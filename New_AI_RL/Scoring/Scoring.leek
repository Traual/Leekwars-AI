/**
 * Scoring Module: Dynamic Indexed Scoring
 * Calcule dynamiquement l'importance de chaque entité
 **/

include("../includes.leek")

global MeanBulbs = [
    CHIP_ROCKY_BULB,
    CHIP_ICED_BULB,
    CHIP_FIRE_BULB,
    CHIP_WIZARD_BULB,
    CHIP_TACTICIAN_BULB,
    CHIP_LIGHTNING_BULB
]

//POLYNOMES POUR LE CALCUL DE ENTITY INTRINSIC SCORE

// Polynômes de réglage (Degré 2 : [a, b, c] pour ax^2 + bx + c)
global POLY_STRENGTH = [0.0, 1.0, 0.0]
global POLY_WISDOM = [0.0, 1.0, 0.0]
global POLY_AGILITY = [0.0, 1.0, 0.0]
global POLY_RESISTANCE = [0.0, 1.0, 0.0]
global POLY_SCIENCE = [0.0, 1.0, 0.0]
global POLY_MAGIC = [0.0, 1.0, 0.0]

// Polynômes pour la puissance (POWER)
global POLY_POWER_STRENGTH = [0.0, 0.01, 1.0] // Défaut: 1 + (POWER / 100)
global POLY_POWER_MAGIC = [0.0, 0.0066, 1.0] // Défaut: 1 + (POWER / 150)

// Polynômes pour les Coefficents d'ajustement (ex: StrengthCoef = solvePoly(POLY_COEF_STR, EnemyResIndex))
global POLY_COEF_STR = [0.0, 0.00025, 0.0]
global POLY_COEF_WIS = [0.0, 0.0, 1.0]
global POLY_COEF_AGI = [0.0, 0.0001, 1.0]
global POLY_COEF_RES = [0.0, 0.0001, 0]
global POLY_COEF_SCI = [0.0, 0.0, 1.0]
global POLY_COEF_MAG = [0.0, 0.0, 1.0]

// Polynômes pour les bonus finaux (MP, Agi/Crit)
global POLY_BONUS_MP = [0.0, 0.033, 1.0] // Défaut: 1 + (MP / 30)
global POLY_BONUS_CRIT = [0.0, 0.0014, 1.0] // Défaut: 1 + (AGI * 0.0014)

// Polynômes pour la menace (Threat)
global POLY_THREAT_DANGER = [0.0, 0.45, 0.0]
global POLY_THREAT_POISON = [0.0, 0.8, 0.0]
global POLY_THREAT_POT = [0.0, 0.3, 0.0]

// Polynôme de survie final (Input: Ratio de survie, Output: Multiplicateur de score)
global POLY_SURVIVAL = [0.0, 0.7, 0.3]

//TODO : ADD DISTS and check Threat > 0.5 to let kill score thrive


class ScoringClass {

    static getStateScore(State, MySide, BaseHash) {
        var _score = 0
        for (var e: var stat in State) {
            if (stat.LIFE > 0) {
                var is_ally = (stat.SIDE == MySide)
                var entity_value = getEntityIntrinsicScore(stat, State)
                var danger = DangerClass.getEntityDanger(stat, State, e, BaseHash)

                // On applique le multiplicateur de survie au score intrinsèque
                var multiplier = getSurvivalMultiplier(stat, danger)
                var finalValue = entity_value * multiplier

                if (is_ally) {
                    _score += finalValue
                } else {
                    _score -= finalValue
                }
            }
        }
        return _score
    }

    static getResurrectionScore(entity_state, State) {
        var v_stat = clone(entity_state, 3)
        var v_State = clone(State, 2)
        v_State[v_stat.ID] = v_stat

        v_stat.LIFE = v_stat.TOTAL_LIFE
        v_stat.POISON_OVER_TIME = 0
        v_stat.JUST_POISON = 0
        v_stat.POISON = 0
        v_stat.JUST_POISON_OVER_TIME = 0

        v_stat.TP = v_stat.TOTAL_TP
        v_stat.MP = v_stat.TOTAL_MP
        v_stat.ABSOLUTE_SHIELD = 0
        v_stat.RELATIVE_SHIELD = 0
        v_stat.DAMAGE_RETURN = 0

        return getEntityIntrinsicScore(v_stat, v_State)
    }

    static getEntityIntrinsicScore(EntityStats, State) {
        
        var EIndexes = new EntityIndexes(EntityStats)
        var TeamIndexes = EnemiesTeamIndexes.getWithCache(State, EntityStats)

        var StrengthCoef = solvePoly(POLY_COEF_STR, TeamIndexes.RESISTANCE)
        var WisdomCoef = 1
        var AgilityCoef = solvePoly(POLY_COEF_AGI, TeamIndexes.STRENGTH)
        var ResistanceCoef = solvePoly(POLY_COEF_RES, TeamIndexes.STRENGTH)
        var ScienceCoef = 1
        var MagicCoef = 1

        var _final = EIndexes.STRENGTH * StrengthCoef +
            EIndexes.WISDOM * WisdomCoef +
            EIndexes.AGILITY * AgilityCoef +
            EIndexes.RESISTANCE * ResistanceCoef +
            EIndexes.SCIENCE * ScienceCoef +
            EIndexes.MAGIC * MagicCoef

        var TOTAL_MP = EntityStats.TOTAL_MP != null ? EntityStats.TOTAL_MP : EntityStats.MP
        _final *= solvePoly(POLY_BONUS_MP, TOTAL_MP)
        _final *= solvePoly(POLY_BONUS_CRIT, EntityStats.AGILITY)

        if (EntityStats.STATIC) _final /= 100

        return _final
    }

    static getSurvivalMultiplier(stat, danger) {
        // 1. Calcul de la menace pondérée via polynômes
        var totalThreat = solvePoly(POLY_THREAT_DANGER, danger) +
            solvePoly(POLY_THREAT_POISON, stat.POISON) +
            solvePoly(POLY_THREAT_POT, stat.POISON_OVER_TIME)

        // 2. Calcul du ratio de santé prédictif
        var survivalRatio = (stat.LIFE - totalThreat) / stat.TOTAL_LIFE

        // 3. Application du polynôme de survie
        return max(0, solvePoly(POLY_SURVIVAL, survivalRatio)) //to Avoid having a negative ratio
    }

    static solvePoly(poly, x) {
        return poly[0] * x * x + poly[1] * x + poly[2]
    }

    static getMinMapDanger(state, cellToCheck) {
        return 0.2
    }
}