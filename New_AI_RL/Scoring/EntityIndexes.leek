/**
 * EntityIndexes Class
 * Calcule les index de puissance brute pour chaque statistique sans utiliser de Map
 **/

include("../includes.leek")

class EntityIndexes {
    STRENGTH
    WISDOM
    AGILITY
    RESISTANCE
    SCIENCE
    MAGIC

    constructor(entityStats) {
        var powerFactorStrength = ScoringClass.solvePoly(POLY_POWER_STRENGTH, entityStats.POWER)
        var powerFactorMagic = ScoringClass.solvePoly(POLY_POWER_MAGIC, entityStats.POWER)

        var TOTAL_TP = entityStats.TOTAL_TP

        this.STRENGTH = ScoringClass.solvePoly(POLY_STRENGTH, entityStats.STRENGTH) * min(TOTAL_TP, EntityIndexes.getMaxTPUsableForStat(entityStats, "STRENGTH")) * powerFactorStrength
        this.WISDOM = ScoringClass.solvePoly(POLY_WISDOM, entityStats.WISDOM) * min(TOTAL_TP, EntityIndexes.getMaxTPUsableForStat(entityStats, "WISDOM"))
        this.AGILITY = ScoringClass.solvePoly(POLY_AGILITY, entityStats.AGILITY) * min(TOTAL_TP, EntityIndexes.getMaxTPUsableForStat(entityStats, "AGILITY"))
        this.RESISTANCE = ScoringClass.solvePoly(POLY_RESISTANCE, entityStats.RESISTANCE) * min(TOTAL_TP, EntityIndexes.getMaxTPUsableForStat(entityStats, "RESISTANCE"))
        this.SCIENCE = ScoringClass.solvePoly(POLY_SCIENCE, entityStats.SCIENCE) * min(TOTAL_TP, EntityIndexes.getMaxTPUsableForStat(entityStats, "SCIENCE"))
        this.MAGIC = ScoringClass.solvePoly(POLY_MAGIC, entityStats.MAGIC) * min(TOTAL_TP, EntityIndexes.getMaxTPUsableForStat(entityStats, "MAGIC")) * powerFactorMagic
    }

    static getWithCache(entityStats) {
        // Optimisation maximale : 9 variables packées dans seulement 2 mots (64 bits)
        // Word 1 (64 bits) : ID (10b) | Power (12b) | TP (10b) | Strength (16b) | Wisdom (16b)
        var combined1 = (entityStats.ID << 54) | (entityStats.POWER << 42) | (entityStats.TOTAL_TP << 32) | (entityStats.STRENGTH << 16) | entityStats.WISDOM

        // Word 2 (64 bits) : Agility (16b) | Resistance (16b) | Science (16b) | Magic (16b)
        var combined2 = (entityStats.AGILITY << 48) | (entityStats.RESISTANCE << 32) | (entityStats.SCIENCE << 16) | entityStats.MAGIC

        var Hash = addValueToBinHash(addValueToBinHash(OFFSET_BASIS, combined1), combined2)

        if (Hash in ENTITY_INDEXES_CACHE) return ENTITY_INDEXES_CACHE[Hash]

        var indexes = new EntityIndexes(entityStats)
        ENTITY_INDEXES_CACHE[Hash] = indexes
        return indexes
    }

    static isEffectUsefulForStat(ItemEffects, statTypeString) {
        for (var eff in ItemEffects) {
            var type = eff[0]
            switch (statTypeString) {
                case "STRENGTH":
                    if (type == EFFECT_DAMAGE) return true
                    break
                case "WISDOM":
                    switch (type) {
                        case EFFECT_HEAL:
                        case EFFECT_BOOST_MAX_LIFE:
                            return true
                    }
                    break
                case "AGILITY":
                    if (type == EFFECT_DAMAGE_RETURN) return true
                    break
                case "RESISTANCE":
                    switch (type) {
                        case EFFECT_ABSOLUTE_SHIELD:
                        case EFFECT_RELATIVE_SHIELD:
                            return true
                    }
                    break
                case "SCIENCE":
                    switch (type) {
                        case EFFECT_BUFF_AGILITY:
                        case EFFECT_BUFF_MP:
                        case EFFECT_BUFF_RESISTANCE:
                        case EFFECT_BUFF_STRENGTH:
                        case EFFECT_BUFF_TP:
                        case EFFECT_BUFF_WISDOM:
                        case EFFECT_NOVA_DAMAGE:
                        case EFFECT_NOVA_VITALITY:
                            return true
                    }
                    break
                case "MAGIC":
                    switch (type) {
                        case EFFECT_POISON:
                        case EFFECT_SHACKLE_AGILITY:
                        case EFFECT_SHACKLE_MAGIC:
                        case EFFECT_SHACKLE_MP:
                        case EFFECT_SHACKLE_TP:
                        case EFFECT_SHACKLE_WISDOM:
                            return true
                    }
                    break
            }
        }
        return false
    }

    static getMaxTPUsableForStat(entityStats, statTypeString) {
        var Hash = entityStats.NAME + statTypeString + entityStats.ID
        if (Hash in MAX_TP_USABLE_FOR_STAT_CACHE) return MAX_TP_USABLE_FOR_STAT_CACHE[Hash]
        var tpUsable = 0

        for (var itemId: var cd in entityStats.COOLDOWNS) {
            if (cd > 0) continue
            var Infos = ITEMINFO[itemId]
            if (Infos == null) continue

            var isUseful = EntityIndexes.isEffectUsefulForStat(Infos.EFFECTS, statTypeString)
            if (!isUseful) continue

            var Cost = Infos.COST
            if (Infos.COOLDOWN == 0) {
                Cost *= Infos.MAX_USES
            }

            tpUsable += Cost
        }
        MAX_TP_USABLE_FOR_STAT_CACHE[Hash] = tpUsable
        return tpUsable
    }
}