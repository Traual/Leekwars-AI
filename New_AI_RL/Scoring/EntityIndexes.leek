/**
 * EntityIndexes Class
 * Calcule les index de puissance brute pour chaque statistique sans utiliser de Map
 **/

include("../includes.leek")

class EntityIndexes {
    STRENGTH
    WISDOM
    AGILITY
    RESISTANCE
    SCIENCE
    MAGIC

    constructor(entityStats) {
        this.STRENGTH = EntityIndexes.getStrengthIndex(entityStats)
        this.WISDOM = EntityIndexes.getWisdomIndex(entityStats)
        this.AGILITY = EntityIndexes.getAgilityIndex(entityStats)
        this.RESISTANCE = EntityIndexes.getResistanceIndex(entityStats)
        this.SCIENCE = EntityIndexes.getScienceIndex(entityStats)
        this.MAGIC = EntityIndexes.getMagicIndex(entityStats)
    }

    static getStrengthIndex(e) {
        // Hash (64b) : ID (10b) | STRENGTH (16b) | POWER (12b) | TOTAL_TP (10b)
        var h = (e.ID << 38) | (e.STRENGTH << 22) | (e.POWER << 10) | e.TOTAL_TP
        if (h in ENTITY_STR_INDEX_CACHE) return ENTITY_STR_INDEX_CACHE[h]

        var tpTerm = min(e.TOTAL_TP, EntityIndexes.getMaxTPUsableForStat(e, "STRENGTH"))
        var val = ScoringClass.solvePoly(POLY_STRENGTH, e.STRENGTH) * tpTerm * ScoringClass.solvePoly(POLY_POWER_STRENGTH, e.POWER)
        ENTITY_STR_INDEX_CACHE[h] = val
        return val
    }

    static getWisdomIndex(e) {
        // Hash (64b) : ID (10b) | WISDOM (16b) | TOTAL_TP (10b)
        var h = (e.ID << 26) | (e.WISDOM << 10) | e.TOTAL_TP
        if (h in ENTITY_WIS_INDEX_CACHE) return ENTITY_WIS_INDEX_CACHE[h]

        var tpTerm = min(e.TOTAL_TP, EntityIndexes.getMaxTPUsableForStat(e, "WISDOM"))
        var val = ScoringClass.solvePoly(POLY_WISDOM, e.WISDOM) * tpTerm
        ENTITY_WIS_INDEX_CACHE[h] = val
        return val
    }

    static getAgilityIndex(e) {
        var h = (e.ID << 26) | (e.AGILITY << 10) | e.TOTAL_TP
        if (h in ENTITY_AGI_INDEX_CACHE) return ENTITY_AGI_INDEX_CACHE[h]

        var tpTerm = min(e.TOTAL_TP, EntityIndexes.getMaxTPUsableForStat(e, "AGILITY"))
        var val = ScoringClass.solvePoly(POLY_AGILITY, e.AGILITY) * tpTerm
        ENTITY_AGI_INDEX_CACHE[h] = val
        return val
    }

    static getResistanceIndex(e) {
        var h = (e.ID << 26) | (e.RESISTANCE << 10) | e.TOTAL_TP
        if (h in ENTITY_RES_INDEX_CACHE) return ENTITY_RES_INDEX_CACHE[h]

        var tpTerm = min(e.TOTAL_TP, EntityIndexes.getMaxTPUsableForStat(e, "RESISTANCE"))
        var val = ScoringClass.solvePoly(POLY_RESISTANCE, e.RESISTANCE) * tpTerm
        ENTITY_RES_INDEX_CACHE[h] = val
        return val
    }

    static getScienceIndex(e) {
        var h = (e.ID << 26) | (e.SCIENCE << 10) | e.TOTAL_TP
        if (h in ENTITY_SCI_INDEX_CACHE) return ENTITY_SCI_INDEX_CACHE[h]

        var tpTerm = min(e.TOTAL_TP, EntityIndexes.getMaxTPUsableForStat(e, "SCIENCE"))
        var val = ScoringClass.solvePoly(POLY_SCIENCE, e.SCIENCE) * tpTerm
        ENTITY_SCI_INDEX_CACHE[h] = val
        return val
    }

    static getMagicIndex(e) {
        // Hash (64b) : ID (10b) | MAGIC (16b) | POWER (12b) | TOTAL_TP (10b)
        var h = (e.ID << 38) | (e.MAGIC << 22) | (e.POWER << 10) | e.TOTAL_TP
        if (h in ENTITY_MAG_INDEX_CACHE) return ENTITY_MAG_INDEX_CACHE[h]

        var tpTerm = min(e.TOTAL_TP, EntityIndexes.getMaxTPUsableForStat(e, "MAGIC"))
        var val = ScoringClass.solvePoly(POLY_MAGIC, e.MAGIC) * tpTerm * ScoringClass.solvePoly(POLY_POWER_MAGIC, e.POWER)
        ENTITY_MAG_INDEX_CACHE[h] = val
        return val
    }

    static getWithCache(entityStats) {
        // Optimisation maximale : 9 variables packées dans seulement 2 mots (64 bits)
        // Word 1 (64 bits) : ID (10b) | Power (12b) | TP (10b) | Strength (16b) | Wisdom (16b)
        var combined1 = (entityStats.ID << 54) | (entityStats.POWER << 42) | (entityStats.TOTAL_TP << 32) | (entityStats.STRENGTH << 16) | entityStats.WISDOM

        // Word 2 (64 bits) : Agility (16b) | Resistance (16b) | Science (16b) | Magic (16b)
        var combined2 = (entityStats.AGILITY << 48) | (entityStats.RESISTANCE << 32) | (entityStats.SCIENCE << 16) | entityStats.MAGIC

        var Hash = addValueToBinHash(addValueToBinHash(OFFSET_BASIS, combined1), combined2)

        if (Hash in ENTITY_INDEXES_CACHE) return ENTITY_INDEXES_CACHE[Hash]

        var indexes = new EntityIndexes(entityStats)
        ENTITY_INDEXES_CACHE[Hash] = indexes
        return indexes
    }

    static isEffectUsefulForStat(ItemEffects, statTypeString) {
        switch (statTypeString) {
            case "STRENGTH":
                for (var eff in ItemEffects) switch (eff[0]) {
                    case EFFECT_DAMAGE:
                        return true
                }
                break
            case "WISDOM":
                for (var eff in ItemEffects) switch (eff[0]) {
                    case EFFECT_HEAL:
                    case EFFECT_BOOST_MAX_LIFE:
                        return true
                }
                break
            case "AGILITY":
                for (var eff in ItemEffects) switch (eff[0]) {
                    case EFFECT_DAMAGE_RETURN:
                        return true
                }
                break
            case "RESISTANCE":
                for (var eff in ItemEffects) switch (eff[0]) {
                    case EFFECT_ABSOLUTE_SHIELD:
                    case EFFECT_RELATIVE_SHIELD:
                        return true
                }
                break
            case "SCIENCE":
                for (var eff in ItemEffects) switch (eff[0]) {
                    case EFFECT_BUFF_AGILITY:
                    case EFFECT_BUFF_MP:
                    case EFFECT_BUFF_RESISTANCE:
                    case EFFECT_BUFF_STRENGTH:
                    case EFFECT_BUFF_TP:
                    case EFFECT_BUFF_WISDOM:
                    case EFFECT_NOVA_DAMAGE:
                    case EFFECT_NOVA_VITALITY:
                        return true
                }
                break
            case "MAGIC":
                for (var eff in ItemEffects) switch (eff[0]) {
                    case EFFECT_POISON:
                    case EFFECT_SHACKLE_AGILITY:
                    case EFFECT_SHACKLE_MAGIC:
                    case EFFECT_SHACKLE_MP:
                    case EFFECT_SHACKLE_TP:
                    case EFFECT_SHACKLE_WISDOM:
                        return true
                }
                break
        }
        return false
    }

    static getMaxTPUsableForStat(entityStats, statTypeString) {
        var Hash = entityStats.NAME + statTypeString + entityStats.ID
        if (Hash in MAX_TP_USABLE_FOR_STAT_CACHE) return MAX_TP_USABLE_FOR_STAT_CACHE[Hash]
        var tpUsable = 0

        for (var itemId: var cd in entityStats.COOLDOWNS) {
            if (cd > 0) continue
            var Infos = ITEMINFO[itemId]
            if (Infos == null) continue

            var isUseful = EntityIndexes.isEffectUsefulForStat(Infos.EFFECTS, statTypeString)
            if (!isUseful) continue

            var Cost = Infos.COST
            if (Infos.COOLDOWN == 0) {
                Cost *= Infos.MAX_USES
            }

            tpUsable += Cost
        }
        MAX_TP_USABLE_FOR_STAT_CACHE[Hash] = tpUsable
        return tpUsable
    }
}