	}
	return _final
}

function getAccessTJ() { //Pour chaque ligne, on coupe le nombre binaire en 3 parties de 6 bits, puis on décode a l'aide des tables les 6 bits --> un tableau des cellules. Et ensuite on les ajoute a _final pour le bon nombre de mp
