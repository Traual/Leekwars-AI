function InitObstacles(Obstacles) { //Pour initialiser la bitmap Obstacles : 
	if (MAP_OBSTACLES_LOADED) { //Si On l'a déjà chargée alors on récupère le cache (les poireaux peuvent avoir bouger donc il faut garder en mémoire la version avec uniquement les obstacles)
		MAP_OBSTACLES_ZERO = MAP_OBSTACLES_ZERO_CACHE
		MAP_OBSTACLES_ONE = MAP_OBSTACLES_ONE_CACHE
		MAP_OBSTACLES_TWO = MAP_OBSTACLES_TWO_CACHE
		MAP_OBSTACLES_THREE = MAP_OBSTACLES_THREE_CACHE
		MAP_OBSTACLES_FOUR = MAP_OBSTACLES_FOUR_CACHE
		MAP_OBSTACLES_FIVE = MAP_OBSTACLES_FIVE_CACHE
		MAP_OBSTACLES_SIX = MAP_OBSTACLES_SIX_CACHE
		MAP_OBSTACLES_SEVEN = MAP_OBSTACLES_SEVEN_CACHE
