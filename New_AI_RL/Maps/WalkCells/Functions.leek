	for (var bin: var mp in ACCESMPTJZero) {
		for (var c in BINARY_TO_CELL_ZERO_ZERO[(bin & 63)] + BINARY_TO_CELL_ZERO_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_ZERO_TWO[bin >> 12]) {
