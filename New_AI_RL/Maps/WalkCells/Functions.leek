function WalkOneInACCTJ() {
	// On propage les cases sur la bitmap :
	TMPTJZero = ACCTJZero | (ACCTJOne | (ACCTJOne << 1)) & MAP_OBSTACLES_ZERO

	TMPTJOne = ACCTJOne | (ACCTJZero | ACCTJTwo | (ACCTJZero >> 1) | (ACCTJTwo >> 1)) & MAP_OBSTACLES_ONE

