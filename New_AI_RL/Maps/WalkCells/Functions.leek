function getAccesible(mp) {
	//On Sauvegarde la case accessible de base : 
	SaveBaseAccessibles()
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC() //On Propage ACC et on save les Mp
		SaveAccesMpFromTmp(m) //On save les mp de TMP avant que ACC soit update
		UpdateAccFromTmp() //On Save le nouvel ACC (qui est tmp actuellement)
	}
}

function getAccesibleJ(mp) {
	UpdateShiftedForJump()
	TotalJumpToTMPJFromACC()
	SaveAccesMpJFromTmpJ(0)
	UpdateAccJFromTmpJ() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC() //On Propage ACC et on save les Mp
		UpdateAccFromTmp() //On Save le nouvel ACC (qui est tmp actuellement)
		UpdateShiftedForJump() //On Save les nouveaux Shifts d'ACC
		WalkOneInACCJ() //On Propage ACCJ avec une action de marche 
		SaveAccesMpJFromTmpJ(m) //On save les mp de TMPJ avant que ACCJ soit update
		UpdateAccJFromTmpJ() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
		OnlyMaxJumpToTMPJFromACC() //On Propage ACCJ avec une action de saut
		SaveAccesMpJFromTmpJ(m) //On save les mp de TMPJ avant que ACCJ soit update
		UpdateAccJFromTmpJ() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
	}
}

function getAccesibleT(mp) {
	UpdateShiftedForTeleportation()
	TotalTeleportationToTMPTFromACC()
	SaveAccesMpTFromTmpT(0)
	UpdateAccTFromTmpT() //On Save le nouvel ACCT (qui est tmpT actuellement)
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC() //On Propage ACC et on save les Mp
		UpdateAccFromTmp() //On Save le nouvel ACC (qui est tmp actuellement)
		UpdateShiftedForTeleportation() //On Save les nouveaux Shifts d'ACC
		WalkOneInACCT() //On Propage ACCT avec une action de marche 
		SaveAccesMpTFromTmpT(m) //On save les mp de TMPT avant que ACCT soit update
		UpdateAccTFromTmpT() //On Save le nouvel ACCT (qui est tmpT actuellement)
		OnlyMaxTeleportationToTMPTFromACC() //On Propage ACCT avec une action de saut
		SaveAccesMpTFromTmpT(m) //On save les mp de TMPT avant que ACCT soit update
		UpdateAccTFromTmpT() //On Save le nouvel ACCT (qui est tmpT actuellement)
	}
}

function getAccesibleTJ(mp) {
	UpdateShiftedForTeleportation()
	TotalTeleportationToTMPTFromACC()
	TotalJumpToTMPJFromACC()
	UpdateAccJFromTmpJ() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
	UpdateAccTFromTmpT() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
	UpdateShiftedForTeleportationAndJumpOnly()
	TotalTeleportationToTMPTJFromACCJ()
	TotalJumpToTMPTJFromACCT()
	SaveAccesMpTJFromTmpTJ(0)
	UpdateAccTJFromTmpTJ() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC() //On Propage ACC et on save les Mp
		UpdateAccFromTmp() //On Save le nouvel ACC (qui est tmp actuellement)
		UpdateShiftedForTeleportation() //On Save les nouveaux Shifts d'ACC
		WalkOneInACCT() //On Propage ACCT avec une action de marche
		WalkOneInACCJ() //On Propage ACCJ avec une action de marche
		WalkOneInACCTJ() //On Propage ACCJ avec une action de marche
		SaveAccesMpTJFromTmpTJ(m) //On save les mp de TMPJ avant que ACCJ soit update
		UpdateAccTFromTmpT() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
		UpdateAccJFromTmpJ() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
		UpdateAccTJFromTmpTJ() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
		OnlyMaxTeleportationToTMPTFromACC() //On Propage ACCJ avec une action de saut
		OnlyMaxJumpToTMPJFromACC() //On Propage ACCJ avec une action de saut
		UpdateShiftedForTeleportationAndJumpOnly()
		OnlyMaxTeleportationToTMPTJFromACCJ() //On Propage ACCJ avec une action de saut
		OnlyMaxJumpToTMPTJFromACCT() //On Propage ACCJ avec une action de saut
		SaveAccesMpTJFromTmpTJ(m) //On save les mp de TMPJ avant que ACCJ soit update
		UpdateAccTFromTmpT() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
		UpdateAccJFromTmpJ() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
		UpdateAccTJFromTmpTJ() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
	}
}