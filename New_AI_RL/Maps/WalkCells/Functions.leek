function SaveBaseAccessibles() { //On regarde dans ACC nos céllules accessibles de base (Il n'y en a qu'une mais c'est pour avoir un code propre)
	if (ACCZero) ACCESMPZero[ACCZero] = 0
	if (ACCOne) ACCESMPOne[ACCOne] = 0
	if (ACCTwo) ACCESMPTwo[ACCTwo] = 0
	if (ACCThree) ACCESMPThree[ACCThree] = 0
	if (ACCFour) ACCESMPFour[ACCFour] = 0
	if (ACCFive) ACCESMPFive[ACCFive] = 0
	if (ACCSix) ACCESMPSix[ACCSix] = 0
	if (ACCSeven) ACCESMPSeven[ACCSeven] = 0
	if (ACCEight) ACCESMPEight[ACCEight] = 0
	if (ACCNine) ACCESMPNine[ACCNine] = 0
	if (ACCTen) ACCESMPTen[ACCTen] = 0
	if (ACCEleven) ACCESMPEleven[ACCEleven] = 0
	if (ACCTwelve) ACCESMPTwelve[ACCTwelve] = 0
	if (ACCThirteen) ACCESMPThirteen[ACCThirteen] = 0
	if (ACCFourteen) ACCESMPFourteen[ACCFourteen] = 0
	if (ACCFifteen) ACCESMPFifteen[ACCFifteen] = 0
	if (ACCSixteen) ACCESMPSixteen[ACCSixteen] = 0
	if (ACCSeventeen) ACCESMPSeventeen[ACCSeventeen] = 0
	if (ACCEighteen) ACCESMPEighteen[ACCEighteen] = 0
	if (ACCNineteen) ACCESMPNineteen[ACCNineteen] = 0
	if (ACCTwenty) ACCESMPTwenty[ACCTwenty] = 0
	if (ACCTwentyOne) ACCESMPTwentyOne[ACCTwentyOne] = 0
	if (ACCTwentyTwo) ACCESMPTwentyTwo[ACCTwentyTwo] = 0
	if (ACCTwentyThree) ACCESMPTwentyThree[ACCTwentyThree] = 0
	if (ACCTwentyFour) ACCESMPTwentyFour[ACCTwentyFour] = 0
	if (ACCTwentyFive) ACCESMPTwentyFive[ACCTwentyFive] = 0
	if (ACCTwentySix) ACCESMPTwentySix[ACCTwentySix] = 0
	if (ACCTwentySeven) ACCESMPTwentySeven[ACCTwentySeven] = 0
	if (ACCTwentyEight) ACCESMPTwentyEight[ACCTwentyEight] = 0
	if (ACCTwentyNine) ACCESMPTwentyNine[ACCTwentyNine] = 0
