	TMPTTwentyEight = ACCTTwentyEight | (ACCTTwentySeven | ACCTTwentyNine | (ACCTTwentySeven << 1) | (ACCTTwentyNine << 1)) & MAP_OBSTACLES_TWENTYEIGHT

