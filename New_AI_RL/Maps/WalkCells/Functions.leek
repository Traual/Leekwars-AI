	TMPTJTwentyEight = ACCTJTwentyEight | (ACCTJTwentySeven | ACCTJTwentyNine | (ACCTJTwentySeven << 1) | (ACCTJTwentyNine << 1)) & MAP_OBSTACLES_TWENTYEIGHT

	TMPTJTwentyNine = ACCTJTwentyNine | (ACCTJTwentyEight | ACCTJThirty | (ACCTJTwentyEight >> 1) | (ACCTJThirty >> 1)) & MAP_OBSTACLES_TWENTYNINE

	TMPTJThirty = ACCTJThirty | (ACCTJTwentyNine | ACCTJThirtyOne | (ACCTJTwentyNine << 1) | (ACCTJThirtyOne << 1)) & MAP_OBSTACLES_THIRTY

	TMPTJThirtyOne = ACCTJThirtyOne | (ACCTJThirty | ACCTJThirtyTwo | (ACCTJThirty >> 1) | (ACCTJThirtyTwo >> 1)) & MAP_OBSTACLES_THIRTYONE

