function InitBuildAcc(cell) { //On Reset / Construit l'ACC (La bitmap des cases accessibles)
	ACCZero = 0
	ACCOne = 0
	ACCTwo = 0
	ACCThree = 0
	ACCFour = 0
	ACCFive = 0
	ACCSix = 0
	ACCSeven = 0
	ACCEight = 0
	ACCNine = 0
	ACCTen = 0
	ACCEleven = 0
	ACCTwelve = 0
	ACCThirteen = 0
	ACCFourteen = 0
	ACCFifteen = 0
	ACCSixteen = 0
	ACCSeventeen = 0
	ACCEighteen = 0
	ACCNineteen = 0
	ACCTwenty = 0
	ACCTwentyOne = 0
	ACCTwentyTwo = 0
	ACCTwentyThree = 0
	ACCTwentyFour = 0
	ACCTwentyFive = 0
	ACCTwentySix = 0
	ACCTwentySeven = 0
	ACCTwentyEight = 0
	ACCTwentyNine = 0
	ACCThirty = 0
	ACCThirtyOne = 0
	ACCThirtyTwo = 0
	ACCThirtyThree = 0
	ACCThirtyFour = 0

	MapFctSetupAcc[MAP_CELL_TO_LINE[cell]](cell)
}

