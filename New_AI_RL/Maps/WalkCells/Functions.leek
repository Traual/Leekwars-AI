		MAP_OBSTACLES_NINE = MAP_OBSTACLES_NINE_CACHE
		MAP_OBSTACLES_TEN = MAP_OBSTACLES_TEN_CACHE
		MAP_OBSTACLES_ELEVEN = MAP_OBSTACLES_ELEVEN_CACHE
		MAP_OBSTACLES_TWELVE = MAP_OBSTACLES_TWELVE_CACHE
		MAP_OBSTACLES_THIRTEEN = MAP_OBSTACLES_THIRTEEN_CACHE
		MAP_OBSTACLES_FOURTEEN = MAP_OBSTACLES_FOURTEEN_CACHE
		MAP_OBSTACLES_FIFTEEN = MAP_OBSTACLES_FIFTEEN_CACHE
		MAP_OBSTACLES_SIXTEEN = MAP_OBSTACLES_SIXTEEN_CACHE
		MAP_OBSTACLES_SEVENTEEN = MAP_OBSTACLES_SEVENTEEN_CACHE
		MAP_OBSTACLES_EIGHTEEN = MAP_OBSTACLES_EIGHTEEN_CACHE
		MAP_OBSTACLES_NINETEEN = MAP_OBSTACLES_NINETEEN_CACHE
		MAP_OBSTACLES_TWENTY = MAP_OBSTACLES_TWENTY_CACHE
		MAP_OBSTACLES_TWENTYONE = MAP_OBSTACLES_TWENTYONE_CACHE
		MAP_OBSTACLES_TWENTYTWO = MAP_OBSTACLES_TWENTYTWO_CACHE
		MAP_OBSTACLES_TWENTYTHREE = MAP_OBSTACLES_TWENTYTHREE_CACHE
		MAP_OBSTACLES_TWENTYFOUR = MAP_OBSTACLES_TWENTYFOUR_CACHE
		MAP_OBSTACLES_TWENTYFIVE = MAP_OBSTACLES_TWENTYFIVE_CACHE
		MAP_OBSTACLES_TWENTYSIX = MAP_OBSTACLES_TWENTYSIX_CACHE
		MAP_OBSTACLES_TWENTYSEVEN = MAP_OBSTACLES_TWENTYSEVEN_CACHE
		MAP_OBSTACLES_TWENTYEIGHT = MAP_OBSTACLES_TWENTYEIGHT_CACHE
		MAP_OBSTACLES_TWENTYNINE = MAP_OBSTACLES_TWENTYNINE_CACHE
		MAP_OBSTACLES_THIRTY = MAP_OBSTACLES_THIRTY_CACHE
		MAP_OBSTACLES_THIRTYONE = MAP_OBSTACLES_THIRTYONE_CACHE
		MAP_OBSTACLES_THIRTYTWO = MAP_OBSTACLES_THIRTYTWO_CACHE
		MAP_OBSTACLES_THIRTYTHREE = MAP_OBSTACLES_THIRTYTHREE_CACHE
		MAP_OBSTACLES_THIRTYFOUR = MAP_OBSTACLES_THIRTYFOUR_CACHE
	} else {
		//On charge la map obstacle (Les nombres en dessous sont les obstacles sur chaque bout de map a droite (on met un obstacle au bit 18 pour les nombres pairs et 17 pour les nombres impair pour éviter que l'algo veuilles passer du bord droit de la map au bord gauche en 2mp))
		MAP_OBSTACLES_ZERO = 262143
		MAP_OBSTACLES_ONE = 131071
		MAP_OBSTACLES_TWO = 262143
		MAP_OBSTACLES_THREE = 131071
		MAP_OBSTACLES_FOUR = 262143
		MAP_OBSTACLES_FIVE = 131071
		MAP_OBSTACLES_SIX = 262143
		MAP_OBSTACLES_SEVEN = 131071
		MAP_OBSTACLES_EIGHT = 262143
		MAP_OBSTACLES_NINE = 131071
		MAP_OBSTACLES_TEN = 262143
		MAP_OBSTACLES_ELEVEN = 131071
		MAP_OBSTACLES_TWELVE = 262143
		MAP_OBSTACLES_THIRTEEN = 131071
		MAP_OBSTACLES_FOURTEEN = 262143
		MAP_OBSTACLES_FIFTEEN = 131071
		MAP_OBSTACLES_SIXTEEN = 262143
		MAP_OBSTACLES_SEVENTEEN = 131071
		MAP_OBSTACLES_EIGHTEEN = 262143
		MAP_OBSTACLES_NINETEEN = 131071
		MAP_OBSTACLES_TWENTY = 262143
		MAP_OBSTACLES_TWENTYONE = 131071
		MAP_OBSTACLES_TWENTYTWO = 262143
		MAP_OBSTACLES_TWENTYTHREE = 131071
		MAP_OBSTACLES_TWENTYFOUR = 262143
		MAP_OBSTACLES_TWENTYFIVE = 131071
		MAP_OBSTACLES_TWENTYSIX = 262143
		MAP_OBSTACLES_TWENTYSEVEN = 131071
		MAP_OBSTACLES_TWENTYEIGHT = 262143
		MAP_OBSTACLES_TWENTYNINE = 131071
		MAP_OBSTACLES_THIRTY = 262143
		MAP_OBSTACLES_THIRTYONE = 131071
		MAP_OBSTACLES_THIRTYTWO = 262143
		MAP_OBSTACLES_THIRTYTHREE = 131071
		MAP_OBSTACLES_THIRTYFOUR = 262143

		//On Ajoute les réels obstacles de la map a notre bitmap d'obstacles
		for (var x in Obstacles) {
			obstacleFunctions[MAP_CELL_TO_LINE[x]](MAP_CELL_TO_POS[x])
		}

		//On Sauvegarde le tout pour le cache pour les prochains tours
		MAP_OBSTACLES_LOADED = true
		MAP_OBSTACLES_ZERO_CACHE = MAP_OBSTACLES_ZERO
		MAP_OBSTACLES_ONE_CACHE = MAP_OBSTACLES_ONE
		MAP_OBSTACLES_TWO_CACHE = MAP_OBSTACLES_TWO
		MAP_OBSTACLES_THREE_CACHE = MAP_OBSTACLES_THREE
		MAP_OBSTACLES_FOUR_CACHE = MAP_OBSTACLES_FOUR
		MAP_OBSTACLES_FIVE_CACHE = MAP_OBSTACLES_FIVE
		MAP_OBSTACLES_SIX_CACHE = MAP_OBSTACLES_SIX
		MAP_OBSTACLES_SEVEN_CACHE = MAP_OBSTACLES_SEVEN
		MAP_OBSTACLES_EIGHT_CACHE = MAP_OBSTACLES_EIGHT
		MAP_OBSTACLES_NINE_CACHE = MAP_OBSTACLES_NINE
		MAP_OBSTACLES_TEN_CACHE = MAP_OBSTACLES_TEN
		MAP_OBSTACLES_ELEVEN_CACHE = MAP_OBSTACLES_ELEVEN
		MAP_OBSTACLES_TWELVE_CACHE = MAP_OBSTACLES_TWELVE
		MAP_OBSTACLES_THIRTEEN_CACHE = MAP_OBSTACLES_THIRTEEN
		MAP_OBSTACLES_FOURTEEN_CACHE = MAP_OBSTACLES_FOURTEEN
		MAP_OBSTACLES_FIFTEEN_CACHE = MAP_OBSTACLES_FIFTEEN
		MAP_OBSTACLES_SIXTEEN_CACHE = MAP_OBSTACLES_SIXTEEN
		MAP_OBSTACLES_SEVENTEEN_CACHE = MAP_OBSTACLES_SEVENTEEN
		MAP_OBSTACLES_EIGHTEEN_CACHE = MAP_OBSTACLES_EIGHTEEN
		MAP_OBSTACLES_NINETEEN_CACHE = MAP_OBSTACLES_NINETEEN
		MAP_OBSTACLES_TWENTY_CACHE = MAP_OBSTACLES_TWENTY
		MAP_OBSTACLES_TWENTYONE_CACHE = MAP_OBSTACLES_TWENTYONE
		MAP_OBSTACLES_TWENTYTWO_CACHE = MAP_OBSTACLES_TWENTYTWO
		MAP_OBSTACLES_TWENTYTHREE_CACHE = MAP_OBSTACLES_TWENTYTHREE
		MAP_OBSTACLES_TWENTYFOUR_CACHE = MAP_OBSTACLES_TWENTYFOUR
		MAP_OBSTACLES_TWENTYFIVE_CACHE = MAP_OBSTACLES_TWENTYFIVE
		MAP_OBSTACLES_TWENTYSIX_CACHE = MAP_OBSTACLES_TWENTYSIX
		MAP_OBSTACLES_TWENTYSEVEN_CACHE = MAP_OBSTACLES_TWENTYSEVEN
		MAP_OBSTACLES_TWENTYEIGHT_CACHE = MAP_OBSTACLES_TWENTYEIGHT
		MAP_OBSTACLES_TWENTYNINE_CACHE = MAP_OBSTACLES_TWENTYNINE
		MAP_OBSTACLES_THIRTY_CACHE = MAP_OBSTACLES_THIRTY
		MAP_OBSTACLES_THIRTYONE_CACHE = MAP_OBSTACLES_THIRTYONE
		MAP_OBSTACLES_THIRTYTWO_CACHE = MAP_OBSTACLES_THIRTYTWO
		MAP_OBSTACLES_THIRTYTHREE_CACHE = MAP_OBSTACLES_THIRTYTHREE
		MAP_OBSTACLES_THIRTYFOUR_CACHE = MAP_OBSTACLES_THIRTYFOUR
	}
}

function InitLeekCells(LeekCells) { //on met sur la bitmap d'obstacles les positions des entitées
	for (var x in LeekCells) {
		obstacleFunctions[MAP_CELL_TO_LINE[x]](MAP_CELL_TO_POS[x])
	}
}


