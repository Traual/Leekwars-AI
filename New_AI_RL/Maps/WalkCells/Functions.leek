function SaveAccesMpFromTmp(m) {
	// Si il n'y a aucun changement pour ce mp sur cette ligne, alors on ne le sauvegarde pas
	if (TMPZero ^ ACCZero) ACCESMPZero[TMPZero ^ ACCZero] = m
	if (TMPOne ^ ACCOne) ACCESMPOne[TMPOne ^ ACCOne] = m
	if (TMPTwo ^ ACCTwo) ACCESMPTwo[TMPTwo ^ ACCTwo] = m
	if (TMPThree ^ ACCThree) ACCESMPThree[TMPThree ^ ACCThree] = m
	if (TMPFour ^ ACCFour) ACCESMPFour[TMPFour ^ ACCFour] = m
	if (TMPFive ^ ACCFive) ACCESMPFive[TMPFive ^ ACCFive] = m
	if (TMPSix ^ ACCSix) ACCESMPSix[TMPSix ^ ACCSix] = m
	if (TMPSeven ^ ACCSeven) ACCESMPSeven[TMPSeven ^ ACCSeven] = m
	if (TMPEight ^ ACCEight) ACCESMPEight[TMPEight ^ ACCEight] = m
	if (TMPNine ^ ACCNine) ACCESMPNine[TMPNine ^ ACCNine] = m
	if (TMPTen ^ ACCTen) ACCESMPTen[TMPTen ^ ACCTen] = m
	if (TMPEleven ^ ACCEleven) ACCESMPEleven[TMPEleven ^ ACCEleven] = m
	if (TMPTwelve ^ ACCTwelve) ACCESMPTwelve[TMPTwelve ^ ACCTwelve] = m
	if (TMPThirteen ^ ACCThirteen) ACCESMPThirteen[TMPThirteen ^ ACCThirteen] = m
	if (TMPFourteen ^ ACCFourteen) ACCESMPFourteen[TMPFourteen ^ ACCFourteen] = m
	if (TMPFifteen ^ ACCFifteen) ACCESMPFifteen[TMPFifteen ^ ACCFifteen] = m
	if (TMPSixteen ^ ACCSixteen) ACCESMPSixteen[TMPSixteen ^ ACCSixteen] = m
	if (TMPSeventeen ^ ACCSeventeen) ACCESMPSeventeen[TMPSeventeen ^ ACCSeventeen] = m
	if (TMPEighteen ^ ACCEighteen) ACCESMPEighteen[TMPEighteen ^ ACCEighteen] = m
	if (TMPNineteen ^ ACCNineteen) ACCESMPNineteen[TMPNineteen ^ ACCNineteen] = m
	if (TMPTwenty ^ ACCTwenty) ACCESMPTwenty[TMPTwenty ^ ACCTwenty] = m
	if (TMPTwentyOne ^ ACCTwentyOne) ACCESMPTwentyOne[TMPTwentyOne ^ ACCTwentyOne] = m
	if (TMPTwentyTwo ^ ACCTwentyTwo) ACCESMPTwentyTwo[TMPTwentyTwo ^ ACCTwentyTwo] = m
	if (TMPTwentyThree ^ ACCTwentyThree) ACCESMPTwentyThree[TMPTwentyThree ^ ACCTwentyThree] = m
	if (TMPTwentyFour ^ ACCTwentyFour) ACCESMPTwentyFour[TMPTwentyFour ^ ACCTwentyFour] = m
