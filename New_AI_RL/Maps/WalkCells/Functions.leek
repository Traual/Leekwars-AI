/**
 * Walkable cells binary functions file
 **/

include("../../includes.leek")

function CellToLine(cell) { //Used Only In Init
	var couple = floor(cell / 35) // Couple de ligne
	var c = cell % 35 // position de x dans le couple de ligne
	var line = c >= 18 ? 1 : 0 // dans la ligne 1 ou 2 ?
	var l = couple * 2 + line // Numero de ligne
	return l
}

function CellToPos(cell) { //Used Only In Init
	var c = cell % 35 // position de x dans le couple de ligne
	var line = c >= 18 ? 1 : 0 // dans la ligne 1 ou 2 ?
	var pos = c - (18 * line) // Position de x dans la ligne
	return pos
}

function RowColToCell(row, col) {
    var couple = floor(row / 2)
    return couple * 35 + (row % 2 == 1 ? 18 : 0) + col
}

