	TMPTJNine = ACCTJNine | (ACCTJEight | ACCTJTen | (ACCTJEight >> 1) | (ACCTJTen >> 1)) & MAP_OBSTACLES_NINE

	TMPTJTen = ACCTJTen | (ACCTJNine | ACCTJEleven | (ACCTJNine << 1) | (ACCTJEleven << 1)) & MAP_OBSTACLES_TEN

	TMPTJEleven = ACCTJEleven | (ACCTJTen | ACCTJTwelve | (ACCTJTen >> 1) | (ACCTJTwelve >> 1)) & MAP_OBSTACLES_ELEVEN

	TMPTJTwelve = ACCTJTwelve | (ACCTJEleven | ACCTJThirteen | (ACCTJEleven << 1) | (ACCTJThirteen << 1)) & MAP_OBSTACLES_TWELVE

	TMPTJThirteen = ACCTJThirteen | (ACCTJTwelve | ACCTJFourteen | (ACCTJTwelve >> 1) | (ACCTJFourteen >> 1)) & MAP_OBSTACLES_THIRTEEN

	TMPTJFourteen = ACCTJFourteen | (ACCTJThirteen | ACCTJFifteen | (ACCTJThirteen << 1) | (ACCTJFifteen << 1)) & MAP_OBSTACLES_FOURTEEN

	TMPTJFifteen = ACCTJFifteen | (ACCTJFourteen | ACCTJSixteen | (ACCTJFourteen >> 1) | (ACCTJSixteen >> 1)) & MAP_OBSTACLES_FIFTEEN

	TMPTJSixteen = ACCTJSixteen | (ACCTJFifteen | ACCTJSeventeen | (ACCTJFifteen << 1) | (ACCTJSeventeen << 1)) & MAP_OBSTACLES_SIXTEEN

	TMPTJSeventeen = ACCTJSeventeen | (ACCTJSixteen | ACCTJEighteen | (ACCTJSixteen >> 1) | (ACCTJEighteen >> 1)) & MAP_OBSTACLES_SEVENTEEN

	TMPTJEighteen = ACCTJEighteen | (ACCTJSeventeen | ACCTJNineteen | (ACCTJSeventeen << 1) | (ACCTJNineteen << 1)) & MAP_OBSTACLES_EIGHTEEN

	TMPTJNineteen = ACCTJNineteen | (ACCTJEighteen | ACCTJTwenty | (ACCTJEighteen >> 1) | (ACCTJTwenty >> 1)) & MAP_OBSTACLES_NINETEEN

	TMPTJTwenty = ACCTJTwenty | (ACCTJNineteen | ACCTJTwentyOne | (ACCTJNineteen << 1) | (ACCTJTwentyOne << 1)) & MAP_OBSTACLES_TWENTY

	TMPTJTwentyOne = ACCTJTwentyOne | (ACCTJTwenty | ACCTJTwentyTwo | (ACCTJTwenty >> 1) | (ACCTJTwentyTwo >> 1)) & MAP_OBSTACLES_TWENTYONE

	TMPTJTwentyTwo = ACCTJTwentyTwo | (ACCTJTwentyOne | ACCTJTwentyThree | (ACCTJTwentyOne << 1) | (ACCTJTwentyThree << 1)) & MAP_OBSTACLES_TWENTYTWO

	TMPTJTwentyThree = ACCTJTwentyThree | (ACCTJTwentyTwo | ACCTJTwentyFour | (ACCTJTwentyTwo >> 1) | (ACCTJTwentyFour >> 1)) & MAP_OBSTACLES_TWENTYTHREE

	TMPTJTwentyFour = ACCTJTwentyFour | (ACCTJTwentyThree | ACCTJTwentyFive | (ACCTJTwentyThree << 1) | (ACCTJTwentyFive << 1)) & MAP_OBSTACLES_TWENTYFOUR

	TMPTJTwentyFive = ACCTJTwentyFive | (ACCTJTwentyFour | ACCTJTwentySix | (ACCTJTwentyFour >> 1) | (ACCTJTwentySix >> 1)) & MAP_OBSTACLES_TWENTYFIVE

	TMPTJTwentySix = ACCTJTwentySix | (ACCTJTwentyFive | ACCTJTwentySeven | (ACCTJTwentyFive << 1) | (ACCTJTwentySeven << 1)) & MAP_OBSTACLES_TWENTYSIX

