		var add = getRealEffect(Effect, Dist, Multiplier) * (1 + CastStats.WISDOM / 100)
		/* Multiplier*/ //No multiplier and no aoe (yet)
		TarStats.LIFE += add
		TarStats.TOTAL_LIFE += add
	}

