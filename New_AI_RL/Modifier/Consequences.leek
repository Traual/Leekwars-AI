/**
 * Class that change State from the consequences of an action (Not SUMM/RESU Type) : Item To X From Y (For Lasers)
 **/

//TODO : Add Special Weapons Effects on Kill (Here and in Action Fitness)
include("../includes.leek")

class ConsequencesClass {

	static getConsequences(State, Item, From, To, Caster, BaseHash) { //Need from for lasers 
		var Targets = ConsequenceTargets(Item, From, To, State, Caster, BaseHash)
		var CastStats = State[Caster]
		for (var Effect in ITEMINFO[Item].EFFECTS) {
			var EffectType = Effect[0]

			// Cas particuliers (Summon/Resurrect)
			switch (EffectType) {
				case EFFECT_SUMMON:
					var Id = StateClass.getMaxUsedID(State)
					var EntityStats = new BulbState(Id, SUMMONER_LEVEL_TIMES, Item, To, Caster, CastStats)
					State[Id] = EntityStats
					continue
				case EFFECT_RESURRECT:
					ResurrectionClass.Update(To, State)
					continue
			}

			var TmpTargets = RealConsequenceTargets(Targets, Effect, State, CastStats, Caster)
			var Multiplier = (Effect[5] & EFFECT_MODIFIER_MULTIPLIED_BY_TARGETS) ? mapSize(TmpTargets) : 1 //Saving Multiplier
			if (CastStats.AGILITY >= MIN_AGILITY_TO_FULLY_CRIT) Multiplier *= CRITICAL_FACTOR
			var RealTargets = (Effect[5] & EFFECT_MODIFIER_ON_CASTER) ? [Caster: 0] : TmpTargets

			// Dispatch via Switch (Dégage la ConsMap)
			switch (EffectType) {
				case EFFECT_ABSOLUTE_SHIELD:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityAbsoluteShieldConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_ABSOLUTE_VULNERABILITY:
					for (var Tar: var Dist in RealTargets) {
						getEntityAbsoluteVulnerabilityConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_AFTEREFFECT:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityAfterEffectConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_ANTIDOTE:
					for (var Tar: var Dist in RealTargets) {
						getEntityAntidoteConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_ATTRACT:
					for (var Tar: var Dist in RealTargets) {
						if (!State[Tar].STATIC) State[Tar].CELL = To
					}
					break
				case EFFECT_BOOST_MAX_LIFE:
					for (var Tar: var Dist in RealTargets) {
						getEntityBoostMaxLifeConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_BUFF_AGILITY:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityBuffAgilityConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_BUFF_MP:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityBuffMpConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_BUFF_RESISTANCE:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityBuffResistanceConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_BUFF_STRENGTH:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityBuffStrengthConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_BUFF_TP:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityBuffTpConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_BUFF_WISDOM:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityBuffWisdomConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_DAMAGE:
					for (var Tar: var Dist in RealTargets) {
						getEntityDamageConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster, State)
					}
					break
				case EFFECT_DAMAGE_RETURN:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityDamageReturnConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_DEBUFF:
					for (var Tar: var Dist in RealTargets) {
						getEntityDebuffConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_HEAL:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityHealConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_INVERT:
					for (var Tar: var Dist in RealTargets) {
						if (!State[Tar].STATIC) {
							State[Tar].CELL = From
							State[Caster].CELL = To
						}
					}
					break
				case EFFECT_KILL:
					for (var Tar: var Dist in RealTargets) {
						getKillConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster, State, true)
					}
					break
				case EFFECT_LIFE_DAMAGE:
					for (var Tar: var Dist in RealTargets) {
						getEntityLifeDamageConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster, State)
					}
					break
				case EFFECT_NOVA_DAMAGE:
					for (var Tar: var Dist in RealTargets) {
						getEntityNovaDamageConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_NOVA_VITALITY:
					for (var Tar: var Dist in RealTargets) {
						getEntityNovaVitalityConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_POISON:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityPoisonConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_PUSH:
					for (var Tar: var Dist in RealTargets) {
						if (!State[Tar].STATIC) State[Tar].CELL = To
					}
					break
				case EFFECT_RAW_ABSOLUTE_SHIELD:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityRawAbsoluteShieldConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_RAW_BUFF_AGILITY:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityRawBuffAgilityConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_RAW_BUFF_MAGIC:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityRawBuffMagicConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_RAW_BUFF_MP:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityRawBuffMpConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_RAW_BUFF_POWER:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityRawBuffPowerConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_RAW_BUFF_RESISTANCE:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityRawBuffResistanceConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_RAW_BUFF_SCIENCE:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityRawBuffScienceConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_RAW_BUFF_STRENGTH:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityRawBuffStrengthConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_RAW_BUFF_TP:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityRawBuffTpConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_RAW_BUFF_WISDOM:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityRawBuffWisdomConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_RAW_HEAL:
					for (var Tar: var Dist in RealTargets) {
						getEntityRawHealConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_RAW_RELATIVE_SHIELD:
					for (var Tar: var Dist in RealTargets) {
						getEntityRawRelativeShieldConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_RELATIVE_SHIELD:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityRelativeShieldConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_REMOVE_SHACKLES:
					for (var Tar: var Dist in RealTargets) {
						getEntityRemoveShacklesConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_SHACKLE_AGILITY:
					for (var Tar: var Dist in RealTargets) {
						getEntityShackleAgilityConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_SHACKLE_MAGIC:
					for (var Tar: var Dist in RealTargets) {
						getEntityShackleMagicConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_SHACKLE_MP:
					for (var Tar: var Dist in RealTargets) {
						getEntityShackleMpConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_SHACKLE_STRENGTH:
					for (var Tar: var Dist in RealTargets) {
						getEntityShackleStrengthConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_SHACKLE_TP:
					for (var Tar: var Dist in RealTargets) {
						ReplacementChangeStats(Item, Effect, State[Tar])
						getEntityShackleTpConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_SHACKLE_WISDOM:
					for (var Tar: var Dist in RealTargets) {
						getEntityShackleWisdomConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_STEAL_ABSOLUTE_SHIELD:
					for (var Tar: var Dist in RealTargets) {
						getEntityStealAbsoluteShieldConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_STEAL_LIFE:
					for (var Tar: var Dist in RealTargets) {
						getEntityStealLifeConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
				case EFFECT_TELEPORT:
					for (var Tar: var Dist in RealTargets) {
						State[Caster].CELL = To
					}
					break
				case EFFECT_VULNERABILITY:
					for (var Tar: var Dist in RealTargets) {
						getEntityVulnerabilityConsequences(Dist, Multiplier, Effect, State[Tar], CastStats, Tar == Caster)
					}
					break
			}
		}
	}

	static isHitable(Effect, TarStats, CastStats, TarIsCaster) { //Determine wether or not the effect can be put on target (for example : Burning on leek : false, Vaccin on Ally : True)
		if (TarStats.LIFE <= 0) return false
		var Eff4 = Effect[4]
		var TargetSide = TarStats.SIDE
		var CasterSide = CastStats.SIDE
		var binSidesEqual = TargetSide == CasterSide ? 1 : 0
		var binTarEqualCaster = TarIsCaster ? 1 : 0
		var binSummon = TarStats.IS_SUMMON ? 1 : 0
		var Hash = binTarEqualCaster << 36 | binSummon << 34 | binSidesEqual << 32 | Eff4
		if (Hash in IS_HITABLE_CACHE) return IS_HITABLE_CACHE[Hash]
		var Ally = (CasterSide == TargetSide)
		var Summ = TarStats.IS_SUMMON
		if ((!(Eff4 & EFFECT_TARGET_ALLIES) && Ally) || (!(Eff4 & EFFECT_TARGET_ENEMIES) && !Ally) || (!(Eff4 & EFFECT_TARGET_NON_SUMMONS) && !Summ) || (!(Eff4 & EFFECT_TARGET_SUMMONS) && Summ)) {
			IS_HITABLE_CACHE[Hash] = false
		} else {
			IS_HITABLE_CACHE[Hash] = !(!(Eff4 & EFFECT_TARGET_CASTER) && TarIsCaster)
		}
		return IS_HITABLE_CACHE[Hash]
	}

	static ReplacementChangeStats(Item, Effect, TarStats) { //Determine wether or not the effect will change something (And make the changes before application of item) (Stackable and already here ? : True. Not Stackable And here : False)
		if (Effect[5] & EFFECT_MODIFIER_STACKABLE) return; //stackable, then pass
		//Then search the effect on target : 
		for (var eff in TarStats.EFFECTS) {
			if (eff[5] == Item) {
				// Dispatch via Switch (Dégage EffectsRemove)
				var type = eff[0]
				var value = eff[1]
				var duration = eff[3]
				switch (type) {
					case EFFECT_ABSOLUTE_SHIELD:
					case EFFECT_DAMAGE_TO_ABSOLUTE_SHIELD:
					case EFFECT_RAW_ABSOLUTE_SHIELD:
					case EFFECT_STEAL_ABSOLUTE_SHIELD:
						TarStats.ABSOLUTE_SHIELD -= value;
						break
					case EFFECT_ABSOLUTE_VULNERABILITY:
						TarStats.ABSOLUTE_SHIELD += value;
						break
					case EFFECT_AFTEREFFECT:
					case EFFECT_POISON:
						TarStats.POISON -= value
						TarStats.POISON_OVER_TIME -= value * duration
						if (type == EFFECT_POISON) {
							TarStats.JUST_POISON -= value
							TarStats.JUST_POISON_OVER_TIME -= value * duration
						}
						break
					case EFFECT_ALLY_KILLED_TO_AGILITY:
					case EFFECT_BUFF_AGILITY:
					case EFFECT_RAW_BUFF_AGILITY:
						TarStats.AGILITY -= value;
						break
					case EFFECT_BUFF_MP:
					case EFFECT_MOVED_TO_MP:
					case EFFECT_RAW_BUFF_MP:
						TarStats.MP -= value
						TarStats.TOTAL_MP -= value
						break
					case EFFECT_BUFF_RESISTANCE:
					case EFFECT_RAW_BUFF_RESISTANCE:
						TarStats.RESISTANCE -= value;
						break
					case EFFECT_BUFF_STRENGTH:
					case EFFECT_DAMAGE_TO_STRENGTH:
					case EFFECT_RAW_BUFF_STRENGTH:
						TarStats.STRENGTH -= value;
						break
					case EFFECT_BUFF_TP:
					case EFFECT_KILL_TO_TP:
					case EFFECT_RAW_BUFF_TP:
						TarStats.TP -= value
						TarStats.TOTAL_TP -= value
						break
					case EFFECT_BUFF_WISDOM:
					case EFFECT_RAW_BUFF_WISDOM:
						TarStats.WISDOM -= value;
						break
					case EFFECT_DAMAGE_RETURN:
						TarStats.DAMAGE_RETURN -= value;
						break
					case EFFECT_HEAL:
						TarStats.POISON += value
						TarStats.POISON_OVER_TIME += value * duration
						break
					case EFFECT_NOVA_DAMAGE_TO_MAGIC:
					case EFFECT_RAW_BUFF_MAGIC:
						TarStats.MAGIC -= value;
						break
					case EFFECT_POISON_TO_SCIENCE:
					case EFFECT_RAW_BUFF_SCIENCE:
						TarStats.SCIENCE -= value;
						break
					case EFFECT_RAW_BUFF_POWER:
						TarStats.POWER -= value;
						break
					case EFFECT_RAW_RELATIVE_SHIELD:
					case EFFECT_RELATIVE_SHIELD:
						TarStats.RELATIVE_SHIELD -= value;
						break
					case EFFECT_SHACKLE_AGILITY:
						TarStats.AGILITY += value;
						break
					case EFFECT_SHACKLE_MAGIC:
						TarStats.MAGIC += value;
						break
					case EFFECT_SHACKLE_MP:
						TarStats.MP += value
						TarStats.TOTAL_MP += value
						break
					case EFFECT_SHACKLE_STRENGTH:
						TarStats.STRENGTH += value;
						break
					case EFFECT_SHACKLE_TP:
						TarStats.TP += value
						TarStats.TOTAL_TP += value
						break
					case EFFECT_SHACKLE_WISDOM:
						TarStats.WISDOM += value;
						break
					case EFFECT_VULNERABILITY:
						TarStats.RELATIVE_SHIELD += value;
						break
				}
			}
		}
	}

	static RemoveCastedEffects(EveryStats, Caster) {
		for (var e: var stat in EveryStats) {
			for (var eff in stat.EFFECTS) {
				if (eff[2] == Caster) {
					// Dispatch via Switch (Dégage EffectsRemove)
					var type = eff[0]
					var value = eff[1]
					var duration = eff[3]
					switch (type) {
						case EFFECT_ABSOLUTE_SHIELD:
						case EFFECT_DAMAGE_TO_ABSOLUTE_SHIELD:
						case EFFECT_RAW_ABSOLUTE_SHIELD:
						case EFFECT_STEAL_ABSOLUTE_SHIELD:
							stat.ABSOLUTE_SHIELD -= value;
							break
						case EFFECT_ABSOLUTE_VULNERABILITY:
							stat.ABSOLUTE_SHIELD += value;
							break
						case EFFECT_AFTEREFFECT:
						case EFFECT_POISON:
							stat.POISON -= value
							stat.POISON_OVER_TIME -= value * duration
							if (type == EFFECT_POISON) {
								stat.JUST_POISON -= value
								stat.JUST_POISON_OVER_TIME -= value * duration
							}
							break
						case EFFECT_ALLY_KILLED_TO_AGILITY:
						case EFFECT_BUFF_AGILITY:
						case EFFECT_RAW_BUFF_AGILITY:
							stat.AGILITY -= value;
							break
						case EFFECT_BUFF_MP:
						case EFFECT_MOVED_TO_MP:
						case EFFECT_RAW_BUFF_MP:
							stat.MP -= value
							stat.TOTAL_MP -= value
							break
						case EFFECT_BUFF_RESISTANCE:
						case EFFECT_RAW_BUFF_RESISTANCE:
							stat.RESISTANCE -= value;
							break
						case EFFECT_BUFF_STRENGTH:
						case EFFECT_DAMAGE_TO_STRENGTH:
						case EFFECT_RAW_BUFF_STRENGTH:
							stat.STRENGTH -= value;
							break
						case EFFECT_BUFF_TP:
						case EFFECT_KILL_TO_TP:
						case EFFECT_RAW_BUFF_TP:
							stat.TP -= value
							stat.TOTAL_TP -= value
							break
						case EFFECT_BUFF_WISDOM:
						case EFFECT_RAW_BUFF_WISDOM:
							stat.WISDOM -= value;
							break
						case EFFECT_DAMAGE_RETURN:
							stat.DAMAGE_RETURN -= value;
							break
						case EFFECT_HEAL:
							stat.POISON += value
							stat.POISON_OVER_TIME += value * duration
							break
						case EFFECT_NOVA_DAMAGE_TO_MAGIC:
						case EFFECT_RAW_BUFF_MAGIC:
							stat.MAGIC -= value;
							break
						case EFFECT_POISON_TO_SCIENCE:
						case EFFECT_RAW_BUFF_SCIENCE:
							stat.SCIENCE -= value;
							break
						case EFFECT_RAW_BUFF_POWER:
							stat.POWER -= value;
							break
						case EFFECT_RAW_RELATIVE_SHIELD:
						case EFFECT_RELATIVE_SHIELD:
							stat.RELATIVE_SHIELD -= value;
							break
						case EFFECT_SHACKLE_AGILITY:
							stat.AGILITY += value;
							break
						case EFFECT_SHACKLE_MAGIC:
							stat.MAGIC += value;
							break
						case EFFECT_SHACKLE_MP:
							stat.MP += value
							stat.TOTAL_MP += value
							break
						case EFFECT_SHACKLE_STRENGTH:
							stat.STRENGTH += value;
							break
						case EFFECT_SHACKLE_TP:
							stat.TP += value
							stat.TOTAL_TP += value
							break
						case EFFECT_SHACKLE_WISDOM:
							stat.WISDOM += value;
							break
						case EFFECT_VULNERABILITY:
							stat.RELATIVE_SHIELD += value;
							break
					}
				}
			}
		}
	}

	static getKillConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster, EveryStats, AddTpEnhancedLightninger) {
		//Remove his Life
		TarStats.LIFE = 0
		var Killed = TarStats.ID
		//Then Remove his Effects Casted
		RemoveCastedEffects(EveryStats, Killed)
		//Then Remove his bulbs
		//Then Remove the bulb's casted effects
		for (var e: var stat in EveryStats) {
			if (stat.SUMMONER == Killed) { //TODO : Doesn't work on TarStats
				getKillConsequences(Dist, Multiplier, Effect, stat, CastStats, TarIsCaster, EveryStats, false)
			}
			if (stat.SPECIAL_WEAPON == WEAPON_ENHANCED_LIGHTNINGER && AddTpEnhancedLightninger) { //TODO: Redo clean
				stat.TOTAL_TP++
				stat.TP++
			} else {
				if (stat.SPECIAL_WEAPON == WEAPON_DARK_KATANA) stat.AGILITY += 100
			}
		}
		//Then add special effects (Like Dark Katana and Enhanced_Lightner) //TODO !

		//Adding Power : 
		var cp = ChestPower[TarStats.NAME]
		if (cp) CastStats.POWER += cp
		if (FIGHT_TYPE == FIGHT_TYPE_BATTLE_ROYALE) {
			if (TarStats.IS_SUMMON) {
				CastStats.POWER += 2 + floor(TarStats.POWER / 2)
			} else {
				CastStats.POWER += 10 + floor(TarStats.POWER / 2)
			}
		}
	}

	static ChestPower = [
		"wooden_chest": 10,
		"iron_chest": 50,
		"diamond_chest": 100
	]

	static getEntityDamageConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster, EveryStats) {
		var BaseDamages = getRealEffect(Effect, Dist, Multiplier) * (1 + CastStats.STRENGTH / 100) * (1 + CastStats.POWER / 100)
		var DamagesWithShield = max(0, BaseDamages * (1 - TarStats.RELATIVE_SHIELD / 100) - TarStats.ABSOLUTE_SHIELD)
		var TargetLife = TarStats.LIFE
		var Damage = min(DamagesWithShield, TargetLife) // Either the full damage or the Life (If Kill)
		if (Damage >= TargetLife && TargetLife > 0) {
			//debug("entered kill consequence")
			getKillConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster, EveryStats, true) //Killed so consequences
		} else {
			TarStats.LIFE -= Damage
		}
		TarStats.TOTAL_LIFE -= Damage * EROSION_NO_POISON
		if (!TarIsCaster) {
			var Damage_Return = BaseDamages * (TarStats.DAMAGE_RETURN / 100)
			CastStats.LIFE += min(Damage * (CastStats.WISDOM / 1000), CastStats.TOTAL_LIFE - CastStats.LIFE) - Damage_Return //Either the full heal or the leftover heal (If near full life) Then the damage return (applied like this in fights)
			//Then Damage Return Erosion
			CastStats.TOTAL_LIFE -= Damage_Return * EROSION_NO_POISON
		}

		// Dispatch via Switch (Dégage SpeMap)
		switch (TarStats.SPECIAL_WEAPON) {
			case WEAPON_REVOKED_M_LASER:
				TarStats.STRENGTH += Damage * 0.05;
				break
			case WEAPON_UNBRIDLED_GAZOR:
				TarStats.MAGIC += Damage * 0.01;
				break
			case WEAPON_MYSTERIOUS_ELECTRISOR:
				TarStats.ABSOLUTE_SHIELD += Damage * 0.05;
				break
		}
	}

	static getEntityRawBuffTpConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		var add = getRealEffect(Effect, Dist, Multiplier)
		TarStats.TP += add
		TarStats.TOTAL_TP += add
	}

	static getEntityAbsoluteShieldConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		TarStats.ABSOLUTE_SHIELD += getRealEffect(Effect, Dist, Multiplier) * (1 + CastStats.RESISTANCE / 100)
	}
	static getEntityAbsoluteVulnerabilityConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		TarStats.ABSOLUTE_SHIELD -= getRealEffect(Effect, Dist, Multiplier)
	}

	static getEntityAfterEffectConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		var add = getRealEffect(Effect, Dist, Multiplier) * (1 + CastStats.SCIENCE / 100) /* /!\ it can kills allies cuz its taking effect min and not max /!\ */
		TarStats.LIFE -= add
		TarStats.TOTAL_LIFE -= add * EROSION_NO_POISON //0.05 from actual damage then 5% from after effect poison, but stays over time so how ?
		TarStats.POISON += add //NO add to Just Poison cuz not Antidotable
		TarStats.POISON_OVER_TIME += add * Effect[3]
	}

	static getEntityAntidoteConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		TarStats.POISON -= TarStats.JUST_POISON
		TarStats.JUST_POISON = 0
		TarStats.POISON_OVER_TIME -= TarStats.JUST_POISON_OVER_TIME
		TarStats.JUST_POISON_OVER_TIME = 0
	}

