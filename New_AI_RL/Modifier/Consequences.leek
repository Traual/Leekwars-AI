	static getConsequences(State, Item, From, To, Caster, BaseHash) { //Need from for lasers 
		var Targets = ConsequenceTargets(Item, From, To, State, Caster, BaseHash)
		var CastStats = State[Caster]
		for (var Effect in ITEMINFO[Item].EFFECTS) {
			var EffectType = Effect[0]
			if (EffectType == EFFECT_SUMMON) {
				var Id = StateClass.getMaxUsedID(State)
				var EntityStats = new BulbState(Id, SUMMONER_LEVEL_TIMES, Item, To, Caster, CastStats)
				State[Id] = EntityStats
				continue
			} else if (EffectType == EFFECT_RESURRECT) {
				ResurrectionClass.Update(To, State)
				continue
			}
			var TmpTargets = RealConsequenceTargets(Targets, Effect, State, CastStats, Caster)
			var Multiplier = (Effect[5] & EFFECT_MODIFIER_MULTIPLIED_BY_TARGETS) ? mapSize(TmpTargets) : 1 //Saving Multiplier
			if (CastStats.AGILITY >= MIN_AGILITY_TO_FULLY_CRIT) Multiplier *= CRITICAL_FACTOR
			var RealTargets = Effect[5] & EFFECT_MODIFIER_ON_CASTER ? [Caster: 0] : TmpTargets
			ConsMap[EffectType](State, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) //TODO : CHECK AND ADD NEW EFFECTS LIKE LIFE STEAL
		}
	}

	static isHitable(Effect, TarStats, CastStats, TarIsCaster) { //Determine wether or not the effect can be put on target (for example : Burning on leek : false, Vaccin on Ally : True)
		if (TarStats.LIFE <= 0) return false
		var Eff4 = Effect[4]
		var TargetSide = TarStats.SIDE
		var CasterSide = CastStats.SIDE
		var binSidesEqual = TargetSide == CasterSide ? 1 : 0
		var binTarEqualCaster = TarIsCaster ? 1 : 0
		var binSummon = TarStats.IS_SUMMON ? 1 : 0
		var Hash = binTarEqualCaster << 36 | binSummon << 34 | binSidesEqual << 32 | Eff4
		if (Hash in IS_HITABLE_CACHE) return IS_HITABLE_CACHE[Hash]
		var Ally = (CasterSide == TargetSide)
		var Summ = TarStats.IS_SUMMON
		if ((!(Eff4 & EFFECT_TARGET_ALLIES) && Ally) || (!(Eff4 & EFFECT_TARGET_ENEMIES) && !Ally) || (!(Eff4 & EFFECT_TARGET_NON_SUMMONS) && !Summ) || (!(Eff4 & EFFECT_TARGET_SUMMONS) && Summ)) {
			IS_HITABLE_CACHE[Hash] = false
		} else {
			IS_HITABLE_CACHE[Hash] = !(!(Eff4 & EFFECT_TARGET_CASTER) && TarIsCaster)
		}
		return IS_HITABLE_CACHE[Hash]
	}

	static EffectsRemove = [
		EFFECT_ABSOLUTE_SHIELD: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.ABSOLUTE_SHIELD -= ValueOfEffect
		},
		EFFECT_ABSOLUTE_VULNERABILITY: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.ABSOLUTE_SHIELD += ValueOfEffect
		},
		EFFECT_AFTEREFFECT: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.POISON -= ValueOfEffect
			StatsTarget.POISON_OVER_TIME -= ValueOfEffect * DurationOfEffect
		},
		EFFECT_ALLY_KILLED_TO_AGILITY: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.AGILITY -= ValueOfEffect
		},
		EFFECT_BUFF_AGILITY: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.AGILITY -= ValueOfEffect
		},
		EFFECT_BUFF_MP: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
