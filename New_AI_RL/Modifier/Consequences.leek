	static ConsequenceTargets(Item, From, To, EveryStats, Me, BaseHash) {
		var Hash = ConsequenceTargetsHash(BaseHash, Item, From, To)
		if (Hash in CONSEQUENCE_TARGET_CACHE) return CONSEQUENCE_TARGET_CACHE[Hash]
		var Tars = [: ]
		FunctionMapForConsequenceTargets[ITEMINFO[Item].AREA](Tars, Item, From, To, EveryStats, Me)
		CONSEQUENCE_TARGET_CACHE[Hash] = Tars
		return Tars
	}

	static ConsequenceTargetsHash(BaseHash, Item, From, To) {//BaseHash is Cell:Id Hash
		// ——— INITIALISATION ———
		var hash_value = (OFFSET_BASIS ^ BaseHash)

		// ——— Item, From, To ———

		var combined = (Item << 30) | (From << 15) | To
		hash_value = addValueToBinHash(hash_value, combined)

		return hash_value
	}

	static RealConsequenceTargets(AllTargets, Effect, State, CastStats, Caster) {
		var _final = [: ]
		for (var tar: var dist in AllTargets) {
			if (isHitable(Effect, State[tar], CastStats, tar == Caster)) _final[tar] = dist
		}
		return _final
	}

	static getItemDanger(item, casterstats, targetstats, Distance, Multiplier) {
		var Info = ITEMINFO[item]
		if (!isHitable(Info.EFFECTS[0], targetstats, casterstats, false)) return 0 //Ugly for the effect part might redo it clean ?
		var _final = 0
		for (var eff in Info.EFFECTS) {
			if (eff[5] & EFFECT_MODIFIER_ON_CASTER) continue
			if (TmpMapForItemDanger[eff[0]]) _final += TmpMapForItemDanger[eff[0]](casterstats, targetstats, eff, Distance, Multiplier)
		}
		return _final
	}

	static TmpMapForItemDanger = [
		EFFECT_DAMAGE: function(casterstats, targetstats, Effect, Distance, Multiplier) {
			return ((Effect[2] * ConsequencesClass.DistToAoeNumber(Distance) * Multiplier * (1 + casterstats.POWER / 100)) * (1 + casterstats.STRENGTH / 100) * (1 - targetstats.RELATIVE_SHIELD / 100) - targetstats.ABSOLUTE_SHIELD)
		},
		EFFECT_LIFE_DAMAGE: function(casterstats, targetstats, Effect, Distance, Multiplier) {
			return ((Effect[2] * (1 + casterstats.POWER / 100)) * (casterstats.LIFE / 100) * (1 - targetstats.RELATIVE_SHIELD / 100) - targetstats.ABSOLUTE_SHIELD)
		},
		EFFECT_POISON: function(casterstats, targetstats, Effect, Distance, Multiplier) {
			return (Effect[2] * (1 + casterstats.POWER / 100)) * ConsequencesClass.DistToAoeNumber(Distance) * (1 + casterstats.MAGIC / 100) * min(Effect[3], targetstats.COOLDOWNS[CHIP_ANTIDOTE]+1)
		}
	]
}