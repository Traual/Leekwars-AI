		TarStats.ABSOLUTE_SHIELD += getRealEffect(Effect, Dist, Multiplier)
	}

	static getEntitySummonConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		debugW("Summon, special effect Not Handeled in consequences")
	}

	static getEntityVulnerabilityConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		//No Dist no Multiplier (Yet)
		TarStats.RELATIVE_SHIELD -= getRealEffect(Effect, Dist, Multiplier)
	}

	static getRealEffect(Effect, Dist, Multiplier) {
		return Effect[1] * DistToAoeNumber(Dist) * Multiplier
	}

	static DistToAoeNumber(dist) {
		return 1 - (dist * 0.2)
	}

	static FunctionMapForConsequenceTargets = [
			AREA_CIRCLE_1: function(_final, Item, From, To, EveryStats, Me) {
				var MapAoe = ActionsClass.AoeDistItem(Item, To)//TODO : Fct all this with MapAoe in Param So its easier to change things
				var MapFrom = MapAoe[From]
				if (MapFrom != null) _final[Me] = MapFrom
				for (var e: var stat in EveryStats) { //I can't put MapAoe[stat.CELL] cuz it can be 0 dist so i need != null
					if (e == Me || stat.LIFE <= 0) continue
					var Dist = MapAoe[stat.CELL]
					if (Dist != null) _final[e] = Dist
				}
			},
			AREA_CIRCLE_2: function(_final, Item, From, To, EveryStats, Me) {
				var MapAoe = ActionsClass.AoeDistItem(Item, To)
				var MapFrom = MapAoe[From]
				if (MapFrom != null) _final[Me] = MapFrom
				for (var e: var stat in EveryStats) {
					if (e == Me || stat.LIFE <= 0) continue
					var Dist = MapAoe[stat.CELL]
					if (Dist != null) _final[e] = Dist
				}
			},
			AREA_CIRCLE_3: function(_final, Item, From, To, EveryStats, Me) {
