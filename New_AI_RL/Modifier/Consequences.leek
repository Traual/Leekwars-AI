	static getEntityDamageReturnConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		/* Multiplier*/ //No multiplier (yet)
		TarStats.DAMAGE_RETURN += getRealEffect(Effect, Dist, Multiplier) * (1 + CastStats.AGILITY / 100)
	}

	static getEntityDebuffConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		//FIRST We Remove 40% Of Every Shackles
		var DebuffPower = getRealEffect(Effect, Dist, Multiplier) / 100
		TarStats.TO_SAVE_SHACKLE_AGILITY *= DebuffPower
		TarStats.TO_SAVE_SHACKLE_MAGIC *= DebuffPower
		//TarStats.TO_SAVE_SHACKLE_MP *= DebuffPower
		TarStats.TO_SAVE_SHACKLE_TOTAL_MP *= DebuffPower
		TarStats.TO_SAVE_SHACKLE_STRENGTH *= DebuffPower
		//TarStats.TO_SAVE_SHACKLE_TP *= DebuffPower
		TarStats.TO_SAVE_SHACKLE_TOTAL_TP *= DebuffPower
		TarStats.TO_SAVE_SHACKLE_WISDOM *= DebuffPower
		//THEN We Remove 40% Of Every stats that are at 0 initially :
		TarStats.ABSOLUTE_SHIELD *= DebuffPower
		TarStats.RELATIVE_SHIELD *= DebuffPower
		TarStats.DAMAGE_RETURN *= DebuffPower
		TarStats.POISON *= DebuffPower
		TarStats.JUST_POISON *= DebuffPower
		TarStats.POISON_OVER_TIME *= DebuffPower
		TarStats.JUST_POISON_OVER_TIME *= DebuffPower
		//THEN We Remove 40% Of Every Others stats that can be different from 0
		DebuffPower = 1 - DebuffPower //Cuz its not *= now its divided
		TarStats.STRENGTH -= (TarStats.STRENGTH - TarStats.TO_SAVE_STRENGTH) * DebuffPower
		TarStats.WISDOM -= (TarStats.WISDOM - TarStats.TO_SAVE_WISDOM) * DebuffPower
		TarStats.AGILITY -= (TarStats.AGILITY - TarStats.TO_SAVE_AGILITY) * DebuffPower
		TarStats.RESISTANCE -= (TarStats.RESISTANCE - TarStats.TO_SAVE_RESISTANCE) * DebuffPower
		TarStats.SCIENCE -= (TarStats.SCIENCE - TarStats.TO_SAVE_SCIENCE) * DebuffPower
		TarStats.MAGIC -= (TarStats.MAGIC - TarStats.TO_SAVE_MAGIC) * DebuffPower
		TarStats.MP -= (TarStats.TOTAL_MP - TarStats.TO_SAVE_TOTAL_MP) * DebuffPower
		TarStats.TOTAL_MP -= (TarStats.TOTAL_MP - TarStats.TO_SAVE_TOTAL_MP) * DebuffPower
		TarStats.TP -= (TarStats.TOTAL_TP - TarStats.TO_SAVE_TOTAL_TP) * DebuffPower
		TarStats.TOTAL_TP -= (TarStats.TOTAL_TP - TarStats.TO_SAVE_TOTAL_TP) * DebuffPower
	}

	static getEntityHealConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		if (TarStats.LIFE <= 0) return;
		var add = getRealEffect(Effect, Dist, Multiplier) * (1 + CastStats.WISDOM / 100)
		if (Effect[3] > 0) { //not Var Eff3 cuz it is rare to go into if, it will save 1 ops when in if and waste 1 when not in if
			TarStats.POISON -= add
			TarStats.POISON_OVER_TIME -= add * Effect[3]
		} else {
			TarStats.LIFE += min(add, TarStats.TOTAL_LIFE - TarStats.LIFE)
		}
	}

	static getEntityLifeDamageConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster, EveryStats) {
		//base Damages for damage return and loading real damages
		var BaseDamages = getRealEffect(Effect, Dist, Multiplier) * (CastStats.LIFE / 100) * (1 + CastStats.POWER / 100)
		//Real damages input
		var InitialDamages = max(0, BaseDamages * (1 - TarStats.RELATIVE_SHIELD / 100) - TarStats.ABSOLUTE_SHIELD)
		var TargetLife = TarStats.LIFE
		var Damage = min(InitialDamages, TargetLife) // Either the full damage or the Life (If Kill) No DIST and No MULTIPLIER (Yet)
		if (Damage >= TargetLife && TargetLife > 0) { //Adding Kills Effects
			getKillConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster, EveryStats, true) //Killed so consequences
		} else { //Or Just Removing Life
			TarStats.LIFE -= Damage
		}
		TarStats.TOTAL_LIFE -= Damage * EROSION_NO_POISON //adding Erosion
		if (!TarIsCaster) {
			var Damage_Return = BaseDamages * (TarStats.DAMAGE_RETURN / 100)
			CastStats.LIFE -= Damage_Return // damage return
			//Then Damage Return Erosion
			CastStats.TOTAL_LIFE -= Damage_Return * EROSION_NO_POISON
		}
		//Then Special Items
		var fct = SpeMap[TarStats.SPECIAL_WEAPON]
		if (fct != null) SpeMap[TarStats.SPECIAL_WEAPON](TarStats, Damage)
	}

	static getEntityNovaDamageConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		var Damage = min(getRealEffect(Effect, Dist, Multiplier) * (1 + CastStats.SCIENCE / 100), TarStats.TOTAL_LIFE - TarStats.LIFE) // No MULTIPLIER (Yet)
		TarStats.TOTAL_LIFE -= Damage
		if (!TarIsCaster) {
			var fct = SpeMapNova[TarStats.SPECIAL_WEAPON]
			if (fct != null) SpeMapNova[TarStats.SPECIAL_WEAPON](TarStats, Damage)
		}
	}

