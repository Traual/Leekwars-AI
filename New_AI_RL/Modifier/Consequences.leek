	static getRealEffect(Effect, Dist, Multiplier) {
		return Effect[1] * DistToAoeNumber(Dist) * Multiplier
	}

	static DistToAoeNumber(dist) {
		return 1 - (dist * 0.2)
	}

	static ConsequenceTargets(Item, From, To, EveryStats, Me, BaseHash) {
		var Hash = ConsequenceTargetsHash(BaseHash, Item, From, To)
		if (Hash in CONSEQUENCE_TARGET_CACHE) return CONSEQUENCE_TARGET_CACHE[Hash]

		var Tars = [: ]
		var area = ITEMINFO[Item].AREA

		// Dispatch via Switch (Dégage FunctionMapForConsequenceTargets)
		switch (area) {
			case AREA_CIRCLE_1:
			case AREA_CIRCLE_2:
			case AREA_CIRCLE_3:
			case AREA_PLUS_2:
			case AREA_PLUS_3:
			case AREA_POINT:
			case AREA_SQUARE_1:
			case AREA_SQUARE_2:
			case AREA_X_1:
			case AREA_X_2:
			case AREA_X_3:
				var MapAoe = ActionsClass.AoeDistItem(Item, To)
				var MapFrom = MapAoe[From]
				if (MapFrom != null) Tars[Me] = MapFrom
				for (var e: var stat in EveryStats) {
					if (e == Me || stat.LIFE <= 0) continue
					var Dist = MapAoe[stat.CELL]
					if (Dist != null) Tars[e] = (area == AREA_POINT ? 0 : Dist)
				}
				break
			case AREA_FIRST_INLINE:
				var MapEntity = [: ]
				for (var e: var stat in EveryStats) {
					if (e != Me && stat.LIFE >= 0) MapEntity[stat.CELL] = true
				}
				var MapAoe = From == To ? [From: true] : CellClass.getFirstInlineAoe(From, To, ITEMINFO[Item].MINRANGE, ITEMINFO[Item].MAXRANGE, MapEntity)
				for (var e: var stat in EveryStats) {
					if (MapAoe[stat.CELL]) Tars[e] = 0
				}
				break
			case AREA_LASER_LINE:
				var MapAoe = From == To ? [From: true] : CellClass.getLaserAoe(From, To, ITEMINFO[Item].MINRANGE, ITEMINFO[Item].MAXRANGE)
				for (var e: var stat in EveryStats) {
					if (e == Me || stat.LIFE <= 0) continue
					if (MapAoe[stat.CELL]) Tars[e] = 0
				}
				break
		}

		CONSEQUENCE_TARGET_CACHE[Hash] = Tars
		return Tars
	}

	static ConsequenceTargetsHash(BaseHash, Item, From, To) { //BaseHash is Cell:Id Hash
		// ——— INITIALISATION ———
		var hash_value = (OFFSET_BASIS ^ BaseHash)

		// ——— Item, From, To ———

		var combined = (Item << 30) | (From << 15) | To
		hash_value = addValueToBinHash(hash_value, combined)

		return hash_value
	}

	static RealConsequenceTargets(AllTargets, Effect, State, CastStats, Caster) {
		var _final = [: ]
		for (var tar: var dist in AllTargets) {
			if (isHitable(Effect, State[tar], CastStats, tar == Caster)) _final[tar] = dist
		}
		return _final
	}

	static getItemDanger(item, casterstats, targetstats, Distance, Multiplier) {
		var Info = ITEMINFO[item]
		if (!isHitable(Info.EFFECTS[0], targetstats, casterstats, false)) return 0
		var _final = 0
		for (var eff in Info.EFFECTS) {
			if (eff[5] & EFFECT_MODIFIER_ON_CASTER) continue

			// Dispatch via Switch (Dégage TmpMapForItemDanger)
			var type = eff[0]
			switch (type) {
				case EFFECT_DAMAGE:
					_final += ((eff[2] * ConsequencesClass.DistToAoeNumber(Distance) * Multiplier * (1 + casterstats.POWER / 100)) * (1 + casterstats.STRENGTH / 100) * (1 - targetstats.RELATIVE_SHIELD / 100) - targetstats.ABSOLUTE_SHIELD)
					break
				case EFFECT_LIFE_DAMAGE:
					_final += ((eff[2] * (1 + casterstats.POWER / 100)) * (casterstats.LIFE / 100) * (1 - targetstats.RELATIVE_SHIELD / 100) - targetstats.ABSOLUTE_SHIELD)
					break
				case EFFECT_POISON:
					_final += (eff[2] * (1 + casterstats.POWER / 100)) * ConsequencesClass.DistToAoeNumber(Distance) * (1 + casterstats.MAGIC / 100) * min(eff[3], targetstats.COOLDOWNS[CHIP_ANTIDOTE] + 1)
					break
			}
		}
		return _final
	}

}