		// No MULTIPLIER (Yet)
		TarStats.TOTAL_LIFE += getRealEffect(Effect, Dist, Multiplier) * (1 + CastStats.SCIENCE / 100)
	}

	static getEntityPoisonConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		var Damage = getRealEffect(Effect, Dist, Multiplier) * (1 + CastStats.MAGIC / 100) // No MULTIPLIER (Yet)
		TarStats.POISON += Damage
		TarStats.JUST_POISON += Damage
		var OverTime = Effect[3] * Damage
		TarStats.POISON_OVER_TIME += OverTime
		TarStats.JUST_POISON_OVER_TIME += OverTime
	}

