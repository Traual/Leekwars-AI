				}
			},
			AREA_POINT: function(_final, Item, From, To, EveryStats, Me) {
				var MapAoe = ActionsClass.AoeDistItem(Item, To)
				var MapFrom = MapAoe[From]
				if (MapFrom != null) _final[Me] = MapFrom
				for (var e: var stat in EveryStats) {
					if (e == Me || stat.LIFE <= 0) continue
					if (MapAoe[stat.CELL] != null) _final[e] = 0 //FORCED cuz point
				}
			},
			AREA_SQUARE_1: function(_final, Item, From, To, EveryStats, Me) {
				var MapAoe = ActionsClass.AoeDistItem(Item, To)
				var MapFrom = MapAoe[From]
