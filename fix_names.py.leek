import os

root = r"c:\Users\aurel\Leekwars-AI\Random\IA_LaSoupe\Ancienne"
for filename in os.listdir(root):
    if filename.endswith(" ") or "\xa0" in filename or " " in filename:
        old_path = os.path.join(root, filename)
        # Use \\?\ for long paths and trailing spaces
        long_old_path = "\\\\?\\" + old_path
        
        new_filename = filename.strip().replace(" ", "_").replace("\xa0", "_")
        if not new_filename.endswith(".leek"):
            new_filename += ".leek"
        
        new_path = os.path.join(root, new_filename)
        long_new_path = "\\\\?\\" + new_path
        
        print(f"Renaming {filename!r} to {new_filename!r}")
        try:
            os.rename(long_old_path, long_new_path)
        except Exception as e:
            print(f"Failed: {e}")
