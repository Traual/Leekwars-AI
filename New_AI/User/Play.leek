/*
 * Boucle de jeu du tour : joue la meilleure action tant qu'il y en a une,
 * puis va se placer sur la meilleure cellule finale.
 */

include("../includes.leek")

class Play {

	constructor() {
		// Pas de ReloadCacheNewTurn ici : Main l'exécute AVANT Preload.InitStateClass, et cet
		// ordre est porteur — InitStateClass peuple des globals de tour entier (inventaires via
		// TARGETABLECACHE) qui ne doivent pas dériver d'entrées du tour précédent.
		// Compteur local au tour des échecs d'exécution RÉELLE, clé descriptive : le PREMIER
		// échec d'une clé replanifie normalement (debug conservé, auto-guérison si l'état
		// réel a bougé — cellule/TP/MP/arme dans la clé), le DEUXIÈME échec identique arrête
		// la boucle d'actions (pas de replans impossibles en boucle) sans toucher au BFS.
		var failCounts = [: ]
		while (true) {
			var State = StateClass.Virtualize()
			// Ancre de replan : ma vraie cellule actuelle — meilleure estimation de ma cellule
			// de fin de tour pour la couverture antidote, converge au fil des actions réelles.
			// Portée par la POISON_KEY : les maps de l'ancienne ancre deviennent injoignables.
			MY_REPLAN_CELL = State[Me].CELL
			MY_REPLAN_CELL_HASH = mix64(MY_REPLAN_CELL)
			// Importance recalculée à CHAQUE replan réel (un buff/shackle réellement exécuté
			// devient visible), puis FIGÉE pendant tout le BFS qui suit — jamais vidée dans
			// les nœuds ni entre branches. Quelques centaines d'opés, négligeable vs le BFS.
			IMPORTANCE_BY_ID = [: ]
			// Les caches de placement portent cette importance et ma valeur de covid : ils ne
			// survivent au replan que si ni l'une ni l'autre n'a bougé.
			ReloadPlacementCacheNewPlan(State)
			// Poids de CETTE planification : construits une fois, immuables ensuite. Le choix
			// entre formule historique et réseau se fait ICI et nulle part ailleurs.
			var mySide = State[Me].SIDE
			REPLAN_WEIGHTS = CONTEXTUAL_WEIGHTS_ENABLED
				? ContextualWeightNetworkClass.build(State, mySide)
				: HistoricalWeightsFactory.build(State, mySide)
			var Action = ActionSuite.getBestAction(State)
			if (Action == null) break
			var From = Action.From
			var Item = Action.Item
			var To = Action.To
			var TmpBaseHash = StateClass.getBaseHash(State)
			debug("Using : " + ITEMINFO[Item].NAME + " from : " + From + " to : " + To)
			var moveRes = WalkCellsClass.MoveTo(From, State, TmpBaseHash)
			// Déplacement raté -> l'item n'est PAS lancé.
			var res = moveRes[0] ? executeAction(Action) : moveRes
			if (!res[0]) {
				var failKey = res[1] + "|" + res[2] + "|" + Item + "|" + From + "|" + To
					+ "|" + Action.RESURRECT_ID + "|" + getCell() + "|" + getTP() + "|" + getMP() + "|" + getWeapon()
				var seen = (failKey in failCounts) ? failCounts[failKey] : 0
				failCounts[failKey] = seen + 1
				if (seen == 0) {
					debugE("[FAIL] " + failKey + " -> replan")
				} else {
					debugE("[FAIL x2] " + failKey + " -> abandon des actions, placement final")
					break
				}
			}
		}
		// Plus rien à jouer : re-capture l'état réel et choisit la cellule de fin de tour.
		var State = StateClass.Virtualize()
		var this_Base_Hash = StateClass.getBaseHash(State)
		var this_Final_Cell = FinalCell.get(State, this_Base_Hash)
		var finalMove = WalkCellsClass.MoveTo(this_Final_Cell, State, this_Base_Hash)
		// Échec du placement final : seulement loggé — aucune nouvelle boucle ici.
		if (!finalMove[0]) debugE("[FAIL] MoveTo final " + finalMove[1] + " code " + finalMove[2] + " cell " + getCell() + " -> visait " + this_Final_Cell)
	}

	/*
	 * Exécute l'action (item classique, summon ou résurrection) et renvoie
	 * [succès, phase, code moteur] : un résultat <= 0 (USE_FAILED = 0 compris) est un ÉCHEC.
	 */
	executeAction(Action) {
		var Item = Action.Item
		var To = Action.To
		var ItemEffects = ITEMINFO[Item].EFFECTS
		if (ItemEffects[0][0] != EFFECT_SUMMON && ItemEffects[0][0] != EFFECT_RESURRECT) {
			return useItem(Item, To)
		}
		if (count(ItemEffects) > 1) debugW("Summon or Resu and Multiple Effects ?! Outdated play in execute Action")
		if (ItemEffects[0][0] != EFFECT_RESURRECT) {
			var r = summon(Item, To, Bulb.AI)
			if (r <= 0) return [false, "summon", r]
			return [true, null, 0]
		}
		// Le MÊME candidat que la planification (payload de l'action) : entre la
		// décision et le cast, seul Me a bougé, et le choix du mort n'en dépend pas.
		debugC("Resurrecting entity " + Action.RESURRECT_ID, COLOR_GREEN)
		var r = resurrect(Action.RESURRECT_ID, To)
		if (r <= 0) return [false, "resurrect", r]
		return [true, null, 0]
	}

	/*
	 * Utilise l'item (équipe l'arme si besoin), chip ou arme, et renvoie
	 * [succès, phase, code]. Un swap d'arme raté (setWeapon renvoie un booléen)
	 * n'enchaîne PAS l'attaque.
	 */
	useItem(Item, To) {
		if (ITEMINFO[Item].IS_WEAPON) {
			if (getWeapon() != Item) {
				if (!setWeapon(Item)) return [false, "setWeapon", 0]
			}
			var r = useWeaponOnCell(To)
			if (r <= 0) return [false, "useWeapon", r]
			return [true, null, 0]
		}
		var r = useChipOnCell(Item, To)
		if (r <= 0) return [false, "useChip", r]
		return [true, null, 0]
	}
}
