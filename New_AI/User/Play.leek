/*
 * Boucle de jeu du tour : joue la meilleure action tant qu'il y en a une,
 * puis va se placer sur la meilleure cellule finale.
 */

include("../includes.leek")

class Play {

	constructor() {
		// Pas de ReloadCacheNewTurn ici : Main l'exécute AVANT Preload.InitStateClass, et cet
		// ordre est porteur — InitStateClass peuple des globals de tour entier (inventaires via
		// TARGETABLECACHE) qui ne doivent pas dériver d'entrées du tour précédent.
		// Compteur local au tour des échecs d'exécution RÉELLE, clé descriptive : le PREMIER
		// échec d'une clé replanifie normalement (debug conservé, auto-guérison si l'état
		// réel a bougé — cellule/TP/MP/arme dans la clé), le DEUXIÈME échec identique arrête
		// la boucle d'actions (pas de replans impossibles en boucle) sans toucher au BFS.
		var failCounts = [: ]
		// Plafond du moteur, lu une seule fois par combat : getCores() vaut 15 operations et,
		// dans un bulbe, rendrait SES coeurs alors que le compteur est celui de l'invocateur.
		if (OPS_CAP == null) OPS_CAP = getCores() * 1000000
		// Chaine du dernier plan, remise a zero a chaque tour : la vidange ne doit jamais
		// rejouer celle d'un autre tour ni celle d'une autre entite (poireau et bulbes
		// partagent la VM, donc les globals).
		BFS_LAST_CHAIN = []
		var showCoefficients = ScoringDebug.ENABLED
		while (true) {
			var State = StateClass.Virtualize()
			if (showCoefficients) {
				ScoringDebug.coefficients(State)
				showCoefficients = false // Une fois par tour, pas à chaque action réelle.
			}
			// Date limite du tour, recalculee a chaque action reelle : le nombre de bulbes
			// vivants change quand j'en invoque un ou qu'il meurt, et chacun cherchera apres
			// moi dans ce meme compteur.
			OPS_DEADLINE = OPS_CAP - OPS_RESERVE_TURN - StateClass.countSummonsAfterMe(State) * OPS_RESERVE_PER_BULB
			// Plus de quoi PLANIFIER : la chaine du dernier plan porte encore des actions,
			// on les joue avant de se placer plutot que de laisser les TP intacts.
			//
			// MESURE : s'arreter PLUS TOT, des qu'un plan de plus ne tient pas, pour jouer la
			// chaine a la place, PERD — difference appariee -0,366 +/- 0,144 (t = -2,55) a
			// 9-12 cœurs, malgre 2,97 actions par tour de poireau contre 2,42 et deux fois
			// moins d'avortements. Replanifier apres chaque action vaut donc plus que jouer
			// des actions estimees sur un etat perime. La vidange ne sert que quand aucun plan
			// n'est plus finançable du tout.
			if (getOperations() > OPS_DEADLINE) {
				drainChain(StateClass.countSummonsAfterMe(State))
				break
			}
			var Action = ActionSuite.getBestAction(State)
			if (Action == null) break
			var From = Action.From
			var Item = Action.Item
			var To = Action.To
			var TmpBaseHash = StateClass.getBaseHash(State)
			debug("Using : " + ITEMINFO[Item].NAME + " from : " + From + " to : " + To)
			var moveRes = WalkCellsClass.MoveTo(From, State, TmpBaseHash)
			// Déplacement raté -> l'item n'est PAS lancé.
			var opsBeforeExec = getOperations()
			var res = moveRes[0] ? executeAction(Action) : moveRes
			// Le plus cher deplacement-puis-lancer du combat : c'est la marge que la vidange
			// exige avant de tenter une action de plus.
			var execCost = getOperations() - opsBeforeExec
			if (execCost > OPS_EXEC_MAX) OPS_EXEC_MAX = execCost
			if (!res[0]) {
				var failKey = res[1] + "|" + res[2] + "|" + Item + "|" + From + "|" + To
					+ "|" + Action.RESURRECT_ID + "|" + getCell() + "|" + getTP() + "|" + getMP() + "|" + getWeapon()
				var seen = (failKey in failCounts) ? failCounts[failKey] : 0
				failCounts[failKey] = seen + 1
				if (seen == 0) {
					debugE("[FAIL] " + failKey + " -> replan")
				} else {
					debugE("[FAIL x2] " + failKey + " -> abandon des actions, placement final")
					break
				}
			}
		}
		// Plus rien à jouer : re-capture l'état réel et choisit la cellule de fin de tour.
		var State = StateClass.Virtualize()
		var this_Base_Hash = StateClass.getBaseHash(State)
		var this_Final_Cell = FinalCell.get(State, this_Base_Hash)
		var finalMove = WalkCellsClass.MoveTo(this_Final_Cell, State, this_Base_Hash)
		// Échec du placement final : seulement loggé — aucune nouvelle boucle ici.
		if (!finalMove[0]) debugE("[FAIL] MoveTo final " + finalMove[1] + " code " + finalMove[2] + " cell " + getCell() + " -> visait " + this_Final_Cell)
	}

	/*
	 * Exécute l'action (item classique, summon ou résurrection) et renvoie
	 * [succès, phase, code moteur] : un résultat <= 0 (USE_FAILED = 0 compris) est un ÉCHEC.
	 */
	/*
	 * Joue la suite de la chaine du dernier plan, sans replanifier. Appelee quand le budget
	 * ne finance plus une recherche : le choix est alors entre des actions estimees sur un
	 * etat d'il y a un coup, et aucune action du tout.
	 *
	 * Le financement ne vient PAS d'une reserve agrandie : OPS_RESERVE_TURN borne la
	 * planification, OPS_RESERVE_PLACEMENT borne le placement final, et l'ecart entre les deux
	 * est ce que la vidange a le droit de depenser. Chaque action verifie qu'elle tient dans
	 * cet ecart AVANT de virtualiser, avec la marge du pire pas deja mesure.
	 */
	drainChain(livingSummons) {
		// La chaine ne contient QUE des actions non jouees : BFS l'arrete avant la racine
		// (`while (ancestor.PARENT != null)`), et cette racine a deja ete executee par la
		// boucle de Play au tour de planification precedent. L'indice 0 est donc la prochaine
		// action a jouer, pas une action deja passee : partir de 1 en sautait une a chaque
		// vidange, et s'arreter sous deux n'en jouait aucune quand il n'en restait qu'une.
		var n = count(BFS_LAST_CHAIN)
		if (n < 1) return;
		var limit = OPS_CAP - OPS_RESERVE_PLACEMENT - livingSummons * OPS_RESERVE_PER_BULB
		for (var i = 0; i < n; i++) {
			var opsBefore = getOperations()
			if (opsBefore + OPS_EXEC_MAX > limit) return;
			var State = StateClass.Virtualize()
			var Action = BFS_LAST_CHAIN[i]
			var BaseHash = StateClass.getBaseHash(State)
			var moveRes = WalkCellsClass.MoveTo(Action.From, State, BaseHash)
			if (!moveRes[0]) return;
			var res = executeAction(Action)
			if (!res[0]) return;
			debugC("[VIDANGE] " + ITEMINFO[Action.Item].NAME + " depuis " + Action.From, COLOR_GREEN)
			var stepCost = getOperations() - opsBefore
			if (stepCost > OPS_EXEC_MAX) OPS_EXEC_MAX = stepCost
			// Une invocation jouee ici cherchera dans ce meme compteur : sa part est due.
			// L'etat virtualise date d'AVANT le lancer, il ne la contient pas : on la compte
			// sur l'effet de l'item, pas sur l'etat.
			if (ITEMINFO[Action.Item].EFFECTS[0][0] == EFFECT_SUMMON) limit = limit - OPS_RESERVE_PER_BULB
		}
	}

	executeAction(Action) {
		var Item = Action.Item
		var To = Action.To
		var ItemEffects = ITEMINFO[Item].EFFECTS
		if (ItemEffects[0][0] != EFFECT_SUMMON && ItemEffects[0][0] != EFFECT_RESURRECT) {
			return useItem(Item, To)
		}
		if (count(ItemEffects) > 1) debugW("Summon or Resu and Multiple Effects ?! Outdated play in execute Action")
		if (ItemEffects[0][0] != EFFECT_RESURRECT) {
			var r = summon(Item, To, Bulb.AI)
			if (r <= 0) return [false, "summon", r]
			return [true, null, 0]
		}
		// Le MÊME candidat que la planification (payload de l'action) : entre la
		// décision et le cast, seul Me a bougé, et le choix du mort n'en dépend pas.
		debugC("Resurrecting entity " + Action.RESURRECT_ID, COLOR_GREEN)
		var r = resurrect(Action.RESURRECT_ID, To)
		if (r <= 0) return [false, "resurrect", r]
		return [true, null, 0]
	}

	/*
	 * Utilise l'item (équipe l'arme si besoin), chip ou arme, et renvoie
	 * [succès, phase, code]. Un swap d'arme raté (setWeapon renvoie un booléen)
	 * n'enchaîne PAS l'attaque.
	 */
	useItem(Item, To) {
		if (ITEMINFO[Item].IS_WEAPON) {
			if (getWeapon() != Item) {
				if (!setWeapon(Item)) return [false, "setWeapon", 0]
			}
			var r = useWeaponOnCell(To)
			if (r <= 0) return [false, "useWeapon", r]
			return [true, null, 0]
		}
		var r = useChipOnCell(Item, To)
		if (r <= 0) return [false, "useChip", r]
		return [true, null, 0]
	}
}
