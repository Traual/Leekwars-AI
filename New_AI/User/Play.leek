/*
 * Boucle de jeu du tour : joue la meilleure action tant qu'il y en a une,
 * puis va se placer sur la meilleure cellule finale.
 */

include("../includes.leek")

class Play {

	constructor() {
		// Pas de ReloadCacheNewTurn ici : Main l'exécute AVANT Preload.InitStateClass, et cet
		// ordre est porteur — InitStateClass peuple des globals de tour entier (inventaires via
		// TARGETABLECACHE) qui ne doivent pas dériver d'entrées du tour précédent.
		while (true) {
			var State = StateClass.Virtualize()
			// Ancre de replan : ma vraie cellule actuelle — meilleure estimation de ma cellule
			// de fin de tour pour la couverture antidote, converge au fil des actions réelles.
			// Portée par la POISON_KEY : les maps de l'ancienne ancre deviennent injoignables.
			MY_REPLAN_CELL = State[Me].CELL
			MY_REPLAN_CELL_HASH = mix64(MY_REPLAN_CELL)
			// Importance recalculée à CHAQUE replan réel (un buff/shackle réellement exécuté
			// devient visible), puis FIGÉE pendant tout le BFS qui suit — jamais vidée dans
			// les nœuds ni entre branches. Quelques centaines d'opés, négligeable vs le BFS.
			IMPORTANCE_BY_ID = [: ]
			var Action = ActionSuite.getBestAction(State)
			if (Action == null) break
			var From = Action.From
			var Item = Action.Item
			var To = Action.To
			var TmpBaseHash = StateClass.getBaseHash(State)
			debug("Using : " + ITEMINFO[Item].NAME + " from : " + From + " to : " + To)
			WalkCellsClass.MoveTo(From, State, TmpBaseHash)
			executeAction(Action)
		}
		// Plus rien à jouer : re-capture l'état réel et choisit la cellule de fin de tour.
		var State = StateClass.Virtualize()
		var this_Base_Hash = StateClass.getBaseHash(State)
		var this_Final_Cell = FinalCell.get(State, this_Base_Hash)
		WalkCellsClass.MoveTo(this_Final_Cell, State, this_Base_Hash)
	}

	/* Exécute l'action quelle qu'elle soit : item classique, summon ou résurrection. */
	executeAction(Action) {
		var Item = Action.Item
		var To = Action.To
		var ItemEffects = ITEMINFO[Item].EFFECTS
		if (ItemEffects[0][0] != EFFECT_SUMMON && ItemEffects[0][0] != EFFECT_RESURRECT) {
			useItem(Item, To)
		} else {
			if (count(ItemEffects) > 1) debugW("Summon or Resu and Multiple Effects ?! Outdated play in execute Action")
			if (ItemEffects[0][0] != EFFECT_RESURRECT) {
				summon(Item, To, Bulb.AI)
			} else {
				// Le MÊME candidat que la planification (payload de l'action) : entre la
				// décision et le cast, seul Me a bougé, et le choix du mort n'en dépend pas.
				debugC("Resurrecting entity " + Action.RESURRECT_ID, COLOR_GREEN)
				resurrect(Action.RESURRECT_ID, To)
			}
		}
	}

	/* Utilise l'item (équipe l'arme si besoin), chip ou arme. */
	useItem(Item, To) {
		if (ITEMINFO[Item].IS_WEAPON) {
			if (getWeapon() != Item) setWeapon(Item)
			useWeaponOnCell(To)
		} else useChipOnCell(Item, To)
	}
}
