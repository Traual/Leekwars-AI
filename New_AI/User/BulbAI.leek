/*
 * IA des bulbes et des plantes. L'invocation s'exécute dans la VM DE L'INVOCATEUR (summon passe
 * une fonction de l'IA du propriétaire) : tous les globals et caches sont partagés.
 */

include("../includes.leek")

class Bulb {
	static AI() {
		// Plante : réveil ou tour vide, joué par une politique courte qui n'écrit AUCUNE globale.
		// Un réveil peut interrompre l'action de mon invocateur : relancer Play ici écraserait
		// Me, ses états virtuels et ses caches avant qu'il ne reprenne la main.
		if (getType() == ENTITY_PLANT) {
			PlantPolicy.playReal()
			return;
		}
		// Reset D'ABORD, puis InitStateClass — le même ordre porteur que Main. Au démarrage du
		// bulbe, les caches per-turn contiennent encore les entrées du tour du PROPRIÉTAIRE :
		// sans ce reset, le bulbe consommait les listes d'actions du proprio et tentait de
		// caster ses chips ("Cette puce n'est pas équipée").
		ReloadCacheNewTurn()
		Preload.InitStateClass()
		new Play()
	}
}
