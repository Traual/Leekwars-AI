/*
 * Sélecteur d'action par beam search, en DEUX temps.
 *
 * 1. EXPANSION, sur les scores BRUTS (aucun danger positionnel de Me) :
 *  - Profondeur 1 : chaque action jouable est clonée + appliquée + scorée, puis triée
 *    par PRIORITÉ décroissante (BFS_SCORE_PER_ACTION_COST : rendement par TP, ou Δscore).
 *  - À chaque profondeur, chaque parent propose jusqu'à BFS_BEAM_WIDTH successeurs
 *    jouables et positifs. Seuls les BFS_BEAM_WIDTH meilleurs états continuent.
 *    Les priorités cachées guident les essais ; chaque état retenu a un score courant.
 *  - Les gains de groupes sont partagés par signature de cibles pendant le tour,
 *    avec invalidation des dépendances après chaque vrai cast.
 *    Le catalogue géométrique est lié au board et à l'item ; son domaine grandit avec
 *    la mobilité du nœud. Les actions locales suivent sa cellule actuelle.
 *    Les gains cachés sont des estimations, pas des bornes.
 *  - Un nœud "ne rien jouer" (score initial) sert de plancher.
 *
 * 2. RECLASSEMENT TERMINAL : tout nœud visité est une suite où l'on PEUT s'arrêter. Chacun
 *    est reclassé par finalScore = rawScore − placementPenalty, où la pénalité vient de
 *    FinalCell — la même fonction que le placement réellement joué en fin de tour. node.SCORE
 *    reste le score brut de la recherche, il n'est jamais réécrit.
 *
 * Le meilleur nœud FINAL gagne ; on renvoie l'action de son premier ancêtre.
 */

include("../includes.leek")

// Nombre de steps d'expansion déroulés par le getBestAction courant (affiché dans "Best:").
global BFS_CHAIN_STEPS = 0

// Marge laissée sous la part stricte du placement quand le reclassement terminal cesse d'ouvrir
// des candidats : une évaluation commencée juste avant la limite doit encore y tenir. Elle couvre
// le plus cher bloc de fin de tour mesuré (82 861 opérations sur 49 tours d'entité).
global TERMINAL_EVAL_MARGIN = 100000

/*
 * Politique de choix du successeur à dérouler.
 *   true  : par RENDEMENT, priority = Δscore / coût RÉEL de l'action dans cet état — coût de
 *           l'item, changement d'arme, Saut, Téléportation, Saut + Téléportation compris.
 *   false : par Δscore absolu.
 * Le score d'un nœud reste ABSOLU dans les deux cas — le rendement ne sert qu'à classer.
 *
 * Le rendement est le bon critère : un budget de TP est FINI, donc ce qui compte n'est pas ce
 * qu'une action rapporte mais ce qu'elle rapporte par TP dépensé. Préférer 15 TP pour 3 de
 * score à 3 TP pour 2 est un défaut de critère, pas un compromis.
 *
 * Il coûte des opérations : privilégier les actions bon marché allonge les chaînes, donc
 * multiplie les nœuds. C'est une conséquence attendue du critère, pas un effet de bord.
 */
// Priorite de la recherche : Delta de score ABSOLU, pas le rendement par TP.
//
// Mesure du 2026-09-03, 480 combats aux builds du top 50, plan apparie (memes scenarios
// rejoues avec et sans) : le rendement par TP valait +0,048 de fitness et 53 % de victoires
// contre main, le Delta absolu vaut +0,209 +/- 0,035 et 57 %. L'ecart entre les deux est de
// +0,160 +/- 0,047 (t = +3,43), et les QUATRE bandes de cœurs sont positives (+0,267 a <= 8,
// +0,090 a 9-12, +0,187 a 13-16, +0,182 au-dessus de 16).
//
// Pourquoi : diviser par le cout fait remonter les petites actions bon marche en tete de
// chaine. Le glouton les joue, epuise ses TP en gains marginaux, et n'atteint plus la grosse
// action qui valait le tour. Le Delta absolu poursuit d'abord ce qui compte ; le cout reste
// pris en compte, mais par la chaine elle-meme, qui s'arrete quand les TP manquent.
global BFS_SCORE_PER_ACTION_COST = false

// Largeur maintenue à TOUTES les profondeurs, pour les parents et leurs successeurs.
global BFS_BEAM_WIDTH = 3
global BFS_DECISION_BUDGET_RATIO = 0.2
global BFS_DECISION_MIN_EXPANSION = 250000

class ActionSuite {

	/*
	 * Renvoie la meilleure action à jouer dans l'état donné (null = ne rien jouer).
	 */
	static getBestAction(State) {
		// Le plafond de tour appartient à Play. Une décision utilise seulement
		// une part de ce qui reste après sa préparation, pour pouvoir replanifier
		// après un vrai cast (critique, morts et effets réels compris).
		var turnDeadline = OPS_DEADLINE
		var action = searchBestAction(State)
		OPS_DEADLINE = turnDeadline
		return action
	}

	static searchBestAction(State) {
		BenchOps.Start("BFS")
		var MyStats = State[Me]
		var MySide = MyStats.SIDE
		var BaseHash = StateClass.getBaseHash(State)
		// Contexte caché par BaseHash, fixé avant tout score (résurrection incluse).
		// Reste constant dans l'arbre : seules les entités modifiées sont rescorrées.
		ROOT_SCORING_CONSTANTS = ScoringStateConstants.get(State, BaseHash)
		AllySupport.prepare(State)
		EnemyOffense.prepare(State, BaseHash)
		// Les quatre couches de mobilite servent a la recherche ET au deplacement de fin de tour.
		// Construites ici, elles sont chaudes quand le tour s'arrete ; sinon le placement puis le
		// deplacement les paient a froid avec la seule marge de deplacement, et le moteur coupe.
		var MyWalkCells = WalkCellsClass.getAllLayers(State, Me, BaseHash)
		var RootContext = DeltaClass.buildContextBySide(State)
		var RootHfp = HealClass.buildHfpBySide(State)
		var rootCombinedHfp = 0
		for (var s: var h in RootHfp) rootCombinedHfp ^= h
		// Fast-path racine : sous le coût du moindre item jouable du tour (même garde que
		// findBestNextNodes), aucune action de base n'existe — rien à chercher. Le tour se termine
		// donc ici, et le placement suit : on lui prépare ses structures avant de rendre la main.
		if (MyStats.TP < MINIMUM_COST_ITEM) {
			prewarmIfAffordable(State, BaseHash, RootContext, rootCombinedHfp, RootHfp[MySide])
			BenchOps.Stop("BFS")
			return null
		}
		var RootResurrectId = resurrectIdOf(State)
		prewarmIfAffordable(State, BaseHash, RootContext, rootCombinedHfp, RootHfp[MySide])
		// Empreinte de mobilité de Me à la racine : construite UNE fois par getBestAction
		// effectif, portée par noPlay et héritée par ses enfants. Elle sert aux caches de
		// géométrie et de placement — aucune valeur de scoring n'en dépend.
		var RootWalkFingerprint = WalkCellsClass.HashWalkCellsWithItemsWithoutBaseHash(MyStats)
		// La racine s'interrompt entre deux entités quand elle entame la part stricte du placement
		// final : le moteur qui la coupait emportait aussi le placement. Sans racine, aucune
		// décision : le placement prend la main.
		var rootValues = [:]
		var initialScore = ScoringClass.stateValue(State, MySide, OPS_CAP - OPS_RESERVE_PLACEMENT, rootValues)
		if (initialScore == null) {
			BenchOps.Stop("BFS")
			return null
		}

		// Les indications survivent au cast réel, les nœuds jamais. La racine continue
		// à simuler tous ses candidats : aucun score ancien ne devient un score exact.
		var SearchCache = TURN_ACTION_SEARCH_CACHE
		if (SearchCache == null) {
			SearchCache = new ActionSearchCacheClass()
			TURN_ACTION_SEARCH_CACHE = SearchCache
		}
		SearchCache.beginSearch(State, ROOT_SCORING_CONSTANTS)

		// noPlay = plancher "ne rien jouer" ET racine de la chaîne d'états.
		var noPlay = new NodeClass(null, State, null)
		noPlay.SCORE = initialScore
		noPlay.SCORE_VALUES = rootValues
		noPlay.BASE_HASH = BaseHash
		noPlay.ME_WALK_FINGERPRINT = RootWalkFingerprint
		// Métadonnées que le reclassement terminal lit sur TOUT candidat, plancher compris.
		noPlay.CONTEXT_BY_SIDE = RootContext
		noPlay.HFP_BY_SIDE = RootHfp
		noPlay.COMBINED_HFP = rootCombinedHfp
		// Racine des ÉTATS : elle seule porte la map complète d'office, patch vide.
		noPlay.STATE_PARENT = null
		noPlay.STATE_PATCH = [: ]

		// Les actions locales sont peu coûteuses à préparer : les scorer AVANT la
		// géométrie offensive. Une extension froide ne peut plus effacer leurs nœuds.
		var localPairs = getBaseActions(State, BaseHash, RootResurrectId, MyWalkCells, true)
		var rootEntries = enumerateAndSort(State, BaseHash, initialScore, MySide, RootContext, RootHfp, noPlay, MyWalkCells, localPairs, SearchCache)
		validateEarly(rootEntries, noPlay, SearchCache)
		if (getOperations() <= OPS_DEADLINE) {
			var otherPairs = getBaseActions(State, BaseHash, RootResurrectId, MyWalkCells, false, true)
			var known = [:]
			for (var entry in rootEntries) known[estimateKeyOf(entry.PLAYABLE)] = true
			var freshPairs = []
			for (var pair in otherPairs) if (!(estimateKeyOf(pair) in known)) push(freshPairs, pair)
			// La fusion est triée juste après : éviter un second tri des nouveaux candidats.
			// Le tri stable conserve le même ordre de création pour les priorités égales.
			pushAll(rootEntries, enumerateAndSort(State, BaseHash, initialScore, MySide, RootContext, RootHfp, noPlay, MyWalkCells, freshPairs, SearchCache, false, false))
			rootEntries = arraySort(rootEntries, function(a, b) { return b.PRIORITY - a.PRIORITY })
		}
		BFS_CHAIN_STEPS = 0
		debugC("--- " + count(rootEntries) + " base actions ---", COLOR_BLUE)
		var expansionStart = getOperations()
		var remaining = max(0, OPS_DEADLINE - expansionStart)
		var allowance = max(BFS_DECISION_MIN_EXPANSION, floor(remaining * BFS_DECISION_BUDGET_RATIO))
		OPS_DEADLINE = min(OPS_DEADLINE, expansionStart + allowance)
		debug("[BFS] expansion budget: " + min(remaining, allowance) + " operations (" + remaining + " remaining this turn)")

		// TOUT nœud retenu est une suite où l'on peut
		// s'arrêter : le plancher, chaque action racine retenue, et chaque nœud intermédiaire
		// du déroulé — pas seulement le dernier de chaque chaîne.
		var candidates = [noPlay]

		for (var entry in rootEntries) {
			// Une différée ne vaut rien dans CET état : ni candidat terminal, ni tête de chaîne.
			if (entry.DEFERRED) continue
			var baseNode = entry.NODE
			baseNode.SCORE = entry.SCORE
			push(candidates, baseNode)
		}
		var roots = []
		for (var entry in rootEntries) if (!entry.DEFERRED) push(roots, entry.NODE)
		var frontier = selectBeam(roots)
		while (count(frontier) > 0 && getOperations() <= OPS_DEADLINE) {
			var nextWave = []
			for (var parent in frontier) {
				if (getOperations() > OPS_DEADLINE) break
				var successors = findBestNextNodes(parent, SearchCache, MySide)
				if (count(successors) == 0) validateChain(parent, SearchCache)
				for (var next in successors) {
					push(candidates, next)
					BFS_CHAIN_STEPS++
					push(nextWave, next)
				}
			}
			frontier = selectBeam(nextWave)
		}
		BenchOps.Stop("BFS")
		debug("[BFS] group scores: " + SearchCache.NEW_SCORES + " computed, " + SearchCache.REUSED_SCORES + " reused, " + SearchCache.ORDER_HITS + " cached orders, " + SearchCache.RETAINED_ESTIMATES + " retained across casts")

		return pickTerminal(candidates, initialScore, count(rootEntries), SearchCache)
	}

	/* Garder UNE suite entièrement validée pendant que le budget est encore
	 * disponible. Même si la géométrie ou l'expansion consomme ensuite le reste,
	 * pickTerminal ne revient pas au brut ni au seul plan « ne rien jouer ».
	 * Aucun budget supplémentaire : mêmes limites et même évaluation terminale. */
	static validateEarly(entries, noPlay, SearchCache) {
		var limit = OPS_DEADLINE + OPS_RESERVE_TURN - OPS_RESERVE_PLACEMENT
		var deadline = limit - TERMINAL_EVAL_MARGIN
		for (var entry in entries) {
			if (getOperations() > deadline) break
			if (entry.DEFERRED || !canCloseNow(entry.NODE, limit)) continue
			var close = closeOf(entry.NODE, limit)
			if (count(close) != 3) break
			SearchCache.VALIDATED_NODE = entry.NODE
			SearchCache.VALIDATED_FINAL = entry.SCORE - close[1]
			return;
		}
		if (getOperations() <= deadline && canCloseNow(noPlay, limit)) {
			var close = closeOf(noPlay, limit)
			if (count(close) == 3) {
				SearchCache.VALIDATED_NODE = noPlay
				SearchCache.VALIDATED_FINAL = noPlay.SCORE - close[1]
			}
		}
	}

	// Clore une chaîne prometteuse pendant qu'il reste du budget, avant d'ouvrir
	// la suivante. Un plan déjà payé reste disponible si les branches froides
	// suivantes épuisent la recherche. Les nœuds intermédiaires restent candidats.
	static validateChain(node, SearchCache) {
		if (SearchCache.VALIDATED_NODE != null && node.SCORE <= SearchCache.VALIDATED_FINAL) return;
		var limit = OPS_DEADLINE
		if (getOperations() + TERMINAL_EVAL_MARGIN > limit || !canCloseNow(node, limit)) return;
		var close = closeOf(node, limit)
		if (count(close) != 3) return;
		var value = node.SCORE - close[1]
		if (SearchCache.VALIDATED_NODE == null || value > SearchCache.VALIDATED_FINAL) {
			SearchCache.VALIDATED_NODE = node
			SearchCache.VALIDATED_FINAL = value
		}
	}

	/*
	 * Construit ce que la fin de tour lira — plan de danger, carte de soin — tant que le budget
	 * couvre ce qui lui manque VRAIMENT (FinalCell.coldCost). Le score ne les lit plus : sans cet
	 * appel, la première clôture terminale ou le placement les paierait à froid en fin de tour, et
	 * le moteur couperait le tour dedans. En dessous, on s'abstient : le placement se rabattra sur
	 * son coût spatial plutôt que de se faire couper.
	 */
	static prewarmIfAffordable(State, BaseHash, contextBySide, combinedHfp, sideHfp = null) {
		if (getOperations() + FinalCell.coldCost(State, combinedHfp, sideHfp) <= OPS_CAP - OPS_RESERVE_PLACEMENT) {
			FinalCell.prewarm(State, BaseHash, contextBySide, combinedHfp, sideHfp)
		}
	}

	/*
	 * Reclassement terminal : chaque candidat est clos par FinalCell, qui rend la pénalité de
	 * son meilleur placement, et vaut finalScore = rawScore − placementPenalty.
	 *
	 * COUPURE EXACTE, sans epsilon : la pénalité est >= 0 par construction, donc
	 * finalScore <= rawScore. Les candidats étant parcourus par score BRUT décroissant, dès
	 * qu'un score brut ne bat plus le meilleur score final, aucun de ceux qui restent ne le
	 * pourra non plus. Une égalité parfaite de scores finaux garde le premier plan validé
	 * rencontré, y compris celui qui a été conservé avant l'expansion.
	 *
	 * @return l'action du premier ancêtre du meilleur candidat, null si le plancher gagne
	 */
	static pickTerminal(candidates, initialScore, nBases, SearchCache = null) {
		BenchOps.Start("Terminal")
		// Le meilleur score BRUT ouvre le parcours. Sa première clôture peut donner une
		// borne avant le tri ; si elle est impossible, d'autres candidats restent évaluables.
		var seed = candidates[0]
		var bestRaw = seed.SCORE
		for (var c in candidates) {
			if (c.SCORE > bestRaw) {
				bestRaw = c.SCORE
				seed = c
			}
		}
		// Date limite des évaluations terminales. Chacune peut coûter un balayage de placement
		// entier et aucune ne s'interrompt : on n'en ouvre plus une fois entamé ce que la suite du
		// tour doit trouver intact — la part stricte du placement final, celle des bulbes qui
		// jouent après moi, et la marge du plus cher balayage. Franchir le plafond moteur ici
		// tuait le tour entier : ni l'action choisie, ni le placement.
		// Une évaluation commencée avant cette date limite peut encore courir jusqu'à terminalLimit, où
		// son balayage se tronque : elle rend alors un majorant de sa pénalité, et le budget est épuisé.
		var terminalLimit = OPS_DEADLINE + OPS_RESERVE_TURN - OPS_RESERVE_PLACEMENT
		var terminalDeadline = terminalLimit - TERMINAL_EVAL_MARGIN
		var best = SearchCache == null ? null : SearchCache.VALIDATED_NODE
		var bestFinal = best == null ? 0 : SearchCache.VALIDATED_FINAL
		// Le même objet a déjà une clôture complète : son score final est connu.
		// Éviter les gardes, la matérialisation et la consultation du placement à nouveau.
		var seedValidated = best != null && seed == best
		if (!seedValidated && getOperations() <= terminalDeadline && canCloseNow(seed, terminalLimit)) {
			var seedClose = closeOf(seed, terminalLimit)
			if (count(seedClose) == 3) {
				seedValidated = true
				var seedFinal = bestRaw - seedClose[1]
				if (best == null || seedFinal > bestFinal) { best = seed; bestFinal = seedFinal }
			}
		}

		if (getOperations() <= terminalDeadline) {
			// Un candidat dont le score BRUT n'atteint pas déjà cette borne ne peut plus gagner : son
			// score final lui est inférieur ou égal. Les écarter AVANT le tri est ce qui compte —
			// le parcours n'en ouvre qu'une poignée, et trier des milliers de nœuds pour cela coûtait
			// plus cher que toutes les évaluations réunies. Sans validation, aucune borne : on
			// essaie les autres candidats tant que le budget le permet.
			var live = []
			for (var c in candidates) {
				if (best == null || c.SCORE >= bestFinal) push(live, c)
			}
			var sorted = arraySort(live, function(a, b) { return b.SCORE - a.SCORE })
			var n = count(sorted)
			for (var i = 0; i < n; i++) {
				// Même sans aucun plan clos, ne pas épuiser la réserve à tester des candidats.
				if (getOperations() > terminalDeadline) break
				var node = sorted[i]
				if (seedValidated && node == seed) continue // déjà clos, aucune seconde facture
				var raw = node.SCORE
				if (best != null && raw <= bestFinal) {
					break
				}
				// Reconstruction à froid non finançable : ce candidat reste non clos, les
				// suivants peuvent encore l'être.
				if (!canCloseNow(node, terminalLimit)) {
					continue
				}
				var close = closeOf(node, terminalLimit)

				// Balayage tronqué : le budget des évaluations est épuisé, on garde ce qui est déjà clos.
				if (count(close) > 3) {
					break
				}
				var finalScore = raw - close[1]
				if (best == null || finalScore > bestFinal) {
					best = node
					bestFinal = finalScore
				}
			}
		}
		// Une validation avec danger prime toujours sur les scores bruts non vérifiés.
		// La provenance suit la chaîne jusqu'à la vidange, sans recalculer le danger.
		BFS_LAST_CHAIN_DANGER_VALIDATED = best != null
		// Aucun candidat clos : ultime repli, annoncé explicitement.
		if (best == null) {
			debugW("[BFS] danger not taken into account: raw-score fallback")
			best = seed
			bestFinal = bestRaw
		}
		BenchOps.Stop("Terminal")

		if (best.ACTION == null) {
			BFS_LAST_CHAIN = []
			return null
		}
		// Chaine complete du meilleur candidat, de la racine vers la feuille. Play n'en joue
		// que la tete tant qu'il peut replanifier ; quand le budget ne finance plus un plan,
		// la suite se joue telle quelle plutot que de ne rien jouer du tout. Remontee bornee
		// par la longueur de chaine (mediane 2, maximum 7).
		var chain = []
		var ancestor = best
		while (ancestor.PARENT != null) {
			push(chain, ancestor.ACTION)
			ancestor = ancestor.PARENT
		}
		reverse(chain)   // en place : reverse ne rend rien
		BFS_LAST_CHAIN = chain
		debug("Best: " + ITEMINFO[ancestor.ACTION.Item].NAME + " | From: " + ancestor.ACTION.From + " | To: " + ancestor.ACTION.To + " | Delta: " + (bestFinal - initialScore) + " | " + nBases + " bases, " + BFS_CHAIN_STEPS + " steps")
		return ancestor.ACTION
	}

	/*
	 * Clôture d'un candidat par FinalCell : [cellule, pénalité, net], suivie de true si le balayage
	 * a été tronqué à truncateAt. Son état complet n'est reconstruit depuis sa chaîne de patches que
	 * s'il est réellement évalué (matérialisation paresseuse, puis cachée sur le nœud — la graine
	 * repasse ici sans rien recalculer).
	 */
	static closeOf(node, truncateAt) {
		var NodeState = StateClass.materializeNodeState(node)
		// Toujours avec le danger : canCloseNow a deja verifie qu'il est finançable.
		return FinalCell.evaluate(NodeState, node.BASE_HASH, node.CONTEXT_BY_SIDE, node.HFP_BY_SIDE, combinedHfpOf(node), node.ME_WALK_FINGERPRINT, truncateAt, true)
	}

	/*
	 * Fold des empreintes de soigneurs du nœud : clé de la carte de soin que FinalCell consomme.
	 * Le scoring ne la lit plus, elle n'est donc repliée que sur les nœuds qu'on envisage de clore.
	 */
	static combinedHfpOf(node) {
		if (node.COMBINED_HFP == null) {
			var combined = 0
			for (var s: var h in node.HFP_BY_SIDE) combined ^= h
			node.COMBINED_HFP = combined
		}
		return node.COMBINED_HFP
	}

	/*
	 * Peut-on ouvrir la clôture de ce candidat ? Une clôture qui doit reconstruire À FROID le
	 * plan de danger ou la carte de soin coûte des millions d'opérations et ne s'interrompt pas
	 * en route : sous cette marge, on laisse le candidat non clos plutôt que de faire tuer le
	 * tour par le moteur. Le test de chaleur n'est payé que quand le budget est déjà court.
	 */
	static canCloseNow(node, truncateAt) {
		// Au large, rien à vérifier : même le pire des constructions tient.
		if (getOperations() + OPS_COLD_HEAL + OPS_COLD_PLAN <= truncateAt) return true
		var State = StateClass.materializeNodeState(node)
		return getOperations() + FinalCell.coldCost(State, combinedHfpOf(node), node.HFP_BY_SIDE[State[Me].SIDE]) <= truncateAt
	}

	// Classement global des états à la même profondeur, sur leur score absolu.
	// Le tri stable conserve l'ordre de génération en cas d'égalité.
	static selectBeam(nodes) {
		var sorted = arraySort(nodes, function(a, b) { return b.SCORE - a.SCORE })
		var beam = []
		for (var i = 0; i < min(BFS_BEAM_WIDTH, count(sorted)); i++) push(beam, sorted[i])
		return beam
	}

	// Petite liste triée des meilleurs gains réellement simulés pour UN parent.
	static keepBeamSuccessor(best, entry) {
		if (entry.DEFERRED) return;
		var slot = 0
		while (slot < count(best) && best[slot].PRIORITY >= entry.PRIORITY) slot++
		if (slot >= BFS_BEAM_WIDTH) return;
		if (count(best) < BFS_BEAM_WIDTH) push(best, entry)
		for (var j = count(best) - 1; j > slot; j--) best[j] = best[j - 1]
		best[slot] = entry
	}

	/* Les priorités sont triées sans résoudre toutes les origines. Les hits
	 * partagent un ordre de CLÉS, jamais les actions concrètes d'un autre parent. */
	static findBestNextNodes(Parent, SearchCache, MySide) {
		var State = StateClass.materializeNodeState(Parent)
		var mine = State[Me]
		if (mine.LIFE <= 0 || mine.TP < MINIMUM_COST_ITEM) return []
		var BaseHash = Parent.BASE_HASH
		var walk = WalkCellsClass.getAllLayers(State, Me, BaseHash, Parent.ME_WALK_FINGERPRINT)
		var resurrectionTargetId = resurrectIdOf(State)
		var frame = prepareGroups(State, BaseHash, Parent, MySide, walk, resurrectionTargetId, SearchCache)
		var best = []
		// Les nouveaux groupes sont déjà simulés par prepareGroups. Les garder même
		// si cette préparation a épuisé le budget, sans les simuler une seconde fois.
		for (var actual in frame.FRESH) keepBeamSuccessor(best, actual)
		var Workspace = null
		for (var hint in frame.ORDER) {
			if (getOperations() > OPS_DEADLINE) break
			// Aucun second passage sur les anciennes estimations non positives.
			if (hint.GAIN <= BFS_DELTA_EPSILON) break
			// Coupure APPROXIMATIVE : les anciens gains guident les essais, sans
			// garantir qu'une action plus bas n'a pas augmenté depuis son estimation.
			if (count(best) == BFS_BEAM_WIDTH && best[BFS_BEAM_WIDTH - 1].PRIORITY >= hint.PRIORITY) break
			if (hint.KEY in frame.FRESH) continue
			var playable = framePlayable(frame, hint.KEY, mine, walk, resurrectionTargetId, BaseHash, Parent.ME_WALK_FINGERPRINT)
			if (playable == null) continue
			if (Workspace == null) Workspace = clone(State, 1)
			var actual = simulatePlayable(playable, Workspace, BaseHash, Parent.SCORE,
				MySide, Parent.CONTEXT_BY_SIDE, Parent.HFP_BY_SIDE, Parent, walk)
			rememberScored(SearchCache, hint.KEY, actual)
			keepBeamSuccessor(best, actual)
		}
		var successors = []
		for (var entry in best) {
			entry.NODE.PARENT = Parent
			push(successors, entry.NODE)
		}
		return successors
	}

	/* Réunir les groupes actuels, apprendre seulement les priorités inconnues,
	 * puis reprendre un tri déjà fait pour ce même ensemble. Les coûts/usages
	 * restent propres au parent. Par gain brut, aucune origine des hits n'est
	 * cherchée ici ; par rendement, le coût actuel entre aussi dans la clé du tri. */
	static prepareGroups(State, BaseHash, Parent, MySide, Walk, resurrectionTargetId, SearchCache) {
		var mine = State[Me]
		var frame = new ActionSearchFrameClass()
		var availability = ActionsClass.availabilityOf(mine)
		frame.COSTS = availability.COSTS
		frame.USES = availability.USES
		var availableMask = availability.MASK
		if (availableMask == null) {
			availableMask = 0
			for (var i: var item in mine.INVENTORY) {
				if (baseCostOf(mine, item, frame.COSTS, frame.USES, availability.STOCKS) >= 0) availableMask ^= mix64Memo(i + 1)
			}
			availability.MASK = availableMask
		}
		// Cellule/PM/capacités, items disponibles, payload de résurrection et
		// stérilité déterminent cette liste. Stats, dégâts et gains restent courants.
		var setKey = ((BaseHash * MIX_A) ^ Parent.ME_WALK_FINGERPRINT) * MIX_A
		setKey = ((setKey ^ availableMask) * MIX_A) ^ ((resurrectionTargetId == null ? 0 : resurrectionTargetId + 1) << 1) ^ (EntityStateClass.hasState(mine, STATE_STERILE) ? 1 : 0)
		var set = SearchCache.GROUP_SETS[setKey]
		if (set == null) {
			var groups = ActionsClass.getEveryActionsInAState(State, Walk, mine.CELL, BaseHash)
			for (var group in groups) {
				if (group.Item == CHIP_RESURRECTION && resurrectionTargetId == null) continue
				if (baseCostOf(mine, group.Item, frame.COSTS, frame.USES, availability.STOCKS) < 0) continue
				var key = groupEstimateKey(group, resurrectionTargetId)
				if (!(key in frame.GROUPS) || group.IS_LOCAL) frame.GROUPS[key] = group
			}
			set = new ActionGroupSetClass(frame.GROUPS)
			if (getOperations() <= OPS_DEADLINE) SearchCache.GROUP_SETS[setKey] = set // jamais une préparation tronquée
		} else {
			frame.GROUPS = set.GROUPS
			SearchCache.SET_HITS++
		}
		var keys = []
		var fingerprint = 0
		var incomplete = false
		var Workspace = null
		// Les estimations ne sont jamais retirées pendant une recherche. Une fois
		// toutes les clés connues, inutile de vérifier à nouveau leur présence.
		// Seule la liste est reprise : le tri lit les gains actuels et les actions
		// examinées résolvent toujours leur origine avant d'être resimulées.
		if (!BFS_SCORE_PER_ACTION_COST && setKey in SearchCache.KNOWN_GROUP_SETS) {
			keys = set.KEYS
			SearchCache.REUSED_SCORES += count(keys)
		} else for (var key in set.KEYS) {
			if (getOperations() > OPS_DEADLINE) { incomplete = true; break }
			if (!(key in SearchCache.ESTIMATES)) {
				var playable = framePlayable(frame, key, mine, Walk, resurrectionTargetId, BaseHash, Parent.ME_WALK_FINGERPRINT)
				if (playable == null) { incomplete = true; continue }
				if (Workspace == null) Workspace = clone(State, 1)
				var actual = simulatePlayable(playable, Workspace, BaseHash, Parent.SCORE,
					MySide, Parent.CONTEXT_BY_SIDE, Parent.HFP_BY_SIDE, Parent, Walk)
				frame.FRESH[key] = actual
				rememberScored(SearchCache, key, actual)
				SearchCache.NEW_SCORES++
			} else {
				SearchCache.REUSED_SCORES++
			}
			if (BFS_SCORE_PER_ACTION_COST) {
				var playable = framePlayable(frame, key, mine, Walk, resurrectionTargetId, BaseHash, Parent.ME_WALK_FINGERPRINT)
				if (playable == null) continue
				fingerprint ^= mix64(addValueToBinHash(key, playable.COST))
			}
			push(keys, key)
		}
		if (!BFS_SCORE_PER_ACTION_COST) {
			if (!incomplete) {
				fingerprint = set.FINGERPRINT
				SearchCache.KNOWN_GROUP_SETS[setKey] = true
			}
			else for (var key in keys) fingerprint ^= mix64(key)
		}
		var orderKey = addValueToBinHash(addValueToBinHash(OFFSET_BASIS ^ fingerprint, (count(keys) << 1) | (BFS_SCORE_PER_ACTION_COST ? 1 : 0)), SearchCache.ESTIMATE_VERSION)
		var order = SearchCache.ORDERED_GROUPS[orderKey]
		if (order == null) {
			order = []
			for (var key in keys) {
				var gain = SearchCache.ESTIMATES[key]
				var priority = BFS_SCORE_PER_ACTION_COST ? priorityOf(gain, frame.PLAYABLES[key].COST) : gain
				push(order, new ActionPriorityClass(key, gain, priority))
			}
			order = arraySort(order, function(a, b) { return b.PRIORITY - a.PRIORITY })
			SearchCache.ORDERED_GROUPS[orderKey] = order
		} else {
			SearchCache.ORDER_HITS++
		}
		frame.ORDER = order
		return frame
	}

	// Une revalidation apprend le gain courant. Ne pas garder un tri qui date
	// d'avant ce changement ; les estimations restent des indications gloutonnes.
	static rememberEstimate(SearchCache, key, gain) {
		if (SearchCache.ESTIMATES[key] == gain) return;
		SearchCache.ESTIMATES[key] = gain
		SearchCache.ESTIMATE_VERSION++
	}

	static rememberScored(SearchCache, key, entry) {
		rememberEstimate(SearchCache, key, entry.GAIN)
		var mask = (SearchCache.DEPENDENCIES[key] ?? 0) | ActionSearchCacheClass.dependencyBit(Me)
		for (var id: var _stat in entry.NODE.STATE_PATCH) mask |= ActionSearchCacheClass.dependencyBit(id)
		SearchCache.DEPENDENCIES[key] = mask
	}

	static framePlayable(frame, key, mine, Walk, resurrectionTargetId, BaseHash, WalkFingerprint) {
		if (key in frame.PLAYABLES) return frame.PLAYABLES[key]
		var group = frame.GROUPS[key]
		var playable = resolveGroup(group, mine, Walk, frame.COSTS[group.Item], frame.USES[group.Item], resurrectionTargetId, BaseHash, WalkFingerprint)
		frame.PLAYABLES[key] = playable
		return playable
	}

	/* Un seul workspace restauré entre candidats. Le score inclut TOUJOURS la
	 * couche de déplacement actuelle, ses buffs/passifs et le prix du cooldown. */
	static simulatePlayable(playable, Workspace, BaseHash, ReferenceScore, MySide, Context, Hfp, StateParent, Walk) {
		var act = playable.ACTION
		var item = act.Item
		var node = NodeClass.ActionToNodeInTree(act, Workspace, act.From, Walk, playable.COST,
			ITEMINFO[item], item, act.To, BaseHash, null, StateParent, Context, Hfp, playable.USES)
		// Tous les candidats de ce parent relisent les mêmes valeurs d'avant action.
		// Le mémo appartient au nœud immuable, jamais à un autre état ou une autre recherche.
		// Tester la variable locale évite que l'analyseur réduise le type du champ
		// à null au moment de lui affecter la map (avertissement dans l'éditeur).
		var parentValues = StateParent.SCORE_VALUES
		if (parentValues == null) {
			parentValues = [:]
			StateParent.SCORE_VALUES = parentValues
		}
		// Un parent ne stocke d'abord que les entités modifiées par son action.
		// Une entité intacte garde la valeur du plus proche ancêtre qui l'a scorée :
		// remonter les petits patches évite de recalculer cette même valeur complète.
		if (StateParent.STATE_PARENT != null) for (var id: var before in node.CLONED) {
			if (id == Me) continue // sa valeur existe déjà sur tout parent scoré
			if (before == null || id in parentValues) continue
			var ancestor = StateParent.STATE_PARENT
			while (ancestor != null) {
				var values = ancestor.SCORE_VALUES
				if (values != null && id in values) {
					parentValues[id] = values[id]
					break
				}
				ancestor = ancestor.STATE_PARENT
			}
		}
		var score = ScoringClass.getStateScoreFromParent(node, Workspace, ReferenceScore, MySide, parentValues)
		StateClass.restoreWorkspace(Workspace, node.CLONED)
		node.CLONED = null
		node.SCORE = score
		var gain = score - ReferenceScore
		return new ScoredActionClass(playable, gain, priorityOf(gain, playable.COST), node, score)
	}

	/* Scoring APRÈS dédoublonnage. La racine calcule ses vrais nœuds. En branche,
	 * seuls les nouveaux groupes sont scorés pour construire le tri ; les autres
	 * reprennent leur estimation, puis sont resimulés s'ils sont examinés. */
	static enumerateAndSort(State, BaseHash, ReferenceScore, MySide, Context, Hfp, StateParent, Walk, pairs, SearchCache = null, reuseEstimates = false, sortResults = true) {
		if (SearchCache == null) SearchCache = new ActionSearchCacheClass()
		var entries = []
		var Workspace = null
		for (var playable in pairs) {
			if (getOperations() > OPS_DEADLINE) break
			var key = estimateKeyOf(playable)
			var entry
			if (reuseEstimates && key in SearchCache.ESTIMATES) {
				var gain = SearchCache.ESTIMATES[key]
				entry = new ScoredActionClass(playable, gain, priorityOf(gain, playable.COST), null, null)
				SearchCache.REUSED_SCORES++
			} else {
				if (Workspace == null) Workspace = clone(State, 1)
				entry = simulatePlayable(playable, Workspace, BaseHash, ReferenceScore, MySide, Context, Hfp, StateParent, Walk)
				rememberScored(SearchCache, key, entry)
				SearchCache.NEW_SCORES++
			}
			push(entries, entry)
		}
		return sortResults ? arraySort(entries, function(a, b) { return b.PRIORITY - a.PRIORITY }) : entries
	}

	static estimateKeyOf(playable) {
		return groupEstimateKey(playable.GROUP, playable.ACTION.RESURRECT_ID)
	}

	static groupEstimateKey(group, resurrectionTargetId) {
		var key = group.SIGNATURE
		if (group.Item == CHIP_RESURRECTION) key = addValueToBinHash(key, resurrectionTargetId + 1)
		return key
	}

	/*
	 * Priorité d'un candidat : ce que son Δscore vaut PAR TP réellement dépensé, ou le Δscore
	 * brut si la politique de rendement est désactivée.
	 * Garde de coût nul : aucun item n'en produit aujourd'hui, mais un coût 0 rendrait la
	 * division infinie — il est alors traité comme un TP, donc classé sur son Δscore plein.
	 */
	static priorityOf(delta, cost) {
		if (!BFS_SCORE_PER_ACTION_COST) return delta
		return delta / max(1, cost)
	}

	/* Filtrage DYNAMIQUE : disponibilité, équipement et TP ne sont jamais figés
	 * dans la géométrie. Les doublons locaux/zone sont retirés AVANT le scoring. */
	static getBaseActions(State, BaseHash, ResurrectId, Walk, localOnly = false, othersOnly = false) {
		var result = [:]
		var mine = State[Me]
		var groups = ActionsClass.getEveryActionsInAState(State, Walk, mine.CELL, BaseHash, localOnly, othersOnly)
		var walkFingerprint = WalkCellsClass.HashWalkCellsWithItemsWithoutBaseHash(mine)
		var availability = ActionsClass.availabilityOf(mine)
		var baseCosts = availability.COSTS
		var usesByItem = availability.USES
		for (var group in groups) {
			var item = group.Item
			var cost = baseCosts[item]
			if (cost == null) cost = baseCostOf(mine, item, baseCosts, usesByItem, availability.STOCKS)
			if (cost < 0 || (item == CHIP_RESURRECTION && ResurrectId == null)) continue
			var playable = resolveGroup(group, mine, Walk, cost, usesByItem[item], ResurrectId, BaseHash, walkFingerprint)
			if (playable == null) continue
			var old = result[group.SIGNATURE]
			if (old == null || playable.ACTION.From == mine.CELL || playable.COST < old.COST) result[group.SIGNATURE] = playable
		}
		return mapValues(result)
	}

	static baseCostOf(mine, item, costs, usesByItem, stocks = null) {
        var cost = costs[item]
        if (cost != null) return cost
        var info = ITEMINFO[item]
        var stock = stocks == null ? null : stocks[item]
        if (stock == null) {
            stock = -1
            if (StateClass.cooldownOf(mine, item) <= 0) {
                var uses = StateClass.usesOf(mine, item)
                if (uses < info.MAX_USES) stock = uses
            }
            if (stocks != null) stocks[item] = stock
        }
        cost = -1
        if (stock >= 0) {
            usesByItem[item] = stock
            cost = info.COST + ((info.IS_WEAPON && mine.WEAPON != item) ? 1 : 0)
            if (cost > mine.TP) cost = -1
        }
        costs[item] = cost
        return cost
    }

	/* Pas de copie de la map d'origines. Le cas courant (je peux déjà lancer ici)
	 * se résout par une seule appartenance ; sinon on cherche le déplacement le
	 * moins cher qui laisse ASSEZ de TP pour le cast, équipement compris. */
	static resolveGroup(group, mine, Walk, baseCost, uses, ResurrectId, BaseHash = null, WalkFingerprint = null) {
		var from = null
		var to = null
		var cost = baseCost
		if (group.IS_LOCAL) {
			if (group.From != mine.CELL) return null // invariant : génération locale du nœud
			from = mine.CELL
			to = group.To
		} else if (mine.CELL in group.ORIGINS) {
			from = mine.CELL
			to = group.ORIGINS[from]
		} else {
			var choices = null
			if (BaseHash != null && WalkFingerprint != null) {
				var budget = mine.TP - baseCost
				var mask = (budget >= JUMP_COST ? 1 : 0) | (budget >= TELE_COST ? 2 : 0) | (budget >= JUMP_TELE_COST ? 4 : 0)
				var domain = addValueToBinHash(addValueToBinHash(OFFSET_BASIS ^ BaseHash, WalkFingerprint), mask)
				choices = ACTION_ORIGIN_CHOICE_CACHE[domain]
				if (choices == null) { choices = [:]; ACTION_ORIGIN_CHOICE_CACHE[domain] = choices }
			}
			if (choices != null && group.SIGNATURE in choices) {
				var choice = choices[group.SIGNATURE]
				if (choice == null) return null
				from = choice.FROM
				to = choice.TO
				cost = baseCost + choice.EXTRA_TP
			} else {
				var bestRank = MAX_VALUE
				for (var origin: var aim in group.ORIGINS) {
					var extra = 0
					var rank
					if (origin in Walk.WALK) rank = Walk.WALK[origin]
					else if (origin in Walk.JUMP) { extra = JUMP_COST; rank = Walk.JUMP[origin] + 100 }
					else if (origin in Walk.TELEPORTATION) { extra = TELE_COST; rank = Walk.TELEPORTATION[origin] + 1000 }
					else if (origin in Walk.TELEPORTATION_AND_JUMP) { extra = JUMP_TELE_COST; rank = Walk.TELEPORTATION_AND_JUMP[origin] + 10000 }
					else continue
					if (baseCost + extra > mine.TP || rank >= bestRank) continue
					bestRank = rank
					from = origin
					to = aim
					cost = baseCost + extra
					// La cellule courante est déjà exclue : une marche ne peut coûter moins de 1.
					if (rank == 1) break
				}
				if (choices != null) choices[group.SIGNATURE] = from == null ? null : new ActionOriginChoiceClass(from, to, cost - baseCost)
			}
		}
		if (from == null) return null
		var action = new ActionClass(group.Item, from, to)
		if (group.Item == CHIP_RESURRECTION) action.RESURRECT_ID = ResurrectId
		return new PlayableActionClass(action, group, cost, uses)
	}

	/*
	 * L'id du meilleur ressuscitable de cet état, ou null si Résurrection n'est pas
	 * utilisable MAINTENANT (chip absente, cooldown, uses, TP insuffisants). UNE évaluation
	 * de ScoringWichId par State — la sim (Update) et le vrai cast (Play) reçoivent cet id
	 * en payload d'action, plus personne ne rappelle ScoringWichId.
	 */
	static resurrectIdOf(State) {
		// Chip absente de l'inventaire : la remontée de chaîne de cooldownOf la parcourrait en
		// entier pour rien, et cette fonction est appelée à chaque développement de nœud.
		if (!I_HAVE_RESURRECTION) return null
		var MyStats = State[Me]
		var resCd = StateClass.cooldownOf(MyStats, CHIP_RESURRECTION)
		if (resCd == null || resCd > 0) return null
		if (StateClass.usesOf(MyStats, CHIP_RESURRECTION) >= ITEMINFO[CHIP_RESURRECTION].MAX_USES) return null
		if (MyStats.TP < ITEMINFO[CHIP_RESURRECTION].COST) return null
		return ResurrectionClass.ScoringWichId(State).ID
	}

}
