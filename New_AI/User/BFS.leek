/*
 * Sélecteur d'action par recherche arborescente gloutonne, en DEUX temps.
 *
 * 1. EXPANSION, sur les scores BRUTS (aucun danger positionnel de Me) :
 *  - Profondeur 1 : chaque action jouable est clonée + appliquée + scorée, puis triée
 *    par PRIORITÉ décroissante (BFS_SCORE_PER_ACTION_COST : rendement par TP, ou Δscore).
 *  - Chaque action de base est déroulée récursivement (unroll) : on descend l'action suivante
 *    de plus haute priorité, avec early-exit quand la borne du tri ne peut plus la battre.
 *  - Les listes triées sont CACHÉES par BaseHash sur tout l'appel : un step qui reste sur
 *    le même BaseHash (self-buff) réutilise la liste, un step qui le change (move, summon,
 *    Inversion...) énumère à neuf pour ce nouveau board.
 *  - Un nœud "ne rien jouer" (score initial) sert de plancher.
 *
 * 2. RECLASSEMENT TERMINAL : tout nœud visité est une suite où l'on PEUT s'arrêter. Chacun
 *    est reclassé par finalScore = rawScore − placementPenalty, où la pénalité vient de
 *    FinalCell — la même fonction que le placement réellement joué en fin de tour. node.SCORE
 *    reste le score brut de la recherche, il n'est jamais réécrit.
 *
 * Le meilleur nœud FINAL gagne ; on renvoie l'action de son premier ancêtre.
 */

include("../includes.leek")

// Nombre de steps d'expansion déroulés par le getBestAction courant (affiché dans "Best:").
global BFS_CHAIN_STEPS = 0

/*
 * Politique de choix du successeur à dérouler.
 *   true  : par RENDEMENT, priority = Δscore / coût RÉEL de l'action dans cet état — coût de
 *           l'item, changement d'arme, Saut, Téléportation, Saut + Téléportation compris.
 *   false : par Δscore absolu.
 * Le score d'un nœud reste ABSOLU dans les deux cas — le rendement ne sert qu'à classer.
 *
 * Le rendement est le bon critère : un budget de TP est FINI, donc ce qui compte n'est pas ce
 * qu'une action rapporte mais ce qu'elle rapporte par TP dépensé. Préférer 15 TP pour 3 de
 * score à 3 TP pour 2 est un défaut de critère, pas un compromis.
 *
 * Il coûte des opérations : privilégier les actions bon marché allonge les chaînes, donc
 * multiplie les nœuds. C'est une conséquence attendue du critère, pas un effet de bord.
 */
global BFS_SCORE_PER_ACTION_COST = true

class ActionSuite {

	/*
	 * Renvoie la meilleure action à jouer dans l'état donné (null = ne rien jouer).
	 */
	static getBestAction(State) {
		BenchOps.Start("BFS")
		var MyStats = State[Me]
		// Fast-path racine : sous le coût du moindre item jouable du tour (même garde que
		// findBestNextNode), aucune action de base n'existe — rien à calculer, pas même BaseHash.
		if (MyStats.TP < MINIMUM_COST_ITEM) {
			BenchOps.Stop("BFS")
			return null
		}
		var MySide = MyStats.SIDE
		var BaseHash = StateClass.getBaseHash(State)
		var RootResurrectId = resurrectIdOf(State)
		var MyWalkCells = WalkCellsClass.getAllLayers(State, Me, BaseHash)
		var basePairs = getBaseActions(State, BaseHash, RootResurrectId, MyWalkCells)
		// basePairs = les actions réellement JOUABLES. Vide -> rien à scorer : sortie avant
		// Context/HFP/Terms (le gros du coût racine).
		if (count(basePairs) == 0) {
			BenchOps.Stop("BFS")
			return null
		}
		var RootContext = DeltaClass.buildContextBySide(State)
		var RootHfp = HealClass.buildHfpBySide(State)
		var RootPoisonFold = ScoringClass.carrierFoldOthers(State)
		var RootPoisonKey = ScoringClass.poisonKeyFromFold(State, BaseHash, RootPoisonFold)
		// Empreinte de mobilité de Me à la racine : construite UNE fois par getBestAction
		// effectif, portée par noPlay et héritée par ses enfants. Elle sale le filtre de
		// cellules de tir du ScoredCache — plus aucun terme de scoring n'en dépend.
		var RootWalkFingerprint = WalkCellsClass.HashWalkCellsWithItemsWithoutBaseHash(MyStats)
		var RootTerms = ScoringClass.buildTermsMap(State, MySide, BaseHash, RootContext, RootHfp, RootPoisonKey)
		var initialScore = ScoringClass.sumTerms(RootTerms)

		// Cache par appel : scoredKeyOf(BaseHash, candidat résu) -> liste triée
		// [act, delta, node, nodeScore, cellule de tir, item].
		var ScoredCache = [:]
		// Même liste, restreinte aux entrées dont la cellule de tir m'est ATTEIGNABLE. Clé
		// salée par l'empreinte de mobilité, qui fixe exactement ce set avec le terrain.
		var ReachableCache = [:]

		// noPlay = plancher "ne rien jouer" ET racine de la chaîne de termes : il porte la
		// map complète, chaque nœud n'empile ensuite qu'un PATCH (TERMS_PARENT).
		var noPlay = new NodeClass(null, State, null)
		noPlay.TERMS = RootTerms
		noPlay.TERMS_PARENT = null
		noPlay.SCORE = initialScore
		noPlay.BASE_HASH = BaseHash   // terrain de la racine des termes (comparaison parent/enfant pour Me)
		noPlay.ME_WALK_FINGERPRINT = RootWalkFingerprint
		noPlay.POISON_FOLD = RootPoisonFold   // moitié stable de la clé antidote, héritée par ses enfants
		// Fold des empreintes de soigneurs de la racine : ses enfants l'héritent tant qu'aucun
		// n'a sa propre map (copie-sur-écriture du Nœud).
		var rootCombinedHfp = 0
		for (var s: var h in RootHfp) rootCombinedHfp ^= h
		noPlay.COMBINED_HFP = rootCombinedHfp
		noPlay.HFP_OWNED = true
		// Métadonnées que la racine ne portait pas : le reclassement terminal les lit sur
		// TOUT candidat, plancher compris, comme sur n'importe quel nœud.
		noPlay.CONTEXT_BY_SIDE = RootContext
		noPlay.HFP_BY_SIDE = RootHfp
		noPlay.POISON_KEY = RootPoisonKey
		// Racine des ÉTATS : elle seule porte la map complète d'office, patch vide.
		noPlay.STATE_PARENT = null
		noPlay.STATE_PATCH = [: ]

		var rootEntries = enumerateAndSort(State, BaseHash, initialScore, MySide, RootContext, RootHfp, noPlay, RootPoisonKey, MyWalkCells, basePairs)
		ScoredCache[scoredKeyOf(BaseHash, RootResurrectId)] = rootEntries
		BFS_CHAIN_STEPS = 0
		debugC("--- " + count(rootEntries) + " base actions ---", COLOR_BLUE)

		// Déroulé de chaque action de base. TOUT nœud visité est une suite où l'on peut
		// s'arrêter : le plancher, chaque action racine retenue, et chaque nœud intermédiaire
		// du déroulé — pas seulement le dernier de chaque chaîne.
		var candidates = [noPlay]

		for (var entry in rootEntries) {
			var baseNode = entry[2]
			baseNode.SCORE = entry[3]
			push(candidates, baseNode)
			unroll(baseNode, ScoredCache, ReachableCache, MySide, candidates)
		}
		BenchOps.Stop("BFS")

		return pickTerminal(candidates, initialScore, count(rootEntries))
	}

	/*
	 * Reclassement terminal : chaque candidat est clos par FinalCell, qui rend la pénalité de
	 * son meilleur placement, et vaut finalScore = rawScore − placementPenalty.
	 *
	 * COUPURE EXACTE, sans epsilon : la pénalité est >= 0 par construction, donc
	 * finalScore <= rawScore. Les candidats étant parcourus par score BRUT décroissant, dès
	 * qu'un score brut ne bat plus le meilleur score final, aucun de ceux qui restent ne le
	 * pourra non plus. Une égalité parfaite de scores finaux garde le premier trouvé, donc le
	 * meilleur score brut — le départage historique.
	 *
	 * @return l'action du premier ancêtre du meilleur candidat, null si le plancher gagne
	 */
	static pickTerminal(candidates, initialScore, nBases) {
		BenchOps.Start("Terminal")
		// Le meilleur score BRUT est le seul candidat qu'on soit CERTAIN d'évaluer : il ouvre
		// forcément le parcours. Le trouver d'abord en un balayage donne donc la borne de
		// coupure avant tout tri, pour le prix d'une comparaison par candidat.
		var seed = candidates[0]
		var bestRaw = seed.SCORE
		for (var c in candidates) {
			if (c.SCORE > bestRaw) {
				bestRaw = c.SCORE
				seed = c
			}
		}
		var bound = bestRaw - penaltyOf(seed)
		// Un candidat dont le score BRUT n'atteint pas déjà cette borne ne peut plus gagner : son
		// score final lui est inférieur ou égal. Les écarter AVANT le tri est ce qui compte —
		// le parcours n'en ouvre qu'une poignée, et trier des milliers de nœuds pour cela coûtait
		// plus cher que toutes les évaluations réunies. Le seuil est LARGE (>=) : la graine y
		// reste même si sa pénalité est nulle, et la liste triée reste un sur-ensemble exact de
		// ce que le parcours aurait ouvert.
		var live = []
		for (var c in candidates) {
			if (c.SCORE >= bound) push(live, c)
		}
		var sorted = arraySort(live, function(a, b) { return b.SCORE - a.SCORE })
		var n = count(sorted)
		var best = null
		var bestFinal = 0
		for (var i = 0; i < n; i++) {
			var node = sorted[i]
			var raw = node.SCORE
			if (best != null && raw <= bestFinal) break
			var finalScore = raw - penaltyOf(node)
			if (best == null || finalScore > bestFinal) {
				best = node
				bestFinal = finalScore
			}
		}
		BenchOps.Stop("Terminal")

		if (best.ACTION == null) return null
		var ancestor = best
		while (ancestor.PARENT != null) ancestor = ancestor.PARENT
		debug("Best: " + ITEMINFO[ancestor.ACTION.Item].NAME + " | From: " + ancestor.ACTION.From + " | To: " + ancestor.ACTION.To + " | Delta: " + (bestFinal - initialScore) + " | " + nBases + " bases, " + BFS_CHAIN_STEPS + " steps")
		return ancestor.ACTION
	}

	/*
	 * Pénalité de placement d'un candidat : son état complet n'est reconstruit depuis sa chaîne
	 * de patches que s'il est réellement évalué (matérialisation paresseuse, puis cachée sur le
	 * nœud — la graine repasse ici sans rien recalculer).
	 */
	static penaltyOf(node) {
		var NodeState = StateClass.materializeNodeState(node)
		return FinalCell.evaluate(NodeState, node.BASE_HASH, node.CONTEXT_BY_SIDE, node.HFP_BY_SIDE, node.COMBINED_HFP, node.POISON_KEY, node.ME_WALK_FINGERPRINT)[1]
	}

	/*
	 * Déroulé glouton récursif d'une branche : descend la meilleure action suivante tant
	 * qu'il y en a une, en collectant chaque nœud traversé comme candidat terminal.
	 */
	static unroll(node, ScoredCache, ReachableCache, MySide, candidates) {
		var next = findBestNextNode(node, ScoredCache, ReachableCache, MySide)
		if (next == null) return;
		push(candidates, next)
		BFS_CHAIN_STEPS++
		unroll(next, ScoredCache, ReachableCache, MySide, candidates)
	}

	/*
	 * Depuis un nœud parent, trouve le meilleur nœud suivant — celui de plus haute PRIORITÉ
	 * (rendement par TP, ou Δscore absolu selon BFS_SCORE_PER_ACTION_COST).
	 * Liste triée via ScoredCache (clé BaseHash). Deux chemins :
	 *  - FRAIS (miss) : la liste vient d'être énumérée et scorée pour CET état exact, avec le
	 *    coût de CET état -> la première entrée EST le meilleur suivant, aucune re-simulation.
	 *  - RÉUTILISÉ (hit, même BaseHash atteint depuis un AUTRE état) : re-filtre
	 *    (cooldown/uses/coût) et re-score chaque candidat dans les stats réelles du parent.
	 *    Sa priorité est recalculée avec le coût COURANT, jamais reprise de la liste — celle-ci
	 *    a été produite sous une autre arme, une autre couche de mouvement, d'autres TP.
	 *    Le break sur la priorité STOCKÉE garde exactement le statut de l'ancien break sur le
	 *    delta stocké : une borne du tri, valable tant que la liste décrit cet état.
	 */
	static findBestNextNode(Parent, ScoredCache, ReachableCache, MySide) {
		// Le nœud est réellement développé : c'est ICI (et seulement ici) que son état complet
		// est reconstruit depuis sa chaîne de patches, puis caché.
		var State = StateClass.materializeNodeState(Parent)
		var MyStats = State[Me]
		var MyTp = MyStats.TP
		if (MyTp < MINIMUM_COST_ITEM) return null

		var BaseHash = Parent.BASE_HASH
		// Candidat résu de CET état, calculé une fois AVANT la consultation du cache : la clé
		// locale le porte, un hit garantit donc des entrées au même RESURRECT_ID.
		var ResurrectId = resurrectIdOf(State)
		var CacheKey = scoredKeyOf(BaseHash, ResurrectId)

		var Entries
		if (CacheKey in ScoredCache) {
			Entries = ScoredCache[CacheKey]
		} else {
			// Miss : WalkCells + jouables produits UNE seule fois pour ce nouvel état, puis scorés.
			var FreshWalk = WalkCellsClass.getAllLayers(State, Me, BaseHash)
			var freshPairs = getBaseActions(State, BaseHash, ResurrectId, FreshWalk)
			Entries = enumerateAndSort(State, BaseHash, Parent.SCORE, MySide, Parent.CONTEXT_BY_SIDE, Parent.HFP_BY_SIDE, Parent, Parent.POISON_KEY, FreshWalk, freshPairs)
			ScoredCache[CacheKey] = Entries

			// Chemin frais : toutes les entrées sont positives et triées pour cet état.
			if (count(Entries) == 0) return null
			var top = Entries[0]
			var fresh = top[2]
			fresh.PARENT = Parent   // créé avec PARENT=null dans enumerateAndSort
			fresh.SCORE = top[3]
			return fresh
		}

		var MyWalkCells = WalkCellsClass.getAllLayers(State, Me, BaseHash)
		var MyOnlyWalk = MyWalkCells.WALK
		var MyMax = MyWalkCells.MAX

		// Le filtre de cellule de tir écartait trois entrées sur quatre et ne dépend que de
		// MyMax, donc de (empreinte de mobilité, terrain). On le paie une fois par couple, pas
		// une fois par nœud : mesuré 8,3 réutilisations par couple.
		// Une MULTIPLICATION sépare les deux moitiés (contrat des clés, famille 3b) : CacheKey
		// finit par l'id du ressuscité, que la rotation de addValueToBinHash poserait sur les
		// trois bits de capacité saut/téléportation portés par l'empreinte de mobilité. La clé
		// ne dépendrait alors du couple que par son XOR, et servirait une liste filtrée sur
		// d'autres cellules accessibles, tirée d'un autre ensemble d'actions.
		var ReachableKey = (CacheKey * MIX_A) ^ Parent.ME_WALK_FINGERPRINT
		var Reachable
		if (ReachableKey in ReachableCache) {
			Reachable = ReachableCache[ReachableKey]
		} else {
			Reachable = []
			for (var e in Entries) {
				if (e[4] in MyMax) push(Reachable, e)
			}
			ReachableCache[ReachableKey] = Reachable
		}
		var MyWeapon = MyStats.WEAPON
		var ParentScore = Parent.SCORE
		var JumpCost = JUMP_COST
		var TeleCost = TELE_COST

		var BestPriority = 0
		var BestNode = null
		// Workspace créé au PREMIER candidat réellement simulé (les filtres ci-dessous en
		// écartent souvent tous), puis réutilisé et restauré entre chaque candidat.
		var Workspace = null
		// Coût de base par item, NÉGATIF quand l'item est injouable ou déjà hors budget :
		// cooldownOf et usesOf remontent la chaîne ITEM_STATE_PARENT alors que MyStats est
		// invariant sur toute la boucle, et le même item revient une fois par cellule de tir.
		// Le verdict et le coût dans la MÊME entrée : une seule lecture de map par entrée
		// examinée, et ITEMINFO n'est relu que pour les entrées réellement simulées.
		var baseCosts = [: ]
		// Compte d'usages du même item, résolu en même temps que son coût et pour le même
		// prix : le nœud n'a plus à remonter la chaîne d'inventaire pour l'incrémenter.
		var baseUses = [: ]

		for (var entry in Reachable) {
			if (BestPriority >= entry[1]) break   // borne du tri : plus rien à battre

			// Cellule et item sont PORTÉS PAR L'ENTRÉE : rien ici ne déréférence l'action, elle
			// n'est lue que pour les entrées réellement simulées.
			// L'item d'abord, la cellule seulement après le verdict de coût : sur les entrées
			// examinées, neuf sur dix sont écartées par un item injouable, et leur cellule de
			// tir n'aura jamais servi.
			var item = entry[5]

			var cost = baseCosts[item]
			if (cost == null) {
				var Infos = ITEMINFO[item]
				// Même ordre de court-circuit qu'avant : le cooldown d'abord, les usages ensuite,
				// et le compte n'est résolu qu'une fois.
				if (StateClass.cooldownOf(MyStats, item) > 0) {
					cost = -1
				} else {
					var itemUsed = StateClass.usesOf(MyStats, item)
					if (itemUsed >= Infos.MAX_USES) {
						cost = -1
					} else {
						baseUses[item] = itemUsed
						cost = (Infos.IS_WEAPON && MyWeapon != item) ? Infos.COST + 1 : Infos.COST
						// Le supplément de couche ne fait qu'AJOUTER : un coût de base déjà hors budget
						// le restera pour toutes ses cellules de tir, autant le marquer injouable.
						if (cost > MyTp) cost = -1
					}
				}
				baseCosts[item] = cost
			}
			if (cost < 0) continue
			// La cellule de tir est déjà garantie atteignable par la liste filtrée.
			var from = entry[4]
			if (!(from in MyOnlyWalk)) {
				if (from in MyWalkCells.JUMP)                          cost += JumpCost
				else if (from in MyWalkCells.TELEPORTATION)            cost += TeleCost
				else if (from in MyWalkCells.TELEPORTATION_AND_JUMP)   cost += JumpCost + TeleCost
			}
			if (cost > MyTp) continue

			if (Workspace == null) Workspace = clone(State, 1)
			var act = entry[0]
			var candidate = NodeClass.ActionToNodeInTree(act, Workspace, from, MyWalkCells, cost, ITEMINFO[item], item, act.To, BaseHash, Parent, Parent, Parent.CONTEXT_BY_SIDE, Parent.HFP_BY_SIDE, baseUses[item])
			var candidateScore = ScoringClass.getStateScoreFromParent(candidate, Workspace, ParentScore, Parent, Parent.HFP_BY_SIDE, MySide, Parent.POISON_KEY)
			StateClass.restoreWorkspace(Workspace, candidate.CLONED)
			candidate.CLONED = null
			// Rendement sur le coût COURANT, celui que ce candidat paie vraiment dans cet état
			// parent : arme équipée, couche de mouvement empruntée, TP restants.
			var priority = priorityOf(candidateScore - ParentScore, cost)

			if (priority > BestPriority) {
				BestPriority = priority
				BestNode = candidate
				BestNode.SCORE = candidateScore
			}
		}

		return BestNode
	}

	/*
	 * Applique + score chaque action JOUABLE reçue (basePairs = sortie de getBaseActions,
	 * produite une seule fois par l'appelant avec MyWalkCells), trie par delta décroissant.
	 * Renvoie des entrées [act, priorité, node, nodeScore, cellule de tir, item], triées par
	 * priorité décroissante ; node avec PARENT=null mais TERMS_PARENT = ParentTermNode (la
	 * chaîne de termes est posée ici et jamais réassignée, contrairement à PARENT que le
	 * déroulé reconstruit).
	 * INVARIANT : toute entrée renvoyée a delta > BFS_DELTA_EPSILON — jouable (basePairs)
	 * n'implique donc pas retenu ; les sub-epsilon sont injouables partout en aval
	 * (plancher, chemin frais, borne du tri), les dropper ici libère leur nœud immédiatement.
	 * Le seuil porte sur le Δscore, pas sur la priorité : c'est la question « cette action
	 * apporte-t-elle quoi que ce soit ? », indépendante de ce qu'elle coûte.
	 */
	static enumerateAndSort(State, BaseHash, ReferenceScore, MySide, ParentContext, ParentHfp, ParentTermNode, ParentPoisonKey, MyWalkCells, basePairs) {
		var Entries = []
		// UN seul workspace pour toute la liste : chaque candidat le mute, se score dessus,
		// puis le rend EXACTEMENT à l'état parent — plus de copie de map par candidat. Créé
		// au premier candidat (une liste vide n'en paie aucun).
		// INVARIANT : ParentTermNode est AUSSI le nœud d'état parent — State doit être son
		// état matérialisé, sinon les enfants reconstruiraient un état faux.
		var Workspace = null
		for (var pair in basePairs) {
			var act = pair[0]
			var Item = act.Item
			if (Workspace == null) Workspace = clone(State, 1)
			var node = NodeClass.ActionToNodeInTree(act, Workspace, act.From, MyWalkCells, pair[1], ITEMINFO[Item], Item, act.To, BaseHash, null, ParentTermNode, ParentContext, ParentHfp, pair[2])
			var nodeScore = ScoringClass.getStateScoreFromParent(node, Workspace, ReferenceScore, ParentTermNode, ParentHfp, MySide, ParentPoisonKey)
			// Scoring fait : le workspace redevient le State parent pour le candidat suivant,
			// et CLONED est libéré (STATE_PATCH porte désormais les entités modifiées).
			StateClass.restoreWorkspace(Workspace, node.CLONED)
			node.CLONED = null
			var delta = nodeScore - ReferenceScore
			// AUDIT du majorant : il doit TOUJOURS couvrir le Δ réel. Une seule violation
			// suffit à rendre toute coupure fondée dessus incorrecte, et elle serait muette.
			if (BOUND_AUDIT) {
				var ub = ScoringClass.actionUpperBound(Item, act.From, act.To, State, MySide, BaseHash)
				if (ub != BOUND_MUST_SIMULATE) {
					BOUND_CHECKED++
					if (ub < delta) {
						BOUND_VIOLATED++
						debugE("[MAJORANT VIOLE] " + ITEMINFO[Item].NAME + " majorant " + ub + " < delta " + delta)
					}
				} else {
					BOUND_SKIPPED++
				}
			}
			if (delta <= BFS_DELTA_EPSILON) continue
			// pair[1] est le coût TP COMPLET de cette action dans CET état (item + swap d'arme
			// + saut/télépo), déjà résolu par getBaseActions pour son filtre de jouabilité.
			push(Entries, [act, priorityOf(delta, pair[1]), node, nodeScore, act.From, Item])
		}
		// arraySort RENVOIE le tableau trié (doc LS) : il faut capturer le retour.
		return arraySort(Entries, function(a, b) {
			return b[1] - a[1]
		})
	}

	/*
	 * Priorité d'un candidat : ce que son Δscore vaut PAR TP réellement dépensé, ou le Δscore
	 * brut si la politique de rendement est désactivée.
	 * Garde de coût nul : aucun item n'en produit aujourd'hui, mais un coût 0 rendrait la
	 * division infinie — il est alors traité comme un TP, donc classé sur son Δscore plein.
	 */
	static priorityOf(delta, cost) {
		if (!BFS_SCORE_PER_ACTION_COST) return delta
		return delta / max(1, cost)
	}

	/*
	 * Liste toute action jouable depuis l'état courant, en paires [act, coût TP] — le coût
	 * (item + swap d'arme + jump/télépo) sert au filtre et est transmis tel quel aux nœuds.
	 * Filtre : cooldown, MAX_USES, coût vs TP restants.
	 */
	static getBaseActions(State, BaseHash, ResurrectId, MyWalkCells) {
		var _final = []
		var MyStats = State[Me]
		var Acts = ActionsClass.getEveryActionsInAState(State, MyWalkCells, MyStats.CELL, BaseHash)

		for (var Action in Acts) {
			var Item = Action.Item
			if (StateClass.cooldownOf(MyStats, Item) > 0) continue
			// Le compte d'usages est résolu ici pour le filtre : il voyage ensuite jusqu'au nœud,
			// qui n'a plus à remonter la chaîne d'inventaire pour l'incrémenter.
			var ItemUses = StateClass.usesOf(MyStats, Item)
			if (ItemUses >= ITEMINFO[Item].MAX_USES) continue
			// Résurrection : l'action cachée est géométrique (RESURRECT_ID null, objet partagé
			// entre states de même BaseHash). Sans candidat -> exclue ; sinon un objet NEUF
			// porte l'id choisi pour cette évaluation (l'objet caché n'est jamais muté).
			if (Item == CHIP_RESURRECTION) {
				if (ResurrectId == null) continue
				var resAct = new ActionClass(Item, Action.From, Action.To)
				resAct.RESURRECT_ID = ResurrectId
				Action = resAct
			}

			var From = Action.From
			var Info = ITEMINFO[Item]
			var Cost = (Info.IS_WEAPON && MyStats.WEAPON != Item) ? Info.COST + 1 : Info.COST

			if (!(From in MyWalkCells.WALK)) {
				if (From in MyWalkCells.JUMP) Cost += JUMP_COST
				else if (From in MyWalkCells.TELEPORTATION) Cost += TELE_COST
				else if (From in MyWalkCells.TELEPORTATION_AND_JUMP) Cost += JUMP_TELE_COST
				else continue
			}

			if (Cost <= MyStats.TP) push(_final, [Action, Cost, ItemUses])
		}
		return _final
	}

	/*
	 * L'id du meilleur ressuscitable de cet état, ou null si Résurrection n'est pas
	 * utilisable MAINTENANT (chip absente, cooldown, uses, TP insuffisants). UNE évaluation
	 * de ScoringWichId par State — la sim (Update) et le vrai cast (Play) reçoivent cet id
	 * en payload d'action, plus personne ne rappelle ScoringWichId.
	 */
	static resurrectIdOf(State) {
		// Chip absente de l'inventaire : la remontée de chaîne de cooldownOf la parcourrait en
		// entier pour rien, et cette fonction est appelée à chaque développement de nœud.
		if (!I_HAVE_RESURRECTION) return null
		var MyStats = State[Me]
		var resCd = StateClass.cooldownOf(MyStats, CHIP_RESURRECTION)
		if (resCd == null || resCd > 0) return null
		if (StateClass.usesOf(MyStats, CHIP_RESURRECTION) >= ITEMINFO[CHIP_RESURRECTION].MAX_USES) return null
		if (MyStats.TP < ITEMINFO[CHIP_RESURRECTION].COST) return null
		return ResurrectionClass.ScoringWichId(State).ID
	}

	/*
	 * Clé locale du ScoredCache : BaseHash salé par le candidat de résurrection. Un summon
	 * virtuel MORT ne change pas BaseHash (contributions LIFE-gated) alors qu'il change la
	 * liste d'actions — sans ce sel, deux states partageraient une liste scorée fausse.
	 */
	static scoredKeyOf(BaseHash, ResurrectId) {
		return addValueToBinHash(BaseHash, ResurrectId == null ? 0 : ResurrectId + 1)
	}
}
