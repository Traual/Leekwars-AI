/**
 * Tree Search Action Selector (port from Old_AI's ActionSuite/Tree.leek)
 *
 * Builds a tree of possible play sequences:
 *  - Depth-1 : every playable action is cloned+applied+state-scored.
 *  - Each base action is then greedy-expanded : after every applied play
 *    we score and pick the best next move in the derived state.
 *  - The raw action enumeration + initial walkcells are computed ONCE
 *    at the start of getBestAction (per real play) and reused across
 *    every greedy step. Each step only refilters by TP/CD/USES and
 *    refreshes the cheap NoEntities walkcells layer for accurate
 *    movement-cost accounting in ActionToNode.
 *  - Trade-off : if a play relocates an entity (Inversion / Grapple /
 *    Boxing-glove) we don't catch new opportunities until the next
 *    real play. Less precise, much cheaper, won't crash.
 *  - All nodes (every depth) are pushed into Tree_Array.
 *  - A no-play node (score = initial) acts as a floor.
 *  - The best-scored node wins; we return its first ancestor's action.
 **/

include("../includes.leek")

class ActionSuite {

	static getBestAction(State) {
		BenchOps.Start("BFS")
		var MySide = State[Me].SIDE
		var BaseHash = StateClass.getBaseHash(State)
		var initialScore = ScoringClass.getStateScore(State, MySide, BaseHash)

		// === Single enumeration for the whole BFS (this real play) ===
		var MyWalkCells = WalkCellsClass.getAllLayers(State, Me, BaseHash)
		var rawActs = ActionsClass.getEveryActionsInAState(State, MyWalkCells, State[Me].CELL, BaseHash)
		var baseActions = filterActions(rawActs, State[Me], MyWalkCells)
		debugC("--- Evaluating " + count(baseActions) + " actions ---", COLOR_BLUE)

		var Tree_Array = []
		for (var act in baseActions) {
			var baseNode = NodeClass.ActionToNode(act, State, BaseHash, null)
			if (baseNode == null) continue
			var baseNodeBaseHash = StateClass.getBaseHash(baseNode.END_STATS)
			baseNode.BASE_HASH = baseNodeBaseHash
			baseNode.SCORE = ScoringClass.getStateScore(baseNode.END_STATS, MySide, baseNodeBaseHash)
			push(Tree_Array, baseNode)

			if (baseNode.SCORE <= initialScore) continue   // negative-delta bases : skip expansion

			// === Greedy expansion : reuse rawActs across all steps ===
			var current = baseNode
			while (true) {
				var next = findBestNextNode(current, rawActs, MySide)
				if (next == null) break
				push(Tree_Array, next)
				current = next
			}
		}

		// === No-play floor (hide, no action) ===
		var noPlay = new NodeClass(null, State, null)
		noPlay.SCORE = initialScore
		push(Tree_Array, noPlay)

		// === Find best by absolute SCORE ===
		var best = noPlay
		for (var nod in Tree_Array) {
			if (nod.SCORE > best.SCORE) best = nod
		}
		BenchOps.Stop("BFS")

		if (best.ACTION == null) return null
		var ancestor = best
		while (ancestor.PARENT != null) ancestor = ancestor.PARENT
		debug("Best: " + ITEMINFO[ancestor.ACTION.Item].NAME + " | From: " + ancestor.ACTION.From + " | To: " + ancestor.ACTION.To + " | Delta: " + (best.SCORE - initialScore))
		return ancestor.ACTION
	}

	/**
	 * Finds the best next action from Parent's derived state.
	 * Reuses the root-level rawActs (no re-enumeration). Recomputes the
	 * cheap NoEntities walkcells so movement-cost accounting in
	 * ActionToNode stays correct after the leek has moved.
	 */
	static findBestNextNode(Parent, RawActs, MySide) {
		var State = Parent.END_STATS
		if (State[Me].TP < MINIMUM_COST_ITEM) return null

		var BaseHash = Parent.BASE_HASH
		var ParentScore = Parent.SCORE
		var MyWalkCells = WalkCellsClass.getAllLayers(State, Me, BaseHash)
		var actions = filterActions(RawActs, State[Me], MyWalkCells)

		var BestNode = null
		var BestDeltaFromParent = 0
		var BestBaseHash = null

		for (var act in actions) {
			var candidate = NodeClass.ActionToNode(act, State, BaseHash, Parent)
			if (candidate == null) continue
			var candidateBaseHash = StateClass.getBaseHash(candidate.END_STATS)
			var candidateScore = ScoringClass.getStateScore(candidate.END_STATS, MySide, candidateBaseHash)
			var deltaFromParent = candidateScore - ParentScore

			if (deltaFromParent > BestDeltaFromParent) {
				BestDeltaFromParent = deltaFromParent
				BestNode = candidate
				BestNode.SCORE = candidateScore
				BestBaseHash = candidateBaseHash
			}
		}

		if (BestNode != null) BestNode.BASE_HASH = BestBaseHash
		return BestNode
	}

	/**
	 * Cheap filter pass over a pre-enumerated raw action list.
	 * Applies per-state TP / cooldown / uses / reachability filtering.
	 * No fresh enumeration here.
	 */
	static filterActions(Acts, MyStats, MyWalkCells) {
		var _final = []
		for (var Action in Acts) {
			var Item = Action.Item
			if (MyStats.COOLDOWNS[Item] > 0 || MyStats.USES[Item] >= ITEMINFO[Item].MAX_USES) continue

			var From = Action.From
			var Info = ITEMINFO[Item]
			var Cost = (Info.IS_WEAPON && MyStats.WEAPON != Item) ? Info.COST + 1 : Info.COST

			if (!(From in MyWalkCells.WALK)) {
				if (From in MyWalkCells.JUMP) Cost += ITEMINFO[CHIP_JUMP].COST
				else if (From in MyWalkCells.TELEPORTATION) Cost += ITEMINFO[CHIP_TELEPORTATION].COST
				else if (From in MyWalkCells.TELEPORTATION_AND_JUMP) Cost += ITEMINFO[CHIP_JUMP].COST + ITEMINFO[CHIP_TELEPORTATION].COST
				else continue
			}

			if (Cost <= MyStats.TP) push(_final, Action)
		}
		return _final
	}
}
