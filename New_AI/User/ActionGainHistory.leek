// Plusieurs contextes de gain par action, partagés dans UNE recherche.
// La clé décrit les inputs présents avant le cast, jamais l'ordre des casts passés.
include("../includes.leek")

class ActionGainContexts {
    CHANNELS = 0
    SELF = false
    TARGET_IDS = []
    VALUES = [:]
    KEYS = []
    NEXT = 0
    LAST
    constructor(memo) {
        this.CHANNELS = memo.PROFILE.CHANNELS
        this.SELF = memo.SELF
        for (var id: var _before in memo.TARGETS) push(this.TARGET_IDS, id)
    }
}

class ActionGainHistory {
    static MAX_CONTEXTS = 8
    static MAX_ENTRIES = 4096

    // Empreinte de PRESÉLECTION, paresseuse sur le snapshot immuable. Les durées,
    // bases et registres restent validés exactement par ActionGains.matches :
    // un hash égal ne constitue jamais une preuve d'égalité des gains.
    static inputHash(stat) {
        var hash = stat.ACTION_GAIN_HASH
        if (hash != null) return hash
        hash = (OFFSET_BASIS ^ stat.ID) * MIX_A
        hash = ((hash ^ stat.LIFE) * MIX_A ^ stat.TOTAL_LIFE) * MIX_A
        hash = ((hash ^ stat.STRENGTH) * MIX_A ^ stat.WISDOM) * MIX_A
        hash = ((hash ^ stat.AGILITY) * MIX_A ^ stat.RESISTANCE) * MIX_A
        hash = ((hash ^ stat.SCIENCE) * MIX_A ^ stat.MAGIC) * MIX_A
        hash = ((hash ^ stat.POWER) * MIX_A ^ stat.STATES) * MIX_A
        hash = ((hash ^ stat.TOTAL_TP) * MIX_A ^ stat.TOTAL_MP) * MIX_A
        hash = ((hash ^ stat.ABSOLUTE_SHIELD) * MIX_A ^ stat.RELATIVE_SHIELD) * MIX_A
        hash = ((hash ^ stat.DAMAGE_RETURN) * MIX_A ^ stat.POISON_OVER_TIME) * MIX_A
        hash = ((hash ^ stat.AFTEREFFECT_OVER_TIME) * MIX_A ^ stat.HEAL_OVER_TIME) * MIX_A
        stat.ACTION_GAIN_HASH = hash
        return hash
    }

    // Présélection seulement : tous les lecteurs et registres restent certifiés
    // par matches. Les canaux sans interaction omettent les stocks étrangers.
    static channelHash(cache, stat, channels) {
        var input = stat.ACTION_GAIN_INPUTS ?? stat
        var inputId = input.ACTION_GAIN_INPUT_ID
        if (inputId == null) { inputId = ++ActionGains.NEXT_INPUT_ID; input.ACTION_GAIN_INPUT_ID = inputId }
        var key = (inputId << 5) | channels
        var hash = cache.GAIN_HASHES[key]
        if (hash != null) return hash
        hash = ((OFFSET_BASIS ^ input.ID) * MIX_A ^ input.STATES) * MIX_A
        if (channels & 17) {
            hash = ((hash ^ input.STRENGTH) * MIX_A ^ input.WISDOM) * MIX_A
            hash = ((hash ^ input.AGILITY) * MIX_A ^ input.RESISTANCE) * MIX_A
            hash = ((hash ^ input.SCIENCE) * MIX_A ^ input.MAGIC) * MIX_A
            hash = (hash ^ input.POWER) * MIX_A
        }
        if (channels & 1) hash = ((hash ^ input.TOTAL_TP) * MIX_A ^ input.TOTAL_MP) * MIX_A
        if (channels & 6) hash = (hash ^ input.LIFE) * MIX_A
        if (channels & 2) hash = (hash ^ input.ABSOLUTE_SHIELD) * MIX_A
        if (channels & 4) hash = (hash ^ input.RELATIVE_SHIELD) * MIX_A
        if (channels & 8) hash = (hash ^ input.DAMAGE_RETURN) * MIX_A
        cache.GAIN_HASHES[key] = hash
        return hash
    }

    static signature(cache, contexts, State, movement) {
        var channels = contexts.CHANNELS
        var casterHash = channels != 0 && movement == 0
            ? channelHash(cache, State[Me], 16 | (contexts.SELF ? channels : 0)) : inputHash(State[Me])
        var hash = (casterHash ^ movement) * MIX_A
        // XOR des contributions incluant l'id : ordre d'insertion sans importance.
        // Le groupe d'action encode déjà les cibles et leurs distances dans la zone.
        for (var id in contexts.TARGET_IDS) {
            var stat = State[id]
            if (stat == null) return null
            hash ^= channels == 0 ? inputHash(stat) : channelHash(cache, stat, channels)
        }
        return hash
    }

    static find(cache, key, State, playable, Walk, checks, inherited, latest) {
        var contexts = cache.GAIN_HISTORY[key]
        if (contexts == null) return null
        // Avec un seul contexte déjà rejeté, il n'existe rien d'autre à retrouver.
        if (count(contexts.KEYS) == 1 && (contexts.LAST == inherited || contexts.LAST == latest)) return null
        var hash = signature(cache, contexts, State, ActionGains.movementOf(playable, Walk))
        if (hash == null) return null
        var memo = contexts.VALUES[hash]
        if (memo == inherited || memo == latest) return null
        return ActionGains.matches(memo, State, playable, Walk, checks) ? memo : null
    }

    static store(cache, key, memo, State) {
        // Kills, réveils, déplacements forcés, etc. gardent leur garde non locale.
        if (memo.SOURCE != null) return;
        var contexts = cache.GAIN_HISTORY[key]
        if (contexts == null) {
            if (cache.HISTORY_SIZE >= MAX_ENTRIES) return;
            contexts = new ActionGainContexts(memo)
            cache.GAIN_HISTORY[key] = contexts
        }
        var hash = signature(cache, contexts, State, memo.MOVEMENT)
        if (hash == null) return;
        if (!(hash in contexts.VALUES)) {
            if (count(contexts.KEYS) < MAX_CONTEXTS) {
                if (cache.HISTORY_SIZE >= MAX_ENTRIES) return;
                push(contexts.KEYS, hash)
                cache.HISTORY_SIZE++
            } else {
                mapRemove(contexts.VALUES, contexts.KEYS[contexts.NEXT])
                contexts.KEYS[contexts.NEXT] = hash
                contexts.NEXT = (contexts.NEXT + 1) % MAX_CONTEXTS
            }
        }
        contexts.VALUES[hash] = memo
        contexts.LAST = memo
    }
}
