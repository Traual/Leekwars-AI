/**
 * Context for tree generation, keeping track of global records and visited states.
 **/

include("../includes.leek")

class GenerationContextClass {
	bestScore
	visited
	constructor(initialScore) {
		this.bestScore = initialScore
		this.visited = [:]
	}

	isStateDominated(nodeHash, score, tp, mp) {
		if (!(nodeHash in this.visited)) return false
		var current = new VisitedStateClass(score, tp, mp)
		for (var visit in this.visited[nodeHash]) {
			if (VisitedStateClass.isDominating(visit, current)) return true
		}
		return false
	}

	recordState(nodeHash, score, tp, mp) {
		if (!(nodeHash in this.visited)) this.visited[nodeHash] = []
		push(this.visited[nodeHash], new VisitedStateClass(score, tp, mp))
		if (score > this.bestScore) this.bestScore = score
	}
}
