/**
 * FinalCell: Find the best cell to end the turn on.
 * Uses the exact same polynomial formulas as Scoring.leek
 * so that tuning polynomials in Scoring.leek also tunes FinalCell behavior.
 **/

include("../includes.leek")

class FinalCell {
    /* Finds the best cell to end the turn by maximizing a position score.
     * Score = myValue * SurvivalMultiplier * DistMultiplier
     * (Same formula as getStateScore for Me's entity)
     * 
     * @param State Map Id : Entity State
     * @param BaseHash Hash of all other entities positions
     * @return Best cell ID
     */
    static get(State, BaseHash) {
        BenchOps.Start("FinalCell")
        var MyState = State[Me]
        var MySide = MyState.SIDE
        var myId = MyState.ID

        // Get all reachable cells with remaining MP
        var possibleCells = WalkCellsClass.getMaxLayer(State, Me, BaseHash)

        // Pre-compute entity values once (they don't change with my position)
        var entityInfos = []
        for (var e: var stat in State) {
            if (stat.LIFE > 0 && stat.ID != myId) {
                var value = ScoringClass.getEntityIntrinsicScore(stat, State)
                push(entityInfos, [stat.CELL, stat.SIDE, value])
            }
        }

        // My intrinsic value (constant, doesn't depend on position)
        var myValue = ScoringClass.getEntityIntrinsicScore(MyState, State)

        // Pre-load danger context
        var thisStatsHashForDanger = DangerClass.getStatsHashForDanger(MyState, State)
        var thisToSkipMap = DangerClass.EntitiesToSkip(MyState, State, BaseHash)
        var thisEnemiesWalkableCellsMap = DangerClass.LoadEnemiesWalkableCellsMap(State, Me, thisToSkipMap, BaseHash)
        // Pre-compute caster iteration order (constant across cell loop)
        var thisCastersInOrder = StateClass.getEntitiesInTurnOrderAfterEntity(State, myId)

        var bestScore = -MAX_VALUE
        var bestCell = MyState.CELL

        debugC("--- Finding Best Final Cell ---", COLOR_BLUE)

        for (var cell: var mp in possibleCells) {
            // === 1. sit_score equivalent (mirror of ScoringClass.getSitScore) ===
            var danger = DangerClass.get(cell, State, MyState, thisEnemiesWalkableCellsMap, thisToSkipMap, thisStatsHashForDanger, thisCastersInOrder)
            var threat = ScoringClass.solvePoly(POLY_THREAT_DANGER, danger) +
                ScoringClass.solvePoly(POLY_THREAT_POISON, MyState.POISON) +
                ScoringClass.solvePoly(POLY_THREAT_POT, MyState.POISON_OVER_TIME)
            var effective_HP = max(0, MyState.LIFE - threat)
            var ratio = effective_HP / MyState.TOTAL_LIFE
            var sit_score = max(0, ScoringClass.solvePoly(POLY_SIT_SCORE, ratio))

            // === 2. Positional cohesion + engagement to enemies ===
            // FinalCell is where my position MATTERS (turn-end). Unlike state-score
            // during BFS where my cell is transient, here we balance :
            //   - sit_score (low danger preferred)
            //   - cohesion with my allies (POLY_POS_ALLY)
            //   - proximity to enemies (POLY_FINAL_ENEMY_PROX)
            var ally_cohesion = 0
            var enemy_proximity = 0

            for (var info in entityInfos) {
                var dist = CellClass.getDist(cell, info[0])
                var isAlly = (info[1] == MySide)
                var value = info[2]

                if (isAlly) {
                    ally_cohesion += value * ScoringClass.solvePoly(POLY_POS_ALLY, dist)
                } else {
                    enemy_proximity += value * ScoringClass.solvePoly(POLY_FINAL_ENEMY_PROX, dist)
                }
            }

            // === 3. Score Final ===
            // myValue × sit_score = core survival/value term
            // + cohesion + proximity = positional preferences (additive)
            var score = myValue * sit_score + ally_cohesion + enemy_proximity

            if (score > bestScore) {
                bestScore = score
                bestCell = cell
            }
        }

        debug("Best final cell: " + bestCell + " (Score: " + bestScore + ")")
        BenchOps.Stop("FinalCell")
        return bestCell
    }
}