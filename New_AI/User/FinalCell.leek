/**
 * FinalCell : choose the cell to end the turn on.
 *
 * Scoring v3 (Σ life) does NOT depend on where I stand — my life is my life on
 * any cell. So the only thing that varies with the end cell is my SAFETY.
 * FinalCell therefore picks the reachable cell with the LOWEST danger (matches
 * Play's intent: "then go hide to minimize danger"). Reuses the danger module
 * unchanged. Positional richness (cover / engagement range) will return in a
 * later scoring layer; for now: safest reachable cell.
 **/

include("../includes.leek")

class FinalCell {
    /* Finds the safest reachable cell to end the turn on.
     *
     * @param State    Map <Id : EntityState>
     * @param BaseHash Hash of all other entities' positions
     * @return Best cell ID (lowest danger reachable cell)
     */
    static get(State, BaseHash) {
        BenchOps.Start("FinalCell")
        var MyState = State[Me]
        var myId = MyState.ID

        // Cells I can reach with my remaining MP.
        var possibleCells = WalkCellsClass.getMaxLayer(State, Me, BaseHash)

        // Danger context (same setup the danger module uses everywhere else).
        var thisStatsHashForDanger     = DangerClass.getStatsHashForDanger(MyState, State)
        var thisToSkipMap              = DangerClass.EntitiesToSkip(MyState, State, BaseHash)
        var thisEnemiesWalkableCellsMap = DangerClass.LoadEnemiesWalkableCellsMap(State, Me, thisToSkipMap, BaseHash)
        var thisCastersInOrder         = StateClass.getEntitiesInTurnOrderAfterEntity(State, myId)

        var bestCell = MyState.CELL
        var bestDanger = MAX_VALUE

        debugC("--- Finding Best Final Cell (min danger) ---", COLOR_BLUE)
        for (var cell: var mp in possibleCells) {
            var dangerMap = DangerClass.get(cell, State, MyState, thisEnemiesWalkableCellsMap, thisToSkipMap, thisStatsHashForDanger, thisCastersInOrder)
            var danger = DangerClass.sumDamages(dangerMap)
            if (danger < bestDanger) {
                bestDanger = danger
                bestCell = cell
                if (danger == 0) break   // can't do better than a fully safe cell
            }
        }

        debug("Best final cell: " + bestCell + " (danger: " + bestDanger + ")")
        BenchOps.Stop("FinalCell")
        return bestCell
    }
}
