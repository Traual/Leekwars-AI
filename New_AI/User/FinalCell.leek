/*
 * FinalCell : l'évaluateur TERMINAL. Le score de l'arbre ne dit rien d'où je me tiens — la
 * valeur de Me ne lit pas sa cellule — donc toute ma sécurité et tout mon positionnement se
 * décident ici, sous forme d'une PÉNALITÉ à retrancher au score.
 *
 *   placementPenalty = coût spatial (GravityClass) + coût du danger à la cellule
 *
 * Les deux composantes sont des COÛTS : plus bas = mieux, jamais négatives. C'est ce qui
 * rend la coupure du reclassement terminal exacte — finalScore <= rawScore, toujours.
 *
 * SOURCE UNIQUE : la même fonction sert au reclassement des branches (BFS) et au placement
 * réellement joué en fin de tour (Play). Un état identique évalué deux fois rend le même
 * résultat, aux caches près.
 */

include("../includes.leek")

// Cout d'une construction A FROID des deux structures lourdes que le placement lit, relevé par
// le prechauffage de la racine a chaque tour : aucune des deux ne s'interrompt en route, et une
// evaluation ne s'ouvre que si le budget couvre ce qui lui manque encore.
// Mesure sur les builds du meta : la PREMIERE carte de soin d'un tour coute 1,6 M (toutes les
// couvertures de soigneurs), une carte REBATIE ensuite 17 k en mediane et 485 k au pire ; un plan
// de danger a couvertures froides coute 1,4 a 4 MILLIONS. Valeurs de depart au-dessus du courant,
// relevees par chaque mesure du tour.
global OPS_COLD_HEAL = 3000000
global OPS_REBUILD_HEAL = 500000
global OPS_COLD_PLAN = 3000000

class FinalCell {

    /*
     * Cellule de fin de tour réellement jouée. Reconstruit le contexte depuis l'état — appelée
     * UNE fois par tour, quand toutes les actions ont été jouées.
     *
     * @param State [id -> stats]
     * @param BaseHash hash (id, cellule) des vivants
     * @return id de cellule
     */
    static get(State, BaseHash) {
        // Un tour qui commence déjà au-delà de sa date limite — un bulbe dont l'invocateur a
        // consommé le compteur partagé — sort de la boucle de Play avant toute planification, et
        // le contexte de poids n'a jamais été construit pour ce tour. Chaque lecture de poids
        // levait alors une erreur, et leur rafale épuisait le budget jusqu'à l'avortement : ni
        // placement, ni déplacement. Les poids historiques suffisent à se placer.
        if (REPLAN_WEIGHTS == null) REPLAN_WEIGHTS = HistoricalWeightsFactory.build(State, State[Me].SIDE)
        var contextBySide = DeltaClass.buildContextBySide(State)
        var hfpBySide = HealClass.buildHfpBySide(State)
        var combinedHfp = 0
        for (var s: var h in hfpBySide) combinedHfp ^= h
        var meWalkFp = WalkCellsClass.HashWalkCellsWithItemsWithoutBaseHash(State[Me])
        // Le deplacement qui suit lit les QUATRE couches de mobilite (WalkCellsClass.MoveTo),
        // la ou le balayage n'en demande qu'une : les construire ICI, budget intact. Sinon
        // elles se paient APRES le balayage, quand il ne reste que la marge de deplacement,
        // et le moteur coupe le tour dans le deplacement lui-meme.
        WalkCellsClass.getAllLayers(State, Me, BaseHash)
        // Le placement REEL de fin de tour se tronque au plus pres du plafond, en ne gardant que de
        // quoi bouger : c'est lui que le moteur tue quand le budget est epuise (585 tours mesures sur
        // 480 combats, contre 3 pour main). Le balayage est un MINIMUM dont la graine est ma cellule
        // courante : s'arreter en route rend donc une reponse VALIDE, seulement moins bonne —
        // strictement mieux que de mourir dedans, et mieux que de ne pas se placer du tout (mesure :
        // sauter le placement coute -0,055, et -0,425 sous 8 coeurs).
        // Le danger d'une cellule demande parfois de reconstruire A FROID le plan de danger, ce
        // que la fin de tour ne finance plus — et cette reconstruction ne s'interrompt pas, donc
        // le moteur tuait le tour dedans. Sous cette marge, le balayage garde son seul cout
        // SPATIAL : une reponse degradee, mais complete sur toutes mes cellules accessibles.
        var budget = OPS_CAP - OPS_MOVE_MARGIN
        var withDanger = getOperations() + coldCost(State, combinedHfp) <= budget
        if (!withDanger) debugW("[placement] danger non financable : cout spatial seul")
        var res = evaluate(State, BaseHash, contextBySide, hfpBySide, combinedHfp, meWalkFp, budget, withDanger)
        debug("Best final cell: " + res[0] + " (pénalité: " + res[1] + ", net: " + res[2] + ")")
        // Le placement RÉELLEMENT joué, sous la même forme que les suites du diagnostic.
        if (ScoringClass.diagActive()) {
            debug("[diag] placement joue | cellule " + res[0] + " | depuis " + State[Me].CELL
                + " | penalite " + res[1] + " | net " + res[2] + " | mode " + DIAG_PLACEMENT_MODE
                + " | tronque " + (count(res) > 3))
        }
        return res[0]
    }

    /*
     * Construit les objets que le balayage lira : la carte de soin et le plan de danger de mon
     * camp, avec les deux séquences de Me. Le score de la recherche ne lit plus ni danger ni
     * soins, donc plus personne ne les chauffe : sans cet appel à la RACINE, la première clôture
     * terminale les paie en fin de tour, budget déjà dépensé, et le moteur coupe le tour dedans.
     *
     * @param State état de la racine
     * @param BaseHash hash (id, cellule) des vivants
     * @param contextBySide [side -> hash de l'équipe adverse]
     * @param combinedHfp fold XOR des empreintes de soigneurs
     */
    static prewarm(State, BaseHash, contextBySide, combinedHfp) {
        var avant = getOperations()
        // Premiere carte de soin du tour ou simple reconstruction : deux regimes de cout, donc
        // deux marges. Les caches de soin sont vides au debut de chaque tour.
        var premiereDuTour = mapIsEmpty(HEAL_MAP_CACHE)
        HealClass.getHealMapByFp(State, combinedHfp)
        var apresSoin = getOperations()
        var mySide = State[Me].SIDE
        var plan = DangerPlanClass.getTeamPlan(State, BaseHash, contextBySide[mySide], mySide)
        DangerPlanClass.coverageSequenceFor(plan, Me)
        DangerPlanClass.netSequenceFor(plan, Me)
        // Seules constructions a froid que l'IA paie en les voyant : elles calibrent les marges.
        var coutSoin = apresSoin - avant
        if (premiereDuTour) {
            if (coutSoin > OPS_COLD_HEAL) OPS_COLD_HEAL = coutSoin
        } else if (coutSoin > OPS_REBUILD_HEAL) {
            OPS_REBUILD_HEAL = coutSoin
        }
        var coutPlan = getOperations() - apresSoin
        if (coutPlan > OPS_COLD_PLAN) OPS_COLD_PLAN = coutPlan
    }

    /*
     * Ce qu'une evaluation de placement devrait encore CONSTRUIRE, en operations : la carte de
     * soin si son empreinte est inconnue, et les couvertures d'items des menaces adverses si
     * elles manquent. Ce sont les deux seules parts lourdes — un plan d'equipe rebati sur des
     * couvertures deja chaudes coute quelques milliers d'operations — et les deux seules qui ne
     * s'interrompent pas. Lecture seule, memes cles que DangerPlanClass.getTeamPlan.
     *
     * @param State etat a evaluer
     * @param combinedHfp fold XOR des empreintes de soigneurs
     * @return le cout a prevoir, 0 si tout est deja construit
     */
    static coldCost(State, combinedHfp) {
        var cout = 0
        if (!(combinedHfp in HEAL_MAP_CACHE)) cout = mapIsEmpty(HEAL_MAP_CACHE) ? OPS_COLD_HEAL : OPS_REBUILD_HEAL
        var mySide = State[Me].SIDE
        for (var e: var stat in State) {
            if (e == Me || stat.LIFE <= 0 || stat.SIDE == mySide) continue
            if (count(EntityDangerClass.getItemsList(stat)) == 0) continue
            if (!(DangerPlanClass.mapCellItemAoeKeyOf(stat) in MAP_CELL_ITEM_AOE_CACHE)) return cout + OPS_COLD_PLAN
            for (var t = 0; t < 4; t++) {
                if (!WalkCellsClass.dangerTierAvailable(stat, t)) continue
                if (!(DangerPlanClass.mapCellItemAoeKeyForLayer(stat, t) in MAP_CELL_ITEM_AOE_CACHE)) return cout + OPS_COLD_PLAN
            }
        }
        return cout
    }

    /*
     * Meilleur placement terminal d'un état : la cellule accessible de pénalité MINIMALE.
     *
     * Les métadonnées viennent de l'appelant — un nœud du BFS les porte déjà toutes, rien
     * n'est reconstruit par feuille.
     *
     * @param State [id -> stats] de l'état à clore
     * @param BaseHash hash (id, cellule) des vivants
     * @param contextBySide [side -> hash de l'équipe adverse] (node.CONTEXT_BY_SIDE)
     * @param hfpBySide [side -> fingerprint des soigneurs] (node.HFP_BY_SIDE)
     * @param combinedHfp fold XOR des empreintes, clé de la heal map (node.COMBINED_HFP)
     * @param meWalkFp empreinte de mobilité de Me (node.ME_WALK_FINGERPRINT) : avec BaseHash,
     *        elle fixe exactement mes cellules accessibles
     * @param truncateAt nombre d'opérations au-delà duquel le balayage s'arrête sur le meilleur
     *        trouvé : près du plafond pour le placement réel, plus tôt pour le reclassement du BFS
     * @param withDanger faux quand le budget ne finance plus le danger des cellules : la pénalité
     *        se réduit alors au coût spatial, et le résultat n'entre pas dans le mémo
     * @return [meilleure cellule, pénalité (>= 0), net à cette cellule], suivi de true si le
     *        balayage a été tronqué — sa pénalité n'est alors qu'un majorant du minimum
     */
    static evaluate(State, BaseHash, contextBySide, hfpBySide, combinedHfp, meWalkFp, truncateAt, withDanger) {
        BenchOps.Start("FinalCell")
        var MyState = State[Me]
        var mySide = MyState.SIDE

        // MÊMES primitives, MÊMES clés, MÊMES caches que le reste de l'IA : le placement
        // hérite des caches chauffés par la recherche au lieu d'entretenir un quatrième
        // chemin divergent.
        var offensiveContextHash = contextBySide[mySide]
        var antidoteCd           = DangerComboClass.antidoteCdOf(MyState)
        var targetSeed           = DeltaClass.targetDangerSeedOf(MyState, offensiveContextHash, antidoteCd)
        var dangerCellSeed       = DangerClass.cellCacheSeed(targetSeed, MyState.ID)
        var seed                 = DeltaClass.fleeSeedOf(MyState, targetSeed, hfpBySide[mySide])

        // Le reclassement terminal rouvre deux fois sur trois un état déjà évalué : le memo
        // épargne alors le balayage entier. Sa clé porte TOUT ce dont la pénalité dépend — le
        // terrain et ma mobilité (donc mes cellules accessibles), la graine de fuite (qui porte
        // déjà menace adverse, mes boucliers, mon antidote, ma vie et ma vie max, dont le masque
        // d'immunités) et les soigneurs des deux camps. La pénalité ne lit rien d'autre : ni mes
        // flux périodiques, ni mes caractéristiques, qui ne changent pas ce qu'un net me coûte.
        var memoKey = mix64(mix64(BaseHash ^ seed) ^ mix64(meWalkFp) ^ combinedHfp)
        if (memoKey in FINAL_PLACEMENT_CACHE) {
            // Diagnostic armé : dire lequel des trois modes a produit cette pénalité. Un danger
            // servi par le mémo a bien été calculé ; un danger sauté ne vaut PAS un danger nul.
            if (DIAG_TURN != 0) DIAG_PLACEMENT_MODE = "memo"
            BenchOps.Stop("FinalCell")
            return FINAL_PLACEMENT_CACHE[memoKey]
        }
        if (DIAG_TURN != 0) DIAG_PLACEMENT_MODE = withDanger ? "danger calcule" : "spatial seul"

        // Cellules accessibles avec mes MP restants.
        var possibleCells = WalkCellsClass.getMaxLayer(State, Me, BaseHash)
        // Sans danger, la carte de soin n'a aucun lecteur — et c'est justement une des deux
        // constructions que le budget ne finançait pas.
        var healMap = withDanger ? HealClass.getHealMapByFp(State, combinedHfp) : null

        var finalWeights = REPLAN_WEIGHTS.FINAL_CELL_WEIGHTS
        // Le coût de soin n'est calculé que si un poids le réclame : sans lui, la map de danger
        // n'est même pas parcourue.
        var wantHealCost = finalWeights.HEAL_COST != 0

        var bestCell    = MyState.CELL
        var bestPenalty = MAX_VALUE
        var bestNet     = 0

        // Objets communs à tout le balayage (plan, buckets, deux séquences), matérialisés au
        // PREMIER vrai miss et pas avant : une cellule déjà en cache n'en construit aucun.
        var lazy = [null, null, null, null]

        // Vrai seulement si le budget a coupe le balayage : le resultat n'est alors PAS
        // l'optimum du set, il ne doit pas entrer dans le memo qui promet le contraire.
        var truncated = false
        for (var cell: var mp in possibleCells) {
            // Budget epuise : on garde le meilleur trouve jusqu'ici. Le seuil vient de l'appelant —
            // le reclassement du BFS doit laisser intacte la part du placement reel, celui-ci ne
            // garde que de quoi bouger.
            if (getOperations() > truncateAt) {
                truncated = true
                break
            }
            // Le coût spatial est un PLANCHER de la pénalité de cette cellule : le coût du
            // danger ne peut que s'y ajouter. Une cellule dont le seul spatial dépasse déjà le
            // meilleur total ne peut pas gagner — coupure EXACTE, et elle épargne le net,
            // de loin le calcul le plus cher des deux.
            var spatial = SCORE_SPATIAL_SCALE * GravityClass.costAt(State, BaseHash, cell)
            if (spatial >= bestPenalty) continue

            var net = withDanger ? DeltaClass.netAtFleeCell(cell, seed, dangerCellSeed, MyState, State, BaseHash, offensiveContextHash, mySide, antidoteCd, healMap, lazy, wantHealCost) : 0
            var penalty = spatial
            // Le soin que la cellule consomme s'ajoute au coût. Positif par construction, donc
            // le spatial reste un minorant de la pénalité et la coupure du balayage reste exacte.
            if (withDanger && wantHealCost) penalty += finalWeights.HEAL_COST * CELL_FLEE_HEALCOST_CACHE[seed ^ cell]
            if (net > 0) {
                // Les PV que ce net me coûterait réellement (ScoringClass.exposureLoss) : une
                // valeur positive, donc le spatial reste un minorant de la pénalité.
                penalty += finalWeights.NET * ScoringClass.exposureLoss(net, MyState)
            }
            if (penalty < bestPenalty) {
                bestPenalty = penalty
                bestCell = cell
                bestNet = net
                if (penalty == 0) break   // borne parfaite : rien ne peut faire mieux
            }
        }

        // Renvoyé PAR RÉFÉRENCE, read-only en aval comme les autres maps cachées de l'IA.
        // Un balayage tronque n'est pas l'optimum : il le dit a l'appelant, et le memoriser servirait
        // une reponse degradee a un etat qui, lui, aurait le budget de faire mieux.
        var res = truncated ? [bestCell, bestPenalty, bestNet, true] : [bestCell, bestPenalty, bestNet]
        // Une penalite sans danger est PARTIELLE : elle ne doit pas etre servie a un etat qui,
        // lui, aurait le budget de la calculer en entier.
        if (!truncated && withDanger) FINAL_PLACEMENT_CACHE[memoKey] = res
        BenchOps.Stop("FinalCell")
        return res
    }
}
