/*
 * FinalCell : la cellule de fin de tour. Le score (Σ survie) ne dépend pas d'où je me tiens,
 * le placement est donc un choix pur POSITIONNEMENT + SÉCURITÉ, en deux couches :
 *   1. GRAVITY classe chaque cellule accessible (cohésion alliés, approche ennemis,
 *      anti-AoE, covid...).
 *   2. SÉCURITÉ filtre par le NET que j'y prendrais (danger amorti par les heals, séquencé
 *      par ordre de tour) — le même net que le scoring.
 * On parcourt les cellules par gravité décroissante et on prend la PREMIÈRE totalement sûre
 * (net == 0) ; sinon, celle du net minimal (départagée par l'ordre de gravité).
 */

include("../includes.leek")

class FinalCell {
    /*
     * Meilleure cellule de fin de tour : la plus haute gravité totalement sûre, sinon le
     * moindre net.
     *
     * @param State [id -> stats]
     * @param BaseHash hash (id, cellule) des vivants
     * @return id de cellule
     */
    static get(State, BaseHash) {
        BenchOps.Start("FinalCell")
        var MyState = State[Me]
        var myId = MyState.ID

        // Cellules accessibles avec mes MP restants.
        var possibleCells = WalkCellsClass.getMaxLayer(State, Me, BaseHash)

        // Positionnement (gravity) + heal map (pour le net heal-aware).
        var gravityMap = GravityClass.loadGravityMap(State, possibleCells)
        var healMap    = HealClass.getHealMap(State)

        // Meilleur placement d'abord.
        var cells = arraySort(mapKeys(possibleCells), function(a, b) { return gravityMap[b] - gravityMap[a] })

        // MÊME pipeline que le BFS : même graine de cible, même plan offensif, même primitive
        // froide, même groupement local progressif. FinalCell hérite donc des caches chauffés
        // par la recherche au lieu d'entretenir un quatrième chemin divergent.
        var mySide                 = MyState.SIDE
        var offensiveContextHash   = DeltaClass.buildContextBySide(State)[mySide]
        var antidoteCd             = DangerComboClass.antidoteCdOf(MyState)
        var targetSeed             = DeltaClass.targetDangerSeedOf(MyState, offensiveContextHash, antidoteCd)
        var dangerCellSeed         = DangerClass.cellCacheSeed(targetSeed, myId)

        var bestCell = MyState.CELL
        var bestNet  = MAX_VALUE

        // Plan et buckets PARESSEUX : une cellule déjà en cache n'en construit aucun.
        var plan = null
        var myNetSeq = null   // séquence restreinte aux casters qui peuvent changer mon net
        var myCovSeq = null   // séquence restreinte aux menaces, pour les couvertures de cellule
        var buckets = null

        debugC("--- Finding Best Final Cell (gravity-sorted, heal-aware net) ---", COLOR_BLUE)
        for (var cell in cells) {
            var dangerKey = dangerCellSeed ^ cell
            var dangerMap
            if (dangerKey in CELL_DANGER_GET_CACHE) {
                dangerMap = CELL_DANGER_GET_CACHE[dangerKey]
            } else {
                if (plan == null) {
                    plan = DangerPlanClass.getTeamPlan(State, BaseHash, offensiveContextHash, mySide)
                    buckets = [: ]
                }
                // Le plan a pu naître dans le bloc du net : la séquence de couverture se résout
                // donc ici, indépendamment de qui a créé le plan.
                if (myCovSeq == null) myCovSeq = DangerPlanClass.coverageSequenceFor(plan, myId)
                dangerMap = DangerClass.dangerOfCellCold(cell, dangerKey, plan, myCovSeq, State, MyState, antidoteCd, buckets)
            }
            var net = 0
            if (!mapIsEmpty(dangerMap)) {
                if (plan == null) plan = DangerPlanClass.getTeamPlan(State, BaseHash, offensiveContextHash, mySide)
                if (myNetSeq == null) myNetSeq = DangerPlanClass.netSequenceFor(plan, myId)
                net = DeltaClass.netDamage(MyState, dangerMap, healMap, State, myNetSeq, cell)
            }
            if (net == 0) { bestCell = cell ; bestNet = 0 ; break }   // meilleure gravité ET sûre -> fini
            if (net < bestNet) { bestNet = net ; bestCell = cell }
        }

        debug("Best final cell: " + bestCell + " (net: " + bestNet + ")")
        BenchOps.Stop("FinalCell")
        return bestCell
    }
}
