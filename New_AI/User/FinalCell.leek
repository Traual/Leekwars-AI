/**
 * FinalCell: Find the best cell to end the turn on.
 * Uses the exact same polynomial formulas as Scoring.leek
 * so that tuning polynomials in Scoring.leek also tunes FinalCell behavior.
 **/

include("../includes.leek")

class FinalCell {
    /* Finds the best cell to end the turn by maximizing a position score.
     * Score = myValue * SurvivalMultiplier * DistMultiplier
     * (Same formula as getStateScore for Me's entity)
     * 
     * @param State Map Id : Entity State
     * @param BaseHash Hash of all other entities positions
     * @return Best cell ID
     */
    static get(State, BaseHash) {
        var MyState = State[Me]
        var MySide = MyState.SIDE
        var myId = MyState.ID

        // Get all reachable cells with remaining MP
        var WalkCells = new WalkCellsClass(State, Me, true, true, true, true, BaseHash)
        var possibleCells = WalkCells.MAX

        // Pre-compute entity values once (they don't change with my position)
        var entityInfos = []
        for (var e: var stat in State) {
            if (stat.LIFE > 0 && stat.ID != myId) {
                var value = ScoringClass.getEntityIntrinsicScore(stat, State)
                push(entityInfos, [stat.CELL, stat.SIDE, value])
            }
        }

        // My intrinsic value (constant, doesn't depend on position)
        var myValue = ScoringClass.getEntityIntrinsicScore(MyState, State)

        // Pre-load danger context
        var thisStatsHashForDanger = DangerClass.getStatsHashForDanger(MyState, State, BaseHash)
        var thisToSkipMap = DangerClass.EntitiesToSkip(MyState, State, BaseHash)
        var thisEnemiesWalkableCellsMap = DangerClass.LoadEnemiesWalkableCellsMap(State, Me, thisToSkipMap, BaseHash)

        var bestScore = -MAX_VALUE
        var bestCell = MyState.CELL

        debugC("--- Finding Best Final Cell ---", COLOR_BLUE)

        for (var cell: var mp in possibleCells) {
            // === 1. DistMultiplier (miroir exact de ScoringClass.getDistMultiplier) ===
            var allyRelSum = 0
            var allyWeight = 0
            var enemyRelSum = 0
            var enemyWeight = 0

            for (var info in entityInfos) {
                var dist = CellClass.getDist(cell, info[0])
                var isAlly = (info[1] == MySide)
                var value = info[2]

                if (isAlly) {
                    allyRelSum += value * ScoringClass.solvePoly(POLY_DIST_RELATION_ALLY, dist)
                    allyWeight += value
                } else {
                    enemyRelSum += value * ScoringClass.solvePoly(POLY_DIST_RELATION_ENEMY, dist)
                    enemyWeight += value
                }
            }

            var allyScore = (allyWeight > 0) ? (allyRelSum / allyWeight) : 1.0
            var enemyScore = (enemyWeight > 0) ? (enemyRelSum / enemyWeight) : 1.0
            var avgRelation = (allyScore + enemyScore) / 2.0
            var distMultiplier = max(0.1, ScoringClass.solvePoly(POLY_DIST_FINAL, avgRelation))

            // === 2. SurvivalMultiplier (miroir exact de ScoringClass.getSurvivalMultiplier) ===
            var danger = DangerClass.get(cell, State, MyState, thisEnemiesWalkableCellsMap, thisToSkipMap, thisStatsHashForDanger)
            var totalThreat = ScoringClass.solvePoly(POLY_THREAT_DANGER, danger) +
                ScoringClass.solvePoly(POLY_THREAT_POISON, MyState.POISON) +
                ScoringClass.solvePoly(POLY_THREAT_POT, MyState.POISON_OVER_TIME)
            var survivalRatio = (MyState.LIFE - totalThreat) / MyState.TOTAL_LIFE
            var survivalMultiplier = max(0, ScoringClass.solvePoly(POLY_SURVIVAL, survivalRatio))

            // === 3. Score Final (même formule que getStateScore pour une entité) ===
            var score = myValue * survivalMultiplier * distMultiplier

            if (score > bestScore) {
                bestScore = score
                bestCell = cell
            }
        }

        debug("Best final cell: " + bestCell + " (Score: " + bestScore + ")")
        return bestCell
    }
}