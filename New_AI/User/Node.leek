/**
 * Here we have the Node Class ! Used in action Suite to keep track of EndStats
 **/

include("../includes.leek")

class NodeClass {
	ACTION
	END_STATS
	PARENT      // Node we came from (null for root / base / no-play)
	SCORE       // Absolute state score of END_STATS (cached, filled by BFS)
	BASE_HASH   // BaseHash of END_STATS (filled by BFS for cache lookup)
	CONTEXT_BY_SIDE   // Phase 2: per-side opposing-team context, patched incrementally at creation
	HFP_BY_SIDE       // Phase 4a: per-side healers fingerprint, patched incrementally at creation
	CLONED            // Phase 4a: the clonedIds map = the EXACT set of possibly-mutated entities
	FULL_REBUILD      // Phase 4a: true on the summon/resurrect fallback -> incremental scoring must full-rescore
	TERMS             // Phase 4a mode 2: [entityId -> SIGNED term], cloned from the parent + patched (null in mode 1)
	constructor(Act, StatsAfterAction, Parent) {
		this.ACTION = Act
		this.END_STATS = StatsAfterAction
		this.PARENT = Parent
	}

	/* Simplified entry (fewer params) of ActionToNodeInTree: derives walkcells + cost, then delegates.
	 * Used by enumerateAndSort (base nodes) and findBestNextNode (expansion candidates).
	 *
	 * @param Action Action to turn into a node
	 * @param State Map <Id : Class Stats of Id> (the PARENT state)
	 * @param BaseHash BaseHash of the parent State
	 * @param Parent Parent node (null for base nodes)
	 * @param ParentContext Parent's CONTEXT_BY_SIDE (patched incrementally onto the child)
	 *
	 * @return New Node Class
	 */

	static ActionToNode(Action, State, BaseHash, Parent, ParentContext, ParentHfp) {
		if (Action == null) return;
		BenchOps.Start("Node")
		var MyState = State[Me]
		var MyCell = MyState.CELL
		var MyWalkCells = WalkCellsClass.getAllLayers(State, Me, BaseHash)
		var Item = Action.Item
		var From = Action.From
		var To = Action.To
		var Info = ITEMINFO[Item]
		var Cost = Info.IS_WEAPON && MyState.WEAPON != Item ?
			Info.COST + 1 :
			Info.COST
		if (!(From in MyWalkCells.WALK)) { //I need to add the item to move to the cost
			if (From in MyWalkCells.JUMP) {
				Cost += ITEMINFO[CHIP_JUMP].COST
			} else if (From in MyWalkCells.TELEPORTATION) {
				Cost += ITEMINFO[CHIP_TELEPORTATION].COST
			} else if (From in MyWalkCells.TELEPORTATION_AND_JUMP) {
				Cost += ITEMINFO[CHIP_TELEPORTATION].COST + ITEMINFO[CHIP_JUMP].COST
			}
		}
		var result = ActionToNodeInTree(Action, State, From, MyWalkCells, Cost, Info, Item, To, BaseHash, Parent, ParentContext, ParentHfp)
		BenchOps.Stop("Node")
		return result
	}

	/* It is a complicated version with more parameters of ActionToNode to avoid reloading informations that i already have. It is used in Action Suite in using the best play to expand the existing base nodes
	 *
	 * @param Act Action that i want to transform into a node
	 * @param State Map <Id : Class Stats of Id>
	 * @param From : Cell From (Act.FROM)
	 * @param MyWalkCells Class WalkCells of my entity
	 * @param Cost Total cost of the action including weapon changes, jump etc
	 * @param Info Class ItemInfo of (Item)
	 * @param Item : Item to use (Act.ITEM)
	 * @param To : Cell To (Act.TO)
	 * @param BaseHash BaseHash of the parent State
	 * @param Parent Parent node (null for base nodes)
	 * @param ParentContext Parent's CONTEXT_BY_SIDE (cloned + patched incrementally onto the child)
	 *
	 * @return New Node Class
	 */

	static ActionToNodeInTree(Act, State, From, MyWalkCells, Cost, Info, Item, To, BaseHash, Parent, ParentContext, ParentHfp) {
		var Targets = ConsequencesClass.ConsequenceTargets(Item, From, To, State, Me, BaseHash)
		// clonedIds = the EXACT set of possibly-mutated entities: Targets+Me pre-cloned here, plus every
		// kill-path side-victim (summon cascade, buff unwind, weapon procs) cloned-on-write by
		// StateClass.ensureCloned inside getConsequences. Local, threaded as a parameter (no global).
		var clonedIds = [: ]
		var ThisActionStats = StateClass.CloneOnlyTargetsAndMe(Targets, State, clonedIds)

		// FIX RESURRECTION : Les entités mortes alliées doivent être clonées 
		// car ResurrectionClass.Update va modifier leurs stats (LIFE, CELL, etc.)
		if (Item == CHIP_RESURRECTION) {
			for (var e: var stat in State) {
				if (stat.LIFE <= 0 && stat.SIDE == State[Me].SIDE && !(e in Targets)) {
					ThisActionStats[e] = clone(stat, 2)
					clonedIds[e] = true
				}
			}
		}

		ThisActionStats[Me].CELL = From
		if (From in MyWalkCells.WALK) { //Removing Mps
			ThisActionStats[Me].MP -= MyWalkCells.WALK[From]
		} else if (From in MyWalkCells.JUMP) {
			ThisActionStats[Me].MP -= MyWalkCells.JUMP[From]
		} else if (From in MyWalkCells.TELEPORTATION) {
			ThisActionStats[Me].MP -= MyWalkCells.TELEPORTATION[From]
		} else if (From in MyWalkCells.TELEPORTATION_AND_JUMP) {
			ThisActionStats[Me].MP -= MyWalkCells.TELEPORTATION_AND_JUMP[From]
		}
		ThisActionStats[Me].TP -= Cost //We Remove TP
		if (Info.IS_WEAPON) ThisActionStats[Me].WEAPON = Item //Change Entity Weapon
		ConsequencesClass.getConsequences(ThisActionStats, Item, From, To, Me, BaseHash, clonedIds) //Changing item consequences
		ThisActionStats[Me].COOLDOWNS[Item] = Info.COOLDOWN //Adding the cooldown
		ThisActionStats[Me].USES[Item]++ //Adding the uses
		if (!(From in MyWalkCells.WALK)) { //Adding the moving item cooldown
			if (From in MyWalkCells.JUMP) {
				ThisActionStats[Me].COOLDOWNS[CHIP_JUMP] = ITEMINFO[CHIP_JUMP].COOLDOWN //Adding the jump cooldown
			} else if (From in MyWalkCells.TELEPORTATION) {
				ThisActionStats[Me].COOLDOWNS[CHIP_TELEPORTATION] = ITEMINFO[CHIP_TELEPORTATION].COOLDOWN //Adding the Teleportation cooldown
			} else if (From in MyWalkCells.TELEPORTATION_AND_JUMP) { //Adding both cooldowns
				ThisActionStats[Me].COOLDOWNS[CHIP_JUMP] = ITEMINFO[CHIP_JUMP].COOLDOWN //Adding the jump cooldown
				ThisActionStats[Me].COOLDOWNS[CHIP_TELEPORTATION] = ITEMINFO[CHIP_TELEPORTATION].COOLDOWN //Adding the Teleportation cooldown
			}
		}
		var result = new NodeClass(Act, ThisActionStats, Parent) //Creating Node

		result.CLONED = clonedIds

		// === Phase 2 + 4a: incremental hash patch (BASE_HASH + CONTEXT_BY_SIDE + HFP_BY_SIDE) ===
		if (Item == CHIP_RESURRECTION || mapSize(ThisActionStats) != mapSize(State)) {
			// Summon / resurrect ADD entities -> full recompute for now.
			// TODO Phase 2+: patch the born/revived entities incrementally instead of a full rebuild.
			result.BASE_HASH = StateClass.getBaseHash(ThisActionStats)
			result.CONTEXT_BY_SIDE = DeltaClass.buildContextBySide(ThisActionStats)
			result.HFP_BY_SIDE = HealClass.buildHfpBySide(ThisActionStats)
			result.FULL_REBUILD = true
		} else {
			// Patch over clonedIds — the EXACT set of possibly-mutated entities (Targets+Me pre-cloned
			// + kill-path side-victims cloned-on-write). Covers cascade/unwind/procs by construction;
			// the parent State keeps the pristine old values (it is never mutated anymore).
			var bh = BaseHash                    // parent State's BaseHash
			var ctx = clone(ParentContext, 1)    // copy so we never mutate the parent's context
			var ctxSides = mapKeys(ctx)          // hoisted: the side set never changes inside the patch loop
			var hfpMap = clone(ParentHfp, 1)     // Phase 4a: healers fingerprint, patched like the context
			var mySide = ThisActionStats[Me].SIDE
			for (var tar: var _c in clonedIds) {
				if (tar == Me) continue          // Me excluded from all three hashes
				var oldStat = State[tar]
				var newStat = ThisActionStats[tar]
				bh ^= StateClass.baseContribution(oldStat, tar) ^ StateClass.baseContribution(newStat, tar)
				var deltaCtx = DeltaClass.contextContribution(oldStat, tar) ^ DeltaClass.contextContribution(newStat, tar)
				if (deltaCtx != 0) {
					var side = newStat.SIDE      // side doesn't change
					for (var s in ctxSides) if (s != side) ctx[s] ^= deltaCtx
				}
				var deltaHfp = HealClass.healerContributionOf(oldStat, tar, mySide) ^ HealClass.healerContributionOf(newStat, tar, mySide)
				if (deltaHfp != 0) hfpMap[mySide] = ((mySide in hfpMap) ? hfpMap[mySide] : 0) ^ deltaHfp
			}
			result.BASE_HASH = bh
			result.CONTEXT_BY_SIDE = ctx
			result.HFP_BY_SIDE = hfpMap
			result.FULL_REBUILD = false
		}

		// TEMP 4a.0 self-test (remove once validated): the patched HFP must equal a full rebuild.
		// Compare VALUES with a 0-default (the builder omits the key when fp == 0, the patch may keep it).
		var fullHfp = HealClass.buildHfpBySide(ThisActionStats)
		var msT = ThisActionStats[Me].SIDE
		var hfpPatched = (msT in result.HFP_BY_SIDE) ? result.HFP_BY_SIDE[msT] : 0
		var hfpFull = (msT in fullHfp) ? fullHfp[msT] : 0
		if (hfpPatched != hfpFull) debugC("[HFPTEST] " + hfpPatched + " != " + hfpFull + " item=" + Item, COLOR_RED)

		return result
	}
}