/*
 * Nœud de l'arbre de recherche : l'état complet après une action, avec les hashs
 * incrémentaux du scoring (patchés depuis le parent, jamais reconstruits).
 */

include("../includes.leek")

class NodeClass {
	ACTION
	END_STATS         // CACHE PARESSEUX de l'état complet : rempli d'office sur la racine,
	                  // null sur un candidat neuf, matérialisé (STATE_PARENT + STATE_PATCH)
	                  // seulement si le nœud est réellement développé — StateClass.materializeNodeState
	STATE_PARENT      // nœud portant l'état d'AVANT cette action — chaîne IMMUABLE, indépendante de
	                  // PARENT (réassigné par le déroulé et les entrées du ScoredCache) ; null = racine
	STATE_PATCH       // [id -> EntityState APRÈS l'action] : les seules entités que l'action a modifiées
	                  // (les ids de CLONED), seule représentation persistante du nœud
	PARENT            // nœud d'origine (null pour une action de base)
	SCORE             // score absolu de l'état du nœud (rempli par le BFS)
	BASE_HASH         // BaseHash de l'état du nœud
	CONTEXT_BY_SIDE   // par side : hash de l'équipe adverse (clé des caches danger)
	HFP_BY_SIDE       // par side : fingerprint des healers (clé de la heal map)
	CLONED            // [id -> ANCIEN EntityState] : ensemble EXACT des entités possiblement mutées
	                  // par l'action — la valeur est la référence read-only à l'état d'avant clonage
	                  // (null pour un summon né en branche). Sert au clone-on-write, à la capture du
	                  // patch et à la restauration du workspace, puis est libéré (null) par le BFS —
	                  // STATE_PATCH reste la seule représentation persistante
	LOCAL_TERM_DIRTY  // [id -> true] : entités dont un input LOCAL du terme a réellement changé
	                  // (masque diffMaskOf + checks Me BaseHash/fingerprint) — le recompute-set
	                  // du scoring l'itère directement
	TERMS             // [id -> terme signé] : PATCH local — les seuls termes recalculés par CE nœud
	                  // (la racine noPlay porte la map complète). Résolution via ScoringClass.termOf.
	TERMS_PARENT      // nœud portant le snapshot de termes précédent — chaîne IMMUABLE, indépendante
	                  // de PARENT (que le déroulé du BFS réassigne) ; null = racine des termes
	POISON_KEY        // clé de couverture antidote de l'état du nœud (posée par getStateScoreFromParent
	                  // depuis le workspace encore muté, 0 sans antidote)
	constructor(Act, StatsAfterAction, Parent) {
		this.ACTION = Act
		this.END_STATS = StatsAfterAction
		this.PARENT = Parent
	}

	/*
	 * Fabrique LE nœud : applique les conséquences de l'action sur un état clone-on-write,
	 * puis patche les hashs incrémentaux (base, contextes, healers) depuis le parent.
	 *
	 * Le nœud rendu ne porte QUE son patch : END_STATS reste null, le workspace est rendu à
	 * l'appelant qui doit le scorer PUIS le restaurer (StateClass.restoreWorkspace).
	 *
	 * @param Act Action à transformer en nœud
	 * @param Workspace map de travail — copie superficielle du State parent, partagée par tous
	 *        les candidats du même parent et restaurée après chacun
	 * @param From cellule de lancement (Act.From)
	 * @param MyWalkCells layers de déplacement de Me (déjà calculés par l'appelant)
	 * @param Cost coût TP total : item + swap d'arme + jump/télépo (déjà calculé par l'appelant)
	 * @param Info ItemInfo de Item
	 * @param Item item utilisé (Act.Item)
	 * @param To cellule cible (Act.To)
	 * @param BaseHash BaseHash de l'état parent
	 * @param Parent nœud parent (null pour une action de base)
	 * @param StateParent nœud portant l'état d'avant l'action (chaîne STATE_PARENT)
	 * @param ParentContext CONTEXT_BY_SIDE du parent
	 * @param ParentHfp HFP_BY_SIDE du parent
	 *
	 * @return le nouveau nœud, hashs et patch remplis
	 */
	static ActionToNodeInTree(Act, Workspace, From, MyWalkCells, Cost, Info, Item, To, BaseHash, Parent, StateParent, ParentContext, ParentHfp) {
		BenchOps.Start("Node")
		// clonedIds = l'ensemble exact des entités effectivement mutables : Me pré-cloné ici ;
		// cibles réellement touchées, victimes des cascades de kill et ressuscité (payload
		// Act.RESURRECT_ID) clonés PARESSEUSEMENT (ensureCloned) dans getConsequences.
		var clonedIds = [: ]
		StateClass.beginActionOnWorkspace(Workspace, clonedIds)
		var ThisActionStats = Workspace

		// Déplacement : retire les MP de la layer utilisée.
		ThisActionStats[Me].CELL = From
		if (From in MyWalkCells.WALK) {
			ThisActionStats[Me].MP -= MyWalkCells.WALK[From]
		} else if (From in MyWalkCells.JUMP) {
			ThisActionStats[Me].MP -= MyWalkCells.JUMP[From]
		} else if (From in MyWalkCells.TELEPORTATION) {
			ThisActionStats[Me].MP -= MyWalkCells.TELEPORTATION[From]
		} else if (From in MyWalkCells.TELEPORTATION_AND_JUMP) {
			ThisActionStats[Me].MP -= MyWalkCells.TELEPORTATION_AND_JUMP[From]
		}
		ThisActionStats[Me].TP -= Cost
		if (Info.IS_WEAPON) ThisActionStats[Me].WEAPON = Item
		// ============ DIAGNOSTIC TEMPORAIRE Libération — À RETIRER (revert) ============
		// Arme la trace sur un cast simulé de Libération visant ma propre cellule. Le
		// désarmement n'a lieu QUE si le ledger était non vide (cas reproductible :
		// ArkansasBlack après Forteresse/Solidification/Mur) — sinon on continue de chercher.
		if (DIAG_LIB_ARMED && Item == CHIP_LIBERATION && To == From) {
			DIAG_LIB_ACTIVE = true
			DIAG_LIB_BEFORE = diagSnapshotOfMe(ThisActionStats[Me])
		}
		// ==============================================================================
		ConsequencesClass.getConsequences(ThisActionStats, Item, From, To, Me, BaseHash, clonedIds, Act.RESURRECT_ID)
		// ============ DIAGNOSTIC TEMPORAIRE Libération — À RETIRER (revert) ============
		if (DIAG_LIB_ACTIVE && DIAG_LIB_BEFORE != null) {
			var diagLedgerCount = count(DIAG_LIB_BEFORE[16])
			if (diagLedgerCount == 0) {
				// Rien à réduire : cas sans intérêt, on ne trace pas et on reste armé.
				DIAG_LIB_ACTIVE = false
			} else {
				debugW("[DIAG-LIB] (lignes de ledger avant le débuff : " + diagLedgerCount + ")")
				diagDumpDebuff(DIAG_LIB_BEFORE, diagSnapshotOfMe(ThisActionStats[Me]), ThisActionStats[Me])
			}
			DIAG_LIB_BEFORE = null
		}
		// ==============================================================================
		// Écritures d'inventaire via les setters différentiels : elles ne touchent que le
		// patch local du clone de Me, jamais un ancêtre.
		StateClass.setCooldown(ThisActionStats[Me], Item, Info.COOLDOWN)
		StateClass.incrementUses(ThisActionStats[Me], Item)
		// Cooldowns des items de déplacement si la cellule d'arrivée vient d'une layer jump/télépo.
		if (!(From in MyWalkCells.WALK)) {
			if (From in MyWalkCells.JUMP) {
				StateClass.setCooldown(ThisActionStats[Me], CHIP_JUMP, ITEMINFO[CHIP_JUMP].COOLDOWN)
			} else if (From in MyWalkCells.TELEPORTATION) {
				StateClass.setCooldown(ThisActionStats[Me], CHIP_TELEPORTATION, ITEMINFO[CHIP_TELEPORTATION].COOLDOWN)
			} else if (From in MyWalkCells.TELEPORTATION_AND_JUMP) {
				StateClass.setCooldown(ThisActionStats[Me], CHIP_JUMP, ITEMINFO[CHIP_JUMP].COOLDOWN)
				StateClass.setCooldown(ThisActionStats[Me], CHIP_TELEPORTATION, ITEMINFO[CHIP_TELEPORTATION].COOLDOWN)
			}
		}
		// END_STATS reste NULL : le nœud ne portera que son patch (matérialisation paresseuse).
		var result = new NodeClass(Act, null, Parent)
		result.STATE_PARENT = StateParent

		// Patch incrémental des trois hashs, piloté par le SEUL clonedIds : old ^ new pour une
		// entité préexistante, ajout pur pour une entité née dans l'action (valeur null). Un
		// ressuscité était mort dans le parent -> ses contributions old valent 0 (LIFE-gated).
		var bh = BaseHash
		var ctx = clone(ParentContext, 1)    // copie : le contexte du parent n'est jamais muté
		var ctxSides = mapKeys(ctx)
		var hfpMap = clone(ParentHfp, 1)
		var localTermDirty = [: ]
		for (var tar: var parentStat in clonedIds) {
			var newStat = ThisActionStats[tar]
			// Entité NÉE dans l'action (summon) : aucune contribution ancienne à retirer, on
			// AJOUTE simplement les siennes. clonedIds est enregistré à la source par
			// Consequences, donc Node n'a plus à deviner la nature de l'action.
			if (parentStat == null) {
				localTermDirty[tar] = true
				if (tar == Me) continue      // impossible en pratique : Me préexiste toujours
				bh ^= StateClass.baseContribution(newStat, tar)
				var addCtx = DeltaClass.contextContribution(newStat, tar)
				if (addCtx != 0) {
					for (var s in ctxSides) if (s != newStat.SIDE) ctx[s] ^= addCtx
				}
				var addHfp = HealClass.healerContributionOf(newStat, tar)
				if (addHfp != 0) hfpMap[newStat.SIDE] = ((newStat.SIDE in hfpMap) ? hfpMap[newStat.SIDE] : 0) ^ addHfp
				continue
			}
			// Masque différentiel UNIQUE : une seule comparaison parent/clone pilote les
			// trois patchs de hash ET le terme local, et invalide les mémos dérivés
			// (Me compris — il est seulement exclu des trois hashs).
			var mask = StateClass.diffMaskOf(parentStat, newStat, tar == Me)
			if (mask & DIFF_LOCAL_TERM) localTermDirty[tar] = true
			if (tar == Me) continue          // Me est exclu des trois hashs
			if (mask & DIFF_BASE) bh ^= StateClass.baseContribution(parentStat, tar) ^ StateClass.baseContribution(newStat, tar)
			if (mask & DIFF_CONTEXT) {
				var deltaCtx = DeltaClass.contextContribution(parentStat, tar) ^ DeltaClass.contextContribution(newStat, tar)
				if (deltaCtx != 0) {
					var side = newStat.SIDE
					for (var s in ctxSides) if (s != side) ctx[s] ^= deltaCtx   // contextes des sides ADVERSES
				}
			}
			if (mask & DIFF_HFP) {
				var deltaHfp = HealClass.healerContributionOf(parentStat, tar) ^ HealClass.healerContributionOf(newStat, tar)
				if (deltaHfp != 0) {             // fingerprint du side de l'entité elle-même
					var hfpSide = newStat.SIDE
					hfpMap[hfpSide] = ((hfpSide in hfpMap) ? hfpMap[hfpSide] : 0) ^ deltaHfp
				}
			}
		}

		// Me : exclu des trois hashs, mais son terme dépend du domaine de fuite — BaseHash
		// FINAL différent -> dirty ; sinon UNE comparaison des fingerprints WalkCells
		// old/new (une dépense de TP sans franchir de seuil de mobilité ne salit rien).
		if (!(Me in localTermDirty)
			&& (bh != BaseHash
				|| WalkCellsClass.HashWalkCellsWithItemsWithoutBaseHash(clonedIds[Me]) != WalkCellsClass.HashWalkCellsWithItemsWithoutBaseHash(ThisActionStats[Me]))) {
			localTermDirty[Me] = true
		}

		result.CLONED = clonedIds
		result.LOCAL_TERM_DIRTY = localTermDirty
		result.BASE_HASH = bh
		result.CONTEXT_BY_SIDE = ctx
		result.HFP_BY_SIDE = hfpMap
		capturePatch(result, ThisActionStats, clonedIds)

		BenchOps.Stop("Node")
		return result
	}

	// ============ DIAGNOSTIC TEMPORAIRE Libération — À RETIRER (revert) ============

	/* Scalaires de Me lus par le scoring + copie plate du ledger. */
	static diagSnapshotOfMe(s) {
		var led = []
		for (var eff in s.EFFECTS) push(led, [eff[0], eff[1], eff[3], eff[5], eff[7]])
		return [s.RELATIVE_SHIELD, s.ABSOLUTE_SHIELD, s.RESISTANCE, s.DAMAGE_RETURN,
			s.POISON, s.POISON_OVER_TIME, s.AFTEREFFECT, s.AFTEREFFECT_OVER_TIME, s.HEAL, s.HEAL_OVER_TIME,
			s.LIFE, s.TOTAL_LIFE, s.STRENGTH, s.AGILITY, s.TOTAL_TP, s.TOTAL_MP, led]
	}

	static diagDumpDebuff(b, a, s) {
		debugW("[DIAG-LIB] ===== CAST DE LIBÉRATION SUR MOI — ÉTAT AVANT -> APRÈS =====")
		debugW("[DIAG-LIB] RELATIVE_SHIELD " + b[0] + " -> " + a[0] + "   ABSOLUTE_SHIELD " + b[1] + " -> " + a[1] + "   RESISTANCE " + b[2] + " -> " + a[2])
		debugW("[DIAG-LIB] DAMAGE_RETURN " + b[3] + " -> " + a[3])
		debugW("[DIAG-LIB] flux POISON " + b[4] + "->" + a[4] + " POT " + b[5] + "->" + a[5] + " AFTEREFFECT " + b[6] + "->" + a[6] + " AOT " + b[7] + "->" + a[7] + " HEAL " + b[8] + "->" + a[8] + " HOT " + b[9] + "->" + a[9])
		debugW("[DIAG-LIB] LIFE " + b[10] + "->" + a[10] + " TOTAL_LIFE " + b[11] + "->" + a[11] + " STRENGTH " + b[12] + "->" + a[12] + " AGILITY " + b[13] + "->" + a[13] + " TOTAL_TP " + b[14] + "->" + a[14] + " TOTAL_MP " + b[15] + "->" + a[15])
		debugW("[DIAG-LIB] ledger AVANT (type, value, turns, item, modifiers) : " + b[16])
		debugW("[DIAG-LIB] ledger APRÈS (type, value, turns, item, modifiers) : " + a[16])
	}

	// ============ FIN DIAGNOSTIC TEMPORAIRE Libération ============

	/*
	 * Fige les entités modifiées par l'action : STATE_PATCH prend, pour chaque id touché, la
	 * référence PRODUITE dans le workspace (un id né dans l'action y figure aussi — sa valeur
	 * dans clonedIds est null, mais le workspace porte bien la nouvelle entité). Appelé sur
	 * les DEUX sorties d'ActionToNodeInTree, avant que l'appelant ne restaure le workspace.
	 */
	static capturePatch(node, Workspace, clonedIds) {
		var patch = [: ]
		for (var id: var oldStat in clonedIds) patch[id] = Workspace[id]
		node.STATE_PATCH = patch
	}
}
