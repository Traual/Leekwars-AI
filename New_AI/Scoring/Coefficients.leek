// Réglages manuels. Utilitaires dans Equipment.leek et StateConstants.leek.
// Chaque fonction reçoit l'état du porteur. Les poids de cibles sont figés par recherche.
include("../includes.leek")

class Coefficients {
    static presence(stat)       { return 100 }
    static life(stat)           { return 1 }
    static totalLife(stat)      { return 0.5 }
    // Paliers sur la force courante. Le rendement sert seulement à vérifier qu'on peut attaquer.
    static strength(stat) {
        var yields = Equipment.strengthYield(stat)
        // strengthYield renvoie deux rendements : zéro sur les deux = aucun dégât physique.
        if (yields.LEEKS == 0 && yields.SUMMONS == 0) return 0
        var coef = 0.2
        if (stat.STRENGTH > 0) coef += 0.2
        if (stat.STRENGTH >= 200) coef += 0.3
        if (stat.STRENGTH >= 400) coef += 0.3
        if (stat.STRENGTH >= 600) coef += 0.2
        if (stat.STRENGTH >= 800) coef += 0.2
        if (stat.STRENGTH >= 1000) coef += 0.1
        return coef
    }
    static wisdom(stat)         { return 1 }
    // Renvois futurs : 10 PT / 100, convertis en score avec la valeur d'un point de renvoi.
    static agility(stat) {
        var yields = Equipment.damageReturnYield(stat)
        if (ROOT_SCORING_CONSTANTS == null) return 0
        var weights = ROOT_SCORING_CONSTANTS.ALLIES_BY_SIDE[stat.SIDE]
        if (weights == null) return 0
        return (yields.LEEKS * weights.LEEKS + yields.SUMMONS * weights.SUMMONS)
            * 0.1 * damageReturn(stat)
    }
    // Réglage distinct du renvoi : 0.05 par point d'agilité utile au critique, avant échelle.
    static criticalAgility(stat) { return 0.05 * ScoringStateConstants.criticalScale(stat) }
    static resistance(stat)     { return 1 }
    static science(stat)        { return 1 }
    static magic(stat)          { return 1 }
    static power(stat)          { return 1 }
    static totalTP(stat)        { return 30 }
    static totalMP(stat)        { return stat.STATIC || EntityStateClass.hasState(stat, STATE_ROOTED) ? 0 : 15 }
    static absoluteShield(stat) { return 1 }
    static relativeShield(stat) { return 10 }
    static damageReturn(stat)   { return 10 }
    static poison(stat)         { return EntityStateClass.hasState(stat, STATE_INVINCIBLE) ? 0 : -0.5 }
    static aftereffect(stat)    { return -0.75 }
    static heal(stat)           { return EntityStateClass.hasState(stat, STATE_UNHEALABLE) ? 0 : 0.5 }
}
