// Valeurs de départ à régler à la main. Aucune estimation du kit ou de l'importance.
// Chaque fonction reçoit uniquement l'état du porteur de la statistique.
include("../includes.leek")

class Coefficients {
    static presence(s)       { return 100 }
    static life(s)           { return 1 }
    static totalLife(s)      { return 0.5 }
    static strength(s)       { return 1 }
    static wisdom(s)         { return 1 }
    static agility(s)        { return 1 }
    static resistance(s)     { return 1 }
    static science(s)        { return 1 }
    static magic(s)          { return 1 }
    static power(s)          { return 1 }
    static totalTP(s)        { return 30 }
    static totalMP(s)        { return s.STATIC || EntityStateClass.hasState(s, STATE_ROOTED) ? 0 : 15 }
    static absoluteShield(s) { return 1 }
    static relativeShield(s) { return 10 }
    static damageReturn(s)   { return 10 }
    static poison(s)         { return EntityStateClass.hasState(s, STATE_INVINCIBLE) ? 0 : -0.5 }
    static aftereffect(s)    { return -0.75 }
    static heal(s)           { return EntityStateClass.hasState(s, STATE_UNHEALABLE) ? 0 : 0.5 }
}
