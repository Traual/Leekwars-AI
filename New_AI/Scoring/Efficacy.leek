/**
 * #2 STAT EFFICACY — an ADDITIVE term scoring buffs/nerfs of the stats NOT in the
 * danger/heal maps: RESISTANCE, SCIENCE, AGILITY. NOT scored on Me (handled by the BFS
 * payoff + #1 importance).
 *
 *   value(e) += efficacy(e)            (added per entity, sign-flipped in getStateScore)
 *               ⇒ buffs on allies AND nerfs on enemies both register a delta.
 *
 * computeCombo(e) = a TP-BOUNDED GREEDY COMBO of what the entity can cast this turn:
 *  1) score each castable item (cd 0) = sumRES·resMul + sumSCI·sciMul + sumAGI·agiMul + sumRaw,
 *     where the per-item stat-independent sums (base · perEffectWeight grouped by scaling stat)
 *     are precomputed once in ITEM_EFF_SCORE. Effect→stat: RES→ABSOLUTE/RELATIVE_SHIELD,
 *     AGI→DAMAGE_RETURN, SCI→NOVA_DAMAGE/NOVA_VITALITY/AFTEREFFECT/BUFF_*; RAW_BUFF_* go to
 *     sumRaw (same weight, NOT SCI-scaled). perEffectWeight = HP per real point (RELATIVE ≫
 *     ABSOLUTE; AFTEREFFECT negative = doping's self-poison).
 *  2) sort items by score desc, take while TP remains.
 *  3) efficacy = EFF_SCALE · Σ(taken). Net-negative items are dropped.
 *
 * TWO CACHES: ITEM_EFF_SCORE[itemId] (fight-wide, stat-independent) avoids the per-effect
 * switch; EFFICACY_CACHE[packedKey] (reset per turn) avoids the whole combo on hit — non-Me
 * entities are constant per turn so it hits everywhere except when I debuff/buff one in-tree.
 **/

include("../includes.leek")

// ============================================================================
// TUNE HERE — HP per real point of effect (user-calibrated). EFF_SCALE = master dial vs survival.
// ============================================================================
global EFF_W_ABSOLUTE_SHIELD = 5.0
global EFF_W_RELATIVE_SHIELD = 25.0
global EFF_W_DAMAGE_RETURN   = 15.0
global EFF_W_NOVA_DAMAGE     = 10.0
global EFF_W_NOVA_VITALITY   = 10.0
global EFF_W_AFTEREFFECT     = -2.0          // doping's self-poison: a downside
global EFF_W_BUFF_STRENGTH   = 5.0
global EFF_W_BUFF_AGILITY    = 2.0
global EFF_W_BUFF_RESISTANCE = 3.0
global EFF_W_BUFF_WISDOM     = 3.0
global EFF_W_BUFF_MP         = 40.0
global EFF_W_BUFF_TP         = 100.0
global EFF_SCALE             = 0.2

class EfficacyClass {

    /**
     * #2 additive value of one entity (0 for Me). Cached per turn by a single packed key
     * (id, TP, RES, SCI, AGI) — these are all the combo depends on (inventory fixed by id,
     * non-Me cooldowns constant per turn).
     *   layout: AGI 0-13 | SCI 14-27 | RES 28-41 | TP 42-49 | id 50-63  (14-bit stats, masked).
     */
    static get(stat) {
        if (stat.ID == Me) return 0
        var cacheKey = ((stat.ID & 0x3FFF) << 50)
                     | ((stat.TP & 0xFF) << 42)
                     | ((stat.RESISTANCE & 0x3FFF) << 28)
                     | ((stat.SCIENCE & 0x3FFF) << 14)
                     | (stat.AGILITY & 0x3FFF)
        if (cacheKey in EFFICACY_CACHE) return EFFICACY_CACHE[cacheKey]
        var efficacy = computeCombo(stat)
        EFFICACY_CACHE[cacheKey] = efficacy
        return efficacy
    }

    /**
     * Stat-independent per-item sums [sumRES, sumSCI, sumAGI, sumRaw, cost], cached fight-wide
     * (depends only on the item's static effects + the weights).
     */
    static itemEffScore(itemId) {
        if (itemId in ITEM_EFF_SCORE) return ITEM_EFF_SCORE[itemId]
        var sumResistance = 0
        var sumScience = 0
        var sumAgility = 0
        var sumRaw = 0
        for (var eff in ITEMINFO[itemId].EFFECTS) {
            var base = eff[1]
            switch (eff[0]) {
                case EFFECT_ABSOLUTE_SHIELD:
                    sumResistance += base * EFF_W_ABSOLUTE_SHIELD
                    break
                case EFFECT_RELATIVE_SHIELD:
                    sumResistance += base * EFF_W_RELATIVE_SHIELD
                    break
                case EFFECT_DAMAGE_RETURN:
                    sumAgility += base * EFF_W_DAMAGE_RETURN
                    break
                case EFFECT_NOVA_DAMAGE:
                    sumScience += base * EFF_W_NOVA_DAMAGE
                    break
                case EFFECT_NOVA_VITALITY:
                    sumScience += base * EFF_W_NOVA_VITALITY
                    break
                case EFFECT_AFTEREFFECT:
                    sumScience += base * EFF_W_AFTEREFFECT
                    break
                case EFFECT_BUFF_STRENGTH:
                    sumScience += base * EFF_W_BUFF_STRENGTH
                    break
                case EFFECT_RAW_BUFF_STRENGTH:
                    sumRaw += base * EFF_W_BUFF_STRENGTH
                    break
                case EFFECT_BUFF_AGILITY:
                    sumScience += base * EFF_W_BUFF_AGILITY
                    break
                case EFFECT_RAW_BUFF_AGILITY:
                    sumRaw += base * EFF_W_BUFF_AGILITY
                    break
                case EFFECT_BUFF_RESISTANCE:
                    sumScience += base * EFF_W_BUFF_RESISTANCE
                    break
                case EFFECT_RAW_BUFF_RESISTANCE:
                    sumRaw += base * EFF_W_BUFF_RESISTANCE
                    break
                case EFFECT_BUFF_WISDOM:
                    sumScience += base * EFF_W_BUFF_WISDOM
                    break
                case EFFECT_RAW_BUFF_WISDOM:
                    sumRaw += base * EFF_W_BUFF_WISDOM
                    break
                case EFFECT_BUFF_MP:
                    sumScience += base * EFF_W_BUFF_MP
                    break
                case EFFECT_RAW_BUFF_MP:
                    sumRaw += base * EFF_W_BUFF_MP
                    break
                case EFFECT_BUFF_TP:
                    sumScience += base * EFF_W_BUFF_TP
                    break
                case EFFECT_RAW_BUFF_TP:
                    sumRaw += base * EFF_W_BUFF_TP
                    break
            }
        }
        var result = [sumResistance, sumScience, sumAgility, sumRaw, ITEMINFO[itemId].COST]
        ITEM_EFF_SCORE[itemId] = result
        return result
    }

    /**
     * The TP-bounded combo value of an entity's castable RES/SCI/AGI items (no Me-skip, no cache).
     */
    static computeCombo(stat) {
        var resistanceMul = 1 + stat.RESISTANCE * 0.01
        var scienceMul    = 1 + stat.SCIENCE * 0.01
        var agilityMul    = 1 + stat.AGILITY * 0.01

        // 1) value every castable item via its precomputed sums → [itemValue, tpCost]
        var items = []
        for (var itemId in stat.INVENTORY) {
            if (stat.COOLDOWNS[itemId] != 0) continue           // not castable this turn
            var precomputed = itemEffScore(itemId)
            var itemValue = precomputed[0] * resistanceMul
                          + precomputed[1] * scienceMul
                          + precomputed[2] * agilityMul
                          + precomputed[3]
            if (itemValue > 0) push(items, [itemValue, precomputed[4]])   // net-positive only
        }
        if (count(items) == 0) return 0

        // 2) best-first, take while TP allows
        items = arraySort(items, function(a, b) { return b[0] - a[0] })
        var remainingTp = stat.TP
        var total = 0
        for (var item in items) {
            if (item[1] <= remainingTp) {
                total += item[0]
                remainingTp -= item[1]
            }
        }
        return EFF_SCALE * total
    }

    /**
     * TEMP debug: print the raw combo value of every alive entity (bypasses the Me-skip).
     */
    static debugAll() {
        var State = StateClass.Virtualize()
        for (var e: var stat in State) {
            if (stat.LIFE <= 0) continue
            debug("[EFF] " + stat.NAME + " id=" + e + " Me=" + (e == Me) + " RES=" + stat.RESISTANCE + " SCI=" + stat.SCIENCE + " AGI=" + stat.AGILITY + " -> " + computeCombo(stat))
        }
    }
}
