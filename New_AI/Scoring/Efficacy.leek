/**
 * #2 STAT EFFICACY — an ADDITIVE term scoring buffs/nerfs of the stats NOT in the
 * danger/heal maps: RESISTANCE, SCIENCE, AGILITY. NOT scored on Me (handled by the BFS
 * payoff + #1 importance).
 *
 *   value(e) += efficacy(e)            (added per entity, sign-flipped in getStateScore)
 *               ⇒ buffs on allies AND nerfs on enemies both register a delta.
 *
 * computeCombo(e) = a TP-BOUNDED GREEDY COMBO of what the entity can cast this turn:
 *  1) score each castable item (cd 0): Σ effects  base · perEffectWeight · (1 + stat·0.01)
 *     (exact Consequences scaling). Effect→stat: RES→ABSOLUTE/RELATIVE_SHIELD,
 *     AGI→DAMAGE_RETURN, SCI→NOVA_DAMAGE/NOVA_VITALITY/AFTEREFFECT/BUFF_* (RAW_BUFF_* same
 *     weight but NOT SCI-scaled). perEffectWeight = HP per real point (RELATIVE ≫ ABSOLUTE;
 *     AFTEREFFECT negative = doping's self-poison).
 *  2) sort items by score desc, take while TP remains.
 *  3) efficacy = EFF_SCALE · Σ(taken). Net-negative items are dropped.
 *
 * Cooldown-aware. AGI crit/dodge are passive (not item effects) → only damage-return counted.
 * No cache yet (one inventory pass + arraySort per entity per call).
 **/

include("../includes.leek")

// ============================================================================
// TUNE HERE — HP per real point of effect (user-calibrated). EFF_SCALE = master dial vs survival.
// ============================================================================
global EFF_W_ABSOLUTE_SHIELD = 5.0
global EFF_W_RELATIVE_SHIELD = 25.0
global EFF_W_DAMAGE_RETURN   = 15.0
global EFF_W_NOVA_DAMAGE     = 10.0
global EFF_W_NOVA_VITALITY   = 10.0
global EFF_W_AFTEREFFECT     = -2.0          // doping's self-poison: a downside
global EFF_W_BUFF_STRENGTH   = 5.0
global EFF_W_BUFF_AGILITY    = 2.0
global EFF_W_BUFF_RESISTANCE = 3.0
global EFF_W_BUFF_WISDOM     = 3.0
global EFF_W_BUFF_MP         = 40.0
global EFF_W_BUFF_TP         = 100.0
global EFF_SCALE             = 0.2

class EfficacyClass {

    /**
     * #2 additive value of one entity (0 for Me — handled elsewhere).
     */
    static get(stat) {
        if (stat.ID == Me) return 0
        return computeCombo(stat)
    }

    /**
     * The TP-bounded combo value of an entity's castable RES/SCI/AGI items (no Me-skip).
     */
    static computeCombo(stat) {
        var resMul = 1 + stat.RESISTANCE * 0.01
        var sciMul = 1 + stat.SCIENCE * 0.01
        var agiMul = 1 + stat.AGILITY * 0.01

        // 1) score every castable item that has #2 value → [score, tpCost]
        var items = []
        for (var id in stat.INVENTORY) {
            if (stat.COOLDOWNS[id] != 0) continue              // not castable this turn
            var v = 0
            for (var eff in ITEMINFO[id].EFFECTS) {
                var base = eff[1]
                switch (eff[0]) {
                    case EFFECT_ABSOLUTE_SHIELD:
                        v += base * EFF_W_ABSOLUTE_SHIELD * resMul
                        break
                    case EFFECT_RELATIVE_SHIELD:
                        v += base * EFF_W_RELATIVE_SHIELD * resMul
                        break
                    case EFFECT_DAMAGE_RETURN:
                        v += base * EFF_W_DAMAGE_RETURN * agiMul
                        break
                    case EFFECT_NOVA_DAMAGE:
                        v += base * EFF_W_NOVA_DAMAGE * sciMul
                        break
                    case EFFECT_NOVA_VITALITY:
                        v += base * EFF_W_NOVA_VITALITY * sciMul
                        break
                    case EFFECT_AFTEREFFECT:
                        v += base * EFF_W_AFTEREFFECT * sciMul
                        break
                    case EFFECT_BUFF_STRENGTH:
                        v += base * EFF_W_BUFF_STRENGTH * sciMul
                        break
                    case EFFECT_RAW_BUFF_STRENGTH:
                        v += base * EFF_W_BUFF_STRENGTH
                        break
                    case EFFECT_BUFF_AGILITY:
                        v += base * EFF_W_BUFF_AGILITY * sciMul
                        break
                    case EFFECT_RAW_BUFF_AGILITY:
                        v += base * EFF_W_BUFF_AGILITY
                        break
                    case EFFECT_BUFF_RESISTANCE:
                        v += base * EFF_W_BUFF_RESISTANCE * sciMul
                        break
                    case EFFECT_RAW_BUFF_RESISTANCE:
                        v += base * EFF_W_BUFF_RESISTANCE
                        break
                    case EFFECT_BUFF_WISDOM:
                        v += base * EFF_W_BUFF_WISDOM * sciMul
                        break
                    case EFFECT_RAW_BUFF_WISDOM:
                        v += base * EFF_W_BUFF_WISDOM
                        break
                    case EFFECT_BUFF_MP:
                        v += base * EFF_W_BUFF_MP * sciMul
                        break
                    case EFFECT_RAW_BUFF_MP:
                        v += base * EFF_W_BUFF_MP
                        break
                    case EFFECT_BUFF_TP:
                        v += base * EFF_W_BUFF_TP * sciMul
                        break
                    case EFFECT_RAW_BUFF_TP:
                        v += base * EFF_W_BUFF_TP
                        break
                }
            }
            if (v > 0) push(items, [v, ITEMINFO[id].COST])     // net-positive items only
        }
        if (count(items) == 0) return 0

        // 2) best-first, take while TP allows
        items = arraySort(items, function(a, b) { return b[0] - a[0] })
        var tp = stat.TP
        var total = 0
        for (var it in items) {
            if (it[1] <= tp) {
                total += it[0]
                tp -= it[1]
            }
        }
        return EFF_SCALE * total
    }

    /**
     * TEMP debug: print the raw combo value of every alive entity (bypasses the Me-skip so
     * you see what Me would score too). Call once per turn.
     */
    static debugAll() {
        var State = StateClass.Virtualize()
        for (var e: var stat in State) {
            if (stat.LIFE <= 0) continue
            debug("[EFF] " + stat.NAME + " id=" + e + " Me=" + (e == Me) + " RES=" + stat.RESISTANCE + " SCI=" + stat.SCIENCE + " AGI=" + stat.AGILITY + " -> " + computeCombo(stat))
        }
    }
}
