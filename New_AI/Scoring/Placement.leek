// Pénalité de fin de tour : soutien accessible + occasion offensive perdue + exposition.
// Plus petit = mieux. Le danger utilise mon importance de base.
include("../includes.leek")

class Placement {
    // Les soins peuvent effacer 60 % de la pénalité brute, jamais sa totalité.
    // Garder ce réglage entre 0 et 1 pour conserver une pénalité positive ou nulle.
    static HEAL_ATTENUATION = 0.6

    // Fraction de ma vie courante menacée, par tranches cumulées et continues.
    // Les 10 premiers % sont gratuits ; poids 1 / 2 / 4 / 20 ensuite.
    static dangerRisk(ratio) {
        if (ratio <= 0.1) return 0
        var score = min(ratio - 0.1, 0.3) * 1
        if (ratio > 0.4) score += min(ratio - 0.4, 0.3) * 2
        if (ratio > 0.7) score += min(ratio - 0.7, 0.3) * 4
        if (ratio > 1) score += (ratio - 1) * 20
        return score
    }

    static exposure(stat, raw, net) {
        if (raw <= 0) return 0
        var life = max(1, stat.LIFE)
        var rawRisk = dangerRisk(raw / life)
        var netRisk = dangerRisk(max(0, net) / life)
        // Même entièrement soigné, je mobilise mes alliés et conserve 40 % du risque brut.
        // Le net vient du déroulé existant : ordre des tours, cap de vie et mort avant soin.
        return (rawRisk - HEAL_ATTENUATION * (rawRisk - netRisk)) * EntityImportance.value(stat)
    }

    static spatial(State, BaseHash, cell) {
        if (ROOT_ALLY_SUPPORT == null) AllySupport.prepare(State)
        if (ROOT_ENEMY_OFFENSE == null) EnemyOffense.prepare(State, BaseHash)
        var support = ROOT_ALLY_SUPPORT
        var offense = ROOT_ENEMY_OFFENSE
        var key = addValueToBinHash(mix64(BaseHash ^ support.HASH ^ offense.HASH), cell)
        if (key in PLACEMENT_COST_CACHE) return PLACEMENT_COST_CACHE[key]
        var cost = AllySupport.costAt(State, cell, support) + EnemyOffense.costAt(State, cell, offense)
        PLACEMENT_COST_CACHE[key] = cost
        return cost
    }
}
