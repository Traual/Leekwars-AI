/**
 * ItemValuation : per-leek, enemy-aware item valuation.
 *
 * Refreshed once per turn (in Main.leek). Computes ITEM_VALUE[itemId] for
 * each item in my inventory using:
 *   - MY OWN stats as multipliers (a STR-build values damage chips highly,
 *     a MAG-build values poison chips highly — naturally archetype-aware).
 *   - ENEMY PROFILE for counter-items :
 *       * ANTIDOTE / REMOVE_SHACKLES scale with enemy max MAGIC
 *       * VULNERABILITY / ABS_VULNERABILITY scale with enemy max RESISTANCE
 *       * DEBUFF / TOTAL_DEBUFF scale with enemy total SCIENCE + RESISTANCE
 *       * Shields / DR use an adaptive DMG_REF = base + per_str × enemy max STR
 *
 * Effect formulas mirror the LeekWars engine (Effect.java) :
 *   actual_value = (value1 + jet × value2) × (1 + stat/100) × (1 + power/100)
 *   expected_value = (value1 + 0.5 × value2)
 * In LeekScript, getChipEffects returns [type, min_jet_value, max_jet_value, turns, targets, modifiers].
 * So `V = (eff[1] + eff[2]) / 2` is the unambiguous expected value.
 **/

include("../includes.leek")

class ItemValuation {

	/**
	 * Refresh ITEM_VALUE for every item in my inventory.
	 * Called once per turn from Main.leek (after Preload.InitStateClass).
	 */
	static refreshAll(MyState, State) {
		var profile = computeEnemyProfile(MyState, State)
		for (var itemId in BASE_INVENTORY) {
			ITEM_VALUE[itemId] = computeItemValue(itemId, MyState, profile)
		}
	}

	/**
	 * Aggregate threat profile of enemies alive at refresh time.
	 *  - max_mag : highest enemy MAG → poison/shackle ceiling
	 *  - max_str : highest enemy STR → physical damage ceiling (drives DMG_REF)
	 *  - max_res : highest enemy RES → shield-building ceiling (drives vuln value)
	 *  - total_* : aggregate threats (used for counter-items boosted by team comp)
	 */
	static computeEnemyProfile(MyState, State) {
		var p = [:]
		p["max_mag"] = 0
		p["max_str"] = 0
		p["max_res"] = 0
		p["total_mag"] = 0
		p["total_str"] = 0
		p["total_res"] = 0
		p["total_sci"] = 0
		p["alive_count"] = 0

		var mySide = MyState.SIDE
		for (var e: var stat in State) {
			if (stat.LIFE <= 0 || stat.SIDE == mySide) continue
			if (stat.MAGIC > p["max_mag"]) p["max_mag"] = stat.MAGIC
			if (stat.STRENGTH > p["max_str"]) p["max_str"] = stat.STRENGTH
			if (stat.RESISTANCE > p["max_res"]) p["max_res"] = stat.RESISTANCE
			p["total_mag"] += stat.MAGIC
			p["total_str"] += stat.STRENGTH
			p["total_res"] += stat.RESISTANCE
			p["total_sci"] += stat.SCIENCE
			p["alive_count"]++
		}
		return p
	}

	/**
	 * ITEM_VALUE = (Σ intrinsic per effect) × cd_mult × cost_mult
	 *  - cd_mult   : high-CD items get a reserve premium (1 + 0.10 × CD)
	 *  - cost_mult : cheap items are called more times in a turn (1 / (1 + 0.05 × COST))
	 */
	static computeItemValue(itemId, MyStats, profile) {
		var Info = ITEMINFO[itemId]
		if (Info == null || Info.COST == null || Info.COST <= 0) return 0
		if (Info.EFFECTS == null) return 0

		var intrinsic = 0
		for (var eff in Info.EFFECTS) {
			// Skip self-targeted negative effects (e.g. weapon recoil on caster)
			if (eff[5] != null && (eff[5] & EFFECT_MODIFIER_ON_CASTER)) continue
			intrinsic += effectIntrinsic(eff, MyStats, profile, Info)
		}

		var cd_mult = 1 + 0.10 * Info.COOLDOWN
		var cost_mult = 1 / (1 + 0.05 * Info.COST)

		return intrinsic * cd_mult * cost_mult
	}

	/**
	 * Per-effect intrinsic value in HP-equivalent units.
	 * Uses MY stats as multipliers (per-leek refs) and ENEMY profile for
	 * counter-item adaptive scaling.
	 *
	 * Organized as a single switch over the effect type. Cases sharing a
	 * formula are grouped via fallthrough (e.g. all RAW_BUFF_* non-strength
	 * use the same body).
	 */
	static effectIntrinsic(eff, MyStats, profile, Info) {
		var type = eff[0]
		var V = (eff[1] + eff[2]) / 2.0     // expected value (uniform jet)
		var turns = eff[3]
		var DUR = max(1, turns)

		// My stat multipliers — per-leek archetype awareness
		var STR_M = 1 + MyStats.STRENGTH / 100
		var MAG_M = 1 + MyStats.MAGIC / 100
		var SCI_M = 1 + MyStats.SCIENCE / 100
		var RES_M = 1 + MyStats.RESISTANCE / 100
		var WIS_M = 1 + MyStats.WISDOM / 100
		var AGI_M = 1 + MyStats.AGILITY / 100
		var POW_M = 1 + MyStats.POWER / 100

		// AOE target multiplier (diminishing returns)
		var TARG = aoeTargetMultiplier(Info.AREA)

		// Adaptive damage reference for shield-value calculations
		var DMG_REF = ITEM_VAL_SHIELD_DMG_REF_BASE + ITEM_VAL_SHIELD_DMG_REF_PER_STR * profile["max_str"]
		var DMG_REF_RATIO = DMG_REF / 60.0   // normalized to old default of 60

		switch (type) {
			// ====== Damage ======
			case EFFECT_DAMAGE:
				return V * STR_M * POW_M * TARG
			case EFFECT_LIFE_DAMAGE:
				return (V / 100) * 2500 * POW_M
			case EFFECT_NOVA_DAMAGE:
				return V * SCI_M * POW_M * TARG * 0.7

			// ====== Heal / Vitality ======
			case EFFECT_HEAL:
				if (turns > 0) return V * WIS_M * DUR * 0.6
				return V * WIS_M * 0.7
			case EFFECT_RAW_HEAL:
				return V * 0.7
			case EFFECT_BOOST_MAX_LIFE:
				return V * WIS_M * 1.1
			case EFFECT_NOVA_VITALITY:
				return V * SCI_M * 0.8
			case EFFECT_RESURRECT:
				return 1200

			// ====== Shields ======
			case EFFECT_ABSOLUTE_SHIELD:
				return V * RES_M * DUR * 0.8 * DMG_REF_RATIO
			case EFFECT_RAW_ABSOLUTE_SHIELD:
				return V * DUR * 0.8 * DMG_REF_RATIO
			case EFFECT_RELATIVE_SHIELD:
			case EFFECT_RAW_RELATIVE_SHIELD:
				return (V / 100) * DMG_REF * DUR * 0.7
			case EFFECT_STEAL_ABSOLUTE_SHIELD:
				return 60

			// ====== Buffs (scaling SCI) ======
			case EFFECT_BUFF_STRENGTH:
			case EFFECT_BUFF_AGILITY:
				return V * SCI_M * DUR * 0.5
			case EFFECT_BUFF_MP:
			case EFFECT_BUFF_TP:
				return V * SCI_M * DUR * 8
			case EFFECT_BUFF_RESISTANCE:
			case EFFECT_BUFF_WISDOM:
				return V * SCI_M * DUR * 0.4

			// ====== Raw Buffs (no scaling) ======
			case EFFECT_RAW_BUFF_STRENGTH:
				return V * DUR * 1.5
			case EFFECT_RAW_BUFF_POWER:
				return V * DUR * 4
			case EFFECT_RAW_BUFF_MAGIC:
			case EFFECT_RAW_BUFF_SCIENCE:
			case EFFECT_RAW_BUFF_AGILITY:
			case EFFECT_RAW_BUFF_RESISTANCE:
			case EFFECT_RAW_BUFF_WISDOM:
				return V * DUR * 0.8
			case EFFECT_RAW_BUFF_MP:
			case EFFECT_RAW_BUFF_TP:
				return V * DUR * 12

			// ====== Shackles (anti-stat, scaling MAG) ======
			case EFFECT_SHACKLE_STRENGTH:
			case EFFECT_SHACKLE_MAGIC:
			case EFFECT_SHACKLE_MP:
			case EFFECT_SHACKLE_TP:
			case EFFECT_SHACKLE_AGILITY:
			case EFFECT_SHACKLE_WISDOM:
				return V * MAG_M * DUR * 0.6

			// ====== Counter-items (scale with enemy profile) ======
			case EFFECT_DEBUFF:
				return ITEM_VAL_DEBUFF_BASE
				     + ITEM_VAL_DEBUFF_PER_SCI * profile["total_sci"]
				     + ITEM_VAL_DEBUFF_PER_RES * profile["total_res"]
			case EFFECT_TOTAL_DEBUFF:
				return ITEM_VAL_TOTAL_DEBUFF_BASE
				     + ITEM_VAL_TOTAL_DEBUFF_PER_SCI * profile["total_sci"]
				     + ITEM_VAL_TOTAL_DEBUFF_PER_RES * profile["total_res"]
			case EFFECT_VULNERABILITY:
				return V * DUR * (ITEM_VAL_VULN_BASE + ITEM_VAL_VULN_PER_RES * profile["max_res"])
			case EFFECT_ABSOLUTE_VULNERABILITY:
				return V * DUR * (ITEM_VAL_ABS_VULN_BASE + ITEM_VAL_ABS_VULN_PER_RES * profile["max_res"])
			case EFFECT_ANTIDOTE:
				return ITEM_VAL_ANTIDOTE_BASE + ITEM_VAL_ANTIDOTE_PER_MAG * profile["max_mag"]
			case EFFECT_REMOVE_SHACKLES:
				return ITEM_VAL_MANUMISSION_BASE + ITEM_VAL_MANUMISSION_PER_MAG * profile["max_mag"]

			// ====== Damage Return (DR) ======
			case EFFECT_DAMAGE_RETURN:
				return V * AGI_M * DUR * 0.3 * DMG_REF_RATIO

			// ====== Poison + Aftereffect ======
			case EFFECT_POISON:
				return V * MAG_M * POW_M * DUR * 0.85 * TARG
			case EFFECT_AFTEREFFECT:
				return V * SCI_M * 0.9

			// ====== Movement / Special ======
			case EFFECT_TELEPORT:
				return 60
			case EFFECT_INVERT:
				return 120
			case EFFECT_ATTRACT:
			case EFFECT_REPEL:
			case EFFECT_PUSH:
				return 25 * V
			case EFFECT_SUMMON:
				return 400
			case EFFECT_KILL:
				return 1500
			case EFFECT_ADD_STATE:
				return 100
		}
		return 0
	}

	/**
	 * Rough estimate of how many entities an AOE typically hits.
	 * Diminishing returns to avoid over-valuing huge AOEs that rarely hit
	 * everyone (positioning constraints, LoS, etc.).
	 */
	static aoeTargetMultiplier(area) {
		switch (area) {
			case AREA_POINT:
				return 1.0
			case AREA_CIRCLE_1:
			case AREA_PLUS_1:
			case AREA_X_1:
				return 1.2
			case AREA_CIRCLE_2:
			case AREA_PLUS_2:
			case AREA_SQUARE_1:
				return 1.4
			case AREA_CIRCLE_3:
			case AREA_PLUS_3:
			case AREA_SQUARE_2:
			case AREA_X_2:
			case AREA_X_3:
				return 1.5
			case AREA_LASER_LINE:
			case AREA_FIRST_INLINE:
				return 1.3
		}
		return 1.0
	}
}
