/**
 * #1 ENTITY IMPORTANCE — a per-entity MULTIPLIER in [0,1] on the survival value.
 *
 *   value(e) = importance(e) · (BASE_ALIVE + W_LIFE·sqrt(effLife))     (+ #2 efficacy, later)
 *
 * GOAL: rank entities so the AI protects / focuses the ones that matter and does NOT
 * over-invest on weak ones (a summon, a low leek). Read from the raw STATS (level is
 * unreliable via components). TOTAL_TP / TOTAL_MP count too (small numbers but impactful;
 * TP ≫ MP, MP off-meta). A summon needs no special flag — its weak stats put it low on
 * their own (a bulb lands ≈ 1/3 of a real leek here).
 *
 * raw — weighted sum with a per-stat SLIGHT CONVEXITY  W[S]·stat[S]·(1 + IMP_CONVEX·stat[S]):
 *   (a) a high single stat is superlinear (700 STR partially bypasses absolute shields vs
 *   200), and (b) concentration > spread (x(1+kx) is superadditive: 800 > 400+400).
 *
 * SHAPE — LINEAR then clamped:  importance = min(1, raw / IMP_SCALE).  Kept simple on
 * purpose: linear ~doubles the weak/strong separation vs the old concave saturation
 * (bulb 1/3 of a top build vs 1/1.7). Note it can't push the bulb below ~1/3 because the
 * TP/MP "floor" (~1.15 raw, near-constant for everyone) dominates a bulb's raw; if more
 * separation is needed, raise IMP_CONVEX, lower the TP weight, or go to a power (raw^1.5).
 *
 * DELIBERATELY COARSE: a single buff (+50) barely moves importance, so it RANKS entities
 * WITHOUT meaningfully scoring buffs — buffs are scored by #2 (item efficacy, RES/SCI/AGI)
 * and the payoff action via Consequences (STR/MAG/WIS, in the danger/heal maps).
 *
 * SYMMETRIC: applied to every alive entity (sign-flipped in getStateScore) ⇒ nerfing an
 * enemy's STR lowers its importance → a small positive delta even out of danger range.
 *
 * LIFE is NOT included (already in the survival term). Cheap (~35 ops/entity) → no cache.
 **/

include("../includes.leek")

// ============================================================================
// TUNE HERE.   raw = Σ W[S]·stat[S]·(1 + IMP_CONVEX·stat[S]) ;  importance = min(1, raw/IMP_SCALE)
//   - SCIENCE highest (team value); other combat stats equal; TP ≫ MP.
//   - IMP_CONVEX: 0 = linear stats, higher = more reward for high/concentrated stats.
//   - IMP_SCALE: raw value that maps to importance 1. Raise to make everyone lower.
// ============================================================================
global IMP_W_STRENGTH   = 0.002
global IMP_W_MAGIC      = 0.002
global IMP_W_WISDOM     = 0.002
global IMP_W_SCIENCE    = 0.003
global IMP_W_AGILITY    = 0.002
global IMP_W_RESISTANCE = 0.002
global IMP_W_TOTAL_TP   = 0.10
global IMP_W_TOTAL_MP   = 0.05
global IMP_CONVEX       = 0.0003
global IMP_SCALE        = 9.0

class ImportanceClass {

    /**
     * Importance multiplier of one entity, in [0,1]. Low for weak entities (a bulb ≈ 1/3
     * of a real leek), 1 for a maxed build.
     */
    static get(stat) {
        var raw = IMP_W_STRENGTH   * stat.STRENGTH   * (1 + IMP_CONVEX * stat.STRENGTH)
                + IMP_W_MAGIC      * stat.MAGIC      * (1 + IMP_CONVEX * stat.MAGIC)
                + IMP_W_WISDOM     * stat.WISDOM     * (1 + IMP_CONVEX * stat.WISDOM)
                + IMP_W_SCIENCE    * stat.SCIENCE    * (1 + IMP_CONVEX * stat.SCIENCE)
                + IMP_W_AGILITY    * stat.AGILITY    * (1 + IMP_CONVEX * stat.AGILITY)
                + IMP_W_RESISTANCE * stat.RESISTANCE * (1 + IMP_CONVEX * stat.RESISTANCE)
                + IMP_W_TOTAL_TP   * stat.TOTAL_TP   * (1 + IMP_CONVEX * stat.TOTAL_TP)
                + IMP_W_TOTAL_MP   * stat.TOTAL_MP   * (1 + IMP_CONVEX * stat.TOTAL_MP)
        return min(1, raw / IMP_SCALE)
    }
}
