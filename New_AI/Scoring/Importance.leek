/**
 * TWO SEPARATE FUNCTIONS (the buff-farm fix — form and level DECOUPLED):
 *
 *   term(e) = sign · ( importance(e) · survival(e)  +  capability(e) )
 *
 * #1 IMPORTANCE — the TIER multiplier in [0,1], FROZEN AT TURN START (memo by id, first
 *    computed at the BFS root on the real stats; reset per turn in ReloadCacheNewTurn).
 *    Its only job: rank WHO matters (focus/protect — a bulb ≈ 1/3 of a real leek). Frozen ⇒
 *    in-turn buffs move it by exactly ZERO — the old live version paid ~90 score per self-buff
 *    (importance × ~2000 survival) and the AI spent entire endgames buff-farming instead of
 *    attacking. Stat changes pay through capability + the REAL channels (danger context,
 *    damage formulas, heal map).
 *
 * #2 CAPABILITY v2 — the additive, LIVE, deliberately SMALL buff/debuff channel:
 *      capability = CAP_SCALE · Σ_S bucket_S · (1 + max(0,stat_S)/100) · (1 + CAP_MP_FACTOR·mp)
 *    bucket_S = the HP output of S-scaled effects in the entity's best item combo AT ITS
 *    CURRENT TOTAL_TP (cooldown-gated greedy, HP-valued via the USER-calibrated CAP_HP_W
 *    table — the scoring's native currency). The (1 + stat/100) is THE GENERATOR'S OWN
 *    multiplier (an item outputs its base even at stat 0). "The value of a stat = what the
 *    ITEMS can do with it": buffing a stat no item uses → 0 (pruned — correct); shackling a
 *    mage's STR → 0; TP buffs are EMERGENT (the combo re-runs at the new budget — a bulb
 *    that can't fit an extra cast gains 0, a loaded build gains a real cast); MP = flat
 *    flattened multiplier. max(0,·): shackles below 0 can't raise the output.
 *    Killing an entity frees its capability (~40-70) — its loaded kit dies with it, coherent.
 *
 * LIFE is in neither function (survival term owns it). Costs: importance ≈ 5 ops (memo hit),
 * capability ≈ 5 (CAP_MEMO hit) / ~40 (combo-cache hit) / ~150-300 per NEW (id, TP) pair.
 **/

include("../includes.leek")

// ============================================================================
// TUNE HERE — #1 IMPORTANCE.   raw = Σ W[S]·stat[S]·(1 + IMP_CONVEX·stat[S]) ;
// importance = min(1, raw/IMP_SCALE), FROZEN per turn.
//   - SCIENCE highest (team value); other combat stats equal; TP ≫ MP.
//   - IMP_SCALE: raw value that maps to importance 1. Raise to make everyone lower.
// ============================================================================
global IMP_W_STRENGTH   = 0.002
global IMP_W_MAGIC      = 0.002
global IMP_W_WISDOM     = 0.002
global IMP_W_SCIENCE    = 0.003
global IMP_W_AGILITY    = 0.002
global IMP_W_RESISTANCE = 0.002
global IMP_W_TOTAL_TP   = 0.10
global IMP_W_TOTAL_MP   = 0.05
global IMP_CONVEX       = 0.0003
global IMP_SCALE        = 9.0

// ============================================================================
// TUNE HERE — #2 CAPABILITY v2.   capability = CAP_SCALE · ( Σ_S T_S·max(0,stat_S)
//                                                            + CAP_W_TP·tp² + CAP_W_MP·mp² )
// T_S = HP of item-output per point of stat S, from the entity's TURN-START best combo
// (greedy HP/TP over items with turn-start cooldown ≤ 1, within TOTAL_TP) — cached per id
// per turn in CAPABILITY_T_BY_ID. "The value of a stat = what the entity's ITEMS can do
// with it": buffing a stat no item uses → T = 0 → worthless (and pruned — correct);
// shackling a mage's STR → 0 too (v1's blind square overpaid those).
// CAP_HP_W = HP per point of base effect (the common currency, USER-calibrated June 2026,
// NOVA lowered 10 → 5 on user call). Only the RATIOS matter for the greedy — the absolute
// level is absorbed by CAP_SCALE (master dial: a main-stat buff ≈ +10, adrenaline ≈ +8).
// ============================================================================
global CAP_HP_W = [
    EFFECT_DAMAGE: 1.0,
    EFFECT_POISON: 2.0,                 // ≈ ticks espérés avant cure
    EFFECT_HEAL: 1.0,
    EFFECT_BOOST_MAX_LIFE: 1.0,
    EFFECT_ABSOLUTE_SHIELD: 5.0,        // 1 ABS bloque 1 dégât PAR HIT (~5 hits sur la durée)
    EFFECT_RELATIVE_SHIELD: 25.0,       // 1% du flux entrant (~2500) sur la durée
    EFFECT_VULNERABILITY: 25.0,         // miroir du relative shield
    EFFECT_ABSOLUTE_VULNERABILITY: 5.0, // miroir de l'absolute shield
    EFFECT_DAMAGE_RETURN: 15.0,
    EFFECT_NOVA_DAMAGE: 5.0,            // permanent + heal-proof (10 → 5, user call)
    EFFECT_NOVA_VITALITY: 5.0,
    EFFECT_AFTEREFFECT: -2.0,           // le self-poison du doping
    EFFECT_BUFF_TP: 100.0,              // 1 TP ≈ un cast de plus
    EFFECT_BUFF_MP: 40.0,
    EFFECT_BUFF_STRENGTH: 5.0,          // 1 STR = +1% dégâts ≈ 1% × ~500 de base
    EFFECT_BUFF_RESISTANCE: 3.0,
    EFFECT_BUFF_WISDOM: 3.0,
    EFFECT_BUFF_AGILITY: 2.0,
    EFFECT_SHACKLE_STRENGTH: 5.0,       // les shackles = miroirs des buffs
    EFFECT_SHACKLE_MAGIC: 5.0,
    EFFECT_SHACKLE_TP: 100.0,
    EFFECT_SHACKLE_MP: 40.0,
    EFFECT_SHACKLE_WISDOM: 3.0,
    EFFECT_SHACKLE_AGILITY: 2.0
]
// Effet -> stat de scaling du CASTER (multiplicateurs engine-vérifiés dans Consequences),
// en CONSTANTES STAT_* lisibles. Les effets sans scaling (vulnés, raw buffs) comptent dans
// la VALEUR du greedy mais n'alimentent aucun bucket.
global CAP_STAT_OF_EFFECT = [
    EFFECT_DAMAGE: STAT_STRENGTH,
    EFFECT_POISON: STAT_MAGIC,
    EFFECT_SHACKLE_STRENGTH: STAT_MAGIC, EFFECT_SHACKLE_MAGIC: STAT_MAGIC,
    EFFECT_SHACKLE_TP: STAT_MAGIC, EFFECT_SHACKLE_MP: STAT_MAGIC,
    EFFECT_SHACKLE_WISDOM: STAT_MAGIC, EFFECT_SHACKLE_AGILITY: STAT_MAGIC,        // shackles ×(1+MAG/100)
    EFFECT_HEAL: STAT_WISDOM, EFFECT_BOOST_MAX_LIFE: STAT_WISDOM,                 // ×(1+WIS/100)
    EFFECT_BUFF_TP: STAT_SCIENCE, EFFECT_BUFF_MP: STAT_SCIENCE,
    EFFECT_BUFF_STRENGTH: STAT_SCIENCE, EFFECT_BUFF_RESISTANCE: STAT_SCIENCE,
    EFFECT_BUFF_WISDOM: STAT_SCIENCE, EFFECT_BUFF_AGILITY: STAT_SCIENCE,
    EFFECT_AFTEREFFECT: STAT_SCIENCE, EFFECT_NOVA_DAMAGE: STAT_SCIENCE,
    EFFECT_NOVA_VITALITY: STAT_SCIENCE,                                           // ×(1+SCI/100)
    EFFECT_DAMAGE_RETURN: STAT_AGILITY,                                           // ×(1+AGI/100)
    EFFECT_ABSOLUTE_SHIELD: STAT_RESISTANCE, EFFECT_RELATIVE_SHIELD: STAT_RESISTANCE // ×(1+RES/100)
]
global CAP_MP_FACTOR = 0.1   // MP = multiplicateur plat du résultat (mobilité générique — assumé
                             // aplati : 8 PM ≠ 2 entités à 4 PM ; 0.03 → 0.1, user call)
global CAP_SCALE     = 0.006 // master dial (protein ≈ +10 sur un build à ~900 HP de bucket STR)

class ImportanceClass {

    /**
     * Importance multiplier of one entity, in [0,1] — FROZEN at its first computation of
     * the turn (the BFS root scores every real entity from the pristine State before any
     * branch; a virtual bulb freezes at its constructor stats). Low for weak entities
     * (a bulb ≈ 1/3 of a real leek), 1 for a maxed build.
     */
    static get(stat) {
        var id = stat.ID
        if (id in IMPORTANCE_BY_ID) return IMPORTANCE_BY_ID[id]
        var raw = IMP_W_STRENGTH   * stat.STRENGTH   * (1 + IMP_CONVEX * stat.STRENGTH)
                + IMP_W_MAGIC      * stat.MAGIC      * (1 + IMP_CONVEX * stat.MAGIC)
                + IMP_W_WISDOM     * stat.WISDOM     * (1 + IMP_CONVEX * stat.WISDOM)
                + IMP_W_SCIENCE    * stat.SCIENCE    * (1 + IMP_CONVEX * stat.SCIENCE)
                + IMP_W_AGILITY    * stat.AGILITY    * (1 + IMP_CONVEX * stat.AGILITY)
                + IMP_W_RESISTANCE * stat.RESISTANCE * (1 + IMP_CONVEX * stat.RESISTANCE)
                + IMP_W_TOTAL_TP   * stat.TOTAL_TP   * (1 + IMP_CONVEX * stat.TOTAL_TP)
                + IMP_W_TOTAL_MP   * stat.TOTAL_MP   * (1 + IMP_CONVEX * stat.TOTAL_MP)
        var imp = min(1, raw / IMP_SCALE)
        IMPORTANCE_BY_ID[id] = imp
        return imp
    }

    /**
     * LIVE additive buff/debuff channel, v2 (see header):
     *   capability = CAP_SCALE · Σ_S bucket_S · (1 + max(0, stat_S)/100) · (1 + CAP_MP_FACTOR·mp)
     * The (1 + stat/100) is THE GENERATOR'S OWN FORMULA (an item outputs its base even at
     * stat 0 — the old T×stat shape wrongly zeroed a 0-STR rifle). bucket_S = the HP output
     * of S-scaled effects in the entity's best combo AT ITS CURRENT TOTAL_TP (cached by
     * (id, TP) — a TP buff re-runs the greedy, so its delta is EMERGENT: 0 on a bulb that
     * can't use the extra TP, a real extra cast on a loaded build). MP = flat multiplier
     * (generic mobility — flattened on purpose). MEMOIZED on the stat object (CAP_MEMO,
     * null-on-clone). Me is INCLUDED on purpose: my buffs' immediate delta has no other
     * channel (Me is excluded from contextBySide AND the heal map — my outputs are simulated,
     * not projected), so capability(Me) is the exploration ticket that keeps buff→attack
     * chains alive past the sub-epsilon enumeration filter; the chain's real payoff still
     * dominates the decision.
     */
    static capability(stat) {
        if (stat.CAP_MEMO != null) return stat.CAP_MEMO
        var combo = getCapabilityCombo(stat)   // [STAT_X -> HP des effets scalés par X], only non-zero buckets
        var v = 0
        for (var s: var hp in combo) {
            if      (s == STAT_STRENGTH)   v += hp * (1 + max(0, stat.STRENGTH) / 100)
            else if (s == STAT_MAGIC)      v += hp * (1 + max(0, stat.MAGIC) / 100)
            else if (s == STAT_WISDOM)     v += hp * (1 + max(0, stat.WISDOM) / 100)
            else if (s == STAT_SCIENCE)    v += hp * (1 + max(0, stat.SCIENCE) / 100)
            else if (s == STAT_AGILITY)    v += hp * (1 + max(0, stat.AGILITY) / 100)
            else if (s == STAT_RESISTANCE) v += hp * (1 + max(0, stat.RESISTANCE) / 100)
        }
        v *= CAP_SCALE * (1 + CAP_MP_FACTOR * max(0, stat.TOTAL_MP))
        stat.CAP_MEMO = v
        return v
    }

    /* The entity's sorted castable item list [[item, hpValue, cost], ...] — turn-start
     * cooldown ≤ 1 gate (the danger-inventory convention), HP-valued via CAP_HP_W, sorted
     * HP/TP desc. Cached per id per turn (CAPABILITY_ITEMS_BY_ID). */
    static getCapabilityItems(stat) {
        var id = stat.ID
        if (id in CAPABILITY_ITEMS_BY_ID) return CAPABILITY_ITEMS_BY_ID[id]
        var items = []
        for (var i: var cd in stat.COOLDOWNS) {
            if (cd > 1) continue
            var hpValue = 0
            for (var eff in ITEMINFO[i].EFFECTS) {
                if (eff[0] in CAP_HP_W) hpValue += eff[1] * CAP_HP_W[eff[0]]
            }
            if (hpValue <= 0) continue
            push(items, [i, hpValue, ITEMINFO[i].COST])
        }
        if (count(items) > 1) items = arraySort(items, function(a, b) { return (b[1] / b[2]) - (a[1] / a[2]) })
        CAPABILITY_ITEMS_BY_ID[id] = items
        return items
    }

    /* The greedy combo at the entity's CURRENT TOTAL_TP, as per-stat HP buckets
     * [STAT_X -> HP output of X-scaled effects]. Cached by (id << 10) | max(0, TOTAL_TP) —
     * TP is IN the key so in-branch TP buffs/shackles re-run the greedy at the new budget
     * (few distinct TP values per turn -> few runs, ~100-200 ops each). */
    static getCapabilityCombo(stat) {
        var tp = max(0, stat.TOTAL_TP)
        var key = (stat.ID << 10) | tp
        if (key in CAPABILITY_COMBO_CACHE) return CAPABILITY_COMBO_CACHE[key]
        var combo = [: ]
        for (var it in getCapabilityItems(stat)) {
            var maxUses = ITEMINFO[it[0]].MAX_USES
            var n = 0
            while (tp >= it[2] && n < maxUses) { tp -= it[2]; n++ }
            if (n == 0) continue
            for (var eff in ITEMINFO[it[0]].EFFECTS) {
                if (!(eff[0] in CAP_STAT_OF_EFFECT) || !(eff[0] in CAP_HP_W)) continue
                var s = CAP_STAT_OF_EFFECT[eff[0]]
                combo[s] = ((s in combo) ? combo[s] : 0) + n * eff[1] * CAP_HP_W[eff[0]]
            }
        }
        CAPABILITY_COMBO_CACHE[key] = combo
        return combo
    }
}
