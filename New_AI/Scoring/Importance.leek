/*
 * Les deux canaux de valeur d'une entité, découplés :
 *
 *   term(e) = sign · ( importance(e) · survival(e)  +  capability(e) )
 *
 * #1 IMPORTANCE — multiplicateur de rang dans [0,1], FIGÉ au début du tour (memo par id).
 *    Son seul rôle : classer QUI compte (focus/protéger — un bulbe ≈ 1/3 d'un vrai poireau).
 *    Figé => un buff en cours de tour ne le bouge pas d'un point ; les changements de stats
 *    paient par capability et par les vrais canaux (contexte danger, formules de dégâts,
 *    heal map).
 *
 * #2 CAPABILITY — le canal LIVE des buffs/debuffs, additif et volontairement PETIT :
 *      capability = CAP_SCALE · Σ_S bucket_S · (1 + max(0,stat_S)/100) · (1 + CAP_MP_FACTOR·mp)
 *    bucket_S = la sortie HP des effets scalés par S dans le meilleur combo d'items de
 *    l'entité à son TOTAL_TP courant (glouton gated cooldown, valorisé via CAP_HP_W).
 *    « La valeur d'une stat = ce que les ITEMS peuvent en faire » : buffer une stat
 *    qu'aucun item n'utilise vaut 0 ; les buffs TP sont ÉMERGENTS (le combo se relance au
 *    nouveau budget) ; MP = multiplicateur plat. Tuer une entité libère sa capability.
 *
 * LIFE n'est dans aucun des deux (le terme de survie s'en charge).
 */

include("../includes.leek")

// ============================================================================
// TUNING — #1 IMPORTANCE.   raw = Σ W[S]·stat[S]·(1 + IMP_CONVEX·stat[S]) ;
// importance = min(1, raw/IMP_SCALE), figée au tour.
//   - SCIENCE au-dessus (valeur d'équipe), autres stats de combat égales, TP >> MP.
//   - IMP_SCALE : le raw qui vaut importance 1. Monter => tout le monde baisse.
// ============================================================================
global IMP_W_STRENGTH   = 0.002
global IMP_W_MAGIC      = 0.002
global IMP_W_WISDOM     = 0.002
global IMP_W_SCIENCE    = 0.003
global IMP_W_AGILITY    = 0.002
global IMP_W_RESISTANCE = 0.002
global IMP_W_TOTAL_TP   = 0.10
global IMP_W_TOTAL_MP   = 0.05
global IMP_CONVEX       = 0.0003
global IMP_SCALE        = 9.0

// ============================================================================
// TUNING — #2 CAPABILITY. CAP_HP_W = HP par point d'effet de base (la monnaie commune).
// Seuls les RATIOS comptent pour le glouton — le niveau absolu est absorbé par CAP_SCALE.
// ============================================================================
global CAP_HP_W = [
    EFFECT_DAMAGE: 1.0,
    EFFECT_POISON: 2.0,                 // ≈ ticks espérés avant cure
    EFFECT_HEAL: 1.0,
    EFFECT_BOOST_MAX_LIFE: 1.0,
    EFFECT_ABSOLUTE_SHIELD: 5.0,        // 1 ABS bloque 1 dégât PAR HIT (~5 hits sur la durée)
    EFFECT_RELATIVE_SHIELD: 25.0,       // 1% du flux entrant (~2500) sur la durée
    EFFECT_VULNERABILITY: 25.0,         // miroir du relative shield
    EFFECT_ABSOLUTE_VULNERABILITY: 5.0, // miroir de l'absolute shield
    EFFECT_DAMAGE_RETURN: 15.0,
    EFFECT_NOVA_DAMAGE: 5.0,            // permanent + heal-proof
    EFFECT_NOVA_VITALITY: 5.0,
    EFFECT_AFTEREFFECT: -2.0,           // le self-poison du doping
    EFFECT_BUFF_TP: 100.0,              // 1 TP ≈ un cast de plus
    EFFECT_BUFF_MP: 40.0,
    EFFECT_BUFF_STRENGTH: 5.0,          // 1 STR = +1% dégâts ≈ 1% × ~500 de base
    EFFECT_BUFF_RESISTANCE: 3.0,
    EFFECT_BUFF_WISDOM: 3.0,
    EFFECT_BUFF_AGILITY: 2.0,
    EFFECT_SHACKLE_STRENGTH: 5.0,       // les shackles = miroirs des buffs
    EFFECT_SHACKLE_MAGIC: 5.0,
    EFFECT_SHACKLE_TP: 100.0,
    EFFECT_SHACKLE_MP: 40.0,
    EFFECT_SHACKLE_WISDOM: 3.0,
    EFFECT_SHACKLE_AGILITY: 2.0
]
// Effet -> stat de scaling du CASTER (multiplicateurs vérifiés dans le moteur). Les effets
// sans scaling (vulnés, raw buffs) comptent dans la VALEUR du glouton mais n'alimentent
// aucun bucket.
global CAP_STAT_OF_EFFECT = [
    EFFECT_DAMAGE: STAT_STRENGTH,
    EFFECT_POISON: STAT_MAGIC,
    EFFECT_SHACKLE_STRENGTH: STAT_MAGIC, EFFECT_SHACKLE_MAGIC: STAT_MAGIC,
    EFFECT_SHACKLE_TP: STAT_MAGIC, EFFECT_SHACKLE_MP: STAT_MAGIC,
    EFFECT_SHACKLE_WISDOM: STAT_MAGIC, EFFECT_SHACKLE_AGILITY: STAT_MAGIC,        // shackles ×(1+MAG/100)
    EFFECT_HEAL: STAT_WISDOM, EFFECT_BOOST_MAX_LIFE: STAT_WISDOM,                 // ×(1+WIS/100)
    EFFECT_BUFF_TP: STAT_SCIENCE, EFFECT_BUFF_MP: STAT_SCIENCE,
    EFFECT_BUFF_STRENGTH: STAT_SCIENCE, EFFECT_BUFF_RESISTANCE: STAT_SCIENCE,
    EFFECT_BUFF_WISDOM: STAT_SCIENCE, EFFECT_BUFF_AGILITY: STAT_SCIENCE,
    EFFECT_AFTEREFFECT: STAT_SCIENCE, EFFECT_NOVA_DAMAGE: STAT_SCIENCE,
    EFFECT_NOVA_VITALITY: STAT_SCIENCE,                                           // ×(1+SCI/100)
    EFFECT_DAMAGE_RETURN: STAT_AGILITY,                                           // ×(1+AGI/100)
    EFFECT_ABSOLUTE_SHIELD: STAT_RESISTANCE, EFFECT_RELATIVE_SHIELD: STAT_RESISTANCE // ×(1+RES/100)
]
global CAP_MP_FACTOR = 0.1   // MP = multiplicateur plat (mobilité générique, volontairement aplati)
global CAP_SCALE     = 0.006 // master dial (un buff de main-stat ≈ +10 sur un build chargé)

class ImportanceClass {

    /*
     * Importance d'une entité, dans [0,1] — FIGÉE à sa première évaluation du tour (la racine
     * du BFS score toutes les entités réelles avant toute branche ; un bulbe virtuel se fige
     * à ses stats de constructeur). Basse pour une entité faible, 1 pour un build max.
     */
    static get(stat) {
        var id = stat.ID
        if (id in IMPORTANCE_BY_ID) return IMPORTANCE_BY_ID[id]
        var raw = IMP_W_STRENGTH   * stat.STRENGTH   * (1 + IMP_CONVEX * stat.STRENGTH)
                + IMP_W_MAGIC      * stat.MAGIC      * (1 + IMP_CONVEX * stat.MAGIC)
                + IMP_W_WISDOM     * stat.WISDOM     * (1 + IMP_CONVEX * stat.WISDOM)
                + IMP_W_SCIENCE    * stat.SCIENCE    * (1 + IMP_CONVEX * stat.SCIENCE)
                + IMP_W_AGILITY    * stat.AGILITY    * (1 + IMP_CONVEX * stat.AGILITY)
                + IMP_W_RESISTANCE * stat.RESISTANCE * (1 + IMP_CONVEX * stat.RESISTANCE)
                + IMP_W_TOTAL_TP   * stat.TOTAL_TP   * (1 + IMP_CONVEX * stat.TOTAL_TP)
                + IMP_W_TOTAL_MP   * stat.TOTAL_MP   * (1 + IMP_CONVEX * stat.TOTAL_MP)
        var imp = min(1, raw / IMP_SCALE)
        IMPORTANCE_BY_ID[id] = imp
        return imp
    }

    /*
     * Canal LIVE des buffs/debuffs (formule du header). Le (1 + stat/100) est LA formule du
     * moteur : un item sort sa base même à stat 0. Memoïsé sur l'objet stat (CAP_MEMO,
     * null-au-clone). Me est INCLUS exprès : le delta immédiat de mes buffs n'a aucun autre
     * canal (Me est exclu du contexte danger ET de la heal map — mes sorties sont simulées,
     * pas projetées), capability(Me) est le ticket d'exploration qui garde les chaînes
     * buff→attaque au-dessus du filtre sub-epsilon ; le vrai payoff de la chaîne domine
     * ensuite la décision.
     */
    static capability(stat) {
        if (stat.CAP_MEMO != null) return stat.CAP_MEMO
        var combo = getCapabilityCombo(stat)   // [STAT_X -> HP des effets scalés par X], buckets non nuls
        var v = 0
        for (var s: var hp in combo) {
            if      (s == STAT_STRENGTH)   v += hp * (1 + max(0, stat.STRENGTH) / 100)
            else if (s == STAT_MAGIC)      v += hp * (1 + max(0, stat.MAGIC) / 100)
            else if (s == STAT_WISDOM)     v += hp * (1 + max(0, stat.WISDOM) / 100)
            else if (s == STAT_SCIENCE)    v += hp * (1 + max(0, stat.SCIENCE) / 100)
            else if (s == STAT_AGILITY)    v += hp * (1 + max(0, stat.AGILITY) / 100)
            else if (s == STAT_RESISTANCE) v += hp * (1 + max(0, stat.RESISTANCE) / 100)
        }
        v *= CAP_SCALE * (1 + CAP_MP_FACTOR * max(0, stat.TOTAL_MP))
        stat.CAP_MEMO = v
        return v
    }

    /*
     * Liste d'items castables de l'entité [[item, hpValue, coût], ...] — gate cooldown <= 1
     * de début de tour (convention de l'inventaire danger), valorisés via CAP_HP_W, triés
     * HP/TP décroissant. Cachée par id pour le tour.
     */
    static getCapabilityItems(stat) {
        var id = stat.ID
        if (id in CAPABILITY_ITEMS_BY_ID) return CAPABILITY_ITEMS_BY_ID[id]
        var items = []
        for (var i: var cd in stat.COOLDOWNS) {
            if (cd > 1) continue
            var hpValue = 0
            for (var eff in ITEMINFO[i].EFFECTS) {
                if (eff[0] in CAP_HP_W) hpValue += eff[1] * CAP_HP_W[eff[0]]
            }
            if (hpValue <= 0) continue
            push(items, [i, hpValue, ITEMINFO[i].COST])
        }
        if (count(items) > 1) items = arraySort(items, function(a, b) { return (b[1] / b[2]) - (a[1] / a[2]) })
        CAPABILITY_ITEMS_BY_ID[id] = items
        return items
    }

    /*
     * Le combo glouton au TOTAL_TP courant de l'entité, en buckets HP par stat
     * [STAT_X -> HP des effets scalés par X]. Clé (id << 10) | max(0, TOTAL_TP) — le TP est
     * DANS la clé pour que les buffs/shackles TP en branche relancent le glouton au nouveau
     * budget (peu de TP distincts par tour -> peu de runs).
     */
    static getCapabilityCombo(stat) {
        var tp = max(0, stat.TOTAL_TP)
        var key = (stat.ID << 10) | tp
        if (key in CAPABILITY_COMBO_CACHE) return CAPABILITY_COMBO_CACHE[key]
        var combo = [: ]
        for (var it in getCapabilityItems(stat)) {
            var maxUses = ITEMINFO[it[0]].MAX_USES
            var n = 0
            while (tp >= it[2] && n < maxUses) { tp -= it[2]; n++ }
            if (n == 0) continue
            for (var eff in ITEMINFO[it[0]].EFFECTS) {
                if (!(eff[0] in CAP_STAT_OF_EFFECT) || !(eff[0] in CAP_HP_W)) continue
                var s = CAP_STAT_OF_EFFECT[eff[0]]
                combo[s] = ((s in combo) ? combo[s] : 0) + n * eff[1] * CAP_HP_W[eff[0]]
            }
        }
        CAPABILITY_COMBO_CACHE[key] = combo
        return combo
    }
}
