/**
 * TWO SEPARATE FUNCTIONS (the buff-farm fix — form and level DECOUPLED):
 *
 *   term(e) = sign · ( importance(e) · survival(e)  +  capability(e) )
 *
 * #1 IMPORTANCE — the TIER multiplier in [0,1], FROZEN AT TURN START (memo by id, first
 *    computed at the BFS root on the real stats; reset per turn in ReloadCacheNewTurn).
 *    Its only job: rank WHO matters (focus/protect — a bulb ≈ 1/3 of a real leek). Frozen ⇒
 *    in-turn buffs move it by exactly ZERO — the old live version paid ~90 score per self-buff
 *    (importance × ~2000 survival) and the AI spent entire endgames buff-farming instead of
 *    attacking. Stat changes pay through capability + the REAL channels (danger context,
 *    damage formulas, heal map).
 *
 * #2 CAPABILITY — the additive, LIVE, deliberately SMALL buff/debuff channel:
 *      capability = CAP_SCALE · Σ CAP_W[s] · max(0, stat_s)²
 *    QUADRATIC on purpose: the marginal value of +1 stat is ∝ the CURRENT stat — buffing a
 *    stat the build actually uses (STR 600→750 ≈ +10) pays, buffing a useless stat
 *    (MAG 0→150 ≈ +1) pays almost nothing but stays > epsilon (never hard-pruned, still
 *    chainable). Because the channel is ADDITIVE with its own tiny CAP_SCALE, the convex
 *    shape can't inflate deltas the way it did inside the multiplicative importance.
 *    max(0,·): a shackle pushing a stat negative must not RAISE capability via the square.
 *    Debuffs pay symmetrically (shackle STR 700→400 on an enemy ≈ −16 for it).
 *    Killing an entity frees its capability too (~30-60) — the buffed one is worth slightly
 *    more dead, coherent and negligible vs BASE_ALIVE.
 *
 * TODO (capability v2, user request): replace the raw square with a per-stat evaluation of
 * the entity's best ITEM COMBOS with COOLDOWNS — the value of a stat = what the entity's
 * items can actually DO with it this turn / the coming turns (cooldown-aware), instead of
 * a blind quadratic proxy.
 *
 * LIFE is in neither function (survival term owns it). importance ≈ 5 ops (memo hit),
 * capability ≈ 30 ops.
 **/

include("../includes.leek")

// ============================================================================
// TUNE HERE — #1 IMPORTANCE.   raw = Σ W[S]·stat[S]·(1 + IMP_CONVEX·stat[S]) ;
// importance = min(1, raw/IMP_SCALE), FROZEN per turn.
//   - SCIENCE highest (team value); other combat stats equal; TP ≫ MP.
//   - IMP_SCALE: raw value that maps to importance 1. Raise to make everyone lower.
// ============================================================================
global IMP_W_STRENGTH   = 0.002
global IMP_W_MAGIC      = 0.002
global IMP_W_WISDOM     = 0.002
global IMP_W_SCIENCE    = 0.003
global IMP_W_AGILITY    = 0.002
global IMP_W_RESISTANCE = 0.002
global IMP_W_TOTAL_TP   = 0.10
global IMP_W_TOTAL_MP   = 0.05
global IMP_CONVEX       = 0.0003
global IMP_SCALE        = 9.0

// ============================================================================
// TUNE HERE — #2 CAPABILITY.   CAP_SCALE · Σ CAP_W·max(0,stat)²  (additive, live, small)
// Calibrated so a main-stat buff ≈ +10, adrenaline (+4 TP at ~28) ≈ +8, +2 MP ≈ +3:
// TP/MP are small numbers, squared even smaller → their weights look big, that's expected.
// CAP_SCALE is the master dial: the whole buff economy scales with it.
// ============================================================================
global CAP_W_STAT  = 1.0
global CAP_W_TP    = 650
global CAP_W_MP    = 1800
global CAP_SCALE   = 0.00005

class ImportanceClass {

    /**
     * Importance multiplier of one entity, in [0,1] — FROZEN at its first computation of
     * the turn (the BFS root scores every real entity from the pristine State before any
     * branch; a virtual bulb freezes at its constructor stats). Low for weak entities
     * (a bulb ≈ 1/3 of a real leek), 1 for a maxed build.
     */
    static get(stat) {
        var id = stat.ID
        if (id in IMPORTANCE_BY_ID) return IMPORTANCE_BY_ID[id]
        var raw = IMP_W_STRENGTH   * stat.STRENGTH   * (1 + IMP_CONVEX * stat.STRENGTH)
                + IMP_W_MAGIC      * stat.MAGIC      * (1 + IMP_CONVEX * stat.MAGIC)
                + IMP_W_WISDOM     * stat.WISDOM     * (1 + IMP_CONVEX * stat.WISDOM)
                + IMP_W_SCIENCE    * stat.SCIENCE    * (1 + IMP_CONVEX * stat.SCIENCE)
                + IMP_W_AGILITY    * stat.AGILITY    * (1 + IMP_CONVEX * stat.AGILITY)
                + IMP_W_RESISTANCE * stat.RESISTANCE * (1 + IMP_CONVEX * stat.RESISTANCE)
                + IMP_W_TOTAL_TP   * stat.TOTAL_TP   * (1 + IMP_CONVEX * stat.TOTAL_TP)
                + IMP_W_TOTAL_MP   * stat.TOTAL_MP   * (1 + IMP_CONVEX * stat.TOTAL_MP)
        var imp = min(1, raw / IMP_SCALE)
        IMPORTANCE_BY_ID[id] = imp
        return imp
    }

    /**
     * LIVE additive buff/debuff channel (see header). Quadratic: marginal value ∝ current
     * stat → useless-stat buffs pay ~nothing, main-stat buffs pay ~10, all > epsilon.
     * MEMOIZED on the stat object (CAP_MEMO): stats only mutate on fresh clones and the clone
     * sites null the memo — a shared object's memo is valid for every sharer by construction.
     * TODO (v2): per-stat best item combos with cooldowns instead of the blind square.
     */
    static capability(stat) {
        if (stat.CAP_MEMO != null) return stat.CAP_MEMO
        var s  = max(0, stat.STRENGTH)
        var m  = max(0, stat.MAGIC)
        var w  = max(0, stat.WISDOM)
        var sc = max(0, stat.SCIENCE)
        var a  = max(0, stat.AGILITY)
        var r  = max(0, stat.RESISTANCE)
        var tp = max(0, stat.TOTAL_TP)
        var mp = max(0, stat.TOTAL_MP)
        var v = CAP_SCALE * (CAP_W_STAT * (s*s + m*m + w*w + sc*sc + a*a + r*r) + CAP_W_TP * tp*tp + CAP_W_MP * mp*mp)
        stat.CAP_MEMO = v
        return v
    }
}
