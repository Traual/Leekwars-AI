// Affichage manuel des coefficients au début du tour, avant la première recherche.
include("../includes.leek")

class ScoringDebug {
    static ENABLED = true // false désactive les logs ET les pauses.

    static coefficients(State) {
        // Même contexte que le BFS : les coefficients d'équipement ont besoin des poids.
        ROOT_SCORING_CONSTANTS = ScoringStateConstants.get(State, StateClass.getBaseHash(State))
        for (var id: var stat in State) {
            if (stat.LIFE <= 0) continue
            debug("[COEFS] Tour " + getTurn() + " | " + stat.NAME + " (#" + id + ")"
                + (id == Me ? " [moi]" : (stat.SIDE == State[Me].SIDE ? " [allié]" : " [adversaire]")))
            // Coefficients bruts : durée et facteurs communs PT/PM appliqués séparément.
            var potential = ScoringClass.characteristicsPotential(stat)
            var tpFactor = Coefficients.tpMultiplier(stat)
            var mpFactor = Coefficients.mpMultiplier(stat)
            var periodic = PeriodicScoring.damageValues(stat)
            var poisonCoef = Coefficients.poison(stat, periodic)
            var aftereffectCoef = Coefficients.aftereffect(stat, periodic)
            debug([
                "présence": Coefficients.presence(stat),
                "importance (caractéristiques de base)": EntityImportance.statsImportance(stat),
                "importance (tactique)": EntityImportance.tacticalImportance(stat),
                "importance (potentiel de base)": EntityImportance.potential(stat),
                "importance (multiplicateur PT de base)": EntityImportance.tpMultiplier(stat),
                "importance (multiplicateur PM de base)": EntityImportance.mpMultiplier(stat),
                "vie": Coefficients.life(stat),
                "vie max": Coefficients.totalLife(stat),
                "force": Coefficients.strength(stat),
                "sagesse": Coefficients.wisdom(stat),
                "agilité (total)": Coefficients.agility(stat),
                "agilité (base critique incluse)": Coefficients.criticalAgility(stat),
                "résistance": Coefficients.resistance(stat),
                "science": Coefficients.science(stat),
                "magie": Coefficients.magic(stat),
                "puissance": Coefficients.power(stat),
                "potentiel courant (caractéristiques + tactique)": potential,
                "facteur PT courant": tpFactor,
                "facteur PM courant": mpFactor,
                "score caractéristiques et ressources (avant décote entraves)": potential * tpFactor * mpFactor,
                "entraves (multiplicateur Manumission)": ShackleScoring.multiplier(stat),
                "bouclier absolu": Coefficients.absoluteShield(stat),
                "protections et renvoi (facteur adverse)": ShieldProfile.forEntity(stat),
                "bouclier absolu (bonus PV brut)": Coefficients.absoluteShieldLifeBonus(stat),
                "bouclier relatif": Coefficients.relativeShield(stat),
                "bouclier relatif (bonus PV brut)": Coefficients.relativeShieldLifeBonus(stat),
                "renvoi": Coefficients.damageReturn(stat),
                "poison": poisonCoef,
                "poison (cooldown effectif Antidote)": PeriodicScoring.antidoteCooldown(stat),
                "poison (facteur Antidote)": Coefficients.antidoteMultiplier(PeriodicScoring.antidoteCooldown(stat)),
                "poison (score futur)": stat.POISON_OVER_TIME * poisonCoef,
                "aftereffect": aftereffectCoef,
                "aftereffect (score futur)": stat.AFTEREFFECT_OVER_TIME * aftereffectCoef,
                "soin continu": Coefficients.heal(stat)
            ])
        }
        pause()
    }
}
