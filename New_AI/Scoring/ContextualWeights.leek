/*
 * Réseau contextuel de poids : il regarde TOUT le combat, puis module les coefficients de
 * scoring d'une planification.
 *
 *   encodeur partagé   : chaque entité -> un plongement
 *   agrégation         : somme des plongements alliés, somme des plongements ennemis —
 *                        une somme ne dépend pas de l'ordre des entités
 *   tête globale       : (traits de combat, résumé allié, résumé ennemi) -> plongement global
 *   tête d'entité      : (plongement d'entité, plongement global, relation à Me) -> 8 facteurs
 *   tête de placement  : (plongement global, plongement de Me) -> 4 facteurs
 *
 * Le réseau ne REMPLACE pas les coefficients historiques : il les MULTIPLIE par un facteur
 * borné. Un modèle neutre (paramètres tous nuls) rend le facteur 1 exactement, et multiplier
 * un flottant par 1 ne déplace aucun bit — poids historiques retrouvés au bit près. Les
 * coefficients qui partent de zéro reçoivent à la place une contribution additive, nulle au
 * neutre : aucun facteur multiplicatif ne saurait les rallumer.
 *
 * Les paramètres vivent dans des tableaux numériques à plat, jamais dans un objet par neurone
 * ou par connexion. Une seule fonction de couche dense les consomme.
 *
 * Tout tourne UNE fois par planification, à la construction du contexte de poids. Le scoring
 * chaud ne voit que des objets de poids déjà calculés.
 */

include("../includes.leek")

// Le commutateur. Faux = fabrique historique, vrai = réseau. C'est le SEUL endroit où le
// choix se fait : aucune condition n'est dispersée dans le scoring ni dans FinalCell.
global CONTEXTUAL_WEIGHTS_ENABLED = false

// Bornes du facteur multiplicatif. Un modèle ne peut ni annuler ni faire exploser un
// coefficient historique : il l'infléchit.
global NN_MULT_MIN = 0.25
global NN_MULT_MAX = 4.0

// Un facteur MULTIPLICATIF ne peut pas rallumer un coefficient historiquement nul : zéro fois
// n'importe quoi reste zéro. Les coefficients qui partent de zéro reçoivent donc une
// contribution ADDITIVE, nulle quand le modèle est neutre et bornée au-dessus. Elle reste
// positive, donc la pénalité de placement ne peut pas changer de signe.
global NN_ADD_MAX = 4.0

// Les types d'effet dont on donne au réseau la meilleure valeur en UN cast, en unités moteur
// brutes. Volontairement sans pondération de ma part : « ce que ce kit peut produire » est un
// fait du moteur, le taux de change entre un dégât et un bouclier est justement ce que le
// réseau doit apprendre.
global NN_KIT_EFFECTS = [
	EFFECT_DAMAGE, EFFECT_POISON, EFFECT_HEAL,
	EFFECT_ABSOLUTE_SHIELD, EFFECT_RELATIVE_SHIELD,
	EFFECT_VULNERABILITY, EFFECT_ABSOLUTE_VULNERABILITY,
	EFFECT_DAMAGE_RETURN, EFFECT_NOVA_DAMAGE,
	EFFECT_BUFF_TP, EFFECT_SHACKLE_TP, EFFECT_BUFF_STRENGTH
]
// Même liste en map, pour tester l'appartenance sans balayer le tableau.
global NN_KIT_MEMBER = [: ]
// Familles de durée : un buff et un shackle ne se lisent pas pareil, mais tous les buffs se
// lisent ensemble.
global NN_BUFF_MEMBER = [
	EFFECT_BUFF_STRENGTH: true, EFFECT_BUFF_MP: true, EFFECT_BUFF_TP: true,
	EFFECT_BUFF_RESISTANCE: true, EFFECT_BUFF_WISDOM: true, EFFECT_BUFF_AGILITY: true,
	EFFECT_RAW_BUFF_STRENGTH: true
]
global NN_SHACKLE_MEMBER = [
	EFFECT_SHACKLE_STRENGTH: true, EFFECT_SHACKLE_MAGIC: true, EFFECT_SHACKLE_TP: true,
	EFFECT_SHACKLE_MP: true, EFFECT_SHACKLE_WISDOM: true, EFFECT_SHACKLE_AGILITY: true
]

// Tailles. Modifier une taille impose de refournir des paramètres de la bonne longueur : les
// NN_*_IN sont des sommes des autres, tenues à jour à la main. NN_ENT_FEATURES doit valoir
// EXACTEMENT la longueur rendue par entityFeatures — trop court, la couche lit du vide ; trop
// long, les derniers traits sont ignorés en silence.
global NN_ENT_FEATURES = 57
global NN_EMBED = 8
global NN_BATTLE_FEATURES = 16
global NN_GLOBAL_IN = 32    // NN_BATTLE_FEATURES + 2 · NN_EMBED
global NN_RELATION = 3
global NN_ENT_HEAD_IN = 19  // NN_EMBED + NN_EMBED + NN_RELATION
global NN_ENT_HEAD_OUT = 8  // ALIVE, LIFE, THREAT, MAXLIFE, CAPABILITY, DR, FINAL_DISTANCE, FINAL_COVID
global NN_FIN_HEAD_IN = 16  // NN_EMBED + NN_EMBED
global NN_FIN_HEAD_OUT = 4  // NET, HEAL_COST, CENTER, CROWDING

// Paramètres appris, à plat. null = modèle NEUTRE : toutes les sorties valent 0, donc tous
// les facteurs valent 1, donc les poids historiques sortent inchangés.
global NN_W_ENC = null
global NN_B_ENC = null
global NN_W_GLOBAL = null
global NN_B_GLOBAL = null
global NN_W_ENT = null
global NN_B_ENT = null
global NN_W_FIN = null
global NN_B_FIN = null

class ContextualWeightNetworkClass {

	/*
	 * Contexte de poids d'une planification, produit par le réseau.
	 *
	 * Part TOUJOURS des poids historiques et les module : un modèle absent ou neutre rend donc
	 * exactement le contexte historique.
	 */
	static build(State, mySide) {
		var historical = HistoricalWeightsFactory.build(State, mySide)
		if (NN_W_ENC == null) {
			// Aucun modèle appris : les facteurs vaudraient tous 1, autant ne rien dérouler.
			if (NN_MODEL == null) return historical
			loadVector(NN_MODEL)
		}

		// Un plongement par entité, encodeur PARTAGÉ. Les résumés par camp sont des sommes :
		// elles ne dépendent pas de l'ordre du parcours.
		var meStat = State[Me]
		var embeddings = [: ]
		var allySummary = zeros(NN_EMBED)
		var enemySummary = zeros(NN_EMBED)
		for (var e: var stat in State) {
			var emb = dense(entityFeatures(stat, meStat, mySide, State), NN_W_ENC, NN_B_ENC, NN_ENT_FEATURES, NN_EMBED, true)
			embeddings[e] = emb
			var into = (stat.SIDE == mySide) ? allySummary : enemySummary
			for (var i = 0; i < NN_EMBED; i++) into[i] += emb[i]
		}

		var globalIn = battleFeatures(State, meStat, mySide)
		for (var i = 0; i < NN_EMBED; i++) push(globalIn, allySummary[i])
		for (var i = 0; i < NN_EMBED; i++) push(globalIn, enemySummary[i])
		var globalEmbedding = dense(globalIn, NN_W_GLOBAL, NN_B_GLOBAL, NN_GLOBAL_IN, NN_EMBED, true)
		historical.GLOBAL_EMBEDDING = globalEmbedding

		// Tête d'entité : un passage par entité, ici et nulle part ailleurs.
		for (var e: var stat in State) {
			var headIn = []
			var emb = embeddings[e]
			for (var i = 0; i < NN_EMBED; i++) push(headIn, emb[i])
			for (var i = 0; i < NN_EMBED; i++) push(headIn, globalEmbedding[i])
			push(headIn, (e == Me) ? 1 : 0)
			push(headIn, (stat.SIDE == mySide) ? 1 : 0)
			push(headIn, stat.IS_SUMMON ? 1 : 0)
			var out = dense(headIn, NN_W_ENT, NN_B_ENT, NN_ENT_HEAD_IN, NN_ENT_HEAD_OUT, false)
			var h = historical.ENTITY_WEIGHTS_BY_ID[e]
			// Chaque morceau de la valeur reçoit son propre facteur : le réseau peut dire qu'ici
			// achever compte plus que gratter, ou qu'une entité vaut surtout par son capital
			// durable. Un facteur unique ne pouvait dire que QUI compte.
			historical.ENTITY_WEIGHTS_BY_ID[e] = new EntityWeightsClass(
				h.ALIVE * bounded(out[0]),
				h.LIFE * bounded(out[1]),
				h.THREAT * bounded(out[2]),
				h.MAXLIFE * bounded(out[3]),
				h.CAPABILITY * bounded(out[4]),
				h.DR * bounded(out[5]),
				h.FINAL_DISTANCE * bounded(out[6]),
				h.FINAL_COVID * bounded(out[7]))
		}

		// Tête de placement : plongement global et plongement de Me.
		var finIn = []
		for (var i = 0; i < NN_EMBED; i++) push(finIn, globalEmbedding[i])
		var meEmb = embeddings[Me]
		for (var i = 0; i < NN_EMBED; i++) push(finIn, meEmb[i])
		var fout = dense(finIn, NN_W_FIN, NN_B_FIN, NN_FIN_HEAD_IN, NN_FIN_HEAD_OUT, false)
		var f = historical.FINAL_CELL_WEIGHTS
		// Le coût de soin part de zéro : il reçoit une contribution ADDITIVE, sinon aucun facteur
		// ne pourrait jamais l'allumer.
		historical.FINAL_CELL_WEIGHTS = new FinalCellWeightsClass(
			f.NET * bounded(fout[0]),
			f.HEAL_COST + additive(fout[1]),
			f.CENTER * bounded(fout[2]),
			f.CROWDING * bounded(fout[3]))
		return historical
	}

	/*
	 * Facteur multiplicatif borné. Sortie nulle -> 1 EXACTEMENT : c'est ce qui rend un modèle
	 * neutre indiscernable de la formule historique, au bit près.
	 * Toujours strictement positif, donc aucun poids ne change de signe et la pénalité de
	 * placement reste >= 0 — la coupure terminale sans epsilon reste exacte.
	 */
	static bounded(raw) {
		return min(NN_MULT_MAX, max(NN_MULT_MIN, 1 + raw))
	}

	/*
	 * Contribution ADDITIVE bornée, pour les coefficients qui partent de zéro. Sortie nulle -> 0
	 * EXACTEMENT, donc un modèle neutre n'ajoute rien et la parité tient. Jamais négative : un
	 * terme de pénalité doit rester positif pour que la coupure terminale reste exacte.
	 */
	static additive(raw) {
		return min(NN_ADD_MAX, max(0, raw))
	}

	/*
	 * Couche dense : out[o] = activation(bias[o] + Σ_i matrice[o · inSize + i] · in[i]).
	 * Matrice à plat, ligne par ligne. `relu` faux = sortie linéaire.
	 */
	static dense(input, matrix, bias, inSize, outSize, relu) {
		var out = []
		for (var o = 0; o < outSize; o++) {
			var acc = bias[o]
			var base = o * inSize
			for (var i = 0; i < inSize; i++) acc += matrix[base + i] * input[i]
			push(out, relu ? max(0, acc) : acc)
		}
		return out
	}

	/*
	 * Traits d'une entité, tous normalisés dans des ordres de grandeur comparables : un réseau
	 * n'apprend rien de propre sur des entrées dont les échelles diffèrent d'un facteur mille.
	 */
	/*
	 * Ce que l'entité PORTE : le covid contagieux, et combien de tours tiennent encore ses
	 * protections et ses modificateurs de stats. Une valeur sans sa durée ne dit pas si elle
	 * pèsera encore au prochain tour.
	 *
	 * Ligne d'effet : [0] type, [1] valeur, [2] lanceur, [3] tours, [4] critique, [5] item.
	 */
	static carriedFeatures(stat) {
		var covid = 0, absT = 0, relT = 0, drT = 0, buffT = 0, shackT = 0
		for (var eff in stat.EFFECTS) {
			var ty = eff[0]
			var tu = eff[3]
			if (ty == EFFECT_POISON) {
				if (eff[5] == CHIP_COVID && eff[1] > covid) covid = eff[1]
			} else if (ty == EFFECT_ABSOLUTE_SHIELD) {
				if (tu > absT) absT = tu
			} else if (ty == EFFECT_RELATIVE_SHIELD) {
				if (tu > relT) relT = tu
			} else if (ty == EFFECT_DAMAGE_RETURN) {
				if (tu > drT) drT = tu
			} else if (ty in NN_BUFF_MEMBER) {
				if (tu > buffT) buffT = tu
			} else if (ty in NN_SHACKLE_MEMBER) {
				if (tu > shackT) shackT = tu
			}
		}
		return [covid / 500, absT / 10, relT / 10, drT / 10, buffT / 10, shackT / 10]
	}

	/*
	 * Ce que l'entité peut PRODUIRE, par type d'effet : la meilleure valeur en un seul cast
	 * parmi ses items disponibles, en unités moteur. Aucun poids de ma part n'intervient — le
	 * taux de change entre un dégât et un bouclier est justement ce que le réseau doit trouver.
	 */
	static kitFeatures(stat) {
		if (mapIsEmpty(NN_KIT_MEMBER)) {
			for (var ty in NN_KIT_EFFECTS) NN_KIT_MEMBER[ty] = true
		}
		var best = [: ]
		for (var i in stat.INVENTORY) {
			if (StateClass.cooldownOf(stat, i) > 1) continue
			for (var eff in ITEMINFO[i].EFFECTS) {
				var ty = eff[0]
				if (!(ty in NN_KIT_MEMBER)) continue
				if (!(ty in best) || eff[1] > best[ty]) best[ty] = eff[1]
			}
		}
		var out = []
		for (var ty in NN_KIT_EFFECTS) push(out, (ty in best) ? best[ty] / 100 : 0)
		return out
	}

	static entityFeatures(stat, meStat, mySide, State) {
		var total = max(1, stat.TOTAL_LIFE)
		var base = stat.BASE_STATS
		// Invocations possédées : une entité qui en tient huit ne se joue pas comme une qui en
		// tient une, et le compte seul ne dit pas leur solidité.
		var summons = 0, summonLife = 0
		for (var o: var s in State) {
			if (s.LIFE > 0 && s.SUMMONER == stat.ID) {
				summons++
				summonLife += s.LIFE
			}
		}
		var carried = carriedFeatures(stat)
		var kit = kitFeatures(stat)
		var out = [
			// Rôle
			(stat.SIDE == mySide) ? 1 : 0,
			stat.IS_SUMMON ? 1 : 0,
			(stat.ID == Me) ? 1 : 0,
			// Vitalité. La vie ABSOLUE compte autant que la fraction : un bulbe à moitié mort
			// et un poireau à moitié mort ne sont pas la même menace.
			stat.LIFE / total,
			stat.LIFE / 5000,
			total / 5000,
			// Stats brutes
			max(0, stat.STRENGTH) / 1000,
			max(0, stat.MAGIC) / 1000,
			max(0, stat.WISDOM) / 1000,
			max(0, stat.SCIENCE) / 1000,
			max(0, stat.AGILITY) / 1000,
			max(0, stat.RESISTANCE) / 1000,
			max(0, stat.POWER) / 100,
			// Écart aux stats de base : buffé ou shacklé, et de combien. Le niveau seul ne dit
			// pas si l'entité est en train de monter en puissance ou d'être démontée.
			(stat.STRENGTH - base[STAT_STRENGTH]) / 500,
			(stat.MAGIC - base[STAT_MAGIC]) / 500,
			(stat.WISDOM - base[STAT_WISDOM]) / 500,
			(stat.SCIENCE - base[STAT_SCIENCE]) / 500,
			(stat.AGILITY - base[STAT_AGILITY]) / 500,
			(stat.RESISTANCE - base[STAT_RESISTANCE]) / 500,
			// Défenses
			max(0, stat.ABSOLUTE_SHIELD) / 100,
			max(0, stat.RELATIVE_SHIELD) / 100,
			max(0, stat.DAMAGE_RETURN) / 100,
			// Ressources, niveau et écart au base — les shackles de TP et de MP sont parmi les
			// effets les plus lourds du jeu.
			stat.TP / max(1, stat.TOTAL_TP),
			stat.MP / max(1, stat.TOTAL_MP),
			max(0, stat.TOTAL_TP) / 30,
			max(0, stat.TOTAL_MP) / 10,
			(stat.TOTAL_TP - base[STAT_TP]) / 10,
			(stat.TOTAL_MP - base[STAT_MP]) / 5,
			// Les six canaux périodiques SÉPARÉS. Les écraser en un net détruit exactement la
			// distinction qui décide s'il faut nettoyer ou soigner : le poison se cure,
			// l'aftereffect non, le soin sur la durée est amical.
			stat.POISON / total,
			stat.POISON_OVER_TIME / total,
			stat.AFTEREFFECT / total,
			stat.AFTEREFFECT_OVER_TIME / total,
			stat.HEAL / total,
			stat.HEAL_OVER_TIME / total,
			// Géométrie
			CellClass.getDist(stat.CELL, meStat.CELL) / GRAV_MAXDIST,
			// Invocations possédées
			summons / 4,
			summonLife / 5000,
			// Résumés de la formule historique. Ils partiront quand le réseau saura s'en passer.
			ImportanceClass.get(stat),
			ImportanceClass.capability(stat) / 1000
		]
		for (var v in carried) push(out, v)
		for (var v in kit) push(out, v)
		return out
	}

	/* Traits du combat lui-même : de quoi distinguer une ouverture d'une fin de partie. */
	static battleFeatures(State, meStat, mySide) {
		var allies = 0, enemies = 0, allyLife = 0, enemyLife = 0
		var allyImp = 0, enemyImp = 0, allyTp = 0, enemyTp = 0, allyMp = 0, enemyMp = 0
		var distEnemyMin = GRAV_MAXDIST, distEnemySum = 0, distAllySum = 0
		for (var e: var stat in State) {
			if (stat.LIFE <= 0) continue
			var d = CellClass.getDist(stat.CELL, meStat.CELL)
			if (stat.SIDE == mySide) {
				allies++
				allyLife += stat.LIFE
				allyImp += ImportanceClass.get(stat)
				allyTp += stat.TOTAL_TP
				allyMp += stat.TOTAL_MP
				if (e != Me) distAllySum += d
			} else {
				enemies++
				enemyLife += stat.LIFE
				enemyImp += ImportanceClass.get(stat)
				enemyTp += stat.TOTAL_TP
				enemyMp += stat.TOTAL_MP
				distEnemySum += d
				if (d < distEnemyMin) distEnemyMin = d
			}
		}
		return [
			getTurn() / 32,
			allies / 6,
			enemies / 6,
			allyLife / 20000,
			enemyLife / 20000,
			meStat.LIFE / max(1, meStat.TOTAL_LIFE),
			// Les trois distances. Ensemble, la plus proche et la moyenne décrivent une position
			// que ni l'une ni l'autre ne dit seule : collé à UN ennemi et loin des autres.
			distEnemyMin / GRAV_MAXDIST,
			(enemies > 0 ? distEnemySum / enemies : GRAV_MAXDIST) / GRAV_MAXDIST,
			(allies > 1 ? distAllySum / (allies - 1) : GRAV_MAXDIST) / GRAV_MAXDIST,
			// La valeur d'une équipe n'est pas son effectif : trois entités fortes et six faibles
			// ne se jouent pas pareil.
			allyImp / 6,
			enemyImp / 6,
			allyTp / 100,
			enemyTp / 100,
			allyMp / 50,
			enemyMp / 50,
			// Part physique du danger adverse : ce qui déclenche des retours de dégâts. La table
			// est construite paresseusement au premier porteur évalué, donc elle peut ne pas
			// exister encore ici — on ne la force pas, elle a sa propre logique de gel au tour.
			(DR_PHYSRATIO_BY_SIDE != null && mySide in DR_PHYSRATIO_BY_SIDE) ? DR_PHYSRATIO_BY_SIDE[mySide] : 0.5
		]
	}

	static zeros(n) {
		var a = []
		for (var i = 0; i < n; i++) push(a, 0)
		return a
	}

	/*
	 * Charge un vecteur de paramètres PLAT dans les huit tableaux, dans l'ordre où ils sont
	 * déclarés. C'est la seule porte d'entrée d'un modèle appris : l'entraînement n'a qu'un
	 * vecteur à produire, et sa longueur est vérifiée ici.
	 */
	static loadVector(v) {
		var expected = NN_EMBED * NN_ENT_FEATURES + NN_EMBED
			+ NN_EMBED * NN_GLOBAL_IN + NN_EMBED
			+ NN_ENT_HEAD_OUT * NN_ENT_HEAD_IN + NN_ENT_HEAD_OUT
			+ NN_FIN_HEAD_OUT * NN_FIN_HEAD_IN + NN_FIN_HEAD_OUT
		if (count(v) != expected) {
			debugE("modèle de longueur " + count(v) + ", attendu " + expected + " : modèle ignoré")
			loadNeutral()
			return;
		}
		var at = 0
		NN_W_ENC = take(v, at, NN_EMBED * NN_ENT_FEATURES)      at += NN_EMBED * NN_ENT_FEATURES
		NN_B_ENC = take(v, at, NN_EMBED)                        at += NN_EMBED
		NN_W_GLOBAL = take(v, at, NN_EMBED * NN_GLOBAL_IN)      at += NN_EMBED * NN_GLOBAL_IN
		NN_B_GLOBAL = take(v, at, NN_EMBED)                     at += NN_EMBED
		NN_W_ENT = take(v, at, NN_ENT_HEAD_OUT * NN_ENT_HEAD_IN) at += NN_ENT_HEAD_OUT * NN_ENT_HEAD_IN
		NN_B_ENT = take(v, at, NN_ENT_HEAD_OUT)                 at += NN_ENT_HEAD_OUT
		NN_W_FIN = take(v, at, NN_FIN_HEAD_OUT * NN_FIN_HEAD_IN) at += NN_FIN_HEAD_OUT * NN_FIN_HEAD_IN
		NN_B_FIN = take(v, at, NN_FIN_HEAD_OUT)
	}

	/* n valeurs du vecteur à partir de `at`. */
	static take(v, at, n) {
		var a = []
		for (var i = 0; i < n; i++) push(a, v[at + i])
		return a
	}

	/*
	 * Modèle NEUTRE : tous les paramètres nuls. Chaque tête sort 0, donc chaque facteur vaut 1,
	 * donc les poids historiques ressortent au bit près — le réseau tourne pour de vrai mais ne
	 * décide rien. C'est le modèle de départ d'un entraînement, et le seul moyen de prouver que
	 * le chemin réseau est bien neutre plutôt que simplement contourné.
	 */
	static loadNeutral() {
		NN_W_ENC = zeros(NN_EMBED * NN_ENT_FEATURES)
		NN_B_ENC = zeros(NN_EMBED)
		NN_W_GLOBAL = zeros(NN_EMBED * NN_GLOBAL_IN)
		NN_B_GLOBAL = zeros(NN_EMBED)
		NN_W_ENT = zeros(NN_ENT_HEAD_OUT * NN_ENT_HEAD_IN)
		NN_B_ENT = zeros(NN_ENT_HEAD_OUT)
		NN_W_FIN = zeros(NN_FIN_HEAD_OUT * NN_FIN_HEAD_IN)
		NN_B_FIN = zeros(NN_FIN_HEAD_OUT)
	}
}
