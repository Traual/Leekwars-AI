/*
 * Poids de placement contextuels. Aucun réseau n'est employé : le commutateur reste fermé, pour
 * que la boucle de jeu garde un seul point de choix des poids de placement.
 */

include("../includes.leek")

global CONTEXTUAL_WEIGHTS_ENABLED = false

class ContextualWeightNetworkClass {
	static build(State, mySide) {
		return HistoricalWeightsFactory.build(State, mySide)
	}
}
