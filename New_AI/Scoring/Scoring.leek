/*
 * Scoring : valeur d'un état, en HP d'équipe.
 *
 * Par entité VIVANTE — deux canaux, chaque input a UN seul canal :
 *   netTick       = POISON + AFTEREFFECT − HEAL              // tick périodique net (6 flux séparés)
 *   afterPeriodic = max(0, LIFE − COEF_PERIODIC_TICK·netTick)  // STOCK : vie après le tick net
 *   ttk           = rounds avant la mort sous la pression    // HORIZON : danger net + traînée périodique
 *   value       = BASE_ALIVE + W_LIFE·sqrt(afterPeriodic) + W_TTK·g(ttk) + W_TOTAL_LIFE·sqrt(TOTAL_LIFE)
 *   term        = sign · (importance·value + capability + drDeterrence)
 * Me fait exception : son terme est STATIQUE (danger = 0). Là où il finira le tour n'est pas
 * décidé pendant la recherche, projeter des attaques sur lui n'aurait donc aucun support.
 * Sa sécurité est arbitrée après coup, par la pénalité de placement de FinalCell.
 *
 * score = Σ term.  sign = +1 allié, −1 ennemi. Les morts contribuent 0 -> BASE_ALIVE
 * apporte une contribution fixe d'être vivant, importance·BASE_ALIVE (le terme complet
 * retiré par un kill ajoute le reste de survival, capability — possiblement négative — et
 * drDeterrence : pas un plancher strict). Le SCORE d'un nœud soustrait en plus
 * CAST_COST[action] (coût d'action porté par le chemin -> le score n'est pas strictement
 * Σ termes).
 *
 * importance est FIGÉE pendant un replan/BFS (classement des cibles, rafraîchie par Play à
 * chaque planification réelle), capability est le canal LIVE des
 * buffs/debuffs + shields idle (Importance.leek), drDeterrence le bonus des porteurs de
 * damage return.
 * sqrt est concave (finir les blessés paie plus par HP) ; g(ttk) est relatif à la vie (une
 * menace n'est jamais noyée) et concentre la valeur sur les SEUILS de kill.
 */

include("../includes.leek")

class ScoringClass {

    /*
     * Map complète des termes [id -> terme SIGNÉ] (score == sumTerms(map)).
     * Utilisée à la racine du BFS, puis portée de nœud en nœud et patchée.
     * hfpBySide et poisonKey sont construits UNE seule fois par l'appelant (racine du BFS)
     * et réutilisés ici, jamais reconstruits.
     */
    static buildTermsMap(State, MySide, BaseHash, contextBySide, hfpBySide, poisonKey) {
        BenchOps.Start("Scoring")
        var netDamageMap = DeltaClass.getNetDamageMap(State, BaseHash, contextBySide, hfpBySide)
        var terms = [: ]
        for (var e: var stat in State) {
            if (stat.LIFE <= 0) continue
            if (e == Me) {
                // Terme STATIQUE de Me : danger nul, donc drDeterrence nul aussi (les retours
                // s'arrêtent à min(net, LIFE)). Signe toujours +1, Me étant de mon camp.
                terms[e] = ImportanceClass.get(stat) * survivalValue(stat, 0, State, poisonKey) + ImportanceClass.capability(stat)
                continue
            }
            var sign = (stat.SIDE == MySide) ? 1 : -1
            terms[e] = sign * (ImportanceClass.get(stat) * survivalValue(stat, netDamageMap[e], State, poisonKey) + ImportanceClass.capability(stat) + drDeterrence(stat, netDamageMap[e], State))
        }
        BenchOps.Stop("Scoring")
        return terms
    }

    static sumTerms(terms) {
        var s = 0
        for (var e: var t in terms) s += t
        return s
    }

    /*
     * Score incrémental : score(enfant) = score(parent) + Δ sur le recompute-set EXACT.
     * Recompute-set = node.LOCAL_TERM_DIRTY (le masque différentiel du Node a déjà comparé
     * les inputs locaux de chaque clonée — diffMaskOf + checks Me BaseHash/fingerprint) ∪
     * les entités touchées par un trigger global : DANGER = l'union des cibles couvertes par
     * la géométrie ANCIENNE ou NOUVELLE des casters de node.DANGER_DIRTY_CASTERS (plus aucun
     * scan « tout le side » : CONTEXT_BY_SIDE reste une clé de cache, ce n'est plus un
     * déclencheur de recomputation), heal (HFP_BY_SIDE), et pour la couverture antidote
     * (POISON_KEY) les seuls porteurs de POISON_OVER_TIME. Une morte NON clonée est skippée
     * (ancien et nouveau terme valent déjà 0). Un terme sauté n'est PAS écrit dans le patch :
     * il se résout chez l'ancêtre (chaîne TERMS_PARENT). Aucun clone de la map complète.
     */
    static getStateScoreFromParent(node, EffectiveState, ParentScore, ParentTermNode, ParentHfp, MySide, ParentPoisonKey) {
        BenchOps.Start("Scoring")
        // EffectiveState = le workspace ENCORE muté par l'action (le nœud, lui, ne porte que
        // son patch : END_STATS est null tant qu'il n'est pas développé).
        var State = EffectiveState
        var cloned = node.CLONED
        var hfpMap = node.HFP_BY_SIDE

        // Map d'empreintes PARTAGÉE avec le parent (copie-sur-écriture du Nœud) : aucune
        // empreinte n'a pu changer, et le fold est exactement celui du parent. Le cas courant
        // — une attaque ordinaire ne touche ni la qualification ni les stats d'un soigneur.
        // Sinon seulement, un parcours produit les deux informations qu'on en tire : le fold
        // combiné (clé de la heal map) et les sides dont les inputs heal ont changé.
        // Comparaison 0-défaut : le patch ne fait qu'AJOUTER des clés, donc la map enfant ⊇
        // la map parent -> itérer l'enfant suffit.
        var combinedHfp
        var healChanged = null
        if (node.HFP_OWNED) {
            combinedHfp = 0
            for (var s: var h in hfpMap) {
                combinedHfp ^= h
                if (((s in ParentHfp) ? ParentHfp[s] : 0) != h) {
                    if (healChanged == null) healChanged = [: ]
                    healChanged[s] = true
                }
            }
        } else {
            combinedHfp = ParentTermNode.COMBINED_HFP
        }
        node.COMBINED_HFP = combinedHfp
        var healMap = HealClass.getHealMapByFp(State, combinedHfp)

        // Casters offensifs réellement modifiés par l'action (posés par le Node depuis les
        // SEULS blocs où la contribution au contexte a bougé). Une cible n'est relue que si
        // l'un d'eux la COUVRE réellement.
        // null = aucun caster sale (cas courant, aucune map allouée par le Node).
        var hasDirtyCasters = node.DANGER_DIRTY_CASTERS != null
        var casterDeps = null   // descripteurs construits paresseusement, une fois par nœud
        // Couverture antidote : POISON_KEY (poisonKeyOf — BaseHash, porteurs, ancre, Me
        // vivant) comparée à celle du parent. Déclenche exactement sur les vrais événements
        // (kill, summon, résu, push, cd/MP d'un porteur, mort de Me), jamais sur mes moves ni
        // mes casts ordinaires. Le coef antidote ne module que le VRAI poison restant
        // (POISON_OVER_TIME, survivalValue) — AFTEREFFECT et HEAL_OVER_TIME ne le lisent
        // pas : seuls les porteurs de POT > 0 sont relus quand la clé bouge.
        node.POISON_KEY = poisonKeyOnNode(node, State)
        var coefChanged = node.POISON_KEY != ParentPoisonKey
        // Les cinq champs que le calcul d'un terme lit sur le nœud sont invariants pour tout
        // le nœud : lus une fois ici plutôt qu'à chacun des termes recalculés. Les passer ne
        // coûte rien, un appel valant 1 quel que soit son nombre d'arguments.
        var nBase = node.BASE_HASH
        var nCtx = node.CONTEXT_BY_SIDE
        var nHfp = node.HFP_BY_SIDE
        var nPoison = node.POISON_KEY

        var delta = 0
        var termsPatch = [: ]
        node.TERMS_PARENT = ParentTermNode

        if (!hasDirtyCasters && healChanged == null && !coefChanged) {
            // Cas courant : le masque du Node a déjà déterminé les termes locaux sales.
            // La valeur PORTE l'état d'après l'action : plus besoin de rouvrir l'état.
            for (var e: var stat in node.LOCAL_TERM_DIRTY) {
                delta += termDelta(e, stat, State, termsPatch, ParentTermNode, healMap, MySide, nBase, nCtx, nHfp, nPoison)
            }
        } else {
            for (var e: var stat in State) {
                // Morte non clonée : ancien et nouveau terme valent déjà 0, rien à recalculer
                // (une morte CLONÉE passe par LOCAL_TERM_DIRTY — kill de cette action).
                if (stat.LIFE <= 0 && !(e in cloned)) continue
                // Terme local déjà sale : aucun test de dépendance à payer.
                if (e in node.LOCAL_TERM_DIRTY) {
                    delta += termDelta(e, stat, State, termsPatch, ParentTermNode, healMap, MySide, nBase, nCtx, nHfp, nPoison)
                    continue
                }
                if (e == Me) {
                    // Le terme de Me ne consomme ni danger projeté ni soins projetés : le seul
                    // canal global qui puisse le salir est la couverture antidote, qui module
                    // son poison résiduel.
                    if (!(coefChanged && stat.POISON_OVER_TIME > 0)) continue
                } else {
                    var globalDirty = (healChanged != null && stat.SIDE in healChanged)
                        || (coefChanged && stat.POISON_OVER_TIME > 0)
                    if (!globalDirty && hasDirtyCasters) {
                        if (casterDeps == null) casterDeps = buildCasterDeps(node, State)
                        // Chacun encaisse à sa cellule courante : un seul test.
                        globalDirty = dangerAffectsCell(casterDeps, stat.SIDE, stat.CELL)
                    }
                    if (!globalDirty) continue
                }
                delta += termDelta(e, stat, State, termsPatch, ParentTermNode, healMap, MySide, nBase, nCtx, nHfp, nPoison)
            }
        }
        // La map n'est utile qu'à CE scoring : les hits du ScoredCache refabriquent un
        // candidat par ActionToNodeInTree, aucun chemin ne rescore le même objet Node.
        if (hasDirtyCasters) node.DANGER_DIRTY_CASTERS = null
        node.TERMS = termsPatch
        BenchOps.Stop("Scoring")

        // Coût de cast des items d'économie (CAST_COST, Weights.leek) : soustrait au SCORE,
        // pas aux TERMS — un coût d'ACTION porté par le chemin, comme les TP.
        return ParentScore + delta - ((node.ACTION.Item in CAST_COST) ? CAST_COST[node.ACTION.Item] : 0)
    }

    /*
     * Descripteurs des casters sales, à plat : [ancienCamp, ancienneMap, nouveauCamp,
     * nouvelleMap, ...]. Une map nulle = le caster ne menaçait (ou ne menace) personne, son
     * camp est alors sans objet et vaut -1. Camps ancien et nouveau conservés séparément pour
     * rester juste même si un id changeait de camp. Les deux maps peuvent être la même
     * référence quand la clé géométrique n'a pas bougé. Construit une seule fois par nœud.
     */
    static buildCasterDeps(node, State) {
        var deps = []
        var cloned = node.CLONED
        for (var caster: var _d in node.DANGER_DIRTY_CASTERS) {
            var oldStat = cloned[caster]       // null = caster NÉ dans l'action
            var newStat = State[caster]
            // Une clé au plus par état, et aucune pour un caster absent ou mort : sa couverture
            // est nulle sans le moindre calcul.
            var oldKey = (oldStat != null && oldStat.LIFE > 0) ? DangerPlanClass.mapCellItemAoeKeyOf(oldStat) : null
            var newKey = (newStat.LIFE > 0) ? DangerPlanClass.mapCellItemAoeKeyOf(newStat) : null
            var oldMap = null
            var newMap = null
            if (oldKey != null && oldKey == newKey) {
                // Géométrie inchangée (même id, cellule, MP totale et couche Jump) : la
                // couverture est LA MÊME map. STR/MAG/POWER/AGI et shields ne déplacent
                // personne, et l'inventaire d'un non-Me est figé pour le tour, déjà caché par id.
                oldMap = DangerPlanClass.offensiveCoverageOf(oldStat, caster, oldKey)
                newMap = oldMap
            } else {
                if (oldKey != null) oldMap = DangerPlanClass.offensiveCoverageOf(oldStat, caster, oldKey)
                if (newKey != null) newMap = DangerPlanClass.offensiveCoverageOf(newStat, caster, newKey)
            }
            push(deps, (oldMap == null) ? -1 : oldStat.SIDE)
            push(deps, oldMap)
            push(deps, (newMap == null) ? -1 : newStat.SIDE)
            push(deps, newMap)
        }
        return deps
    }

    /*
     * Une cible de camp TargetSide, à la cellule Cell, dépend-elle d'un caster sale ?
     * UNION ancienne ∪ nouvelle couverture, obligatoire : un caster tué n'a plus que
     * l'ancienne, un ressuscité ou invoqué que la nouvelle, un caster déplacé les deux.
     * La simple présence de la cellule suffit — ni couverture, ni hash, ni combo. Prédicat
     * volontairement CONSERVATEUR (un item couvrant peut finir à zéro contre les shields) :
     * il peut relire pour rien, jamais l'inverse.
     */
    static dangerAffectsCell(Deps, TargetSide, Cell) {
        var n = count(Deps)
        for (var i = 0; i < n; i += 4) {
            var oldMap = Deps[i + 1]
            if (oldMap != null && TargetSide != Deps[i] && (Cell in oldMap)) return true
            var newMap = Deps[i + 3]
            if (newMap != null && TargetSide != Deps[i + 2] && (Cell in newMap)) return true
        }
        return false
    }

    /* newTerm(e) − oldTerm(e) ; l'ancien terme est résolu dans la chaîne de snapshots
     * (termOf), le nouveau n'est écrit QUE dans le patch local du nœud.
     * L'importance est figée par replan et vit dans une map par id : la lire ici, avec la clé
     * déjà en main, évite l'appel et la relecture de l'id. L'appel reste le repli au tout
     * premier calcul d'un id, et demeure le SEUL écrivain de la map. */
    static termDelta(e, stat, State, termsPatch, ParentTermNode, healMap, MySide, NodeBaseHash, NodeContext, NodeHfp, NodePoisonKey) {
        var newTerm = 0
        if (stat.LIFE > 0) {
            if (e == Me) {
                // Terme STATIQUE : aucun danger positionnel, donc pas de drDeterrence non plus.
                // Sa sécurité est arbitrée après la recherche, par la pénalité de FinalCell.
                newTerm = ((e in IMPORTANCE_BY_ID) ? IMPORTANCE_BY_ID[e] : ImportanceClass.get(stat)) * survivalValue(stat, 0, State, NodePoisonKey) + ImportanceClass.capability(stat)
            } else {
                var sign = (stat.SIDE == MySide) ? 1 : -1
                var net = DeltaClass.netOf(e, stat, State, NodeBaseHash, NodeContext, NodeHfp, healMap)
                newTerm = sign * (((e in IMPORTANCE_BY_ID) ? IMPORTANCE_BY_ID[e] : ImportanceClass.get(stat)) * survivalValue(stat, net, State, NodePoisonKey) + ImportanceClass.capability(stat)
                    + (stat.DAMAGE_RETURN > 0 ? drDeterrence(stat, net, State) : 0))
            }
        }
        var oldTerm = termOf(ParentTermNode, e)
        termsPatch[e] = newTerm
        return newTerm - oldTerm
    }

    /*
     * Terme courant d'une entité dans la chaîne de snapshots : le patch le plus PROCHE qui
     * la contient gagne (dernier recalcul sur le chemin), la racine (noPlay) porte la map
     * complète. Absente de toute la chaîne -> 0 (morte à la racine, summon virtuel pas
     * encore né, ressuscité inconnu de la map racine).
     */
    static termOf(termNode, entityId) {
        var n = termNode
        while (n != null) {
            if (entityId in n.TERMS) return n.TERMS[entityId]
            n = n.TERMS_PARENT
        }
        return 0
    }

    /*
     * Valeur de survie d'une entité, cachée par une clé packée 64 bits :
     * LIFE<<48 | netTick<<34 | harmfulRemaining<<17 | danger — EXACTEMENT les valeurs que
     * la formule consomme. netTick / harmfulRemaining / danger sont MASQUÉS à leur slot
     * (valeurs négatives ou d'overkill possibles : un signe non masqué s'étendrait et
     * écraserait les champs hauts). Les bit-ops tronquent les floats, pas de round.
     * Le terme TOTAL_LIFE vit HORS cache (clé pleine) via le memo TLSQ_MEMO sur l'objet stat.
     * netTick = POISON + AFTEREFFECT − HEAL (tick périodique net du prochain tour).
     * harmfulRemaining = max(0, poisonCoefOf·POT + AFTEREFFECT_OVER_TIME − HEAL_OVER_TIME) :
     * la remise antidote porte SEULEMENT sur POISON_OVER_TIME — le moteur ne cure ni
     * l'aftereffect ni ne multiplie les soins futurs (correction voulue vs l'ancien
     * coef × net). poisonCoefOf n'est payé que si du POT existe.
     */
    static survivalValue(stat, danger, State, PoisonKey) {
        var tlTerm = stat.TLSQ_MEMO
        if (tlTerm == null) {
            tlTerm = W_TOTAL_LIFE * sqrt(max(0, stat.TOTAL_LIFE))
            stat.TLSQ_MEMO = tlTerm
        }
        var effectivePoisonRemaining = stat.POISON_OVER_TIME
        if (effectivePoisonRemaining > 0) effectivePoisonRemaining = poisonCoefOf(stat, State, PoisonKey) * effectivePoisonRemaining
        var netTick = stat.POISON + stat.AFTEREFFECT - stat.HEAL
        var harmfulRemaining = max(0, effectivePoisonRemaining + stat.AFTEREFFECT_OVER_TIME - stat.HEAL_OVER_TIME)
        var key = (stat.LIFE << 48) | ((netTick & 0x3FFF) << 34) | ((harmfulRemaining & 0x1FFFF) << 17) | (danger & 0x1FFFF)
        if (key in SURVIVAL_CACHE) return SURVIVAL_CACHE[key] + tlTerm

        // Canal STOCK : la vie brute après le tick périodique NET du prochain tour (poison +
        // aftereffect − heal over time : un HoT rehausse le stock). AUCUNE projection ici —
        // le danger et la traînée périodique vivent exclusivement dans le canal TTK
        // (chaque input a UN canal, pas de double compte). sqrt concave : un HP vaut plus
        // près de la mort -> finir les blessés.
        var afterPeriodic = max(0, stat.LIFE - COEF_PERIODIC_TICK * netTick)
        var value = BASE_ALIVE + W_LIFE * sqrt(afterPeriodic)

        // Canal HORIZON (TTK) en forme DIRECTE : g = horizonLife / (horizonLife + TTK_HALF ·
        // pression) — algébriquement identique à g(ttk) = ttk/(ttk+TTK_HALF) avec
        // ttk = horizonLife/pression, sans calcul intermédiaire de ttk ni dénominateur +1 :
        // pression nulle -> g = 1 EXACTEMENT (une entité vivante sans pression touche tout
        // W_TTK, plus de faux dégât fantôme). tick = poison du prochain tour, répété tant que
        // la traînée dure ; harmfulRemaining est remisé par la couverture antidote (poison
        // seul) -> TTK antidote-aware. Trois régimes :
        //   - sans traînée persistante : horizonLife = afterPeriodic,           pression = danger
        //   - mort PENDANT la traînée  : horizonLife = afterPeriodic,           pression = danger + tick
        //   - traînée EXPIRÉE avant    : horizonLife = afterPeriodic − traînée, pression = danger
        //     (simplification EXACTE de duration + (afterPeriodic − (danger+tick)·duration)/danger,
        //      duration = harmfulRemaining/tick — vérifiée algébriquement)
        // Détection sans division : afterPeriodic·tick <= (danger+tick)·harmfulRemaining.
        // tick = max(0, netTick). Tous les inputs sont déjà dans la clé du cache -> miss seulement.
        var tick = max(0, netTick)
        var horizonLife = afterPeriodic
        var pressure = danger
        if (tick > 0 && harmfulRemaining > 0) {
            if (afterPeriodic * tick <= (danger + tick) * harmfulRemaining) {
                pressure = danger + tick                       // il meurt avant l'expiration de la traînée
            } else {
                horizonLife = afterPeriodic - harmfulRemaining // la traînée expire, elle est payée
            }
        }
        // g : 0 (condamné) -> 1 (sûr), pente max près de 0, RELATIF à la vie (un même danger
        // mord plus une petite vie). Franchir un seuil de kill est la plus grosse monnaie du
        // canal, puis g s'aplatit -> stack de vulnés jusqu'au seuil, puis cible suivante ;
        // l'overkill garde un gradient. Garde : horizonLife <= 0 -> contribution 0 (condamné),
        // jamais 1 ni epsilon — et jamais de 0/0.
        if (horizonLife > 0) value += W_TTK * horizonLife / (horizonLife + TTK_HALF * pressure)

        SURVIVAL_CACHE[key] = value
        return value + tlTerm
    }

    /*
     * Bonus dissuasion d'un porteur de damage return, dans SON propre terme : la menace qui
     * lui arrive (son net) se convertit en retours que ses attaquants saigneront.
     * Net post-shield et amorti par les heals VOLONTAIREMENT : un porteur blindé/soigné
     * attire moins de coups, donc dissuade moins. min(net, LIFE) : les retours s'arrêtent à
     * sa mort. Vit dans le terme du porteur exprès : ses inputs (net, DR, ratio figé) sont
     * exactement les triggers de recompute existants du terme -> aucun canal nouveau.
     * Mes propres attaques paient leur retour dans la sim et sont absentes des nets (Me
     * jamais caster) -> pas de double compte.
     */
    static drDeterrence(stat, net, State) {
        if (stat.DAMAGE_RETURN <= 0) return 0
        if (DR_PHYSRATIO_BY_SIDE == null) buildDrPhysRatios(State)
        return DR_RETURN_EXPECT * DR_PHYSRATIO_BY_SIDE[stat.SIDE] * min(net, stat.LIFE) * (stat.DAMAGE_RETURN / 100)
    }

    /*
     * [side -> part physique STR/(STR+MAG) de l'équipe ADVERSE] : la fraction du danger
     * entrant qui déclenche des retours (le poison n'en déclenche pas). Stats clampées à 0,
     * Me exclu (comme des nets). FIGÉ au tour, construit au premier porteur évalué :
     * une constante du tour garde les termes patchés purs.
     */
    static buildDrPhysRatios(State) {
        var strBySide = [: ], magBySide = [: ], strAll = 0, magAll = 0
        var sides = [: ]
        for (var e: var stat in State) {
            sides[stat.SIDE] = true
            if (stat.LIFE <= 0 || e == Me) continue
            var s = max(0, stat.STRENGTH), m = max(0, stat.MAGIC)
            strBySide[stat.SIDE] = ((stat.SIDE in strBySide) ? strBySide[stat.SIDE] : 0) + s
            magBySide[stat.SIDE] = ((stat.SIDE in magBySide) ? magBySide[stat.SIDE] : 0) + m
            strAll += s
            magAll += m
        }
        DR_PHYSRATIO_BY_SIDE = [: ]
        for (var side: var _ in sides) {
            var s = strAll - ((side in strBySide) ? strBySide[side] : 0)
            var m = magAll - ((side in magBySide) ? magBySide[side] : 0)
            DR_PHYSRATIO_BY_SIDE[side] = (s + m > 0) ? s / (s + m) : 1   // sans stats : dégâts de base, physiques
        }
    }

    /*
     * Y a-t-il un antidote dans ce combat ? Scanné MORTS INCLUS : basé inventaire, donc
     * invariant en branche (une première évaluation sur une branche kill-du-porteur ne peut
     * pas fausser le flag). Court-circuite toute la machinerie poison à ~2 ops sinon.
     * Lazy, reset au tour (un summon peut apporter des chips).
     */
    static anyAntidote(State) {
        if (ANY_ANTIDOTE == null) {
            ANTIDOTE_CARRIER_IDS = []
            ANTIDOTE_CARRIER_SET = [: ]
            for (var e: var stat in State) {
                if (StateClass.hasInventoryItem(stat, CHIP_ANTIDOTE)) {
                    push(ANTIDOTE_CARRIER_IDS, e)
                    ANTIDOTE_CARRIER_SET[e] = true
                }
            }
            ANY_ANTIDOTE = count(ANTIDOTE_CARRIER_IDS) > 0
            ME_HAS_ANTIDOTE = Me in ANTIDOTE_CARRIER_SET
        }
        return ANY_ANTIDOTE
    }

    /*
     * Clé de couverture antidote d'un état : encode TOUS les inputs de buildPoisonCoefs.
     *   - BaseHash : positions/vie des non-Me (kill, summon, résu, push -> clé neuve) ;
     *   - fold des porteurs vivants (id, TOTAL_MP, cd) : cast d'antidote, shackle/buff MP ;
     *   - ancre de replan de Me (MY_REPLAN_CELL_HASH) : Me est GELÉ à sa vraie cellule du
     *     dernier replan — la portée d'un porteur (range 4 + MP) dépasse un tour de
     *     déplacement et l'ancre converge vers ma cellule finale au fil des actions réelles ;
     *   - sel si Me est mort en branche (aucun des deux autres canaux ne le porte).
     * Sert de clé de POISON_COEF_CACHE ET de détecteur de changement parent/enfant.
     * 0 si pas d'antidote en jeu.
     *
     * Le fold est coupé en deux parce que les deux moitiés ne bougent pas au même rythme :
     * celle des porteurs AUTRES que Me (carrierFoldOthers) est héritée du parent d'un nœud à
     * l'autre, celle de Me est relue à chaque nœud (Me est cloné partout, et son stat est déjà
     * en main pour le test vivant/mort).
     */
    static poisonKeyFromFold(State, BaseHash, FoldOthers) {
        var key = BaseHash ^ MY_REPLAN_CELL_HASH ^ FoldOthers
        var meStat = State[Me]
        if (meStat.LIFE <= 0) return key ^ POISON_ME_DEAD_SALT
        if (ME_HAS_ANTIDOTE) key ^= carrierContribOf(meStat, Me)
        return key
    }

    /*
     * Contribution d'un porteur au fold, mémoïsée sur l'objet stat : ses deux seuls inputs
     * variables sont max(0, TOTAL_MP) et le cooldown effectif d'Antidote, que diffMaskOf
     * invalide. Un clone dont ni l'un ni l'autre n'a bougé garde donc son mémo, et la remontée
     * de chaîne du cooldown n'est pas payée à chaque nœud.
     */
    static carrierContribOf(stat, id) {
        var contrib = stat.PKEY_MEMO
        if (contrib == null) {
            contrib = mix64((id << 20) | (max(0, stat.TOTAL_MP) << 10) | min(1023, StateClass.cooldownOf(stat, CHIP_ANTIDOTE)))
            stat.PKEY_MEMO = contrib
        }
        return contrib
    }

    /* Fold des porteurs vivants AUTRES que Me. 0 si pas d'antidote en jeu. */
    static carrierFoldOthers(State) {
        if (!anyAntidote(State)) return 0
        var fold = 0
        for (var e in ANTIDOTE_CARRIER_IDS) {
            if (e == Me) continue
            var s = State[e]
            if (s.LIFE > 0) fold ^= carrierContribOf(s, e)
        }
        return fold
    }

    /*
     * Clé du nœud : le fold des autres porteurs est déjà PATCHÉ sur le nœud (Node le maintient
     * en old ^ new comme les trois autres hashs), il ne reste que la moitié de Me à relire.
     */
    static poisonKeyOnNode(node, State) {
        // Global lu directement : la racine du BFS a déjà appelé anyAntidote (carrierFoldOthers)
        // avant de fabriquer le moindre nœud, le flag n'est donc jamais null ici.
        if (ANY_ANTIDOTE != true) return 0
        return poisonKeyFromFold(State, node.BASE_HASH, node.POISON_FOLD)
    }

    /*
     * Coefficient poison d'une entité ∈ ]0,1] : la part du poison posé sur elle qui va
     * vraiment COLLER, vu la couverture antidote autour d'elle. PoisonKey vient de
     * poisonKeyOf (calculée une fois par nœud, portée par node.POISON_KEY).
     */
    static poisonCoefOf(stat, State, PoisonKey) {
        if (!anyAntidote(State)) return 1
        if (!(PoisonKey in POISON_COEF_CACHE)) POISON_COEF_CACHE[PoisonKey] = buildPoisonCoefs(State)
        var coefs = POISON_COEF_CACHE[PoisonKey]
        return (stat.ID in coefs) ? coefs[stat.ID] : 1
    }

    /*
     * [id -> coef] pour chaque vivant : coef = 1/(1 + POISON_CLEANSE_W · protection), avec
     * protection = son propre antidote 1/(1+cd) + Σ des porteurs alliés à portée, chacun
     * DILUÉ par le nombre de coéquipiers qu'il couvre (un antidote nettoie ~une cible par
     * cycle de cd : un porteur seul couvrant 4 protège chacun à 1/4, une équipe full-antidote
     * écrase le poison — le scoring voit OÙ le poison colle).
     * Portée = range antidote + MP, LoS ignorée. cd/cellules lus dans le State du build,
     * pureté garantie par la clé du cache.
     */
    static buildPoisonCoefs(State) {
        var antidoteRange = ITEMINFO[CHIP_ANTIDOTE].MAXRANGE
        var carriers = [: ]   // id -> [capacité déjà diluée par nCovered, portée]
        for (var a in ANTIDOTE_CARRIER_IDS) {
            var aStat = State[a]
            if (aStat.LIFE <= 0) continue
            var reach = antidoteRange + max(0, aStat.TOTAL_MP)
            var aCell = (a == Me) ? MY_REPLAN_CELL : aStat.CELL   // Me gelé (voir poisonCoefOf)
            var nCovered = 0
            for (var t: var tStat in State) {
                if (tStat.LIFE > 0 && tStat.SIDE == aStat.SIDE && CellClass.getDist(aCell, (t == Me) ? MY_REPLAN_CELL : tStat.CELL) <= reach) nCovered++
            }
            carriers[a] = [(1 / (1 + StateClass.cooldownOf(aStat, CHIP_ANTIDOTE))) / nCovered, reach]
        }
        var coefs = [: ]
        if (mapSize(carriers) == 0) return coefs   // aucun porteur vivant -> tous les lookups valent 1
        for (var e: var stat in State) {
            if (stat.LIFE <= 0) continue
            var eCell = (e == Me) ? MY_REPLAN_CELL : stat.CELL
            var ownAntidoteCd = StateClass.cooldownOf(stat, CHIP_ANTIDOTE)
            var protection = (ownAntidoteCd != null) ? 1 / (1 + ownAntidoteCd) : 0
            for (var a: var c in carriers) {
                if (a == e || State[a].SIDE != stat.SIDE) continue
                var aCell = (a == Me) ? MY_REPLAN_CELL : State[a].CELL
                if (CellClass.getDist(aCell, eCell) <= c[1]) protection += c[0]
            }
            coefs[e] = 1 / (1 + POISON_CLEANSE_W * protection)
        }
        return coefs
    }

    /*
     * Classe les morts alliés pour la résurrection : PROXY du terme post-revive — canaux
     * danger/TTK/DR omis volontairement (la cellule To est commune aux candidats, tous
     * relevés sans shields -> le net n'y différencie pas), et le kit (capability) lu sur
     * les stats de mort (proxy assumé). Vie ressuscitée via la SOURCE UNIQUE
     * ResurrectionClass.reviveTotalLife/reviveLife (arrondis moteur exacts) : le score
     * classe rigoureusement les mêmes valeurs que celles que Update appliquera. Quasi
     * gratuit : importance et capability sont déjà memoizées (par id / par objet).
     */
    static getResurrectionScore(entity_state, State) {
        var reviveTL = ResurrectionClass.reviveTotalLife(entity_state.TOTAL_LIFE, State)
        var reviveLife = ResurrectionClass.reviveLife(reviveTL)
        return ImportanceClass.get(entity_state)
                 * (BASE_ALIVE + W_LIFE * sqrt(reviveLife) + W_TOTAL_LIFE * sqrt(reviveTL))
             + ImportanceClass.capability(entity_state)
    }
}
