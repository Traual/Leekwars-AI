/*
 * Scoring v3 : valeur d'un état en PV pondérés par la production (formule dans Weights.leek).
 *
 *   score = Σ terme(e) sur les vivants  +  issue
 *   terme(e) = +valeur(e) pour mon camp, −valeur(e) pour l'adversaire
 *   issue    = +V3_WIN si plus aucun poireau adverse n'est debout, −V3_WIN si plus aucun des miens
 *
 * Me fait exception : sa pression projetée vaut 0 pendant la recherche. Là où il finira le
 * tour n'est pas décidé, et FinalCell facture ensuite, cellule par cellule, la valeur qu'il
 * perdrait sous le danger de sa cellule finale.
 *
 * La recherche patche les termes de nœud en nœud : un terme n'est recalculé que si ses entrées
 * ont bougé — ses champs locaux (masque du Node), le danger d'un lanceur qui la couvre, ou les
 * soigneurs de son camp. L'issue est un pseudo-terme, relu seulement quand un poireau meurt.
 */

include("../includes.leek")

// Pseudo-entité de l'issue dans la map de termes. Aucun identifiant d'entité n'est négatif.
global V3_OUTCOME_ID = -1

// Poids gelés au tour : [id d'un poireau, ou signature d'une invocation -> poids], et la
// production moyenne des poireaux vivants qui sert d'unité.
global V3_WORTH_BY_KEY = [: ]
global V3_WORTH_TURN = -1
global V3_OUT_REF = 1

class ScoringClass {

	/*
	 * Poids gelés au tour, préparés à la première lecture du tour. Un poireau et ses bulbes
	 * partagent la VM : un poids est une propriété de l'entité évaluée, pas de celle qui cherche.
	 */
	static prepareTurn(State) {
		var turn = getTurn()
		if (V3_WORTH_TURN == turn) return;
		V3_WORTH_TURN = turn
		V3_WORTH_BY_KEY = [: ]
		var sum = 0
		var n = 0
		for (var e: var stat in State) {
			if (stat.LIFE <= 0 || stat.IS_SUMMON) continue
			sum += OutputClass.of(stat)
			n++
		}
		V3_OUT_REF = (n > 0 && sum > 0) ? sum / n : 1
	}

	/*
	 * Poids d'une entité : sa production relative, bornée. Figé à sa première lecture du tour.
	 * Une invocation est rangée sous la signature de ses stats et de son invocateur : deux
	 * branches qui invoquent sous le même identifiant virtuel ne partagent un poids que si les
	 * invocations sont indiscernables.
	 */
	static worthOf(e, stat) {
		var key = stat.IS_SUMMON ? HistoricalWeightsFactory.summonKey(stat) : e
		if (key in V3_WORTH_BY_KEY) return V3_WORTH_BY_KEY[key]
		var out = OutputClass.of(stat)
		if (e in PLANT_ZONE_BY_ID) out *= V3_K_PLANT_OUTPUT
		var w = out / V3_OUT_REF
		if (V3_WORTH_POW != 1) w = pow(max(0, w), V3_WORTH_POW)
		if (w < V3_WORTH_MIN) w = V3_WORTH_MIN
		if (w > V3_WORTH_MAX) w = V3_WORTH_MAX
		V3_WORTH_BY_KEY[key] = w
		return w
	}

	/*
	 * Terme SIGNÉ d'une entité vivante, sous une pression projetée `net` (0 pour Me dans l'arbre).
	 */
	static entityTerm(e, stat, net, MySide) {
		// Flux périodiques EFFECTIFS : le moteur annule le tick de poison d'un INVINCIBLE et le
		// tick de soin d'un UNHEALABLE ; le contrecoup tombe toujours.
		var tickDmg = stat.POISON + stat.AFTEREFFECT
		var restDmg = (stat.POISON_OVER_TIME - stat.POISON) + (stat.AFTEREFFECT_OVER_TIME - stat.AFTEREFFECT)
		var tickHeal = stat.HEAL
		var restHeal = stat.HEAL_OVER_TIME - stat.HEAL
		if (stat.STATES != 0) {
			if (EntityStateClass.hasState(stat, STATE_INVINCIBLE)) {
				tickDmg = stat.AFTEREFFECT
				restDmg = stat.AFTEREFFECT_OVER_TIME - stat.AFTEREFFECT
			}
			if (EntityStateClass.hasState(stat, STATE_UNHEALABLE)) {
				tickHeal = 0
				restHeal = 0
			}
		}
		var lifeMax = stat.TOTAL_LIFE
		// PV attendus : le prochain tick net tombe, le reste des flux compte pour V3_K_PERIODIC.
		// Les soins continus remplissent d'abord la vie manquante ; ce qui déborde du plafond n'est
		// pas perdu, il absorbera les dégâts à venir — il compense le danger projeté et entre dans la
		// garde, jamais dans les PV.
		var filled = stat.LIFE - tickDmg + tickHeal + V3_K_PERIODIC * restHeal
		var overflow = 0
		if (filled > lifeMax) {
			overflow = filled - lifeMax
			filled = lifeMax
		}
		var now = filled - V3_K_PERIODIC * restDmg
		// Condamnée par ses flux : plus rien à défendre ni à attaquer.
		if (now <= 0) return 0

		var survival = 1
		var pressure = net - overflow
		if (pressure > 0) {
			var r = pressure / (V3_R0 * now)
			var rp = r * r
			if (V3_SF_POW == 4) rp = rp * rp
			else if (V3_SF_POW == 3) rp = rp * r
			survival = 1 / (1 + rp)
		}
		var ally = stat.SIDE == MySide
		var out = OutputClass.of(stat)
		if (e in PLANT_ZONE_BY_ID) out *= V3_K_PLANT_OUTPUT
		var worth = (ally && !V3_WORTH_ALLIES) ? 1 : worthOf(e, stat)
		var stock = now
		if (V3_HP_CONCAVITY != 0) stock = now * (1 + V3_HP_CONCAVITY * (1 - now / lifeMax))
		var value = worth * ((ally ? V3_K_HP_ALLY : V3_K_HP_ENEMY) * stock
				+ (stat.IS_SUMMON ? V3_K_PRESENCE_SUMMON + V3_K_ALIVE_SUMMON * survival : V3_K_PRESENCE_LEEK + V3_K_ALIVE_LEEK * survival) * lifeMax)
			+ (stat.IS_SUMMON ? V3_K_OUTPUT_PRESENCE_SUMMON + V3_K_OUTPUT_SUMMON * survival : (ally ? V3_K_OUTPUT_ALLY : V3_K_OUTPUT_ENEMY) * survival) * out
		// Garde au repos : boucliers et renvoi contre un tour d'attaques typique. Signée comme le
		// reste : retirer la protection d'un adversaire vaut autant que protéger un allié.
		if (V3_K_IDLE_SHIELD != 0) value += V3_K_IDLE_SHIELD * (stat.ABSOLUTE_SHIELD * V3_GUARD_HITS + stat.RELATIVE_SHIELD * lifeMax * V3_GUARD_SHARE / 100)
		if (V3_K_IDLE_DR != 0 && stat.DAMAGE_RETURN != 0) value += V3_K_IDLE_DR * stat.DAMAGE_RETURN * lifeMax * V3_GUARD_SHARE / 100
		if (V3_K_IDLE_HOT != 0 && overflow > 0) value += V3_K_IDLE_HOT * min(overflow, lifeMax * V3_GUARD_SHARE)
		return ally ? value : -value
	}

	/*
	 * Issue du combat : un camp sans poireau debout a perdu. Les invocations ne comptent pas.
	 */
	static outcomeOf(State, MySide) {
		var allies = false
		var enemies = false
		for (var e: var stat in State) {
			if (stat.LIFE <= 0 || stat.IS_SUMMON) continue
			if (stat.SIDE == MySide) allies = true
			else enemies = true
			if (allies && enemies) return 0
		}
		return (enemies ? 0 : V3_WIN) - (allies ? 0 : V3_WIN)
	}

	/*
	 * Map complète des termes [id -> terme signé], pseudo-terme d'issue compris. Utilisée à la
	 * racine du BFS, puis patchée de nœud en nœud. Passé OpsLimit, rend null plutôt que de
	 * laisser le moteur couper le tour.
	 */
	static buildTermsMap(State, MySide, BaseHash, contextBySide, hfpBySide, poisonKey, OpsLimit) {
		BenchOps.Start("Scoring")
		prepareTurn(State)
		var combinedFp = 0
		for (var s: var h in hfpBySide) combinedFp ^= h
		var healMap = HealClass.getHealMapByFp(State, combinedFp)
		var terms = [: ]
		for (var e: var stat in State) {
			if (stat.LIFE <= 0) continue
			if (getOperations() > OpsLimit) {
				BenchOps.Stop("Scoring")
				return null
			}
			var net = 0
			if (e != Me) {
				BenchOps.Start("Delta")
				net = DeltaClass.netOf(e, stat, State, BaseHash, contextBySide, hfpBySide, healMap)
				BenchOps.Stop("Delta")
			}
			terms[e] = entityTerm(e, stat, net, MySide)
		}
		terms[V3_OUTCOME_ID] = outcomeOf(State, MySide)
		BenchOps.Stop("Scoring")
		return terms
	}

	static sumTerms(terms) {
		var s = 0
		for (var e: var t in terms) s += t
		return s
	}

	/*
	 * Score incrémental : score(enfant) = score(parent) + Δ sur les termes dont une entrée a
	 * bougé. Mêmes déclencheurs que la recherche fournit déjà : LOCAL_TERM_DIRTY (champs
	 * locaux), casters dont la couverture offensive a changé, soigneurs d'un camp. Un terme
	 * sauté n'est pas écrit dans le patch : il se résout chez l'ancêtre (TERMS_PARENT).
	 */
	static getStateScoreFromParent(node, EffectiveState, ParentScore, ParentTermNode, ParentHfp, MySide, ParentPoisonKey) {
		BenchOps.Start("Scoring")
		var State = EffectiveState
		var cloned = node.CLONED
		var hfpMap = node.HFP_BY_SIDE

		var combinedHfp
		var healChanged = null
		if (node.HFP_OWNED) {
			combinedHfp = 0
			for (var s: var h in hfpMap) {
				combinedHfp ^= h
				if (((s in ParentHfp) ? ParentHfp[s] : 0) != h) {
					if (healChanged == null) healChanged = [: ]
					healChanged[s] = true
				}
			}
		} else {
			combinedHfp = ParentTermNode.COMBINED_HFP
		}
		node.COMBINED_HFP = combinedHfp
		var healMap = HealClass.getHealMapByFp(State, combinedHfp)

		var hasDirtyCasters = node.DANGER_DIRTY_CASTERS != null
		var casterDeps = null
		// La clé antidote reste portée par le nœud (FinalCell et les enfants la lisent), mais aucun
		// terme de cette famille n'en dépend.
		node.POISON_KEY = poisonKeyOnNode(node, State)
		var nBase = node.BASE_HASH
		var nCtx = node.CONTEXT_BY_SIDE
		var nHfp = node.HFP_BY_SIDE

		var delta = 0
		var termsPatch = [: ]
		node.TERMS_PARENT = ParentTermNode

		if (!hasDirtyCasters && healChanged == null) {
			for (var e: var stat in node.LOCAL_TERM_DIRTY) {
				delta += termDelta(e, stat, State, termsPatch, ParentTermNode, healMap, MySide, nBase, nCtx, nHfp)
			}
		} else {
			for (var e: var stat in State) {
				if (stat.LIFE <= 0 && !(e in cloned)) continue
				if (e in node.LOCAL_TERM_DIRTY) {
					delta += termDelta(e, stat, State, termsPatch, ParentTermNode, healMap, MySide, nBase, nCtx, nHfp)
					continue
				}
				// Me ne lit ni danger ni soins projetés : seul son masque local peut le salir.
				if (e == Me) continue
				var globalDirty = healChanged != null && stat.SIDE in healChanged
				if (!globalDirty && hasDirtyCasters) {
					if (casterDeps == null) casterDeps = buildCasterDeps(node, State)
					globalDirty = dangerAffectsCell(casterDeps, stat.SIDE, stat.CELL)
				}
				if (!globalDirty) continue
				delta += termDelta(e, stat, State, termsPatch, ParentTermNode, healMap, MySide, nBase, nCtx, nHfp)
			}
		}
		// Issue : relue seulement quand un poireau meurt dans ce nœud.
		for (var e: var stat in node.LOCAL_TERM_DIRTY) {
			if (stat.LIFE > 0 || stat.IS_SUMMON) continue
			var newOutcome = outcomeOf(State, MySide)
			var oldOutcome = termOf(ParentTermNode, V3_OUTCOME_ID)
			if (newOutcome != oldOutcome) {
				termsPatch[V3_OUTCOME_ID] = newOutcome
				delta += newOutcome - oldOutcome
			}
			break
		}
		if (hasDirtyCasters) node.DANGER_DIRTY_CASTERS = null
		node.TERMS = termsPatch
		BenchOps.Stop("Scoring")
		return ParentScore + delta - ((node.ACTION.Item in CAST_COST) ? CAST_COST[node.ACTION.Item] : 0)
	}

	/*
	 * Descripteurs des casters sales, à plat : [ancienCamp, ancienneMap, nouveauCamp,
	 * nouvelleMap, ...]. Une map nulle = le caster ne menaçait (ou ne menace) personne.
	 */
	static buildCasterDeps(node, State) {
		var deps = []
		var cloned = node.CLONED
		for (var caster: var _d in node.DANGER_DIRTY_CASTERS) {
			var oldStat = cloned[caster]
			var newStat = State[caster]
			var oldKey = (oldStat != null && oldStat.LIFE > 0) ? DangerPlanClass.mapCellItemAoeKeyOf(oldStat) : null
			var newKey = (newStat.LIFE > 0) ? DangerPlanClass.mapCellItemAoeKeyOf(newStat) : null
			var oldMap = null
			var newMap = null
			if (oldKey != null && oldKey == newKey) {
				oldMap = DangerPlanClass.offensiveCoverageOf(oldStat, caster, oldKey)
				newMap = oldMap
			} else {
				if (oldKey != null) oldMap = DangerPlanClass.offensiveCoverageOf(oldStat, caster, oldKey)
				if (newKey != null) newMap = DangerPlanClass.offensiveCoverageOf(newStat, caster, newKey)
			}
			push(deps, (oldMap == null) ? -1 : oldStat.SIDE)
			push(deps, oldMap)
			push(deps, (newMap == null) ? -1 : newStat.SIDE)
			push(deps, newMap)
		}
		return deps
	}

	/*
	 * Une cible de camp TargetSide, à la cellule Cell, dépend-elle d'un caster sale ? Union de
	 * l'ancienne et de la nouvelle couverture ; prédicat conservateur.
	 */
	static dangerAffectsCell(Deps, TargetSide, Cell) {
		var n = count(Deps)
		for (var i = 0; i < n; i += 4) {
			var oldMap = Deps[i + 1]
			if (oldMap != null && TargetSide != Deps[i] && (Cell in oldMap)) return true
			var newMap = Deps[i + 3]
			if (newMap != null && TargetSide != Deps[i + 2] && (Cell in newMap)) return true
		}
		return false
	}

	/* newTerm(e) − oldTerm(e) ; le nouveau terme n'est écrit que dans le patch du nœud. */
	static termDelta(e, stat, State, termsPatch, ParentTermNode, healMap, MySide, NodeBaseHash, NodeContext, NodeHfp) {
		var newTerm = 0
		if (stat.LIFE > 0) {
			var net = 0
			if (e != Me) net = DeltaClass.netOf(e, stat, State, NodeBaseHash, NodeContext, NodeHfp, healMap)
			newTerm = entityTerm(e, stat, net, MySide)
		}
		var oldTerm = termOf(ParentTermNode, e)
		termsPatch[e] = newTerm
		return newTerm - oldTerm
	}

	/*
	 * Terme courant d'une entité dans la chaîne de snapshots : le patch le plus proche gagne, la
	 * racine porte la map complète, absente partout -> 0.
	 */
	static termOf(termNode, entityId) {
		var n = termNode
		while (n != null) {
			if (entityId in n.TERMS) return n.TERMS[entityId]
			n = n.TERMS_PARENT
		}
		return 0
	}

	/*
	 * Perte de valeur de Me s'il encaissait `net` à sa cellule finale, jamais négative.
	 * La valeur sans danger est invariante sur tout un balayage : elle arrive déjà calculée.
	 */
	static exposureLoss(MyStats, safeTerm, net, MySide) {
		var loss = V3_K_EXPOSURE * (safeTerm - entityTerm(Me, MyStats, net, MySide))
		return loss > 0 ? loss : 0
	}

	/*
	 * Classe les morts alliés pour la résurrection : la valeur qu'aurait le ressuscité, sans
	 * pression, avec les arrondis moteur de la vie rendue.
	 */
	static getResurrectionScore(entity_state, State) {
		prepareTurn(State)
		var reviveTL = ResurrectionClass.reviveTotalLife(entity_state.TOTAL_LIFE, State)
		var reviveLife = ResurrectionClass.reviveLife(reviveTL)
		return (V3_WORTH_ALLIES ? worthOf(entity_state.ID, entity_state) : 1) * (V3_K_HP_ALLY * reviveLife
				+ (entity_state.IS_SUMMON ? V3_K_PRESENCE_SUMMON + V3_K_ALIVE_SUMMON : V3_K_PRESENCE_LEEK + V3_K_ALIVE_LEEK) * reviveTL)
			+ (entity_state.IS_SUMMON ? V3_K_OUTPUT_PRESENCE_SUMMON + V3_K_OUTPUT_SUMMON : V3_K_OUTPUT_ALLY) * OutputClass.of(entity_state)
	}

	/*
	 * Clé de couverture antidote : aucun terme de cette famille ne la lit, mais le Node la
	 * patche, et FinalCell l'emploie dans sa clé de mémo. Mêmes définitions qu'avant.
	 */
	static anyAntidote(State) {
		if (ANY_ANTIDOTE == null) {
			ANTIDOTE_CARRIER_IDS = []
			ANTIDOTE_CARRIER_SET = [: ]
			for (var e: var stat in State) {
				if (StateClass.hasInventoryItem(stat, CHIP_ANTIDOTE)) {
					push(ANTIDOTE_CARRIER_IDS, e)
					ANTIDOTE_CARRIER_SET[e] = true
				}
			}
			ANY_ANTIDOTE = count(ANTIDOTE_CARRIER_IDS) > 0
			ME_HAS_ANTIDOTE = Me in ANTIDOTE_CARRIER_SET
		}
		return ANY_ANTIDOTE
	}

	static poisonKeyFromFold(State, BaseHash, FoldOthers) {
		var key = BaseHash ^ MY_REPLAN_CELL_HASH ^ FoldOthers
		var meStat = State[Me]
		if (meStat.LIFE <= 0) return key ^ POISON_ME_DEAD_SALT
		if (ME_HAS_ANTIDOTE) key ^= carrierContribOf(meStat, Me)
		return key
	}

	static carrierContribOf(stat, id) {
		var contrib = stat.PKEY_MEMO
		if (contrib == null) {
			contrib = mix64((id << 20) | (max(0, stat.TOTAL_MP) << 10) | min(1023, StateClass.cooldownOf(stat, CHIP_ANTIDOTE)))
			stat.PKEY_MEMO = contrib
		}
		return contrib
	}

	static carrierFoldOthers(State) {
		if (!anyAntidote(State)) return 0
		var fold = 0
		for (var e in ANTIDOTE_CARRIER_IDS) {
			if (e == Me) continue
			var s = State[e]
			if (s.LIFE > 0) fold ^= carrierContribOf(s, e)
		}
		return fold
	}

	static poisonKeyOnNode(node, State) {
		if (ANY_ANTIDOTE != true) return 0
		return poisonKeyFromFold(State, node.BASE_HASH, node.POISON_FOLD)
	}

	/*
	 * MAJORANT du gain d'une action, calculé SANS la simuler. CONTRAT : toujours >= au Δ réel.
	 * Tout ce qui n'est pas borné rend BOUND_MUST_SIMULATE : item qui n'est pas que des dégâts
	 * directs sur ennemi, allié touché, cible tuée, plantes réveillables, passif de critique.
	 *
	 * Par cible ennemie touchée sans être tuée, seul SON terme bouge — le danger et les soins
	 * projetés des autres ne lisent pas sa vie :
	 *   - PV présents : baissent au plus des dégâts, plus l'érosion quand la vie était au plafond ;
	 *   - survie : dans [0, 1], ne peut que baisser (moins de PV, pression non décroissante), sa
	 *     part vaut au plus poids · K_ALIVE · vie max + K_OUTPUT · production.
	 * Pour Me, le vol de vie monte ses PV présents et sa survie, bornés de la même façon.
	 * Me n'est borné que depuis une cellule de marche (voir BFS) : saut et téléportation posent
	 * sur lui des valeurs que cette formule ignore.
	 */
	static actionUpperBound(Item, From, To, State, MySide, BaseHash) {
		var Infos = ITEMINFO[Item]
		if (!Infos.IS_BOUNDABLE_DAMAGE) return BOUND_MUST_SIMULATE
		var MyStats = State[Me]
		if (!mapIsEmpty(PLANT_ZONE_BY_ID) && From != MyStats.CELL && AwakeningClass.livingZones(State) != null) return BOUND_MUST_SIMULATE
		if ((MyStats.SPECIAL_WEAPON & SPW_UNSTABLE_DESTROYER) && MyStats.LIFE < MyStats.TOTAL_LIFE) return BOUND_MUST_SIMULATE
		prepareTurn(State)
		// Jet maximal compté deux fois, critique supposé, force plancherée, puissance non plancherée.
		var gainFactor = (1 + max(0, MyStats.STRENGTH) / 100) * (1 + MyStats.POWER / 100) * CRITICAL_FACTOR
		var raw = 0
		var nEff = 0
		for (var eff in Infos.EFFECTS) {
			raw += eff[1] + eff[2]
			nEff++
		}
		raw = raw * gainFactor
		var Targets = ConsequencesClass.ConsequenceTargets(Item, From, To, State, Me, BaseHash)
		var bound = 0
		var stealFactor = EntityStateClass.hasState(MyStats, STATE_UNHEALABLE) ? 0 : max(0, MyStats.WISDOM) / 1000
		var stolen = 0
		for (var tar: var dist in Targets) {
			var stat = State[tar]
			if (stat == null || stat.LIFE <= 0) continue
			if (stat.SIDE == MySide) {
				if (tar != Me) return BOUND_MUST_SIMULATE
				continue
			}
			var relFactor = 1 - stat.RELATIVE_SHIELD / 100
			if (relFactor < 0) relFactor = 0
			var absShield = stat.ABSOLUTE_SHIELD
			var dealt = raw * AOE_FALLOFF[dist] * relFactor - (absShield > 0 ? absShield : nEff * absShield) + nEff
			if (dealt <= 0) continue
			if (dealt >= stat.LIFE) return BOUND_MUST_SIMULATE
			var out = OutputClass.of(stat)
			if (tar in PLANT_ZONE_BY_ID) out *= V3_K_PLANT_OUTPUT
			// Pente du stock <= 1 + c ; l'érosion baisse en plus la vie max, ce qui retire au plus
			// c · érosion : (1 + EROSION_CRIT) · (1 + 2c) couvre les deux.
			bound += worthOf(tar, stat) * (V3_K_HP_ENEMY * dealt * (1 + EROSION_CRIT) * (1 + 2 * max(0, V3_HP_CONCAVITY))
					+ (stat.IS_SUMMON ? V3_K_ALIVE_SUMMON : V3_K_ALIVE_LEEK) * stat.TOTAL_LIFE
					+ max(0, stat.IS_SUMMON ? V3_K_PRESENCE_SUMMON : V3_K_PRESENCE_LEEK) * EROSION_CRIT * dealt)
				+ (stat.IS_SUMMON ? V3_K_OUTPUT_SUMMON : V3_K_OUTPUT_ENEMY) * out
			if (V3_K_IDLE_HOT > 0 && stat.HEAL_OVER_TIME > 0) bound += V3_K_IDLE_HOT * dealt
			stolen += dealt * stealFactor
		}
		var room = MyStats.TOTAL_LIFE - MyStats.LIFE
		if (stolen > 0 && room > 0) {
			if (stolen > room) stolen = room
			var myOut = OutputClass.of(MyStats)
			bound += (V3_WORTH_ALLIES ? worthOf(Me, MyStats) : 1) * (V3_K_HP_ALLY * stolen * (1 + max(0, V3_HP_CONCAVITY))
					+ (MyStats.IS_SUMMON ? V3_K_ALIVE_SUMMON : V3_K_ALIVE_LEEK) * MyStats.TOTAL_LIFE)
				+ (MyStats.IS_SUMMON ? V3_K_OUTPUT_SUMMON : V3_K_OUTPUT_ALLY) * myOut
			// Le vol de vie peut aussi faire déborder mon soin continu, donc monter ma garde.
			if (V3_K_IDLE_HOT > 0 && MyStats.HEAL_OVER_TIME > 0) bound += V3_K_IDLE_HOT * stolen
			// Condamné par ses flux, Me valait 0 : sa présence revient avec lui.
			bound += (V3_WORTH_ALLIES ? worthOf(Me, MyStats) : 1) * max(0, MyStats.IS_SUMMON ? V3_K_PRESENCE_SUMMON : V3_K_PRESENCE_LEEK) * MyStats.TOTAL_LIFE
				+ (MyStats.IS_SUMMON ? max(0, V3_K_OUTPUT_PRESENCE_SUMMON) : 0) * myOut
		}
		if (V3_K_HP_ENEMY < 0 || V3_K_HP_ALLY < 0) return BOUND_MUST_SIMULATE
		return bound
	}
}
