/**
 * Scoring Module: Dynamic Indexed Scoring
 * Calcule dynamiquement l'importance de chaque entité
 **/

include("../includes.leek")

global MeanBulbs = [
    CHIP_ROCKY_BULB,
    CHIP_ICED_BULB,
    CHIP_FIRE_BULB,
    CHIP_WIZARD_BULB,
    CHIP_TACTICIAN_BULB,
    CHIP_LIGHTNING_BULB
]

class ScoringClass {

    static getStateScore(State, MySide, BaseHash) {
        // Pré-calcul des contextes de danger par camp (Side)
        var allSides = [: ]
        for (var e: var s in State)
            if (s.LIFE > 0) allSides[s.SIDE] = true

        var enemyContextsBySide = [: ]
        for (var side: var _ in allSides) {
            var h = (OFFSET_BASIS ^ BaseHash)
            for (var e: var stat in State) {
                if (stat.LIFE <= 0 || stat.SIDE == side) continue
                // On inclut STR, MAG, MP, TP, POW (pour Danger)
                var Hiscombined = (stat.STRENGTH << 48) | (stat.MAGIC << 36) | (stat.MP << 24) | (stat.TP << 12) | stat.POWER
                h = addValueToBinHash(h, Hiscombined)
            }
            enemyContextsBySide[side] = h
        }

        var _score = 0
        for (var e: var stat in State) {
            if (stat.LIFE > 0) {
                var is_ally = (stat.SIDE == MySide)
                var enemyContext = enemyContextsBySide[stat.SIDE]

                // --- ULTIMATE HASH PER ENTITY ---
                // ID (10b) | CELL (10b) | SIDE (3b) | LIFE (15b) | TP (8b) | MP (8b) | STATIC (1b)
                var w1 = (stat.ID << 55) | (stat.CELL << 45) | (stat.SIDE << 42) | (stat.LIFE << 27) | (stat.TP << 19) | (stat.MP << 11) | (stat.STATIC ? 1 : 0)
                // STR (12b) | WIS (12b) | AGI (12b) | RES (12b) | SCI (12b)
                var w2 = (stat.STRENGTH << 52) | (stat.WISDOM << 40) | (stat.AGILITY << 28) | (stat.RESISTANCE << 16) | stat.SCIENCE
                // MAG (12b) | POW (12b) | ABS_SHIELD (16b) | REL_SHIELD (16b)
                var w3 = (stat.MAGIC << 44) | (stat.POWER << 32) | (stat.ABSOLUTE_SHIELD << 16) | stat.RELATIVE_SHIELD
                // TOTAL_LIFE (15b) | DR (10b) | CD_ANTIDOTE (4b) | POISON (16b) | POT (16b)
                var w4 = (stat.TOTAL_LIFE << 46) | (stat.DAMAGE_RETURN << 36) | (stat.COOLDOWNS[CHIP_ANTIDOTE] << 32) | (stat.POISON << 16) | stat.POISON_OVER_TIME

                var h_final = addValueToBinHash(addValueToBinHash(addValueToBinHash(addValueToBinHash(enemyContext, w1), w2), w3), w4)

                if (h_final in ENTITY_ULTIMATE_SCORE_CACHE) {
                    var cachedVal = ENTITY_ULTIMATE_SCORE_CACHE[h_final]
                    _score += is_ally ? cachedVal : -cachedVal
                    continue
                }

                var entity_value = getEntityIntrinsicScore(stat, State)
                var shieldCombined = (stat.ABSOLUTE_SHIELD << 30) | (stat.RELATIVE_SHIELD << 15) | stat.COOLDOWNS[CHIP_ANTIDOTE]
                var thisStatsHashForDanger = addValueToBinHash(enemyContext, shieldCombined)

                var danger = DangerClass.getEntityDanger(stat, State, e, BaseHash, thisStatsHashForDanger)

                // On applique les multiplicateurs au score intraseque
                var SurvivalMultiplier = getSurvivalMultiplier(stat, danger)
                var DistanceMultiplier = e == Me ? SCORE_DEFAULT_MULTIPLIER : getDistMultiplier(stat.ID, stat.SIDE, stat.CELL, State, BaseHash)
                var ShieldAndDRMultiplier = getShieldAndDRMultiplier(stat, danger, SurvivalMultiplier)

                var finalValue = entity_value * SurvivalMultiplier * DistanceMultiplier * ShieldAndDRMultiplier

                ENTITY_ULTIMATE_SCORE_CACHE[h_final] = finalValue
                _score += is_ally ? finalValue : -finalValue
            }
        }
        return _score
    }

    static getShieldAndDRMultiplier(stat, danger, SurvivalMultiplier) {
        var absBonus = solvePoly(POLY_ABS_SHIELD_BASE, stat.ABSOLUTE_SHIELD)
        var relBonus = solvePoly(POLY_REL_SHIELD_BASE, stat.RELATIVE_SHIELD)
        
        // 1. Dissuasion pure (la simple présence de la stat)
        var baseDRBonus = solvePoly(POLY_DAMAGE_RETURN, stat.DAMAGE_RETURN)
        
        // 2. Dégâts concrets renvoyés (sur le danger brut, sans limite de vie car l'overkill est infligé à l'attaquant)
        var activeDR = danger * (stat.DAMAGE_RETURN / 100)
        var activeDRBonus = solvePoly(POLY_DAMAGE_RETURN_ACTIVE, activeDR)
        
        // 3. Facteur de désespoir (Plus la mort est proche, plus le renvoi est inestimable comme bouclier dissuasif absolu)
        var despairFactor = 1.0 - SurvivalMultiplier
        var despairDRBonus = solvePoly(POLY_DAMAGE_RETURN_DESPAIR, activeDR * despairFactor)
        
        return SCORE_SHIELD_DR_BASE + absBonus + relBonus + baseDRBonus + activeDRBonus + despairDRBonus
    }

    static getResurrectionScore(entity_state, State) {
        var ThisHash = entity_state.ID
        if (ThisHash in RESURRECTION_SCORE_CACHE) return RESURRECTION_SCORE_CACHE[ThisHash]

        var v_stat = clone(entity_state, 3)
        var v_State = clone(State, 4)
        v_State[v_stat.ID] = v_stat

        v_stat.TOTAL_LIFE /= 2
        v_stat.LIFE = v_stat.TOTAL_LIFE / 2
        v_stat.POISON_OVER_TIME = 0
        v_stat.JUST_POISON = 0
        v_stat.POISON = 0
        v_stat.JUST_POISON_OVER_TIME = 0

        v_stat.TP = v_stat.TOTAL_TP
        v_stat.MP = v_stat.TOTAL_MP
        v_stat.ABSOLUTE_SHIELD = 0
        v_stat.RELATIVE_SHIELD = 0
        v_stat.DAMAGE_RETURN = 0

        var result = getEntityIntrinsicScore(v_stat, v_State)
        RESURRECTION_SCORE_CACHE[ThisHash] = result
        return result
    }

    static getEntityIntrinsicScore(EntityStats, State) {
        // Word 1 (58 bits) : ID (10b) | Power (12b) | TotalTP (10b) | Strength (12b) | Wisdom (12b)
        var combined1 = (EntityStats.ID << 46) | (EntityStats.POWER << 34) | (EntityStats.TOTAL_TP << 24) | (EntityStats.STRENGTH << 12) | EntityStats.WISDOM
        // Word 2 (63 bits) : Agility (12b) | Resistance (12b) | Science (12b) | Magic (12b) | TotalLife (15b)
        var combined2 = (EntityStats.AGILITY << 51) | (EntityStats.RESISTANCE << 39) | (EntityStats.SCIENCE << 27) | (EntityStats.MAGIC << 15) | EntityStats.TOTAL_LIFE
        // Word 3 : MP (10b) | STATIC (1b) | SIDE (4b)
        var combined3 = (EntityStats.TOTAL_MP << 5) | (EntityStats.STATIC ? 1 : 0) << 4 | EntityStats.SIDE

        var Hash = addValueToBinHash(addValueToBinHash(addValueToBinHash(OFFSET_BASIS, combined1), combined2), combined3)
        if (Hash in ENTITY_INTRINSIC_SCORE_CACHE) return ENTITY_INTRINSIC_SCORE_CACHE[Hash]

        var EIndexes = EntityIndexes.getWithCache(EntityStats)
        var TeamIndexes = EnemiesTeamIndexes.getWithCache(State, EntityStats)

        var StrengthCoef = solvePoly(POLY_COEF_STR, TeamIndexes.RESISTANCE)
        var WisdomCoef = SCORE_COEF_WISDOM
        var AgilityCoef = solvePoly(POLY_COEF_AGI, TeamIndexes.STRENGTH)
        var ResistanceCoef = solvePoly(POLY_COEF_RES, TeamIndexes.STRENGTH)
        var ScienceCoef = SCORE_COEF_SCIENCE
        var MagicCoef = SCORE_COEF_MAGIC

        var _final = EIndexes.STRENGTH * StrengthCoef +
            EIndexes.WISDOM * WisdomCoef +
            EIndexes.AGILITY * AgilityCoef +
            EIndexes.RESISTANCE * ResistanceCoef +
            EIndexes.SCIENCE * ScienceCoef +
            EIndexes.MAGIC * MagicCoef

        _final *= solvePoly(POLY_BONUS_MP, EntityStats.TOTAL_MP)
        _final *= solvePoly(POLY_BONUS_CRIT, EntityStats.AGILITY)
        _final *= solvePoly(POLY_BONUS_LIFE, EntityStats.TOTAL_LIFE)

        if (EntityStats.STATIC) _final /= SCORE_STATIC_DIVISOR

        ENTITY_INTRINSIC_SCORE_CACHE[Hash] = _final
        return _final
    }

    static getSurvivalMultiplier(stat, danger) {
        // Optimisation : On pack 3 valeurs dans le premier mot (48 bits total)
        // Danger (16 bits) | Life (16 bits) | TotalLife (16 bits)
        var combined1 = (danger << 32) | (stat.LIFE << 16) | stat.TOTAL_LIFE

        // On pack les poisons dans le second mot (32 bits total)
        var combined2 = (stat.POISON << 16) | stat.POISON_OVER_TIME

        var ThisHash = addValueToBinHash(addValueToBinHash(OFFSET_BASIS, combined1), combined2)

        if (ThisHash in SURVIVAL_MULTIPLIER_CACHE) return SURVIVAL_MULTIPLIER_CACHE[ThisHash]

        // 1. Calcul de la menace pondérée via polynômes
        var totalThreat = solvePoly(POLY_THREAT_DANGER, danger) +
            solvePoly(POLY_THREAT_POISON, stat.POISON) +
            solvePoly(POLY_THREAT_POT, stat.POISON_OVER_TIME)

        // 2. Calcul du ratio de santé prédictif
        var survivalRatio = (stat.LIFE - totalThreat) / stat.TOTAL_LIFE

        // 3. Application du polynôme de survie
        var result = max(SCORE_SURVIVAL_MIN_VALUE, solvePoly(POLY_SURVIVAL, survivalRatio)) //to Avoid having a negative ratio

        SURVIVAL_MULTIPLIER_CACHE[ThisHash] = result
        return result
    }

    static getDistMultiplier(id, side, cell, State, BaseHash) {
        var ThisHash = addValueToBinHash((OFFSET_BASIS ^ BaseHash), (cell << 32) | id)
        if (ThisHash in DIST_MULTIPLIER_CACHE) return DIST_MULTIPLIER_CACHE[ThisHash]

        var allyRelSum = 0,
            allyWeight = 0
        var enemyRelSum = 0,
            enemyWeight = 0

        for (var e: var other in State) {
            if (other.LIFE > 0 && other.ID != id && e != Me) {
                var dist = CellClass.getDist(cell, other.CELL)
                var otherValue = getEntityIntrinsicScore(other, State)

                if (other.SIDE == side) {
                    // Score de COHÉSION
                    allyRelSum += otherValue * solvePoly(POLY_DIST_RELATION_ALLY, dist)
                    allyWeight += otherValue
                } else {
                    // Score d'ENGAGEMENT
                    enemyRelSum += otherValue * solvePoly(POLY_DIST_RELATION_ENEMY, dist)
                    enemyWeight += otherValue
                }
            }
        }
        // 1. On calcule les moyennes séparément
        // Si on est seul (ex: fin de game), on met 1.0 pour ne pas impacter le score
        var allyScore = (allyWeight > 0) ? (allyRelSum / allyWeight) : 1.0
        var enemyScore = (enemyWeight > 0) ? (enemyRelSum / enemyWeight) : 1.0

        // 2. On fusionne les deux (50/50 ou avec des coefficients de priorité)
        // Ici, l'importance des alliés vs ennemis est ÉQUILIBRÉE peu importe leur nombre
        var avgRelation = (allyScore + enemyScore) / 2.0

        var result = max(SCORE_DIST_MIN_VALUE, solvePoly(POLY_DIST_FINAL, avgRelation))
        DIST_MULTIPLIER_CACHE[ThisHash] = result
        return result
    }

    static solvePoly(poly, x) {
        return poly[0] * x * x + poly[1] * x + poly[2]
    }
}