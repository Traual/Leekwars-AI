/**
 * Scoring v3 — full rewrite. ONE currency: HP. Readable, hand-tunable.
 *
 * Per ALIVE entity, a SURVIVAL value (kill base + concave, threat-pressured life):
 *   afterPoison = max(0, LIFE − COEF_POISON·POISON)                  // certain next-turn poison tick
 *   pressure    = (DANGER_WEIGHT·danger + COEF_POT·POISON_OVER_TIME) // relative threats (never drowned)
 *               / (afterPoison + BUFFER)
 *   effLife     = afterPoison · exp(−pressure)                       // >0, monotone, threat-scaled
 *   value       = BASE_ALIVE + W_LIFE · pow(effLife, CONCAVITY)      // CONCAVITY<1 → low life matters more
 * score = Σ sign(e) · value(e).  sign = +1 my side, −1 enemy. Dead entities contribute 0.
 * Same treatment for both sides (sign flips it).
 *
 * Properties this gives (all wanted):
 *  - value ≥ BASE_ALIVE > 0, dead = 0 → a KILL is always worth ≥ BASE_ALIVE (monotone,
 *    never indifferent).
 *  - +life → +value, +poison → −value, +danger → −value, each with a STRICTLY non-zero
 *    delta (no flat region).
 *  - Threats (danger, total poison) are RELATIVE to remaining life, so a 10000 danger on a
 *    1000-life target still bites hard instead of being drowned — and they hit a wounded
 *    target much harder (the pressure denominator shrinks).
 *  - CONCAVE in life: the marginal value of a HP rises as life drops → finishing a wounded
 *    target is worth more than chipping a healthy one (focus-fire).
 *
 * Roadmap (NOT yet active): support (heal/buff potential), positioning/cover, turn-64
 * tiebreak, per-entity capital weight. POISON tick uses raw POISON; an antidote/liberation-
 * cooldown-aware refinement of the poison/POT weighting is a later TODO.
 **/

include("../includes.leek")

class ScoringClass {

    /**
     * State value : Σ sign · survivalValue(e). `danger` is the existing cached post-shield
     * incoming estimate (used in the threat pressure, both sides).
     */
    static getStateScore(State, MySide, BaseHash) {
        BenchOps.Start("Scoring")
        var _score = 0
        for (var e: var stat in State) {
            if (stat.LIFE <= 0) continue
            var sign = (stat.SIDE == MySide) ? 1 : -1

            var danger = 0
            if (DANGER_WEIGHT != 0) {
                var statsHash = DangerClass.getStatsHashForDanger(stat, State)
                danger = DangerClass.getEntityDanger(stat, State, e, BaseHash, statsHash)
            }

            // Certain next-turn poison tick removed up front; danger + total poison enter as
            // a pressure relative to the remaining life (so big threats are never drowned).
            var afterPoison = max(0, stat.LIFE - COEF_POISON * stat.POISON)
            var pressure = (DANGER_WEIGHT * danger + COEF_POT * stat.POISON_OVER_TIME) / (afterPoison + BUFFER)
            var effLife = afterPoison * exp(-pressure)

            // Kill base + concave life (low life worth more per HP → push to finish).
            var value = BASE_ALIVE + W_LIFE * pow(effLife, CONCAVITY)

            _score += sign * value
        }
        BenchOps.Stop("Scoring")
        return _score
    }

    /**
     * Value used by Modifier/Resurrection.leek to rank WHICH dead ally to revive.
     * Resurrected life = TOTAL_LIFE/4 (Update halves TOTAL_LIFE, LIFE = half of that).
     * Monotone in TOTAL_LIFE → revive the biggest leek first.
     */
    static getResurrectionScore(entity_state, State) {
        return entity_state.TOTAL_LIFE / 4
    }
}
