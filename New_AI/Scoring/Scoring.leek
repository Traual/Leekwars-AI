/**
 * Scoring v3 — full rewrite. ONE currency: HP. Readable, hand-tunable.
 *
 * Per ALIVE entity, a SURVIVAL value (kill base + concave, threat-pressured life):
 *   afterPoison = max(0, LIFE − COEF_POISON·POISON)                  // certain next-turn poison tick
 *   pressure    = (DANGER_WEIGHT·danger + COEF_POT·POISON_OVER_TIME) // relative threats (never drowned)
 *               / (afterPoison + BUFFER)
 *   effLife     = afterPoison / (1 + pressure)                       // >0, monotone, threat-scaled (cheap)
 *   value       = BASE_ALIVE + W_LIFE·sqrt(effLife) + W_TOTAL_LIFE·sqrt(TOTAL_LIFE)   // concave × 2
 * term(e) = sign · (importance(e)·value(e) + capability(e)) — importance FROZEN per turn (tier
 * ranking), capability = the small LIVE quadratic buff/debuff channel (see Importance.leek).
 * score = Σ term(e).  sign = +1 my side, −1 enemy. Dead entities contribute 0.
 * Same treatment for both sides (sign flips it).
 *
 * Properties: value ≥ BASE_ALIVE > 0, dead = 0 → kill always worth ≥ BASE_ALIVE (monotone);
 * +life/+poison/+danger each give a strictly non-zero delta; danger & total poison are
 * RELATIVE to remaining life (never drowned, hit a wounded target harder); sqrt is concave
 * (low life worth more per HP → finish wounded); 1/(1+pressure) gives diminishing returns
 * on danger. Cheap ops: 1/(1+pressure) replaces exp, sqrt replaces pow(.,0.7).
 *
 * Two op-caches:
 *  - survivalValue() is cached in SURVIVAL_CACHE (reset per turn) by a single packed 64-bit
 *    key: LIFE (bits 48-63, 16b) | POISON (bits 34-47, 14b) | POT (bits 17-33, 17b) |
 *    danger (bits 0-16, 17b). Bit-ops truncate the floats to int (verified), so no round()
 *    is needed. POISON / POT are masked because they can be NEGATIVE (net heal) — a raw
 *    negative would sign-extend and erase the higher fields through the OR. danger is masked
 *    to its slot too: overkill nets are uncapped and can exceed 16 bits (17 bits = 131k
 *    covers any realistic focus); POT gets 17 bits (documented up to 100k > 16 bits).
 *  - the danger "opposing-team context" hash is precomputed once PER SIDE (contextBySide,
 *    supports any number of teams: a side's context = every entity NOT on that side); each
 *    entity then only adds its own shields to its side's context.
 *
 * Roadmap (NOT yet active): per-entity "capital" (what it brings — offensive/support power,
 * fixes the Δ=0 buff problem), support (heal/buff), positioning/cover, turn-64 tiebreak.
 **/

include("../includes.leek")

class ScoringClass {

    /**
     * State value : Σ sign · (importance(e)·survivalValue(e, netDamage) + capability(e)). The
     * per-entity net damage (danger cushioned by heal, sequenced by turn order) is owned by
     * DeltaClass; importance is frozen per turn, capability is the live buff channel.
     */
    static getStateScore(State, MySide, BaseHash, contextBySide) {
        BenchOps.Start("Scoring")
        var netDamageMap = DeltaClass.getNetDamageMap(State, BaseHash, contextBySide)
        var _score = 0
        for (var e: var stat in State) {
            if (stat.LIFE <= 0) continue
            var sign = (stat.SIDE == MySide) ? 1 : -1
            _score += sign * (ImportanceClass.get(stat) * survivalValue(stat, netDamageMap[e]) + ImportanceClass.capability(stat))
        }
        BenchOps.Stop("Scoring")
        return _score
    }

    /* Full terms map [entityId -> SIGNED term] (sign folded in: +ally / -enemy — SIDE is
     * fight-constant). score == sumTerms(map). Used at the BFS root (and the Node summon-patch
     * assert fallback rebuilds hashes only — its terms go through the incremental path). */
    static buildTermsMap(State, MySide, BaseHash, contextBySide) {
        BenchOps.Start("Scoring")
        var netDamageMap = DeltaClass.getNetDamageMap(State, BaseHash, contextBySide)
        var terms = [: ]
        for (var e: var stat in State) {
            if (stat.LIFE <= 0) continue
            var sign = (stat.SIDE == MySide) ? 1 : -1
            terms[e] = sign * (ImportanceClass.get(stat) * survivalValue(stat, netDamageMap[e]) + ImportanceClass.capability(stat))
        }
        BenchOps.Stop("Scoring")
        return terms
    }

    static sumTerms(terms) {
        var s = 0
        for (var e: var t in terms) s += t
        return s
    }

    /* Phase 4a/4b — INCREMENTAL score: score(child) = score(parent) + Δ over the recompute set R.
     * R = node.CLONED (the exact mutated set, always contains Me — and the newborn bulb / revived
     * entity since Phase 4b) ∪ every alive entity of a side whose DANGER inputs
     * (CONTEXT_BY_SIDE[side]) or HEAL inputs (HFP_BY_SIDE[side]) changed vs the parent — detection
     * is purely DATA-driven (hash compares), no effect table. Summon/resurrect nodes take this very
     * path too (the retired FULL_REBUILD fallback is gone): a summon flips the OPPOSING sides'
     * context -> all their alive entities recompute (real work: the bulb genuinely adds threat),
     * allies are skipped, termDelta 0-defaults the newborn's old term.
     * Old terms come from the parent's carried node.TERMS (cloned ~12 ops + patched) — benched
     * +5.7% Scoring CHEAPER than recomputing them on demand (the retired delta-only variant). */
    static getStateScoreFromParent(node, ParentScore, ParentTerms, ParentContext, ParentHfp, MySide) {
        BenchOps.Start("Scoring")
        var State = node.END_STATS
        var cloned = node.CLONED
        var hfpMap = node.HFP_BY_SIDE

        // Child heal map by the carried fingerprints (hit unless a healer changed on this branch).
        // HEAL_MAP_CACHE is keyed by the COMBINED all-sides fold (enemy heals modeled).
        var combinedHfp = 0
        for (var s: var h in hfpMap) combinedHfp ^= h
        var healMap = HealClass.getHealMapByFp(State, combinedHfp)

        // Which sides' danger inputs changed vs the parent?
        var dangerChanged = null   // null = none (the common case: Me moved / self-buff / non-lethal hit)
        for (var s: var h in node.CONTEXT_BY_SIDE) {
            if (ParentContext[s] != h) {
                if (dangerChanged == null) dangerChanged = [: ]
                dangerChanged[s] = true
            }
        }
        // Which sides' heal inputs changed? 0-defaulted compare (a side with no healers is ABSENT
        // from its map). INVARIANT: the patch only ever ADDS keys, never removes them, so the child
        // map ⊇ the parent map — iterating the child covers every possible change.
        var healChanged = null
        for (var s: var h in hfpMap) {
            if (((s in ParentHfp) ? ParentHfp[s] : 0) != h) {
                if (healChanged == null) healChanged = [: ]
                healChanged[s] = true
            }
        }

        var delta = 0
        var terms = clone(ParentTerms, 1)

        if (dangerChanged == null && healChanged == null) {
            // Common case: only the cloned entities can have a changed term.
            for (var e: var _c in cloned) {
                delta += termDelta(e, State, node, terms, healMap, MySide)
            }
        } else {
            // Cascade: entities of an affected side are recomputed too (their ndKey misses anyway —
            // that recompute is REAL work that exists today as well; only the detection is new).
            for (var e: var stat in State) {
                if ((e in cloned)
                    || (dangerChanged != null && stat.SIDE in dangerChanged)
                    || (healChanged != null && stat.SIDE in healChanged)) {
                    delta += termDelta(e, State, node, terms, healMap, MySide)
                }
            }
        }
        node.TERMS = terms
        BenchOps.Stop("Scoring")

        return ParentScore + delta
    }

    /* newTerm(e) − oldTerm(e); the old term is read from the carried map, then overwritten. */
    static termDelta(e, State, node, terms, healMap, MySide) {
        var stat = State[e]
        var newTerm = 0
        if (stat.LIFE > 0) {
            var sign = (stat.SIDE == MySide) ? 1 : -1
            newTerm = sign * (ImportanceClass.get(stat) * survivalValue(stat, DeltaClass.netOf(e, stat, State, node.BASE_HASH, node.CONTEXT_BY_SIDE, node.HFP_BY_SIDE, healMap)) + ImportanceClass.capability(stat))
        }
        var oldTerm = (e in terms) ? terms[e] : 0
        terms[e] = newTerm
        return newTerm - oldTerm
    }

    /**
     * Survival value of one entity, cached by a single packed 64-bit key. Bit-ops truncate
     * the floats to int (no round needed). POISON / POT masked because they can be negative.
     * The max-life term (W_TOTAL_LIFE·sqrt) lives OUTSIDE the cache: the key is full (16+14+
     * 17+17 bits) and has no TOTAL_LIFE slot — added after the read, sqrt ≈ 8 ops. It is the
     * erosion/nova channel: permanent, heal-proof, so a max-life chip scores on both sides.
     */
    static survivalValue(stat, danger) {
        // Max-life term memoized on the stat object (TLSQ_MEMO, nulled at the clone sites) —
        // the SURVIVAL_CACHE key is full, so this term lives outside it; the memo turns the
        // per-call sqrt (~10 ops) into a field read for every unmutated entity.
        var tlTerm = stat.TLSQ_MEMO
        if (tlTerm == null) {
            tlTerm = W_TOTAL_LIFE * sqrt(max(0, stat.TOTAL_LIFE))
            stat.TLSQ_MEMO = tlTerm
        }
        var key = (stat.LIFE << 48) | ((stat.POISON & 0x3FFF) << 34) | ((stat.POISON_OVER_TIME & 0x1FFFF) << 17) | (danger & 0x1FFFF)
        if (key in SURVIVAL_CACHE) return SURVIVAL_CACHE[key] + tlTerm

        var afterPoison = max(0, stat.LIFE - COEF_POISON * stat.POISON)
        var pressure = (DANGER_WEIGHT * danger + COEF_POT * stat.POISON_OVER_TIME) / (afterPoison + BUFFER)
        var effLife = afterPoison / (1 + pressure)
        var value = BASE_ALIVE + W_LIFE * sqrt(effLife)

        SURVIVAL_CACHE[key] = value
        return value + tlTerm
    }

    /**
     * Value used by Modifier/Resurrection.leek to rank WHICH dead ally to revive.
     * Resurrected life = TOTAL_LIFE/4 (Update halves TOTAL_LIFE, LIFE = half of that).
     * Monotone in TOTAL_LIFE → revive the biggest leek first.
     */
    static getResurrectionScore(entity_state, State) {
        return entity_state.TOTAL_LIFE / 4
    }
}
