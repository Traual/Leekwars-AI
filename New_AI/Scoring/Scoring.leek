// Score d'un état = valeur des alliés - valeur des adversaires.
// Score d'une action = score après - score avant. Le placement est évalué à la fin.
include("../includes.leek")

class ScoringClass {
    static entityValue(s) {
        if (s.LIFE <= 0) return 0
        var score = Coefficients.presence(s)
        score += s.LIFE                  * Coefficients.life(s)
        score += s.TOTAL_LIFE            * Coefficients.totalLife(s)
        score += s.STRENGTH              * Coefficients.strength(s)
        score += s.WISDOM                * Coefficients.wisdom(s)
        score += s.AGILITY               * Coefficients.agility(s)
        score += s.RESISTANCE            * Coefficients.resistance(s)
        score += s.SCIENCE               * Coefficients.science(s)
        score += s.MAGIC                 * Coefficients.magic(s)
        score += s.POWER                 * Coefficients.power(s)
        score += s.TOTAL_TP              * Coefficients.totalTP(s)
        score += s.TOTAL_MP              * Coefficients.totalMP(s)
        score += s.ABSOLUTE_SHIELD       * Coefficients.absoluteShield(s)
        score += s.RELATIVE_SHIELD       * Coefficients.relativeShield(s)
        score += s.DAMAGE_RETURN         * Coefficients.damageReturn(s)
        score += s.POISON_OVER_TIME      * Coefficients.poison(s)
        score += s.AFTEREFFECT_OVER_TIME * Coefficients.aftereffect(s)
        score += s.HEAL_OVER_TIME        * Coefficients.heal(s)
        return max(1, score) // Un allié vivant ne devient pas plus rentable mort.
    }

    static stateValue(State, MySide, OpsLimit) {
        var score = 0
        for (var id: var s in State) {
            if (getOperations() > OpsLimit) return null
            score += (s.SIDE == MySide ? 1 : -1) * entityValue(s)
        }
        return score
    }

    // Évite de relire tout le plateau : seules les entités clonées ont changé.
    static getStateScoreFromParent(node, State, ParentScore, MySide) {
        var score = ParentScore
        for (var id: var before in node.CLONED) {
            var after = State[id]
            var delta = entityValue(after) - (before == null ? 0 : entityValue(before))
            score += (after.SIDE == MySide ? 1 : -1) * delta
        }
        return score
    }

    static getResurrectionScore(entity, State) {
        var copy = clone(State, 1)
        var changed = [:]
        ResurrectionClass.Update(entity.CELL, copy, entity.ID, changed)
        return entityValue(copy[entity.ID])
    }
}
