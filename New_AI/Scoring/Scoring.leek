/**
 * Scoring v3 — full rewrite. ONE currency: HP. Readable, hand-tunable.
 *
 * Per ALIVE entity, a SURVIVAL value (kill base + concave, threat-pressured life):
 *   afterPoison = max(0, LIFE − COEF_POISON·POISON)                  // certain next-turn poison tick
 *   pressure    = (DANGER_WEIGHT·danger + COEF_POT·POISON_OVER_TIME) // relative threats (never drowned)
 *               / (afterPoison + BUFFER)
 *   effLife     = afterPoison / (1 + pressure)                       // >0, monotone, threat-scaled (cheap)
 *   value       = BASE_ALIVE + W_LIFE · sqrt(effLife)                // concave → low life matters more
 * score = Σ sign(e) · value(e).  sign = +1 my side, −1 enemy. Dead entities contribute 0.
 * Same treatment for both sides (sign flips it).
 *
 * Properties: value ≥ BASE_ALIVE > 0, dead = 0 → kill always worth ≥ BASE_ALIVE (monotone);
 * +life/+poison/+danger each give a strictly non-zero delta; danger & total poison are
 * RELATIVE to remaining life (never drowned, hit a wounded target harder); sqrt is concave
 * (low life worth more per HP → finish wounded); 1/(1+pressure) gives diminishing returns
 * on danger. Cheap ops: 1/(1+pressure) replaces exp, sqrt replaces pow(.,0.7).
 *
 * Two op-caches:
 *  - survivalValue() is cached in SURVIVAL_CACHE (reset per turn) by a single packed 64-bit
 *    key: LIFE (bits 48-63) | POISON (32-47) | POT (16-31) | danger (0-15). Bit-ops truncate
 *    the floats to int (verified), so no round() is needed. POISON / POT are masked with
 *    & 0xFFFF because they can be NEGATIVE (net heal) — a raw negative would sign-extend and
 *    erase the LIFE field through the OR. LIFE and danger are always ≥ 0 and fit in 16 bits.
 *  - the danger "opposing-team context" hash is precomputed once PER SIDE (contextBySide,
 *    supports any number of teams: a side's context = every entity NOT on that side); each
 *    entity then only adds its own shields to its side's context.
 *
 * Roadmap (NOT yet active): per-entity "capital" (what it brings — offensive/support power,
 * fixes the Δ=0 buff problem), support (heal/buff), positioning/cover, turn-64 tiebreak.
 **/

include("../includes.leek")

class ScoringClass {

    /**
     * State value : Σ sign · importance(e) · survivalValue(e, netDamage). The per-entity net damage
     * (danger cushioned by heal, sequenced by turn order) is owned by DeltaClass.
     */
    static getStateScore(State, MySide, BaseHash, node) {
        BenchOps.Start("Scoring")
        // contextBySide depends only on non-Me entities. The node inherits it from its parent unless
        // its action touched the enemy/ally context (Node.ActionToNodeInTree); build + memoize it here
        // only when the node didn't supply one (root, base nodes, or context-touching nodes).
        var contextBySide
        if (node != null && node.CONTEXT_BY_SIDE != null) {
            contextBySide = node.CONTEXT_BY_SIDE
        } else {
            contextBySide = DeltaClass.buildContextBySide(State)
            if (node != null) node.CONTEXT_BY_SIDE = contextBySide
        }
        var netDamageMap = DeltaClass.getNetDamageMap(State, BaseHash, contextBySide)
        var _score = 0
        for (var e: var stat in State) {
            if (stat.LIFE <= 0) continue
            var sign = (stat.SIDE == MySide) ? 1 : -1
            _score += sign * ImportanceClass.get(stat) * survivalValue(stat, netDamageMap[e])
        }
        BenchOps.Stop("Scoring")
        return _score
    }

    /**
     * Survival value of one entity, cached by a single packed 64-bit key. Bit-ops truncate
     * the floats to int (no round needed). POISON / POT masked because they can be negative.
     */
    static survivalValue(stat, danger) {
        var key = (stat.LIFE << 48) | ((stat.POISON & 0xFFFF) << 32) | ((stat.POISON_OVER_TIME & 0xFFFF) << 16) | danger
        if (key in SURVIVAL_CACHE) return SURVIVAL_CACHE[key]

        var afterPoison = max(0, stat.LIFE - COEF_POISON * stat.POISON)
        var pressure = (DANGER_WEIGHT * danger + COEF_POT * stat.POISON_OVER_TIME) / (afterPoison + BUFFER)
        var effLife = afterPoison / (1 + pressure)
        var value = BASE_ALIVE + W_LIFE * sqrt(effLife)

        SURVIVAL_CACHE[key] = value
        return value
    }

    /**
     * Value used by Modifier/Resurrection.leek to rank WHICH dead ally to revive.
     * Resurrected life = TOTAL_LIFE/4 (Update halves TOTAL_LIFE, LIFE = half of that).
     * Monotone in TOTAL_LIFE → revive the biggest leek first.
     */
    static getResurrectionScore(entity_state, State) {
        return entity_state.TOTAL_LIFE / 4
    }
}
