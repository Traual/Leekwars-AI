// Score d'un état = valeur des alliés - valeur des adversaires.
// Score d'une action = score après - score avant. Le placement est évalué à la fin.
include("../includes.leek")

class ScoringClass {
    static entityValue(stat) {
        if (stat.LIFE <= 0) return 0
        var score = Coefficients.presence(stat)
        score += stat.LIFE                  * Coefficients.life(stat)
        score += stat.TOTAL_LIFE            * Coefficients.totalLife(stat)
        score += max(0, stat.STRENGTH)       * Coefficients.strength(stat) // Plancher du moteur pour les dégâts.
        score += stat.WISDOM                * Coefficients.wisdom(stat)
        score += stat.AGILITY               * Coefficients.agility(stat)
        score += stat.RESISTANCE            * Coefficients.resistance(stat)
        score += stat.SCIENCE               * Coefficients.science(stat)
        score += stat.MAGIC                 * Coefficients.magic(stat)
        score += stat.POWER                 * Coefficients.power(stat)
        score += stat.TOTAL_TP              * Coefficients.totalTP(stat)
        score += stat.TOTAL_MP              * Coefficients.totalMP(stat)
        score += stat.ABSOLUTE_SHIELD       * Coefficients.absoluteShield(stat)
        score += stat.RELATIVE_SHIELD       * Coefficients.relativeShield(stat)
        score += stat.DAMAGE_RETURN         * Coefficients.damageReturn(stat)
        score += stat.POISON_OVER_TIME      * Coefficients.poison(stat)
        score += stat.AFTEREFFECT_OVER_TIME * Coefficients.aftereffect(stat)
        score += stat.HEAL_OVER_TIME        * Coefficients.heal(stat)
        return max(0, score) // Un allié vivant ne devient pas plus rentable mort.
    }

    static stateValue(State, MySide, OpsLimit) {
        var score = 0
        for (var id: var stat in State) {
            if (getOperations() > OpsLimit) return null
            score += (stat.SIDE == MySide ? 1 : -1) * entityValue(stat)
        }
        return score
    }

    // Évite de relire tout le plateau : seules les entités clonées ont changé.
    static getStateScoreFromParent(node, State, ParentScore, MySide) {
        var score = ParentScore
        for (var id: var before in node.CLONED) {
            var after = State[id]
            var delta = entityValue(after) - (before == null ? 0 : entityValue(before))
            score += (after.SIDE == MySide ? 1 : -1) * delta
        }
        return score
    }

    static getResurrectionScore(entity, State) {
        var copy = clone(State, 1)
        var changed = [:]
        ResurrectionClass.Update(entity.CELL, copy, entity.ID, changed)
        return entityValue(copy[entity.ID])
    }
}
