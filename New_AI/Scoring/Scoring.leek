/**
 * Scoring v3 — full rewrite. ONE currency: HP. Readable, hand-tunable.
 *
 * Per ALIVE entity, a TIERED value (fixed floors + a continuous remainder) :
 *   value(e) = BASE_ALIVE                                       // tier 0: alive (real-kill floor)
 *            + (LIFE > POISON          ? BASE_ALIVE_POISON : 0) // tier 1: survives next poison tick
 *            + (danger < LIFE − POISON ? BASE_ALIVE_DANGER : 0) // tier 2: survives incoming danger
 *            + max(0, eHP(e) − DANGER_WEIGHT·danger)            // continuous HP gradient, floored
 * score = Σ sign(e) · value(e).  sign = +1 my side, −1 enemy. Dead entities contribute 0.
 *
 * Why tiers: a dead entity is 0, an alive one is ≥ BASE_ALIVE, so a kill is ALWAYS worth
 * ≥ BASE_ALIVE (never indifferent / never beaten by a doomed-alive enemy → monotone). When
 * an enemy LOSES a tier (we push it toward death) the score rises by that tier's value:
 * making it poison-lethal frees BASE_ALIVE_POISON, making it danger-lethal frees
 * BASE_ALIVE_DANGER, finishing it frees BASE_ALIVE — the three "push to kill" rewards.
 * The max(0,…) floors keep each tier's minimum intact (exposure can't drag it under).
 * Because every term is ≥ 0 and BASE_ALIVE > 0, danger is monotone-safe on BOTH sides.
 *
 * Roadmap (NOT yet active): a POT-lethal tier (needs antidote/liberation cooldowns),
 * support (heal/buff potential), positioning/cover, turn-64 tiebreak, per-entity capital.
 **/

include("../includes.leek")

class ScoringClass {

    /**
     * State value : Σ sign · tieredValue(e). `danger` is the existing cached post-shield
     * incoming estimate (reused for the danger tier AND the continuous exposure).
     */
    static getStateScore(State, MySide, BaseHash) {
        BenchOps.Start("Scoring")
        var _score = 0
        for (var e: var stat in State) {
            if (stat.LIFE <= 0) continue
            var sign = (stat.SIDE == MySide) ? 1 : -1

            // Incoming danger (cached). Needed by the danger tier AND the exposure term;
            // computed unless both are disabled.
            var danger = 0
            if (DANGER_WEIGHT != 0 || BASE_ALIVE_DANGER != 0) {
                var statsHash = DangerClass.getStatsHashForDanger(stat, State)
                danger = DangerClass.getEntityDanger(stat, State, e, BaseHash, statsHash)
            }

            // Tiered floors (each lost tier = a "push to kill" reward) + continuous remainder.
            var value = BASE_ALIVE
            if (stat.LIFE > stat.POISON)            value += BASE_ALIVE_POISON
            if (danger < stat.LIFE - stat.POISON)   value += BASE_ALIVE_DANGER
            value += max(0, eHP(stat) - DANGER_WEIGHT * danger)

            _score += sign * value
        }
        BenchOps.Stop("Scoring")
        return _score
    }

    /**
     * Certain remaining HP : LIFE minus locked poison (true damage, bypasses shields),
     * floored at 0. Feeds the continuous remainder. COEF_* are tunable in Weights.leek.
     */
    static eHP(stat) {
        return max(0, stat.LIFE - COEF_POISON * stat.POISON - COEF_POT * stat.POISON_OVER_TIME)
    }

    /**
     * Value used by Modifier/Resurrection.leek to rank WHICH dead ally to revive.
     * Resurrected life = TOTAL_LIFE/4 (Update halves TOTAL_LIFE, LIFE = half of that).
     * Monotone in TOTAL_LIFE → revive the biggest leek first.
     */
    static getResurrectionScore(entity_state, State) {
        return entity_state.TOTAL_LIFE / 4
    }
}
