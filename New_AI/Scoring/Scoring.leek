// Score d'un état = valeur des alliés - valeur des adversaires.
// Score d'une action = score après - score avant - prix des cooldowns consommés.
// Les prix s'accumulent dans le plan ; le placement est évalué à la fin.
include("../includes.leek")

// Un état scoré n'est plus muté : toute simulation écrit un clone (clone-on-write).
// Le mémo peut donc garder ses inputs par référence, sans copier quarante champs.
// Un clone hérite du mémo, mais ne le réutilise qu'après comparaison de SES inputs.
class EntityScoreMemo {
    INPUTS
    CONTEXT
    VALUE
    constructor(stat, context, value) {
        this.INPUTS = stat
        this.CONTEXT = context
        this.VALUE = value
    }
}

class ScoringClass {
    static CHARACTERISTIC_CONTEXTS = [:]
    static CHARACTERISTIC_CONTEXT
    static MAX_CHARACTERISTIC_CONTEXTS = 1024
    static CHARACTERISTIC_HITS = 0
    static CHARACTERISTIC_SHARING = false
    static CHARACTERISTIC_MIN_ACTIONS = 64

    static clearCharacteristicContexts() {
        CHARACTERISTIC_CONTEXTS = [:]
        CHARACTERISTIC_CONTEXT = ROOT_SCORING_CONSTANTS
        CHARACTERISTIC_HITS = 0
        CHARACTERISTIC_SHARING = false
    }

    // Présélection légère : les durées et entraves restent dans la comparaison
    // exacte. Deux valeurs différentes sous cette clé ne peuvent partager un score.
    static characteristicKey(stat) {
        var hash = (OFFSET_BASIS ^ stat.ID) * MIX_A
        hash = ((hash ^ stat.STRENGTH) * MIX_A ^ stat.WISDOM) * MIX_A
        hash = ((hash ^ stat.AGILITY) * MIX_A ^ stat.RESISTANCE) * MIX_A
        hash = ((hash ^ stat.SCIENCE) * MIX_A ^ stat.MAGIC) * MIX_A
        hash = ((hash ^ stat.POWER) * MIX_A ^ stat.STATES) * MIX_A
        return ((hash ^ stat.TOTAL_TP) * MIX_A ^ stat.TOTAL_MP) * MIX_A
    }
    static entityValue(stat) {
        // Le delta d'un kill retire toute la valeur AVANT la mort, buffs compris dans
        // les termes ci-dessous. Aucun bonus « stats courantes - bases » à rajouter.
        if (stat.LIFE <= 0) return 0
        var memo = stat.SCORE_MEMO
        if (memo != null && memo.CONTEXT == ROOT_SCORING_CONSTANTS
            && sameEntityScoreInputs(stat, memo.INPUTS, true)) {
            if (memo.INPUTS != stat) stat.SCORE_MEMO = new EntityScoreMemo(stat, ROOT_SCORING_CONSTANTS, memo.VALUE)
            return memo.VALUE
        }
        var value = computeEntityValue(stat)
        stat.SCORE_MEMO = new EntityScoreMemo(stat, ROOT_SCORING_CONSTANTS, value)
        return value
    }

    // PT/PM dépensés, arme équipée et cellule ne figurent PAS dans entityValue.
    // En revanche capacité, puissance, états, durées pondérées et entraves comptent.
    // Comparaison exacte (sans hash arrondi), indépendante de l'ancien DIFF_LOCAL_TERM.
    // Bases, inventaire, identité, camp et STATIC sont immuables dans une lignée de clones.
    static sameEntityScoreInputs(a, b, trackedParent = false) {
        if (a == b) return true
        if (a.LIFE != b.LIFE || a.TOTAL_LIFE != b.TOTAL_LIFE) return false
        // La marque d'action certifie seulement les caractéristiques du parent
        // DIRECT, pour la réutilisation locale de SCORE_MEMO uniquement. Les
        // certifications d'ActionGains gardent la comparaison brute par défaut.
        // Protections, puissance, états, flux et nettoyages restent relus.
        if ((!trackedParent || a.CHARACTERISTICS_PARENT != b || a.CAP_DIRTY)
            && (a.STRENGTH != b.STRENGTH || a.WISDOM != b.WISDOM
            || a.AGILITY != b.AGILITY || a.RESISTANCE != b.RESISTANCE
            || a.SCIENCE != b.SCIENCE || a.MAGIC != b.MAGIC
            || a.TOTAL_TP != b.TOTAL_TP || a.TOTAL_MP != b.TOTAL_MP
            || a.STRENGTH_BUFF != b.STRENGTH_BUFF || a.STRENGTH_BUFF_WEIGHTED != b.STRENGTH_BUFF_WEIGHTED
            || a.WISDOM_BUFF != b.WISDOM_BUFF || a.WISDOM_BUFF_WEIGHTED != b.WISDOM_BUFF_WEIGHTED
            || a.AGILITY_BUFF != b.AGILITY_BUFF || a.AGILITY_BUFF_WEIGHTED != b.AGILITY_BUFF_WEIGHTED
            || a.RESISTANCE_BUFF != b.RESISTANCE_BUFF || a.RESISTANCE_BUFF_WEIGHTED != b.RESISTANCE_BUFF_WEIGHTED
            || a.SCIENCE_BUFF != b.SCIENCE_BUFF || a.SCIENCE_BUFF_WEIGHTED != b.SCIENCE_BUFF_WEIGHTED
            || a.MAGIC_BUFF != b.MAGIC_BUFF || a.MAGIC_BUFF_WEIGHTED != b.MAGIC_BUFF_WEIGHTED
            || a.SHACKLE_STRENGTH != b.SHACKLE_STRENGTH || a.SHACKLE_AGILITY != b.SHACKLE_AGILITY
            || a.SHACKLE_WISDOM != b.SHACKLE_WISDOM || a.SHACKLE_MAGIC != b.SHACKLE_MAGIC
            || a.SHACKLE_TP != b.SHACKLE_TP || a.SHACKLE_MP != b.SHACKLE_MP)) return false
        if (a.POWER != b.POWER || a.STATES != b.STATES
            || a.ABSOLUTE_SHIELD != b.ABSOLUTE_SHIELD
            || a.RELATIVE_SHIELD != b.RELATIVE_SHIELD || a.DAMAGE_RETURN != b.DAMAGE_RETURN
            || a.POISON != b.POISON || a.POISON_OVER_TIME != b.POISON_OVER_TIME
            || a.AFTEREFFECT != b.AFTEREFFECT || a.AFTEREFFECT_OVER_TIME != b.AFTEREFFECT_OVER_TIME
            || a.HEAL_OVER_TIME != b.HEAL_OVER_TIME) return false
        // Ces deux cooldowns sont les seuls lus par la valeur d'entité, et seulement
        // quand le canal correspondant existe. Les autres dépenses n'invalident rien.
        if (a.POISON_OVER_TIME > 0 && PeriodicScoring.antidoteCooldown(a) != PeriodicScoring.antidoteCooldown(b)) return false
        if (ShackleScoring.hasShackles(a) && ShackleScoring.cooldown(a) != ShackleScoring.cooldown(b)) return false
        return true
    }

    static computeEntityValue(stat) {
        var score = Coefficients.presence(stat)
        score += stat.LIFE                  * Coefficients.life(stat)
        score += stat.TOTAL_LIFE            * Coefficients.totalLife(stat)
        score += characteristicsScore(stat)
        // Un stock nul contribue exactement zéro : le coefficient peut rester
        // paresseux. Ses fonctions restent inchangées pour le debug et les réglages.
        if (stat.ABSOLUTE_SHIELD != 0) score += stat.ABSOLUTE_SHIELD * Coefficients.absoluteShield(stat)
        if (stat.RELATIVE_SHIELD != 0) score += stat.RELATIVE_SHIELD * Coefficients.relativeShield(stat)
        if (stat.DAMAGE_RETURN != 0) score += stat.DAMAGE_RETURN * Coefficients.damageReturn(stat)
        // Une seule projection pour partager les PV entre poison et contrecoup.
        var periodic = PeriodicScoring.damageValues(stat)
        if (periodic != null) {
            score += stat.POISON_OVER_TIME      * Coefficients.poison(stat, periodic)
            score += stat.AFTEREFFECT_OVER_TIME * Coefficients.aftereffect(stat, periodic)
        }
        if (stat.HEAL_OVER_TIME != 0) score += stat.HEAL_OVER_TIME * Coefficients.heal(stat)
        return max(0, score) // Un allié vivant ne devient pas plus rentable mort.
    }

    // Une seule interaction caractéristiques × ressources : les deux ordres de buffs
    // donnent le même score à état final identique. Aucun bonus PT/PM ajouté à côté.
    // Partagée avec la copie sans entraves : Manumission décote aussi leurs synergies.
    static characteristicsValue(stat) {
        return characteristicsPotential(stat) * Coefficients.tpMultiplier(stat) * Coefficients.mpMultiplier(stat)
    }

    // Les PV, protections et flux périodiques changent souvent sans modifier le
    // potentiel des caractéristiques. Conserver sa somme exacte, correction des
    // entraves comprise, au lieu de recalculer tous les coefficients après chaque hit.
    static characteristicsScore(stat) {
        var memo = stat.CHARACTERISTICS_MEMO
        if (memo != null && memo.CONTEXT == ROOT_SCORING_CONSTANTS
            && sameCharacteristicsInputs(stat, memo.INPUTS)) {
            // Rattacher la preuve au snapshot courant : le clone suivant pourra
            // employer sa marque d'action, sans l'étendre à un ancien ancêtre.
            if (memo.INPUTS != stat) stat.CHARACTERISTICS_MEMO = new EntityScoreMemo(stat, ROOT_SCORING_CONSTANTS, memo.VALUE)
            return memo.VALUE
        }
        var key = null
        var shared = null
        if (CHARACTERISTIC_SHARING) {
            if (CHARACTERISTIC_CONTEXT != ROOT_SCORING_CONSTANTS) {
                clearCharacteristicContexts()
                CHARACTERISTIC_SHARING = true
            }
            key = characteristicKey(stat)
            shared = CHARACTERISTIC_CONTEXTS[key]
            if (shared != null && shared.INPUTS.ID == stat.ID
                && shared.INPUTS.INVENTORY == stat.INVENTORY && shared.INPUTS.STATIC == stat.STATIC
                // Les bases ne servent ici qu'à l'échelle critique. Leur map est
                // recapturée après chaque vrai cast : comparer cette échelle exacte.
                && ScoringStateConstants.criticalScale(shared.INPUTS) == ScoringStateConstants.criticalScale(stat)
                && sameCharacteristicsInputs(stat, shared.INPUTS)) {
                stat.CHARACTERISTICS_MEMO = new EntityScoreMemo(stat, ROOT_SCORING_CONSTANTS, shared.VALUE)
                CHARACTERISTIC_HITS++
                return shared.VALUE
            }
        }
        var characteristics = characteristicsValue(stat)
        var value = characteristics + ShackleScoring.correction(stat, characteristics)
        stat.CHARACTERISTICS_MEMO = new EntityScoreMemo(stat, ROOT_SCORING_CONSTANTS, value)
        if (key != null && (shared != null || mapSize(CHARACTERISTIC_CONTEXTS) < MAX_CHARACTERISTIC_CONTEXTS)) CHARACTERISTIC_CONTEXTS[key] = stat.CHARACTERISTICS_MEMO
        return value
    }

    static sameCharacteristicsInputs(a, b) {
        if (a == b) return true
        // CAP_DIRTY couvre stats, durées pondérées et entraves via le ledger,
        // mais seulement depuis le parent DIRECT. Puissance, états, Châtiment
        // et cooldown de Manumission sont des canaux indépendants à relire.
        if (a.CHARACTERISTICS_PARENT == b && !a.CAP_DIRTY) {
            if (a.POWER != b.POWER || a.STATES != b.STATES) return false
            if (a.LIFE != b.LIFE && Equipment.canUseLifeDamage(a)) return false
            return !ShackleScoring.hasShackles(a) || ShackleScoring.cooldown(a) == ShackleScoring.cooldown(b)
        }
        if (a.STRENGTH != b.STRENGTH || a.WISDOM != b.WISDOM
            || a.AGILITY != b.AGILITY || a.RESISTANCE != b.RESISTANCE
            || a.SCIENCE != b.SCIENCE || a.MAGIC != b.MAGIC || a.POWER != b.POWER
            || a.TOTAL_TP != b.TOTAL_TP || a.TOTAL_MP != b.TOTAL_MP || a.STATES != b.STATES
            || a.STRENGTH_BUFF != b.STRENGTH_BUFF || a.STRENGTH_BUFF_WEIGHTED != b.STRENGTH_BUFF_WEIGHTED
            || a.WISDOM_BUFF != b.WISDOM_BUFF || a.WISDOM_BUFF_WEIGHTED != b.WISDOM_BUFF_WEIGHTED
            || a.AGILITY_BUFF != b.AGILITY_BUFF || a.AGILITY_BUFF_WEIGHTED != b.AGILITY_BUFF_WEIGHTED
            || a.RESISTANCE_BUFF != b.RESISTANCE_BUFF || a.RESISTANCE_BUFF_WEIGHTED != b.RESISTANCE_BUFF_WEIGHTED
            || a.SCIENCE_BUFF != b.SCIENCE_BUFF || a.SCIENCE_BUFF_WEIGHTED != b.SCIENCE_BUFF_WEIGHTED
            || a.MAGIC_BUFF != b.MAGIC_BUFF || a.MAGIC_BUFF_WEIGHTED != b.MAGIC_BUFF_WEIGHTED
            || a.SHACKLE_STRENGTH != b.SHACKLE_STRENGTH || a.SHACKLE_AGILITY != b.SHACKLE_AGILITY
            || a.SHACKLE_WISDOM != b.SHACKLE_WISDOM || a.SHACKLE_MAGIC != b.SHACKLE_MAGIC
            || a.SHACKLE_TP != b.SHACKLE_TP || a.SHACKLE_MP != b.SHACKLE_MP) return false
        // Châtiment est le seul équipement dont le coefficient de puissance lit les PV.
        if (a.LIFE != b.LIFE && Equipment.canUseLifeDamage(a)) return false
        if (ShackleScoring.hasShackles(a) && ShackleScoring.cooldown(a) != ShackleScoring.cooldown(b)) return false
        return true
    }

    // Potentiel COURANT, distinct de l'importance de BASE utilisée pour présence/vie.
    // Les durées restent celles de BuffDuration ; les coefs ne contiennent plus de PT/PM.
    // Inventaire et tactique déjà en cache. Ce total dépend des buffs : pas de mémo de base.
    static characteristicsPotential(stat) {
        var score = BuffDuration.strengthValue(stat) * Coefficients.strength(stat)
        score += BuffDuration.wisdomValue(stat) * Coefficients.wisdom(stat)
        // agility inclut déjà le critique : isoler sa base pour la compter une seule fois,
        // sur les points entre 0 et 1000. Les paliers de renvoi gardent leur propre valeur.
        var criticalCoef = Coefficients.criticalAgility(stat)
        score += BuffDuration.agilityValue(stat) * (Coefficients.agility(stat) - criticalCoef)
        score += BuffDuration.criticalAgilityValue(stat) * criticalCoef
        score += BuffDuration.resistanceValue(stat) * Coefficients.resistance(stat)
        score += BuffDuration.scienceValue(stat) * Coefficients.science(stat)
        score += BuffDuration.magicValue(stat) * Coefficients.magic(stat)
        score += stat.POWER                 * Coefficients.power(stat)
        score += EntityImportance.tacticalImportance(stat)
        // Un potentiel négatif ferait préférer perdre des PT/PM. Les entraves peuvent
        // neutraliser le potentiel, pas transformer les ressources en pénalité.
        return max(0, score)
    }

    static stateValue(State, MySide, OpsLimit, values = null) {
        var score = 0
        for (var id: var stat in State) {
            if (getOperations() > OpsLimit) return null
            var value = entityValue(stat)
            if (values != null) values[id] = value
            score += (stat.SIDE == MySide ? 1 : -1) * value
        }
        return score
    }

    // Évite de relire tout le plateau : seules les entités clonées ont changé.
    // beforeValues optionnel : valeurs du parent immuable de CES candidats.
    // Le BFS passe le mémo de chaque nœud ; les sondes indépendantes celui de leur racine.
    static getStateScoreFromParent(node, State, ParentScore, MySide, beforeValues = null) {
        // Ce candidat ne sera pas retenu : le seul gain proviendrait du déplacement.
        if (!node.ITEM_HAS_BENEFIT) return ParentScore - node.COOLDOWN_COST
        node.SCORE_VALUES = [:]
        var score = ParentScore
        for (var id: var before in node.CLONED) {
            var after = State[id]
            var oldValue = 0
            if (before != null) {
                if (beforeValues != null && id in beforeValues) oldValue = beforeValues[id]
                else {
                    oldValue = entityValue(before)
                    if (beforeValues != null) beforeValues[id] = oldValue
                }
            }
            var newValue = entityValue(after)
            node.SCORE_VALUES[id] = newValue
            var delta = newValue - oldValue
            score += (after.SIDE == MySide ? 1 : -1) * delta
        }
        // ParentScore contient déjà les frais des casts précédents : payer celui-ci UNE fois.
        return score - node.COOLDOWN_COST
    }

    static getResurrectionScore(entity, State) {
        var copy = clone(State, 1)
        var changed = [:]
        ResurrectionClass.Update(entity.CELL, copy, entity.ID, changed)
        return entityValue(copy[entity.ID])
    }
}
