/*
 * Scoring : valeur d'un état, en HP d'équipe.
 *
 * Par entité VIVANTE — deux canaux, chaque input a UN seul canal :
 *   afterPoison = max(0, LIFE − COEF_POISON·POISON)          // STOCK : vie après le tick certain
 *   ttk         = rounds avant la mort sous la pression      // HORIZON : danger net + traînée poison
 *   value       = BASE_ALIVE + W_LIFE·sqrt(afterPoison) + W_TTK·g(ttk) + W_TOTAL_LIFE·sqrt(TOTAL_LIFE)
 *   term        = sign · (importance·value + capability + drDeterrence)
 * score = Σ term.  sign = +1 allié, −1 ennemi. Les morts contribuent 0 -> un kill vaut
 * toujours ≥ BASE_ALIVE. Le SCORE d'un nœud soustrait en plus CAST_COST[action] (coût
 * d'action porté par le chemin -> le score n'est pas strictement Σ termes).
 *
 * importance est FIGÉE pendant un replan/BFS (classement des cibles, rafraîchie par Play à
 * chaque planification réelle), capability est le canal LIVE des
 * buffs/debuffs + shields idle (Importance.leek), drDeterrence le bonus des porteurs de
 * damage return.
 * sqrt est concave (finir les blessés paie plus par HP) ; g(ttk) est relatif à la vie (une
 * menace n'est jamais noyée) et concentre la valeur sur les SEUILS de kill.
 */

include("../includes.leek")

class ScoringClass {

    /*
     * Score complet d'un état.
     *
     * @param State [id -> stats]
     * @param MySide side de Me
     * @param BaseHash hash (id, cellule) des vivants
     * @param contextBySide [side -> hash de l'équipe adverse]
     * @return score total signé
     */
    static getStateScore(State, MySide, BaseHash, contextBySide) {
        BenchOps.Start("Scoring")
        var netDamageMap = DeltaClass.getNetDamageMap(State, BaseHash, contextBySide)
        var poisonKey = poisonKeyOf(State, BaseHash)
        var _score = 0
        for (var e: var stat in State) {
            if (stat.LIFE <= 0) continue
            var sign = (stat.SIDE == MySide) ? 1 : -1
            _score += sign * (ImportanceClass.get(stat) * survivalValue(stat, netDamageMap[e], State, poisonKey) + ImportanceClass.capability(stat) + drDeterrence(stat, netDamageMap[e], State))
        }
        BenchOps.Stop("Scoring")
        return _score
    }

    /*
     * Map complète des termes [id -> terme SIGNÉ] (score == sumTerms(map)).
     * Utilisée à la racine du BFS, puis portée de nœud en nœud et patchée.
     */
    static buildTermsMap(State, MySide, BaseHash, contextBySide) {
        BenchOps.Start("Scoring")
        var netDamageMap = DeltaClass.getNetDamageMap(State, BaseHash, contextBySide)
        var poisonKey = poisonKeyOf(State, BaseHash)
        var terms = [: ]
        for (var e: var stat in State) {
            if (stat.LIFE <= 0) continue
            var sign = (stat.SIDE == MySide) ? 1 : -1
            terms[e] = sign * (ImportanceClass.get(stat) * survivalValue(stat, netDamageMap[e], State, poisonKey) + ImportanceClass.capability(stat) + drDeterrence(stat, netDamageMap[e], State))
        }
        BenchOps.Stop("Scoring")
        return terms
    }

    static sumTerms(terms) {
        var s = 0
        for (var e: var t in terms) s += t
        return s
    }

    /*
     * Score incrémental : score(enfant) = score(parent) + Δ sur le recompute-set.
     * Recompute-set = node.CLONED (les entités mutées par l'action) ∪ les vivants de chaque
     * side dont un input a changé vs le parent : danger (CONTEXT_BY_SIDE), heal (HFP_BY_SIDE)
     * ou couverture antidote (POISON_KEY). Détection purement par comparaison de
     * hashs. Les anciens termes viennent de node.TERMS, porté de parent en enfant.
     */
    static getStateScoreFromParent(node, ParentScore, ParentTerms, ParentContext, ParentHfp, MySide, ParentPoisonKey) {
        BenchOps.Start("Scoring")
        var State = node.END_STATS
        var cloned = node.CLONED
        var hfpMap = node.HFP_BY_SIDE

        // Heal map de l'enfant via le fold combiné des fingerprints (hit sauf healer modifié).
        var combinedHfp = 0
        for (var s: var h in hfpMap) combinedHfp ^= h
        var healMap = HealClass.getHealMapByFp(State, combinedHfp)

        // Sides dont les inputs danger ont changé.
        var dangerChanged = null
        for (var s: var h in node.CONTEXT_BY_SIDE) {
            if (ParentContext[s] != h) {
                if (dangerChanged == null) dangerChanged = [: ]
                dangerChanged[s] = true
            }
        }
        // Sides dont les inputs heal ont changé. Comparaison 0-défaut : le patch ne fait
        // qu'AJOUTER des clés, donc la map enfant ⊇ la map parent -> itérer l'enfant suffit.
        var healChanged = null
        for (var s: var h in hfpMap) {
            if (((s in ParentHfp) ? ParentHfp[s] : 0) != h) {
                if (healChanged == null) healChanged = [: ]
                healChanged[s] = true
            }
        }
        // Couverture antidote : POISON_KEY (poisonKeyOf — BaseHash, porteurs, ancre, Me
        // vivant) comparée à celle du parent. Déclenche exactement sur les vrais événements
        // (kill, summon, résu, push, cd/MP d'un porteur, mort de Me), jamais sur mes moves ni
        // mes casts ordinaires. Clé globale -> les DEUX camps sont relus quand elle bouge
        // (large d'un cran ; découpage par camp si les mesures l'exigent).
        node.POISON_KEY = poisonKeyOf(State, node.BASE_HASH)
        var coefChanged = node.POISON_KEY != ParentPoisonKey

        var delta = 0
        var terms = clone(ParentTerms, 1)

        if (dangerChanged == null && healChanged == null && !coefChanged) {
            // Cas courant : seules les entités clonées peuvent avoir un terme différent.
            for (var e: var _c in cloned) {
                delta += termDelta(e, State, node, terms, healMap, MySide)
            }
        } else {
            for (var e: var stat in State) {
                if ((e in cloned) || coefChanged
                    || (dangerChanged != null && stat.SIDE in dangerChanged)
                    || (healChanged != null && stat.SIDE in healChanged)) {
                    delta += termDelta(e, State, node, terms, healMap, MySide)
                }
            }
        }
        node.TERMS = terms
        BenchOps.Stop("Scoring")

        // Coût de cast des items d'économie (CAST_COST, Weights.leek) : soustrait au SCORE,
        // pas aux TERMS — un coût d'ACTION porté par le chemin, comme les TP.
        return ParentScore + delta - ((node.ACTION.Item in CAST_COST) ? CAST_COST[node.ACTION.Item] : 0)
    }

    /* newTerm(e) − oldTerm(e) ; l'ancien terme est lu dans la map portée, puis écrasé. */
    static termDelta(e, State, node, terms, healMap, MySide) {
        var stat = State[e]
        var newTerm = 0
        if (stat.LIFE > 0) {
            var sign = (stat.SIDE == MySide) ? 1 : -1
            var net = DeltaClass.netOf(e, stat, State, node.BASE_HASH, node.CONTEXT_BY_SIDE, node.HFP_BY_SIDE, healMap)
            newTerm = sign * (ImportanceClass.get(stat) * survivalValue(stat, net, State, node.POISON_KEY) + ImportanceClass.capability(stat) + drDeterrence(stat, net, State))
        }
        var oldTerm = (e in terms) ? terms[e] : 0
        terms[e] = newTerm
        return newTerm - oldTerm
    }

    /*
     * Valeur de survie d'une entité, cachée par une clé packée 64 bits :
     * LIFE<<48 | POISON<<34 | effPot<<17 | danger. POISON / effPot / danger sont MASQUÉS à
     * leur slot (valeurs négatives ou d'overkill possibles : un signe non masqué s'étendrait
     * et écraserait les champs hauts). Les bit-ops tronquent les floats, pas de round.
     * Le terme TOTAL_LIFE vit HORS cache (clé pleine) via le memo TLSQ_MEMO sur l'objet stat.
     * effPot = poisonCoefOf · POT (seulement si POT > 0) : la clé packe la valeur EFFECTIVE
     * — le vrai input de la formule — donc reste exacte sans salage. POISON (le tick certain
     * du prochain tour) n'est jamais réduit : aucun cleanse ne l'empêche.
     */
    static survivalValue(stat, danger, State, PoisonKey) {
        var tlTerm = stat.TLSQ_MEMO
        if (tlTerm == null) {
            tlTerm = W_TOTAL_LIFE * sqrt(max(0, stat.TOTAL_LIFE))
            stat.TLSQ_MEMO = tlTerm
        }
        var pot = stat.POISON_OVER_TIME
        if (pot > 0) pot = poisonCoefOf(stat, State, PoisonKey) * pot
        var key = (stat.LIFE << 48) | ((stat.POISON & 0x3FFF) << 34) | ((pot & 0x1FFFF) << 17) | (danger & 0x1FFFF)
        if (key in SURVIVAL_CACHE) return SURVIVAL_CACHE[key] + tlTerm

        // Canal STOCK : la vie brute après le tick certain du prochain tour. AUCUNE projection
        // ici — le danger et la traînée de poison vivent exclusivement dans le canal TTK
        // (chaque input a UN canal, pas de double compte). sqrt concave : un HP vaut plus
        // près de la mort -> finir les blessés.
        var afterPoison = max(0, stat.LIFE - COEF_POISON * stat.POISON)
        var value = BASE_ALIVE + W_LIFE * sqrt(afterPoison)

        // Canal HORIZON (TTK) en forme DIRECTE : g = horizonLife / (horizonLife + TTK_HALF ·
        // pression) — algébriquement identique à g(ttk) = ttk/(ttk+TTK_HALF) avec
        // ttk = horizonLife/pression, sans calcul intermédiaire de ttk ni dénominateur +1 :
        // pression nulle -> g = 1 EXACTEMENT (une entité vivante sans pression touche tout
        // W_TTK, plus de faux dégât fantôme). tick = poison du prochain tour, répété tant que
        // le poison dure ; effPot est remisé par la couverture antidote -> TTK antidote-aware.
        // Trois régimes :
        //   - sans poison persistant : horizonLife = afterPoison,          pression = danger
        //   - mort PENDANT le poison : horizonLife = afterPoison,          pression = danger + tick
        //   - poison EXPIRÉ avant    : horizonLife = afterPoison − effPot, pression = danger
        //     (simplification EXACTE de duration + (afterPoison − (danger+tick)·duration)/danger,
        //      duration = effPot/tick — vérifiée algébriquement)
        // Détection sans division : afterPoison·tick <= (danger+tick)·effPot <=> mort pendant.
        // Tous les inputs (LIFE, POISON, effPot, danger) sont déjà dans la clé du cache
        // -> calculé sur miss seulement, aucun salage.
        var tick = max(0, stat.POISON)
        var effPot = max(0, pot)
        var horizonLife = afterPoison
        var pressure = danger
        if (tick > 0 && effPot > 0) {
            if (afterPoison * tick <= (danger + tick) * effPot) {
                pressure = danger + tick                     // il meurt avant l'expiration du poison
            } else {
                horizonLife = afterPoison - effPot           // le poison expire, la traînée est payée
            }
        }
        // g : 0 (condamné) -> 1 (sûr), pente max près de 0, RELATIF à la vie (un même danger
        // mord plus une petite vie). Franchir un seuil de kill est la plus grosse monnaie du
        // canal, puis g s'aplatit -> stack de vulnés jusqu'au seuil, puis cible suivante ;
        // l'overkill garde un gradient. Garde : horizonLife <= 0 -> contribution 0 (condamné),
        // jamais 1 ni epsilon — et jamais de 0/0.
        if (horizonLife > 0) value += W_TTK * horizonLife / (horizonLife + TTK_HALF * pressure)

        SURVIVAL_CACHE[key] = value
        return value + tlTerm
    }

    /*
     * Bonus dissuasion d'un porteur de damage return, dans SON propre terme : la menace qui
     * lui arrive (son net) se convertit en retours que ses attaquants saigneront.
     * Net post-shield et amorti par les heals VOLONTAIREMENT : un porteur blindé/soigné
     * attire moins de coups, donc dissuade moins. min(net, LIFE) : les retours s'arrêtent à
     * sa mort. Vit dans le terme du porteur exprès : ses inputs (net, DR, ratio figé) sont
     * exactement les triggers de recompute existants du terme -> aucun canal nouveau.
     * Mes propres attaques paient leur retour dans la sim et sont absentes des nets (Me
     * jamais caster) -> pas de double compte.
     */
    static drDeterrence(stat, net, State) {
        if (stat.DAMAGE_RETURN <= 0) return 0
        if (DR_PHYSRATIO_BY_SIDE == null) buildDrPhysRatios(State)
        return DR_RETURN_EXPECT * DR_PHYSRATIO_BY_SIDE[stat.SIDE] * min(net, stat.LIFE) * (stat.DAMAGE_RETURN / 100)
    }

    /*
     * [side -> part physique STR/(STR+MAG) de l'équipe ADVERSE] : la fraction du danger
     * entrant qui déclenche des retours (le poison n'en déclenche pas). Stats clampées à 0,
     * Me exclu (comme des nets). FIGÉ au tour, construit au premier porteur évalué :
     * une constante du tour garde les termes patchés purs.
     */
    static buildDrPhysRatios(State) {
        var strBySide = [: ], magBySide = [: ], strAll = 0, magAll = 0
        var sides = [: ]
        for (var e: var stat in State) {
            sides[stat.SIDE] = true
            if (stat.LIFE <= 0 || e == Me) continue
            var s = max(0, stat.STRENGTH), m = max(0, stat.MAGIC)
            strBySide[stat.SIDE] = ((stat.SIDE in strBySide) ? strBySide[stat.SIDE] : 0) + s
            magBySide[stat.SIDE] = ((stat.SIDE in magBySide) ? magBySide[stat.SIDE] : 0) + m
            strAll += s
            magAll += m
        }
        DR_PHYSRATIO_BY_SIDE = [: ]
        for (var side: var _ in sides) {
            var s = strAll - ((side in strBySide) ? strBySide[side] : 0)
            var m = magAll - ((side in magBySide) ? magBySide[side] : 0)
            DR_PHYSRATIO_BY_SIDE[side] = (s + m > 0) ? s / (s + m) : 1   // sans stats : dégâts de base, physiques
        }
    }

    /*
     * Y a-t-il un antidote dans ce combat ? Scanné MORTS INCLUS : basé inventaire, donc
     * invariant en branche (une première évaluation sur une branche kill-du-porteur ne peut
     * pas fausser le flag). Court-circuite toute la machinerie poison à ~2 ops sinon.
     * Lazy, reset au tour (un summon peut apporter des chips).
     */
    static anyAntidote(State) {
        if (ANY_ANTIDOTE == null) {
            ANTIDOTE_CARRIER_IDS = []
            for (var e: var stat in State) {
                if (CHIP_ANTIDOTE in stat.COOLDOWNS) push(ANTIDOTE_CARRIER_IDS, e)
            }
            ANY_ANTIDOTE = count(ANTIDOTE_CARRIER_IDS) > 0
        }
        return ANY_ANTIDOTE
    }

    /*
     * Clé de couverture antidote d'un état : encode TOUS les inputs de buildPoisonCoefs.
     *   - BaseHash : positions/vie des non-Me (kill, summon, résu, push -> clé neuve) ;
     *   - fold des porteurs vivants (id, TOTAL_MP, cd) : cast d'antidote, shackle/buff MP ;
     *   - ancre de replan de Me (MY_REPLAN_CELL_HASH) : Me est GELÉ à sa vraie cellule du
     *     dernier replan — la portée d'un porteur (range 4 + MP) dépasse un tour de
     *     déplacement et l'ancre converge vers ma cellule finale au fil des actions réelles ;
     *   - sel si Me est mort en branche (aucun des deux autres canaux ne le porte).
     * Sert de clé de POISON_COEF_CACHE ET de détecteur de changement parent/enfant.
     * 0 si pas d'antidote en jeu. ~30 opés par nœud (1-3 porteurs).
     */
    static poisonKeyOf(State, BaseHash) {
        if (!anyAntidote(State)) return 0
        var key = BaseHash ^ MY_REPLAN_CELL_HASH
        if (State[Me].LIFE <= 0) key ^= POISON_ME_DEAD_SALT
        for (var e in ANTIDOTE_CARRIER_IDS) {
            var s = State[e]
            if (s.LIFE > 0) key ^= mix64((e << 20) | (max(0, s.TOTAL_MP) << 10) | min(1023, s.COOLDOWNS[CHIP_ANTIDOTE]))
        }
        return key
    }

    /*
     * Coefficient poison d'une entité ∈ ]0,1] : la part du poison posé sur elle qui va
     * vraiment COLLER, vu la couverture antidote autour d'elle. PoisonKey vient de
     * poisonKeyOf (calculée une fois par nœud, portée par node.POISON_KEY).
     */
    static poisonCoefOf(stat, State, PoisonKey) {
        if (!anyAntidote(State)) return 1
        if (!(PoisonKey in POISON_COEF_CACHE)) POISON_COEF_CACHE[PoisonKey] = buildPoisonCoefs(State)
        var coefs = POISON_COEF_CACHE[PoisonKey]
        return (stat.ID in coefs) ? coefs[stat.ID] : 1
    }

    /*
     * [id -> coef] pour chaque vivant : coef = 1/(1 + POISON_CLEANSE_W · protection), avec
     * protection = son propre antidote 1/(1+cd) + Σ des porteurs alliés à portée, chacun
     * DILUÉ par le nombre de coéquipiers qu'il couvre (un antidote nettoie ~une cible par
     * cycle de cd : un porteur seul couvrant 4 protège chacun à 1/4, une équipe full-antidote
     * écrase le poison — le scoring voit OÙ le poison colle).
     * Portée = range antidote + MP, LoS ignorée. cd/cellules lus dans le State du build,
     * pureté garantie par la clé du cache.
     */
    static buildPoisonCoefs(State) {
        var antidoteRange = ITEMINFO[CHIP_ANTIDOTE].MAXRANGE
        var carriers = [: ]   // id -> [capacité déjà diluée par nCovered, portée]
        for (var a in ANTIDOTE_CARRIER_IDS) {
            var aStat = State[a]
            if (aStat.LIFE <= 0) continue
            var reach = antidoteRange + max(0, aStat.TOTAL_MP)
            var aCell = (a == Me) ? MY_REPLAN_CELL : aStat.CELL   // Me gelé (voir poisonCoefOf)
            var nCovered = 0
            for (var t: var tStat in State) {
                if (tStat.LIFE > 0 && tStat.SIDE == aStat.SIDE && CellClass.getDist(aCell, (t == Me) ? MY_REPLAN_CELL : tStat.CELL) <= reach) nCovered++
            }
            carriers[a] = [(1 / (1 + aStat.COOLDOWNS[CHIP_ANTIDOTE])) / nCovered, reach]
        }
        var coefs = [: ]
        if (mapSize(carriers) == 0) return coefs   // aucun porteur vivant -> tous les lookups valent 1
        for (var e: var stat in State) {
            if (stat.LIFE <= 0) continue
            var eCell = (e == Me) ? MY_REPLAN_CELL : stat.CELL
            var protection = (CHIP_ANTIDOTE in stat.COOLDOWNS) ? 1 / (1 + stat.COOLDOWNS[CHIP_ANTIDOTE]) : 0
            for (var a: var c in carriers) {
                if (a == e || State[a].SIDE != stat.SIDE) continue
                var aCell = (a == Me) ? MY_REPLAN_CELL : State[a].CELL
                if (CellClass.getDist(aCell, eCell) <= c[1]) protection += c[0]
            }
            coefs[e] = 1 / (1 + POISON_CLEANSE_W * protection)
        }
        return coefs
    }

    /*
     * Classe les morts alliés pour la résurrection : PROXY du terme post-revive — canaux
     * danger/TTK/DR omis volontairement (la cellule To est commune aux candidats, tous
     * relevés sans shields -> le net n'y différencie pas), et le kit (capability) lu sur
     * les stats de mort (proxy assumé). Vie ressuscitée via la SOURCE UNIQUE
     * ResurrectionClass.reviveTotalLife/reviveLife (arrondis moteur exacts) : le score
     * classe rigoureusement les mêmes valeurs que celles que Update appliquera. Quasi
     * gratuit : importance et capability sont déjà memoizées (par id / par objet).
     */
    static getResurrectionScore(entity_state, State) {
        var reviveTL = ResurrectionClass.reviveTotalLife(entity_state.TOTAL_LIFE, State)
        var reviveLife = ResurrectionClass.reviveLife(reviveTL)
        return ImportanceClass.get(entity_state)
                 * (BASE_ALIVE + W_LIFE * sqrt(reviveLife) + W_TOTAL_LIFE * sqrt(reviveTL))
             + ImportanceClass.capability(entity_state)
    }
}
