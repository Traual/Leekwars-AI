/*
 * Score = somme signée des valeurs par entité + bonus de victoire terminale.
 * Valeur = vie, vie max, présence du kit + somme coef(stat, profil) × delta depuis la base
 *        + protections et flux périodiques utiles.
 * Les profils sont figés par recherche. Pas de moteur ni de danger dans entityValue.
 * La cellule de Me est évaluée seulement à la clôture, dans FinalCell.
 */

include("../includes.leek")

// Journalise les contributions de la décision retenue (ScoringClass.explainDecision).
global SCORE_EXPLAIN = false

// Diagnostic d'UNE décision : tour visé, 0 = éteint. Il détaille le contexte, la suite retenue
// et les autres têtes de chaîne explorées depuis le même état. Éteint, il ne coûte qu'une
// comparaison par décision ; allumé, il ne vise qu'un tour d'une entité.
global DIAG_TURN = 0
// Entité visée. La sentinelle est -1, PAS 0 : 0 est un identifiant d'entité valide, et le
// prendre pour « toutes » instrumentait tout le tour quand on visait l'entité 0.
global DIAG_ENTITY = -1
// Item dont on veut la meilleure suite explorée SANS aucun cast (-1 = aucun). Sert à comparer
// la suite retenue à une vraie concurrente qui se prive de cet item, sous les mêmes
// coefficients, au lieu de soustraire une contribution à la main.
global DIAG_WITHOUT_ITEM = -1
// Mode du dernier placement évalué, renseigné par FinalCell quand le diagnostic est armé :
// « danger » calculé, « memo » servi par le cache, « spatial » quand le danger n'est pas
// finançable. Un danger non calculé n'est pas un danger nul.
global DIAG_PLACEMENT_MODE = ""

class ScoringClass {

	/*
	 * Valeur d'une entité pour son propre camp, plancher positif tant qu'elle vit.
	 * Une entité morte ne vaut rien : ni présence, ni caractéristiques.
	 *
	 * @param stat état de l'entité
	 * @param out map [nom -> contribution] remplie quand elle n'est pas nulle (diagnostic)
	 * @return la valeur
	 */
	static entityValue(stat, out) {
		if (stat.LIFE <= 0) return 0
		var p = Coefficients.profile(stat)
		var b = stat.BASE_STATS
		var presence    = Coefficients.presence(stat, p)
		var life        = Coefficients.life(stat, p) * stat.LIFE
		var totalLife   = Coefficients.totalLife(stat, p) * stat.TOTAL_LIFE
		// Les bases du kit sont déjà dans la présence. Seuls buffs et entraves s'ajoutent :
		// relever un blessé ne recrée pas artificiellement des milliers de points de stats.
		var strength    = Coefficients.strength(stat, p) * (max(0, stat.STRENGTH) - max(0, b[STAT_STRENGTH]))
		var wisdom      = Coefficients.wisdom(stat, p) * (max(-100, stat.WISDOM) - max(-100, b[STAT_WISDOM]))
		var agility     = Coefficients.agility(stat, p) * (min(1000, max(0, stat.AGILITY)) - min(1000, max(0, b[STAT_AGILITY])))
			+ p.reflection * (max(-100, stat.AGILITY) - max(-100, b[STAT_AGILITY]))
		var resistance  = Coefficients.resistance(stat, p) * (max(-100, stat.RESISTANCE) - max(-100, b[STAT_RESISTANCE]))
		var science     = Coefficients.science(stat, p) * (max(-100, stat.SCIENCE) - max(-100, b[STAT_SCIENCE]))
		var magic       = Coefficients.magic(stat, p) * (max(0, stat.MAGIC) - max(0, b[STAT_MAGIC]))
		var power       = Coefficients.power(stat, p) * max(-100, stat.POWER)
		var tp          = Coefficients.totalTP(stat, p) * (max(0, stat.TOTAL_TP) - max(0, b[STAT_TP]))
		var mp          = Coefficients.totalMP(stat, p) * max(0, stat.TOTAL_MP) - p.mp * max(0, b[STAT_MP])
		var absShield   = Coefficients.absoluteShield(stat, p) * stat.ABSOLUTE_SHIELD
		var relShield   = Coefficients.relativeShield(stat, p) * stat.RELATIVE_SHIELD
		var damageReturn = Coefficients.damageReturn(stat, p) * max(0, stat.DAMAGE_RETURN)
		var states = Coefficients.states(stat, p)
		var poison = Coefficients.periodic(stat.POISON_OVER_TIME, stat.POISON, Coefficients.poison(stat, p))
		var aftereffect = Coefficients.periodic(stat.AFTEREFFECT_OVER_TIME, stat.AFTEREFFECT, Coefficients.aftereffect(stat, p))
		var loss = poison + aftereffect
		var lossScale = loss > stat.LIFE ? stat.LIFE / loss : 1
		poison *= -lossScale * p.life
		aftereffect *= -lossScale * p.life
		var projectedLife = max(0, stat.LIFE - loss)
		var heal = min(max(0, stat.TOTAL_LIFE - projectedLife) + p.healReserve, Coefficients.periodic(stat.HEAL_OVER_TIME, stat.HEAL, Coefficients.heal(stat, p))) * p.life
		var value = presence + life + totalLife + strength + wisdom + agility + resistance + science
			+ magic + power + tp + mp + absShield + relShield + damageReturn + poison + aftereffect + heal + states
		// Une entité vivante ne devient jamais un passif qu'il serait rentable de tuer.
		var floorBonus = max(0, (stat.IS_SUMMON ? 5 : 20) - value)
		if (out != null) {
			out["présence"] = presence
			out["vie"] = life
			out["vie max"] = totalLife
			out["force"] = strength
			out["sagesse"] = wisdom
			out["agilité"] = agility
			out["résistance"] = resistance
			out["science"] = science
			out["magie"] = magic
			out["puissance"] = power
			out["PT"] = tp
			out["PM"] = mp
			out["bouclier absolu"] = absShield
			out["bouclier relatif"] = relShield
			out["renvoi"] = damageReturn
			out["poison"] = poison
			out["contrecoup"] = aftereffect
			out["soin continu"] = heal
			out["états"] = states
			out["plancher vivant"] = floorBonus
		}
		return value + floorBonus
	}

	/*
	 * Score COMPLET d'un état : la somme signée des valeurs de ses entités. Passé OpsLimit,
	 * rend null plutôt que de laisser le moteur couper le tour.
	 *
	 * @param State [id -> stats]
	 * @param MySide mon camp
	 * @param OpsLimit plafond d'opérations au-delà duquel on renonce
	 * @return le score, ou null
	 */
	static stateValue(State, MySide, OpsLimit) {
		BenchOps.Start("Scoring")
		var total = 0
		for (var e: var stat in State) {
			if (getOperations() > OpsLimit) {
				BenchOps.Stop("Scoring")
				return null
			}
			if (stat.LIFE <= 0) continue
			var v = entityValue(stat, null)
			total += (stat.SIDE == MySide) ? v : -v
		}
		BenchOps.Stop("Scoring")
		return total + terminalValue(State, MySide, null)
	}

	// Un gain matériel ne vaut jamais une victoire immédiate. Les formats spéciaux
	// (coffres, guerre/tourelles) ont d'autres règles : bonus désactivé dans ces modes.
	// `before` permet de relire le parent depuis les clones, sans copier le plateau.
	static terminalValue(State, MySide, before) {
		if (!SCORE_TERMINAL_STANDARD) return 0
		var mine = false
		var enemy = false
		for (var id: var s in State) {
			var old = before != null && id in before ? before[id] : s
			if (old == null || old.LIFE <= 0) continue
			if (old.SIDE == MySide) mine = true
			else enemy = true
			if (mine && enemy) return 0
		}
		return mine ? SCORE_VICTORY : (enemy ? -SCORE_VICTORY : 0)
	}

	/*
	 * Score d'un nœud depuis celui de son parent. Seules les entités CLONÉES par l'action ont pu
	 * changer de valeur : les autres sont les objets du parent, partagés tels quels. La somme des
	 * écarts est donc exactement la différence des scores complets.
	 *
	 * @param node nœud dont CLONED porte [id -> état d'AVANT l'action] (null = entité née)
	 * @param State état de travail APRÈS l'action
	 * @param ParentScore score de l'état parent
	 * @param MySide mon camp
	 * @return le score du nœud
	 */
	static getStateScoreFromParent(node, State, ParentScore, MySide) {
		BenchOps.Start("Scoring")
		var delta = 0
		var populationChanged = false
		for (var e: var parentStat in node.CLONED) {
			var newStat = State[e]
			if (parentStat == null || (parentStat.LIFE > 0) != (newStat.LIFE > 0)) populationChanged = true
			var d = entityValue(newStat, null)
			if (parentStat != null) d -= entityValue(parentStat, null)
			if (d != 0) delta += (newStat.SIDE == MySide) ? d : -d
		}
		if (populationChanged) delta += terminalValue(State, MySide, null) - terminalValue(State, MySide, node.CLONED)
		// Le score ne lit plus le danger : la liste des lanceurs salis n'a plus de lecteur.
		node.DANGER_DIRTY_CASTERS = null
		BenchOps.Stop("Scoring")
		return ParentScore + delta
	}

	/*
	 * Pénalité d'exposition de Me à sa cellule de fin de tour, pour FinalCell : les PV que le net
	 * projeté à cette cellule, pondéré par une hypothèse d'exposition. Toujours >= 0, et jamais plafonnée à sa
	 * vie — le net compte l'overkill, c'est ce qui départage deux cellules également mortelles.
	 *
	 * @param net dégâts nets projetés sur un round à la cellule
	 * @return la pénalité, en points de score
	 */
	static exposureLoss(net, stat = null) {
		if (stat == null) return EXPOSURE_FACTOR * max(0, net)
		return Coefficients.placement(stat, Coefficients.profile(stat)) * max(0, net)
	}

	/*
	 * Valeur qu'aurait un mort allié une fois relevé : le moteur le ressuscite propre — vie et
	 * vie max rendues par les formules de ResurrectionClass, caractéristiques remises à leurs
	 * bases, ni effet, ni bouclier, ni puissance. Classe les candidats de la Résurrection.
	 *
	 * @param entity_state état du mort
	 * @param State état courant (vie de résurrection : critique du lanceur)
	 * @return la valeur du ressuscité
	 */
	static getResurrectionScore(entity_state, State) {
		// Même transition que la simulation : aucun second calcul parallèle à maintenir.
		var copy = clone(State, 1)
		var changed = [:]
		ResurrectionClass.Update(entity_state.CELL, copy, entity_state.ID, changed)
		return entityValue(copy[entity_state.ID], null)
	}

	/*
	 * Contribution de ce porteur à la clé de couverture antidote. Plus aucun score ne dépend de
	 * cette clé ; la fonction reste pour Node.leek, qui ne l'appelle que si ANY_ANTIDOTE est
	 * vrai — ce que plus personne ne pose.
	 */
	static carrierContribOf(stat, id) {
		return 0
	}

	/*
	 * MAJORANT du gain d'une action, calculé SANS la simuler. CONTRAT : toujours >= au gain réel.
	 * Tout ce qui n'est pas borné rend BOUND_MUST_SIMULATE : item qui n'est pas que des dégâts
	 * directs sur ennemi, allié touché, cible tuée, plante réveillable, passif d'arme, renvoi qui
	 * pourrait me tuer.
	 *
	 * Sur une cible ennemie touchée sans être tuée, la vie retirée et l'érosion changent aussi
	 * les plafonds du poison et des soins continus. La borne couvre leurs pentes maximales.
	 * Ses passifs d'arme ne peuvent que lui RENDRE des
	 * caractéristiques, donc réduire mon gain. Chez moi, seul le vol de vie ajoute quelque chose.
	 * Me n'est borné que depuis une cellule de marche (voir BFS) : saut et téléportation posent
	 * sur lui des valeurs que cette formule ignore.
	 */
	static actionUpperBound(Item, From, To, State, MySide, BaseHash) {
		var Infos = ITEMINFO[Item]
		if (!Infos.IS_BOUNDABLE_DAMAGE) return BOUND_MUST_SIMULATE
		if (SCORE_MAX_LIFE < 0 || SCORE_FUTURE_TURNS < 0) return BOUND_MUST_SIMULATE
		var MyStats = State[Me]
		if (!mapIsEmpty(PLANT_ZONE_BY_ID) && From != MyStats.CELL && AwakeningClass.livingZones(State) != null) return BOUND_MUST_SIMULATE
		if ((MyStats.SPECIAL_WEAPON & SPW_UNSTABLE_DESTROYER) && MyStats.LIFE < MyStats.TOTAL_LIFE) return BOUND_MUST_SIMULATE
		// Jet maximal compté deux fois, critique supposé, force plancherée, puissance non plancherée.
		var gainFactor = (1 + max(0, MyStats.STRENGTH) / 100) * (1 + MyStats.POWER / 100) * CRITICAL_FACTOR
		var raw = 0
		var nEff = 0
		for (var eff in Infos.EFFECTS) {
			raw += eff[1] + eff[2]
			nEff++
		}
		raw = raw * gainFactor
		// Passifs qui rendent des caractéristiques à qui encaisse des dégâts ou de l'érosion.
		var damagePassives = SPW_REVOKED_M_LASER | SPW_MYSTERIOUS_ELECTRISOR | SPW_PLUTONIUM_BAZOOKA | SPW_UNBRIDLED_GAZOR
		var Targets = ConsequencesClass.ConsequenceTargets(Item, From, To, State, Me, BaseHash)
		var bound = 0
		var dealtTotal = 0
		var returned = 0
		for (var tar: var dist in Targets) {
			var stat = State[tar]
			if (stat == null || stat.LIFE <= 0) continue
			var base = raw * AOE_FALLOFF[dist]
			if (stat.SIDE == MySide) {
				if (tar != Me) return BOUND_MUST_SIMULATE
				// Me dans ma propre zone : je n'y perds que de la vie, sauf si un passif m'en
				// rend en caractéristiques, ou si le coup peut me tuer.
				if (MyStats.SPECIAL_WEAPON & damagePassives) return BOUND_MUST_SIMULATE
				if (base + nEff >= MyStats.LIFE) return BOUND_MUST_SIMULATE
				continue
			}
			var relFactor = 1 - stat.RELATIVE_SHIELD / 100
			if (relFactor < 0) relFactor = 0
			var absShield = stat.ABSOLUTE_SHIELD
			// Un bouclier absolu ne peut que retirer : le compter une fois majore. Une
			// vulnérabilité absolue, elle, s'ajoute à CHAQUE effet. Un point par effet couvre
			// les arrondis du moteur.
			var dealt = base * relFactor - (absShield > 0 ? absShield : nEff * absShield) + nEff
			if (stat.DAMAGE_RETURN > 0) returned += base * stat.DAMAGE_RETURN / 100 + nEff
			if (dealt <= 0) continue
			if (dealt >= stat.LIFE) return BOUND_MUST_SIMULATE
			var p = Coefficients.profile(stat)
			// Le plafonnement des soins continus peut donner une unité de valeur de plus
			// par PV max. Les plafonds de poison et le plancher vivant n'augmentent jamais
			// la pente par PV courant. Ces constantes majorent toutes les branches.
			bound += p.life * dealt + (p.totalLife + (stat.HEAL_OVER_TIME > 0 ? p.life : 0)) * (EROSION_CRIT * dealt + nEff)
			dealtTotal += dealt
		}
		if (returned > 0) {
			// Renvoi qui peut me tuer, ou dont l'érosion nourrirait mon passif de magie.
			if (returned >= MyStats.LIFE) return BOUND_MUST_SIMULATE
			if (MyStats.SPECIAL_WEAPON & SPW_UNBRIDLED_GAZOR) return BOUND_MUST_SIMULATE
		}
		// Vol de vie : plafonné à ma vie manquante, nul sous UNHEALABLE.
		if (dealtTotal > 0 && !EntityStateClass.hasState(MyStats, STATE_UNHEALABLE)) {
			var stolen = dealtTotal * max(0, MyStats.WISDOM) / 1000
			if (stolen > 0) {
				stolen += nEff
				var room = MyStats.TOTAL_LIFE - MyStats.LIFE
				if (stolen > room) stolen = room
				if (stolen > 0) bound += Coefficients.profile(MyStats).life * stolen
			}
		}
		return bound
	}

	/*
	 * Contributions d'un gain, entité par entité et statistique par statistique, calculées par la
	 * fonction de valeur elle-même. Une ligne de journal par entité dont la valeur bouge.
	 *
	 * @param Before état de départ
	 * @param After état d'arrivée
	 * @param MySide mon camp
	 * @param tag étiquette préfixant chaque ligne, pour regrouper plusieurs gains d'une décision
	 * @return la somme des contributions journalisées
	 */
	static explainDelta(Before, After, MySide, tag) {
		var total = 0
		for (var e: var stat in After) {
			var apres = [: ]
			var avant = [: ]
			entityValue(stat, apres)
			if (e in Before) entityValue(Before[e], avant)
			var reference = (mapSize(apres) > 0) ? apres : avant
			if (mapSize(reference) == 0) continue
			var sign = (stat.SIDE == MySide) ? 1 : -1
			var ligne = ""
			var somme = 0
			for (var nom: var _c in reference) {
				var d = sign * (((nom in apres) ? apres[nom] : 0) - ((nom in avant) ? avant[nom] : 0))
				if (d == 0) continue
				somme += d
				ligne += " | " + nom + " " + d
			}
			if (ligne == "") continue
			total += somme
			debug("[score] " + tag + " " + ((sign > 0) ? "allié " : "ennemi ") + stat.NAME + " #" + e + " : " + somme + ligne)
		}
		var terminal = terminalValue(After, MySide, null) - terminalValue(Before, MySide, null)
		if (terminal != 0) debug("[score] " + tag + " fin de combat : " + terminal)
		return total + terminal
	}

	/*
	 * Détail de la décision retenue : contributions du gain brut, puis pénalité de placement.
	 * Appelée par le BFS uniquement quand SCORE_EXPLAIN est vrai.
	 *
	 * @param RootNode nœud « ne rien jouer » (état de départ)
	 * @param BestNode nœud retenu
	 * @param FinalScore score final du nœud retenu (brut moins pénalité)
	 * @param MySide mon camp
	 */
	static explainDecision(RootNode, BestNode, FinalScore, MySide) {
		var brut = BestNode.SCORE - RootNode.SCORE
		var somme = explainDelta(StateClass.materializeNodeState(RootNode),
			StateClass.materializeNodeState(BestNode), MySide, "retenue")
		debug("[score] gain brut " + brut + " | contributions " + somme + " | pénalité de placement "
			+ (BestNode.SCORE - FinalScore) + " | gain final " + (FinalScore - RootNode.SCORE))
		if (abs(somme - brut) > 0.001) debugE("[score] ECART contributions " + somme + " contre gain brut " + brut)
	}

	/*
	 * Le diagnostic de décision vise-t-il CETTE décision ? Un tour nul n'en vise aucune : le
	 * diagnostic est éteint par défaut et ne coûte alors qu'une comparaison par décision.
	 *
	 * @return vrai si la décision courante est celle qu'on veut détailler
	 */
	static diagActive() {
		if (DIAG_TURN == 0) return false
		if (getTurn() != DIAG_TURN) return false
		return DIAG_ENTITY < 0 || Me == DIAG_ENTITY
	}

	/*
	 * La suite d'un nœud lance-t-elle cet item ? Sert à retrouver la meilleure suite explorée qui
	 * s'en prive.
	 *
	 * @param node nœud terminal de la suite
	 * @param item identifiant d'item
	 * @return vrai si un des casts de la suite est cet item
	 */
	static chainUsesItem(node, item) {
		var cur = node
		while (cur != null && cur.ACTION != null) {
			if (cur.ACTION.Item == item) return true
			cur = cur.PARENT
		}
		return false
	}

	/*
	 * Contexte de la décision visée : le tour, le budget, puis une ligne par entité vivante —
	 * camp, cellule, vie, ressources, caractéristiques et sa valeur pour le score. Exactement ce
	 * que la fonction de valeur lit, et rien d'autre.
	 *
	 * @param State état de départ de la décision
	 * @param MySide mon camp
	 */
	static explainContext(State, MySide) {
		var MyStats = State[Me]
		debug("[diag] decision tour " + getTurn() + " entite " + Me + " " + MyStats.NAME + " camp " + MySide
			+ " cellule " + MyStats.CELL + " operations " + getOperations() + " plafond " + OPS_CAP)
		for (var e: var stat in State) {
			if (stat.LIFE <= 0) continue
			debug("[diag] entite " + e + " " + stat.NAME
				+ ((stat.SIDE == MySide) ? " allie" : " ennemi") + (stat.IS_SUMMON ? " invocation" : " poireau")
				+ " cellule " + stat.CELL + " vie " + stat.LIFE + "/" + stat.TOTAL_LIFE
				+ " PT " + stat.TP + "/" + stat.TOTAL_TP + " PM " + stat.MP + "/" + stat.TOTAL_MP
				+ " force " + stat.STRENGTH + " sagesse " + stat.WISDOM + " agilite " + stat.AGILITY
				+ " resistance " + stat.RESISTANCE + " science " + stat.SCIENCE + " magie " + stat.MAGIC
				+ " puissance " + stat.POWER
				+ " bouclier " + stat.ABSOLUTE_SHIELD + "+" + stat.RELATIVE_SHIELD + "%"
				+ " renvoi " + stat.DAMAGE_RETURN + "%"
				+ " poison " + stat.POISON_OVER_TIME + " contrecoup " + stat.AFTEREFFECT_OVER_TIME
				+ " soin " + stat.HEAL_OVER_TIME + " valeur " + entityValue(stat, null))
		}
		return;
	}

	/*
	 * La suite d'actions d'un nœud, de la racine vers lui. Remontée bornée par la longueur de
	 * chaîne (médiane 2, maximum 7).
	 *
	 * @param node nœud terminal de la suite
	 * @return le texte de la suite, « ne rien jouer » pour le plancher
	 */
	static chainTextOf(node) {
		var noms = []
		var cur = node
		while (cur != null && cur.ACTION != null) {
			push(noms, ITEMINFO[cur.ACTION.Item].NAME + "#" + cur.ACTION.Item
				+ "(" + cur.ACTION.From + ">" + cur.ACTION.To + ")")
			cur = cur.PARENT
		}
		if (count(noms) == 0) return "ne-rien-jouer"
		reverse(noms)
		var texte = ""
		for (var n in noms) {
			if (texte != "") texte += " puis "
			texte += n
		}
		return texte
	}

	/*
	 * Clé d'une suite, identique pour deux nœuds portant la même chaîne d'actions. Sert à
	 * retrouver le statut de placement relevé pendant le reclassement, sans comparer d'objets.
	 *
	 * @param node nœud terminal de la suite
	 * @return la clé
	 */
	static chainKeyOf(node) {
		var cle = ""
		var cur = node
		while (cur != null && cur.ACTION != null) {
			cle += cur.ACTION.Item + ":" + cur.ACTION.From + ":" + cur.ACTION.To + ";"
			cur = cur.PARENT
		}
		return cle
	}

	/*
	 * Une suite candidate : ses actions, son score brut, sa pénalité de placement quand elle a
	 * RÉELLEMENT été calculée, puis les contributions de son gain par entité et par statistique.
	 * Une suite non close annonce son statut et n'affiche aucune pénalité : une pénalité absente
	 * n'est pas une pénalité nulle.
	 *
	 * @param etiquette « retenue » ou le rang de l'alternative
	 * @param node nœud de la suite
	 * @param RootState état de départ, commun à toutes les suites comparées
	 * @param RootScore score de cet état de départ
	 * @param MySide mon camp
	 * @param close [statut, pénalité ou null, net, mode de placement]
	 */
	static explainCandidate(etiquette, node, RootState, RootScore, MySide, close) {
		var ligne = ("[diag] suite " + etiquette + " | " + chainTextOf(node)
			+ " | brut " + node.SCORE + " | gain " + (node.SCORE - RootScore) + " | placement " + close[0])
		if (close[1] != null) {
			ligne += (" (" + close[3] + ") | penalite " + close[1] + " | net " + close[2]
				+ " | final " + (node.SCORE - close[1]))
		}
		debug(ligne)
		explainDelta(RootState, StateClass.materializeNodeState(node), MySide, etiquette)
		return;
	}
}
