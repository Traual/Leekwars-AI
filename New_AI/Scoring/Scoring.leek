/*
 * Scoring : la valeur d'un état est une somme par statistique.
 *
 *   valeur(e)    = bonus de présence + Σ coefficient × statistique   (0 si e est morte)
 *   score(état)  = Σ valeur(alliés) − Σ valeur(adversaires)
 *   gain(action) = score(après) − score(avant)
 *
 * Coefficients et signification de chaque statistique : Weights.leek. Le score ne lit ni le
 * danger projeté, ni les soins projetés, ni la production d'un kit : la sécurité de la cellule
 * de fin de tour est jugée à part, par FinalCell.
 */

include("../includes.leek")

// Journalise les contributions de la décision retenue (ScoringClass.explainDecision).
global SCORE_EXPLAIN = false

class ScoringClass {

	/*
	 * Valeur d'une entité pour son propre camp, toujours >= 0 pour des coefficients positifs.
	 * Une entité morte ne vaut rien : ni présence, ni caractéristiques.
	 *
	 * @param stat état de l'entité
	 * @param out map [nom -> contribution] remplie quand elle n'est pas nulle (diagnostic)
	 * @return la valeur
	 */
	static entityValue(stat, out) {
		if (stat.LIFE <= 0) return 0
		var presence    = stat.IS_SUMMON ? SCORE_ALIVE_SUMMON : SCORE_ALIVE_LEEK
		var life        = COEF_LIFE * stat.LIFE
		var totalLife   = COEF_TOTAL_LIFE * stat.TOTAL_LIFE
		var strength    = COEF_STRENGTH * stat.STRENGTH
		var wisdom      = COEF_WISDOM * stat.WISDOM
		var agility     = COEF_AGILITY * stat.AGILITY
		var resistance  = COEF_RESISTANCE * stat.RESISTANCE
		var science     = COEF_SCIENCE * stat.SCIENCE
		var magic       = COEF_MAGIC * stat.MAGIC
		var power       = COEF_POWER * stat.POWER
		var tp          = COEF_TOTAL_TP * stat.TOTAL_TP
		var mp          = COEF_TOTAL_MP * stat.TOTAL_MP
		var absShield   = COEF_ABSOLUTE_SHIELD * stat.ABSOLUTE_SHIELD
		var relShield   = COEF_RELATIVE_SHIELD * stat.RELATIVE_SHIELD
		var damageReturn = COEF_DAMAGE_RETURN * stat.DAMAGE_RETURN
		var poison      = COEF_POISON * stat.POISON_OVER_TIME
		var aftereffect = COEF_AFTEREFFECT * stat.AFTEREFFECT_OVER_TIME
		var heal        = COEF_HEAL * stat.HEAL_OVER_TIME
		if (out != null) {
			out["présence"] = presence
			out["vie"] = life
			out["vie max"] = totalLife
			out["force"] = strength
			out["sagesse"] = wisdom
			out["agilité"] = agility
			out["résistance"] = resistance
			out["science"] = science
			out["magie"] = magic
			out["puissance"] = power
			out["PT"] = tp
			out["PM"] = mp
			out["bouclier absolu"] = absShield
			out["bouclier relatif"] = relShield
			out["renvoi"] = damageReturn
			out["poison"] = poison
			out["contrecoup"] = aftereffect
			out["soin continu"] = heal
		}
		return presence + life + totalLife + strength + wisdom + agility + resistance + science
			+ magic + power + tp + mp + absShield + relShield + damageReturn + poison
			+ aftereffect + heal
	}

	/*
	 * Score COMPLET d'un état : la somme signée des valeurs de ses entités. Passé OpsLimit,
	 * rend null plutôt que de laisser le moteur couper le tour.
	 *
	 * @param State [id -> stats]
	 * @param MySide mon camp
	 * @param OpsLimit plafond d'opérations au-delà duquel on renonce
	 * @return le score, ou null
	 */
	static stateValue(State, MySide, OpsLimit) {
		BenchOps.Start("Scoring")
		var total = 0
		for (var e: var stat in State) {
			if (getOperations() > OpsLimit) {
				BenchOps.Stop("Scoring")
				return null
			}
			if (stat.LIFE <= 0) continue
			var v = entityValue(stat, null)
			total += (stat.SIDE == MySide) ? v : -v
		}
		BenchOps.Stop("Scoring")
		return total
	}

	/*
	 * Score d'un nœud depuis celui de son parent. Seules les entités CLONÉES par l'action ont pu
	 * changer de valeur : les autres sont les objets du parent, partagés tels quels. La somme des
	 * écarts est donc exactement la différence des scores complets.
	 *
	 * @param node nœud dont CLONED porte [id -> état d'AVANT l'action] (null = entité née)
	 * @param State état de travail APRÈS l'action
	 * @param ParentScore score de l'état parent
	 * @param MySide mon camp
	 * @return le score du nœud
	 */
	static getStateScoreFromParent(node, State, ParentScore, MySide) {
		BenchOps.Start("Scoring")
		var delta = 0
		for (var e: var parentStat in node.CLONED) {
			var newStat = State[e]
			var d = entityValue(newStat, null)
			if (parentStat != null) d -= entityValue(parentStat, null)
			if (d != 0) delta += (newStat.SIDE == MySide) ? d : -d
		}
		// Le score ne lit plus le danger : la liste des lanceurs salis n'a plus de lecteur.
		node.DANGER_DIRTY_CASTERS = null
		BenchOps.Stop("Scoring")
		return ParentScore + delta
	}

	/*
	 * Pénalité d'exposition de Me à sa cellule de fin de tour, pour FinalCell : les PV que le net
	 * projeté à cette cellule lui coûterait réellement. Toujours >= 0, et jamais plafonnée à sa
	 * vie — le net compte l'overkill, c'est ce qui départage deux cellules également mortelles.
	 *
	 * @param net dégâts nets projetés sur un round à la cellule
	 * @return la pénalité, en points de score
	 */
	static exposureLoss(net) {
		return EXPOSURE_FACTOR * COEF_LIFE * net
	}

	/*
	 * Valeur qu'aurait un mort allié une fois relevé : le moteur le ressuscite propre — vie et
	 * vie max rendues par les formules de ResurrectionClass, caractéristiques remises à leurs
	 * bases, ni effet, ni bouclier, ni puissance. Classe les candidats de la Résurrection.
	 *
	 * @param entity_state état du mort
	 * @param State état courant (vie de résurrection : critique du lanceur)
	 * @return la valeur du ressuscité
	 */
	static getResurrectionScore(entity_state, State) {
		var reviveTotalLife = ResurrectionClass.reviveTotalLife(entity_state.TOTAL_LIFE, State)
		var reviveLife = ResurrectionClass.reviveLife(reviveTotalLife)
		var bases = entity_state.BASE_STATS
		return (entity_state.IS_SUMMON ? SCORE_ALIVE_SUMMON : SCORE_ALIVE_LEEK)
			+ COEF_LIFE * reviveLife + COEF_TOTAL_LIFE * reviveTotalLife
			+ COEF_STRENGTH * bases[STAT_STRENGTH] + COEF_WISDOM * bases[STAT_WISDOM]
			+ COEF_AGILITY * bases[STAT_AGILITY] + COEF_RESISTANCE * bases[STAT_RESISTANCE]
			+ COEF_SCIENCE * bases[STAT_SCIENCE] + COEF_MAGIC * bases[STAT_MAGIC]
			+ COEF_TOTAL_TP * bases[STAT_TP] + COEF_TOTAL_MP * bases[STAT_MP]
	}

	/*
	 * Contribution de ce porteur à la clé de couverture antidote. Plus aucun score ne dépend de
	 * cette clé ; la fonction reste pour Node.leek, qui ne l'appelle que si ANY_ANTIDOTE est
	 * vrai — ce que plus personne ne pose.
	 */
	static carrierContribOf(stat, id) {
		return 0
	}

	/*
	 * MAJORANT du gain d'une action, calculé SANS la simuler. CONTRAT : toujours >= au gain réel.
	 * Tout ce qui n'est pas borné rend BOUND_MUST_SIMULATE : item qui n'est pas que des dégâts
	 * directs sur ennemi, allié touché, cible tuée, plante réveillable, passif d'arme, renvoi qui
	 * pourrait me tuer.
	 *
	 * Sur une cible ennemie touchée sans être tuée, seule SA valeur bouge, et de deux lignes :
	 * la vie retirée et l'érosion de sa vie max. Ses passifs d'arme ne peuvent que lui RENDRE des
	 * caractéristiques, donc réduire mon gain. Chez moi, seul le vol de vie ajoute quelque chose.
	 * Me n'est borné que depuis une cellule de marche (voir BFS) : saut et téléportation posent
	 * sur lui des valeurs que cette formule ignore.
	 */
	static actionUpperBound(Item, From, To, State, MySide, BaseHash) {
		var Infos = ITEMINFO[Item]
		if (!Infos.IS_BOUNDABLE_DAMAGE) return BOUND_MUST_SIMULATE
		// Le raisonnement suppose qu'une statistique RETIRÉE à un adversaire ne peut que me
		// profiter : sous un coefficient négatif, la borne ne tient plus.
		if (COEF_LIFE < 0 || COEF_TOTAL_LIFE < 0 || COEF_STRENGTH < 0 || COEF_RESISTANCE < 0
			|| COEF_MAGIC < 0 || COEF_ABSOLUTE_SHIELD < 0) return BOUND_MUST_SIMULATE
		var MyStats = State[Me]
		if (!mapIsEmpty(PLANT_ZONE_BY_ID) && From != MyStats.CELL && AwakeningClass.livingZones(State) != null) return BOUND_MUST_SIMULATE
		if ((MyStats.SPECIAL_WEAPON & SPW_UNSTABLE_DESTROYER) && MyStats.LIFE < MyStats.TOTAL_LIFE) return BOUND_MUST_SIMULATE
		// Jet maximal compté deux fois, critique supposé, force plancherée, puissance non plancherée.
		var gainFactor = (1 + max(0, MyStats.STRENGTH) / 100) * (1 + MyStats.POWER / 100) * CRITICAL_FACTOR
		var raw = 0
		var nEff = 0
		for (var eff in Infos.EFFECTS) {
			raw += eff[1] + eff[2]
			nEff++
		}
		raw = raw * gainFactor
		// Passifs qui rendent des caractéristiques à qui encaisse des dégâts ou de l'érosion.
		var damagePassives = SPW_REVOKED_M_LASER | SPW_MYSTERIOUS_ELECTRISOR | SPW_PLUTONIUM_BAZOOKA | SPW_UNBRIDLED_GAZOR
		var Targets = ConsequencesClass.ConsequenceTargets(Item, From, To, State, Me, BaseHash)
		var bound = 0
		var dealtTotal = 0
		var returned = 0
		for (var tar: var dist in Targets) {
			var stat = State[tar]
			if (stat == null || stat.LIFE <= 0) continue
			var base = raw * AOE_FALLOFF[dist]
			if (stat.SIDE == MySide) {
				if (tar != Me) return BOUND_MUST_SIMULATE
				// Me dans ma propre zone : je n'y perds que de la vie, sauf si un passif m'en
				// rend en caractéristiques, ou si le coup peut me tuer.
				if (MyStats.SPECIAL_WEAPON & damagePassives) return BOUND_MUST_SIMULATE
				if (base + nEff >= MyStats.LIFE) return BOUND_MUST_SIMULATE
				continue
			}
			var relFactor = 1 - stat.RELATIVE_SHIELD / 100
			if (relFactor < 0) relFactor = 0
			var absShield = stat.ABSOLUTE_SHIELD
			// Un bouclier absolu ne peut que retirer : le compter une fois majore. Une
			// vulnérabilité absolue, elle, s'ajoute à CHAQUE effet. Un point par effet couvre
			// les arrondis du moteur.
			var dealt = base * relFactor - (absShield > 0 ? absShield : nEff * absShield) + nEff
			if (stat.DAMAGE_RETURN > 0) returned += base * stat.DAMAGE_RETURN / 100 + nEff
			if (dealt <= 0) continue
			if (dealt >= stat.LIFE) return BOUND_MUST_SIMULATE
			bound += COEF_LIFE * dealt + COEF_TOTAL_LIFE * (EROSION_CRIT * dealt + nEff)
			dealtTotal += dealt
		}
		if (returned > 0) {
			// Renvoi qui peut me tuer, ou dont l'érosion nourrirait mon passif de magie.
			if (returned >= MyStats.LIFE) return BOUND_MUST_SIMULATE
			if (MyStats.SPECIAL_WEAPON & SPW_UNBRIDLED_GAZOR) return BOUND_MUST_SIMULATE
		}
		// Vol de vie : plafonné à ma vie manquante, nul sous UNHEALABLE.
		if (dealtTotal > 0 && !EntityStateClass.hasState(MyStats, STATE_UNHEALABLE)) {
			var stolen = dealtTotal * max(0, MyStats.WISDOM) / 1000
			if (stolen > 0) {
				stolen += nEff
				var room = MyStats.TOTAL_LIFE - MyStats.LIFE
				if (stolen > room) stolen = room
				if (stolen > 0) bound += COEF_LIFE * stolen
			}
		}
		return bound
	}

	/*
	 * Contributions d'un gain, entité par entité et statistique par statistique, calculées par la
	 * fonction de valeur elle-même. Une ligne de journal par entité dont la valeur bouge.
	 *
	 * @param Before état de départ
	 * @param After état d'arrivée
	 * @param MySide mon camp
	 * @return la somme des contributions journalisées
	 */
	static explainDelta(Before, After, MySide) {
		var total = 0
		for (var e: var stat in After) {
			var apres = [: ]
			var avant = [: ]
			entityValue(stat, apres)
			if (e in Before) entityValue(Before[e], avant)
			var reference = (mapSize(apres) > 0) ? apres : avant
			if (mapSize(reference) == 0) continue
			var sign = (stat.SIDE == MySide) ? 1 : -1
			var ligne = ""
			var somme = 0
			for (var nom: var _c in reference) {
				var d = sign * (((nom in apres) ? apres[nom] : 0) - ((nom in avant) ? avant[nom] : 0))
				if (d == 0) continue
				somme += d
				ligne += " | " + nom + " " + d
			}
			if (ligne == "") continue
			total += somme
			debug("[score] " + ((sign > 0) ? "allié " : "ennemi ") + stat.NAME + " #" + e + " : " + somme + ligne)
		}
		return total
	}

	/*
	 * Détail de la décision retenue : contributions du gain brut, puis pénalité de placement.
	 * Appelée par le BFS uniquement quand SCORE_EXPLAIN est vrai.
	 *
	 * @param RootNode nœud « ne rien jouer » (état de départ)
	 * @param BestNode nœud retenu
	 * @param FinalScore score final du nœud retenu (brut moins pénalité)
	 * @param MySide mon camp
	 */
	static explainDecision(RootNode, BestNode, FinalScore, MySide) {
		var brut = BestNode.SCORE - RootNode.SCORE
		var somme = explainDelta(StateClass.materializeNodeState(RootNode),
			StateClass.materializeNodeState(BestNode), MySide)
		debug("[score] gain brut " + brut + " | contributions " + somme + " | pénalité de placement "
			+ (BestNode.SCORE - FinalScore) + " | gain final " + (FinalScore - RootNode.SCORE))
		if (abs(somme - brut) > 0.001) debugE("[score] ECART contributions " + somme + " contre gain brut " + brut)
	}
}
