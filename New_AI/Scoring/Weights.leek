/**
 * Scoring Weights and Coefficients — V0 baseline for CMA-ES
 *
 * Everything is set to ZERO or game-mechanical default EXCEPT :
 *   - Base-stat coefs (STR, MAG, AGI, RES, WIS, SCI) all = 1.0 (uniform)
 *   - Threat polys (DANGER, POISON, POT) all = linear 1:1
 *   - Sit_score = linear identity
 *   - Distance-to-enemy = linear (combat actually happens)
 *
 * Every other tunable starts at zero. CMA-ES will discover everything else.
 **/

// === Importance coefs (base stats) — uniform 1.0 ===
global IMPORTANCE_COEF_STR = 4.145
global IMPORTANCE_COEF_MAG = 1.565
global IMPORTANCE_COEF_AGI = 1.403
global IMPORTANCE_COEF_WIS = 0.394
global IMPORTANCE_COEF_RES = 0.682
global IMPORTANCE_COEF_SCI = 0.1
// Bulbs slightly discounted — avoid silly summon spam during early training.
global IMPORTANCE_STATIC_FACTOR = 1.0

// === Base stat polys (used inside stat indexes) — linear identity ===
global POLY_STRENGTH = [0.0, 1.0, 0.0]
global POLY_WISDOM = [0.0, 1.0, 0.0]
global POLY_AGILITY = [0.0, 1.0, 0.0]
global POLY_RESISTANCE = [0.0, 1.0, 0.0]
global POLY_SCIENCE = [0.0, 1.0, 0.0]
global POLY_MAGIC = [0.0, 1.0, 0.0]

// === Bonus polys (MP/CRIT/LIFE) and POWER scaling — game-mechanical defaults ===
// These aren't really "tunable" — they mirror the engine's natural scaling.
global POLY_BONUS_MP = [0.0, 0.0333, 1.0]      // 1 + MP/30
global POLY_BONUS_CRIT = [0.0, 0.0014, 1.0]    // 1 + AGI × 0.0014
global POLY_BONUS_LIFE = [0.0, 0.0001, 1.0]    // 1 + LIFE/10000
global POLY_POWER_STRENGTH = [0.0, 0.01, 1.0]  // 1 + POW/100
global POLY_POWER_MAGIC = [0.0, 0.0066, 1.0]   // 1 + POW/150

// === sit_score : linear identity (ratio → ratio) ===
global POLY_SIT_SCORE = [0.0, 1.0, 0.0]

// === Threats : 1:1 (1 unit raw → 1 effective HP loss) ===
global POLY_THREAT_DANGER = [0.0, 0.1, 0.0]
global POLY_THREAT_POISON = [0.0, 1.918, 0.0]
global POLY_THREAT_POT = [0.0, 0.337, 0.0]

// === Positional — ZERO except combat nudge ===
global POLY_POS_ALLY = [0.0, 0.0, 0.0]    // no ally cohesion (CMA-ES learns)
global POLY_POS_ENEMY = [0.0, -1.0, 0.0]  // -dist : combat happens (closer to enemy = better)

// === Shield preemptive — DISABLED ===
global POLY_SHIELD_PREEMPTIVE_ABS = [0.0, 0.0, 0.0]
global POLY_SHIELD_PREEMPTIVE_REL = [0.0, 0.0, 0.0]

// === DR contribution — DISABLED ===
global MAX_DR_RETURN = 0.0

// === ItemValuation counter-items — ALL ZERO (CMA-ES will tune) ===
global ITEM_VAL_SHIELD_DMG_REF_BASE = 0.0
global ITEM_VAL_SHIELD_DMG_REF_PER_STR = 0.0
global ITEM_VAL_ANTIDOTE_BASE = 0.0
global ITEM_VAL_ANTIDOTE_PER_MAG = 0.0
global ITEM_VAL_MANUMISSION_BASE = 0.0
global ITEM_VAL_MANUMISSION_PER_MAG = 0.0
global ITEM_VAL_VULN_BASE = 0.0
global ITEM_VAL_VULN_PER_RES = 0.0
global ITEM_VAL_ABS_VULN_BASE = 0.0
global ITEM_VAL_ABS_VULN_PER_RES = 0.0
global ITEM_VAL_DEBUFF_BASE = 0.0
global ITEM_VAL_DEBUFF_PER_SCI = 0.0
global ITEM_VAL_DEBUFF_PER_RES = 0.0
global ITEM_VAL_TOTAL_DEBUFF_BASE = 0.0
global ITEM_VAL_TOTAL_DEBUFF_PER_SCI = 0.0
global ITEM_VAL_TOTAL_DEBUFF_PER_RES = 0.0
