/**
 * Scoring weights & coefficients (HP-equivalent scoring).
 *
 * Every tunable scalar used by getStateScore lives here, so the numbers can be swept
 * (by hand or CMA-ES) WITHOUT touching the scoring logic.
 *
 * Per ALIVE entity:
 *   afterPoison = max(0, LIFE − COEF_POISON·POISON)                         // certain next-turn tick
 *   pressure    = (DANGER_WEIGHT·danger + COEF_POT·POISON_OVER_TIME)        // relative threats
 *               / (afterPoison + BUFFER)
 *   effLife     = afterPoison / (1 + pressure)                              // >0, threats never drowned
 *   value       = BASE_ALIVE + W_LIFE · sqrt(effLife) + W_TOTAL_LIFE · sqrt(TOTAL_LIFE)
 * score = Σ sign·value. Dead (LIFE=0, skipped) = 0 → kill always worth ≥ BASE_ALIVE.
 **/

include("../includes.leek")

// Fixed value of being alive (real-kill floor). A kill removes the whole term, so killing
// is always worth ≥ BASE_ALIVE (monotone, never indifferent). Also values summons/resurrects.
global BASE_ALIVE = 1000

// Life term: W_LIFE · sqrt(effLife). sqrt is concave → the marginal value of a HP is higher
// at low life, so the same +HP is worth more near death (push to finish wounded targets).
// sqrt returns smaller numbers than pow(.,0.7), so W_LIFE is scaled up to keep the life term
// meaningful vs BASE_ALIVE. (Want ~0.75 concavity instead? use sqrt(effLife·sqrt(effLife)).)
global W_LIFE = 14.0

// Max-life term: W_TOTAL_LIFE · sqrt(TOTAL_LIFE) — the entity's DURABLE capital. The only score
// channel for erosion/nova (max-life chip is permanent: no heal ever refunds it) and for vitality
// buffs' max-life half. Tuned DOWN from 3×W_LIFE to 0.5× (user call 2026-07-06: the 3× floor made
// alive-values too max-life-dominated; revisit after live fights).
// Sits OUTSIDE SURVIVAL_CACHE (its 64-bit key is full) — added after the cache read, ~10 ops.
global W_TOTAL_LIFE = 0.5 * W_LIFE

// Immediate poison tick: certain damage next turn → subtracted directly from life.
global COEF_POISON = 0.5

// Relative "pressure" threats (compared to remaining life, so they bite even when huge and
// never get drowned). Both go in the SAME pressure term, scaled by remaining life:
//   - danger            (incoming, post-shield, cached)            weighted DANGER_WEIGHT
//   - POISON_OVER_TIME  (total remaining poison, can reach 100000) weighted COEF_POT
// BUFFER avoids divide-by-zero as remaining life → 0 and sets the pressure scale.
// effLife = afterPoison/(1+pressure) is decreasing & convex → diminishing returns on danger
// (each extra point of danger matters less when danger is already high).
global DANGER_WEIGHT = 0.7
global COEF_POT = 0.2
global BUFFER = 500

// Heal cushions incoming danger in the turn-order-sequenced netDamage (DeltaClass): each same-side
// caster's heal lands at HEAL_COEF of its potential (a heal is less CERTAIN than damage — the
// healer may be dead/shackled/out of position by then). Lowered 0.8 → 0.6 (user call 2026-07-06:
// the AI trusted heals too much).
global DANGER_COEF = 1.0
global HEAL_COEF = 0.6
