/**
 * Scoring weights & coefficients (HP-equivalent scoring).
 *
 * Every tunable scalar used by getStateScore lives here, so the numbers can be swept
 * (by hand or CMA-ES) WITHOUT touching the scoring logic. All values are HP-equivalent,
 * so they stay readable / sanity-checkable by hand.
 **/

include("../includes.leek")

// === Tiered "how alive" floors ===
// An alive entity is worth BASE_ALIVE, plus a fixed bonus for each survival tier it still
// holds. When an ENEMY loses a tier (we push it toward death) the score rises by that
// tier's value, so each tier is a "push to kill" reward; a real kill removes the whole
// term (always ≥ BASE_ALIVE → dead strictly > alive, monotone). Cumulative floors:
//   alive only ............................. BASE_ALIVE                       (= 1000)
//   + won't die to poison next turn ........ + BASE_ALIVE_POISON              (→ 1500)
//   + won't die to incoming danger ......... + BASE_ALIVE_DANGER             (→ 1750)
// BASE_ALIVE also values summons / resurrects (they add an entity).
global BASE_ALIVE        = 1000   // tier 0: alive at all (real-kill floor)
global BASE_ALIVE_POISON = 500    // tier 1: LIFE > POISON (survives next turn's poison tick)
global BASE_ALIVE_DANGER = 250    // tier 2: danger < LIFE − POISON (survives incoming danger)

// === Continuous remainder : locked poison (true damage) + exposure ===
// max(0, LIFE − COEF_POISON·POISON − COEF_POT·POT − DANGER_WEIGHT·danger), floored so it
// never drags the value below the tier floors. This is the intra-tier HP gradient.
//   POISON           = next-turn tick (net of heal)   — also the tier conditions use raw POISON
//   POISON_OVER_TIME = total remaining (discounted)   — POT tier deferred (needs antidote/libé CDs)
// TODO (with cooldowns): scale poison by the victim's antidote CD; add a POT-lethal tier.
global COEF_POISON = 0.5
global COEF_POT = 0.2

// Exposure: incoming danger (post-shield, already cached). `danger` is a MAX-potential
// estimate (pessimistic), so keep this below 1. The tiered floors make it monotone-safe
// on BOTH sides. Danger is still computed when BASE_ALIVE_DANGER != 0 (the danger tier
// needs it) even if this weight is 0.
global DANGER_WEIGHT = 0.7
