/*
 * Tous les scalaires réglables du scoring (monnaie : HP). Les nombres se balayent ici
 * sans toucher à la logique.
 *
 * Par entité VIVANTE — deux canaux, chaque input a UN seul canal :
 *   afterPeriodic = max(0, LIFE − COEF_POISON·netTick)  // STOCK : netTick = poison + aftereffect − HoT
 *   ttk         = rounds avant la mort                // HORIZON : danger net + traînée poison
 *   value       = BASE_ALIVE + W_LIFE · sqrt(afterPeriodic) + W_TTK · g(ttk)
 *               + W_TOTAL_LIFE · sqrt(TOTAL_LIFE)
 * score = Σ sign·value. Les morts (0) => un kill vaut toujours >= BASE_ALIVE.
 */

include("../includes.leek")

// Valeur fixe d'être en vie (plancher du kill). Un kill retire le terme entier, donc tuer
// vaut toujours >= BASE_ALIVE (monotone, jamais indifférent). Valorise aussi summons/résus.
global BASE_ALIVE = 1000

// Canal STOCK : W_LIFE · sqrt(afterPeriodic) — la vie brute, AUCUNE projection dedans (le
// danger et la traînée de poison vivent dans le TTK). sqrt est concave -> un HP vaut plus
// près de la mort (pousse à finir les blessés). Paie le chip damage et les heals même sur
// des cibles hors de toute menace. (~0.75 de concavité ? sqrt(x·sqrt(x)).)
global W_LIFE = 14.0

// Terme de vie max : le capital DURABLE de l'entité. Seul canal de l'érosion/nova (permanent,
// aucun heal ne le rend) et de la moitié vie-max des buffs de vitalité.
// Vit HORS de SURVIVAL_CACHE (clé pleine) — ajouté après la lecture.
global W_TOTAL_LIFE = 0.5 * W_LIFE

// Tick périodique NET du prochain tour (poison + aftereffect − heal over time), soustrait
// de la vie (un HoT dominant le rehausse).
global COEF_POISON = 0.5

// Le heal amortit le danger dans le net séquencé par ordre de tour (DeltaClass) : chaque
// heal ne compte qu'à HEAL_COEF de son potentiel (un soin est moins CERTAIN qu'un dégât —
// le healer peut être mort, shacklé, hors position).
global DANGER_COEF = 1.0
global HEAL_COEF = 0.6

// ----- Canal HORIZON : TTK (kill-horizon) — LE canal de menace -----
// survivalValue gagne W_TTK · g en forme DIRECTE : g = horizonLife/(horizonLife +
// TTK_HALF·pression) ∈ [0,1] — algébriquement ttk/(ttk+TTK_HALF) avec ttk = rounds avant
// la mort sous la pression courante (danger net + tick de poison, antidote-remisé — calcul
// dans survivalValue). Pression nulle -> g = 1 exactement : aucun +1 protecteur, une entité
// vivante sans pression touche tout W_TTK.
// C'est le SEUL endroit où le danger projeté et la traînée de poison entrent dans la valeur
// (l'ancien canal pressure/effLife double-comptait ET était concave -> saupoudrage de
// vulnés ; remplacé).
//
// g a sa pente MAXIMALE près de ttk 0-1.5 : franchir un seuil de kill est la plus grosse
// monnaie du canal (TTK_HALF=2 : ttk 2->1 = Δg 0.167, ·W_TTK = ~67 ; 1->0.5 = ~53), puis g
// s'aplatit (cible condamnée, rien à gratter) et l'IA passe à la suivante.
// -> stack de vulnés jusqu'au one-turn-kill ÉMERGENT ; POT-léthal couvert (un empoisonné
// condamné a ttk ~ sa durée de poison -> valeur effondrée) ; menace RELATIVE à la vie
// (jamais noyée) ; l'overkill garde un gradient (ttk descend sous 1 en continu).
//
// Tuning à la main :
//   W_TTK    : l'ampleur de TOUTE la sensibilité au danger (l'équivalent de l'ancien
//              couple DANGER_WEIGHT/BUFFER). 400 ≈ l'ancienne ampleur sur un build 3k HP.
//              0 = plus AUCUNE peur (stock seul) — à ne pas laisser en combat.
//   TTK_HALF : où est le "milieu" de g (g = 0.5 à ttk = TTK_HALF). Monter -> les seuils
//              lointains (3-4 rounds) paient aussi ; descendre -> seuls les kills
//              imminents comptent.
global W_TTK = 400.0
global TTK_HALF = 2.0

// Dissuasion du damage return : le terme d'un porteur gagne DR_RETURN_EXPECT · physRatio
// (équipe adverse) · min(net, LIFE) · DR/100 — la menace qui lui arrive se convertit en
// retours que ses attaquants saigneront (ScoringClass.drDeterrence). Facteur de confiance,
// même philosophie que HEAL_COEF.
global DR_RETURN_EXPECT = 0.4

// Shields "au repos" (dans capability, memo-safe) : le net ne paie les shields que sous
// danger réel — ce petit terme donne au shield préventif son ticket d'exploration quand il
// n'y a rien de mieux à faire. NON clampé : une vulné (shield négatif) paie le même canal
// en sens inverse (déshabiller un ennemi score même sans allié pour en profiter).
global W_IDLE_ABS = 0.2   // par point de shield absolu
global W_IDLE_REL = 1.0   // par % de shield relatif

// Coût de cast à la main pour quelques items d'économie : soustrait au SCORE du nœud qui
// les caste (coût d'ACTION porté par le chemin, hors TERMS). L'item doit rapporter PLUS que
// son coût pour partir maintenant — Régé (une fois par combat) exige un vrai gros payoff,
// Antidote un vrai poison à nettoyer, Manumission de vrais shackles.
global CAST_COST = [
	CHIP_REGENERATION: 100,
	CHIP_ANTIDOTE: 10,
	CHIP_MANUMISSION: 2
]

// Poison antidote-aware : la pression POT utilise effPot = coef(entité)·POT, avec
// coef = 1/(1 + POISON_CLEANSE_W · protection). protection = son antidote 1/(1+cd) + chaque
// porteur allié 1/(1+cd) DILUÉ par le nombre de coéquipiers qu'il couvre (un antidote
// nettoie ~une cible par cycle de cd de 4 tours — un porteur seul couvrant 4 protège chacun
// à 1/4 : le poison garde ~80% de sa valeur là-bas, ~35% contre une équipe full-antidote).
// Monter => dévaloriser le poison plus fort contre les équipes couvertes.
global POISON_CLEANSE_W = 1.0
