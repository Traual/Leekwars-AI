/*
 * Réglages du score Astra. Unité : le PV.
 * Les fonctions par stat sont dans Coefficients.leek ; entityValue fait leur somme.
 * Les règles du moteur ne sont pas des paramètres. Les valeurs ci-dessous sont des
 * hypothèses stratégiques explicites, à affiner en observant les combats.
 */
include("../includes.leek")

// Présence = petit bonus vivant + une fraction du potentiel du kit de base.
// Les caractéristiques de base ne sont pas ajoutées une seconde fois : leurs
// buffs/entraves sont comptés par différence à BASE_STATS, cf. Scoring.leek.
global SCORE_ALIVE_LEEK = 200
global SCORE_ALIVE_SUMMON = 40
global SCORE_CAPACITY_WEIGHT = 0.30
global SCORE_CAPACITY_CAP = 600
global SCORE_VICTORY = 10000000

// Valeur d'une production future, pondérée par la disponibilité et le budget du kit.
global SCORE_FUTURE_TURNS = 0.65
global SCORE_SUMMON_OPTION = 0.15
global SCORE_MAX_LIFE = 0.12
global SCORE_ATTRIBUTE_EXCHANGE = 0.5
// Conversions de secours pour la science des buffs et la magie des entraves.
// Le prix des PT/PM du porteur est calculé depuis son propre kit.
global SCORE_TP_EXCHANGE = 30
global SCORE_MP_EXCHANGE = 15
global SCORE_TP_CAP = 100
global SCORE_MP_CAP = 18
global SCORE_MP_TO_TP = 0.20

// Un plan d'attaque par ennemi, réparti entre les cibles alliées.
// Les impacts multiples restent séparés.
global SCORE_ENEMY_ACTIVITY = 0.65
global SCORE_MAX_INCOMING_HITS = 12
global SCORE_HEAL_RESERVE = 0.25
global SCORE_STEAL_USE = 0.35
global SCORE_RETURN_USE = 0.60

// Le prochain tick vaut 1 ; les suivants sont décotés, puis plafonnés par les PV
// affectables. Les immunités et le soin excédentaire ne produisent pas de crédit.
global SCORE_POISON_TAIL = 0.30
global SCORE_AFTER_TAIL = 0.70
global SCORE_HEAL_TAIL = 0.55

// Placement terminal seulement : aucun chargement de danger ajouté aux nœuds.
// La pression est moins diluée quand je suis seul.
global EXPOSURE_FACTOR = 0.05
global SCORE_SOLO_EXPOSURE = 0.65
global SCORE_SPATIAL_SCALE = 20
// Contexte figé, pas des paramètres à régler.
global SCORE_ENEMY_DISTANCE = 1
global SCORE_ALLY_DISTANCE = 3
global SCORE_PLACEMENT_LIFE = 1

// Hors score : facteurs des cartes existantes et sentinelle « simuler l'action ».
global DANGER_COEF = 1.0
global HEAL_COEF = 1.0
global BOUND_MUST_SIMULATE = 1000000000

include("Coefficients.leek")
