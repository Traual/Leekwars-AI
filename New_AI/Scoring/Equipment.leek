// Rendements de l'inventaire, indépendants des actions déjà simulées.
include("../includes.leek")

// Inventaire immuable pendant la recherche. Reset au tour suivant : les identifiants
// virtuels des invocations peuvent alors désigner d'autres inventaires.
global EQUIPMENT_STRENGTH_YIELD = [:]
global EQUIPMENT_DAMAGE_RETURN_YIELD = [:]
global EQUIPMENT_HEAL_YIELD = [:]
global EQUIPMENT_BOOST_MAX_LIFE_YIELD = [:]
global EQUIPMENT_ABSOLUTE_SHIELD_YIELD = [:]
global EQUIPMENT_RELATIVE_SHIELD_YIELD = [:]
global EQUIPMENT_POISON_YIELD = [:]
global EQUIPMENT_SHACKLE_STRENGTH_YIELD = [:]
global EQUIPMENT_SHACKLE_MAGIC_YIELD = [:]
global EQUIPMENT_SHACKLE_AGILITY_YIELD = [:]
global EQUIPMENT_SHACKLE_WISDOM_YIELD = [:]
global EQUIPMENT_SHACKLE_TP_YIELD = [:]
global EQUIPMENT_SHACKLE_MP_YIELD = [:]
global EQUIPMENT_BUFF_STRENGTH_YIELD = [:]
global EQUIPMENT_BUFF_AGILITY_YIELD = [:]
global EQUIPMENT_BUFF_WISDOM_YIELD = [:]
global EQUIPMENT_BUFF_RESISTANCE_YIELD = [:]
global EQUIPMENT_BUFF_TP_YIELD = [:]
global EQUIPMENT_BUFF_MP_YIELD = [:]
global EQUIPMENT_NOVA_VITALITY_YIELD = [:]
global EQUIPMENT_AFTEREFFECT_YIELD = [:]
global EQUIPMENT_NOVA_DAMAGE_YIELD = [:]
global EQUIPMENT_CAN_USE_SCIENCE = [:]
global EQUIPMENT_LIFE_DAMAGE_YIELD = [:]
global EQUIPMENT_CAN_USE_POWER = [:]
global EQUIPMENT_CAN_USE_STRENGTH = [:]
global EQUIPMENT_CAN_USE_DAMAGE_RETURN = [:]
global EQUIPMENT_CAN_USE_WISDOM = [:]
global EQUIPMENT_CAN_USE_RESISTANCE = [:]
global EQUIPMENT_CAN_USE_MAGIC = [:]

class EquipmentYield {
    LEEKS
    SUMMONS

    constructor(leeks, summons) {
        this.LEEKS = leeks
        this.SUMMONS = summons
    }
}

class Equipment {
    // Dégâts physiques de base moyens par PT, sur UNE cible ennemie au centre de la zone.
    // Châtiment (LIFE_DAMAGE), poison, nova et passifs ne dépendent pas directement de la
    // force comme DAMAGE. Les dégâts sur soi sont exclus.
    static strengthYield(stat) { return effectYield(stat, EFFECT_DAMAGE, EQUIPMENT_STRENGTH_YIELD, true) }
    // Renvoi de base moyen par PT. Le renvoi déjà présent sur le porteur n'entre pas ici :
    // seul son équipement lançable compte, sans durée du renvoi.
    static damageReturnYield(stat) { return effectYield(stat, EFFECT_DAMAGE_RETURN, EQUIPMENT_DAMAGE_RETURN_YIELD, false) }
    // Soin de base moyen par PT (EFFECT_HEAL, instantané ou par tour), multiplié par la sagesse.
    // Le soin brut, indépendant de la sagesse, n'entre pas.
    static healYield(stat) { return effectYield(stat, EFFECT_HEAL, EQUIPMENT_HEAL_YIELD, false) }
    // Vitalité de base moyenne par PT (EFFECT_BOOST_MAX_LIFE), multipliée par la sagesse.
    static boostMaxLifeYield(stat) { return effectYield(stat, EFFECT_BOOST_MAX_LIFE, EQUIPMENT_BOOST_MAX_LIFE_YIELD, false) }
    // Bouclier absolu de base moyen par PT, en PV, multiplié par la résistance.
    static absoluteShieldYield(stat) { return effectYield(stat, EFFECT_ABSOLUTE_SHIELD, EQUIPMENT_ABSOLUTE_SHIELD_YIELD, false) }
    // Bouclier relatif de base moyen par PT, en %, multiplié par la résistance.
    static relativeShieldYield(stat) { return effectYield(stat, EFFECT_RELATIVE_SHIELD, EQUIPMENT_RELATIVE_SHIELD_YIELD, false) }

    // Effets multipliés par la magie, tous lancés sur un ennemi : poison et les six entraves.
    static poisonYield(stat) { return effectYield(stat, EFFECT_POISON, EQUIPMENT_POISON_YIELD, true) }
    static shackleStrengthYield(stat) { return effectYield(stat, EFFECT_SHACKLE_STRENGTH, EQUIPMENT_SHACKLE_STRENGTH_YIELD, true) }
    static shackleMagicYield(stat) { return effectYield(stat, EFFECT_SHACKLE_MAGIC, EQUIPMENT_SHACKLE_MAGIC_YIELD, true) }
    static shackleAgilityYield(stat) { return effectYield(stat, EFFECT_SHACKLE_AGILITY, EQUIPMENT_SHACKLE_AGILITY_YIELD, true) }
    static shackleWisdomYield(stat) { return effectYield(stat, EFFECT_SHACKLE_WISDOM, EQUIPMENT_SHACKLE_WISDOM_YIELD, true) }
    static shackleTpYield(stat) { return effectYield(stat, EFFECT_SHACKLE_TP, EQUIPMENT_SHACKLE_TP_YIELD, true) }
    static shackleMpYield(stat) { return effectYield(stat, EFFECT_SHACKLE_MP, EQUIPMENT_SHACKLE_MP_YIELD, true) }

    // Effets multipliés par la science : les buffs et la vitalité nova sur un allié,
    // le contrecoup et les dégâts nova sur un ennemi.
    static buffStrengthYield(stat) { return effectYield(stat, EFFECT_BUFF_STRENGTH, EQUIPMENT_BUFF_STRENGTH_YIELD, false) }
    static buffAgilityYield(stat) { return effectYield(stat, EFFECT_BUFF_AGILITY, EQUIPMENT_BUFF_AGILITY_YIELD, false) }
    static buffWisdomYield(stat) { return effectYield(stat, EFFECT_BUFF_WISDOM, EQUIPMENT_BUFF_WISDOM_YIELD, false) }
    static buffResistanceYield(stat) { return effectYield(stat, EFFECT_BUFF_RESISTANCE, EQUIPMENT_BUFF_RESISTANCE_YIELD, false) }
    static buffTpYield(stat) { return effectYield(stat, EFFECT_BUFF_TP, EQUIPMENT_BUFF_TP_YIELD, false) }
    static buffMpYield(stat) { return effectYield(stat, EFFECT_BUFF_MP, EQUIPMENT_BUFF_MP_YIELD, false) }
    static novaVitalityYield(stat) { return effectYield(stat, EFFECT_NOVA_VITALITY, EQUIPMENT_NOVA_VITALITY_YIELD, false) }
    static aftereffectYield(stat) { return effectYield(stat, EFFECT_AFTEREFFECT, EQUIPMENT_AFTEREFFECT_YIELD, true) }
    static novaDamageYield(stat) { return effectYield(stat, EFFECT_NOVA_DAMAGE, EQUIPMENT_NOVA_DAMAGE_YIELD, true) }

    // Châtiment : dégâts proportionnels à la vie du lanceur, multipliés par la puissance.
    static lifeDamageYield(stat) { return effectYield(stat, EFFECT_LIFE_DAMAGE, EQUIPMENT_LIFE_DAMAGE_YIELD, true) }

    // Verdicts « l'équipement peut-il servir cette stat », mis en cache : le scoring les
    // interroge à chaque nœud, les rendements détaillés ne sont relus qu'au premier appel.
    // Vrai si l'équipement peut lancer une attaque physique, sur poireaux ou invocations.
    static canUseStrength(stat) {
        var key = stat.ID * 2 + (stat instanceof BulbState ? 1 : 0)
        if (key in EQUIPMENT_CAN_USE_STRENGTH) return EQUIPMENT_CAN_USE_STRENGTH[key]
        var result = anyYield([strengthYield(stat)])
        EQUIPMENT_CAN_USE_STRENGTH[key] = result
        return result
    }
    // Vrai si l'équipement peut lancer un renvoi, sur poireaux ou invocations.
    static canUseDamageReturn(stat) {
        var key = stat.ID * 2 + (stat instanceof BulbState ? 1 : 0)
        if (key in EQUIPMENT_CAN_USE_DAMAGE_RETURN) return EQUIPMENT_CAN_USE_DAMAGE_RETURN[key]
        var result = anyYield([damageReturnYield(stat)])
        EQUIPMENT_CAN_USE_DAMAGE_RETURN[key] = result
        return result
    }
    // Vrai si l'équipement peut lancer un soin ou de la vitalité, sur poireaux ou invocations.
    static canUseWisdom(stat) {
        var key = stat.ID * 2 + (stat instanceof BulbState ? 1 : 0)
        if (key in EQUIPMENT_CAN_USE_WISDOM) return EQUIPMENT_CAN_USE_WISDOM[key]
        var result = anyYield([healYield(stat), boostMaxLifeYield(stat)])
        EQUIPMENT_CAN_USE_WISDOM[key] = result
        return result
    }
    // Vrai si l'équipement peut lancer un bouclier absolu ou relatif, sur poireaux ou invocations.
    static canUseResistance(stat) {
        var key = stat.ID * 2 + (stat instanceof BulbState ? 1 : 0)
        if (key in EQUIPMENT_CAN_USE_RESISTANCE) return EQUIPMENT_CAN_USE_RESISTANCE[key]
        var result = anyYield([absoluteShieldYield(stat), relativeShieldYield(stat)])
        EQUIPMENT_CAN_USE_RESISTANCE[key] = result
        return result
    }
    // Vrai si l'équipement peut lancer un poison ou une entrave, sur poireaux ou invocations.
    static canUseMagic(stat) {
        var key = stat.ID * 2 + (stat instanceof BulbState ? 1 : 0)
        if (key in EQUIPMENT_CAN_USE_MAGIC) return EQUIPMENT_CAN_USE_MAGIC[key]
        var result = anyYield([poisonYield(stat), shackleStrengthYield(stat), shackleMagicYield(stat), shackleAgilityYield(stat),
                                     shackleWisdomYield(stat), shackleTpYield(stat), shackleMpYield(stat)])
        EQUIPMENT_CAN_USE_MAGIC[key] = result
        return result
    }

    // Vrai si l'équipement peut lancer un buff, une vitalité nova, un contrecoup ou des dégâts
    // nova, sur poireaux ou invocations.
    static canUseScience(stat) {
        var key = stat.ID * 2 + (stat instanceof BulbState ? 1 : 0)
        if (key in EQUIPMENT_CAN_USE_SCIENCE) return EQUIPMENT_CAN_USE_SCIENCE[key]
        var result = anyYield([buffStrengthYield(stat), buffAgilityYield(stat), buffWisdomYield(stat), buffResistanceYield(stat),
                               buffTpYield(stat), buffMpYield(stat), novaVitalityYield(stat), aftereffectYield(stat),
                               novaDamageYield(stat)])
        EQUIPMENT_CAN_USE_SCIENCE[key] = result
        return result
    }

    // Vrai si l'équipement peut lancer un effet multiplié par la puissance, sur poireaux ou
    // invocations : dégâts, châtiment, dégâts nova ou poison.
    static canUsePower(stat) {
        var key = stat.ID * 2 + (stat instanceof BulbState ? 1 : 0)
        if (key in EQUIPMENT_CAN_USE_POWER) return EQUIPMENT_CAN_USE_POWER[key]
        var result = anyYield([strengthYield(stat), lifeDamageYield(stat), novaDamageYield(stat), poisonYield(stat)])
        EQUIPMENT_CAN_USE_POWER[key] = result
        return result
    }

    // Vrai si au moins un rendement est non nul, sur poireaux ou invocations.
    static anyYield(yieldsList) {
        for (var yields in yieldsList) {
            if (yields.LEEKS != 0 || yields.SUMMONS != 0) return true
        }
        return false
    }

    // Valeur de base moyenne par PT d'un type d'effet, sur UNE cible au centre de la zone.
    // Renvoie un EquipmentYield : meilleur item par type de cible, sans additionner les items.
    // onEnemies : effet lancé sur un ennemi, ceux sur soi exclus. Sinon sur un allié, et un
    // effet sur le lanceur compte pour le porteur lui-même, selon son profil.
    // Ni stat, puissance, critique, ni multiplication de zone. Coût nominal : on ignore
    // équipement de l'arme, cooldowns, limites d'usage et portée. Un cache par type d'effet.
    static effectYield(stat, effectType, cache, onEnemies) {
        // Une invocation simulée et une vraie peuvent partager un ID après un cast réel.
        var key = stat.ID * 2 + (stat instanceof BulbState ? 1 : 0)
        if (key in cache) return cache[key]
        var bestLeek = 0
        var bestSummon = 0
        for (var item in stat.INVENTORY) {
            var info = ITEMINFO[item]
            if (info == null || info.COST <= 0) continue
            var leekValue = 0
            var summonValue = 0
            for (var eff in info.EFFECTS) {
                if (eff[0] != effectType) continue
                // getChipEffects/getWeaponEffects renvoient minimum et maximum.
                var value = (eff[1] + eff[2]) / 2
                if (eff[5] & EFFECT_MODIFIER_ON_CASTER) {
                    if (onEnemies) continue
                    if (stat.IS_SUMMON) summonValue += value
                    else leekValue += value
                } else if (eff[4] & (onEnemies ? EFFECT_TARGET_ENEMIES : EFFECT_TARGET_ALLIES)) {
                    if (eff[4] & EFFECT_TARGET_NON_SUMMONS) leekValue += value
                    if (eff[4] & EFFECT_TARGET_SUMMONS) summonValue += value
                }
            }
            bestLeek = max(bestLeek, leekValue / info.COST)
            bestSummon = max(bestSummon, summonValue / info.COST)
        }
        var best = new EquipmentYield(bestLeek, bestSummon)
        cache[key] = best
        return best
    }
}
