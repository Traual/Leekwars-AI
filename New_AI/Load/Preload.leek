/**
 * Preload Class (turn 1)
**/

include("../includes.leek")

class Preload {
    static InitEverything() {
        InitItemInfo()
		InitItemValues()
		InitCellClass()
		InitStateClass()
    }

    static InitItemInfo() {
		for (var i = 0; i < 500; i++) {
			ITEMINFO[i] = [: ]
			var Iinfo = new ItemClass(i)
			ITEMINFO[i] = Iinfo
		}
	}

	/**
	 * Precompute ITEM_VALUE[itemId] for every item.
	 * Used by getMyCooldownScore: "potential stored in this item across turns".
	 * Heuristic v1 : item_value = COST × 10 × (1 + COOLDOWN / 10).
	 *   - High-cost items (Régen, Sérum, Foudre) get more weight.
	 *   - High-CD items get an extra premium (they're "reserves").
	 * Items without info / 0 cost get 0. Tunable later, replace by per-effect or MLP.
	 */
	static InitItemValues() {
		for (var i = 0; i < 500; i++) {
			var Info = ITEMINFO[i]
			if (Info == null || Info.COST == null || Info.COST <= 0) {
				ITEM_VALUE[i] = 0
				continue
			}
			var baseValue = Info.COST * 10
			var cdPremium = 1 + Info.COOLDOWN / 10
			ITEM_VALUE[i] = baseValue * cdPremium
		}
	}

	static InitCellClass() {
		for (var c = 0; c < 613; c++) {
			TMPOBSTACLES[c] = isObstacle(c)
			CELL_Y[c] = getCellY(c)
			CELL_X[c] = getCellX(c)
		}
		// Pre-compute (couple, bitmask) for every cell. Layout:
		//   couple = floor(cell / 35) ; rem = cell % 35
		//   rem < 18  -> even line, bit = rem        (bits 0-17)
		//   rem >= 18 -> odd  line, bit = 24+rem-18  (bits 24-40)
		for (var c = 0; c < 613; c++) {
			var rem = c % 35
			var oddLine = rem >= 18 ? 1 : 0
			var pos = rem - (oddLine * 18)
			push(MAP_CELL_TO_COUPLE, floor(c / 35))
			push(MAP_CELL_TO_BITMASK, 1 << (oddLine == 0 ? pos : (24 + pos)))
		}
		// MAP_OBSTACLES_CACHE = obstacle-only baseline (no entities). 18 ints packed-couple.
		// Per-call BFS clones this and subtracts the live leekcells.
		for (var i = 0; i < 17; i++) MAP_OBSTACLES_CACHE[i] = 262143 | (131071 << 24)
		MAP_OBSTACLES_CACHE[17] = 262143
		for (var x in OBSTACLES_ARRAY) MAP_OBSTACLES_CACHE[MAP_CELL_TO_COUPLE[x]] -= MAP_CELL_TO_BITMASK[x]

		// CELL_BY_LSB[couple][lsb_value] = cell id (single-bit -> cell decode for bit-iteration emit).
		// 18 + 17 = 35 bits per couple; couple 17 only has the even half.
		for (var c = 0; c < 18; c++) {
			var m = [:]
			var base = c * 35
			m[1] = base; m[2] = base + 1; m[4] = base + 2; m[8] = base + 3
			m[16] = base + 4; m[32] = base + 5; m[64] = base + 6; m[128] = base + 7
			m[256] = base + 8; m[512] = base + 9; m[1024] = base + 10
			m[2048] = base + 11; m[4096] = base + 12; m[8192] = base + 13
			m[16384] = base + 14; m[32768] = base + 15; m[65536] = base + 16
			m[131072] = base + 17
			if (c < 17) {
				m[16777216] = base + 18; m[33554432] = base + 19
				m[67108864] = base + 20; m[134217728] = base + 21
				m[268435456] = base + 22; m[536870912] = base + 23
				m[1073741824] = base + 24; m[2147483648] = base + 25
				m[4294967296] = base + 26; m[8589934592] = base + 27
				m[17179869184] = base + 28; m[34359738368] = base + 29
				m[68719476736] = base + 30; m[137438953472] = base + 31
				m[274877906944] = base + 32; m[549755813888] = base + 33
				m[1099511627776] = base + 34
			}
			push(CELL_BY_LSB, m)
		}
		for (var c = 0; c < 613; c++) {
			var cInfo = new CellClass(c)
			ALLCELLINFO[c] = cInfo
		}
	}

	static InitStateClass() {
		Me = getEntity()
		BASE_INVENTORY = getWeapons(Me) + getChips(Me)
		MY_INVENTORY_ON_ME = ActionsClass.getInventoryOnMe(BASE_INVENTORY, new EntityStateClass(Me))
		MY_INVENTORY_ON_VOID = ActionsClass.getInventoryOnVoid(BASE_INVENTORY)
		MY_INVENTORY_SUMMON = ActionsClass.getInventorySummon(BASE_INVENTORY)
		MY_INVENTORY_ON_EVERYONE = ActionsClass.getInventoryOnEveryOne(BASE_INVENTORY)
		// Cheapest item TP cost — used by ActionSuite.findBestNextNode to bail out early
		// when remaining TP is below any usable item's cost.
		var cheapest = 100
		for (var i in BASE_INVENTORY) {
			var c = isChip(i) ? getChipCost(i) : getWeaponCost(i)
			if (c < cheapest) cheapest = c
		}
		MINIMUM_COST_ITEM = cheapest
	}
}