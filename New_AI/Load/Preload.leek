/*
 * Préchargements : constantes d'items/cellules au tour 1, et l'init d'état de chaque tour.
 */

include("../includes.leek")

class Preload {
	/*
	 * Préchargements du tour 1 UNIQUEMENT : catalogue d'items, géométrie statique et ordre
	 * initial. L'état de tour (Me, inventaires, MINIMUM_COST_ITEM, SUMMON_ID_BASE) est le
	 * travail d'InitStateClass, que Main exécute APRÈS ReloadCacheNewTurn — l'appeler ici
	 * ferait tout ce travail deux fois au tour 1 pour un résultat aussitôt écrasé.
	 */
    static InitEverything() {
        InitItemInfo()
		// Constantes de mobilité, une fois le catalogue prêt.
		JUMP_COST = ITEMINFO[CHIP_JUMP].COST
		TELE_COST = ITEMINFO[CHIP_TELEPORTATION].COST
		JUMP_TELE_COST = JUMP_COST + TELE_COST
		JUMP_COOLDOWN = ITEMINFO[CHIP_JUMP].COOLDOWN
		TELE_COOLDOWN = ITEMINFO[CHIP_TELEPORTATION].COOLDOWN
		InitCellClass()
		InitInitialTurnOrder()
    }

	/*
	 * Proxy de l'initialOrder du moteur, capturé au tour 1 et persistant tout le combat :
	 * le resurrect du moteur parcourt les entités de DÉBUT de combat dans l'ordre de boot
	 * (jamais muté par les morts, summons exclus). Une entité déjà morte et retirée avant
	 * cette capture reste inconnue -> sa résurrection retombe sur l'ajout en fin d'ordre.
	 * Consommé par ResurrectionClass.Update.
	 */
	static InitInitialTurnOrder() {
		for (var e in getAllies() + getEnemies()) {
			if (isSummon(e)) continue
			var o = getEntityTurnOrder(e)
			if (o > 0) INITIAL_TURN_ORDER[e] = o
		}
	}

    static InitItemInfo() {
		// Catalogue moteur complet (getAllChips + getAllWeapons) : uniquement les vrais items,
		// aucune borne d'id en dur — un item récent à id haut (ex : Bazooka au plutonium, 506)
		// est couvert d'office.
		for (var i in getAllChips() + getAllWeapons()) {
			var Iinfo = new ItemClass(i)
			ITEMINFO[i] = Iinfo
			// PASSIVE_INFO[arme][type] = ligne au layout de getWeaponPassiveEffects (eff[1] =
			// value1), PAS celui des effets runtime de getEffects. Source unique des valeurs
			// de proc (rien en dur dans Consequences).
			if (Iinfo.PASSIVE_EFFECTS != null) {
				for (var eff in Iinfo.PASSIVE_EFFECTS) {
					if (!(i in PASSIVE_INFO)) PASSIVE_INFO[i] = [: ]
					PASSIVE_INFO[i][eff[0]] = eff
				}
			}
		}
	}

	/*
	 * Plateau de bits (x, y) et formes de zone, pour la dilatation d'AoE.
	 * Les bornes sont MESURÉES sur les 613 cellules, jamais supposées : x est centré par le
	 * moteur et y peut être négatif. Bande de garde de 4 de chaque côté — le plus grand
	 * décalage d'une zone vaut 3 — donc aucun bit ne sort de son mot ni ne franchit le signe.
	 */
	static InitAoeBoard() {
		var minX = 1000, maxX = -1000, minY = 1000, maxY = -1000
		for (var c = 0; c < 613; c++) {
			var x = CELL_X[c], y = CELL_Y[c]
			if (x < minX) minX = x
			if (x > maxX) maxX = x
			if (y < minY) minY = y
			if (y > maxY) maxY = y
		}
		AOEB_XOFF = 4 - minX
		AOEB_YOFF = 4 - minY
		AOEB_ROWS = maxX - minX + 9
		// Un mot par ligne : le plus haut bit utilisé est maxY + AOEB_YOFF + 3, à garder loin
		// du bit de signe pour que le décalage à droite (arithmétique) reste inoffensif.
		if (maxY + AOEB_YOFF + 4 > 60) debugE("plateau d'AoE : plage de y trop large")
		AOEB_FREE = []
		AOEB_CELL_BY_BIT = []
		AOEB_ZERO = []
		for (var i = 0; i < AOEB_ROWS; i++) {
			push(AOEB_FREE, 0)
			push(AOEB_ZERO, 0)
			push(AOEB_CELL_BY_BIT, [: ])
		}
		AOEB_ROW_OF = []
		AOEB_BIT_OF = []
		for (var c = 0; c < 613; c++) {
			// Une cellule bloquée prend (0, 0) : jamais lue, mais l'indexation reste directe.
			if (TMPOBSTACLES[c]) {
				push(AOEB_ROW_OF, 0)
				push(AOEB_BIT_OF, 0)
				continue
			}
			var row = CELL_X[c] + AOEB_XOFF
			var bit = 1 << (CELL_Y[c] + AOEB_YOFF)
			AOEB_FREE[row] |= bit
			AOEB_CELL_BY_BIT[row][bit] = c
			push(AOEB_ROW_OF, row)
			push(AOEB_BIT_OF, bit)
		}
		InitAoeShapes()
	}

	/*
	 * Décalages de chaque zone, TRIÉS par distance d'AoE croissante, centre exclu. La distance
	 * est celle que produit getAreaDist : |dx| + |dy|, quelle que soit la forme.
	 *   CIRCLE_n / PLUS_1 : boule de Manhattan de rayon n ;
	 *   SQUARE_n          : boule de Chebyshev de rayon n (distance jusqu'à 2n) ;
	 *   PLUS_n            : les quatre rayons d'axe jusqu'à n ;
	 *   X_n               : les quatre diagonales, par pas de 1 en (dx, dy) donc de 2 en distance.
	 * L'ordre croissant est ce qui rend le minimum correct sans repasse : la première fois
	 * qu'une cellule est atteinte, c'est par sa plus petite distance.
	 */
	static InitAoeShapes() {
		AOEB_SHAPE = [: ]
		AOEB_SHAPE[AREA_CIRCLE_1] = manhattanShape(1)
		AOEB_SHAPE[AREA_CIRCLE_2] = manhattanShape(2)
		AOEB_SHAPE[AREA_CIRCLE_3] = manhattanShape(3)
		AOEB_SHAPE[AREA_PLUS_1] = manhattanShape(1)   // alias moteur de CIRCLE_1, même forme
		AOEB_SHAPE[AREA_SQUARE_1] = chebyshevShape(1)
		AOEB_SHAPE[AREA_SQUARE_2] = chebyshevShape(2)
		AOEB_SHAPE[AREA_PLUS_2] = crossShape(2)
		AOEB_SHAPE[AREA_PLUS_3] = crossShape(3)
		AOEB_SHAPE[AREA_X_1] = diagonalShape(1)
		AOEB_SHAPE[AREA_X_2] = diagonalShape(2)
		AOEB_SHAPE[AREA_X_3] = diagonalShape(3)
	}

	/* Boule de Manhattan de rayon r, par distance croissante, centre exclu. */
	static manhattanShape(r) {
		var out = []
		for (var d = 1; d <= r; d++) {
			for (var dx = -d; dx <= d; dx++) {
				var dy = d - abs(dx)
				pushOffset(out, dx, dy, d)
				if (dy != 0) pushOffset(out, dx, -dy, d)
			}
		}
		return out
	}

	/* Boule de Chebyshev de rayon r : distance |dx| + |dy| jusqu'à 2r, centre exclu. */
	static chebyshevShape(r) {
		var out = []
		for (var d = 1; d <= 2 * r; d++) {
			for (var dx = -r; dx <= r; dx++) {
				for (var dy = -r; dy <= r; dy++) {
					if (abs(dx) + abs(dy) == d) pushOffset(out, dx, dy, d)
				}
			}
		}
		return out
	}

	/* Les quatre rayons d'axe jusqu'à r : distance = le rayon, centre exclu. */
	static crossShape(r) {
		var out = []
		for (var d = 1; d <= r; d++) {
			pushOffset(out, d, 0, d)
			pushOffset(out, -d, 0, d)
			pushOffset(out, 0, d, d)
			pushOffset(out, 0, -d, d)
		}
		return out
	}

	/* Les quatre diagonales jusqu'à r pas : distance = 2 fois le pas, centre exclu. */
	static diagonalShape(r) {
		var out = []
		for (var i = 1; i <= r; i++) {
			pushOffset(out, i, i, 2 * i)
			pushOffset(out, i, -i, 2 * i)
			pushOffset(out, -i, i, 2 * i)
			pushOffset(out, -i, -i, 2 * i)
		}
		return out
	}

	static pushOffset(out, dx, dy, dist) {
		push(out, dx)
		push(out, dy)
		push(out, dist)
	}

	static InitCellClass() {
		for (var c = 0; c < 613; c++) {
			var obs = isObstacle(c)
			var x = getCellX(c)
			var y = getCellY(c)
			push(TMPOBSTACLES, obs)
			push(CELL_X, x)
			push(CELL_Y, y)
			var idx = x * 1024 + y
			push(CELL_BASE, idx)
			if (!obs) XY_FREE[idx] = c
		}
		// Bien au-delà de la plus grande distance de zone du jeu (6, pour AREA_X_3).
		AOE_FALLOFF = []
		for (var d = 0; d <= 31; d++) push(AOE_FALLOFF, 1 - d * 0.2)
		InitAoeBoard()
		// (couple, bitmask) précalculés pour chaque cellule. Layout :
		//   couple = floor(cell / 35) ; rem = cell % 35
		//   rem < 18  -> ligne paire,   bit = rem        (bits 0-17)
		//   rem >= 18 -> ligne impaire, bit = 24+rem-18  (bits 24-40)
		for (var c = 0; c < 613; c++) {
			var rem = c % 35
			var oddLine = rem >= 18 ? 1 : 0
			var pos = rem - (oddLine * 18)
			push(MAP_CELL_TO_COUPLE, floor(c / 35))
			push(MAP_CELL_TO_BITMASK, 1 << (oddLine == 0 ? pos : (24 + pos)))
		}
		// MAP_OBSTACLES_CACHE = baseline obstacles seuls (18 ints packés). Les BFS clonent
		// cette base et y soustraient les cellules occupées.
		for (var i = 0; i < 17; i++) MAP_OBSTACLES_CACHE[i] = 262143 | (131071 << 24)
		MAP_OBSTACLES_CACHE[17] = 262143
		for (var x in OBSTACLES_ARRAY) MAP_OBSTACLES_CACHE[MAP_CELL_TO_COUPLE[x]] -= MAP_CELL_TO_BITMASK[x]

		// CELL_BY_LSB[couple][valeur du bit] = id de cellule (décodage bit -> cellule).
		// 18 + 17 = 35 bits par couple ; le couple 17 n'a que la moitié paire.
		for (var c = 0; c < 18; c++) {
			var m = [:]
			var base = c * 35
			m[1] = base; m[2] = base + 1; m[4] = base + 2; m[8] = base + 3
			m[16] = base + 4; m[32] = base + 5; m[64] = base + 6; m[128] = base + 7
			m[256] = base + 8; m[512] = base + 9; m[1024] = base + 10
			m[2048] = base + 11; m[4096] = base + 12; m[8192] = base + 13
			m[16384] = base + 14; m[32768] = base + 15; m[65536] = base + 16
			m[131072] = base + 17
			if (c < 17) {
				m[16777216] = base + 18; m[33554432] = base + 19
				m[67108864] = base + 20; m[134217728] = base + 21
				m[268435456] = base + 22; m[536870912] = base + 23
				m[1073741824] = base + 24; m[2147483648] = base + 25
				m[4294967296] = base + 26; m[8589934592] = base + 27
				m[17179869184] = base + 28; m[34359738368] = base + 29
				m[68719476736] = base + 30; m[137438953472] = base + 31
				m[274877906944] = base + 32; m[549755813888] = base + 33
				m[1099511627776] = base + 34
			}
			push(CELL_BY_LSB, m)
		}
	}

	static InitStateClass() {
		Me = getEntity()
		BASE_INVENTORY = getWeapons(Me) + getChips(Me)
		var myStateOnMe = new EntityStateClass(Me)
		MY_INVENTORY_ON_ME = ActionsClass.getInventoryOnMe(BASE_INVENTORY, myStateOnMe)
		MY_INVENTORY_ON_VOID = ActionsClass.getInventoryOnVoid(BASE_INVENTORY)
		MY_INVENTORY_SUMMON = ActionsClass.getInventorySummon(BASE_INVENTORY)
		MY_INVENTORY_ON_EVERYONE = ActionsClass.getInventoryOnEveryOne(BASE_INVENTORY)
		// Coût TP de l'item jouable le moins cher — le BFS coupe court quand les TP restants
		// passent dessous. Cooldown-aware : mes cooldowns ne font que MONTER pendant mon tour,
		// donc exclure les items en cooldown resserre la borne et reste valide toute la
		// recherche.
		var cheapest = 100
		for (var i in BASE_INVENTORY) {
			if (StateClass.cooldownOf(myStateOnMe, i) > 0) continue
			var c = isChip(i) ? getChipCost(i) : getWeaponCost(i)
			if (c < cheapest) cheapest = c
		}
		MINIMUM_COST_ITEM = cheapest
		I_HAVE_RESURRECTION = StateClass.hasInventoryItem(myStateOnMe, CHIP_RESURRECTION)
		// Base des ids VIRTUELS du tour = max des ids RÉELS, capturé une fois. Id de bulbe =
		// SUMMON_ID_BASE + offset de type : un id donné correspond à UN type de bulbe pour tout
		// le tour, quel que soit l'ordre des summons entre branches (les caches clés par id
		// seul ne peuvent pas collisionner entre types).
		var maxRealId = 0
		for (var i in getAllies() + getEnemies()) if (i > maxRealId) maxRealId = i
		SUMMON_ID_BASE = maxRealId
	}
}
