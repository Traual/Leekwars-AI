// Coût TP minimal de l'inventaire (court-circuite l'expansion quand il ne reste plus assez).
global MINIMUM_COST_ITEM
global SUMMON_ID_BASE = 0   // max des ids RÉELS au début du tour ; id de bulbe virtuel = base + offset de type (Preload.InitStateClass)

// Id sentinelle "personne" pour les fonctions à entité-à-skipper (placement des summons :
// le bulbe n'est pas encore dans le State). > tout id réel ; ni -1 ni null, qui casseraient
// les clés bit-packées.
global ID_NOBODY = 1000

// HASH

global MAX_CELL_BINARY = 11
global MAX_AOE_DIST_BINARY = 3

global MAX_VALUE = 9223372036854775807
global OFFSET_BASIS = 1469598103934665603
global SHIFT = 13
global HIGH_SHIFT = 64 - SHIFT
global MASK_HIGH = (1 << SHIFT) - 1

/* Chaînage de hash : rotation 13 bits + XOR de la nouvelle valeur. LINÉAIRE — pour un fold
 * XOR composable, passer par mix64 ci-dessous. */
function addValueToBinHash(BaseHashValue, AddedValue) {
    return ((BaseHashValue << SHIFT) | ((BaseHashValue >> HIGH_SHIFT) & MASK_HIGH)) ^ AddedValue
}

// mix64 : mixeur 64 bits non linéaire (finaliseur type splitmix64) pour les folds XOR
// COMPOSABLES. addValueToBinHash est linéaire -> un fold XOR de ses sorties collisionne sur
// les échanges (deux entités qui permutent leurs cellules donnent le même hash) ; la
// MULTIPLICATION ici casse cette linéarité. Contraintes vérifiées sur LeekWars : les
// littéraux > 2^63 deviennent des FLOATS -> constantes < 2^63 ; `*` wrap mod 2^64 ; `>>` est
// ARITHMÉTIQUE (étend le signe) -> chaque shift est masqué pour émuler le logique.
global MIX_A   = 6364136223846793005    // 0x5851F42D4C957F2D, impair, < 2^63 (multiplicateur MMIX/Knuth)
global MIX_B   = 2685821657736338717    // 0x2545F4914F6CDD1D, impair, < 2^63
global MIX_M34 = 17179869183            // (1<<34)-1, masque un >>30
global MIX_M37 = 137438953471           // (1<<37)-1, masque un >>27
global MIX_M33 = 8589934591             // (1<<33)-1, masque un >>31
// Sel XORé dans POISON_KEY quand Me est mort en branche (BaseHash exclut Me, carrierFold ne
// le porte que s'il a antidote — sans ce sel, ma mort ne changerait pas la clé).
global POISON_ME_DEAD_SALT = 6148914691236517205   // 0x5555555555555555, < 2^63

function mix64(x) {
    x = (x ^ ((x >> 30) & MIX_M34)) * MIX_A
    x = (x ^ ((x >> 27) & MIX_M37)) * MIX_B
    return x ^ ((x >> 31) & MIX_M33)
}


// CONSEQUENCES
global EROSION_NO_POISON = 0.05
global EROSION_POISON = 0.10
// +10 points d'érosion sur un effet CRITIQUE (Effect.java : erosionRate += 0.10 si crit).
global EROSION_CRIT = 0.15

// JEU

global MAX_USEFUL_RELATIVE_SHIELD = 100

// Crit BINAIRE asymétrique — jamais d'espérance : chaque nombre simulé doit correspondre à
// un cast réel possible (les seuils de kill / le TTK l'exigent). Doctrine "pire cas pour
// moi", symétrique à 5% près :
//   - ce qui joue POUR moi (mes casts, heals de mes alliés) ne crite qu'à partir de
//     MIN_AGILITY_TO_FULLY_CRIT (95%+ de chance : je ne compte pas sur la chance) ;
//   - ce qui joue CONTRE moi (danger ennemi, heals des healers ennemis) est craint
//     critique dès MIN_AGILITY_ENEMY_CRIT (5% de chance suffisent à le craindre).
global MIN_AGILITY_TO_FULLY_CRIT = 950
global MIN_AGILITY_ENEMY_CRIT = 50
// Crit du cast en cours de sim — posé par getConsequences AVANT la boucle d'effets (le moteur
// roll une fois par CAST, pas par effet : Attack.applyOnCell), lu par la boucle et les
// fonctions de dégâts pour l'érosion. Transient : toujours écrit avant lecture.
global CAST_IS_CRITICAL = false
global FIGHT_TYPE = getFightType() // sert au calcul du power dans Consequences

// ============================================================================
// Champs MUTABLES d'un EntityState, indexés de façon compacte : identifiants de 0 à 30
// (le masque d'un delta est un bit-set 64 bits, 1 << id). Les champs IMMUABLES pendant la
// simulation (ID, SIDE, IS_SUMMON, SUMMONER, INVENTORY, SPECIAL_WEAPON, STATIC, NAME,
// BASE_STATS) n'en ont PAS : rien ne les écrit, rien ne les journalise.
// Toute écriture simulée doit être précédée de StateClass.touchField(stat, DELTA_X, stat.X).
// ============================================================================
global DELTA_CELL = 0
global DELTA_LIFE = 1
global DELTA_TOTAL_LIFE = 2
global DELTA_STRENGTH = 3
global DELTA_WISDOM = 4
global DELTA_AGILITY = 5
global DELTA_RESISTANCE = 6
global DELTA_SCIENCE = 7
global DELTA_MAGIC = 8
global DELTA_MP = 9
global DELTA_TOTAL_MP = 10
global DELTA_TP = 11
global DELTA_TOTAL_TP = 12
global DELTA_ABSOLUTE_SHIELD = 13
global DELTA_RELATIVE_SHIELD = 14
global DELTA_DAMAGE_RETURN = 15
global DELTA_POWER = 16
global DELTA_WEAPON = 17
global DELTA_EFFECTS = 18
global DELTA_POISON = 19
global DELTA_POISON_OVER_TIME = 20
global DELTA_AFTEREFFECT = 21
global DELTA_AFTEREFFECT_OVER_TIME = 22
global DELTA_HEAL = 23
global DELTA_HEAL_OVER_TIME = 24
global DELTA_TURN_ORDER = 25
global DELTA_COOLDOWNS = 26
global DELTA_USES = 27
global DELTA_ITEM_STATE_PARENT = 28
// Mémos dérivés : suivis UNIQUEMENT pour la restauration temporaire et l'invalidation, ils
// ne sont pas des données sémantiques du patch persistant (recalculables sur l'enfant) et
// n'entrent JAMAIS dans CHANGED.
global DELTA_CAP_MEMO = 29
global DELTA_TLSQ_MEMO = 30

// Groupes d'inputs des trois contributions incrémentales : dès qu'un de ces champs est
// touché pour la première fois, l'ancienne contribution du groupe est capturée AVANT la
// mutation (Node ne peut plus reconstruire un ancien EntityState).
global DELTA_MASK_BASE = (1 << DELTA_LIFE) | (1 << DELTA_CELL)
global DELTA_MASK_CONTEXT = (1 << DELTA_LIFE) | (1 << DELTA_CELL) | (1 << DELTA_AGILITY)
	| (1 << DELTA_STRENGTH) | (1 << DELTA_MAGIC) | (1 << DELTA_TOTAL_MP) | (1 << DELTA_TOTAL_TP)
	| (1 << DELTA_POWER)
global DELTA_MASK_HFP = (1 << DELTA_LIFE) | (1 << DELTA_CELL) | (1 << DELTA_AGILITY)
	| (1 << DELTA_WISDOM) | (1 << DELTA_TOTAL_MP) | (1 << DELTA_TOTAL_TP)

// Inputs LOCAUX du terme de scoring : vie et capital,
// cellule, retour de dégâts, six flux périodiques, et les dix inputs de capability.
global DELTA_MASK_CAPABILITY = (1 << DELTA_STRENGTH) | (1 << DELTA_MAGIC) | (1 << DELTA_WISDOM)
	| (1 << DELTA_SCIENCE) | (1 << DELTA_AGILITY) | (1 << DELTA_RESISTANCE)
	| (1 << DELTA_TOTAL_TP) | (1 << DELTA_TOTAL_MP)
	| (1 << DELTA_ABSOLUTE_SHIELD) | (1 << DELTA_RELATIVE_SHIELD)
global DELTA_MASK_LOCAL_TERM = DELTA_MASK_CAPABILITY | (1 << DELTA_LIFE) | (1 << DELTA_TOTAL_LIFE)
	| (1 << DELTA_CELL) | (1 << DELTA_DAMAGE_RETURN)
	| (1 << DELTA_POISON) | (1 << DELTA_POISON_OVER_TIME)
	| (1 << DELTA_AFTEREFFECT) | (1 << DELTA_AFTEREFFECT_OVER_TIME)
	| (1 << DELTA_HEAL) | (1 << DELTA_HEAL_OVER_TIME)

// BFS :
// Seuil de Δ sous lequel une action de base est traitée comme un no-op (skip de l'expansion
// gloutonne + early-exit des chaînes). Attrape les résidus float des chips type Antidote /
// Libération / Rémission quand aucun effet pertinent ne s'applique.
global BFS_DELTA_EPSILON = 0.01
