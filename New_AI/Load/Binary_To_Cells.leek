/**
 * Decoding lookup tables: bitmap chunks (6 bits = 64 values) -> array of cell positions.
 *
 * Each line bitmap is split into 3 chunks of 6 bits during decode (even lines: 6+6+6 = 18 bits,
 * odd lines: 6+6+5 = 17 bits). Each chunk's 64 possible values map to a precomputed array of
 * cell positions, with line-specific offsets baked in.
 *
 * BINARY_TO_CELL_BY_LINE[line][part] is the lookup table for that line's `part`-th 6-bit chunk.
 * Used by the bitmap -> cells decoding in Maps/WalkCells.leek.
 **/

global BaseMapOfConvertion = [0: [], 1: [0], 2: [1], 3: [0, 1], 4: [2], 5: [0, 2], 6: [1, 2], 7: [0, 1, 2], 8: [3], 9: [0, 3], 10: [1, 3], 11: [0, 1, 3], 12: [2, 3], 13: [0, 2, 3], 14: [1, 2, 3], 15: [0, 1, 2, 3], 16: [4], 17: [0, 4], 18: [1, 4], 19: [0, 1, 4], 20: [2, 4], 21: [0, 2, 4], 22: [1, 2, 4], 23: [0, 1, 2, 4], 24: [3, 4], 25: [0, 3, 4], 26: [1, 3, 4], 27: [0, 1, 3, 4], 28: [2, 3, 4], 29: [0, 2, 3, 4], 30: [1, 2, 3, 4], 31: [0, 1, 2, 3, 4], 32: [5], 33: [0, 5], 34: [1, 5], 35: [0, 1, 5], 36: [2, 5], 37: [0, 2, 5], 38: [1, 2, 5], 39: [0, 1, 2, 5], 40: [3, 5], 41: [0, 3, 5], 42: [1, 3, 5], 43: [0, 1, 3, 5], 44: [2, 3, 5], 45: [0, 2, 3, 5], 46: [1, 2, 3, 5], 47: [0, 1, 2, 3, 5], 48: [4, 5], 49: [0, 4, 5], 50: [1, 4, 5], 51: [0, 1, 4, 5], 52: [2, 4, 5], 53: [0, 2, 4, 5], 54: [1, 2, 4, 5], 55: [0, 1, 2, 4, 5], 56: [3, 4, 5], 57: [0, 3, 4, 5], 58: [1, 3, 4, 5], 59: [0, 1, 3, 4, 5], 60: [2, 3, 4, 5], 61: [0, 2, 3, 4, 5], 62: [1, 2, 3, 4, 5], 63: [0, 1, 2, 3, 4, 5]]

global HalvedMapOfConvertion = [0: [], 1: [0], 2: [1], 3: [0, 1], 4: [2], 5: [0, 2], 6: [1, 2], 7: [0, 1, 2], 8: [3], 9: [0, 3], 10: [1, 3], 11: [0, 1, 3], 12: [2, 3], 13: [0, 2, 3], 14: [1, 2, 3], 15: [0, 1, 2, 3], 16: [4], 17: [0, 4], 18: [1, 4], 19: [0, 1, 4], 20: [2, 4], 21: [0, 2, 4], 22: [1, 2, 4], 23: [0, 1, 2, 4], 24: [3, 4], 25: [0, 3, 4], 26: [1, 3, 4], 27: [0, 1, 3, 4], 28: [2, 3, 4], 29: [0, 2, 3, 4], 30: [1, 2, 3, 4], 31: [0, 1, 2, 3, 4]]

function AddToBaseArray(NumberAdded, BaseMapTmp) {
	var _final = clone(BaseMapTmp, 2)
	for (var bin: var list in _final) {
		for (var c = 0; c < count(list); c++) {
			list[c] += NumberAdded
		}
	}
	return _final
}

// Couple-indexed lookup tables for 35-bit packed bitmap decoding.
// Layout of the 35-bit couple bitmap:
//   bits 0-5   : chunk 0 — even cells 0-5    → BTC[c][0]
//   bits 6-11  : chunk 1 — even cells 6-11   → BTC[c][1]
//   bits 12-17 : chunk 2 — even cells 12-17  → BTC[c][2]
//   bits 18-23 : gap (always 0)
//   bits 24-29 : chunk 3 — odd cells 0-5     → BTC[c][3]
//   bits 30-35 : chunk 4 — odd cells 6-11    → BTC[c][4]
//   bits 36-40 : chunk 5 — odd cells 12-16   → BTC[c][5] (HalvedMap, only 5 bits valid)
// For the last couple (c=17, only even line 34 exists), odd chunks use empty
// arrays so they're no-ops during decode.
global BINARY_TO_CELL_BY_COUPLE = function() {
	var t = []
	// Empty chunk used for couple 17's missing odd half: every key maps to []
	var empty = [: ]
	for (var i = 0; i < 64; i++) empty[i] = []
	for (var couple = 0; couple < 18; couple++) {
		var lineE = couple << 1
		var lineO = lineE | 1
		var baseE = couple * 35
		var baseO = baseE + 18
		var chunks = [
			AddToBaseArray(baseE, BaseMapOfConvertion),     // even chunk 0
			AddToBaseArray(baseE + 6, BaseMapOfConvertion), // even chunk 1
			AddToBaseArray(baseE + 12, BaseMapOfConvertion) // even chunk 2
		]
		if (couple < 17) {
			push(chunks, AddToBaseArray(baseO, BaseMapOfConvertion))       // odd chunk 0
			push(chunks, AddToBaseArray(baseO + 6, BaseMapOfConvertion))   // odd chunk 1
			push(chunks, AddToBaseArray(baseO + 12, HalvedMapOfConvertion)) // odd chunk 2 (5 bits)
		} else {
			push(chunks, empty); push(chunks, empty); push(chunks, empty)
		}
		push(t, chunks)
	}
	return t
}()
