/**
 * Here we put cache globals
 **/

include("../includes.leek")

function ReloadCacheNewTurn() { //Simple function that refresh cache that need to be refreshed
    TARGETABLECACHE = [: ]
    MAP_CELL_ITEM_AOE_CACHE = [: ]
    CELL_DANGER_GET_CACHE = [: ]
    COMBO_FROM_ITEM_AOE_CACHE = [: ]
    HAVE_AN_HITTABLE_ITEM_CACHE = [: ]
    TO_SKIP_MAP_CACHE = [: ]
    ENTITY_DELTA_CACHE_FOR_ME = [: ]
    CELL_NETDAMAGE_FOR_ME_CACHE = [: ]
    AVERAGE_DISTANCE_FROM_ALLIES_CACHE = [: ]
    AVERAGE_DISTANCE_FROM_ENNEMIES_CACHE = [: ]
    SURVIVAL_CACHE = [: ]
    HEAL_COVERAGE_CACHE = [: ]
    HEAL_ENTITY_INVENTORY = [: ]
    IMPORTANCE_BY_ID = [: ]
    NETDAMAGE_CACHE = [: ]
    HEAL_MAP_CACHE = [: ]
    ENTITY_ACTIONS_CACHE = [: ]
    ACTIONS_ON_ME_CACHE = [: ]
    ACTIONS_SUMMON_CACHE = [: ]
    ACTIONS_ON_VOID_CACHE = [: ]

    // Must be reset each turn: cache key is (base_hash, entity_id) but the
    // stored map's contents depend on `toSkipMap`, which can change across
    // turns even for the same key (e.g. HaveAnHittableItem flips when an
    // enemy's cooldowns tick down). Cross-turn re-use of a stale map then
    // leaves `EnemyWalkCells[Caster]` null for casters that were skipped
    // previously but are live now -> crash in getMapCellItemAoe.
    EVERY_ENEMIES_WALKABLES = [: ]

    // Must be reset each turn: getItemsList keys by ID only and filters
    // cooldown > 1 at compute time — an item on cooldown at first evaluation
    // would otherwise stay excluded for the WHOLE fight even once available
    // again (danger underestimated -> walking into lethal range). The sorted
    // damage lists in DANGER_ENTITY_CACHE are built FROM that items list and
    // their key (stats + target shields) carries no cooldown info, so both
    // must be refreshed together for the new list to propagate.
    DANGER_ENTITY_INVENTORY = [: ]
    DANGER_ENTITY_CACHE = [: ]

    // Same cooldown reason, one layer UP: this outer per-(statsHash, cell) danger memo carries no
    // cooldown info in its key, so a cross-turn hit would serve pre-cooldown-refresh danger AND
    // bypass the two freshly-reset caches above entirely (static standoffs: an enemy's big chip
    // coming off cooldown would stay invisible). Reset it with them.
    ENTITY_DANGER_CACHE_FOR_OTHERS = [: ]
}

// STATE

// Keyed by the ALIVE bit-set (getHashedEntities): a resurrect flips the revived's bit, and its
// assigned order is a pure function of (INITIAL_TURN_ORDER, alive set) -> coherent by construction.
global ENTITY_SORTED_BY_TURN_ORDER_CACHE = [: ]

// Engine initialOrder proxy: fight-start entity -> its turn-1 order rank. FIGHT-PERSISTENT,
// captured once in Preload.InitInitialTurnOrder (summons excluded, like the engine's initialOrder).
// Consumed by ResurrectionClass.Update for the revived's turn order.
global INITIAL_TURN_ORDER = [: ]

// CELL CLASS

global CELL_X = [: ]
global CELL_Y = [: ]

global TMPOBSTACLES = [: ]
global ALLCELLINFO = [: ]

global DISTANCE_CACHE = [: ]
global LOS_CACHE = [: ]
global LOS_WITH_BASE_HASH_CACHE = [: ]
global FILLED_CELLS_CACHE = [: ]

global DISK_CACHE = [: ]
global CIRCLE_CACHE = [: ]
global CIRCLE_WITH_LOS_CACHE = [: ]
global DISC_WITH_LOS_CACHE = [: ]

global LINE_CACHE = [: ]
global POINTS_LINE_CACHE = [: ]
global LINE_WITH_LOS_CACHE = [: ]
global POINTS_LINE_WITH_LOS_CACHE = [: ]

global DIAGONAL_CACHE = [: ]
global POINTS_DIAGONAL_CACHE = [: ]
global DIAGONAL_WITH_LOS_CACHE = [: ]
global POINTS_DIAGONAL_WITH_LOS_CACHE = [: ]

global STAR_CACHE = [: ]
global POINTS_STAR_CACHE = [: ]
global STAR_WITH_LOS_CACHE = [: ]
global POINTS_STAR_WITH_LOS_CACHE = [: ]

global INVERTED_STAR_CACHE = [: ]
global POINTS_INVERTED_STAR_CACHE = [: ]
global INVERTED_STAR_WITH_LOS_CACHE = [: ]
global POINTS_INVERTED_STAR_WITH_LOS_CACHE = [: ]

global LASERS = [: ]

// For Item Class

global ITEMINFO = [: ]

// Target

global TARGETABLECACHE = [: ]

// Consequences

global CONSEQUENCE_TARGET_CACHE = [: ]

//Stuff for Summons :

global SUMMONER_LEVEL_TIMES = min(300, getLevel()) / 300

//For Cell Danger :

global MAP_CELL_ITEM_AOE_CACHE = [: ]
global CELL_DANGER_GET_CACHE = [: ]
global COMBO_FROM_ITEM_AOE_CACHE = [: ]
global BFS_CELL_DANGER_CACHE = [: ]
global HAVE_AN_HITTABLE_ITEM_CACHE = [: ]
global DANGER_ENTITY_CACHE = [: ]
global DANGER_ENTITY_INVENTORY = [: ]
global EVERY_ENEMIES_WALKABLES = [: ]

// BaseHash-keyed optimisation: same BaseHash -> same skip map (reset per turn).
global TO_SKIP_MAP_CACHE = [: ]

//Branch Danger Cache :

global ENTITY_DANGER_CACHE_FOR_OTHERS = [: ]

// Me's flee search caches (net delta, two levels). CELL_NETDAMAGE_FOR_ME_CACHE = net at ONE flee
// cell; ENTITY_DELTA_CACHE_FOR_ME = the whole MIN over my reachable set. Both keyed by the same
// seed = addValueToBinHash(statsHash ^ healersFP, pack(LIFE,TOTAL_LIFE)) — folded with the cell,
// resp. BaseHash + the reachable-set fingerprint (the outer MIN's domain depends on obstacles:
// an ally/bulb move shrinks my reachable cells — P2-15). Both reset per turn. (Replaces the retired
// ENTITY_DANGER_CACHE_FOR_ME — the Me danger min is now a net-delta min, computed in DeltaClass.)
global CELL_NETDAMAGE_FOR_ME_CACHE = [: ]
global ENTITY_DELTA_CACHE_FOR_ME = [: ]

//For Walkable cells / Jump Walkable cells

global WALKABLE_CACHE = [: ]
global JUMP_CACHE = [: ]
global TELEPORTATION_CACHE = [: ]
global TELEPORTATION_AND_JUMP_CACHE = [: ]
global IGNORE_CELLLS_CACHE = [: ]

// "NoEntities" walkcells: ignores all dynamic entities (allies, bulbs, enemies)
// as obstacles. Only static map obstacles count. Used in danger evaluation,
// where we accept the approximation in exchange for cache reuse across the
// entire fight (key = (cell << 32) | mp, no base_hash dependency).
// These caches are persistent across turns (the map never changes).
global WALKABLE_CACHE_NOENT = [: ]
global JUMP_CACHE_NOENT = [: ]

//For Entity Actions :

global ENTITY_ACTIONS_CACHE = [: ] //Actions on Everybody else then me
global ACTIONS_ON_ME_CACHE = [: ] //Actions on me only Item from to me (either same cell or aoe)
global ACTIONS_SUMMON_CACHE = [: ] //Actions of summoning something (Resu or Bulbs)
global ACTIONS_ON_VOID_CACHE = [: ] //Actions on void for positive effects (glaive etc)
global COEFFED_MAP_ENTITY_CACHE = [: ]
global HASHED_MAP_ITEM_CACHE = [: ]

// For ally/enemy average distance (used by Actions.leek for bulb placement)

global AVERAGE_DISTANCE_FROM_ALLIES_CACHE = [: ]
global AVERAGE_DISTANCE_FROM_ENNEMIES_CACHE = [: ]

// Scoring: survival value keyed by round(LIFE, POISON, POISON_OVER_TIME, danger). Reset per turn.
global SURVIVAL_CACHE = [: ]

// Importance FROZEN per turn: [id -> importance], first computed at the BFS ROOT (real turn-start
// stats) and served frozen down the whole tree — in-turn stat changes pay through the CAPABILITY
// channel + the real maps (danger/heal), never through importance (the buff-farm fix). Reset per
// turn (covers the bulb turns too — shared VM).
global IMPORTANCE_BY_ID = [: ]

// Heal map: per-caster coverage [cell -> heal] keyed by (id,cell,mp,wis,tp); and the per-caster
// heal-item list keyed by id. Both reset per turn (cooldowns/positions change).
global HEAL_COVERAGE_CACHE = [: ]
global HEAL_ENTITY_INVENTORY = [: ]

// Delta: per-entity net damage keyed by (statsHash ^ healersFP[side], packed cell/life/totallife).
// Reset per turn. Lets unchanged entities skip the danger query + heal + turn-order sequencing.
global NETDAMAGE_CACHE = [: ]

// Heal map: the whole [casterId -> coverage] outer map (ALL sides' healers — enemy heals modeled),
// keyed by the COMBINED healers fingerprint (XOR-fold of every healer's id+wis+tp+mp+cell, all
// sides). Returned BY REFERENCE (read-only downstream). The PER-SIDE split of the same fold salts
// NETDAMAGE_CACHE — built locally by DeltaClass.getNetDamageMap / carried on nodes as HFP_BY_SIDE
// (no global). Reset per turn.
global HEAL_MAP_CACHE = [: ]

// ============================================================================
// WalkCells (packed-couple bitmap BFS — see Maps/WalkCells.leek)
// ============================================================================
// Layout: 1 int per COUPLE of lines (18 couples total).
//   bits 0-17  : even line 2c   (18 cells)
//   bits 18-23 : gap (always 0) — blocks cross-row contamination for shifts ≤ 6
//   bits 24-40 : odd line 2c+1  (17 cells)
// Couple 17 holds only even line 34 (line 35 doesn't exist).

global OBSTACLES_ARRAY = getObstacles()

// MAP_CELL_TO_COUPLE[cell] / MAP_CELL_TO_BITMASK[cell] = couple index + single-bit mask.
// MAP_OBSTACLES_CACHE       = obstacle-only baseline (no entities), 18 ints.
// ACC_TEMPLATE              = 19 zeros (18 couples + sentinel for safe acc[c+1] read).
// CELL_BY_LSB[couple][lsb]  = cell id for the single bit `lsb` set in that couple.
// All four are populated in Preload.InitCellClass; BFS callers clone what they need.
global MAP_CELL_TO_COUPLE   = []
global MAP_CELL_TO_BITMASK  = []
global MAP_OBSTACLES_CACHE  = []; for (var i = 0; i < 18; i++) push(MAP_OBSTACLES_CACHE, 0)
global ACC_TEMPLATE         = []; for (var i = 0; i < 19; i++) push(ACC_TEMPLATE, 0)
global CELL_BY_LSB          = []
