// Helpers to pre-allocate 35-element arrays (LeekScript can't assign to out-of-bounds index).
function _Make35Int()  { var a = []; for (var i = 0; i < 35; i++) push(a, 0);    return a }
function _Make35Map()  { var a = []; for (var i = 0; i < 35; i++) push(a, [: ]); return a }

// Arrays of 35 lines for the walk-cells bitmaps (replaces per-line scalar globals)
global MAP_OBSTACLES       = _Make35Int()
global MAP_OBSTACLES_CACHE = _Make35Int()

global ACC     = _Make35Int()
global TMP     = _Make35Int()
global ACCESMP = _Make35Map()

global ACCJ     = _Make35Int()
global TMPJ     = _Make35Int()
global ACCESMPJ = _Make35Map()

global ACCT     = _Make35Int()
global TMPT     = _Make35Int()
global ACCESMPT = _Make35Map()

global ACCTJ     = _Make35Int()
global TMPTJ     = _Make35Int()
global ACCESMPTJ = _Make35Map()
