/*
 * Tous les globals de cache, et le reset de début de tour.
 */

include("../includes.leek")

function ReloadCacheNewTurn() {
    TARGETABLECACHE = [: ]
    ENTITY_COOLDOWNS_BY_ID = [: ]
    ENTITY_CONST_BY_ID = [: ]
    MAP_CELL_ITEM_AOE_CACHE = [: ]
    DANGER_ITEM_AOE_HASH_CACHE = [: ]
    DANGER_TEAM_PLAN_CACHE = [: ]
    SEQ_MEMO_BY_SIG = [: ]
    PLAN_BY_SIG = [: ]
    CELL_DANGER_GET_CACHE = [: ]
    COMBO_FROM_ITEM_AOE_CACHE = [: ]
    ENTITY_DELTA_CACHE_FOR_ME = [: ]
    CELL_NETDAMAGE_FOR_ME_CACHE = [: ]
    SAFE_CELL_FOR_ME_CACHE = [: ]
    SAFE_ANY_CELLS = []
    SAFE_ANY_SET = [: ]
    AVERAGE_DISTANCE_FROM_ALLIES_CACHE = [: ]
    AVERAGE_DISTANCE_FROM_ENNEMIES_CACHE = [: ]
    SURVIVAL_CACHE = [: ]
    HEAL_COVERAGE_CACHE = [: ]
    HEAL_CELL_ITEM_AOE_CACHE = [: ]
    HEAL_COMBO_CACHE = [: ]
    HEAL_ENTITY_INVENTORY = [: ]
    IMPORTANCE_BY_ID = [: ]
    CAPABILITY_ITEMS_BY_ID = [: ]
    CAPABILITY_COMBO_CACHE = [: ]
    NETDAMAGE_CACHE = [: ]
    HEAL_MAP_CACHE = [: ]
    ENTITY_ACTIONS_CACHE = [: ]
    ACTIONS_ON_ME_CACHE = [: ]
    ACTIONS_SUMMON_CACHE = [: ]
    ACTIONS_ON_VOID_CACHE = [: ]

    // Reset obligatoire : getItemsList est clé par ID et filtre cooldown > 1 au moment du
    // calcul — sans reset, un item en cooldown à la première évaluation resterait exclu tout
    // le combat (danger sous-estimé). Les listes triées de DANGER_ENTITY_CACHE en dérivent
    // et leur clé ne porte pas les cooldowns : les deux se rafraîchissent ensemble.
    DANGER_ENTITY_INVENTORY = [: ]
    DANGER_ENTITY_CACHE = [: ]

    DR_PHYSRATIO_BY_SIDE = null
    POISON_COEF_CACHE = [: ]
    ANY_ANTIDOTE = null
}

// STATE

// Clé = bit-set des vivants (getHashedEntities) : une résurrection flippe le bit du ressuscité,
// et son ordre assigné est une fonction pure de (INITIAL_TURN_ORDER, set des vivants).
global ENTITY_SORTED_BY_TURN_ORDER_CACHE = [: ]

// Proxy de l'initialOrder du moteur : entité de début de combat -> son rang au tour 1.
// PERSISTANT tout le combat, capturé une fois (summons exclus, comme dans le moteur).
// Consommé par ResurrectionClass.Update pour l'ordre du ressuscité.
global INITIAL_TURN_ORDER = [: ]

// CELL

global CELL_X = [: ]
global CELL_Y = [: ]

global TMPOBSTACLES = [: ]

// PLATEAU DE BITS (x, y) — pour les dilatations de zone d'AoE.
// Layout : un ENTIER par ligne x, le bit y dans cet entier. Décalé pour que tout tienne dans
// les bits positifs avec une bande de garde de 4 de chaque côté : un décalage de zone ne
// dépasse jamais 3, donc aucune contamination entre lignes ni débordement de signe.
//   ligne  = x + AOEB_XOFF, bit = y + AOEB_YOFF, et un décalage (dx, dy) devient
//   out[i] = in[i - dx] << dy (ou >> -dy).
// AOEB_FREE : les cellules SANS obstacle (le résultat d'une zone les exclut déjà).
// AOEB_CELL_BY_BIT[ligne][bit isolé] -> cellule, pour décoder un mot en cellules.
// AOEB_ZERO : gabarit de plateau vide à cloner.
// Posés par Preload.InitCellClass, jamais vidés (la carte ne change pas).
global AOEB_XOFF = 0
global AOEB_YOFF = 0
global AOEB_ROWS = 0
global AOEB_FREE = []
global AOEB_CELL_BY_BIT = []
global AOEB_ZERO = []
// Ligne et bit d'une cellule LIBRE, pré-additionnés : poser une cellule sur un plateau
// relisait CELL_X et CELL_Y puis refaisait l'offset et le décalage, une fois par cellule et
// par dilatation. Une cellule bloquée y est absente (elle n'est jamais posée).
global AOEB_ROW_OF = [: ]
global AOEB_BIT_OF = [: ]

// [zone -> décalages (dx, dy, distance d'AoE) à plat, TRIÉS par distance croissante, centre
// EXCLU] : la forme d'une zone est indépendante de son centre, seuls les obstacles et les bords
// en retirent des cellules — et ça, le masque AOEB_FREE s'en charge à l'arrivée.
global AOEB_SHAPE = [: ]

// [x·1024 + y -> cellule LIBRE] : l'inverse de CELL_X/CELL_Y, restreinte aux cellules sans
// obstacle, bâtie une fois au chargement (Preload.InitCellClass). Les constructeurs de géométrie
// demandaient la cellule au moteur PUIS son obstacle à TMPOBSTACLES : ici une seule lecture
// répond aux deux questions, une clé absente valant « hors carte ou bloquée ».
// x et y sont SIGNÉS (le moteur centre x sur la carte, y peut être négatif) : la clé reste
// injective tant que |y| < 512, une collision exigeant |y1 - y2| >= 1024. Les lectures les plus
// débordantes valent un rayon d'AoE hors carte, très loin de cette borne.
// ATTENTION : la cellule 0 existe — tout lecteur teste `!= null`, jamais la vérité de la valeur.
global XY_FREE = [: ]

// [(areaType << 10) | centerCell -> [cellule -> distance d'AoE]] : les zones d'items,
// construites paresseusement par couple réellement demandé (CellClass.getAreaDist).
// PERSISTANT tout le combat (la carte ne change jamais) — jamais vidé au tour.
global AREA_DIST_CACHE = [: ]

// Géométries d'items PERSISTANTES, communes à Danger et Heal (buildMapCellItemAoe) — ne
// dépendent QUE de la map de déplacement statique sans entités (movementKey =
// (coucheJump << 20) | (cellule << 10) | max(0, MP) — 21 bits, sans ID/camp/cooldowns/stats),
// de la signature de lancement et de la zone. Read-only, jamais vidées au tour :
//  - ITEM_LAUNCH_GEOMETRY_CACHE [(movementKey << 25) | LAUNCH_GEOMETRY_KEY -> cellules
//    directement lançables] ;
//  - ITEM_FULL_GEOMETRY_CACHE [(movementKey << 30) | FULL_GEOMETRY_KEY -> [cell -> minAoeDist]].
// L'ASSEMBLAGE par caster (liste d'items cooldown-filtrée) reste, lui, un cache de tour
// (MAP_CELL_ITEM_AOE_CACHE / HEAL_CELL_ITEM_AOE_CACHE).
global ITEM_LAUNCH_GEOMETRY_CACHE = [: ]
global ITEM_FULL_GEOMETRY_CACHE = [: ]

global DISTANCE_CACHE = [: ]
global LOS_CACHE = [: ]
global LOS_WITH_BASE_HASH_CACHE = [: ]
global FILLED_CELLS_CACHE = [: ]

global DISC_CACHE = [: ]
global CIRCLE_CACHE = [: ]
// [rayon -> décalages dx·1024 + dy de l'anneau, dans l'ordre d'insertion attendu] : la forme
// d'un anneau ne dépend pas de son centre. PERSISTANT (la carte ne change jamais).
global RING_OFFSETS = [: ]
global CIRCLE_WITH_LOS_CACHE = [: ]
global DISC_WITH_LOS_CACHE = [: ]

global LINE_CACHE = [: ]
global POINTS_LINE_CACHE = [: ]
global LINE_WITH_LOS_CACHE = [: ]
global POINTS_LINE_WITH_LOS_CACHE = [: ]

global DIAGONAL_CACHE = [: ]
global POINTS_DIAGONAL_CACHE = [: ]
global DIAGONAL_WITH_LOS_CACHE = [: ]
global POINTS_DIAGONAL_WITH_LOS_CACHE = [: ]

global STAR_CACHE = [: ]
global POINTS_STAR_CACHE = [: ]
global STAR_WITH_LOS_CACHE = [: ]
global POINTS_STAR_WITH_LOS_CACHE = [: ]

global INVERTED_STAR_CACHE = [: ]
global POINTS_INVERTED_STAR_CACHE = [: ]
global INVERTED_STAR_WITH_LOS_CACHE = [: ]
global POINTS_INVERTED_STAR_WITH_LOS_CACHE = [: ]

global LASERS = [: ]

// ITEMS

global ITEMINFO = [: ]

// Coûts et cooldowns des deux chips de DÉPLACEMENT, sortis d'ITEMINFO une fois pour toutes :
// les tests de capacité de mobilité et l'empreinte de marche les relisaient à chaque nœud, soit
// des centaines de milliers de lectures de map pour deux constantes du combat.
// Posés par Preload.InitItemInfo, juste après le catalogue.
global JUMP_COST = 0
global TELE_COST = 0
global JUMP_TELE_COST = 0
global JUMP_COOLDOWN = 0
global TELE_COOLDOWN = 0

// PASSIVE_INFO[arme][type d'effet passif] = ligne complète au layout de
// getWeaponPassiveEffects (eff[1] = value1) — PAS celui des effets runtime de getEffects.
// Peuplé une fois dans Preload.InitItemInfo pour toute arme du catalogue portant des effets
// passifs — les procs simulés dans Consequences lisent leurs valeurs ici, jamais en dur.
global PASSIVE_INFO = [: ]

// TARGET

global TARGETABLECACHE = [: ]
// Cooldowns RÉELS des entités autres que Me, relevés une fois par tour : elles ne jouent pas
// pendant le mien, leurs cooldowns ne bougent donc pas. Map partagée par toutes les racines
// de l'entité — personne n'écrit une racine non-Me (setCooldown ne touche que le clone de Me,
// qui reçoit une map neuve).
// Hash de contenu de la DERNIÈRE couverture produite par coverageOfCell. Le fold se fait
// pendant la construction, où idx et le hash de contenu sont déjà en variables locales : un
// second passage sur le tableau les relirait pour rien. Lu immédiatement par le seul appelant.
global LAST_COVERAGE_HASH = 0

global ENTITY_COOLDOWNS_BY_ID = [: ]
// Champs d'entité constants pendant le tour (invocateur, camp, inventaire, nom, statique),
// relevés une seule fois par entité. TURN_ORDER en est EXCLU : le moteur insère un summon
// dans l'ordre en cours de tour, il est donc relu à chaque construction.
global ENTITY_CONST_BY_ID = [: ]

// CONSEQUENCES

global CONSEQUENCE_TARGET_CACHE = [: ]

// SUMMONS

global SUMMONER_LEVEL_TIMES = min(300, getLevel()) / 300

// DANGER MAP

global MAP_CELL_ITEM_AOE_CACHE = [: ]

// Hash de contenu d'une ItemAoeMap, clé (clé de MAP_CELL_ITEM_AOE_CACHE << 10) | cellule.
// Reset de tour OBLIGATOIRE, comme la map dont il décrit le contenu : l'inventaire
// disponible est filtré par cooldown au moment du calcul.
global DANGER_ITEM_AOE_HASH_CACHE = [: ]

// Plans offensifs par (terrain, contexte offensif, camp visé) : qui menace ce camp, avec
// quelle géométrie, quel pack de stats et quel facteur critique. Ne contient que des ids,
// des nombres et des maps de caches — jamais un EntityState ni le workspace.
global DANGER_TEAM_PLAN_CACHE = [: ]

// [signature -> les trois mémos de séquences] : deux plans dont l'ordre de tour, le camp visé et
// les ensembles « menace » / « peut changer un net » coïncident ont EXACTEMENT les mêmes
// séquences de jeu. Leur clé de plan, elle, porte le BaseHash : un ennemi poussé fabrique un plan
// neuf qui rebâtirait les mêmes séquences. Ils partagent donc ces maps par référence. Reset au
// tour, comme les plans.
global SEQ_MEMO_BY_SIG = [: ]

// [signature -> le plan lui-même] : un plan ne dépend pas du BaseHash que porte sa clé rapide,
// seulement du set des vivants, du contexte offensif adverse et du camp visé. Des alliés de la
// cible qui se déplacent fabriquaient un plan neuf, identique. Consultée au MISS seulement.
global PLAN_BY_SIG = [: ]

global CELL_DANGER_GET_CACHE = [: ]

// Reset de tour OBLIGATOIRE : la clé dérive du couple caster/cible packé, qui ne porte PAS la
// LIFE du caster (compromis LIFE_DAMAGE documenté au README). Les valeurs de la liste triée
// dont ce combo dépend vivent dans DANGER_ENTITY_CACHE, lui-même vidé au tour ; garder ce
// cache-ci plus longtemps servirait un combo calculé sur des dégâts d'un tour antérieur.
global COMBO_FROM_ITEM_AOE_CACHE = [: ]

global DANGER_ENTITY_CACHE = [: ]
global DANGER_ENTITY_INVENTORY = [: ]

// Recherche de fuite de Me (net minimal), deux niveaux : CELL_NETDAMAGE_FOR_ME_CACHE = le net
// à UNE cellule de fuite, ENTITY_DELTA_CACHE_FOR_ME = le MIN entier sur mes cellules
// accessibles. Même graine (statsHash ^ healersFP + vie + (id, IS_SUMMON) de Me — le profil
// de couverture heal est un input du net), foldée avec la cellule, resp. avec
// BaseHash + fingerprint du set accessible (le domaine du min dépend des obstacles).
global CELL_NETDAMAGE_FOR_ME_CACHE = [: ]
global ENTITY_DELTA_CACHE_FOR_ME = [: ]
// [graine -> cellules dont le net vaut 0 pour cette graine] : simple projection du cache
// ci-dessus, même clé et même durée de vie. Le net à une cellule ne dépend que de la graine
// et de la cellule ; seule l'ACCESSIBILITÉ change d'un nœud à l'autre, d'où plusieurs
// candidats — aucun doublon possible, le test d'entrée les aurait déjà servis.
global SAFE_CELL_FOR_ME_CACHE = [: ]

// Cellules qui ont rendu un net nul sous N'IMPORTE QUELLE graine du tour, et l'ensemble qui les
// dédoublonne. Contrairement au cache ci-dessus, ce n'est PAS un raccourci exact : c'est une
// liste de candidats que la recherche de fuite évalue normalement, en PREMIER. Une cellule sûre
// sous une graine l'est souvent sous les autres — elle est simplement loin des menaces — et un
// zéro trouvé tôt épargne toutes les cellules froides du balayage restant. Borné : au-delà, les
// tests d'accessibilité de la première passe coûteraient plus qu'ils n'épargnent. Reset au tour.
global SAFE_ANY_CELLS = []
global SAFE_ANY_SET = [: ]
global SAFE_ANY_MAX = 8

// WALKCELLS (par layer)

global WALKABLE_CACHE = [: ]
global JUMP_CACHE = [: ]
global TELEPORTATION_CACHE = [: ]
global TELEPORTATION_AND_JUMP_CACHE = [: ]
global IGNORE_CELLS_CACHE = [: ]

// Variante "NoEntities" : ignore les entités comme obstacles, seuls les obstacles de la carte
// comptent. Utilisée par le danger — l'approximation s'échange contre un cache PERSISTANT tout
// le combat (clé (cell << 32) | mp, aucune dépendance au board).
global WALKABLE_CACHE_NOENT = [: ]
global JUMP_CACHE_NOENT = [: ]

// ACTIONS

global ENTITY_ACTIONS_CACHE = [: ]   // actions sur les autres entités
global ACTIONS_ON_ME_CACHE = [: ]    // actions sur moi (même cellule ou AoE)
global ACTIONS_SUMMON_CACHE = [: ]   // actions d'invocation (bulbes, résurrection)
global ACTIONS_ON_VOID_CACHE = [: ]  // actions dans le vide à effet positif (glaive...)
global COEFFED_MAP_ENTITY_CACHE = [: ]

// Distances moyennes aux alliés/ennemis (placement des bulbes).
global AVERAGE_DISTANCE_FROM_ALLIES_CACHE = [: ]
global AVERAGE_DISTANCE_FROM_ENNEMIES_CACHE = [: ]

// SCORING

// Valeur de survie, clé packée (LIFE, netTick, harmfulRemaining, danger). Reset au tour.
global SURVIVAL_CACHE = [: ]

// Importance FIGÉE par replan réel : [id -> importance], vidée par Play à CHAQUE replan
// (un buff/shackle réellement exécuté est visible à la planification suivante) puis servie
// telle quelle dans TOUT le BFS correspondant. Les changements de stats en branche passent
// par le canal capability et les vraies maps (danger/heal), jamais par l'importance. Le
// reset de ReloadCacheNewTurn reste en filet de sécurité (VM du bulbe comprise) — Play
// réinitialise ensuite à chaque replan.
global IMPORTANCE_BY_ID = [: ]

// Capability, reset au tour :
//  - CAPABILITY_ITEMS_BY_ID : id -> sa liste d'items castables triée [[item, hpValue, coût]]
//    (gate cooldown <= 1 de début de tour, valorisés en HP via CAP_HP_W, triés HP/TP desc).
//    Clé id seule saine : INVENTORY constant par id, les COOLDOWNS non-Me ne bougent jamais
//    en sim, et la liste de Me est volontairement son potentiel de DÉBUT de tour.
//  - CAPABILITY_COMBO_CACHE : (id << 10) | max(0, TOTAL_TP) -> les buckets HP par stat du
//    combo glouton. TP dans la clé : un buff/shackle TP en branche relance le glouton au
//    nouveau budget, le delta TP est ÉMERGENT (un bulbe qui ne peut rien en faire score 0).
global CAPABILITY_ITEMS_BY_ID = [: ]
global CAPABILITY_COMBO_CACHE = [: ]

// HEAL MAP — trois couches, miroir de la danger map :
//  - HEAL_COVERAGE_CACHE : la couverture d'un caster, résolue PAR CELLULE À LA DEMANDE et par
//    profil de cible (pas de SELF : le séquenceur exclut la cible de sa liste de casters),
//    clé (id, couche marche/saut, cell, mp, wis, tp) — le fast path. Le déroulé du net
//    n'interroge qu'une cellule par appel : tout assembler serait du travail jeté.
//  - HEAL_CELL_ITEM_AOE_CACHE : la GÉOMÉTRIE paresseuse par item, clé
//    (id<<21)|(coucheJump<<20)|(cell<<10)|max(0,mp) — position + couche marche/saut future
//    (canJumpNextTurn), COMMUNE aux deux profils ; elle porte aussi les hashs de contenu des
//    cellules déjà assemblées. Un buff/shackle WIS/TP ne reconstruit que la couche valeur,
//    SAUF franchissement du coût de Jump (couche géométrique).
//  - HEAL_COMBO_CACHE : la VALEUR [heal, vitalité], memoïsée par CONTENU (fold des entrées
//    [item -> dist] + wis/tp + PROFIL) — deux profils ne partagent jamais un combo, deux
//    casters de types différents partagent un combo allié identique.
//    (USES pas dans la clé : tout heal caster a USES = 0 — le moteur les clear au endTurn,
//    les bulbes virtuels partent à 0, et Me est exclu de la map.)
// Plus la liste d'items de heal par caster. Tout reset au tour (cooldowns/positions).
global HEAL_COVERAGE_CACHE = [: ]
global HEAL_CELL_ITEM_AOE_CACHE = [: ]

global HEAL_COMBO_CACHE = [: ]
global HEAL_ENTITY_INVENTORY = [: ]

// DELTA : net par entité, clé (statsHash ^ healersFP[side], pack cell/life/totallife) salée
// par (id, IS_SUMMON) — le profil de couverture heal (poireau/summon) est un input du net
// depuis la vitalité. Une entité intouchée saute danger + heal + séquençage. Reset au tour.
global NETDAMAGE_CACHE = [: ]

// Heal map externe [casterId -> couverture par profil] (healers des DEUX camps), clé = fold
// COMBINÉ des fingerprints de healers. Renvoyée PAR RÉFÉRENCE (read-only en aval). Le split
// par side du même fold sale NETDAMAGE_CACHE — porté sur les nœuds (HFP_BY_SIDE). Reset au tour.
global HEAL_MAP_CACHE = [: ]

// [side -> STR/(STR+MAG) de l'équipe adverse] pour le bonus damage-return — figé au tour,
// construit au premier porteur évalué (ScoringClass.buildDrPhysRatios). null = pas construit.
global DR_PHYSRATIO_BY_SIDE = null

// [POISON_KEY -> [id -> coef poison ]0,1]]] — remise de couverture antidote sur le POT
// (ScoringClass.poisonCoefOf). La clé (ScoringClass.poisonKeyFromFold) encode TOUS les inputs du
// build : BaseHash (positions/vie des non-Me), porteurs (vivant, TOTAL_MP, cd), ancre de
// replan de Me, Me vivant/mort — les maps d'une ancienne ancre deviennent injoignables sans
// flush manuel. Reset au tour.
global POISON_COEF_CACHE = [: ]

// Y a-t-il un antidote dans le combat ? (morts inclus — basé inventaire, invariant en branche)
// Court-circuite la machinerie poison. Lazy (ScoringClass.anyAntidote), reset au tour.
// ANTIDOTE_CARRIER_IDS : ids des porteurs (morts inclus), rempli par le même scan.
// ANTIDOTE_CARRIER_SET : le même ensemble en map, pour tester l'appartenance d'une entité
// clonée sans parcourir la liste (héritage du fold, ScoringClass.poisonKeyOnNode).
// ME_HAS_ANTIDOTE : Me est-il porteur ? (posé par le même scan) — sa contribution au fold est
// relue à chaque nœud alors que celle des autres est héritée.
global ANY_ANTIDOTE = null
global ANTIDOTE_CARRIER_IDS = []
global ANTIDOTE_CARRIER_SET = [: ]
global ME_HAS_ANTIDOTE = false

// Ancre de replan de Me : sa VRAIE cellule, reposée à chaque itération de Play (VM du bulbe
// comprise) — meilleure estimation de sa cellule de fin de tour pour la couverture antidote,
// converge au fil des actions réelles. Le hash précalculé est XORé dans chaque POISON_KEY.
global MY_REPLAN_CELL = 0
global MY_REPLAN_CELL_HASH = 0

// ============================================================================
// WalkCells : BFS bitmap par couples de lignes (voir Maps/WalkCells.leek)
// ============================================================================
// Layout : 1 int par COUPLE de lignes (18 couples).
//   bits 0-17  : ligne paire 2c   (18 cellules)
//   bits 18-23 : trou (toujours 0) — bloque la contamination inter-lignes pour les shifts <= 6
//   bits 24-40 : ligne impaire 2c+1 (17 cellules)
// Le couple 17 ne porte que la ligne paire 34 (la 35 n'existe pas).

global OBSTACLES_ARRAY = getObstacles()

// MAP_CELL_TO_COUPLE[cell] / MAP_CELL_TO_BITMASK[cell] = index de couple + masque à 1 bit.
// MAP_OBSTACLES_CACHE = baseline obstacles seuls (18 ints). ACC_TEMPLATE = 19 zéros
// (sentinelle pour lire acc[c+1] sans garde). CELL_BY_LSB[couple][lsb] = cellule du bit `lsb`.
// Peuplés dans Preload.InitCellClass ; les appelants clonent ce dont ils ont besoin.
global MAP_CELL_TO_COUPLE   = []
global MAP_CELL_TO_BITMASK  = []
global MAP_OBSTACLES_CACHE  = []; for (var i = 0; i < 18; i++) push(MAP_OBSTACLES_CACHE, 0)
global ACC_TEMPLATE         = []; for (var i = 0; i < 19; i++) push(ACC_TEMPLATE, 0)
global CELL_BY_LSB          = []
