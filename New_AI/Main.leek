include("includes.leek")
// MODÈLE BULBE : summon(chip, cell, Bulb.AI) passe une FONCTION de cette IA -> le bulbe
// s'exécute dans la VM DE L'INVOCATEUR (globals + caches partagés). BulbAI.leek reset donc
// les caches per-turn AVANT InitStateClass (même ordre que ce Main), et les caches
// persistants Me-dépendants ont Me dans la clé.
// Limites et compromis assumés : voir le README à la racine du dépôt.
if (getTurn() == 1) Preload.InitEverything()
ReloadCacheNewTurn()
Preload.InitStateClass()
BenchOps.Reset()
new Play()
BenchOps.Dump()
// ====== MESURE TEMPORAIRE de la priorité des cellules — À RETIRER après la mesure ======
debugW("EscapePriority windows=" + EPRIO_WINDOWS + " coldProbed=" + EPRIO_COLD_PROBED + " coldEvaluated=" + EPRIO_COLD_EVALUATED + " zeroNoCaster=" + EPRIO_ZERO_NO_CASTER)
// =======================================================================================
