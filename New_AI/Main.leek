if (getTurn() == 1) Preload.InitEverything()
ReloadCacheNewTurn()
Preload.InitStateClass()
BenchOps.Reset()
new Play()
BenchOps.Dump()
debug("Full opés this turn : " + getOperations() / 1000000 + " m")
