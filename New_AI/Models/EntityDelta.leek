/*
 * EntityDelta : le JOURNAL des mutations d'une entité pendant la simulation d'UNE action.
 *
 * Le State n'est plus cloné par candidat : les EntityState du parent sont mutés
 * TEMPORAIREMENT, chaque champ écrit enregistre paresseusement son ancienne valeur ici, le
 * scoring lit ces valeurs temporaires, puis tout est restauré à l'identique. Ce qui SURVIT
 * dans le nœud est le patch des champs réellement DIFFÉRENTS, en valeurs ABSOLUES finales
 * (LIFE = 120, jamais LIFE + 100) — ce qui rend exacts les caps, resets, remplacements,
 * morts et résurrections.
 *
 * Stockage PLAT, deux tableaux alignés (aucune map sparse, aucune liste séparée) :
 *   TOUCHED = [champ, ancienneValeur, champ, ancienneValeur, ...] — base de la restauration ;
 *   CHANGED = [champ, valeurFinale,  champ, valeurFinale,  ...] — patch persistant.
 * Les masques disent en UNE opération si un champ (ou un groupe) est concerné ; les
 * parcours se font par pas de 2, et jamais sur les 31 champs.
 *
 * Après restauration, le journal d'annulation est LIBÉRÉ : le nœud ne retient plus que
 * CHANGED (+ l'objet complet d'une naissance ou d'un remplacement), jamais une ancienne
 * valeur ni une référence vers une entité parent.
 */

include("../includes.leek")

class EntityDeltaClass {
	ID
	IS_NEW            // entité née dans l'action : restauration = retrait de la map
	IS_REPLACEMENT    // entrée rebindée sur un id préexistant : restauration = ancienne référence
	OLD_ENTITY        // référence d'origine (remplacement) — jamais mutée, libérée après restauration
	NEW_ENTITY        // objet complet (naissance ou remplacement)

	TOUCHED_MASK      // bit-set des champs écrits au moins une fois
	TOUCHED           // paires plates [champ, ancienne valeur] — libéré après restauration

	CHANGED_MASK      // bit-set des champs réellement différents après finalisation
	CHANGED           // paires plates [champ, valeur ABSOLUE finale]

	constructor(id) {
		this.ID = id
		this.IS_NEW = false
		this.IS_REPLACEMENT = false
		this.OLD_ENTITY = null
		this.NEW_ENTITY = null
		this.TOUCHED_MASK = 0
		this.TOUCHED = []
		this.CHANGED_MASK = 0
		this.CHANGED = []
	}
}

/*
 * Maillon d'inventaire : porte les références COOLDOWNS / USES / ITEM_STATE_PARENT que
 * l'entité avait AVANT l'action. On ne peut pas pointer ITEM_STATE_PARENT vers l'entité
 * elle-même (elle est mutée temporairement : ce serait une boucle sur des maps déjà
 * remplacées) — ce maillon immuable joue ce rôle, et cooldownOf/usesOf le traversent sans
 * changer de sémantique. Il sert aussi à relire les cooldowns d'AVANT l'action (fingerprint
 * de fuite de Me).
 */
class ItemStateLinkClass {
	COOLDOWNS
	USES
	ITEM_STATE_PARENT

	constructor(cooldowns, uses, parent) {
		this.COOLDOWNS = cooldowns
		this.USES = uses
		this.ITEM_STATE_PARENT = parent
	}
}
