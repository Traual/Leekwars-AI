/*
 * Cell : la géométrie de la carte — formes d'AoE (cercles, lignes, diagonales, étoiles,
 * carrés, lasers), distances et lignes de vue, le tout caché de façon persistante
 * (la carte ne change jamais).
 */

include("../includes.leek")

class CellClass {

	/*
	 * [cellule -> distance d'AoE] d'une forme centrée sur centerCell — SOURCE UNIQUE des
	 * zones d'items (AoeDistItem) et des voisinages cercle de WalkCells. Cache PERSISTANT
	 * (la carte ne change jamais), construit paresseusement : seul chaque couple
	 * (type de zone, centre) réellement demandé est produit, puis conservé tout le combat.
	 * Clé injective (areaType << 10) | centerCell (cellule < 1024). Distances calculées
	 * directement |dx| + |dy| (== getCellDistance moteur : Pathfinding.getCaseDistance,
	 * le décalage constant de getCellX s'annule dans la différence) — sans getDist, pour ne
	 * pas remplir DISTANCE_CACHE de couples créés uniquement pour les AoE.
	 * Maps partagées READ-ONLY par contrat : aucun lecteur ne les mute.
	 */
	static getAreaDist(areaType, centerCell) {
		var key = (areaType << 10) | centerCell
		if (key in AREA_DIST_CACHE) return AREA_DIST_CACHE[key]

		var _final = [: ]
		if (areaType == AREA_POINT || areaType == AREA_FIRST_INLINE || areaType == AREA_LASER_LINE) {
			// Zones volontairement ponctuelles : le centre seul, distance 0.
			_final[centerCell] = 0
		} else {
			var boolMap = null
			// AREA_CIRCLE_1 couvre aussi AREA_PLUS_1, alias moteur de même valeur et même forme.
			if (areaType == AREA_CIRCLE_1) boolMap = getDisc(centerCell, 0, 1)
			else if (areaType == AREA_CIRCLE_2) boolMap = getDisc(centerCell, 0, 2)
			else if (areaType == AREA_CIRCLE_3) boolMap = getDisc(centerCell, 0, 3)
			else if (areaType == AREA_SQUARE_1) boolMap = getSquare(centerCell, 1)
			else if (areaType == AREA_SQUARE_2) boolMap = getSquare(centerCell, 2)
			else if (areaType == AREA_PLUS_2) boolMap = getLine(centerCell, 0, 2)
			else if (areaType == AREA_PLUS_3) boolMap = getLine(centerCell, 0, 3)
			else if (areaType == AREA_X_1) boolMap = getDiagonal(centerCell, 0, 2)
			else if (areaType == AREA_X_2) boolMap = getDiagonal(centerCell, 0, 4)
			else if (areaType == AREA_X_3) boolMap = getDiagonal(centerCell, 0, 6)
			if (boolMap == null) {
				// Type de zone non géré : échec explicite (jamais assimilé à un point).
				debugE("getAreaDist : type de zone non géré " + areaType)
				return null
			}
			var cx = CELL_X[centerCell]
			var cy = CELL_Y[centerCell]
			for (var c: var b in boolMap) {
				_final[c] = abs(CELL_X[c] - cx) + abs(CELL_Y[c] - cy)
			}
		}
		AREA_DIST_CACHE[key] = _final
		return _final
	}

	static getDisc(cell, minradius, radius) {
		var TmpHash = (cell << 14) | (minradius << 7) | radius
		if (TmpHash in DISC_CACHE) return DISC_CACHE[TmpHash]

		var _final = [: ]
		// Parcourir les cellules dans les rayon
		for (var d = minradius; d <= radius; d++) {
			_final += getCircle(cell, d)
		}

		DISC_CACHE[TmpHash] = _final
		return _final
	}

	/*
	 * Un anneau est une TRANSLATION : sa forme ne dépend que du rayon, seul son centre change.
	 * Les décalages sont donc pré-additionnés une fois par rayon, sous la forme même qu'attend
	 * la clé de XY_FREE (dx·1024 + dy), et une lecture par décalage suffit ensuite.
	 * L'ordre d'insertion est CONSERVÉ (x croissant, y positif puis y négatif) : l'itération de
	 * la map rendue est lue en aval, elle ne doit pas changer.
	 */
	static ringOffsets(radius) {
		if (radius in RING_OFFSETS) return RING_OFFSETS[radius]
		var offs = []
		for (var x = -radius; x <= radius; x++) {
			var y1 = radius - abs(x)
			var base = x * 1024
			push(offs, base + y1)
			if (y1 != 0) push(offs, base - y1)   // y1 == -y1 seulement en zéro
		}
		RING_OFFSETS[radius] = offs
		return offs
	}

	static getCircle(cell, radius) {
		var TmpHash = (cell << 7) | radius
		if (TmpHash in CIRCLE_CACHE) return CIRCLE_CACHE[TmpHash]
		var _final = [: ]
		var base = CELL_BASE[cell]
		var offs = ringOffsets(radius)
		for (var o in offs) {
			// XY_FREE répond aux deux questions d'un coup : hors carte ET bloquée valent null.
			var ThisCell = XY_FREE[base + o]
			if (ThisCell != null) _final[ThisCell] = true
		}
		CIRCLE_CACHE[TmpHash] = _final
		return _final
	}
	
	static getDiscWithLos(cell, minradius, radius) {
		var TmpHash = (cell << 14) | (minradius << 7) | radius
		if (TmpHash in DISC_WITH_LOS_CACHE) return DISC_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		for (var d = minradius; d <= radius; d++) {
			_final += getCircleWithLos(cell, d)
		}
		DISC_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	
	static getCircleWithLos(cell, radius) {
		var TmpHash = (cell << 7) | radius
		if (TmpHash in CIRCLE_WITH_LOS_CACHE) return CIRCLE_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		for (var testingCell:var bool in getCircle(cell, radius)) {
			if (getLos(testingCell, cell)) {
				_final[testingCell] = true
			}
		}
		CIRCLE_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	static getLine(cell, minradius, radius) {
		var TmpHash = (cell << 14) | (minradius << 7) | radius
		if (TmpHash in LINE_CACHE) return LINE_CACHE[TmpHash]
		var _final = [: ]
		for (var i = minradius; i <= radius; i++) {
			_final += getPointsLine(cell, i)
		}
		LINE_CACHE[TmpHash] = _final
		return _final
	}

	static getPointsLine(cell, radius) {
		var TmpHash = (cell << 7) | radius
		if (TmpHash in POINTS_LINE_CACHE) return POINTS_LINE_CACHE[TmpHash]
		var _final = [: ]
		// Les quatre voisins cardinaux s'obtiennent par addition sur l'index de base.
		var base = CELL_BASE[cell]
		var dxr = radius * 1024
		var Cell1 = XY_FREE[base + dxr]
		var Cell2 = XY_FREE[base - dxr]
		var Cell3 = XY_FREE[base + radius]
		var Cell4 = XY_FREE[base - radius]
		if (Cell1 != null) _final[Cell1] = true
		if (Cell2 != null) _final[Cell2] = true
		if (Cell3 != null) _final[Cell3] = true
		if (Cell4 != null) _final[Cell4] = true
		POINTS_LINE_CACHE[TmpHash] = _final
		return _final
	}

	static getLineWithLos(cell, minradius, radius) {
		var TmpHash = (cell << 14) | (minradius << 7) | radius
		if (TmpHash in LINE_WITH_LOS_CACHE) return LINE_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		for (var d = minradius; d <= radius; d++) {
			_final += getPointsLineWithLos(cell, d)
		}
		LINE_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	
	static getPointsLineWithLos(cell, radius) {
		var TmpHash = (cell << 7) | radius
		if (TmpHash in POINTS_LINE_WITH_LOS_CACHE) return POINTS_LINE_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		for (var testingCell:var bool in getPointsLine(cell, radius)) {
			if (getLos(testingCell, cell)) {
				_final[testingCell] = true
			}
		}
		POINTS_LINE_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	static getDiagonal(cell, minradius, radius) {
		var TmpHash = (cell << 14) | (minradius << 7) | radius
		if (TmpHash in DIAGONAL_CACHE) return DIAGONAL_CACHE[TmpHash]
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]
		for (var i = minradius / 2; i <= radius / 2; i++) {
			_final += getDiagonalPoints(cell, i, BaseX, BaseY)
		}
		DIAGONAL_CACHE[TmpHash] = _final
		return _final
	}

	static getDiagonalPoints(cell, radius, BaseX, BaseY) {
		var TmpHash = (cell << 7) | radius
		if (TmpHash in POINTS_DIAGONAL_CACHE) return POINTS_DIAGONAL_CACHE[TmpHash]
		var _final = [: ]
		var Cell1 = getCellFromXY(BaseX + radius, BaseY + radius)
		var Cell2 = getCellFromXY(BaseX + radius, BaseY - radius)
		var Cell3 = getCellFromXY(BaseX - radius, BaseY + radius)
		var Cell4 = getCellFromXY(BaseX - radius, BaseY - radius)
		if (Cell1!=null && !TMPOBSTACLES[Cell1]) _final[Cell1] = true
		if (Cell2!=null && !TMPOBSTACLES[Cell2]) _final[Cell2] = true
		if (Cell3!=null && !TMPOBSTACLES[Cell3]) _final[Cell3] = true
		if (Cell4!=null && !TMPOBSTACLES[Cell4]) _final[Cell4] = true
		POINTS_DIAGONAL_CACHE[TmpHash] = _final
		return _final
	}
	
	static getDiagonalWithLos(cell, minradius, radius) {
		var TmpHash = (cell << 14) | (minradius << 7) | radius
		if (TmpHash in DIAGONAL_WITH_LOS_CACHE) return DIAGONAL_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]
		for (var d = minradius / 2; d <= radius / 2; d++) {
			_final += getDiagonalPointsWithLos(cell, d, BaseX, BaseY)
		}
		DIAGONAL_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	
	static getDiagonalPointsWithLos(cell, radius, BaseX, BaseY) {
		// Pas de cache : il ne peut pas servir. Cette fonction n'est appelée que par la
		// boucle de son enveloppe, qui ne tourne QU'AU MISS du cache de celle-ci — clefée
		// (cellule, portée mini, portée maxi). Une seule paire de portées étant en jeu pour
		// cette forme, chaque (cellule, rayon) n'est demandé qu'une fois. Mesuré : 23 331
		// consultations, ZERO hit. Sa clé, son test et son écriture étaient du coût pur.
		var _final = [: ]
		for (var testingCell:var bool in getDiagonalPoints(cell, radius, BaseX, BaseY)) {
			if (getLos(testingCell, cell)) {
				_final[testingCell] = true
			}
		}
		return _final
	}

	static getStar(cell, minradius, radius) {
		var TmpHash = (cell << 14) | (minradius << 7) | radius
		if (TmpHash in STAR_CACHE) return STAR_CACHE[TmpHash]
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]
		for (var d = minradius; d <= radius; d++) {
			_final += getStarPoints(cell, d, BaseX, BaseY)
		}
		STAR_CACHE[TmpHash] = _final
		return _final
	}

	static getStarPoints(cell, radius, BaseX, BaseY) {
		var TmpHash = (cell << 7) | radius
		if (TmpHash in POINTS_STAR_CACHE) return POINTS_STAR_CACHE[TmpHash]
		var _final = [: ]
		if (!(radius % 2)) {
			_final = mapMerge(getDiagonalPoints(cell, radius/2, BaseX, BaseY), getPointsLine(cell, radius))
		} else {
			_final = getPointsLine(cell, radius)
		}
		POINTS_STAR_CACHE[TmpHash] = _final
		return _final
	}
	
	static getStarWithLos(cell, minradius, radius) { // les points sont déjà cachés côté diagonales et lignes
		var TmpHash = (cell << 14) | (minradius << 7) | radius
		if (TmpHash in STAR_WITH_LOS_CACHE) return STAR_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]
		for (var d = minradius; d <= radius; d++) {
			_final += getStarPointsWithLos(cell, d, BaseX, BaseY)
		}
		STAR_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	static getStarPointsWithLos(cell, radius, BaseX, BaseY) {
		// Pas de cache : il ne peut pas servir. Cette fonction n'est appelée que par la
		// boucle de son enveloppe, qui ne tourne QU'AU MISS du cache de celle-ci — clefée
		// (cellule, portée mini, portée maxi). Une seule paire de portées étant en jeu pour
		// cette forme, chaque (cellule, rayon) n'est demandé qu'une fois. Mesuré : 34 735
		// consultations, ZERO hit. Sa clé, son test et son écriture étaient du coût pur.
		var _final = [: ]
		for (var testingCell:var bool in getStarPoints(cell, radius, BaseX, BaseY)) {
			if (getLos(testingCell, cell)) {
				_final[testingCell] = true
			}
		}
		return _final
	}

	static getInvertedStar(cell, minradius, radius) {
		var TmpHash = (cell << 14) | (minradius << 7) | radius
		if (TmpHash in INVERTED_STAR_CACHE) return INVERTED_STAR_CACHE[TmpHash]
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]

		if (minradius == 0) _final[cell] = true
		// Parcourir les cellules dans le rayon
		for (var d = minradius; d <= radius; d++) {
			_final += getInvertedStarPoints(cell, d, BaseX, BaseY)
		}
		INVERTED_STAR_CACHE[TmpHash] = _final
		return _final
	}

	static getInvertedStarPoints(cell, radius, BaseX, BaseY) {
		// Pas de cache : il ne peut pas servir. Cette fonction n'est appelée que par la
		// boucle de son enveloppe, qui ne tourne QU'AU MISS du cache de celle-ci — clefée
		// (cellule, portée mini, portée maxi). Une seule paire de portées étant en jeu pour
		// cette forme, chaque (cellule, rayon) n'est demandé qu'une fois. Mesuré : 637
		// consultations, ZERO hit. Sa clé, son test et son écriture étaient du coût pur.
		var _final = [: ]
		var CircleForThisRadius = getCircle(cell, radius)
		var StarForThisRadius = getStarPoints(cell, radius, BaseX, BaseY)
		for (var cellTest:var bool in CircleForThisRadius) {
			if (!(cellTest in StarForThisRadius)) _final[cellTest] = true
		}
		return _final
	}

	static getInvertedStarWithLos(cell, minradius, radius) {
		var TmpHash = (cell << 14) | (minradius << 7) | radius
		if (TmpHash in INVERTED_STAR_WITH_LOS_CACHE) return INVERTED_STAR_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]
		for (var d = minradius; d <= radius; d++) {
			_final += getInvertedStarPointsWithLos(cell, d, BaseX, BaseY)
		}
		INVERTED_STAR_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	
	static getInvertedStarPointsWithLos(cell, radius, BaseX, BaseY) {
		// Pas de cache : il ne peut pas servir. Cette fonction n'est appelée que par la
		// boucle de son enveloppe, qui ne tourne QU'AU MISS du cache de celle-ci — clefée
		// (cellule, portée mini, portée maxi). Une seule paire de portées étant en jeu pour
		// cette forme, chaque (cellule, rayon) n'est demandé qu'une fois. Mesuré : 637
		// consultations, ZERO hit. Sa clé, son test et son écriture étaient du coût pur.
		var _final = [: ]
		for (var testingCell:var bool in getInvertedStarPoints(cell, radius, BaseX, BaseY)) {
			if (getLos(testingCell, cell)) {
				_final[testingCell] = true
			}
		}
		return _final
	}

	/* Laser AoE : la ligne de cellules de from vers to (alignés sur exactement un axe),
	 * coupée au premier obstacle. Direction portée par le vecteur (stepX, stepY). */
	static getLaserAoe(from, to, minrange, maxrange) {
		var Hash = (maxrange << 27) | (minrange << 20) | (to << 10) | from
		if (Hash in LASERS) return LASERS[Hash]
		var _final = [: ]
		var FromX = CELL_X[from]
		var FromY = CELL_Y[from]
		var stepX = CELL_X[to] > FromX ? 1 : (CELL_X[to] < FromX ? -1 : 0)
		var stepY = CELL_Y[to] > FromY ? 1 : (CELL_Y[to] < FromY ? -1 : 0)
		if ((stepX == 0) != (stepY == 0)) {   // aligné sur exactement UN axe (from == to et diagonales -> vide, comme avant)
			// Un pas de rayon est une translation constante : un seul index à avancer.
			var base = CELL_BASE[from]
			var step = stepX * 1024 + stepY
			for (var d = minrange; d <= maxrange; d++) {
				var Cell = XY_FREE[base + d * step]
				if (Cell == null) break   // hors carte ou obstacle : le laser s'arrête
				_final[Cell] = true
			}
		}
		LASERS[Hash] = _final
		return _final
	}

	/* Comme getLaserAoe mais s'arrête sur la PREMIÈRE entité rencontrée (AREA_FIRST_INLINE) :
	 * retourne au plus une cellule. Non caché (EntityMap dépend de la branche). */
	static getFirstInlineAoe(from, to, minrange, maxrange, EntityMap) {
		var _final = [: ]
		var FromX = CELL_X[from]
		var FromY = CELL_Y[from]
		var stepX = CELL_X[to] > FromX ? 1 : (CELL_X[to] < FromX ? -1 : 0)
		var stepY = CELL_Y[to] > FromY ? 1 : (CELL_Y[to] < FromY ? -1 : 0)
		if ((stepX == 0) != (stepY == 0)) {
			var base = CELL_BASE[from]
			var step = stepX * 1024 + stepY
			for (var d = minrange; d <= maxrange; d++) {
				var Cell = XY_FREE[base + d * step]
				if (Cell == null) break   // hors carte ou obstacle
				if (EntityMap[Cell]) {
					_final[Cell] = true
					break
				}
			}
		}
		return _final
	}

	/* Carré de Chebyshev (toutes les cellules avec max(|dx|,|dy|) <= radius), obstacles exclus,
	 * centre inclus — les formes AREA_SQUARE_*. */
	static getSquare(cell, radius) {
		var _final = [: ]
		var base = CELL_BASE[cell]
		for (var dx = -radius; dx <= radius; dx++) {
			// Index de la ligne calculé une fois : la boucle interne n'ajoute plus que dy.
			var rowBase = base + dx * 1024
			for (var dy = -radius; dy <= radius; dy++) {
				var c = XY_FREE[rowBase + dy]
				if (c != null) _final[c] = true
			}
		}
		return _final
	}

	/* Distance entre deux cellules, cachée dans les deux sens. */
	static getDist(cell1, cell2) {
		var Hash =  cell1 << MAX_CELL_BINARY | cell2
		if (Hash in DISTANCE_CACHE) return DISTANCE_CACHE[Hash]
		var TmpDist = getCellDistance(cell1, cell2)
		DISTANCE_CACHE[Hash] = TmpDist
		DISTANCE_CACHE[cell2 << MAX_CELL_BINARY | cell1] = TmpDist//Reverse is the same value
		return TmpDist
	}

	static signOf(v) {
		return v > 0 ? 1 : (v < 0 ? -1 : 0)
	}

	/*
	 * Destination réelle d'un push/attract — réplique Map.getPush/AttractLastAvailableCell :
	 * l'entité GLISSE case par case de sa cellule VERS la cellule visée (jamais au-delà),
	 * stoppée par la première case indisponible (obstacle, entité VIVANTE — les morts ne
	 * bloquent pas, retirés de la map moteur — ou bord). La VALEUR de l'effet n'existe pas
	 * dans ce chemin (Attack.java:186-198). Gate de direction : push exige la visée dans le
	 * PROLONGEMENT caster->entité (signum égaux), attract l'exige CÔTÉ caster (signum
	 * opposés) — sinon aucun déplacement. occupied = [cellule -> truthy] des vivants.
	 */
	static slideDestination(fromCell, aimCell, casterCell, isAttract, occupied) {
		var ex = CELL_X[fromCell]
		var ey = CELL_Y[fromCell]
		var cdx = signOf(ex - CELL_X[casterCell])
		var cdy = signOf(ey - CELL_Y[casterCell])
		var dx = signOf(CELL_X[aimCell] - ex)
		var dy = signOf(CELL_Y[aimCell] - ey)
		if (isAttract) {
			if (cdx != -dx || cdy != -dy) return fromCell
		} else {
			if (cdx != dx || cdy != dy) return fromCell
		}
		var current = fromCell
		var cx = ex
		var cy = ey
		while (current != aimCell) {
			cx += dx
			cy += dy
			var next = XY_FREE[cx * 1024 + cy]
			if (next == null || occupied[next]) return current   // null = hors carte ou obstacle
			current = next
		}
		return current
	}

	/* LoS STATIQUE : le 3e argument de lineOfSight est la liste des entités IGNORÉES —
	 * EVERYONE (rafraîchi à chaque Virtualize) les ignore toutes, le cache persistant ne
	 * dépend donc que des obstacles de la carte. Obstacles dynamiques du State (summons
	 * simulés inclus) : getLosWithBaseHash. */
	static getLos(cell1, cell2) {
		// Clé CANONIQUE (min, max) : LOS(A,B) == LOS(B,A) -> une seule entrée sert les deux
		// sens, la map (persistante tout le combat) est divisée par 2.
		var Hash = cell1 < cell2 ? (cell1 << MAX_CELL_BINARY | cell2) : (cell2 << MAX_CELL_BINARY | cell1)
		if (Hash in LOS_CACHE) return LOS_CACHE[Hash]
		var TmpLos = lineOfSight(cell1, cell2, EVERYONE)
		LOS_CACHE[Hash] = TmpLos
		return TmpLos
	}

	/* LoS exacte sous un board donné (entités du State de branche comme obstacles). */
	/* Préfixe INVARIANT de la clé de LoS pour un état donné. addValueToBinHash est une rotation
	 * suivie d'un XOR : avb(h, x) == avb(h, 0) ^ x, donc un appelant qui enchaîne des LoS sous le
	 * même BaseHash peut hisser la rotation et ne payer que le XOR. Clé bit-identique. */
	static losKeyPrefix(BaseHash) {
		return addValueToBinHash(OFFSET_BASIS ^ BaseHash, 0)
	}

	/* Même LoS, préfixe déjà rotationné par l'appelant. */
	static getLosWithPrefix(cell1, cell2, State, BaseHash, Prefix) {
		var Hash = Prefix ^ (cell1 < cell2 ? (cell1 << MAX_CELL_BINARY | cell2) : (cell2 << MAX_CELL_BINARY | cell1))
		if (Hash in LOS_WITH_BASE_HASH_CACHE) return LOS_WITH_BASE_HASH_CACHE[Hash]
		var TmpLos = getLosWithoutCache(cell1, cell2, State, BaseHash)
		LOS_WITH_BASE_HASH_CACHE[Hash] = TmpLos
		return TmpLos
	}

	static getLosWithBaseHash(cell1, cell2, State, BaseHash) {
		// Clé CANONIQUE (min, max) sous BaseHash : LOS(A,B) == LOS(B,A).
		var Hash = addValueToBinHash((OFFSET_BASIS ^ BaseHash), cell1 < cell2 ? (cell1 << MAX_CELL_BINARY | cell2) : (cell2 << MAX_CELL_BINARY | cell1))
		if (Hash in LOS_WITH_BASE_HASH_CACHE) return LOS_WITH_BASE_HASH_CACHE[Hash]
		var TmpLos = getLosWithoutCache(cell1, cell2, State, BaseHash)
		LOS_WITH_BASE_HASH_CACHE[Hash] = TmpLos
		return TmpLos
	}

	/* Tracé de LoS exact (lignes, colonnes, diagonales, chemin de Christoffel simplifié). */
	static getLosWithoutCache(cell_dep, cell_but, State, BaseHash) {
		// Coordonnées des cases départ et but
		var X_d = CELL_X[cell_dep],
			Y_d = CELL_Y[cell_dep],
			X_b = CELL_X[cell_but],
			Y_b = CELL_Y[cell_but]

		var FilledCells = getFilledCells(State, BaseHash)

		// Cas de cellules inexistantes
		if (cell_dep == null || cell_but == null) { return null; }

		// Même cellule
		if (cell_dep == cell_but) { return true; }

		// Delta et signes
		var dx = X_b - X_d,
			dy = Y_b - Y_d,
			xx = (dx > 0) ? 1 : -1,
			yy = (dy > 0) ? 1 : -1,
			c = xx * dx,   // abs(dx)
			d = yy * dy;   // abs(dy)

		// Cas sur la même colonne
		if (c == 0) {
			var Y = Y_d;
			while (Y != Y_b) {
				Y += yy;
				if (Y == Y_b) { return true; }
				if (FilledCells[getCellFromXY(X_d, Y)]) { return false; }
			}
		}
		// Cas sur la même ligne
		else if (d == 0) {
			var X = X_d;
			while (X != X_b) {
				X += xx;
				if (X == X_b) { return true; }
				if (FilledCells[getCellFromXY(X, Y_d)]) { return false; }
			}
		}
		// Cas diagonale (|dx| == |dy|)
		else if (c == d) {
			var X = X_d,
				Y = Y_d;
			while (X != X_b) {
				X += xx;
				Y += yy;
				if (X == X_b) { return true; }
				if (FilledCells[getCellFromXY(X, Y)]) { return false; }
			}
		}
		// Cas général : chemin de Christoffel simplifié
		else {
			// Paramètres de la récurrence
			var base = 2 * c + 2 * d;
			var u = c + d;      // u_0
			var X = X_d,
				Y = Y_d;

			// Tant qu'on n'a pas atteint la case but
			while (X != X_b || Y != Y_b) {
				var u_next = (u + 2 * d) % base;

				if (u_next == 0) {
					// Passage par un coin : on avance en X et en Y
					X += xx;
					Y += yy;
					// Si on a atteint la case but
					if (X == X_b && Y == Y_b) { return true; }
					// Test d'obstacle
					if (FilledCells[getCellFromXY(X, Y)]) { return false; }
					// On incrémente "deux fois" u pour passer le coin
					u = (u_next + 2 * d) % base;
				}
				else if (u_next > u) {
					// On va vers la droite (X)
					X += xx;
					if (X == X_b && Y == Y_b) { return true; }
					if (FilledCells[getCellFromXY(X, Y)]) { return false; }
					u = u_next;
				}
				else {
					// On va vers le haut (Y)
					Y += yy;
					if (X == X_b && Y == Y_b) { return true; }
					if (FilledCells[getCellFromXY(X, Y)]) { return false; }
					u = u_next;
				}
			}
			return true;
		}
	}

	static getFilledCells(State, BaseHash) {
		if (BaseHash in FILLED_CELLS_CACHE) return FILLED_CELLS_CACHE[BaseHash]
		var _final = clone(TMPOBSTACLES)
		for (var e:var stat in State) {
			if (e != Me && stat.LIFE > 0) _final[stat.CELL] = true
		}
		FILLED_CELLS_CACHE[BaseHash] = _final
		return _final
	}
}