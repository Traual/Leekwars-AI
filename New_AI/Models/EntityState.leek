/*
 * État complet d'une entité, capturé depuis le moteur : stats, shields, effets,
 * inventaire (cooldowns/uses), poisons agrégés, et les valeurs d'origine nécessaires
 * à Libération / Manumission.
 */

include("../includes.leek")

class EntityStateClass extends EntityClass {
	ABSOLUTE_SHIELD
	RELATIVE_SHIELD
	DAMAGE_RETURN
	POWER
	WEAPON
	COOLDOWNS
	USES
	// Overlay différentiel de l'inventaire : null = racine (COOLDOWNS/USES complets) ;
	// sur un clone simulé de Me, pointe l'état précédent et les maps ne portent que les
	// patches locaux (résolution par StateClass.cooldownOf/usesOf, chaîne immuable).
	ITEM_STATE_PARENT
	EFFECTS
	// Memos de champs dérivés (scoring), calculés paresseusement. COPIÉS au clone puis
	// VALIDÉS après l'action (StateClass.diffMaskOf, appelé par Node sur chaque
	// cloné) : un clone dont les inputs n'ont pas bougé garde ses mémos. Écrire un memo sur
	// un objet PARTAGÉ est sain : partage => stats identiques => même valeur.
	CAP_MEMO    // ImportanceClass.capability(stat)
	TLSQ_MEMO   // W_TOTAL_LIFE * sqrt(max(0, TOTAL_LIFE)) (terme hors cache de survivalValue)
	PKEY_MEMO   // contribution de ce porteur a la cle de couverture antidote (ScoringClass.poisonKeyOf)
	ANTICD_MEMO // cooldown effectif d'Antidote, 99 sans le chip (DangerComboClass.antidoteCdOf)
	// Cooldowns effectifs des deux chips de DÉPLACEMENT, -1 quand le chip n'est pas équipé.
	// Seul StateClass.setCooldown peut les périmer, et il les remet à null en passant : la
	// chaîne d'inventaire n'est donc remontée qu'après un vrai saut ou une vraie télépo.
	JCD_MEMO
	TCD_MEMO
	// Un effet touchant l'un des dix inputs de capability est passé sur cette entité pendant
	// l'action. Remis à faux par le clone de simulation, posé par le ledger d'effets
	// (RecordCastedEffect / removeCastedEffect) : sans lui, diffMaskOf saute les dix
	// comparaisons de capability.
	CAP_DIRTY
	// Six flux périodiques SÉPARÉS et POSITIFS (jamais de "poison négatif") :
	POISON                  // prochain tick des lignes EFFECT_POISON seules
	POISON_OVER_TIME        // somme valeur × tours restants de ces lignes
	AFTEREFFECT             // prochain tick des lignes EFFECT_AFTEREFFECT
	AFTEREFFECT_OVER_TIME
	HEAL                    // prochain tick des EFFECT_HEAL persistants (HoT)
	HEAL_OVER_TIME
	LIFE
	TOTAL_LIFE
	// Bases VRAIES (stat sans aucun effet), une seule map indexée par les constantes
	// STAT_* du moteur au lieu de huit champs froids : lue uniquement par la Résurrection,
	// IMMUABLE pendant toute la simulation -> clone(stat, 1) en partage la référence.
	BASE_STATS
	STRENGTH
	WISDOM
	AGILITY
	RESISTANCE
	SCIENCE
	MAGIC
	// Boucliers qui TOMBERONT pendant la fenêtre de danger, liste plate
	// [lanceur, retrait absolu, retrait relatif] — null quand il n'y en a aucun, ce qui est
	// le cas ultra-majoritaire. Jamais mutée en place : refreshShieldExpiry la REMPLACE, un
	// clone peut donc en partager la référence.
	SHIELD_EXPIRY
	SHIELD_EXPIRY_HASH   // digest de la liste, exactement 0 quand elle est vide
	// ETATS DU MOTEUR, en MASQUE DE BITS : le bit i vaut l'ordinal i de attack/EntityState.java
	// (NONE 0, RESURRECTED 1, UNHEALABLE 2, INVINCIBLE 3, PACIFIST 4, HEAVY 5, DENSE 6,
	// MAGNETIZED 7, CHAINED 8, ROOTED 9, PETRIFIED 10, STATIC 11).
	//
	// Lu par getStates(id), qui rend l'ensemble des ordinaux : source AUTORITAIRE, et surtout
	// GENERIQUE — un etat ajoute au moteur entre dans le masque sans toucher a ce code, seule
	// la regle qui l'exploite reste a ecrire. Un masque plutot qu'un tableau : un champ entier
	// de plus par clone, contre une allocation par entite.
	//
	// Ce que le moteur teste REELLEMENT aujourd'hui (grep hasState) :
	//   INVINCIBLE : degats a ZERO dans les cinq familles, et le porteur ne subit AUCUN retour
	//   UNHEALABLE : bloque soin, soin brut, vol de vie, et le lifesteal credite au lanceur
	//   STATIC     : l'entite ne peut pas se deplacer (State.java:775, 796, 817)
	//   PACIFIST   : declare mais teste NULLE PART — il ne fait rien
	STATES
	MP
	TOTAL_MP
	TP
	TOTAL_TP
	CELL
	constructor(id) {
		super(id)
		// Masque construit en une lecture : getStates coute 25 operations, payees une fois par
		// entite et par virtualisation, jamais dans le chemin chaud des nœuds.
		this.STATES = 0
		var st = getStates(id)
		if (st != null) for (var o in st) this.STATES |= (1 << o)
		this.ABSOLUTE_SHIELD = getAbsoluteShield(id)
		this.RELATIVE_SHIELD = getRelativeShield(id)
		this.DAMAGE_RETURN = getDamageReturn(id)
		this.POWER = getPower(id)
		this.WEAPON = getWeapon(id)
		this.ITEM_STATE_PARENT = null   // état réel = racine : maps complètes
		this.USES = [: ]
		// getItemUses est un builtin ENTITÉ COURANTE (1 arg) : l'appeler pour un autre id
		// stockerait MES compteurs chez tout le monde. Le moteur clear les uses au endTurn de
		// chaque entité -> pendant mon tour, les autres sont toujours à 0, et usesOf rend déjà
		// 0 sur un item absent de toute la chaîne : leurs entrées ne sont pas matérialisées.
		if (id == Me) {
			// Mes cooldowns bougent à chaque action réelle : relevés à chaque construction.
			this.COOLDOWNS = [: ]
			for (var i in this.INVENTORY) {
				this.COOLDOWNS[i] = ItemClass.Cooldown(i, id)
				this.USES[i] = getItemUses(i)
			}
		} else if (id in ENTITY_COOLDOWNS_BY_ID) {
			this.COOLDOWNS = ENTITY_COOLDOWNS_BY_ID[id]
		} else {
			var cooldowns = [: ]
			for (var i in this.INVENTORY) cooldowns[i] = ItemClass.Cooldown(i, id)
			ENTITY_COOLDOWNS_BY_ID[id] = cooldowns
			this.COOLDOWNS = cooldowns
		}
		// Ligne d'effet DATEE : au layout moteur [type, valeur, lanceur, tours, critique,
		// item, cible, modifiers] s'ajoute en index 8 le nombre de ticks que cette ligne fera
		// ENCORE tomber. Les agregats periodiques sont ecrits avec ce nombre et effaces avec
		// lui, donc il doit etre le MEME aux deux bouts : le memoriser garantit l'egalite, la
		// ou le recalculer au retrait la brise des que l'ordre de lecture change. Il reste
		// valable tout le tour — invocation et resurrection inserent un creneau sans permuter
		// les vivants, et une ligne dont le lanceur ou le porteur meurt disparait.
		var rawEffects = getEffects(id)
		var datedEffects = []
		var myOrder = MY_TURN_ORDER
		var thisOrder = this.TURN_ORDER
		for (var eff in rawEffects) {
			push(datedEffects, [eff[0], eff[1], eff[2], eff[3], eff[4], eff[5], eff[6], eff[7],
				EntityStateClass.countedTicks(eff, thisOrder, myOrder)])
		}
		this.EFFECTS = datedEffects
		// Flux périodiques remplis en UNE passe, dans le déroulé d'effets plus bas.
		this.POISON = 0
		this.POISON_OVER_TIME = 0
		this.AFTEREFFECT = 0
		this.AFTEREFFECT_OVER_TIME = 0
		this.HEAL = 0
		this.HEAL_OVER_TIME = 0
		this.LIFE = getLife(id)
		this.TOTAL_LIFE = getTotalLife(id)
		this.STRENGTH = getStrength(id)
		this.WISDOM = getWisdom(id)
		this.AGILITY = getAgility(id)
		this.RESISTANCE = getResistance(id)
		this.SCIENCE = getScience(id)
		this.MAGIC = getMagic(id)
		this.MP = getMP(id)
		this.TOTAL_MP = getTotalMP(id)
		this.TP = getTP(id)
		this.TOTAL_TP = getTotalTP(id)

		// Stats de BASE VRAIE, reconstituées en dépliant les effets actifs :
		// base = courante − buffs + shackles = la stat sans AUCUN effet. Sert la
		// RÉSURRECTION (reset aux bases vraies) ; Libération travaille ligne à ligne sur le
		// ledger (getEntityDebuffConsequences) et Manumission par ligne via
		// removeCastedEffect, aucune des deux ne passe par une base.
		this.BASE_STATS = [
			STAT_STRENGTH:   this.STRENGTH,
			STAT_WISDOM:     this.WISDOM,
			STAT_AGILITY:    this.AGILITY,
			STAT_RESISTANCE: this.RESISTANCE,
			STAT_SCIENCE:    this.SCIENCE,
			STAT_MAGIC:      this.MAGIC,
			STAT_MP:         this.TOTAL_MP,
			STAT_TP:         this.TOTAL_TP
		]

		// TICKS RESTANTS D'UN FLUX PÉRIODIQUE — le moteur ne les compte pas comme on le croyait.
		// Le tick tombe au tour du PORTEUR (Entity.startTurn:768-774) mais la durée n'est
		// décrémentée qu'au tour du LANCEUR (:776-790, seul site de setTurns). Quand l'IA
		// s'exécute, son propre tick de la ronde est déjà tombé et le compteur n'a pas bougé :
		// eff[3] surestime donc d'UN tick toute ligne dont le prochain tour du lanceur précède
		// celui du porteur. Une ligne auto-lancée garde bien eff[3], le tick précédant la
		// décrémentation dans le même startTurn.
		for (var eff in this.EFFECTS) {
			switch (eff[0]) {
				// --- AGILITY ---
				case EFFECT_BUFF_STRENGTH:
				case EFFECT_RAW_BUFF_STRENGTH:
					this.BASE_STATS[STAT_STRENGTH] -= eff[1]
					break
				case EFFECT_HEAL:
					// Persistant seulement — un heal instantané (durée 0) n'entre jamais au
					// ledger moteur, garde par sécurité.
					if (eff[3] > 0) {
						var healTicks = eff[8]
						if (healTicks > 0) this.HEAL += eff[1]
						this.HEAL_OVER_TIME += eff[1] * healTicks
					}
					break
				case EFFECT_BUFF_TP:
				case EFFECT_RAW_BUFF_TP:
					this.BASE_STATS[STAT_TP] -= eff[1]
					break
				case EFFECT_BUFF_WISDOM:
				case EFFECT_RAW_BUFF_WISDOM:
					this.BASE_STATS[STAT_WISDOM] -= eff[1]
					break
				case EFFECT_BUFF_AGILITY:
				case EFFECT_RAW_BUFF_AGILITY:
					this.BASE_STATS[STAT_AGILITY] -= eff[1]
					break
				case EFFECT_BUFF_RESISTANCE:
				case EFFECT_RAW_BUFF_RESISTANCE:
					this.BASE_STATS[STAT_RESISTANCE] -= eff[1]
					break

					// --- MP ---
				case EFFECT_BUFF_MP:
				case EFFECT_RAW_BUFF_MP:
					this.BASE_STATS[STAT_MP] -= eff[1]
					break
				case EFFECT_RAW_BUFF_MAGIC:
					this.BASE_STATS[STAT_MAGIC] -= eff[1]
					break
				case EFFECT_RAW_BUFF_SCIENCE:
					this.BASE_STATS[STAT_SCIENCE] -= eff[1]
					break

					// --- RESISTANCE ---
				case EFFECT_AFTEREFFECT:
					var afterTicks = eff[8]
					if (afterTicks > 0) this.AFTEREFFECT += eff[1]
					this.AFTEREFFECT_OVER_TIME += eff[1] * afterTicks
					break
				case EFFECT_SHACKLE_TP:
					this.BASE_STATS[STAT_TP] += eff[1]
					break

					// --- FLUX PÉRIODIQUES (même passe, six agrégats positifs) ---
				case EFFECT_POISON:
					var poisonTicks = eff[8]
					if (poisonTicks > 0) this.POISON += eff[1]
					this.POISON_OVER_TIME += eff[1] * poisonTicks
					break
				case EFFECT_SHACKLE_MP:
					this.BASE_STATS[STAT_MP] += eff[1]
					break

					// --- TP ---
				case EFFECT_SHACKLE_AGILITY:
					this.BASE_STATS[STAT_AGILITY] += eff[1]
					break

					// --- STRENGTH ---
				case EFFECT_SHACKLE_STRENGTH:
					this.BASE_STATS[STAT_STRENGTH] += eff[1]
					break

					// --- WISDOM ---
				case EFFECT_SHACKLE_WISDOM:
					this.BASE_STATS[STAT_WISDOM] += eff[1]
					break

					// --- MAGIC ---
				case EFFECT_SHACKLE_MAGIC:
					this.BASE_STATS[STAT_MAGIC] += eff[1]
					break

					// --- SCIENCE ---
			}
		}

		this.CELL = getCell(id)
		EntityStateClass.refreshShieldExpiry(this)
	}

	/*
	 * (Re)calcule les boucliers qui tomberont pendant la fenêtre de danger.
	 * Le moteur retire un effet au début du tour de son LANCEUR (Entity.startTurn décrémente
	 * launchedEffects, puis retire la ligne chez la cible) : un bouclier à qui il ne reste
	 * qu'un tour protège jusqu'à ce que son lanceur rejoue, et plus après.
	 * Un bouclier AUTO-LANCÉ n'est jamais listé — il expire au début du tour de la cible,
	 * donc après toute la fenêtre.
	 * `turns == 1` suffit à qualifier : c'est exactement la durée d'un effet retiré pendant la
	 * fenêtre, puisqu'il tombe au prochain tour de son lanceur.
	 *
	 * VULNÉRABILITÉS COMPRISES. Une vulnérabilité est un bouclier NÉGATIF sur la même stat —
	 * EffectVulnerability.java:12-15 fait `setStat(STAT_RELATIVE_SHIELD, -value)` — et le moteur
	 * la retire par la MÊME règle de lanceur (Entity.java:776-790, sans distinction de type).
	 * Elle entre donc dans la liste avec un retrait NÉGATIF : quand elle tombe, le porteur
	 * RÉCUPÈRE du bouclier. Sans cela, l'IA appliquait une vulnérabilité déjà tombée à tous les
	 * attaquants jouant après son lanceur et surestimait les dégâts entrants exactement pour les
	 * casters les plus tardifs de la fenêtre — donc fuyait plus qu'il ne faut. Les trois porteuses
	 * de la méta durent toutes UN tour : shotgun (absolue 25), heavy_sword (absolue 60),
	 * inversion (relative 20).
	 *
	 * Conséquence sur l'invariant d'origine : un BOUCLIER posé en branche n'entre toujours jamais
	 * dans la liste (aucun ne dure un seul tour), mais une VULNÉRABILITÉ posée en branche, elle,
	 * y entre — et c'est correct, elle tombera bien au prochain tour de son lanceur.
	 *
	 * À rappeler après TOUTE réécriture d'EFFECTS qui peut retirer ou réduire un bouclier
	 * ou une vulnérabilité.
	 */
	/*
	 * Ticks qu'une ligne périodique fera ENCORE tomber sur son porteur.
	 *
	 * Le moteur applique le tick au début du tour du PORTEUR puis décrémente, au début du tour
	 * du LANCEUR, les durées des lignes que CELUI-CI a posées (Entity.java:762-790). Il reste
	 * donc eff[3] − 1 ticks quand le prochain tour du lanceur précède celui du porteur, et
	 * eff[3] sinon — l'auto-lancé restant à eff[3] puisque, dans un même startTurn, le tick
	 * (:768) précède la décrémentation (:776).
	 *
	 * Lanceur mort ou absent de l'ordre de tour : plus personne ne décrémente sa ligne, elle
	 * ne tombera jamais d'elle-même. On garde eff[3], qui la sous-estime alors — jamais
	 * l'inverse.
	 */
	/*
	 * Appele une fois par ligne importee, jamais dans un nœud : le resultat part en index 8.
	 * L'ordre du lanceur passe par un memo de tour, plusieurs lignes le partageant souvent.
	 */
	static countedTicks(eff, bearerOrder, myTurnOrder) {
		var casterId = eff[2]
		var casterOrder = 0
		if (casterId in TURN_ORDER_BY_ID) {
			casterOrder = TURN_ORDER_BY_ID[casterId]
		} else {
			casterOrder = getEntityTurnOrder(casterId)
			TURN_ORDER_BY_ID[casterId] = casterOrder
		}
		if (casterOrder <= 0) return eff[3]
		return nextTurnBefore(casterOrder, bearerOrder, myTurnOrder) ? eff[3] - 1 : eff[3]
	}

	/*
	 * Le prochain tour de A tombe-t-il avant celui de B, vu de MAINTENANT — mon tour étant en
	 * cours ? Une entité dont l'ordre dépasse le mien rejoue dans cette ronde, les autres à la
	 * ronde suivante ; à catégorie égale l'ordre tranche. Deux entités de même ordre (donc la
	 * même) rendent faux, ce qui donne bien eff[3] à l'auto-lancé.
	 */
	static nextTurnBefore(orderA, orderB, myTurnOrder) {
		var aThisRound = orderA > myTurnOrder
		var bThisRound = orderB > myTurnOrder
		if (aThisRound != bThisRound) return aThisRound
		return orderA < orderB
	}

	/* L'entite porte-t-elle cet etat ? `state` est l'ordinal moteur. */
	static hasState(stats, state) {
		return (stats.STATES >> state) & 1
	}

	/*
	 * Relit le masque d'etats dans les lignes portees, comme le moteur : updateBuffStats vide
	 * l'ensemble puis le refait ligne par ligne (Entity.java:892-902). Un bit ne peut donc pas
	 * s'effacer tout seul — deux lanceurs peuvent accorder le meme etat, et retirer le bit sans
	 * relire les lignes le supprimerait a tort.
	 * Appelee UNIQUEMENT quand une ligne d'etat vient de disparaitre : remplacement, mort du
	 * lanceur, debuff total. Jamais dans le chemin chaud.
	 */
	static refreshStates(stats) {
		var mask = 0
		for (var eff in stats.EFFECTS) {
			if (eff[0] == EFFECT_ADD_STATE) mask |= (1 << eff[1])
		}
		stats.STATES = mask
	}

	static refreshShieldExpiry(stats) {
		var list = null
		var bearerOrder = stats.TURN_ORDER
		var myOrder = MY_TURN_ORDER
		for (var eff in stats.EFFECTS) {
			var dur = eff[3]
			// Seules les durees 1 et 2 peuvent tomber dans la fenetre : d* n'y vaut que 0, 1 ou 2.
			// La duree -1 est le permanent du moteur, hors de ce calcul.
			if (dur != 1 && dur != 2) continue
			var casterId = eff[2]
			var casterOrder = (casterId in TURN_ORDER_BY_ID) ? TURN_ORDER_BY_ID[casterId] : 0
			// Lanceur vivant hors de l'ordre de tour : personne ne decremente sa ligne, elle ne
			// tombe jamais d'elle-meme. Un lanceur MORT, lui, a deja vu ses lignes retirees.
			if (casterOrder <= 0) continue
			// Date de l'expiration contre la fenetre projetee W = [(R,T), (R+1,T)), R la ronde
			// courante et T l'ordre du porteur — la fenetre que le sequenceur du danger utilise
			// deja, pivotee sur la cible et ouverte a son creneau de CETTE ronde.
			// L'expiration moteur tombe en (R + [C <= M] + d - 1, C), le creneau du lanceur dans
			// la fenetre est (R + [C < T], C), d'ou le nombre de tours qui l'y amenent :
			var dStar = (casterOrder < bearerOrder ? 1 : 0) - (casterOrder <= myOrder ? 1 : 0) + 1
			// d > d* : l'expiration tombe apres la fermeture, rien a retirer sur ce cycle.
			// d < d* : elle est deja acquise a l'ouverture, elle vaut pour TOUS les attaquants.
			// d = d* : elle tombe au creneau du lanceur, avant qu'il n'agisse.
			// Un bouclier AUTO-LANCE se range tout seul : C = T donne d* = 1 quand le porteur
			// rejoue apres moi (retrait au rang zero) et d* = 0 sinon — le bouclier d'un tour que
			// Me vient de se poser le protege donc jusqu'a son prochain tour.
			if (dur > dStar) continue
			var t = eff[0]
			var abs = 0
			var rel = 0
			if (t == EFFECT_ABSOLUTE_SHIELD || t == EFFECT_RAW_ABSOLUTE_SHIELD) abs = eff[1]
			else if (t == EFFECT_RELATIVE_SHIELD || t == EFFECT_RAW_RELATIVE_SHIELD) rel = eff[1]
			// Retrait NÉGATIF : le consommateur fait `chainAbs -= drop`, et la chute d'une
			// vulnérabilité REND du bouclier au porteur.
			else if (t == EFFECT_ABSOLUTE_VULNERABILITY) abs = -eff[1]
			else if (t == EFFECT_VULNERABILITY) rel = -eff[1]
			else continue
			if (list == null) list = []
			push(list, dur < dStar ? EXPIRY_PRE_OPENING : casterId)
			push(list, abs)
			push(list, rel)
		}
		stats.SHIELD_EXPIRY = list
		if (list == null) {
			// Zéro est RÉSERVÉ à la liste vide : la graine de danger reste alors bit-à-bit
			// celle d'avant, et aucune clé de cache ne bouge sur le cas courant.
			stats.SHIELD_EXPIRY_HASH = 0
			return;
		}
		// Digest de longueur variable : chaîne à MULTIPLICATION (contrat des clés, famille 3b).
		var h = OFFSET_BASIS
		for (var v in list) h = (h ^ v) * MIX_A
		stats.SHIELD_EXPIRY_HASH = h
	}

	// (Les anciens getters getPoisons/getPoisonsOverTime/getJustPoisons* sont supprimés :
	// les six flux se remplissent dans la passe unique du constructeur.)

}
