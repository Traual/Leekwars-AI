/**
 * Class State : Variables of a state
 **/

include("../includes.leek")

class EntityStateClass extends EntityClass {
	ABSOLUTE_SHIELD
	RELATIVE_SHIELD
	DAMAGE_RETURN
	POWER
	SUMMONS
	WEAPON
	COOLDOWNS
	USES
	EFFECTS
	EFFECTS_ITEM_MAP
	// Derived-field MEMOS (scoring): computed lazily, valid while the stats don't change —
	// guaranteed by clone-on-write: stats only ever mutate on FRESH clones, and the clone sites
	// (CloneOnlyTargetsAndMe / ensureCloned / the Node resurrection pre-clone) null these two.
	// Writing a memo on a SHARED object is safe: sharing implies identical stats -> same value.
	CAP_MEMO    // ImportanceClass.capability(stat)
	TLSQ_MEMO   // W_TOTAL_LIFE * sqrt(max(0, TOTAL_LIFE)) (survivalValue's out-of-cache term)
	POISON
	POISON_OVER_TIME
	JUST_POISON
	JUST_POISON_OVER_TIME
	LIFE
	TOTAL_LIFE
	STRENGTH
	TO_SAVE_STRENGTH //Oui on doit save POS et NEG pour Manumission (retire les neg) et liberations (retire 60% de POS et NEG)
	TO_SAVE_SHACKLE_STRENGTH
	WISDOM
	TO_SAVE_WISDOM
	TO_SAVE_SHACKLE_WISDOM
	AGILITY
	TO_SAVE_AGILITY
	TO_SAVE_SHACKLE_AGILITY
	RESISTANCE
	TO_SAVE_RESISTANCE
	//TO_SAVE_SHACKLE_RESISTANCE //Does not exist (yet)
	SCIENCE
	TO_SAVE_SCIENCE
	//TO_SAVE_SHACKLE_SCIENCE //Does not exist (yet)
	MAGIC
	TO_SAVE_MAGIC
	TO_SAVE_SHACKLE_MAGIC
	FREQUENCY //No need to save cuz not usefull for Liberation/Manumission 
	MP
	TOTAL_MP
	TO_SAVE_TOTAL_MP
	TO_SAVE_SHACKLE_TOTAL_MP
	TP
	TOTAL_TP
	TO_SAVE_TOTAL_TP
	TO_SAVE_SHACKLE_TOTAL_TP
	CELL
	constructor(id) {
		super(id)
		this.ABSOLUTE_SHIELD = getAbsoluteShield(id)
		this.RELATIVE_SHIELD = getRelativeShield(id)
		this.DAMAGE_RETURN = getDamageReturn(id) //Its always 0 at the start, so like this i will save the exact total buff of each so not saving it
		this.POWER = getPower(id)
		this.SUMMONS = getSummons(id)
		this.WEAPON = getWeapon(id)
		this.COOLDOWNS = [: ]
		this.USES = [: ]
		for (var i in this.INVENTORY) {
			this.COOLDOWNS[i] = ItemClass.Cooldown(i, id)
			// getItemUses est un builtin ENTITE COURANTE (1 arg) : l'appeler pour un AUTRE id stockait MES
			// compteurs chez tout le monde -> pour un item partage (meme chip), apres mon cast la simu
			// cappait a tort le potentiel next-turn de l'ennemi (uses < MAX_USES). Le moteur clear les
			// uses au endTurn de CHAQUE entite -> pendant mon tour, les autres sont toujours a 0.
			this.USES[i] = id == Me ? getItemUses(i) : 0
		}
		this.EFFECTS = getEffects(id)
		//this.EFFECTS_ITEM_MAP = getEffectsMapItem(this.EFFECTS)
		this.POISON = getPoisons(this.EFFECTS)
		this.POISON_OVER_TIME = getPoisonsOverTime(this.EFFECTS)
		this.JUST_POISON = getJustPoisons(this.EFFECTS)
		this.JUST_POISON_OVER_TIME = getJustPoisonsOverTime(this.EFFECTS)
		/**
		 * Leek Stats
		 **/
		this.LIFE = getLife(id)
		this.TOTAL_LIFE = getTotalLife(id)
		this.STRENGTH = getStrength(id)
		this.WISDOM = getWisdom(id)
		this.AGILITY = getAgility(id)
		this.RESISTANCE = getResistance(id)
		this.SCIENCE = getScience(id)
		this.MAGIC = getMagic(id)
		this.FREQUENCY = getFrequency(id)
		this.MP = getMP(id)
		this.TOTAL_MP = getTotalMP(id)
		this.TP = getTP(id)
		this.TOTAL_TP = getTotalTP(id)
		/**
		 * Original Stats for Libe And Shackle summ for Manumission
		 **/
		this.TO_SAVE_STRENGTH = this.STRENGTH //initial strength of the leek
		this.TO_SAVE_SHACKLE_STRENGTH = 0 //Total Shackle Effects
		this.TO_SAVE_WISDOM = this.WISDOM
		this.TO_SAVE_SHACKLE_WISDOM = 0
		this.TO_SAVE_AGILITY = this.AGILITY
		this.TO_SAVE_SHACKLE_AGILITY = 0
		this.TO_SAVE_RESISTANCE = this.RESISTANCE
		//this.TO_SAVE_SHACKLE_RESISTANCE = 0
		this.TO_SAVE_SCIENCE = this.SCIENCE
		//this.TO_SAVE_SHACKLE_SCIENCE = 0
		this.TO_SAVE_MAGIC = this.MAGIC
		this.TO_SAVE_SHACKLE_MAGIC = 0
		//this.TO_SAVE_MP = this.MP
		//this.TO_SAVE_SHACKLE_MP = 0
		this.TO_SAVE_TOTAL_MP = this.TOTAL_MP
		this.TO_SAVE_SHACKLE_TOTAL_MP = 0
		//this.TO_SAVE_TP = this.TP
		//this.TO_SAVE_SHACKLE_TP = 0
		this.TO_SAVE_TOTAL_TP = this.TOTAL_TP
		this.TO_SAVE_SHACKLE_TOTAL_TP = 0

		for (var eff in this.EFFECTS) {
			switch (eff[0]) {
				// --- AGILITY ---
				case EFFECT_BUFF_AGILITY:
				case EFFECT_RAW_BUFF_AGILITY:
					this.TO_SAVE_AGILITY -= eff[1]
					break
				case EFFECT_SHACKLE_AGILITY:
					this.TO_SAVE_SHACKLE_AGILITY += eff[1]
					break

					// --- STRENGTH ---
				case EFFECT_BUFF_STRENGTH:
				case EFFECT_RAW_BUFF_STRENGTH:
				case EFFECT_DAMAGE_TO_STRENGTH:
					this.TO_SAVE_STRENGTH -= eff[1]
					break
				case EFFECT_SHACKLE_STRENGTH:
					this.TO_SAVE_SHACKLE_STRENGTH += eff[1]
					break

					// --- WISDOM ---
				case EFFECT_BUFF_WISDOM:
				case EFFECT_RAW_BUFF_WISDOM:
					this.TO_SAVE_WISDOM -= eff[1]
					break
				case EFFECT_SHACKLE_WISDOM:
					this.TO_SAVE_SHACKLE_WISDOM += eff[1]
					break

					// --- MAGIC ---
				case EFFECT_RAW_BUFF_MAGIC:
				case EFFECT_NOVA_DAMAGE_TO_MAGIC:
					this.TO_SAVE_MAGIC -= eff[1]
					break
				case EFFECT_SHACKLE_MAGIC:
					this.TO_SAVE_SHACKLE_MAGIC += eff[1]
					break

					// --- SCIENCE ---
				case EFFECT_RAW_BUFF_SCIENCE:
				case EFFECT_POISON_TO_SCIENCE:
					this.TO_SAVE_SCIENCE -= eff[1]
					break

					// --- RESISTANCE ---
				case EFFECT_BUFF_RESISTANCE:
				case EFFECT_RAW_BUFF_RESISTANCE:
					this.TO_SAVE_RESISTANCE -= eff[1]
					break

					// --- MP ---
				case EFFECT_BUFF_MP:
				case EFFECT_RAW_BUFF_MP:
				case EFFECT_MOVED_TO_MP:
					this.TO_SAVE_TOTAL_MP -= eff[1]
					break
				case EFFECT_SHACKLE_MP:
					this.TO_SAVE_SHACKLE_TOTAL_MP += eff[1]
					break

					// --- TP ---
				case EFFECT_BUFF_TP:
				case EFFECT_RAW_BUFF_TP:
				case EFFECT_KILL_TO_TP:
					this.TO_SAVE_TOTAL_TP -= eff[1]
					break
				case EFFECT_SHACKLE_TP:
					this.TO_SAVE_SHACKLE_TOTAL_TP += eff[1]
					break
			}
		}

		/**
		 * Map Stats
		 **/
		this.CELL = getCell(id)
	}

	getPoisons(Effects) {
		var Poisons = 0
		for (var eff in Effects) {
			switch (eff[0]) {
				case EFFECT_POISON:
					Poisons += eff[1]
					break
				case EFFECT_HEAL:
					Poisons -= eff[1]
					break
			}
		}
		return Poisons
	}

	getPoisonsOverTime(Effects) {
		var Poisons = 0
		for (var eff in Effects) {
			switch (eff[0]) {
				case EFFECT_POISON:
					Poisons += eff[1] * eff[3]
					break
				case EFFECT_HEAL:
					Poisons -= eff[1] * eff[3]
					break
			}
		}
		return Poisons
	}

	getJustPoisons(Effects) {
		var Poisons = 0
		for (var eff in Effects) {
			switch (eff[0]) {
				case EFFECT_POISON:
					Poisons += eff[1]
					break
			}
		}
		return Poisons
	}

	getJustPoisonsOverTime(Effects) {
		var Poisons = 0
		for (var eff in Effects) {
			switch (eff[0]) {
				case EFFECT_POISON:
					Poisons += eff[1] * eff[3]
					break
			}
		}
		return Poisons
	}

}