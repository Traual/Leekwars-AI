/*
 * État complet d'une entité, capturé depuis le moteur : stats, shields, effets,
 * inventaire (cooldowns/uses), poisons agrégés, et les valeurs d'origine nécessaires
 * à Libération / Manumission.
 */

include("../includes.leek")

class EntityStateClass extends EntityClass {
	ABSOLUTE_SHIELD
	RELATIVE_SHIELD
	DAMAGE_RETURN
	POWER
	WEAPON
	COOLDOWNS
	USES
	// Overlay différentiel de l'inventaire : null = racine (COOLDOWNS/USES complets) ;
	// sur un clone simulé de Me, pointe l'état précédent et les maps ne portent que les
	// patches locaux (résolution par StateClass.cooldownOf/usesOf, chaîne immuable).
	ITEM_STATE_PARENT
	EFFECTS
	// Memos de champs dérivés (scoring), calculés paresseusement. COPIÉS au clone puis
	// VALIDÉS après l'action (StateClass.diffMaskOf, appelé par Node sur chaque
	// cloné) : un clone dont les inputs n'ont pas bougé garde ses mémos. Écrire un memo sur
	// un objet PARTAGÉ est sain : partage => stats identiques => même valeur.
	CAP_MEMO    // ImportanceClass.capability(stat)
	TLSQ_MEMO   // W_TOTAL_LIFE * sqrt(max(0, TOTAL_LIFE)) (terme hors cache de survivalValue)
	PKEY_MEMO   // contribution de ce porteur a la cle de couverture antidote (ScoringClass.poisonKeyOf)
	ANTICD_MEMO // cooldown effectif d'Antidote, 99 sans le chip (DangerComboClass.antidoteCdOf)
	// Cooldowns effectifs des deux chips de DÉPLACEMENT, -1 quand le chip n'est pas équipé.
	// Seul StateClass.setCooldown peut les périmer, et il les remet à null en passant : la
	// chaîne d'inventaire n'est donc remontée qu'après un vrai saut ou une vraie télépo.
	JCD_MEMO
	TCD_MEMO
	// Un effet touchant l'un des dix inputs de capability est passé sur cette entité pendant
	// l'action. Remis à faux par le clone de simulation, posé par le ledger d'effets
	// (RecordCastedEffect / removeCastedEffect) : sans lui, diffMaskOf saute les dix
	// comparaisons de capability.
	CAP_DIRTY
	// Six flux périodiques SÉPARÉS et POSITIFS (jamais de "poison négatif") :
	POISON                  // prochain tick des lignes EFFECT_POISON seules
	POISON_OVER_TIME        // somme valeur × tours restants de ces lignes
	AFTEREFFECT             // prochain tick des lignes EFFECT_AFTEREFFECT
	AFTEREFFECT_OVER_TIME
	HEAL                    // prochain tick des EFFECT_HEAL persistants (HoT)
	HEAL_OVER_TIME
	LIFE
	TOTAL_LIFE
	// Bases VRAIES (stat sans aucun effet), une seule map indexée par les constantes
	// STAT_* du moteur au lieu de huit champs froids : lue uniquement par la Résurrection,
	// IMMUABLE pendant toute la simulation -> clone(stat, 1) en partage la référence.
	BASE_STATS
	STRENGTH
	WISDOM
	AGILITY
	RESISTANCE
	SCIENCE
	MAGIC
	// Boucliers qui TOMBERONT pendant la fenêtre de danger, liste plate
	// [lanceur, retrait absolu, retrait relatif] — null quand il n'y en a aucun, ce qui est
	// le cas ultra-majoritaire. Jamais mutée en place : refreshShieldExpiry la REMPLACE, un
	// clone peut donc en partager la référence.
	SHIELD_EXPIRY
	SHIELD_EXPIRY_HASH   // digest de la liste, exactement 0 quand elle est vide
	MP
	TOTAL_MP
	TP
	TOTAL_TP
	CELL
	constructor(id) {
		super(id)
		this.ABSOLUTE_SHIELD = getAbsoluteShield(id)
		this.RELATIVE_SHIELD = getRelativeShield(id)
		this.DAMAGE_RETURN = getDamageReturn(id)
		this.POWER = getPower(id)
		this.WEAPON = getWeapon(id)
		this.ITEM_STATE_PARENT = null   // état réel = racine : maps complètes
		this.USES = [: ]
		// getItemUses est un builtin ENTITÉ COURANTE (1 arg) : l'appeler pour un autre id
		// stockerait MES compteurs chez tout le monde. Le moteur clear les uses au endTurn de
		// chaque entité -> pendant mon tour, les autres sont toujours à 0, et usesOf rend déjà
		// 0 sur un item absent de toute la chaîne : leurs entrées ne sont pas matérialisées.
		if (id == Me) {
			// Mes cooldowns bougent à chaque action réelle : relevés à chaque construction.
			this.COOLDOWNS = [: ]
			for (var i in this.INVENTORY) {
				this.COOLDOWNS[i] = ItemClass.Cooldown(i, id)
				this.USES[i] = getItemUses(i)
			}
		} else if (id in ENTITY_COOLDOWNS_BY_ID) {
			this.COOLDOWNS = ENTITY_COOLDOWNS_BY_ID[id]
		} else {
			var cooldowns = [: ]
			for (var i in this.INVENTORY) cooldowns[i] = ItemClass.Cooldown(i, id)
			ENTITY_COOLDOWNS_BY_ID[id] = cooldowns
			this.COOLDOWNS = cooldowns
		}
		this.EFFECTS = getEffects(id)
		// Flux périodiques remplis en UNE passe, dans le déroulé d'effets plus bas.
		this.POISON = 0
		this.POISON_OVER_TIME = 0
		this.AFTEREFFECT = 0
		this.AFTEREFFECT_OVER_TIME = 0
		this.HEAL = 0
		this.HEAL_OVER_TIME = 0
		this.LIFE = getLife(id)
		this.TOTAL_LIFE = getTotalLife(id)
		this.STRENGTH = getStrength(id)
		this.WISDOM = getWisdom(id)
		this.AGILITY = getAgility(id)
		this.RESISTANCE = getResistance(id)
		this.SCIENCE = getScience(id)
		this.MAGIC = getMagic(id)
		this.MP = getMP(id)
		this.TOTAL_MP = getTotalMP(id)
		this.TP = getTP(id)
		this.TOTAL_TP = getTotalTP(id)

		// Stats de BASE VRAIE, reconstituées en dépliant les effets actifs :
		// base = courante − buffs + shackles = la stat sans AUCUN effet. Sert la
		// RÉSURRECTION (reset aux bases vraies) ; Libération travaille ligne à ligne sur le
		// ledger (getEntityDebuffConsequences) et Manumission par ligne via
		// removeCastedEffect, aucune des deux ne passe par une base.
		this.BASE_STATS = [
			STAT_STRENGTH:   this.STRENGTH,
			STAT_WISDOM:     this.WISDOM,
			STAT_AGILITY:    this.AGILITY,
			STAT_RESISTANCE: this.RESISTANCE,
			STAT_SCIENCE:    this.SCIENCE,
			STAT_MAGIC:      this.MAGIC,
			STAT_MP:         this.TOTAL_MP,
			STAT_TP:         this.TOTAL_TP
		]

		for (var eff in this.EFFECTS) {
			switch (eff[0]) {
				// --- AGILITY ---
				case EFFECT_BUFF_STRENGTH:
				case EFFECT_RAW_BUFF_STRENGTH:
					this.BASE_STATS[STAT_STRENGTH] -= eff[1]
					break
				case EFFECT_HEAL:
					// Persistant seulement — un heal instantané (durée 0) n'entre jamais au
					// ledger moteur, garde par sécurité.
					if (eff[3] > 0) {
						this.HEAL += eff[1]
						this.HEAL_OVER_TIME += eff[1] * eff[3]
					}
					break
				case EFFECT_BUFF_TP:
				case EFFECT_RAW_BUFF_TP:
					this.BASE_STATS[STAT_TP] -= eff[1]
					break
				case EFFECT_BUFF_WISDOM:
				case EFFECT_RAW_BUFF_WISDOM:
					this.BASE_STATS[STAT_WISDOM] -= eff[1]
					break
				case EFFECT_BUFF_AGILITY:
				case EFFECT_RAW_BUFF_AGILITY:
					this.BASE_STATS[STAT_AGILITY] -= eff[1]
					break
				case EFFECT_BUFF_RESISTANCE:
				case EFFECT_RAW_BUFF_RESISTANCE:
					this.BASE_STATS[STAT_RESISTANCE] -= eff[1]
					break

					// --- MP ---
				case EFFECT_BUFF_MP:
				case EFFECT_RAW_BUFF_MP:
					this.BASE_STATS[STAT_MP] -= eff[1]
					break
				case EFFECT_RAW_BUFF_MAGIC:
					this.BASE_STATS[STAT_MAGIC] -= eff[1]
					break
				case EFFECT_RAW_BUFF_SCIENCE:
					this.BASE_STATS[STAT_SCIENCE] -= eff[1]
					break

					// --- RESISTANCE ---
				case EFFECT_AFTEREFFECT:
					this.AFTEREFFECT += eff[1]
					this.AFTEREFFECT_OVER_TIME += eff[1] * eff[3]
					break
				case EFFECT_SHACKLE_TP:
					this.BASE_STATS[STAT_TP] += eff[1]
					break

					// --- FLUX PÉRIODIQUES (même passe, six agrégats positifs) ---
				case EFFECT_POISON:
					this.POISON += eff[1]
					this.POISON_OVER_TIME += eff[1] * eff[3]
					break
				case EFFECT_SHACKLE_MP:
					this.BASE_STATS[STAT_MP] += eff[1]
					break

					// --- TP ---
				case EFFECT_SHACKLE_AGILITY:
					this.BASE_STATS[STAT_AGILITY] += eff[1]
					break

					// --- STRENGTH ---
				case EFFECT_SHACKLE_STRENGTH:
					this.BASE_STATS[STAT_STRENGTH] += eff[1]
					break

					// --- WISDOM ---
				case EFFECT_SHACKLE_WISDOM:
					this.BASE_STATS[STAT_WISDOM] += eff[1]
					break

					// --- MAGIC ---
				case EFFECT_SHACKLE_MAGIC:
					this.BASE_STATS[STAT_MAGIC] += eff[1]
					break

					// --- SCIENCE ---
			}
		}

		this.CELL = getCell(id)
		EntityStateClass.refreshShieldExpiry(this)
	}

	/*
	 * (Re)calcule les boucliers qui tomberont pendant la fenêtre de danger.
	 * Le moteur retire un effet au début du tour de son LANCEUR (Entity.startTurn décrémente
	 * launchedEffects, puis retire la ligne chez la cible) : un bouclier à qui il ne reste
	 * qu'un tour protège jusqu'à ce que son lanceur rejoue, et plus après.
	 * Un bouclier AUTO-LANCÉ n'est jamais listé — il expire au début du tour de la cible,
	 * donc après toute la fenêtre.
	 * `turns == 1` suffit à qualifier : aucun bouclier castable ne dure un seul tour (minimum
	 * deux), un bouclier posé en branche n'entre donc jamais dans la liste.
	 * À rappeler après TOUTE réécriture d'EFFECTS qui peut retirer ou réduire un bouclier.
	 */
	static refreshShieldExpiry(stats) {
		var list = null
		var id = stats.ID
		for (var eff in stats.EFFECTS) {
			if (eff[3] != 1 || eff[2] == id) continue
			var t = eff[0]
			var abs = 0
			var rel = 0
			if (t == EFFECT_ABSOLUTE_SHIELD || t == EFFECT_RAW_ABSOLUTE_SHIELD) abs = eff[1]
			else if (t == EFFECT_RELATIVE_SHIELD || t == EFFECT_RAW_RELATIVE_SHIELD) rel = eff[1]
			else continue
			if (list == null) list = []
			push(list, eff[2])
			push(list, abs)
			push(list, rel)
		}
		stats.SHIELD_EXPIRY = list
		if (list == null) {
			// Zéro est RÉSERVÉ à la liste vide : la graine de danger reste alors bit-à-bit
			// celle d'avant, et aucune clé de cache ne bouge sur le cas courant.
			stats.SHIELD_EXPIRY_HASH = 0
			return;
		}
		// Digest de longueur variable : chaîne à MULTIPLICATION (contrat des clés, famille 3b).
		var h = OFFSET_BASIS
		for (var v in list) h = (h ^ v) * MIX_A
		stats.SHIELD_EXPIRY_HASH = h
	}

	// (Les anciens getters getPoisons/getPoisonsOverTime/getJustPoisons* sont supprimés :
	// les six flux se remplissent dans la passe unique du constructeur.)

}
