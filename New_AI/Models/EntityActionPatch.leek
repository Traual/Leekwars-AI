/*
 * EntityActionPatch (PureDelta) : le PATCH FONCTIONNEL d'une entité pour UN candidat.
 *
 * Le ParentState est STRICTEMENT immuable : Consequences ne mute jamais un EntityState. Chaque
 * transition est un DELTA NUMÉRIQUE (contrat : delta = valeur_moteur_désirée − valeur_effective
 * courante) accumulé ici. Une valeur effective se lit `base + patch` ; une écriture est un
 * add<Field>(delta). Les champs restent NULL tant que leur bit MASK n'est pas posé — jamais
 * d'init à zéro, jamais de tableau indexé par champ, jamais de dispatch générique.
 *
 * Structurels (hors deltas numériques) :
 *   EFFECTS  (PM_EFFECTS)  : tableau EFFECTS effectif FINAL (rebind, jamais mutation en place) ;
 *   WEAPON   (PM_WEAPON)   : arme effective ;
 *   COOLDOWNS (PM_COOLDOWNS)/USES (PM_USES) : [item -> delta numérique] ;
 *   NEW_ENTITY          : BulbState d'un summon né dans l'action ;
 *   REPLACEMENT_ENTITY  : entité complète pour une collision d'id.
 *
 * Les méthodes eff<Field>/add<Field> sont NOMMÉES par champ (aucun switch) : le chemin chaud
 * n'a jamais d'indirection générique, et P2 pourra les inliner sans changer la sémantique.
 */

include("../includes.leek")

class EntityActionPatchClass {
	ID
	MASK
	// Deltas numériques (null tant que le bit n'est pas posé)
	CELL
	LIFE
	TOTAL_LIFE
	STRENGTH
	WISDOM
	AGILITY
	RESISTANCE
	SCIENCE
	MAGIC
	MP
	TOTAL_MP
	TP
	TOTAL_TP
	ABSOLUTE_SHIELD
	RELATIVE_SHIELD
	DAMAGE_RETURN
	POWER
	POISON
	POISON_OVER_TIME
	AFTEREFFECT
	AFTEREFFECT_OVER_TIME
	HEAL
	HEAL_OVER_TIME
	TURN_ORDER
	// Structurels
	EFFECTS
	WEAPON
	COOLDOWNS   // [item -> delta]
	USES        // [item -> delta]
	NEW_ENTITY
	REPLACEMENT_ENTITY

	constructor(id) {
		this.ID = id
		this.MASK = 0
	}

	// --- Lecture effective (base + delta) et accumulation, une paire par champ ---
	effCELL(base) { return base.CELL + ((this.MASK & PM_CELL) ? this.CELL : 0) }
	addCELL(d) { if (this.MASK & PM_CELL) this.CELL += d else { this.CELL = d ; this.MASK |= PM_CELL } }
	effLIFE(base) { return base.LIFE + ((this.MASK & PM_LIFE) ? this.LIFE : 0) }
	addLIFE(d) { if (this.MASK & PM_LIFE) this.LIFE += d else { this.LIFE = d ; this.MASK |= PM_LIFE } }
	effTOTAL_LIFE(base) { return base.TOTAL_LIFE + ((this.MASK & PM_TOTAL_LIFE) ? this.TOTAL_LIFE : 0) }
	addTOTAL_LIFE(d) { if (this.MASK & PM_TOTAL_LIFE) this.TOTAL_LIFE += d else { this.TOTAL_LIFE = d ; this.MASK |= PM_TOTAL_LIFE } }
	effSTRENGTH(base) { return base.STRENGTH + ((this.MASK & PM_STRENGTH) ? this.STRENGTH : 0) }
	addSTRENGTH(d) { if (this.MASK & PM_STRENGTH) this.STRENGTH += d else { this.STRENGTH = d ; this.MASK |= PM_STRENGTH } }
	effWISDOM(base) { return base.WISDOM + ((this.MASK & PM_WISDOM) ? this.WISDOM : 0) }
	addWISDOM(d) { if (this.MASK & PM_WISDOM) this.WISDOM += d else { this.WISDOM = d ; this.MASK |= PM_WISDOM } }
	effAGILITY(base) { return base.AGILITY + ((this.MASK & PM_AGILITY) ? this.AGILITY : 0) }
	addAGILITY(d) { if (this.MASK & PM_AGILITY) this.AGILITY += d else { this.AGILITY = d ; this.MASK |= PM_AGILITY } }
	effRESISTANCE(base) { return base.RESISTANCE + ((this.MASK & PM_RESISTANCE) ? this.RESISTANCE : 0) }
	addRESISTANCE(d) { if (this.MASK & PM_RESISTANCE) this.RESISTANCE += d else { this.RESISTANCE = d ; this.MASK |= PM_RESISTANCE } }
	effSCIENCE(base) { return base.SCIENCE + ((this.MASK & PM_SCIENCE) ? this.SCIENCE : 0) }
	addSCIENCE(d) { if (this.MASK & PM_SCIENCE) this.SCIENCE += d else { this.SCIENCE = d ; this.MASK |= PM_SCIENCE } }
	effMAGIC(base) { return base.MAGIC + ((this.MASK & PM_MAGIC) ? this.MAGIC : 0) }
	addMAGIC(d) { if (this.MASK & PM_MAGIC) this.MAGIC += d else { this.MAGIC = d ; this.MASK |= PM_MAGIC } }
	effMP(base) { return base.MP + ((this.MASK & PM_MP) ? this.MP : 0) }
	addMP(d) { if (this.MASK & PM_MP) this.MP += d else { this.MP = d ; this.MASK |= PM_MP } }
	effTOTAL_MP(base) { return base.TOTAL_MP + ((this.MASK & PM_TOTAL_MP) ? this.TOTAL_MP : 0) }
	addTOTAL_MP(d) { if (this.MASK & PM_TOTAL_MP) this.TOTAL_MP += d else { this.TOTAL_MP = d ; this.MASK |= PM_TOTAL_MP } }
	effTP(base) { return base.TP + ((this.MASK & PM_TP) ? this.TP : 0) }
	addTP(d) { if (this.MASK & PM_TP) this.TP += d else { this.TP = d ; this.MASK |= PM_TP } }
	effTOTAL_TP(base) { return base.TOTAL_TP + ((this.MASK & PM_TOTAL_TP) ? this.TOTAL_TP : 0) }
	addTOTAL_TP(d) { if (this.MASK & PM_TOTAL_TP) this.TOTAL_TP += d else { this.TOTAL_TP = d ; this.MASK |= PM_TOTAL_TP } }
	effABSOLUTE_SHIELD(base) { return base.ABSOLUTE_SHIELD + ((this.MASK & PM_ABSOLUTE_SHIELD) ? this.ABSOLUTE_SHIELD : 0) }
	addABSOLUTE_SHIELD(d) { if (this.MASK & PM_ABSOLUTE_SHIELD) this.ABSOLUTE_SHIELD += d else { this.ABSOLUTE_SHIELD = d ; this.MASK |= PM_ABSOLUTE_SHIELD } }
	effRELATIVE_SHIELD(base) { return base.RELATIVE_SHIELD + ((this.MASK & PM_RELATIVE_SHIELD) ? this.RELATIVE_SHIELD : 0) }
	addRELATIVE_SHIELD(d) { if (this.MASK & PM_RELATIVE_SHIELD) this.RELATIVE_SHIELD += d else { this.RELATIVE_SHIELD = d ; this.MASK |= PM_RELATIVE_SHIELD } }
	effDAMAGE_RETURN(base) { return base.DAMAGE_RETURN + ((this.MASK & PM_DAMAGE_RETURN) ? this.DAMAGE_RETURN : 0) }
	addDAMAGE_RETURN(d) { if (this.MASK & PM_DAMAGE_RETURN) this.DAMAGE_RETURN += d else { this.DAMAGE_RETURN = d ; this.MASK |= PM_DAMAGE_RETURN } }
	effPOWER(base) { return base.POWER + ((this.MASK & PM_POWER) ? this.POWER : 0) }
	addPOWER(d) { if (this.MASK & PM_POWER) this.POWER += d else { this.POWER = d ; this.MASK |= PM_POWER } }
	effPOISON(base) { return base.POISON + ((this.MASK & PM_POISON) ? this.POISON : 0) }
	addPOISON(d) { if (this.MASK & PM_POISON) this.POISON += d else { this.POISON = d ; this.MASK |= PM_POISON } }
	effPOISON_OVER_TIME(base) { return base.POISON_OVER_TIME + ((this.MASK & PM_POISON_OVER_TIME) ? this.POISON_OVER_TIME : 0) }
	addPOISON_OVER_TIME(d) { if (this.MASK & PM_POISON_OVER_TIME) this.POISON_OVER_TIME += d else { this.POISON_OVER_TIME = d ; this.MASK |= PM_POISON_OVER_TIME } }
	effAFTEREFFECT(base) { return base.AFTEREFFECT + ((this.MASK & PM_AFTEREFFECT) ? this.AFTEREFFECT : 0) }
	addAFTEREFFECT(d) { if (this.MASK & PM_AFTEREFFECT) this.AFTEREFFECT += d else { this.AFTEREFFECT = d ; this.MASK |= PM_AFTEREFFECT } }
	effAFTEREFFECT_OVER_TIME(base) { return base.AFTEREFFECT_OVER_TIME + ((this.MASK & PM_AFTEREFFECT_OVER_TIME) ? this.AFTEREFFECT_OVER_TIME : 0) }
	addAFTEREFFECT_OVER_TIME(d) { if (this.MASK & PM_AFTEREFFECT_OVER_TIME) this.AFTEREFFECT_OVER_TIME += d else { this.AFTEREFFECT_OVER_TIME = d ; this.MASK |= PM_AFTEREFFECT_OVER_TIME } }
	effHEAL(base) { return base.HEAL + ((this.MASK & PM_HEAL) ? this.HEAL : 0) }
	addHEAL(d) { if (this.MASK & PM_HEAL) this.HEAL += d else { this.HEAL = d ; this.MASK |= PM_HEAL } }
	effHEAL_OVER_TIME(base) { return base.HEAL_OVER_TIME + ((this.MASK & PM_HEAL_OVER_TIME) ? this.HEAL_OVER_TIME : 0) }
	addHEAL_OVER_TIME(d) { if (this.MASK & PM_HEAL_OVER_TIME) this.HEAL_OVER_TIME += d else { this.HEAL_OVER_TIME = d ; this.MASK |= PM_HEAL_OVER_TIME } }
	effTURN_ORDER(base) { return base.TURN_ORDER + ((this.MASK & PM_TURN_ORDER) ? this.TURN_ORDER : 0) }
	addTURN_ORDER(d) { if (this.MASK & PM_TURN_ORDER) this.TURN_ORDER += d else { this.TURN_ORDER = d ; this.MASK |= PM_TURN_ORDER } }

	/* EFFECTS effectif : le tableau rebindé du patch, sinon celui du parent. */
	effEFFECTS(base) { return (this.MASK & PM_EFFECTS) ? this.EFFECTS : base.EFFECTS }
	setEFFECTS(arr) { this.EFFECTS = arr ; this.MASK |= PM_EFFECTS }

	/* Arme effective. */
	effWEAPON(base) { return (this.MASK & PM_WEAPON) ? this.WEAPON : base.WEAPON }
	setWEAPON(w) { this.WEAPON = w ; this.MASK |= PM_WEAPON }

	/* Overlays inventaire : [item -> delta]. Le delta effectif est base + somme des deltas. */
	addCooldownDelta(item, d) {
		if (!(this.MASK & PM_COOLDOWNS)) { this.COOLDOWNS = [: ] ; this.MASK |= PM_COOLDOWNS }
		this.COOLDOWNS[item] = ((item in this.COOLDOWNS) ? this.COOLDOWNS[item] : 0) + d
	}
	addUsesDelta(item, d) {
		if (!(this.MASK & PM_USES)) { this.USES = [: ] ; this.MASK |= PM_USES }
		this.USES[item] = ((item in this.USES) ? this.USES[item] : 0) + d
	}
}
