/*
 * Action : un triplet (item, cellule de lancement, cellule cible).
 */

include("../includes.leek")

class ActionClass {
	Item
	From
	To
	// Payload résurrection : l'id du mort choisi pour CETTE évaluation (BFS.resurrectIdOf).
	// null par défaut — les actions GÉOMÉTRIQUES de ACTIONS_SUMMON_CACHE le gardent null,
	// getBaseActions recrée un objet neuf avec l'id (jamais de mutation de l'objet caché).
	RESURRECT_ID
	constructor(itemUsed, fromCell, toCell) {
		this.Item = itemUsed
		this.From = fromCell
		this.To = toCell
	}
}

/* Géométrie partagée, jamais mutée par le BFS. Une seule visée représentative par
 * origine suffit quand les cibles ET leurs distances sont identiques. Les actions
 * locales n'allouent pas de map : elles sont recréées depuis la cellule du nœud. */
class ActionGroupClass extends ActionClass {
	SIGNATURE
	TARGET_HASH
	ORIGINS
	IS_LOCAL
	constructor(item, from, to, signature, targetHash, local = false) {
		super(item, from, to)
		this.SIGNATURE = signature
		this.TARGET_HASH = targetHash
		this.IS_LOCAL = local
		this.ORIGINS = local ? null : [from: to]
	}

	addOrigin(from, to) {
		if (!(from in this.ORIGINS)) this.ORIGINS[from] = to
	}
}

// Possibilité concrète pour UN état : origine choisie, coût et usages courants.
class PlayableActionClass {
	ACTION
	GROUP
	COST
	USES
	constructor(action, group, cost, uses) {
		this.ACTION = action
		this.GROUP = group
		this.COST = cost
		this.USES = uses
	}
}

class ScoredActionClass {
	PLAYABLE
	GAIN
	PRIORITY
	NODE
	SCORE
	DEFERRED
	constructor(playable, gain, priority, node, score) {
		this.PLAYABLE = playable
		this.GAIN = gain
		this.PRIORITY = priority
		this.NODE = node
		this.SCORE = score
		this.DEFERRED = gain <= BFS_DELTA_EPSILON
	}
}

/* Durée de vie : un TOUR d'entité. Les gains
 * mémorisés ordonnent les candidats ; ils ne sont PAS des majorants. Les candidats
 * réutilisés sont toujours simulés depuis leur parent avant d'entrer dans l'arbre. */
class ActionSearchCacheClass {
	ESTIMATES
	DEPENDENCIES
	ROOT_STATE
	SCORING_CONTEXT
	ORDERED_GROUPS
	GROUP_SETS
	KNOWN_GROUP_SETS
	NEW_SCORES = 0
	REUSED_SCORES = 0
	ORDER_HITS = 0
	SET_HITS = 0
	RETAINED_ESTIMATES = 0
	ESTIMATE_VERSION = 0
	constructor() {
		this.ESTIMATES = [:]
		this.DEPENDENCIES = [:]
		this.ORDERED_GROUPS = [:]
		this.GROUP_SETS = [:]
		this.KNOWN_GROUP_SETS = [:]
	}

	// Les nœuds/validations appartiennent à UNE recherche ; seuls les catalogues et
	// indications de gain survivent à un vrai cast. Un buff de Me invalide tous les
	// groupes dépendant du lanceur ; une blessure de cible seulement les groupes concernés.
	beginSearch(State, context) {
		if (this.SCORING_CONTEXT != context) {
			this.ESTIMATES = [:]
			this.DEPENDENCIES = [:]
			this.ESTIMATE_VERSION++
		} else if (this.ROOT_STATE != null) {
			// Toute estimation dépend de Me : si ses inputs ont changé, inutile de
			// comparer les registres de tous les autres porteurs avant de tout vider.
			if (!sameRootInputs(State[Me], this.ROOT_STATE[Me])) {
				this.ESTIMATES = [:]
				this.DEPENDENCIES = [:]
				this.ESTIMATE_VERSION++
			} else {
				var dirty = 0
				for (var id: var stat in State) {
					if (id != Me && !sameRootInputs(stat, this.ROOT_STATE[id])) dirty |= dependencyBit(id)
				}
				if (dirty != 0) {
					var stale = []
					for (var key: var mask in this.DEPENDENCIES) if ((mask & dirty) != 0) push(stale, key)
					for (var key in stale) { mapRemove(this.ESTIMATES, key); mapRemove(this.DEPENDENCIES, key) }
					if (count(stale) > 0) this.ESTIMATE_VERSION++
				}
			}
		}
		this.ROOT_STATE = State // capture immuable, jamais le workspace de simulation
		this.SCORING_CONTEXT = context
		this.RETAINED_ESTIMATES = mapSize(this.ESTIMATES)
		this.ORDERED_GROUPS = [:] // priorités à retrier après les scores racine courants
		this.KNOWN_GROUP_SETS = [:] // présence des estimations établie dans CETTE recherche
		this.NEW_SCORES = 0
		this.REUSED_SCORES = 0
		this.ORDER_HITS = 0
		this.SET_HITS = 0
	}

	// Collisions d'ids modulo 64 : elles invalident TROP, jamais pas assez.
	static dependencyBit(id) { return 1 << (id & 63) }

	static sameRootInputs(stat, before) {
		return before != null && ScoringClass.sameEntityScoreInputs(stat, before)
			&& stat.CELL == before.CELL && sameLedger(stat.EFFECTS, before.EFFECTS)
	}

	static sameLedger(a, b) {
		if (a == b) return true
		if (count(a) != count(b)) return false
		for (var i: var line in a) {
			var other = b[i]
			if (count(line) != count(other)) return false
			for (var j: var value in line) if (value != other[j]) return false
		}
		return true
	}
}

// Par plateau et item : ajouter seulement les origines encore jamais calculées.
class ActionOriginCatalogClass {
	GROUPS
	BY_SIGNATURE
	COVERED_CELLS
	COVERED_DOMAINS
	constructor() {
		this.GROUPS = []
		this.BY_SIGNATURE = [:]
		this.COVERED_CELLS = [:]
		this.COVERED_DOMAINS = [:]
	}
}

class ActionAvailabilityClass {
    CHILDREN // même inventaire parent, puis preuve exacte du patch local
    PATCH_INPUTS // copie de scalaires, jamais les maps mutables
    MASK // publié après lecture complète des coûts
	STOCKS = [:] // usages avant financement PT / équipement
	TP
	WEAPON
	STATES
	COSTS
	USES
	constructor(tp, weapon, states) {
		this.TP = tp
		this.WEAPON = weapon
		this.STATES = states
		this.COSTS = [:]
		this.USES = [:]
	}
}

class ActionOriginChoiceClass {
	FROM
	TO
	EXTRA_TP
	constructor(from, to, extra) {
		this.FROM = from
		this.TO = to
		this.EXTRA_TP = extra
	}
}

// Le tri partage seulement des clés et des priorités, jamais un nœud ou un From.
class ActionPriorityClass {
	KEY
	GAIN
	PRIORITY
	constructor(key, gain, priority) {
		this.KEY = key
		this.GAIN = gain
		this.PRIORITY = priority
	}
}

class ActionSearchFrameClass {
	GROUPS
	FRESH
	PLAYABLES
	COSTS
	USES
	ORDER
	constructor() {
		this.GROUPS = [:]
		this.FRESH = [:]
		this.PLAYABLES = [:]
		this.COSTS = [:]
		this.USES = [:]
	}
}

// Ensemble géométrique immuable pour un plateau, une mobilité et les items disponibles.
// Les origines et coûts concrets restent résolus dans le parent courant.
class ActionGroupSetClass {
	GROUPS
	KEYS
	FINGERPRINT
	constructor(groups) {
		this.GROUPS = groups
		this.KEYS = []
		this.FINGERPRINT = 0
		for (var key: var _group in groups) {
			push(this.KEYS, key)
			this.FINGERPRINT ^= mix64(key)
		}
	}
}
