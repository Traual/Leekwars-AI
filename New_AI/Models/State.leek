/*
 * State : la map [id -> EntityState] du combat, ses hashs, ses tris d'ordre de tour,
 * et les clones de simulation (clone-on-write).
 */

include("../includes.leek")

class StateClass {
	/* Capture l'état réel de toutes les entités depuis le moteur. */
	static Virtualize() {
		BenchOps.Start("StateVirtualize")
		// EVERYONE rafraîchi ici, à CHAQUE replan réel (un seul appel moteur, réutilisé pour
		// construire le State) : après une vraie invocation, le nouveau summon entre dans la
		// liste des ignorés de la LoS statique avant tout nouveau calcul.
		EVERYONE = getAllies() + getEnemies()
		var _final = [: ]
		for (var e in EVERYONE) {
			_final[e] = new EntityStateClass(e)
		}
		BenchOps.Stop("StateVirtualize")
		return _final
	}

	/*
	 * Entités triées par ordre de tour.
	 *
	 * @param State [id -> stats]
	 * @return Array<id>
	 */
	static getSortedEntityByTurnOrder(State) {
		var Hash = getHashedEntities(State)
		if (Hash in ENTITY_SORTED_BY_TURN_ORDER_CACHE) return ENTITY_SORTED_BY_TURN_ORDER_CACHE[Hash]
		var tmp = []
		for (var e: var stat in State) {
			push(tmp, e)
		}
		var _final = arraySort(tmp, function(a, b) {
			return State[a].TURN_ORDER - State[b].TURN_ORDER
		})
		ENTITY_SORTED_BY_TURN_ORDER_CACHE[Hash] = _final
		return _final
	}

	/*
	 * Entités dans l'ordre où elles jouent APRÈS `entity` ce round (rotation du tri,
	 * entity exclue).
	 *
	 * @param State [id -> stats]
	 * @param entity id pivot
	 * @return Array<id>
	 */
	static getEntitiesInTurnOrderAfterEntity(State, entity) {
		var _toPush = []
		var _final = []
		var _turn_order_array = getSortedEntityByTurnOrder(State)
		var _entity_turn_order = State[entity].TURN_ORDER
		for (var e in _turn_order_array) {
			if (State[e].TURN_ORDER < _entity_turn_order) {
				push(_toPush, e)
			} else {
				if (e != entity) push(_final, e)
			}
		}
		for (var e in _toPush) push(_final, e)
		return _final
	}

	/*
	 * Bit-set exact des ids VIVANTS : indépendant de l'ordre, zéro collision, ~3 ops/entité.
	 * Valide tant que les ids < 64 (réels ~<50, bulbes virtuels = SUMMON_ID_BASE + 1..10).
	 * Vivants seulement : le seul TURN_ORDER qui puisse changer sous une même clé est celui
	 * d'un ressuscité (fonction pure de l'ordre initial + du set des vivants), or le revive
	 * flippe justement son bit ici -> même clé <=> même tri.
	 */
	static getHashedEntities(State) {
		var hash_value = 0
		for (var e: var stat in State) {
			if (stat.LIFE > 0) hash_value |= 1 << e
		}
		return hash_value
	}

	/*
	 * BaseHash : hash des positions (id, cellule) des vivants hors Me. Fold XOR composable —
	 * le patch incrémental du nœud utilise la MÊME contribution (source unique).
	 */
	static getBaseHash(State) {
		var hash_value = OFFSET_BASIS
		for (var id: var stat in State) {
			if (id == Me || stat.LIFE <= 0) continue
			hash_value ^= baseContribution(stat, id)
		}
		return hash_value
	}

	/*
	 * Contribution d'une entité au BaseHash (0 si morte). (id + 1) car mix64(0) = 0 :
	 * l'entité 0 sur la cellule 0 contribuerait 0 = la sentinelle "morte".
	 */
	static baseContribution(stat, id) {
		return stat.LIFE > 0 ? mix64(((id + 1) << 32) | stat.CELL) : 0
	}

	/* [cellule -> true] des vivants hors Me (obstacles dynamiques). */
	static getEntityCellsMap(State) {
		var _final = [: ]
		for (var e: var stat in State) {
			if (e != Me && stat.LIFE > 0) _final[stat.CELL] = true
		}
		return _final
	}

	static getMaxUsedID(State) {
		var _final = 0
		for (var e: var EntityState in State) {
			if (e > _final) _final = e
		}
		return _final
	}

	/* Nombre de summons VIVANTS d'un camp — la notion du moteur pour SUMMON_LIMIT
	 * (les bulbes virtuels de la branche sont dans State, donc comptés). */
	static countLivingSummons(State, side) {
		var n = 0
		for (var e: var stat in State) {
			if (stat.LIFE > 0 && stat.IS_SUMMON && stat.SIDE == side) n++
		}
		return n
	}

	/*
	 * LE clone de simulation — source unique. Les containers sont PARTAGÉS par défaut :
	 * personne n'écrit INVENTORY ni BASE_STATS pendant la sim ; EFFECTS est partagé
	 * mais JAMAIS muté en place — toute modification (remplacement, mort du caster, revive)
	 * REBINDE un tableau neuf sur le clone, le parent garde le sien. COOLDOWNS / USES (les
	 * deux seuls containers écrits en sim, Me only) deviennent des OVERLAYS différentiels :
	 * le clone de Me ne porte que ses écritures locales, les valeurs héritées se résolvent
	 * en remontant ITEM_STATE_PARENT (chaîne immuable — cooldownOf/usesOf). Si un jour un
	 * effet mute un container d'une CIBLE en place, le deep-clone se fait ICI (point
	 * unique), jamais au site de l'effet.
	 */
	static cloneEntityForSim(stat, isMe) {
		var c = clone(stat, 1)                    // scalaires copiés, containers partagés
		if (isMe) {
			c.ITEM_STATE_PARENT = stat
			c.COOLDOWNS = [: ]
			c.USES = [: ]
		}
		// CAP_MEMO / TLSQ_MEMO : COPIÉS par clone(stat, 1) puis VALIDÉS après l'action
		// (diffMaskOf dans la boucle de masque du Node) — plus d'invalidation au clonage.
		return c
	}

	// ============================================================================
	// Inventaire différentiel — SOURCES UNIQUES de lecture/écriture de COOLDOWNS/USES.
	// Racine (état réel, virtuel ou non-Me) : ITEM_STATE_PARENT = null, maps complètes.
	// Clone simulé de Me : maps = patches locaux, héritage via la chaîne.
	// Personne ne lit stat.COOLDOWNS[item] / stat.USES[item] en dehors d'ici et des
	// constructeurs ; les setters n'écrivent JAMAIS un parent.
	// ============================================================================

	/* Cooldown effectif : premier patch de la chaîne contenant l'item, sinon la racine.
	 * null = item non équipé (absent de la map complète de la racine). */
	static cooldownOf(stat, item) {
		var s = stat
		while (s != null) {
			if (item in s.COOLDOWNS) return s.COOLDOWNS[item]
			s = s.ITEM_STATE_PARENT
		}
		return null
	}

	/* Uses effectifs, même résolution ; 0 si l'item est absent de toute la chaîne. */
	static usesOf(stat, item) {
		var s = stat
		while (s != null) {
			if (item in s.USES) return s.USES[item]
			s = s.ITEM_STATE_PARENT
		}
		return 0
	}

	/* L'entité a-t-elle cet item équipé ? (la racine porte tout l'inventaire) */
	static hasInventoryItem(stat, item) {
		return cooldownOf(stat, item) != null
	}

	static setCooldown(stat, item, value) {
		stat.COOLDOWNS[item] = value
	}

	static setUses(stat, item, value) {
		stat.USES[item] = value
	}

	static incrementUses(stat, item) {
		stat.USES[item] = usesOf(stat, item) + 1
	}

	/*
	 * Masque différentiel d'une entité clonée, APRÈS l'action — SOURCE UNIQUE de la
	 * comparaison parent/clone (absorbe l'ancien validateDerivedMemos : les mémos dérivés
	 * sont invalidés ICI, sur les mêmes champs, jamais comparés deux fois).
	 *   DIFF_BASE       : la contribution BaseHash peut réellement changer — vivant<->mort,
	 *                     ou deux vivants et cellule différente (deux morts : jamais).
	 *   DIFF_CONTEXT    : un input EFFECTIF de contextContribution a changé — vivant/mort,
	 *                     cellule, classe critique (deux seuils d'AGI), STR/MAG/MP/TP
	 *                     clampés à 0, POWER. LIFE restant vivante, AGI sans franchir de
	 *                     seuil ou STR négative des deux côtés : inchangé.
	 *   DIFF_HFP        : un input EFFECTIF de healerContribution a changé — vivant/mort,
	 *                     cellule, max(0, WIS+100), TP/MP totaux, classe critique (la
	 *                     qualification de healer est immuable pour le replan).
	 *   DIFF_LOCAL_TERM : un input LOCAL du terme de scoring a bougé — LIFE, TOTAL_LIFE
	 *                     (plafond de soin Delta), CELL, DAMAGE_RETURN, six flux
	 *                     périodiques, cooldown effectif d'Antidote, et tout input de
	 *                     capability (même effet que l'ancienne invalidation de CAP_MEMO).
	 * Mémos : TLSQ_MEMO <- TOTAL_LIFE seule ; CAP_MEMO <- les dix inputs de capability
	 * (STR/MAG/WIS/SCI/AGI/RES/TOTAL_TP/TOTAL_MP/ABS/REL). Un mémo déjà null reste null.
	 * isMe : Me est cloné à CHAQUE nœud mais exclu des trois hashs (Node le saute juste
	 * après) -> la fonction rend son masque dès la partie locale, sans jamais calculer
	 * BASE/CONTEXT/HFP ni leurs formes effectives. Ses checks supplémentaires (BaseHash
	 * parent/enfant, fingerprint WalkCells) vivent dans Node, après le hash final.
	 * parentStat null (summon né en branche) -> tout dirty, mémos laissés tels quels.
	 */
	static diffMaskOf(parentStat, childStat, isMe) {
		if (parentStat == null) return DIFF_BASE | DIFF_CONTEXT | DIFF_HFP | DIFF_LOCAL_TERM
		var mask = 0
		var cellChanged = parentStat.CELL != childStat.CELL
		var lifeChanged = parentStat.LIFE != childStat.LIFE

		// ---- Partie LOCALE (toutes les entités) ----
		var totalLifeChanged = parentStat.TOTAL_LIFE != childStat.TOTAL_LIFE
		if (totalLifeChanged && childStat.TLSQ_MEMO != null) childStat.TLSQ_MEMO = null

		var capChanged = parentStat.STRENGTH != childStat.STRENGTH
			|| parentStat.MAGIC != childStat.MAGIC
			|| parentStat.WISDOM != childStat.WISDOM
			|| parentStat.SCIENCE != childStat.SCIENCE
			|| parentStat.AGILITY != childStat.AGILITY
			|| parentStat.RESISTANCE != childStat.RESISTANCE
			|| parentStat.TOTAL_TP != childStat.TOTAL_TP
			|| parentStat.TOTAL_MP != childStat.TOTAL_MP
			|| parentStat.ABSOLUTE_SHIELD != childStat.ABSOLUTE_SHIELD
			|| parentStat.RELATIVE_SHIELD != childStat.RELATIVE_SHIELD
		if (capChanged && childStat.CAP_MEMO != null) childStat.CAP_MEMO = null

		// Antidote : SEUL Me peut voir son cooldown bouger en simulation — les setters
		// n'écrivent que sur son patch local, neuf et vide à chaque nœud. Une entrée
		// présente dans ce patch = une écriture de CE nœud ; absente = valeur héritée,
		// donc identique au parent. Un non-Me ne paie aucune remontée de chaîne.
		// INVARIANT : si un futur effet simulé modifie le cooldown d'une CIBLE non-Me,
		// il devra étendre cette détection (sinon le terme de la cible resterait stale).
		var antidoteChanged = false
		if (isMe && (CHIP_ANTIDOTE in childStat.COOLDOWNS)) {
			antidoteChanged = childStat.COOLDOWNS[CHIP_ANTIDOTE] != cooldownOf(parentStat, CHIP_ANTIDOTE)
		}

		if (capChanged || totalLifeChanged || cellChanged || antidoteChanged
			|| lifeChanged
			|| parentStat.DAMAGE_RETURN != childStat.DAMAGE_RETURN
			|| parentStat.POISON != childStat.POISON
			|| parentStat.POISON_OVER_TIME != childStat.POISON_OVER_TIME
			|| parentStat.AFTEREFFECT != childStat.AFTEREFFECT
			|| parentStat.AFTEREFFECT_OVER_TIME != childStat.AFTEREFFECT_OVER_TIME
			|| parentStat.HEAL != childStat.HEAL
			|| parentStat.HEAL_OVER_TIME != childStat.HEAL_OVER_TIME) {
			mask |= DIFF_LOCAL_TERM
		}

		// Me est exclu des trois hashs (Node le saute juste après) : rien d'autre à calculer.
		if (isMe) return mask

		// ---- Contributions (non-Me seulement) ----
		var oldAlive = parentStat.LIFE > 0
		var newAlive = childStat.LIFE > 0
		var aliveChanged = oldAlive != newAlive
		var bothAlive = oldAlive && newAlive

		if (aliveChanged || (bothAlive && cellChanged)) mask |= DIFF_BASE

		// Formes EFFECTIVES, calculées UNE fois et partagées par les deux contributions.
		// Court-circuit exact : les dix inputs de capability contiennent AGI, STR, MAG, WIS,
		// TOTAL_TP et TOTAL_MP — capChanged faux => classes critiques et valeurs clampées
		// forcément identiques, seules la cellule et POWER peuvent encore bouger.
		var contextStatsChanged = false
		var healStatsChanged = false
		if (capChanged) {
			var oldCrit = (parentStat.AGILITY >= MIN_AGILITY_TO_FULLY_CRIT) ? 2 : ((parentStat.AGILITY >= MIN_AGILITY_ENEMY_CRIT) ? 1 : 0)
			var newCrit = (childStat.AGILITY >= MIN_AGILITY_TO_FULLY_CRIT) ? 2 : ((childStat.AGILITY >= MIN_AGILITY_ENEMY_CRIT) ? 1 : 0)
			var critChanged = oldCrit != newCrit
			var effectiveTotalMpChanged = max(0, parentStat.TOTAL_MP) != max(0, childStat.TOTAL_MP)
			var effectiveTotalTpChanged = max(0, parentStat.TOTAL_TP) != max(0, childStat.TOTAL_TP)
			contextStatsChanged = critChanged || effectiveTotalMpChanged || effectiveTotalTpChanged
				|| max(0, parentStat.STRENGTH) != max(0, childStat.STRENGTH)
				|| max(0, parentStat.MAGIC) != max(0, childStat.MAGIC)
			healStatsChanged = critChanged || effectiveTotalTpChanged || effectiveTotalMpChanged
				|| max(0, parentStat.WISDOM + 100) != max(0, childStat.WISDOM + 100)
		}

		if (aliveChanged || (bothAlive && (cellChanged || contextStatsChanged
			|| parentStat.POWER != childStat.POWER
			// LIFE d'un porteur de LIFE_DAMAGE : input NUMÉRIQUE de sa contribution au
			// contexte danger — une variation de LIFE d'un caster SANS LIFE_DAMAGE ne
			// salit toujours pas le contexte (la transition vivant/mort reste couverte
			// par aliveChanged).
			|| (childStat.DANGER_DEPENDS_ON_LIFE && lifeChanged)))) {
			mask |= DIFF_CONTEXT
		}

		if (aliveChanged || (bothAlive && (cellChanged || healStatsChanged))) mask |= DIFF_HFP

		return mask
	}

	/*
	 * Ouvre la simulation d'une action DANS le workspace (map extérieure réutilisée par tous
	 * les candidats d'un même parent, restaurée après chacun) : Me SEUL est cloné d'office —
	 * sa cellule, ses TP/MP, son arme, ses cooldowns et ses uses bougent à chaque action. Les
	 * cibles réellement touchées sont clonées PARESSEUSEMENT par getConsequences (ensureCloned
	 * au premier effet applicable). clonedIds[id] = l'ANCIEN EntityState (référence read-only,
	 * null pour une entité NÉE dans l'action) — il pilote la capture du patch ET la
	 * restauration du workspace.
	 */
	static beginActionOnWorkspace(Workspace, clonedIds) {
		var parentMe = Workspace[Me]
		Workspace[Me] = cloneEntityForSim(parentMe, true)
		clonedIds[Me] = parentMe
	}

	/*
	 * Remet le workspace EXACTEMENT dans l'état du parent, après simulation ET scoring d'un
	 * candidat : chaque entité touchée retrouve sa référence d'avant l'action, chaque entité
	 * née dans l'action disparaît. À appeler sur TOUS les chemins (candidat retenu, rejeté
	 * sous epsilon, gagnant ou perdant du chemin ScoredCache, fallback de collision d'id) —
	 * un seul oubli corromprait tous les candidats suivants du même parent.
	 */
	static restoreWorkspace(Workspace, clonedIds) {
		for (var id: var oldStat in clonedIds) {
			if (oldStat == null) mapRemove(Workspace, id)
			else Workspace[id] = oldStat
		}
	}

	/*
	 * État complet d'un nœud, matérialisé PARESSEUSEMENT et caché : un candidat ne porte que
	 * son patch (STATE_PATCH) et son état parent (STATE_PARENT) ; la map complète n'est
	 * reconstruite que si le nœud est réellement développé. Les morts restent dans le State
	 * (LIFE <= 0), un summon est une simple entrée neuve du patch, et les références
	 * EntityState des patches sont réutilisées telles quelles (aucun reclonage).
	 */
	static materializeNodeState(node) {
		if (node.END_STATS != null) return node.END_STATS
		var _final = clone(materializeNodeState(node.STATE_PARENT), 1)
		for (var id: var stat in node.STATE_PATCH) _final[id] = stat
		node.END_STATS = _final
		return _final
	}

	/*
	 * Clone-on-write pour les effets de bord des kills (cascade de summons, retrait de buffs,
	 * procs d'armes) : ils mutent des entités HORS du set pré-cloné, donc des objets PARTAGÉS
	 * avec l'état parent — les muter en place corromprait toute la recherche. Clone au premier
	 * toucher et enregistre dans clonedIds l'ANCIEN état (référence read-only) — clonedIds
	 * reste ainsi l'ensemble EXACT des entités possiblement mutées (le patch de hashs du
	 * nœud l'itère, le recompute-set du scoring compare contre ses valeurs).
	 */
	static ensureCloned(EveryStats, id, clonedIds) {
		if (!(id in clonedIds)) {
			var parentStat = EveryStats[id]
			EveryStats[id] = cloneEntityForSim(parentStat, id == Me)
			clonedIds[id] = parentStat
		}
		return EveryStats[id]
	}

	/*
	 * Distance moyenne d'une entité à ses alliés vivants (0 si aucun), non pondérée.
	 * Me exclu (je bouge avant la fin du tour). Clé BaseHash + (cellule, id).
	 */
	static getAverageDistFromAllies(entity_side, state, entity_cell, entity_id, base_hash) {
		var ThisHash = addValueToBinHash((OFFSET_BASIS ^ base_hash), (entity_cell << 32) | entity_id)
		if (ThisHash in AVERAGE_DISTANCE_FROM_ALLIES_CACHE) return AVERAGE_DISTANCE_FROM_ALLIES_CACHE[ThisHash]
		var Total = 0
		var Divide = 0
		for (var entity: var thisState in state) {
			if (entity_side == thisState.SIDE) {
				if (entity == entity_id || entity == Me) continue
				if (thisState.LIFE <= 0) continue   // les cadavres ne tirent pas la moyenne (la clé ne pinne que les vivants)
				Total += CellClass.getDist(thisState.CELL, entity_cell)
				Divide++
			}
		}
		var _final = Divide == 0 ? 0 : (Total / Divide)
		AVERAGE_DISTANCE_FROM_ALLIES_CACHE[ThisHash] = _final
		return _final
	}

	/*
	 * Distance moyenne d'une entité à ses ennemis vivants (0 si aucun), non pondérée.
	 * Me exclu. Clé BaseHash + (cellule, id).
	 */
	static getAverageDistFromEnnemies(entity_side, state, entity_cell, entity_id, base_hash) {
		var ThisHash = addValueToBinHash((OFFSET_BASIS ^ base_hash), (entity_cell << 32) | entity_id)
		if (ThisHash in AVERAGE_DISTANCE_FROM_ENNEMIES_CACHE) return AVERAGE_DISTANCE_FROM_ENNEMIES_CACHE[ThisHash]
		var Total = 0
		var Divide = 0
		for (var entity: var thisState in state) {
			if (entity_side != thisState.SIDE) {
				if (entity == Me) continue
				if (thisState.LIFE <= 0) continue   // les cadavres ne tirent pas la moyenne (la clé ne pinne que les vivants)
				Total += CellClass.getDist(thisState.CELL, entity_cell)
				Divide++
			}
		}
		var _final = Divide == 0 ? 0 : (Total / Divide)
		AVERAGE_DISTANCE_FROM_ENNEMIES_CACHE[ThisHash] = _final
		return _final
	}
}
