/*
 * State : la map [id -> EntityState] du combat, ses hashs, ses tris d'ordre de tour,
 * et les clones de simulation (clone-on-write).
 */

include("../includes.leek")

class StateClass {
	/* Capture l'état réel de toutes les entités depuis le moteur. */
	static Virtualize() {
		BenchOps.Start("StateVirtualize")
		// EVERYONE rafraîchi ici, à CHAQUE replan réel (un seul appel moteur, réutilisé pour
		// construire le State) : après une vraie invocation, le nouveau summon entre dans la
		// liste des ignorés de la LoS statique avant tout nouveau calcul.
		EVERYONE = getAllies() + getEnemies()
		var _final = [: ]
		for (var e in EVERYONE) {
			_final[e] = new EntityStateClass(e)
		}
		BenchOps.Stop("StateVirtualize")
		return _final
	}

	/*
	 * Entités triées par ordre de tour.
	 *
	 * @param State [id -> stats]
	 * @return Array<id>
	 */
	static getSortedEntityByTurnOrder(State) {
		var Hash = getHashedEntities(State)
		if (Hash in ENTITY_SORTED_BY_TURN_ORDER_CACHE) return ENTITY_SORTED_BY_TURN_ORDER_CACHE[Hash]
		var tmp = []
		for (var e: var stat in State) {
			push(tmp, e)
		}
		var _final = arraySort(tmp, function(a, b) {
			return State[a].TURN_ORDER - State[b].TURN_ORDER
		})
		ENTITY_SORTED_BY_TURN_ORDER_CACHE[Hash] = _final
		return _final
	}

	/*
	 * Entités dans l'ordre où elles jouent APRÈS `entity` ce round (rotation du tri,
	 * entity exclue).
	 *
	 * @param State [id -> stats]
	 * @param entity id pivot
	 * @return Array<id>
	 */
	static getEntitiesInTurnOrderAfterEntity(State, entity) {
		var _toPush = []
		var _final = []
		var _turn_order_array = getSortedEntityByTurnOrder(State)
		var _entity_turn_order = State[entity].TURN_ORDER
		for (var e in _turn_order_array) {
			if (State[e].TURN_ORDER < _entity_turn_order) {
				push(_toPush, e)
			} else {
				if (e != entity) push(_final, e)
			}
		}
		for (var e in _toPush) push(_final, e)
		return _final
	}

	/*
	 * Bit-set exact des ids VIVANTS : indépendant de l'ordre, zéro collision, ~3 ops/entité.
	 * Valide tant que les ids < 64 (réels ~<50, bulbes virtuels = SUMMON_ID_BASE + 1..10).
	 * Vivants seulement : le seul TURN_ORDER qui puisse changer sous une même clé est celui
	 * d'un ressuscité (fonction pure de l'ordre initial + du set des vivants), or le revive
	 * flippe justement son bit ici -> même clé <=> même tri.
	 */
	static getHashedEntities(State) {
		var hash_value = 0
		for (var e: var stat in State) {
			if (stat.LIFE > 0) hash_value |= 1 << e
		}
		return hash_value
	}

	/*
	 * BaseHash : hash des positions (id, cellule) des vivants hors Me. Fold XOR composable —
	 * le patch incrémental du nœud utilise la MÊME contribution (source unique).
	 */
	static getBaseHash(State) {
		var hash_value = OFFSET_BASIS
		for (var id: var stat in State) {
			if (id == Me || stat.LIFE <= 0) continue
			hash_value ^= baseContribution(stat, id)
		}
		return hash_value
	}

	/*
	 * Contribution d'une entité au BaseHash (0 si morte). (id + 1) car mix64(0) = 0 :
	 * l'entité 0 sur la cellule 0 contribuerait 0 = la sentinelle "morte".
	 */
	static baseContribution(stat, id) {
		return baseContributionFrom(id, stat.LIFE, stat.CELL)
	}

	/* Même contribution à partir des VALEURS — permet de reconstruire celle du parent sans
	 * ancien EntityState. SOURCE UNIQUE du packing : baseContribution délègue ici. */
	static baseContributionFrom(id, life, cell) {
		return life > 0 ? mix64(((id + 1) << 32) | cell) : 0
	}

	/* [cellule -> true] des vivants hors Me (obstacles dynamiques). */
	static getEntityCellsMap(State) {
		var _final = [: ]
		for (var e: var stat in State) {
			if (e != Me && stat.LIFE > 0) _final[stat.CELL] = true
		}
		return _final
	}

	static getMaxUsedID(State) {
		var _final = 0
		for (var e: var EntityState in State) {
			if (e > _final) _final = e
		}
		return _final
	}

	/* Nombre de summons VIVANTS d'un camp — la notion du moteur pour SUMMON_LIMIT
	 * (les bulbes virtuels de la branche sont dans State, donc comptés). */
	static countLivingSummons(State, side) {
		var n = 0
		for (var e: var stat in State) {
			if (stat.LIFE > 0 && stat.IS_SUMMON && stat.SIDE == side) n++
		}
		return n
	}

	// ============================================================================
	// SIMULATION TRANSACTIONNELLE — les EntityState du State parent sont mutés
	// TEMPORAIREMENT, chaque champ écrit journalise son ancienne valeur, puis tout est
	// restauré. Aucun clone d'entité sur le chemin candidat.
	//
	// CONTRAT ABSOLU : toute écriture simulée sur une entité PRÉEXISTANTE doit être
	// précédée de touchField(stat, DELTA_X, stat.X) — la barrière capture l'ancienne
	// valeur AVANT la mutation. Une écriture non instrumentée corrompt définitivement
	// l'état parent et toutes les branches sœurs. Les LECTURES restent directes
	// (stat.LIFE, stat.STRENGTH...) : aucun getter n'est introduit.
	// Seules écritures non instrumentées autorisées : constructeurs d'état réel,
	// construction d'un BulbState neuf, et les helpers centraux ci-dessous.
	// ============================================================================

	/*
	 * Barrière d'écriture : journalise l'ancienne valeur du champ la PREMIÈRE fois qu'il est
	 * écrit dans l'action courante — et RIEN d'autre. Aucune contribution de hash n'est
	 * calculée ici : Node les reconstruit après coup, et seulement pour les champs qui ont
	 * réellement changé. Appels suivants sur le même champ : un test de bit.
	 * Entité non suivie (ACTIVE_DELTA null) : no-op — c'est le cas des entités neuves
	 * (summon), dont l'objet complet est déjà porté par le delta.
	 */
	static touchField(stat, field, oldValue) {
		var d = stat.ACTIVE_DELTA
		if (d == null) return;
		var bit = 1 << field
		if (d.TOUCHED_MASK & bit) return;
		d.TOUCHED_MASK |= bit
		push(d.TOUCHED, field)
		push(d.TOUCHED, oldValue)
	}

	/*
	 * Ancienne valeur d'un champ : celle journalisée s'il a été touché, sinon la valeur
	 * courante (le champ n'a pas bougé). Chemin FROID — patch de hashs et de dirty
	 * uniquement, jamais dans les lectures de Consequences ni du scoring.
	 */
	static oldValueOf(d, field, currentValue) {
		if (!(d.TOUCHED_MASK & (1 << field))) return currentValue
		var t = d.TOUCHED
		var n = count(t)
		for (var i = 0; i < n; i += 2) {
			if (t[i] == field) return t[i + 1]
		}
		return currentValue
	}

	/* Valeur courante d'un champ suivi — utilisée par la finalisation, la restauration et la
	 * matérialisation UNIQUEMENT (jamais sur un chemin de lecture chaud). */
	static readField(stat, field) {
		if (field == DELTA_CELL) return stat.CELL
		if (field == DELTA_LIFE) return stat.LIFE
		if (field == DELTA_TOTAL_LIFE) return stat.TOTAL_LIFE
		if (field == DELTA_STRENGTH) return stat.STRENGTH
		if (field == DELTA_WISDOM) return stat.WISDOM
		if (field == DELTA_AGILITY) return stat.AGILITY
		if (field == DELTA_RESISTANCE) return stat.RESISTANCE
		if (field == DELTA_SCIENCE) return stat.SCIENCE
		if (field == DELTA_MAGIC) return stat.MAGIC
		if (field == DELTA_MP) return stat.MP
		if (field == DELTA_TOTAL_MP) return stat.TOTAL_MP
		if (field == DELTA_TP) return stat.TP
		if (field == DELTA_TOTAL_TP) return stat.TOTAL_TP
		if (field == DELTA_ABSOLUTE_SHIELD) return stat.ABSOLUTE_SHIELD
		if (field == DELTA_RELATIVE_SHIELD) return stat.RELATIVE_SHIELD
		if (field == DELTA_DAMAGE_RETURN) return stat.DAMAGE_RETURN
		if (field == DELTA_POWER) return stat.POWER
		if (field == DELTA_WEAPON) return stat.WEAPON
		if (field == DELTA_EFFECTS) return stat.EFFECTS
		if (field == DELTA_POISON) return stat.POISON
		if (field == DELTA_POISON_OVER_TIME) return stat.POISON_OVER_TIME
		if (field == DELTA_AFTEREFFECT) return stat.AFTEREFFECT
		if (field == DELTA_AFTEREFFECT_OVER_TIME) return stat.AFTEREFFECT_OVER_TIME
		if (field == DELTA_HEAL) return stat.HEAL
		if (field == DELTA_HEAL_OVER_TIME) return stat.HEAL_OVER_TIME
		if (field == DELTA_TURN_ORDER) return stat.TURN_ORDER
		if (field == DELTA_COOLDOWNS) return stat.COOLDOWNS
		if (field == DELTA_USES) return stat.USES
		if (field == DELTA_ITEM_STATE_PARENT) return stat.ITEM_STATE_PARENT
		if (field == DELTA_CAP_MEMO) return stat.CAP_MEMO
		return stat.TLSQ_MEMO   // DELTA_TLSQ_MEMO
	}

	/* Écrit un champ suivi — finalisation/restauration/matérialisation UNIQUEMENT. */
	static writeField(stat, field, value) {
		if (field == DELTA_CELL) { stat.CELL = value ; return; }
		if (field == DELTA_LIFE) { stat.LIFE = value ; return; }
		if (field == DELTA_TOTAL_LIFE) { stat.TOTAL_LIFE = value ; return; }
		if (field == DELTA_STRENGTH) { stat.STRENGTH = value ; return; }
		if (field == DELTA_WISDOM) { stat.WISDOM = value ; return; }
		if (field == DELTA_AGILITY) { stat.AGILITY = value ; return; }
		if (field == DELTA_RESISTANCE) { stat.RESISTANCE = value ; return; }
		if (field == DELTA_SCIENCE) { stat.SCIENCE = value ; return; }
		if (field == DELTA_MAGIC) { stat.MAGIC = value ; return; }
		if (field == DELTA_MP) { stat.MP = value ; return; }
		if (field == DELTA_TOTAL_MP) { stat.TOTAL_MP = value ; return; }
		if (field == DELTA_TP) { stat.TP = value ; return; }
		if (field == DELTA_TOTAL_TP) { stat.TOTAL_TP = value ; return; }
		if (field == DELTA_ABSOLUTE_SHIELD) { stat.ABSOLUTE_SHIELD = value ; return; }
		if (field == DELTA_RELATIVE_SHIELD) { stat.RELATIVE_SHIELD = value ; return; }
		if (field == DELTA_DAMAGE_RETURN) { stat.DAMAGE_RETURN = value ; return; }
		if (field == DELTA_POWER) { stat.POWER = value ; return; }
		if (field == DELTA_WEAPON) { stat.WEAPON = value ; return; }
		if (field == DELTA_EFFECTS) { stat.EFFECTS = value ; return; }
		if (field == DELTA_POISON) { stat.POISON = value ; return; }
		if (field == DELTA_POISON_OVER_TIME) { stat.POISON_OVER_TIME = value ; return; }
		if (field == DELTA_AFTEREFFECT) { stat.AFTEREFFECT = value ; return; }
		if (field == DELTA_AFTEREFFECT_OVER_TIME) { stat.AFTEREFFECT_OVER_TIME = value ; return; }
		if (field == DELTA_HEAL) { stat.HEAL = value ; return; }
		if (field == DELTA_HEAL_OVER_TIME) { stat.HEAL_OVER_TIME = value ; return; }
		if (field == DELTA_TURN_ORDER) { stat.TURN_ORDER = value ; return; }
		if (field == DELTA_COOLDOWNS) { stat.COOLDOWNS = value ; return; }
		if (field == DELTA_USES) { stat.USES = value ; return; }
		if (field == DELTA_ITEM_STATE_PARENT) { stat.ITEM_STATE_PARENT = value ; return; }
		if (field == DELTA_CAP_MEMO) { stat.CAP_MEMO = value ; return; }
		stat.TLSQ_MEMO = value   // DELTA_TLSQ_MEMO
	}

	// ============================================================================
	// Inventaire différentiel — SOURCES UNIQUES de lecture/écriture de COOLDOWNS/USES.
	// Racine (état réel, virtuel ou non-Me) : ITEM_STATE_PARENT = null, maps complètes.
	// Clone simulé de Me : maps = patches locaux, héritage via la chaîne.
	// Personne ne lit stat.COOLDOWNS[item] / stat.USES[item] en dehors d'ici et des
	// constructeurs ; les setters n'écrivent JAMAIS un parent.
	// ============================================================================

	/* Cooldown effectif : premier patch de la chaîne contenant l'item, sinon la racine.
	 * null = item non équipé (absent de la map complète de la racine). */
	static cooldownOf(stat, item) {
		var s = stat
		while (s != null) {
			if (item in s.COOLDOWNS) return s.COOLDOWNS[item]
			s = s.ITEM_STATE_PARENT
		}
		return null
	}

	/* Uses effectifs, même résolution ; 0 si l'item est absent de toute la chaîne. */
	static usesOf(stat, item) {
		var s = stat
		while (s != null) {
			if (item in s.USES) return s.USES[item]
			s = s.ITEM_STATE_PARENT
		}
		return 0
	}

	/* L'entité a-t-elle cet item équipé ? (la racine porte tout l'inventaire) */
	static hasInventoryItem(stat, item) {
		return cooldownOf(stat, item) != null
	}

	static setCooldown(stat, item, value) {
		stat.COOLDOWNS[item] = value
	}

	static setUses(stat, item, value) {
		stat.USES[item] = value
	}

	static incrementUses(stat, item) {
		stat.USES[item] = usesOf(stat, item) + 1
	}

	/*
	 * Map USES COMPLÈTE d'une entité SANS patch : l'inventaire d'un non-Me n'est jamais
	 * écrit en sim (ITEM_STATE_PARENT reste null), la map du champ est la map moteur.
	 * Réservé aux machineries qui threadent la map entière (combos Danger : clone local
	 * ThisUses/EndUses).
	 */
	static rootUsesMap(stat) {
		return stat.USES
	}

	/*
	 * Ouvre le SUIVI d'une entité : aucun clone, aucun rebind de la map — l'objet du parent
	 * est muté temporairement et son journal enregistre ce qui change. Remplace l'ancien
	 * l'ancien ensureCloned et garde sa signature de retour (l'EntityState sur lequel écrire).
	 * entityDeltas[id] = son EntityDeltaClass.
	 */
	static ensureTracked(EveryStats, id, entityDeltas) {
		var stat = EveryStats[id]
		if (!(id in entityDeltas)) {
			var d = new EntityDeltaClass(id)
			stat.ACTIVE_DELTA = d
			entityDeltas[id] = d
		}
		return stat
	}

	/*
	 * Ouvre la simulation d'une action : Me est suivi d'office (sa cellule, ses TP/MP, son
	 * arme, ses cooldowns et ses uses bougent à chaque action) et reçoit ses overlays
	 * d'inventaire. Les cibles réellement touchées sont suivies PARESSEUSEMENT par
	 * getConsequences (ensureTracked au premier effet applicable).
	 * Overlays : on ne peut pas pointer ITEM_STATE_PARENT vers Me lui-même (ses maps sont
	 * remplacées juste après : ce serait une boucle) — un maillon immuable porte les trois
	 * anciennes références, et cooldownOf/usesOf le traversent sans changer de sémantique.
	 */
	static beginActionOnWorkspace(Workspace, entityDeltas) {
		var meStat = ensureTracked(Workspace, Me, entityDeltas)
		touchField(meStat, DELTA_COOLDOWNS, meStat.COOLDOWNS)
		touchField(meStat, DELTA_USES, meStat.USES)
		touchField(meStat, DELTA_ITEM_STATE_PARENT, meStat.ITEM_STATE_PARENT)
		var link = new ItemStateLinkClass(meStat.COOLDOWNS, meStat.USES, meStat.ITEM_STATE_PARENT)
		meStat.COOLDOWNS = [: ]
		meStat.USES = [: ]
		meStat.ITEM_STATE_PARENT = link
	}

	/*
	 * Rebind d'une ENTRÉE de la map extérieure (summon neuf, ou remplacement complet) —
	 * SOURCE UNIQUE, enregistrée comme telle : naissance -> retrait à la restauration,
	 * remplacement -> ancienne référence remise. Un objet complet n'a pas de journal champ
	 * par champ (il n'a pas de parent sur lequel appliquer un patch).
	 */
	static replaceEntityInWorkspace(Workspace, id, newEntity, entityDeltas) {
		var d = null
		if (id in entityDeltas) {
			d = entityDeltas[id]
		} else {
			d = new EntityDeltaClass(id)
			entityDeltas[id] = d
		}
		// Une entité déjà SUIVIE puis remplacée garde son journal : la restauration remettra
		// d'abord ses champs, puis sa référence (elle a pu être mutée avant le remplacement).
		if (!d.IS_NEW && !d.IS_REPLACEMENT) {
			if (id in Workspace) {
				d.IS_REPLACEMENT = true
				d.OLD_ENTITY = Workspace[id]
			} else {
				d.IS_NEW = true
			}
		}
		d.NEW_ENTITY = newEntity
		Workspace[id] = newEntity
	}

	/*
	 * Fin de l'action, AVANT le scoring : ne retient que les champs RÉELLEMENT différents,
	 * en valeurs ABSOLUES finales. Un champ touché puis revenu à sa valeur d'origine
	 * disparaît du patch. Ne parcourt que les paires de TOUCHED, jamais les 31 champs.
	 */
	static finalizeDeltas(Workspace, entityDeltas) {
		for (var id: var d in entityDeltas) {
			if (d.IS_NEW || d.IS_REPLACEMENT) continue   // objet complet : rien à comparer
			var stat = Workspace[id]
			var t = d.TOUCHED
			var n = count(t)
			for (var i = 0; i < n; i += 2) {
				var field = t[i]
				// Les mémos ne sont pas des données sémantiques : ils sont restaurés sur le
				// parent et recalculés sur l'enfant matérialisé — jamais dans CHANGED.
				if (field == DELTA_CAP_MEMO || field == DELTA_TLSQ_MEMO) continue
				var newValue = readField(stat, field)
				if (newValue == t[i + 1]) continue
				d.CHANGED_MASK |= 1 << field
				push(d.CHANGED, field)
				push(d.CHANGED, newValue)
			}
			// Mémos dérivés : le scoring qui suit va les RECALCULER sur les valeurs
			// temporaires et les écrire dans l'objet PARENT. On journalise donc l'ancien
			// avant de l'invalider — sans quoi la restauration rendrait au parent un mémo
			// calculé sur l'état de l'enfant. (Deuxième passe : touchField pousse dans
			// TOUCHED, dont la longueur d'origine a déjà été parcourue.)
			if (d.CHANGED_MASK & DELTA_MASK_CAPABILITY) {
				touchField(stat, DELTA_CAP_MEMO, stat.CAP_MEMO)
				stat.CAP_MEMO = null
			}
			if (d.CHANGED_MASK & (1 << DELTA_TOTAL_LIFE)) {
				touchField(stat, DELTA_TLSQ_MEMO, stat.TLSQ_MEMO)
				stat.TLSQ_MEMO = null
			}
		}
	}

	/*
	 * Remet le State parent EXACTEMENT dans son état d'avant le candidat, après simulation ET
	 * scoring : chaque champ touché retrouve son ancienne valeur, les mémos leur valeur
	 * parente, ACTIVE_DELTA redevient null, une naissance est retirée de la map et un
	 * remplacement retrouve sa référence. À appeler sur TOUS les chemins — un seul oubli
	 * corromprait le parent et toutes les branches suivantes.
	 */
	static restoreWorkspace(Workspace, entityDeltas) {
		for (var id: var d in entityDeltas) {
			if (d.IS_NEW) {
				mapRemove(Workspace, id)
				releaseJournal(d)
				continue
			}
			if (d.IS_REPLACEMENT) {
				// L'ancienne entité a pu être mutée AVANT d'être remplacée : ses champs
				// touchés sont restaurés avant que sa référence ne reprenne sa place.
				var old = d.OLD_ENTITY
				restoreTouched(old, d)
				old.ACTIVE_DELTA = null
				Workspace[id] = old
				d.OLD_ENTITY = null   // le nœud ne retient plus aucune entité PARENT
				releaseJournal(d)
				continue
			}
			var stat = Workspace[id]
			restoreTouched(stat, d)
			stat.ACTIVE_DELTA = null
			releaseJournal(d)
		}
	}

	/* Réécrit les anciennes valeurs journalisées (paires plates). */
	static restoreTouched(stat, d) {
		var t = d.TOUCHED
		var n = count(t)
		for (var i = 0; i < n; i += 2) writeField(stat, t[i], t[i + 1])
	}

	/*
	 * Le parent est restauré : le journal d'ANNULATION n'a plus de raison d'être. Le nœud ne
	 * garde que CHANGED (et l'objet complet d'une naissance/d'un remplacement) — plus aucune
	 * ancienne valeur ni référence vers une entité parent ne survit dans l'arbre.
	 */
	static releaseJournal(d) {
		d.TOUCHED = []
		d.TOUCHED_MASK = 0
	}

	/*
	 * État complet d'un nœud, matérialisé PARESSEUSEMENT et caché : un candidat ne porte que
	 * ses patches scalaires (STATE_PATCH) et son état parent (STATE_PARENT). Seules les
	 * entités modifiées par CE nœud sont clonées, puis reçoivent leurs overrides ABSOLUS ;
	 * tout le reste est partagé avec le parent. Les morts restent dans le State (LIFE <= 0),
	 * une entité née ou remplacée est insérée telle quelle.
	 */
	static materializeNodeState(node) {
		if (node.END_STATS != null) return node.END_STATS
		var _final = clone(materializeNodeState(node.STATE_PARENT), 1)
		for (var id: var d in node.STATE_PATCH) {
			if (d.NEW_ENTITY != null) {
				_final[id] = d.NEW_ENTITY   // naissance ou remplacement : objet complet
				continue
			}
			// Touchée puis revenue à l'identique : rien à appliquer, l'entité reste PARTAGÉE
			// avec le parent (aucun clone à payer).
			if (d.CHANGED_MASK == 0) continue
			var c = clone(_final[id], 1)    // scalaires copiés, containers partagés
			var ch = d.CHANGED
			var n = count(ch)
			for (var i = 0; i < n; i += 2) writeField(c, ch[i], ch[i + 1])
			// Mémos dérivés : invalidés si un de leurs inputs a changé, recalculés à la
			// demande sur l'enfant (jamais transportés depuis la simulation).
			if (d.CHANGED_MASK & DELTA_MASK_CAPABILITY) c.CAP_MEMO = null
			if (d.CHANGED_MASK & (1 << DELTA_TOTAL_LIFE)) c.TLSQ_MEMO = null
			c.ACTIVE_DELTA = null
			_final[id] = c
		}
		node.END_STATS = _final
		return _final
	}

	/*
	 * Distance moyenne d'une entité à ses alliés vivants (0 si aucun), non pondérée.
	 * Me exclu (je bouge avant la fin du tour). Clé BaseHash + (cellule, id).
	 */
	static getAverageDistFromAllies(entity_side, state, entity_cell, entity_id, base_hash) {
		var ThisHash = addValueToBinHash((OFFSET_BASIS ^ base_hash), (entity_cell << 32) | entity_id)
		if (ThisHash in AVERAGE_DISTANCE_FROM_ALLIES_CACHE) return AVERAGE_DISTANCE_FROM_ALLIES_CACHE[ThisHash]
		var Total = 0
		var Divide = 0
		for (var entity: var thisState in state) {
			if (entity_side == thisState.SIDE) {
				if (entity == entity_id || entity == Me) continue
				if (thisState.LIFE <= 0) continue   // les cadavres ne tirent pas la moyenne (la clé ne pinne que les vivants)
				Total += CellClass.getDist(thisState.CELL, entity_cell)
				Divide++
			}
		}
		var _final = Divide == 0 ? 0 : (Total / Divide)
		AVERAGE_DISTANCE_FROM_ALLIES_CACHE[ThisHash] = _final
		return _final
	}

	/*
	 * Distance moyenne d'une entité à ses ennemis vivants (0 si aucun), non pondérée.
	 * Me exclu. Clé BaseHash + (cellule, id).
	 */
	static getAverageDistFromEnnemies(entity_side, state, entity_cell, entity_id, base_hash) {
		var ThisHash = addValueToBinHash((OFFSET_BASIS ^ base_hash), (entity_cell << 32) | entity_id)
		if (ThisHash in AVERAGE_DISTANCE_FROM_ENNEMIES_CACHE) return AVERAGE_DISTANCE_FROM_ENNEMIES_CACHE[ThisHash]
		var Total = 0
		var Divide = 0
		for (var entity: var thisState in state) {
			if (entity_side != thisState.SIDE) {
				if (entity == Me) continue
				if (thisState.LIFE <= 0) continue   // les cadavres ne tirent pas la moyenne (la clé ne pinne que les vivants)
				Total += CellClass.getDist(thisState.CELL, entity_cell)
				Divide++
			}
		}
		var _final = Divide == 0 ? 0 : (Total / Divide)
		AVERAGE_DISTANCE_FROM_ENNEMIES_CACHE[ThisHash] = _final
		return _final
	}
}
