/*
 * State : la map [id -> EntityState] du combat, ses hashs, ses tris d'ordre de tour,
 * et les clones de simulation (clone-on-write).
 */

include("../includes.leek")

class StateClass {
	/* Capture l'état réel de toutes les entités depuis le moteur. */
	static Virtualize() {
		BenchOps.Start("StateVirtualize")
		// EVERYONE rafraîchi ici, à CHAQUE replan réel (un seul appel moteur, réutilisé pour
		// construire le State) : après une vraie invocation, le nouveau summon entre dans la
		// liste des ignorés de la LoS statique avant tout nouveau calcul.
		EVERYONE = getAllies() + getEnemies()
		var _final = [: ]
		for (var e in EVERYONE) {
			_final[e] = new EntityStateClass(e)
		}
		BenchOps.Stop("StateVirtualize")
		return _final
	}

	/*
	 * Entités triées par ordre de tour.
	 *
	 * @param State [id -> stats]
	 * @return Array<id>
	 */
	static getSortedEntityByTurnOrder(State) {
		var Hash = getHashedEntities(State)
		if (Hash in ENTITY_SORTED_BY_TURN_ORDER_CACHE) return ENTITY_SORTED_BY_TURN_ORDER_CACHE[Hash]
		var tmp = []
		for (var e: var stat in State) {
			push(tmp, e)
		}
		var _final = arraySort(tmp, function(a, b) {
			return State[a].TURN_ORDER - State[b].TURN_ORDER
		})
		ENTITY_SORTED_BY_TURN_ORDER_CACHE[Hash] = _final
		return _final
	}

	/*
	 * Entités dans l'ordre où elles jouent APRÈS `entity` ce round (rotation du tri,
	 * entity exclue).
	 *
	 * @param State [id -> stats]
	 * @param entity id pivot
	 * @return Array<id>
	 */
	static getEntitiesInTurnOrderAfterEntity(State, entity) {
		var _toPush = []
		var _final = []
		var _turn_order_array = getSortedEntityByTurnOrder(State)
		var _entity_turn_order = State[entity].TURN_ORDER
		for (var e in _turn_order_array) {
			if (State[e].TURN_ORDER < _entity_turn_order) {
				push(_toPush, e)
			} else {
				if (e != entity) push(_final, e)
			}
		}
		for (var e in _toPush) push(_final, e)
		return _final
	}

	/*
	 * Bit-set exact des ids VIVANTS : indépendant de l'ordre, zéro collision, ~3 ops/entité.
	 * Valide tant que les ids < 64 (réels ~<50, bulbes virtuels = SUMMON_ID_BASE + 1..10).
	 * Vivants seulement : le seul TURN_ORDER qui puisse changer sous une même clé est celui
	 * d'un ressuscité (fonction pure de l'ordre initial + du set des vivants), or le revive
	 * flippe justement son bit ici -> même clé <=> même tri.
	 */
	static getHashedEntities(State) {
		var hash_value = 0
		for (var e: var stat in State) {
			if (stat.LIFE > 0) hash_value |= 1 << e
		}
		return hash_value
	}

	/*
	 * BaseHash : hash des positions (id, cellule) des vivants hors Me. Fold XOR composable —
	 * le patch incrémental du nœud utilise la MÊME contribution (source unique).
	 */
	static getBaseHash(State) {
		var hash_value = OFFSET_BASIS
		for (var id: var stat in State) {
			if (id == Me || stat.LIFE <= 0) continue
			hash_value ^= baseContribution(stat, id)
		}
		return hash_value
	}

	/*
	 * Contribution d'une entité au BaseHash (0 si morte). (id + 1) car mix64(0) = 0 :
	 * l'entité 0 sur la cellule 0 contribuerait 0 = la sentinelle "morte".
	 */
	static baseContribution(stat, id) {
		return baseContributionFrom(id, stat.LIFE, stat.CELL)
	}

	/* Même contribution à partir des VALEURS — permet de patcher les hashs depuis
	 * ParentState + ActionPatches sans EntityState enfant. SOURCE UNIQUE du packing. */
	static baseContributionFrom(id, life, cell) {
		return life > 0 ? mix64(((id + 1) << 32) | cell) : 0
	}

	/* [cellule -> true] des vivants hors Me (obstacles dynamiques). */
	static getEntityCellsMap(State) {
		var _final = [: ]
		for (var e: var stat in State) {
			if (e != Me && stat.LIFE > 0) _final[stat.CELL] = true
		}
		return _final
	}

	static getMaxUsedID(State) {
		var _final = 0
		for (var e: var EntityState in State) {
			if (e > _final) _final = e
		}
		return _final
	}

	/* Nombre de summons VIVANTS d'un camp — la notion du moteur pour SUMMON_LIMIT
	 * (les bulbes virtuels de la branche sont dans State, donc comptés). */
	static countLivingSummons(State, side) {
		var n = 0
		for (var e: var stat in State) {
			if (stat.LIFE > 0 && stat.IS_SUMMON && stat.SIDE == side) n++
		}
		return n
	}

	// ============================================================================
	// Inventaire différentiel — SOURCES UNIQUES de lecture/écriture de COOLDOWNS/USES.
	// Racine (état réel, virtuel ou non-Me) : ITEM_STATE_PARENT = null, maps complètes.
	// Clone simulé de Me : maps = patches locaux, héritage via la chaîne.
	// Personne ne lit stat.COOLDOWNS[item] / stat.USES[item] en dehors d'ici et des
	// constructeurs ; les setters n'écrivent JAMAIS un parent.
	// ============================================================================

	/* Cooldown effectif : premier patch de la chaîne contenant l'item, sinon la racine.
	 * null = item non équipé (absent de la map complète de la racine). */
	static cooldownOf(stat, item) {
		var s = stat
		while (s != null) {
			if (item in s.COOLDOWNS) return s.COOLDOWNS[item]
			s = s.ITEM_STATE_PARENT
		}
		return null
	}

	/* Uses effectifs, même résolution ; 0 si l'item est absent de toute la chaîne. */
	static usesOf(stat, item) {
		var s = stat
		while (s != null) {
			if (item in s.USES) return s.USES[item]
			s = s.ITEM_STATE_PARENT
		}
		return 0
	}

	/* L'entité a-t-elle cet item équipé ? (la racine porte tout l'inventaire) */
	static hasInventoryItem(stat, item) {
		return cooldownOf(stat, item) != null
	}

	static setCooldown(stat, item, value) {
		stat.COOLDOWNS[item] = value
	}

	static setUses(stat, item, value) {
		stat.USES[item] = value
	}

	static incrementUses(stat, item) {
		stat.USES[item] = usesOf(stat, item) + 1
	}

	/*
	 * Map USES COMPLÈTE d'une entité SANS patch : l'inventaire d'un non-Me n'est jamais
	 * écrit en sim (ITEM_STATE_PARENT reste null), la map du champ est la map moteur.
	 * Réservé aux machineries qui threadent la map entière (combos Danger : clone local
	 * ThisUses/EndUses).
	 */
	static rootUsesMap(stat) {
		return stat.USES
	}


	/*
	 * État complet d'un nœud, matérialisé FROIDEMENT et caché (source unique) : un candidat
	 * ne porte que ses ActionPatches (STATE_PATCH) et son état parent (STATE_PARENT) ; la map
	 * complète n'est reconstruite qu'au premier miss de cache qui l'exige vraiment ou au
	 * développement du nœud gagnant — puis partagée via END_STATS (jamais deux fois).
	 */
	static materializeNodeState(node) {
		if (node.END_STATS != null) return node.END_STATS
		node.END_STATS = materializeActionState(materializeNodeState(node.STATE_PARENT), node.STATE_PATCH)
		return node.END_STATS
	}

	/*
	 * Distance moyenne d'une entité à ses alliés vivants (0 si aucun), non pondérée.
	 * Me exclu (je bouge avant la fin du tour). Clé BaseHash + (cellule, id).
	 */
	static getAverageDistFromAllies(entity_side, state, entity_cell, entity_id, base_hash) {
		var ThisHash = addValueToBinHash((OFFSET_BASIS ^ base_hash), (entity_cell << 32) | entity_id)
		if (ThisHash in AVERAGE_DISTANCE_FROM_ALLIES_CACHE) return AVERAGE_DISTANCE_FROM_ALLIES_CACHE[ThisHash]
		var Total = 0
		var Divide = 0
		for (var entity: var thisState in state) {
			if (entity_side == thisState.SIDE) {
				if (entity == entity_id || entity == Me) continue
				if (thisState.LIFE <= 0) continue   // les cadavres ne tirent pas la moyenne (la clé ne pinne que les vivants)
				Total += CellClass.getDist(thisState.CELL, entity_cell)
				Divide++
			}
		}
		var _final = Divide == 0 ? 0 : (Total / Divide)
		AVERAGE_DISTANCE_FROM_ALLIES_CACHE[ThisHash] = _final
		return _final
	}

	/*
	 * Distance moyenne d'une entité à ses ennemis vivants (0 si aucun), non pondérée.
	 * Me exclu. Clé BaseHash + (cellule, id).
	 */
	static getAverageDistFromEnnemies(entity_side, state, entity_cell, entity_id, base_hash) {
		var ThisHash = addValueToBinHash((OFFSET_BASIS ^ base_hash), (entity_cell << 32) | entity_id)
		if (ThisHash in AVERAGE_DISTANCE_FROM_ENNEMIES_CACHE) return AVERAGE_DISTANCE_FROM_ENNEMIES_CACHE[ThisHash]
		var Total = 0
		var Divide = 0
		for (var entity: var thisState in state) {
			if (entity_side != thisState.SIDE) {
				if (entity == Me) continue
				if (thisState.LIFE <= 0) continue   // les cadavres ne tirent pas la moyenne (la clé ne pinne que les vivants)
				Total += CellClass.getDist(thisState.CELL, entity_cell)
				Divide++
			}
		}
		var _final = Divide == 0 ? 0 : (Total / Divide)
		AVERAGE_DISTANCE_FROM_ENNEMIES_CACHE[ThisHash] = _final
		return _final
	}

	// ============================================================================
	// PureDelta (P1) : le ParentState est STRICTEMENT immuable. Consequences accumule des
	// patches fonctionnels ; le CandidateState n'est matérialisé qu'une fois, pour le
	// scoring de compatibilité (supprimé en P2).
	// ============================================================================

	/* Récupère (ou crée) le patch d'une entité pour ce candidat — UNE fois par entité. */
	static ensureEntityPatch(ActionPatches, id) {
		if (id in ActionPatches) return ActionPatches[id]
		var p = new EntityActionPatchClass(id)
		ActionPatches[id] = p
		return p
	}

	/*
	 * Base EFFECTIVE d'une entité pour la simulation : l'entité de remplacement si une
	 * collision d'id l'a posée, le summon né dans l'action sinon, sinon l'EntityState
	 * IMMUABLE du ParentState. Tous les scans de Consequences passent par cette vue.
	 */
	static patchedBaseOf(ParentState, ActionPatches, id) {
		if (id in ActionPatches) {
			var p = ActionPatches[id]
			if (p.REPLACEMENT_ENTITY != null) return p.REPLACEMENT_ENTITY
			if (p.NEW_ENTITY != null) return p.NEW_ENTITY
		}
		return ParentState[id]
	}

	/*
	 * Matérialisation de compatibilité P1 : reconstruit l'état candidat COMPLET depuis
	 * ParentState + ActionPatches, strictement équivalent à l'ancien résultat mutatif de
	 * Consequences. Les entités non patchées restent PARTAGÉES ; une entité patchée est un
	 * clone superficiel + application des deltas (ils représentent déjà le résultat final
	 * du cast — l'ordre d'application est sans incidence) ; les overlays COOLDOWNS/USES
	 * reproduisent le contrat du système #1 (maps ABSOLUES locales + chaîne
	 * ITEM_STATE_PARENT). Ne modifie JAMAIS ParentState ni ses entités.
	 */
	static materializeActionState(ParentState, ActionPatches) {
		var _final = clone(ParentState, 1)
		for (var id: var p in ActionPatches) {
			var mask = p.MASK
			var isNew = (p.NEW_ENTITY != null)
			var base = (p.REPLACEMENT_ENTITY != null) ? p.REPLACEMENT_ENTITY : (isNew ? p.NEW_ENTITY : ParentState[id])
			if (mask == 0 && !isNew && p.REPLACEMENT_ENTITY == null) continue   // patch vide : l'entité reste partagée (zéro changement de valeur)
			var c = clone(base, 1)
			if (mask & PM_CELL) c.CELL += p.CELL
			if (mask & PM_LIFE) c.LIFE += p.LIFE
			if (mask & PM_TOTAL_LIFE) c.TOTAL_LIFE += p.TOTAL_LIFE
			if (mask & PM_STRENGTH) c.STRENGTH += p.STRENGTH
			if (mask & PM_WISDOM) c.WISDOM += p.WISDOM
			if (mask & PM_AGILITY) c.AGILITY += p.AGILITY
			if (mask & PM_RESISTANCE) c.RESISTANCE += p.RESISTANCE
			if (mask & PM_SCIENCE) c.SCIENCE += p.SCIENCE
			if (mask & PM_MAGIC) c.MAGIC += p.MAGIC
			if (mask & PM_MP) c.MP += p.MP
			if (mask & PM_TOTAL_MP) c.TOTAL_MP += p.TOTAL_MP
			if (mask & PM_TP) c.TP += p.TP
			if (mask & PM_TOTAL_TP) c.TOTAL_TP += p.TOTAL_TP
			if (mask & PM_ABSOLUTE_SHIELD) c.ABSOLUTE_SHIELD += p.ABSOLUTE_SHIELD
			if (mask & PM_RELATIVE_SHIELD) c.RELATIVE_SHIELD += p.RELATIVE_SHIELD
			if (mask & PM_DAMAGE_RETURN) c.DAMAGE_RETURN += p.DAMAGE_RETURN
			if (mask & PM_POWER) c.POWER += p.POWER
			if (mask & PM_POISON) c.POISON += p.POISON
			if (mask & PM_POISON_OVER_TIME) c.POISON_OVER_TIME += p.POISON_OVER_TIME
			if (mask & PM_AFTEREFFECT) c.AFTEREFFECT += p.AFTEREFFECT
			if (mask & PM_AFTEREFFECT_OVER_TIME) c.AFTEREFFECT_OVER_TIME += p.AFTEREFFECT_OVER_TIME
			if (mask & PM_HEAL) c.HEAL += p.HEAL
			if (mask & PM_HEAL_OVER_TIME) c.HEAL_OVER_TIME += p.HEAL_OVER_TIME
			if (mask & PM_TURN_ORDER) c.TURN_ORDER += p.TURN_ORDER
			if (mask & PM_EFFECTS) c.EFFECTS = p.EFFECTS
			if (mask & PM_WEAPON) c.WEAPON = p.WEAPON
			// Mémos dérivés : copiés par clone(base, 1), ils ne restent valides que si leurs
			// inputs n'ont pas été patchés — la matérialisation est LE point d'invalidation
			// (le chemin chaud ne construit jamais d'objet enfant).
			if ((mask & PM_TOTAL_LIFE) && c.TLSQ_MEMO != null) c.TLSQ_MEMO = null
			if ((mask & PM_CAPABILITY) && c.CAP_MEMO != null) c.CAP_MEMO = null
			if (mask & (PM_COOLDOWNS | PM_USES)) {
				// Contrat #1 : le clone porte des overlays LOCAUX à valeurs ABSOLUES, la
				// chaîne remonte à la base pour tout le reste.
				var newCooldowns = [: ]
				if (mask & PM_COOLDOWNS) {
					for (var it: var d in p.COOLDOWNS) newCooldowns[it] = cooldownOf(base, it) + d
				}
				var newUses = [: ]
				if (mask & PM_USES) {
					for (var it: var d in p.USES) newUses[it] = usesOf(base, it) + d
				}
				c.ITEM_STATE_PARENT = base
				c.COOLDOWNS = newCooldowns
				c.USES = newUses
			}
			_final[id] = c
		}
		return _final
	}
}
