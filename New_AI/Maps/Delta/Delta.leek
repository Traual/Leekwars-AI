/**
 * DELTA — combines the danger map and the heal map into the NET damage each entity takes over
 * 1 round, sequenced by TURN ORDER. getStateScore feeds this to its survival formula as `danger`.
 *
 *   getNetDamageMap(State, BaseHash) -> [entityId -> net damage]
 *
 * Per entity, walk casters in turn order on a running `life` starting at LIFE:
 *   - opposing caster      -> life -= DANGER_COEF · danger
 *         NO floor: the danger keeps rolling even past 0 (overkill counts), so the AI still sees a
 *         danger GRADIENT to reduce — it can work toward lowering it across several entity-turns
 *         instead of the value going flat the moment an entity is "doomed".
 *   - same-side caster, ONLY if life > 0  -> life += HEAL_COEF · heal, capped at TOTAL_LIFE
 *         a dead entity isn't healed (cut the heal); overheal is wasted.
 * net = max(0, LIFE − life). Poison/POT stay in the survival formula, untouched.
 *
 * Others take net damage at their current cell (they don't move on my turn). Me searches its
 * reachable cells (minDeltaForMe) for the one MINIMISING the net delta — danger AND heal evaluated
 * at the SAME flee cell (no mismatch), returned directly.
 **/

include("../../includes.leek")

class DeltaClass {

    /* [entityId -> net damage taken over 1 round]. */
    static getNetDamageMap(State, BaseHash, contextBySide) {   // contextBySide is PATCHED on the Node (Phase 2) — no rebuild here
        BenchOps.Start("Delta")

        // Healers fingerprint, folded in one scan (Phase 1 heal fold) so getHealMap doesn't rescan
        // State. The per-side opposing-team context is now PASSED IN (incrementally patched at node
        // creation, Node.leek) instead of rebuilt O(sides*N) here — see buildContextBySide below.
        var mySide = getSide(Me)
        var healFp = 0
        var healCasters = []
        for (var e: var stat in State) {
            if (stat.LIFE <= 0 || e == Me || stat.SIDE != mySide) continue
            if (HealClass.hasHealItem(stat)) {
                healFp ^= addValueToBinHash(OFFSET_BASIS ^ e, (stat.WISDOM << 32) | (stat.TOTAL_TP << 22) | (stat.TOTAL_MP << 12) | stat.CELL)
                push(healCasters, e)
            }
        }

        // getHealMap builds the per-side healers fingerprint (id + cell/mp/wis/tp, XOR-combined,
        // order-independent) while scanning State and publishes it here. The SAME fingerprint keys
        // both HEAL_MAP_CACHE (inside getHealMap) and the per-entity NETDAMAGE_CACHE below -> a
        // buff/shackle/move/death on a healer flips it. Per side so touching MY healer doesn't
        // invalidate the enemies' cache (and vice-versa once enemy heals are added).
        var healMap = HealClass.getHealMapPrecomputed(State, healFp, healCasters)
        var healersFingerprintBySide = HEALERS_FINGERPRINT_BY_SIDE

        var _final = [: ]
        for (var e: var stat in State) {
            if (stat.LIFE <= 0) continue
            var statsHash = addValueToBinHash(contextBySide[stat.SIDE], (stat.ABSOLUTE_SHIELD << 30) | (stat.RELATIVE_SHIELD << 15) | stat.COOLDOWNS[CHIP_ANTIDOTE])

            if (e == Me) {
                // Me MOVES this turn: MIN net delta over my reachable flee cells (danger AND heal at
                // the SAME cell). Two-level cached inside (per-cell net + the whole min by reachable set).
                var hfp = (stat.SIDE in healersFingerprintBySide) ? healersFingerprintBySide[stat.SIDE] : 0
                _final[e] = minDeltaForMe(stat, State, BaseHash, statsHash, hfp, healMap)
                continue
            }

            // Others don't move on my turn -> net damage at their CURRENT cell. Cache it: an entity
            // untouched by my action keeps the same key across BFS nodes -> hit -> skip danger + heal
            // + turn-order build + sequencing.
            var hfp = (stat.SIDE in healersFingerprintBySide) ? healersFingerprintBySide[stat.SIDE] : 0
            var ndKey = addValueToBinHash(statsHash ^ hfp, (stat.CELL << 32) | (stat.LIFE << 16) | stat.TOTAL_LIFE)
            if (ndKey in NETDAMAGE_CACHE) {
                _final[e] = NETDAMAGE_CACHE[ndKey]
                continue
            }

            var dangerToT = DangerClass.getEntityDanger(stat, State, e, BaseHash, statsHash)
            // Casters hit T in the order they act AFTER T this round (X-Y-Z with T=Y -> Z then X).
            var afterOrder = StateClass.getEntitiesInTurnOrderAfterEntity(State, e)
            var nd = netDamage(stat, dangerToT, healMap, State, afterOrder, stat.CELL)
            NETDAMAGE_CACHE[ndKey] = nd
            _final[e] = nd
        }

        BenchOps.Stop("Delta")
        return _final
    }

    /* Min net delta Me takes this turn = MIN over my reachable cells of the net damage AT that cell
     * (danger there sequenced with heal there + turn order). Returned directly — no post-processing.
     * Heal-aware (danger & heal at the SAME flee cell) and gradient-preserving (net is uncapped, so
     * overkill cells stay distinguishable). Not cached yet — caching is the next step. */
    static minDeltaForMe(MeStats, State, BaseHash, statsHash, hfp, healMap) {
        // seed = everything that fixes net(cell) EXCEPT the cell: enemy context + my shields
        // (statsHash), my-side healers (hfp), my current+max life (heal cap + the life<=0 cut). The
        // SAME seed keys BOTH caches — folded with the cell (inner) or my reachable-set hash (outer).
        var seed = addValueToBinHash(statsHash ^ hfp, (MeStats.LIFE << 16) | MeStats.TOTAL_LIFE)
        // seed is loop-invariant below, and addValueToBinHash(seed, x) == rotl13(seed) ^ x. Precompute
        // rotl13(seed) ONCE so the outer key and every per-cell inner key collapse to a single XOR
        // (bit-identical to addValueToBinHash -> same cache keys, same result).
        var rotSeed = (seed << SHIFT) | ((seed >> HIGH_SHIFT) & MASK_HIGH)

        // OUTER: revisiting the exact same Me-state (stats + reachable set) -> whole search skipped.
        var outerKey = rotSeed ^ WalkCellsClass.HashWalkCellsWithItemsWithoutBaseHash(MeStats)
        if (outerKey in ENTITY_DELTA_CACHE_FOR_ME) return ENTITY_DELTA_CACHE_FOR_ME[outerKey]

        var toSkipMap      = DangerClass.EntitiesToSkip(MeStats, State, BaseHash)
        var enemyWalkCells = DangerClass.LoadEnemiesWalkableCellsMap(State, Me, toSkipMap, BaseHash)
        var myWalkCells    = WalkCellsClass.getMaxLayer(State, Me, BaseHash)
        var castersInOrder = StateClass.getEntitiesInTurnOrderAfterEntity(State, Me)

        var minDelta = MAX_VALUE
        for (var cell: var mp in myWalkCells) {
            // INNER: net at this cell. Same seed -> hits even if I moved (overlapping reachable sets).
            var innerKey = rotSeed ^ cell
            var delta = 0
            if (innerKey in CELL_NETDAMAGE_FOR_ME_CACHE) {
                delta = CELL_NETDAMAGE_FOR_ME_CACHE[innerKey]
            } else {
                var dangerAtCell = DangerClass.get(cell, State, MeStats, enemyWalkCells, toSkipMap, statsHash, castersInOrder)
                delta = netDamage(MeStats, dangerAtCell, healMap, State, castersInOrder, cell)
                CELL_NETDAMAGE_FOR_ME_CACHE[innerKey] = delta
            }
            if (delta < minDelta) {
                if (delta == 0) { ENTITY_DELTA_CACHE_FOR_ME[outerKey] = 0; return 0 }   // can't beat 0
                minDelta = delta
            }
        }
        ENTITY_DELTA_CACHE_FOR_ME[outerKey] = minDelta
        return minDelta
    }

    /* Net damage one entity takes over 1 round AT `cell`: danger keeps rolling (overkill counts),
     * heal is applied only while alive AT `cell`, capped at TOTAL_LIFE. */
    static netDamage(stat, dangerToT, healMap, State, turnOrder, cell) {
        var life = stat.LIFE
        var totalLife = stat.TOTAL_LIFE
        for (var caster in turnOrder) {
            if (caster in dangerToT) {
                life -= DANGER_COEF * dangerToT[caster]                 // no floor -> overkill keeps the gradient
            }
            if (life > 0 && State[caster].SIDE == stat.SIDE && caster in healMap && cell in healMap[caster]) {
                life += HEAL_COEF * healMap[caster][cell]               // heal AT `cell` (the flee cell for Me)
                if (life > totalLife) life = totalLife                 // overheal wasted
            }
        }
        return max(0, stat.LIFE - life)
    }

    /* Full rebuild of the per-side opposing-team context (a side's context = every alive non-Me
     * entity NOT on that side). COMPOSABLE XOR-fold via contextContribution -> the incremental Node
     * patch and this MUST share the same contribution formula (single source of truth, else the
     * patched==full self-test would false-mismatch). Used at the BFS root, as the summon/resurrect
     * fallback, and as the Phase-2 self-test reference. */
    static buildContextBySide(State) {
        var sides = [: ]
        for (var e: var stat in State) if (stat.LIFE > 0) sides[stat.SIDE] = true
        var contextBySide = [: ]
        for (var side: var _ in sides) {
            var h = OFFSET_BASIS
            for (var e: var stat in State) {
                if (e == Me || stat.SIDE == side) continue
                h ^= contextContribution(stat, e)   // 0 when dead -> harmless
            }
            contextBySide[side] = h
        }
        return contextBySide
    }

    /* One entity's contribution to an OPPOSING-side context bucket. 0 if dead (so death removes it
     * via XOR). stats CHAINED through mix64 (not XORed with the id/cell term) so two same-stat
     * entities never cancel. */
    static contextContribution(stat, id) {
        if (stat.LIFE <= 0) return 0
        return mix64(mix64((id << 10) | stat.CELL) ^ ((stat.STRENGTH << 48) | (stat.MAGIC << 36) | (stat.TOTAL_MP << 24) | (stat.TOTAL_TP << 12) | stat.POWER))
    }
}
