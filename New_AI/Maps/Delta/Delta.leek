/*
 * Delta : combine la danger map et la heal map en dégâts NETS par entité sur 1 round,
 * séquencés par ordre de tour. C'est le `danger` que consomme la formule de survie.
 *
 * Par entité, on déroule les casters dans l'ordre de jeu sur une vie courante :
 *   - caster adverse   -> life -= DANGER_COEF · danger   (PAS de plancher : l'overkill compte,
 *     le gradient de danger reste visible même sur une entité condamnée)
 *   - caster allié     -> vitalité D'ABORD (monte le cap ET la vie), puis heal ordinaire,
 *     seulement si life > 0 (un mort n'est pas soigné), plafonné au NOUVEAU total — une
 *     vitalité reçue à pleine vie absorbe donc les dégâts suivants ; profil de cible par
 *     TYPE de la cible (summon/poireau — jamais SELF : la rotation exclut la cible), le tout
 *     × HEAL_COEF
 * net = max(0, LIFE − life). Le poison reste dans la formule de survie, pas ici.
 *
 * Les autres encaissent à leur cellule courante (ils ne bougent pas pendant mon tour).
 * Me cherche parmi ses cellules accessibles celle qui MINIMISE le net (danger et heal
 * évalués à la même cellule de fuite).
 */

include("../../includes.leek")

class DeltaClass {

    /*
     * Map des dégâts nets [id -> net] sur 1 round.
     *
     * @param State [id -> stats]
     * @param BaseHash hash (id, cellule) des vivants
     * @param contextBySide [side -> hash de l'équipe adverse], patché sur les nœuds
     * @param hfpBySide [side -> fingerprint des healers], construit par l'appelant
     * @param meWalkFp empreinte de mobilité de Me pour CET état — consommée par le seul
     *        minDeltaForMe, ignorée des autres entités
     * @return [id -> net]
     */
    static getNetDamageMap(State, BaseHash, contextBySide, hfpBySide, meWalkFp) {
        BenchOps.Start("Delta")

        // Fingerprint combiné = fold XOR des fps par side reçus (même source unique
        // healerContribution — le split par side sale NETDAMAGE_CACHE, le fold combiné est
        // la clé de HEAL_MAP_CACHE). Sur un hit de heal map, AUCUN scan des entités ; au
        // miss, getHealMapByFp rescanne l'état pour retrouver les casters.
        var combinedFp = 0
        for (var s: var h in hfpBySide) combinedFp ^= h
        var healMap = HealClass.getHealMapByFp(State, combinedFp)

        var _final = [: ]
        for (var e: var stat in State) {
            if (stat.LIFE <= 0) continue
            _final[e] = netOf(e, stat, State, BaseHash, contextBySide, hfpBySide, healMap, meWalkFp)
        }

        BenchOps.Stop("Delta")
        return _final
    }

    /*
     * Graine des clés de cache danger pour UNE cible : contexte offensif adverse chaîné avec
     * son pack DÉFENSIF (shields courants + antidote). SOURCE UNIQUE pour tous les
     * consommateurs (netOf, FinalCell) — un second chemin de construction fragmenterait ou
     * ferait collisionner les caches. Le type de la cible n'entre PAS ici : il est immuable
     * pour un id, et l'id est déjà porté à part par la clé de cellule.
     */
    static targetDangerSeedOf(stat, offensiveContextHash, antidoteCd) {
        return addValueToBinHash(offensiveContextHash, DangerComboClass.targetDefensePack(stat.ABSOLUTE_SHIELD, stat.RELATIVE_SHIELD, antidoteCd))
    }

    /*
     * Dégâts nets d'UNE entité — le corps par-entité de getNetDamageMap, extrait pour que le
     * scoring incrémental recalcule un seul terme par la même machinerie.
     * Caché : NETDAMAGE_CACHE pour les autres, les deux caches de fuite pour Me.
     */
    static netOf(e, stat, State, BaseHash, contextBySide, healersFingerprintBySide, healMap, meWalkFp) {
        // Contexte offensif et antidote lus UNE fois, puis transportés en scalaires : aucun
        // lecteur profond ne relit contextBySide ni ne recalcule le cooldown.
        var targetSide = stat.SIDE
        var offensiveContextHash = contextBySide[targetSide]
        var antidoteCd = DangerComboClass.antidoteCdOf(stat)
        var targetSeed = targetDangerSeedOf(stat, offensiveContextHash, antidoteCd)
        var hfp = (targetSide in healersFingerprintBySide) ? healersFingerprintBySide[targetSide] : 0

        if (e == Me) {
            // Me BOUGE ce tour : min du net sur mes cellules accessibles.
            return minDeltaForMe(stat, State, BaseHash, offensiveContextHash, targetSeed, antidoteCd, hfp, healMap, meWalkFp)
        }

        // Les autres ne bougent pas -> net à leur cellule courante. Une entité intouchée
        // garde la même clé d'un nœud à l'autre -> hit, tout le déroulé est sauté.
        // Salée par (id, IS_SUMMON) : le PROFIL de couverture heal (poireau/summon) est un
        // input du net depuis la vitalité.
        var ndKey = addValueToBinHash(addValueToBinHash(targetSeed ^ hfp, (stat.CELL << 32) | (stat.LIFE << 16) | stat.TOTAL_LIFE), (e << 1) | (stat.IS_SUMMON ? 1 : 0))
        if (ndKey in NETDAMAGE_CACHE) return NETDAMAGE_CACHE[ndKey]

        var cell = stat.CELL
        var cellDangerKey = DangerClass.cellCacheSeed(targetSeed, e) ^ cell
        var dangerToT
        var plan = null
        if (cellDangerKey in CELL_DANGER_GET_CACHE) {
            // Hit de cellule : ni plan, ni couverture, ni ordre, ni bucket.
            dangerToT = CELL_DANGER_GET_CACHE[cellDangerKey]
        } else {
            BenchOps.Start("Danger")
            plan = DangerPlanClass.getTeamPlan(State, BaseHash, offensiveContextHash, targetSide)
            // Une seule cellule à évaluer pour cette cible : aucun groupement local.
            dangerToT = DangerClass.dangerOfCellCold(cell, cellDangerKey, plan, DangerPlanClass.coverageSequenceFor(plan, e), State, stat, antidoteCd, null)
            BenchOps.Stop("Danger")
        }
        // Danger vide -> net 0 sans dérouler l'ordre de tour ni le séquenceur.
        if (mapIsEmpty(dangerToT)) {
            NETDAMAGE_CACHE[ndKey] = 0
            return 0
        }
        // Les casters frappent dans l'ordre où ils jouent APRÈS la cible ce round : la
        // séquence du plan est construite une fois par cible, puis partagée.
        if (plan == null) plan = DangerPlanClass.getTeamPlan(State, BaseHash, offensiveContextHash, targetSide)
        var nd = netDamage(stat, dangerToT, healMap, State, DangerPlanClass.netSequenceFor(plan, e), DangerPlanClass.netAllySeqFor(plan, e), cell)
        NETDAMAGE_CACHE[ndKey] = nd
        return nd
    }

    /*
     * Net minimal de Me ce tour = min sur mes cellules accessibles du net à cette cellule
     * (danger et heal séquencés au même endroit). Deux niveaux de cache : externe = le min
     * entier par état de Me + set accessible, interne = le net d'une cellule.
     */
    static minDeltaForMe(MeStats, State, BaseHash, offensiveContextHash, targetSeed, antidoteCd, hfp, healMap, meWalkFp) {
        // seed = tout ce qui fixe net(cellule) SAUF la cellule : contexte ennemi + mes shields
        // et mon antidote (targetSeed), mes healers (hfp), ma vie courante et max (cap du heal,
        // coupure à 0), et mon PROFIL de cible heal (id, IS_SUMMON).
        // UN seul chaînage : les champs locaux sont packés dans des slots DISJOINTS, avec les
        // dix bits bas laissés libres pour la cellule. Invariants : cellule <= 612 (bits 0-9),
        // id < 64 (bits 11-16), TOTAL_LIFE et LIFE sur leurs slots de 16 bits (17-32 et 33-48).
        var seed = addValueToBinHash(targetSeed ^ hfp,
            (MeStats.LIFE << 33) | (MeStats.TOTAL_LIFE << 17) | (Me << 11) | (MeStats.IS_SUMMON ? 1024 : 0))

        // Externe : même état de Me sur le même TERRAIN -> recherche entière sautée. BaseHash
        // dans la clé : le DOMAINE du min est mes cellules accessibles, qui dépendent des
        // obstacles (un allié qui apparaît ou bouge le réduit sans toucher seed ni walkHash).
        // meWalkFp est celle du nœud, déjà calculée par Node/BFS. Aucune rotation n'est
        // nécessaire pour séparer les deux niveaux : ce sont deux MAPS distinctes.
        var outerKey = seed ^ addValueToBinHash(BaseHash, meWalkFp)
        if (outerKey in ENTITY_DELTA_CACHE_FOR_ME) return ENTITY_DELTA_CACHE_FOR_ME[outerKey]

        var myWalkCells = WalkCellsClass.getMaxLayer(State, Me, BaseHash)

        // Une cellule qui a rendu 0 pour cette graine le rend TOUJOURS : le net à une cellule
        // ne dépend que de (graine, cellule). Si elle est encore accessible, le minimum est
        // imbattable et aucune cellule n'a besoin d'être balayée. Sinon la recherche reprend
        // normalement — l'indice n'est jamais lu autrement que comme un raccourci exact.
        if (seed in SAFE_CELL_FOR_ME_CACHE && SAFE_CELL_FOR_ME_CACHE[seed] in myWalkCells) {
            ENTITY_DELTA_CACHE_FOR_ME[outerKey] = 0
            return 0
        }

        // Un SEUL parcours des cellules, dans l'ordre historique : chaque cellule est servie par
        // le cache interne ou évaluée sur place. Le minimum est commutatif, l'ordre d'évaluation
        // ne change donc aucune valeur. TOUT reste paresseux — le plan et les buckets ne
        // naissent qu'au premier VRAI miss de CELL_DANGER_GET_CACHE. Le danger est partagé entre
        // couvertures identiques, mais le net et le heal restent PAR CELLULE : même minimum,
        // mêmes additions dans netDamage.
        var minDelta = MAX_VALUE
        var dangerCellSeed = DangerClass.cellCacheSeed(targetSeed, MeStats.ID)
        var mySide = MeStats.SIDE
        var plan = null
        var myNetSeq = null   // séquence restreinte aux casters qui peuvent changer mon net
        var myNetAlly = null  // drapeaux « mon camp » alignés dessus
        var myCovSeq = null   // séquence restreinte aux menaces, pour les couvertures de cellule
        var buckets = null
        for (var cell: var mp in myWalkCells) {
            var innerKey = seed ^ cell
            var delta
            if (innerKey in CELL_NETDAMAGE_FOR_ME_CACHE) {
                delta = CELL_NETDAMAGE_FOR_ME_CACHE[innerKey]
            } else {
                var dangerKey = dangerCellSeed ^ cell
                var dangerAtCell
                if (dangerKey in CELL_DANGER_GET_CACHE) {
                    // Hit : ni plan, ni couverture, ni hash de contenu, ni bucket.
                    dangerAtCell = CELL_DANGER_GET_CACHE[dangerKey]
                } else {
                    if (plan == null) {
                        plan = DangerPlanClass.getTeamPlan(State, BaseHash, offensiveContextHash, mySide)
                        buckets = [: ]   // couvertures rencontrées, locales à cette recherche de fuite
                    }
                    // Le plan a pu naître dans le bloc du net : la séquence de couverture se
                    // résout donc ici, indépendamment de qui a créé le plan.
                    if (myCovSeq == null) myCovSeq = DangerPlanClass.coverageSequenceFor(plan, Me)
                    dangerAtCell = DangerClass.dangerOfCellCold(cell, dangerKey, plan, myCovSeq, State, MeStats, antidoteCd, buckets)
                }
                // Danger vide -> delta 0 direct, sans même l'ordre de tour (déclenche l'early
                // exit "imbattable" dessous).
                delta = 0
                if (!mapIsEmpty(dangerAtCell)) {
                    if (plan == null) plan = DangerPlanClass.getTeamPlan(State, BaseHash, offensiveContextHash, mySide)
                    if (myNetSeq == null) {
                        myNetSeq = DangerPlanClass.netSequenceFor(plan, Me)
                        myNetAlly = DangerPlanClass.netAllySeqFor(plan, Me)
                    }
                    delta = netDamage(MeStats, dangerAtCell, healMap, State, myNetSeq, myNetAlly, cell)
                }
                CELL_NETDAMAGE_FOR_ME_CACHE[innerKey] = delta
            }
            if (delta < minDelta) {
                if (delta == 0) { SAFE_CELL_FOR_ME_CACHE[seed] = cell; ENTITY_DELTA_CACHE_FOR_ME[outerKey] = 0; return 0 }   // imbattable
                minDelta = delta
            }
        }
        ENTITY_DELTA_CACHE_FOR_ME[outerKey] = minDelta
        return minDelta
    }

    /*
     * Net d'une entité sur 1 round À `cell` : le danger continue de rouler (l'overkill
     * compte), le heal ne s'applique que vivante. Vitalité AVANT heal : le cap local monte
     * d'abord (et la vie avec), puis le heal ordinaire est plafonné au NOUVEAU total —
     * une vitalité à pleine vie reste utile contre les dégâts suivants.
     *
     * L'ordre de jeu vient de la séquence du plan (partition sur les TURN_ORDER, cible
     * exclue), construite une seule fois par cible et partagée par toutes les cellules. Elle
     * porte les identifiants des casters, pas leurs index dans l'ordre de tour.
     */
    static netDamage(stat, dangerToT, healMap, State, Seq, AllySeq, cell) {
        // CONTRAT : la map de danger n'est jamais vide ici, les trois appelants le testent
        // avant d'appeler (un danger vide vaut net 0 sans dérouler l'ordre de tour).
        var life = stat.LIFE
        var n = count(Seq)
        // Pas de raccourci "aucun healer" : la heal map n'est jamais vide en pratique (mesuré
        // sur 220 193 appels), et le déroulé général traite ce cas sans écart — un caster
        // absent de la map échoue simplement son test d'appartenance.
        var totalLife = stat.TOTAL_LIFE
        // La séquence exclut la cible -> jamais de self-heal ici, profil par type.
        var allyProfile = stat.IS_SUMMON ? HEAL_PROFILE_ALLY_SUMMON : HEAL_PROFILE_ALLY_LEEK
        for (var k = 0; k < n; k++) {
            var caster = Seq[k]
            if (caster in dangerToT) {
                life -= DANGER_COEF * dangerToT[caster]
            }
            // CONTRAT : un caster du même camp présent dans la séquence de net y est
            // forcément par la clause de soin — il ne peut pas menacer son propre camp, donc
            // sa map offensive est nulle. Or cette clause est mot pour mot la qualification
            // de healerContributionOf, qui décide l'appartenance à la heal map. Un allié de
            // la séquence est donc toujours dans healMap.
            // Le camp est un drapeau du plan, aligné sur la séquence : le déroulé n'a plus à
            // rouvrir l'état pour chaque caster, à chaque cellule et à chaque nœud.
            if (life > 0 && AllySeq[k]) {
                var parts = HealClass.partsAt(healMap[caster], allyProfile, cell)
                if (parts != null) {
                    var projectedVitality = HEAL_COEF * parts[1]
                    totalLife += projectedVitality
                    life += projectedVitality
                    life += HEAL_COEF * parts[0]
                    if (life > totalLife) life = totalLife
                }
            }
        }
        return max(0, stat.LIFE - life)
    }

    /*
     * Reconstruction complète du contexte par side (contexte d'un side = tous les vivants
     * hors Me qui ne sont PAS de ce side). Fold XOR composable via contextContribution :
     * le patch incrémental du nœud DOIT utiliser la même formule de contribution, sinon
     * hashs patchés et reconstruits divergent silencieusement.
     * Utilisé à la racine du BFS et en fallback summon/résurrection.
     */
    static buildContextBySide(State) {
        var sides = [: ]
        for (var e: var stat in State) if (stat.LIFE > 0) sides[stat.SIDE] = true
        var contextBySide = [: ]
        for (var side: var _ in sides) {
            var h = OFFSET_BASIS
            for (var e: var stat in State) {
                if (e == Me || stat.SIDE == side) continue
                h ^= contextContribution(stat, e)   // 0 si morte -> inoffensif
            }
            contextBySide[side] = h
        }
        return contextBySide
    }

    /*
     * Contribution d'une entité au contexte des sides adverses. 0 si morte (sa mort la
     * retire par XOR). Stats CLAMPÉES à 0 dans la clé : le moteur stocke les stats
     * shacklées négatives mais les plancher à l'usage, donc toute valeur négative produit
     * le même danger que 0 — clamper évite l'absorption par extension de signe ET dédoublonne
     * les états équivalents. Le pack de stats est CHAÎNÉ dans mix64 (pas XORé au terme
     * id/cellule) pour que deux entités aux mêmes stats ne s'annulent jamais.
     */
    static contextContribution(stat, id) {
        if (stat.LIFE <= 0) return 0
        // critClass (2 bits, cases 60-61 — libres tant que STRENGTH < 4096) : la seule
        // composante d'AGILITÉ que le danger consomme (les seuils de crit binaires). Sans
        // elle, un buff/shackle d'AGI traversant un seuil en branche servirait du danger stale.
        var critClass = (stat.AGILITY >= MIN_AGILITY_TO_FULLY_CRIT) ? 2 : ((stat.AGILITY >= MIN_AGILITY_ENEMY_CRIT) ? 1 : 0)
        return mix64(mix64((id << 10) | stat.CELL) ^ ((critClass << 60) | (max(0, stat.STRENGTH) << 48) | (max(0, stat.MAGIC) << 36) | (max(0, stat.TOTAL_MP) << 24) | (max(0, stat.TOTAL_TP) << 12) | stat.POWER))
    }
}
