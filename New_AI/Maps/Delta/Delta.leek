/*
 * Delta : combine la danger map et la heal map en dégâts NETS par entité sur 1 round,
 * séquencés par ordre de tour. C'est le `danger` que consomme la formule de survie.
 *
 * Par entité, on déroule les casters dans l'ordre de jeu sur une vie courante :
 *   - caster adverse   -> life -= danger (pondéré par DANGER_COEF à la source)   (PAS de plancher : l'overkill compte,
 *     le gradient de danger reste visible même sur une entité condamnée)
 *   - caster allié     -> vitalité D'ABORD (monte le cap ET la vie), puis heal ordinaire,
 *     seulement si life > 0 (un mort n'est pas soigné), plafonné au NOUVEAU total — une
 *     vitalité reçue à pleine vie absorbe donc les dégâts suivants ; profil de cible par
 *     TYPE de la cible (summon/poireau — jamais SELF : la rotation exclut la cible), le tout
 *     pondéré par HEAL_COEF à la source (HealClass.partsAt)
 * net = max(0, LIFE − life). Le poison reste dans la formule de survie, pas ici.
 *
 * Chacun encaisse à sa cellule courante : personne ne bouge pendant mon tour.
 *
 * Me n'a PAS de net dans l'arbre : son danger dépend d'où il finit le tour, ce que la
 * recherche ne sait pas encore. Sa sécurité est arbitrée après coup par FinalCell, cellule
 * par cellule, via netAtFleeCell.
 */

include("../../includes.leek")

class DeltaClass {

    /*
     * Map des dégâts nets [id -> net] sur 1 round. Me en est ABSENT : son terme de scoring
     * ne consomme plus de danger projeté.
     *
     * @param State [id -> stats]
     * @param BaseHash hash (id, cellule) des vivants
     * @param contextBySide [side -> hash de l'équipe adverse], patché sur les nœuds
     * @param hfpBySide [side -> fingerprint des healers], construit par l'appelant
     * @return [id -> net]
     */
    static getNetDamageMap(State, BaseHash, contextBySide, hfpBySide) {
        BenchOps.Start("Delta")

        // Fingerprint combiné = fold XOR des fps par side reçus (même source unique
        // healerContribution — le split par side sale NETDAMAGE_CACHE, le fold combiné est
        // la clé de HEAL_MAP_CACHE). Sur un hit de heal map, AUCUN scan des entités ; au
        // miss, getHealMapByFp rescanne l'état pour retrouver les casters.
        var combinedFp = 0
        for (var s: var h in hfpBySide) combinedFp ^= h
        var healMap = HealClass.getHealMapByFp(State, combinedFp)

        var _final = [: ]
        for (var e: var stat in State) {
            if (stat.LIFE <= 0 || e == Me) continue
            _final[e] = netOf(e, stat, State, BaseHash, contextBySide, hfpBySide, healMap)
        }

        BenchOps.Stop("Delta")
        return _final
    }

    /*
     * Graine des clés de cache danger pour UNE cible : contexte offensif adverse chaîné avec
     * son pack DÉFENSIF (shields courants + antidote). SOURCE UNIQUE pour tous les
     * consommateurs (netOf, FinalCell) — un second chemin de construction fragmenterait ou
     * ferait collisionner les caches. Le type de la cible n'entre PAS ici : il est immuable
     * pour un id, et l'id est déjà porté à part par la clé de cellule.
     */
    static targetDangerSeedOf(stat, offensiveContextHash, antidoteCd) {
        // L'échéance des boucliers entre dans la graine : deux états aux mêmes boucliers TOTAUX
        // mais dont l'un perd le sien en cours de fenêtre n'ont pas le même déroulé de chaîne.
        // Le digest vaut exactement 0 quand rien n'expire — la graine est alors inchangée.
        // Le masque d'états part avec les boucliers : le pack n'en retient que les deux bits
        // d'immunité, dont dépendent le danger de la cellule et le net.
        return addValueToBinHash(offensiveContextHash ^ stat.SHIELD_EXPIRY_HASH, DangerComboClass.targetDefensePack(stat.ABSOLUTE_SHIELD, stat.RELATIVE_SHIELD, antidoteCd, stat.STATES))
    }

    /*
     * Dégâts nets d'UNE entité — le corps par-entité de getNetDamageMap, extrait pour que le
     * scoring incrémental recalcule un seul terme par la même machinerie. Caché par
     * NETDAMAGE_CACHE.
     * CONTRAT : jamais appelée pour Me — il n'est pas encore posé quand l'arbre le score, et
     * son terme est statique (ScoringClass.termDelta).
     */
    static netOf(e, stat, State, BaseHash, contextBySide, healersFingerprintBySide, healMap) {
        // Contexte offensif et antidote lus UNE fois, puis transportés en scalaires : aucun
        // lecteur profond ne relit contextBySide ni ne recalcule le cooldown.
        var targetSide = stat.SIDE
        var offensiveContextHash = contextBySide[targetSide]
        var antidoteCd = DangerComboClass.antidoteCdOf(stat)
        var targetSeed = targetDangerSeedOf(stat, offensiveContextHash, antidoteCd)
        // Map totale (HealClass.buildHfpBySide) : lecture directe, le 0-défaut y est écrit.
        var hfp = healersFingerprintBySide[targetSide]

        // Personne ne bouge -> net à sa cellule courante. Une entité intouchée
        // garde la même clé d'un nœud à l'autre -> hit, tout le déroulé est sauté.
        // Salée par TYPE_TAG = (id, IS_SUMMON) : le PROFIL de couverture heal (poireau/summon)
        // est un input du net depuis la vitalité. Le tag est posé à la construction et immuable.
        // Les deux pas de chaîne en un : le pack de champs bornés satisfait la précondition
        // d'addTwoValuesToBinHash (cellule <= 612, vie et vie totale sur 16 bits).
        var ndKey = addTwoValuesToBinHash(targetSeed ^ hfp, (stat.CELL << 32) | (stat.LIFE << 16) | stat.TOTAL_LIFE, stat.TYPE_TAG)
        if (ndKey in NETDAMAGE_CACHE) return NETDAMAGE_CACHE[ndKey]

        var cell = stat.CELL
        var cellDangerKey = DangerClass.cellCacheSeed(targetSeed, e) ^ cell
        var dangerToT
        var plan = null
        if (cellDangerKey in CELL_DANGER_GET_CACHE) {
            // Hit de cellule : ni plan, ni couverture, ni ordre, ni bucket.
            dangerToT = CELL_DANGER_GET_CACHE[cellDangerKey]
        } else {
            BenchOps.Start("Danger")
            plan = DangerPlanClass.getTeamPlan(State, BaseHash, offensiveContextHash, targetSide)
            // Une seule cellule à évaluer pour cette cible : aucun groupement local.
            dangerToT = DangerClass.dangerOfCellCold(cell, cellDangerKey, plan, DangerPlanClass.coverageSequenceFor(plan, e), State, stat, antidoteCd, null)
            BenchOps.Stop("Danger")
        }
        // Danger vide -> net 0 sans dérouler l'ordre de tour ni le séquenceur.
        if (mapIsEmpty(dangerToT)) {
            NETDAMAGE_CACHE[ndKey] = 0
            return 0
        }
        // Les casters frappent dans l'ordre où ils jouent APRÈS la cible ce round : la
        // séquence du plan est construite une fois par cible, puis partagée.
        if (plan == null) plan = DangerPlanClass.getTeamPlan(State, BaseHash, offensiveContextHash, targetSide)
        var nd = netDamage(stat, dangerToT, healMap, DangerPlanClass.netSequenceFor(plan, e), cell)
        NETDAMAGE_CACHE[ndKey] = nd
        return nd
    }

    /*
     * Graine du net de Me à une cellule : tout ce qui le fixe SAUF la cellule — contexte
     * ennemi + mes shields et mon antidote (targetSeed), mes soigneurs (hfp), ma vie courante
     * et max (cap du heal, coupure à 0), et mon PROFIL de cible heal (id, IS_SUMMON).
     * UN seul chaînage : les champs locaux sont packés dans des slots DISJOINTS, avec les dix
     * bits bas laissés libres pour la cellule. Invariants : cellule <= 612 (bits 0-9),
     * id < 64 (bits 11-16), TOTAL_LIFE et LIFE sur leurs slots de 16 bits (17-32 et 33-48).
     */
    static fleeSeedOf(MeStats, targetSeed, hfp) {
        return addValueToBinHash(targetSeed ^ hfp,
            (MeStats.LIFE << 33) | (MeStats.TOTAL_LIFE << 17) | (Me << 11) | (MeStats.IS_SUMMON ? 1024 : 0))
    }

    /*
     * Net de Me à UNE cellule où il pourrait finir le tour : servi par le cache interne,
     * sinon évalué à froid. Source unique du danger de placement (FinalCell).
     * `lazy` porte les objets communs à tout le balayage — [plan, buckets, séquence de
     * couverture, séquence de net] — matérialisés au premier vrai besoin.
     */
    static netAtFleeCell(cell, seed, dangerCellSeed, MeStats, State, BaseHash, offensiveContextHash, mySide, antidoteCd, healMap, lazy, wantHealCost) {
        var innerKey = seed ^ cell
        if (innerKey in CELL_NETDAMAGE_FOR_ME_CACHE) return CELL_NETDAMAGE_FOR_ME_CACHE[innerKey]
        var dangerKey = dangerCellSeed ^ cell
        var dangerAtCell
        if (dangerKey in CELL_DANGER_GET_CACHE) {
            // Hit : ni plan, ni couverture, ni hash de contenu, ni bucket.
            dangerAtCell = CELL_DANGER_GET_CACHE[dangerKey]
        } else {
            if (lazy[0] == null) lazy[0] = DangerPlanClass.getTeamPlan(State, BaseHash, offensiveContextHash, mySide)
            // Buckets créés INDÉPENDAMMENT du plan : si le plan naît par le chemin du net, les
            // couvertures suivantes se partageaient sans bucket, donc pas du tout.
            if (lazy[1] == null) lazy[1] = [: ]
            if (lazy[2] == null) lazy[2] = DangerPlanClass.coverageSequenceFor(lazy[0], Me)
            dangerAtCell = DangerClass.dangerOfCellCold(cell, dangerKey, lazy[0], lazy[2], State, MeStats, antidoteCd, lazy[1])
        }
        // Danger vide -> delta 0 direct, sans même dérouler l'ordre de tour.
        var delta = 0
        if (!mapIsEmpty(dangerAtCell)) {
            if (lazy[0] == null) lazy[0] = DangerPlanClass.getTeamPlan(State, BaseHash, offensiveContextHash, mySide)
            if (lazy[3] == null) lazy[3] = DangerPlanClass.netSequenceFor(lazy[0], Me)
            delta = netDamage(MeStats, dangerAtCell, healMap, lazy[3], cell)
        }
        CELL_NETDAMAGE_FOR_ME_CACHE[innerKey] = delta
        // Ce que la cellule coûte en SOIN : les dégâts qui passent mes boucliers, moins ce que
        // j'encaisse réellement — donc ce que la position force mes soigneurs à dépenser. Une
        // cellule où le net est nul parce qu'on m'a soigné n'est pas gratuite pour l'équipe.
        // Planché à zéro : la pénalité de placement doit rester positive pour que la coupure
        // terminale reste exacte. Calculé seulement si un poids le réclame.
        if (wantHealCost) {
            var raw = 0
            for (var d in dangerAtCell) raw += d
            CELL_FLEE_HEALCOST_CACHE[innerKey] = max(0, raw - delta)
        }
        return delta
    }

    /*
     * Net d'une entité sur 1 round À `cell` : le danger continue de rouler (l'overkill
     * compte), le heal ne s'applique que vivante. Vitalité AVANT heal : le cap local monte
     * d'abord (et la vie avec), puis le heal ordinaire est plafonné au NOUVEAU total —
     * une vitalité à pleine vie reste utile contre les dégâts suivants.
     *
     * L'ordre de jeu vient de la séquence du plan (partition sur les TURN_ORDER, cible
     * exclue), construite une seule fois par cible et partagée par toutes les cellules. Elle
     * porte les identifiants des casters, pas leurs index dans l'ordre de tour.
     */
    static netDamage(stat, dangerToT, healMap, Seq, cell) {
        // CONTRAT : la map de danger n'est jamais vide ici, les trois appelants le testent
        // avant d'appeler (un danger vide vaut net 0 sans dérouler l'ordre de tour).
        var life = stat.LIFE
        // Pas de raccourci "aucun healer" : la heal map n'est jamais vide en pratique (mesuré
        // sur 220 193 appels), et le déroulé général traite ce cas sans écart — un caster
        // absent de la map échoue simplement son test d'appartenance.
        var totalLife = stat.TOTAL_LIFE
        // Sous UNHEALABLE le moteur refuse le SOIN instantané mais laisse passer la VITALITÉ :
        // elle n'est pas un soin, ni son effet ni l'ajout de vie qu'il fait n'ont de garde
        // d'état, et le cap comme la vie montent quand même. Lu une fois par déroulé.
        var healable = !EntityStateClass.hasState(stat, STATE_UNHEALABLE)
        // La séquence exclut la cible -> jamais de self-heal ici, profil par type.
        var allyProfile = stat.IS_SUMMON ? HEAL_PROFILE_ALLY_SUMMON : HEAL_PROFILE_ALLY_LEEK
        // Le camp est encodé DANS la séquence : un allié y figure sous -id-1 (DangerPlan). Un
        // allié ne peut pas menacer son propre camp, sa map offensive est donc nulle et il
        // n'est jamais dans la map de danger — le signe tranche seul entre les deux
        // traitements, là où chaque caster payait les DEUX tests à chaque cellule.
        // CONTRAT : la clause qui met un allié dans la séquence est mot pour mot la
        // qualification de healerContributionOf, qui décide l'appartenance à la heal map.
        // Un allié de la séquence est donc toujours dans healMap.
        for (var signed in Seq) {
            if (signed >= 0) {
                if (signed in dangerToT) {
                    // Déjà pondéré par DANGER_COEF à la source (DangerClass.evalChainFromCoverage).
                    life -= dangerToT[signed]
                }
            } else if (life > 0) {
                var parts = HealClass.partsAt(healMap[-signed - 1], allyProfile, cell)
                if (parts != null) {
                    // Valeurs déjà pondérées par HEAL_COEF à la source (HealClass.partsAt), où le
                    // produit est mémoïsé par cellule au lieu d'être refait à chaque caster.
                    var projectedVitality = parts[1]
                    totalLife += projectedVitality
                    life += projectedVitality
                    if (healable) life += parts[0]
                    if (life > totalLife) life = totalLife
                }
            }
        }
        return max(0, stat.LIFE - life)
    }

    /*
     * Reconstruction complète du contexte par side (contexte d'un side = tous les vivants
     * hors Me qui ne sont PAS de ce side). Fold XOR composable via contextContribution :
     * le patch incrémental du nœud DOIT utiliser la même formule de contribution, sinon
     * hashs patchés et reconstruits divergent silencieusement.
     * Utilisé à la racine du BFS et en fallback summon/résurrection.
     */
    static buildContextBySide(State) {
        var sides = [: ]
        for (var e: var stat in State) if (stat.LIFE > 0) sides[stat.SIDE] = true
        var contextBySide = [: ]
        for (var side: var _ in sides) {
            var h = OFFSET_BASIS
            for (var e: var stat in State) {
                if (e == Me || stat.SIDE == side) continue
                h ^= contextContribution(stat, e)   // 0 si morte -> inoffensif
            }
            contextBySide[side] = h
        }
        return contextBySide
    }

    /*
     * Contribution d'une entité au contexte des sides adverses. 0 si morte (sa mort la
     * retire par XOR). Stats CLAMPÉES à 0 dans la clé : le moteur stocke les stats
     * shacklées négatives mais les plancher à l'usage, donc toute valeur négative produit
     * le même danger que 0 — clamper évite l'absorption par extension de signe ET dédoublonne
     * les états équivalents. Le pack de stats est CHAÎNÉ dans mix64 (pas XORé au terme
     * id/cellule) pour que deux entités aux mêmes stats ne s'annulent jamais.
     */
    static contextContribution(stat, id) {
        if (stat.LIFE <= 0) return 0
        // critClass (3 bits, cases 60-62 — libres tant que STRENGTH < 4096) : la seule
        // composante d'AGILITÉ que le danger consomme. Elle porte les seuils de crit ET les
        // mêmes seuils diminués des 100 AGI que Saut pose, puisqu'un palier sauteur joue
        // désormais sa propre classe. Sans elle, un buff/shackle d'AGI traversant un seuil en
        // branche servirait du danger stale.
        var critClass = DangerComboClass.critClassOf(stat.AGILITY)
        return mix64(mix64Memo((id << 10) | stat.CELL) ^ ((critClass << 60) | (max(0, stat.STRENGTH) << 48) | (max(0, stat.MAGIC) << 36) | (max(0, stat.TOTAL_MP) << 24) | (max(0, stat.TOTAL_TP) << 12) | stat.POWER))
    }
}
