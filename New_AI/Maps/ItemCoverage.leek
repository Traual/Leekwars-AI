/*
 * Géométrie d'items, commune à Danger et Heal : quelles cellules chaque item atteint depuis
 * l'ensemble des positions accessibles d'un caster, et à quelle distance d'AoE.
 * Ne connaît ni les dégâts, ni les soins, ni les camps — seulement des portées et des zones.
 */

include("../includes.leek")

class ItemCoverageClass {

	/* Hash de contenu d'une map [item -> dist] : chaîne NON LINÉAIRE, entrée (item 9 bits |
	 * dist 4 bits). Dépendant de l'ordre d'itération : deux maps de même contenu construites
	 * dans des ordres différents FRAGMENTENT seulement, elles ne collisionnent jamais.
	 * Digest de longueur variable que personne ne vérifie : chaîne à MULTIPLICATION puis un
	 * seul finaliseur — la variante bon marché de la famille 3, décrite dans le contrat des
	 * clés en tête de Constants.leek. C'est le fold le plus chaud de l'IA, d'où le finaliseur
	 * unique plutôt qu'un mix64 par item. */
	static hashItemAoeMap(ItemAoeMap) {
		var Hash_Final = 0
		for (var item: var dist in ItemAoeMap) {
			Hash_Final = (Hash_Final ^ ((item << 4) | dist)) * MIX_A
		}
		return mix64(Hash_Final)
	}

	/*
	 * [cell -> [item -> minAoeDist]] pour une liste d'items et les walkcells du caster.
	 * Les géométries vivent dans deux caches PERSISTANTS (jamais vidés au tour) clés par
	 * (movementKey, signature) — movementKey détermine exactement la map NoEntities,
	 * elle-même statique : même contexte au tour suivant ou chez un autre caster -> géométrie
	 * réutilisée telle quelle. Même FULL_GEOMETRY_KEY -> toute la map d'AoE partagée ; même
	 * LAUNCH_GEOMETRY_KEY -> l'union des cellules directement lançables partagée. Maps cachées
	 * STRICTEMENT read-only.
	 * Seul l'ASSEMBLAGE dépend de la liste d'items (cooldown-filtrée par tour) — il reste
	 * caché par tour chez les appelants. L'ordre d'insertion des items = l'ordre de la liste
	 * (le fold dépendant de l'ordre de hashItemAoeMap, les clés de combo et l'ordre glouton
	 * en dépendent).
	 */
	static buildMapCellItemAoe(items, walkCellsMap, movementKey) {
		var _final = [: ]
		for (var Item in items) {
			var flat = ITEMINFO[Item].AREA_MAX == 0
			var itemMap = geometryOfItem(Item, walkCellsMap, movementKey)
			// Deux boucles plutôt qu'un test par cellule : le fold est le point chaud.
			if (flat) {
				for (var Cell: var Direct in itemMap) {
					if (Cell in _final) {
						_final[Cell][Item] = 0
					} else {
						_final[Cell] = [: ]
						_final[Cell][Item] = 0
					}
				}
			} else {
				for (var Cell: var MinAoeDist in itemMap) {
					if (Cell in _final) {
						_final[Cell][Item] = MinAoeDist
					} else {
						_final[Cell] = [: ]
						_final[Cell][Item] = MinAoeDist
					}
				}
			}
		}
		return _final
	}

	/* Géométrie d'UN item depuis toutes les positions accessibles du caster, mémorisée dans
	 * les deux caches persistants. Partagée par l'assemblage complet et par le paresseux.
	 * Sans zone d'effet, la map d'item vaut 0 sur exactement les cellules directement
	 * lançables : ses valeurs ne portent aucune information et l'union des cellules lançables
	 * tient lieu de jeu de clés. AREA_MAX ne dépend que d'AREA, lui-même dans
	 * FULL_GEOMETRY_KEY — deux items ne peuvent donc pas partager une entrée du cache avec des
	 * AREA_MAX différents. */
	static geometryOfItem(Item, walkCellsMap, movementKey) {
		var Infos = ITEMINFO[Item]
		var fullKey = (movementKey << 30) | Infos.FULL_GEOMETRY_KEY
		if (fullKey in ITEM_FULL_GEOMETRY_CACHE) return ITEM_FULL_GEOMETRY_CACHE[fullKey]
		var launchKey = (movementKey << 25) | Infos.LAUNCH_GEOMETRY_KEY
		var directCells
		if (launchKey in ITEM_LAUNCH_GEOMETRY_CACHE) {
			directCells = ITEM_LAUNCH_GEOMETRY_CACHE[launchKey]
		} else {
			directCells = getMapHittableCellsTotal(Infos, walkCellsMap)
			ITEM_LAUNCH_GEOMETRY_CACHE[launchKey] = directCells
		}
		var itemMap = Infos.AREA_MAX == 0 ? directCells : getMapAoeForItem(Infos, directCells)
		ITEM_FULL_GEOMETRY_CACHE[fullKey] = itemMap
		return itemMap
	}

	/*
	 * Même information que buildMapCellItemAoe, gardée sous forme des géométries par item :
	 * l'assemblage d'une cellule n'a lieu qu'à la demande. Pour un consommateur qui ne lit que
	 * quelques cellules sur les quelques centaines que le caster atteint, l'assemblage complet
	 * est presque entièrement du travail jeté.
	 */
	static buildLazyCellItemAoe(items, walkCellsMap, movementKey) {
		var geoms = []
		var flats = []
		for (var Item in items) {
			push(geoms, geometryOfItem(Item, walkCellsMap, movementKey))
			// Géométrie d'un item sans zone d'effet : VALEURS BOOLÉENNES, la distance vaut zéro.
			push(flats, ITEMINFO[Item].AREA_MAX == 0)
		}
		return new LazyCoverageClass(items, geoms, flats)
	}

	/*
	 * [item -> distance d'AoE minimale] à UNE cellule, ou null si aucun item ne l'atteint.
	 * L'ordre d'insertion suit la liste d'items, exactement comme l'assemblage complet — le
	 * hash de contenu et l'ordre glouton en dépendent. Mémorisé, absences comprises.
	 */
	static itemAoeAt(Coverage, Cell) {
		var memo = Coverage.CELLS
		if (Cell in memo) return memo[Cell]
		var items = Coverage.ITEMS
		var geoms = Coverage.GEOMS
		var flats = Coverage.FLATS
		var n = count(items)
		var _final = null
		for (var k = 0; k < n; k++) {
			var geom = geoms[k]
			if (!(Cell in geom)) continue
			if (_final == null) _final = [: ]
			_final[items[k]] = flats[k] ? 0 : geom[Cell]
		}
		memo[Cell] = _final
		return _final
	}

	/* Hash de contenu de la cellule, mémorisé sur la géométrie : partagé par tous ceux qui
	 * réutilisent cette géométrie (mêmes déplacements, stats différentes). */
	static contentHashAt(Coverage, Cell, ItemAoeMap) {
		var memo = Coverage.HASHES
		if (Cell in memo) return memo[Cell]
		var h = hashItemAoeMap(ItemAoeMap)
		memo[Cell] = h
		return h
	}

	/*
	 * [cellule -> distance d'AoE minimale] pour un item : les cellules touchables en direct
	 * (MapCellsBool, déjà calculées par l'appelant) valent 0, puis l'expansion d'AoE remplit
	 * le reste au plus près. Ne dépend que de la map directe, d'AREA et d'AREA_MAX.
	 */
	static getMapAoeForItem(ItemInfos, MapCellsBool) {
		var _final = [: ]
		for (var cell: var bool in MapCellsBool) {
			_final[cell] = 0
		}
		if (ItemInfos.AREA_MAX > 0) {
			var area = ItemInfos.AREA
			for (var cell: var bool in MapCellsBool) {
				for (var Aoe: var AoeDist in CellClass.getAreaDist(area, cell)) {
					// Une cellule directement lançable vaut déjà 0 et AoeDist n'est jamais
					// négatif : l'écriture serait toujours un no-op. Le set direct est dense,
					// c'est le cas de la grande majorité des cellules de zone visitées, et le
					// test d'appartenance coûte trois fois moins qu'une lecture.
					if (Aoe in MapCellsBool) continue
					var ActualCellDist = _final[Aoe]
					if (ActualCellDist == null || ActualCellDist > AoeDist) {
						_final[Aoe] = AoeDist
					}
				}
			}
		}
		return _final
	}

	/*
	 * [cellule -> true] : toutes les cellules touchables en direct par l'item depuis
	 * n'importe quelle cellule accessible du caster.
	 */
	static getMapHittableCellsTotal(ItemInfos, WalkCellsMap) {
		var _final = [: ]
		var LaunchType = ItemInfos.LAUNCHTYPE
		var MinRange = ItemInfos.MINRANGE
		var MaxRange = ItemInfos.MAXRANGE
		if (ItemInfos.NEEDLOS) {
			for (var EntityCell: var mp in WalkCellsMap) {
				_final += ActionsClass.LaunchWithLos[LaunchType](EntityCell, MinRange, MaxRange)
			}
		} else {
			for (var EntityCell: var mp in WalkCellsMap) {
				_final += ActionsClass.LaunchWithoutLos[LaunchType](EntityCell, MinRange, MaxRange)
			}
		}

		return _final
	}
}

/*
 * Couverture d'un caster gardée par item, avec les cellules déjà assemblées et leurs hashs de
 * contenu. Personne ne l'itère : on lui demande une cellule, via ItemCoverageClass.
 */
class LazyCoverageClass {
	ITEMS    // liste d'items, dans l'ordre qui fixe l'assemblage et l'ordre glouton
	GEOMS    // [k] = [cellule -> distance d'AoE] de ITEMS[k], VALEURS BOOLÉENNES si FLATS[k]
	FLATS    // [k] = ITEMS[k] est sans zone d'effet -> sa distance d'AoE vaut toujours zéro
	CELLS    // [cellule -> [item -> distance]] assemblées à la demande, absences comprises
	HASHES   // [cellule -> hash de contenu], mémorisé au premier besoin

	constructor(ThisItems, ThisGeoms, ThisFlats) {
		this.ITEMS = ThisItems
		this.GEOMS = ThisGeoms
		this.FLATS = ThisFlats
		this.CELLS = [: ]
		this.HASHES = [: ]
	}
}
