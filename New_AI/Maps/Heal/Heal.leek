/*
 * Heal map : le symétrique de la danger map, pour le soin. Les healers des DEUX camps sont
 * modélisés (un heal ennemi amortit ma pression de kill sur sa cible).
 *
 *   getHealMap(State) -> [casterId -> [ALLY_LEEK | ALLY_SUMMON -> [cell -> [heal, vitalité]]]]
 *
 * Pour chaque caster vivant qui peut soigner (SAUF Me : mes heals sont le travail du BFS),
 * sa "couverture" : ce qu'il peut poser sur une cible de son camp à chaque cellule,
 * déplacement + cast compris. Gardée par caster (pas sommée) pour que le net puisse
 * séquencer soins et dégâts par ordre de tour. La GÉOMÉTRIE est commune ; la VALEUR dépend
 * du PROFIL de cible (les masques moteur eff[4] d'Armoring/Loam/Fertilizer distinguent
 * poireau / summon — jamais d'id d'item en dur) et porte DEUX composantes : heal instantané
 * externe + vitalité (gain de LIFE ET de TOTAL_LIFE). Pas de profil SELF : le séquenceur
 * (netDamage) déroule les casters jouant APRÈS la cible, liste dont la cible est exclue —
 * un caster ne s'y soigne jamais lui-même.
 *
 * Plus simple que le danger :
 *  - EFFECT_HEAL durée 0 (les heals over time vivent dans les flux HEAL/HEAL_OVER_TIME,
 *    Consequences) + EFFECT_BOOST_MAX_LIFE ; jamais d'effet ON_CASTER (Vampirization exclue)
 *  - pas de shields, pas de chaîne de vulnés
 *  - PESSIMISTE : roll MIN (eff[1]) ; valeur = eff[1] · max(0, 1 + WIS/100) · (1 − 0.2·aoeDist)
 *  - combo = glouton (heal+vitalité)/TP dans TOTAL_TP + MAX_USES, composantes accumulées
 *    séparément
 *
 * Potentiel BRUT : cap de vie manquante, hausse du cap par la vitalité et séquençage vivent
 * dans DeltaClass.netDamage.
 */

include("../../includes.leek")

// Profils de cible de la couverture : même géométrie, valeur par TYPE de cible (valeurs
// conservées — 1 et 2 — pour la stabilité des clés de combo).
global HEAL_PROFILE_ALLY_LEEK = 1
global HEAL_PROFILE_ALLY_SUMMON = 2

class HealClass {

    /*
     * Contribution d'un healer au fingerprint de son side (fold XOR, indépendant de l'ordre).
     * SOURCE UNIQUE : les folds par side salent NETDAMAGE_CACHE, le fold combiné est la clé de
     * HEAL_MAP_CACHE. Tout site de fold passe par ici — une divergence scinde les caches en
     * silence. Stats clampées à 0 : shacklées négatives elles valent 0 à l'usage, et non
     * clampées elles absorberaient les champs hauts.
     */
    static healerContribution(stat, id) {
        // critClass (bits 10-11, libres : cellule < 1024) : le facteur de crit du healer
        // dépend de son AGI par seuils — sans ces bits, un buff/shackle d'AGI traversant
        // un seuil en branche servirait une couverture stale.
        var critClass = (stat.AGILITY >= MIN_AGILITY_TO_FULLY_CRIT) ? 2 : ((stat.AGILITY >= MIN_AGILITY_ENEMY_CRIT) ? 1 : 0)
        // Clé WIS = max(0, WIS + 100) : le facteur moteur est max(0, 1 + WIS/100), donc -50
        // (soigne 50%) doit se distinguer de 0 (100%) ; -100 et -150 partagent 0 (facteur nul).
        return addValueToBinHash(OFFSET_BASIS ^ id, (max(0, stat.WISDOM + 100) << 32) | (max(0, stat.TOTAL_TP) << 22) | (max(0, stat.TOTAL_MP) << 12) | (critClass << 10) | stat.CELL)
    }

    /*
     * Variante GATÉE : la contribution de l'entité au fingerprint de son side, 0 si elle ne
     * qualifie pas (vivante, non-Me, avec un item de heal). Les deux camps qualifient.
     */
    static healerContributionOf(stat, id) {
        if (id == Me || stat.LIFE <= 0) return 0
        if (!hasHealItem(stat)) return 0
        return healerContribution(stat, id)
    }

    /*
     * Heal map par fingerprint combiné DÉJÀ CONNU (XOR des HFP_BY_SIDE du nœud).
     * Hit sauf si un healer a changé sur la branche ; au miss, la liste des casters est
     * reconstruite en un scan.
     */
    static getHealMapByFp(State, fp) {
        if (fp in HEAL_MAP_CACHE) return HEAL_MAP_CACHE[fp]
        var casters = []
        for (var e: var stat in State) {
            if (healerContributionOf(stat, e) != 0) push(casters, e)
        }
        return getHealMapPrecomputed(State, fp, casters)
    }

    /*
     * Reconstruction complète du fingerprint par side (un side sans healer reste ABSENT,
     * toute lecture est 0-défaut). Racine du BFS + fallback summon/résurrection du nœud —
     * le patch incrémental doit rester bit-cohérent avec ceci.
     */
    static buildHfpBySide(State) {
        var _final = [: ]
        for (var e: var stat in State) {
            var c = healerContributionOf(stat, e)
            if (c != 0) _final[stat.SIDE] = ((stat.SIDE in _final) ? _final[stat.SIDE] : 0) ^ c
        }
        return _final
    }

    /*
     * Entrée sans argument : scanne State pour construire fingerprint + liste des casters,
     * puis délègue. Pour les appelants qui ne parcourent pas déjà State (FinalCell).
     */
    static getHealMap(State) {
        var fp = 0
        var casters = []
        for (var e: var stat in State) {
            var c = healerContributionOf(stat, e)
            if (c != 0) {
                fp ^= c
                push(casters, e)
            }
        }
        return getHealMapPrecomputed(State, fp, casters)
    }

    /*
     * Chemin chaud : fp + casters déjà construits par le scan de l'appelant.
     * Renvoyée PAR RÉFÉRENCE — read-only en aval. Hit hors fenêtre BenchOps
     * (le bucket "Heal" ne profile que les miss).
     */
    static getHealMapPrecomputed(State, fp, casters) {
        if (fp in HEAL_MAP_CACHE) return HEAL_MAP_CACHE[fp]
        BenchOps.Start("Heal")
        var _final = [: ]
        for (var caster in casters) {
            _final[caster] = getCasterCoverage(State[caster])
        }
        HEAL_MAP_CACHE[fp] = _final
        BenchOps.Stop("Heal")
        return _final
    }

    /*
     * [ALLY_LEEK | ALLY_SUMMON -> [cell -> [heal, vitalité]]] : ce que ce caster peut poser
     * sur chaque cellule, par profil de cible. Clé (id, couche marche/saut, cell, mp, wis,
     * tp). En dessous, split géométrie / valeur (miroir de la danger map) : la GÉOMÉTRIE
     * (quelles cellules chaque item atteint — le gros d'un build froid) ne dépend que de
     * (id, cell, mp, couche marche/saut future), est COMMUNE aux deux profils et se cache à
     * part ; un buff/shackle WIS ou TP ne reconstruit que la couche combo (sauf
     * franchissement du coût de Jump, qui change la couche géométrique).
     */
    static getCasterCoverage(casterStats) {
        // Crit binaire asymétrique (Constants) : healer ENNEMI craint critique dès
        // MIN_AGILITY_ENEMY_CRIT (son soutien joue contre moi), healer allié crédité
        // seulement à MIN_AGILITY_TO_FULLY_CRIT. Facteur commun -> post-multiplication de la
        // couverture (l'ordre du combo ne change pas), les combos restent crit-free.
        var critAt = (casterStats.SIDE != getSide(Me)) ? MIN_AGILITY_ENEMY_CRIT : MIN_AGILITY_TO_FULLY_CRIT
        var critFactor = (casterStats.AGILITY >= critAt) ? CRITICAL_FACTOR : 1
        // Couche marche/saut FUTURE du caster (source unique canJumpNextTurn), calculée UNE
        // fois par appel froid : la géométrie dépend de (id, cellule, MP, couche) — un
        // buff/shackle TP franchissant le coût de Jump change la couche sans toucher le reste.
        var usesJumpLayer = WalkCellsClass.canJumpNextTurn(casterStats) ? 1 : 0
        var key = addValueToBinHash(OFFSET_BASIS ^ casterStats.ID, (usesJumpLayer << 20) | (casterStats.CELL << 10) | max(0, casterStats.TOTAL_MP))
        key = addValueToBinHash(key, ((critFactor > 1 ? 1 : 0) << 30) | (max(0, casterStats.WISDOM + 100) << 15) | max(0, casterStats.TOTAL_TP))   // WIS encodée max(0, WIS+100), voir healerContribution
        if (key in HEAL_COVERAGE_CACHE) return HEAL_COVERAGE_CACHE[key]

        // Couche géométrie — clé (id, couche, cellule, MP), même pack que la danger map.
        var geomKey = (casterStats.ID << 21) | (usesJumpLayer << 20) | (casterStats.CELL << 10) | max(0, casterStats.TOTAL_MP)
        var mapCellItemAoe
        if (geomKey in HEAL_CELL_ITEM_AOE_CACHE) {
            mapCellItemAoe = HEAL_CELL_ITEM_AOE_CACHE[geomKey]
        } else {
            // Le booléen déjà calculé choisit la couche directement — pas de second
            // canJumpNextTurn via getMaxWalkOrJumpNoEntitiesFull.
            var walkCells = usesJumpLayer ? WalkCellsClass.getJumpNoEntitiesFull(casterStats) : WalkCellsClass.getWalkNoEntitiesFull(casterStats)
            mapCellItemAoe = getMapCellItemAoe(casterStats, walkCells)
            HEAL_CELL_ITEM_AOE_CACHE[geomKey] = mapCellItemAoe
        }

        var _final = [: ]
        _final[HEAL_PROFILE_ALLY_LEEK] = [: ]
        _final[HEAL_PROFILE_ALLY_SUMMON] = [: ]
        for (var cell: var itemAoeMap in mapCellItemAoe) {
            // Hash de contenu calculé UNE fois par cellule, partagé entre les deux profils.
            var contentHash = DangerClass.getHashFromItemAoeMap(itemAoeMap)
            for (var profile = HEAL_PROFILE_ALLY_LEEK; profile <= HEAL_PROFILE_ALLY_SUMMON; profile++) {
                var combo = comboAtCell(itemAoeMap, casterStats, profile, contentHash)
                if (combo[0] > 0 || combo[1] > 0) {
                    _final[profile][cell] = [combo[0] * critFactor, combo[1] * critFactor]
                }
            }
        }
        HEAL_COVERAGE_CACHE[key] = _final
        return _final
    }

    /* [cell -> [item -> minAoeDist]] : quelles cellules chaque item de heal atteint
     * (réutilise la géométrie de la danger map). */
    static getMapCellItemAoe(casterStats, walkCells) {
        var startCell = casterStats.CELL
        var _final = [: ]
        for (var item in getHealItemsList(casterStats)) {
            for (var cell: var minAoeDist in DangerClass.getMapAoeForItem(item, ITEMINFO[item], walkCells, startCell)) {
                if (cell in _final) {
                    _final[cell][item] = minAoeDist
                } else {
                    _final[cell] = [: ]
                    _final[cell][item] = minAoeDist
                }
            }
        }
        return _final
    }

    /*
     * Combo de heal glouton sur une cellule pour UN profil : empile les meilleurs items
     * (heal+vitalité)/TP dans TOTAL_TP + MAX_USES, en accumulant les DEUX composantes
     * séparément -> [heal, vitalité]. Memoïsé par CONTENU : fonction pure des entrées
     * [item -> dist] de la cellule + (WIS, TOTAL_TP, PROFIL) — ~350 cellules mais ~10
     * contenus distincts, partagés entre casters ; deux profils ne partagent JAMAIS un
     * combo (profil dans la clé), et deux casters de TYPES différents partagent
     * correctement un combo allié identique (un profil allié ne dépend pas du type du
     * caster). USES volontairement HORS clé : tout heal caster a USES = 0. Le fold de
     * contenu est dépendant de l'ordre d'itération : deux maps de même contenu construites
     * dans des ordres différents FRAGMENTENT seulement, jamais de collision.
     */
    static comboAtCell(itemAoeMap, casterStats, profile, contentHash) {
        // contentHash = fold de contenu de itemAoeMap, calculé par l'appelant (une fois par
        // cellule, partagé entre les deux profils) — clé bit-identique à l'ancienne.
        var comboKey = addValueToBinHash(OFFSET_BASIS ^ contentHash,
            (profile << 34) | (max(0, casterStats.WISDOM + 100) << 15) | max(0, casterStats.TOTAL_TP))   // WIS encodée max(0, WIS+100), voir healerContribution
        if (comboKey in HEAL_COMBO_CACHE) return HEAL_COMBO_CACHE[comboKey]

        // Facteur sagesse invariant du miss, calculé une fois (le moteur floor le SOIN, pas
        // la stat : WIS -50 soigne 50%, <= -100 soigne 0).
        var wisdomFactor = max(0, 1 + casterStats.WISDOM / 100)
        var items = []
        for (var item: var aoeDist in itemAoeMap) {
            var parts = getItemHealParts(item, wisdomFactor, aoeDist, profile)
            var gain = parts[0] + parts[1]
            if (gain <= 0) continue
            // [item, heal, vitalité, efficacité, coût] — efficacité = (heal+vitalité)/TP
            // pré-calculée une fois (même division que l'ancien comparateur, mêmes floats).
            var cost = ITEMINFO[item].COST
            push(items, [item, parts[0], parts[1], gain / cost, cost])
        }
        if (count(items) == 0) {
            var zero = [0, 0]
            HEAL_COMBO_CACHE[comboKey] = zero
            return zero
        }
        items = arraySort(items, function(a, b) { return b[3] - a[3] })  // efficacité desc

        var remainingTp = casterStats.TOTAL_TP
        var totalHeal = 0
        var totalVitality = 0
        for (var it in items) {
            var item = it[0]
            var cost = it[4]
            var maxUses = ITEMINFO[item].MAX_USES
            // Chaque item n'apparaît qu'une fois dans la liste -> un scalaire local de uses
            // suffit ; casterStats.USES n'est jamais muté ni cloné.
            var itemUses = casterStats.USES[item]
            while (remainingTp >= cost && itemUses < maxUses) {
                totalHeal += it[1]
                totalVitality += it[2]
                remainingTp -= cost
                itemUses++
            }
        }
        var res = [totalHeal, totalVitality]
        HEAL_COMBO_CACHE[comboKey] = res
        return res
    }

    /*
     * Un effet peut-il toucher ce PROFIL de cible ? Miroir des règles d'isHitable (masque
     * eff[4]) : ALLIES + le type du profil (cible toujours distincte du caster — pas de
     * profil SELF, voir le header). Armoring/Loam/Fertilizer fonctionnent par leurs
     * données moteur, aucune exception d'id.
     */
    static effectMatchesProfile(eff, profile) {
        var mask = eff[4]
        if (!(mask & EFFECT_TARGET_ALLIES)) return false
        return (profile == HEAL_PROFILE_ALLY_SUMMON) ? (mask & EFFECT_TARGET_SUMMONS) : (mask & EFFECT_TARGET_NON_SUMMONS)
    }

    /* [heal, vitalité] d'un item à une distance d'AoE pour un profil : roll MIN, scalé
     * sagesse (wisdomFactor pré-calculé par l'appelant), falloff d'AoE — jamais d'effet
     * ON_CASTER (Vampirization & co). */
    static getItemHealParts(item, wisdomFactor, distance, profile) {
        var distFactor = 1 - distance * 0.2
        var heal = 0
        var vitality = 0
        for (var eff in ITEMINFO[item].EFFECTS) {
            if (eff[5] & EFFECT_MODIFIER_ON_CASTER) continue
            if (!effectMatchesProfile(eff, profile)) continue
            if (eff[0] == EFFECT_HEAL && eff[3] == 0) {
                heal += eff[1] * distFactor * wisdomFactor        // eff[1] = roll MIN (pessimiste)
            } else if (eff[0] == EFFECT_BOOST_MAX_LIFE) {
                vitality += eff[1] * distFactor * wisdomFactor
            }
        }
        return [heal, vitality]
    }

    /* Items de heal castables du caster (cooldown <= 1), cachés par id pour le tour. */
    static getHealItemsList(casterStats) {
        if (casterStats.ID in HEAL_ENTITY_INVENTORY) return HEAL_ENTITY_INVENTORY[casterStats.ID]
        var _final = []
        for (var i: var cd in casterStats.COOLDOWNS) {
            if (cd > 1) continue
            if (isHealItem(ITEMINFO[i])) push(_final, i)
        }
        HEAL_ENTITY_INVENTORY[casterStats.ID] = _final
        return _final
    }

    static hasHealItem(casterStats) {
        return count(getHealItemsList(casterStats)) > 0
    }

    static isHealItem(Infos) {
        for (var eff in Infos.EFFECTS) {
            // Même filtre que getItemHealParts : un effet ON_CASTER n'est pas un heal
            // externe (Vampirization) ; heal instantané OU vitalité qualifient — un porteur
            // vitalité-only entre dans le fingerprint des healers.
            if (eff[5] & EFFECT_MODIFIER_ON_CASTER) continue
            if (eff[0] == EFFECT_HEAL && eff[3] == 0) return true
            if (eff[0] == EFFECT_BOOST_MAX_LIFE) return true
        }
        return false
    }

}
