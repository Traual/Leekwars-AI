/*
 * Heal map : le symétrique de la danger map, pour le soin. Les healers des DEUX camps sont
 * modélisés (un heal ennemi amortit ma pression de kill sur sa cible).
 *
 *   [casterId -> [ALLY_LEEK | ALLY_SUMMON -> [cell -> [heal, vitalité]]]]
 *
 * Pour chaque caster vivant qui peut soigner (SAUF Me : mes heals sont le travail du BFS),
 * sa "couverture" : ce qu'il peut poser sur une cible de son camp à chaque cellule,
 * déplacement + cast compris. Gardée par caster (pas sommée) pour que le net puisse
 * séquencer soins et dégâts par ordre de tour. La GÉOMÉTRIE est commune ; la VALEUR dépend
 * du PROFIL de cible (les masques moteur eff[4] d'Armoring/Loam/Fertilizer distinguent
 * poireau / summon — jamais d'id d'item en dur) et porte DEUX composantes : heal instantané
 * externe + vitalité (gain de LIFE ET de TOTAL_LIFE). Pas de profil SELF : le séquenceur
 * (netDamage) déroule les casters jouant APRÈS la cible, liste dont la cible est exclue —
 * un caster ne s'y soigne jamais lui-même.
 *
 * Plus simple que le danger :
 *  - EFFECT_HEAL durée 0 (les heals over time vivent dans les flux HEAL/HEAL_OVER_TIME,
 *    Consequences) + EFFECT_BOOST_MAX_LIFE ; jamais d'effet ON_CASTER (Vampirization exclue)
 *  - pas de shields, pas de chaîne de vulnés
 *  - PESSIMISTE : roll MIN (eff[1]) ; valeur = eff[1] · max(0, 1 + WIS/100) · (1 − 0.2·aoeDist)
 *  - combo = glouton (heal+vitalité)/TP dans TOTAL_TP + MAX_USES, composantes accumulées
 *    séparément
 *
 * Potentiel BRUT : cap de vie manquante, hausse du cap par la vitalité et séquençage vivent
 * dans DeltaClass.netDamage.
 */

include("../../includes.leek")

// Profils de cible de la couverture : même géométrie, valeur par TYPE de cible (valeurs
// conservées — 1 et 2 — pour la stabilité des clés de combo).
global HEAL_PROFILE_ALLY_LEEK = 1
global HEAL_PROFILE_ALLY_SUMMON = 2

class HealClass {

    /*
     * Contribution d'un healer au fingerprint de son side (fold XOR, indépendant de l'ordre).
     * SOURCE UNIQUE : les folds par side salent NETDAMAGE_CACHE, le fold combiné est la clé de
     * HEAL_MAP_CACHE. Tout site de fold passe par ici — une divergence scinde les caches en
     * silence. Stats clampées à 0 : shacklées négatives elles valent 0 à l'usage, et non
     * clampées elles absorberaient les champs hauts.
     */
    static healerContribution(stat, id) {
        // critClass (bits 44-46, au-dessus de WIS) : le facteur de crit du soigneur dépend de
        // son AGI par seuils, et un palier sauteur y ajoute les 100 AGI de Saut — d'où les
        // cinq classes. Sans ces bits, un buff/shackle d'AGI traversant un seuil en branche
        // servirait une couverture stale.
        // LIMITE ASSUMÉE : WIS + 100 occupe douze bits, donc à partir de 3996 de sagesse il
        // déborde sur la classe critique et deux soigneurs de classes différentes rendent la
        // MÊME empreinte. Ce n'est pas une collision probabiliste, c'est un recouvrement exact.
        // Aucun build ne s'en approche aujourd'hui. Le jour où ces valeurs deviennent jouables,
        // il faudra séparer les deux champs : écraser ou plafonner la sagesse encodée ne
        // suffirait pas, deux sagesses distinctes soignant vraiment différemment.
        var critClass = DangerComboClass.critClassOf(stat.AGILITY)
        // Clé WIS = max(0, WIS + 100) : le facteur moteur est max(0, 1 + WIS/100), donc -50
        // (soigne 50%) doit se distinguer de 0 (100%) ; -100 et -150 partagent 0 (facteur nul).
        // mix64 et non addValueToBinHash : ces contributions sont XOR-foldees par camp. Un fold
        // XOR de sorties LINEAIRES se reduit a (XOR des termes d'id) ^ (XOR des packs) : deux
        // soigneurs qui echangent leurs stats rendent le meme fingerprint, et HEAL_MAP_CACHE
        // sert alors la map d'une AUTRE configuration. Mesure avant correctif : 2 245 hits
        // faux sur 59 812 (3,75 %). Meme forme que contextContribution ; (id + 1) car mix64(0) = 0.
        // Le soin dépend lui aussi de l'ORIGINE des TP depuis qu'Adrénaline lui est comptée :
        // même terme que l'empreinte de contexte offensif, même source unique, et nul pour qui
        // ne porte aucun de ces items.
        return mix64(mix64Memo(id + 1) ^ EntityDangerClass.selfTpHeldTermOf(stat) ^ ((critClass << 44) | (max(0, stat.WISDOM + 100) << 32) | (max(0, stat.TOTAL_TP) << 22) | (max(0, stat.TOTAL_MP) << 12) | stat.CELL))
    }

    /*
     * Variante GATÉE : la contribution de l'entité au fingerprint de son side, 0 si elle ne
     * qualifie pas (vivante, non-Me, avec un item de heal). Les deux camps qualifient.
     */
    static healerContributionOf(stat, id) {
        if (id == Me || stat.LIFE <= 0) return 0
        if (!hasHealItem(stat)) return 0
        return healerContribution(stat, id)
    }

    /*
     * Heal map par fingerprint combiné DÉJÀ CONNU (XOR des HFP_BY_SIDE du nœud).
     * Hit sauf si un healer a changé sur la branche ; au miss, la liste des casters est
     * reconstruite en un scan.
     */
    static getHealMapByFp(State, fp) {
        if (fp in HEAL_MAP_CACHE) return HEAL_MAP_CACHE[fp]
        var casters = []
        for (var e: var stat in State) {
            if (healerContributionOf(stat, e) != 0) push(casters, e)
        }
        return getHealMapPrecomputed(State, fp, casters)
    }

    /*
     * Reconstruction complète du fingerprint par side (un side sans healer reste ABSENT,
     * toute lecture est 0-défaut). Racine du BFS + fallback summon/résurrection du nœud —
     * le patch incrémental doit rester bit-cohérent avec ceci.
     */
    static buildHfpBySide(State) {
        var _final = [: ]
        // Map TOTALE : chaque camp présent y figure, à 0 s'il n'a aucun soigneur. Les lecteurs
        // n'ont plus à tester l'appartenance pour retomber sur 0 — or le net la lit une fois
        // par terme. Semée sur les camps des MORTS aussi : la totalité ne doit pas dépendre de
        // qui est vivant à la racine. Ajouter des zéros ne change aucun fold (0 est neutre pour
        // le XOR) ni aucune comparaison parent/enfant.
        for (var e: var stat in State) _final[stat.SIDE] = 0
        for (var e: var stat in State) {
            var c = healerContributionOf(stat, e)
            if (c != 0) _final[stat.SIDE] ^= c
        }
        return _final
    }

    /*
     * Chemin chaud : fp + casters déjà construits par le scan de l'appelant.
     * Renvoyée PAR RÉFÉRENCE — read-only en aval. Hit hors fenêtre BenchOps
     * (le bucket "Heal" ne profile que les miss).
     */
    static getHealMapPrecomputed(State, fp, casters) {
        if (fp in HEAL_MAP_CACHE) return HEAL_MAP_CACHE[fp]
        BenchOps.Start("Heal")
        var _final = [: ]
        for (var caster in casters) {
            _final[caster] = getCasterCoverage(State[caster])
        }
        HEAL_MAP_CACHE[fp] = _final
        BenchOps.Stop("Heal")
        return _final
    }

    /*
     * [ALLY_LEEK | ALLY_SUMMON -> [cell -> [heal, vitalité]]] : ce que ce caster peut poser
     * sur chaque cellule, par profil de cible. Clé (id, paliers jouables, cell, mp, wis, tp).
     * En dessous, split géométrie / valeur (miroir de la danger map) : la GÉOMÉTRIE (quelles
     * cellules chaque item atteint — le gros d'un build froid) ne dépend que de (id, cell, mp,
     * palier), est COMMUNE aux deux profils et se cache à part ; un buff/shackle WIS ou TP ne
     * reconstruit que la couche combo, sauf s'il franchit le coût de Saut ou de Télépo et
     * ouvre un palier de plus.
     */
    static getCasterCoverage(casterStats) {
        // Crit binaire asymétrique (Constants) : healer ENNEMI craint critique dès
        // MIN_AGILITY_ENEMY_CRIT (son soutien joue contre moi), healer allié crédité
        // seulement à MIN_AGILITY_TO_FULLY_CRIT. Facteur PAR PALIER : franchir par Saut pose
        // +100 AGI et peut faire passer le soigneur en critique. Post-multiplication de la
        // couverture (l'ordre du combo ne change pas), les combos restent crit-free.
        var crits = DangerComboClass.tierCritFactorsOf(casterStats)
        // Paliers de déplacement JOUABLES au prochain tour du soigneur, en masque : il les
        // compare tous, il ne se contente pas du plus haut. Le masque entre dans la clé, et
        // ne se déduit pas de la couche — à moins de 13 TP, savoir sauter ET se téléporter
        // n'ouvre pas le palier combiné.
        var availMask = 1
        if (WalkCellsClass.dangerTierAvailable(casterStats, 1)) availMask += 2
        if (WalkCellsClass.dangerTierAvailable(casterStats, 2)) availMask += 4
        if (WalkCellsClass.dangerTierAvailable(casterStats, 3)) availMask += 8
        var mp = WalkCellsClass.dangerMpOf(casterStats)
        var key = addValueToBinHash(OFFSET_BASIS ^ casterStats.ID, (availMask << 20) | (casterStats.CELL << 10) | mp)
        key = addValueToBinHash(key, ((crits[1] > 1 ? 1 : 0) << 31) | ((crits[0] > 1 ? 1 : 0) << 30) | (max(0, casterStats.WISDOM + 100) << 15) | max(0, casterStats.TOTAL_TP))   // WIS encodée max(0, WIS+100), voir healerContribution
        if (key in HEAL_COVERAGE_CACHE) return HEAL_COVERAGE_CACHE[key]

        // UNE géométrie par palier jouable, clé (id, palier, cellule, MP) — même pack que la
        // danger map, donc celle du palier 0 partage l'entrée d'un soigneur immobile. Gardées
        // PARESSEUSES : le déroulé du net n'interroge qu'une cellule par appel, alors que le
        // soigneur en atteint quelques centaines ; les quatre ne coûtent ici que leurs
        // fetchers de cellules. Partagées par toutes les couvertures de même déplacement
        // (stats de soin différentes), avec leurs hashs de contenu.
        var geoms = [null, null, null, null]
        var healItems = getHealItemsList(casterStats)
        for (var t = 0; t < 4; t++) {
            if ((availMask & (1 << t)) == 0) continue
            var movementKey = (t << 20) | (casterStats.CELL << 10) | mp
            var geomKey = (casterStats.ID << 22) | movementKey
            if (geomKey in HEAL_CELL_ITEM_AOE_CACHE) {
                geoms[t] = HEAL_CELL_ITEM_AOE_CACHE[geomKey]
            } else {
                // Le palier déjà résolu choisit le fetcher directement — pas de seconde
                // cascade de cooldowns via getMaxWalkOrJumpNoEntitiesFull.
                var walkCells = WalkCellsClass.getDangerLayerCells(casterStats, t)
                geoms[t] = ItemCoverageClass.buildLazyCellItemAoe(healItems, walkCells, movementKey)
                HEAL_CELL_ITEM_AOE_CACHE[geomKey] = geoms[t]
            }
        }

        // Coût NET de chaque palier : son prix de franchissement moins ce qu'un auto-buff de
        // TP rentable rapporte au soigneur, exactement comme la carte de danger — les deux
        // ordres de cast, chacun avec sa condition de paiement et son facteur critique.
        // Résolu ICI, une fois par couverture, jamais par cellule.
        var tierTp = [0, 0, 0, 0]
        var prof = EntityDangerClass.selfTpProfileOf(casterStats)
        var totTp = casterStats.TOTAL_TP
        for (var t = 0; t < 4; t++) {
            var moveCost = WalkCellsClass.dangerLayerTpCost(t)
            tierTp[t] = moveCost
            if (prof == null) continue
            var best = 0
            var vA = EntityDangerClass.selfTpValueAt(prof, crits[0])
            if (totTp >= prof[1] && totTp - prof[1] + vA >= moveCost) {
                var gA = vA - prof[2] - prof[1]
                if (gA > best) best = gA
            }
            if (totTp - moveCost >= prof[1]) {
                var gB = EntityDangerClass.selfTpValueAt(prof, crits[t]) - prof[2] - prof[1]
                if (gB > best) best = gB
            }
                tierTp[t] = moveCost - best
        }

        // Part du caster dans la clé de combo : INVARIANTE sur toutes les cellules et sur les
        // deux profils au bit de profil près. Packée une fois ici, plus jamais par cellule.
        var statPack = (max(0, casterStats.WISDOM + 100) << 15) | max(0, casterStats.TOTAL_TP)   // WIS encodée max(0, WIS+100), voir healerContribution
        var _final = new HealCoverageClass(geoms, casterStats, crits,
            (HEAL_PROFILE_ALLY_LEEK << 34) | statPack, (HEAL_PROFILE_ALLY_SUMMON << 34) | statPack,
            tierTp)
        HEAL_COVERAGE_CACHE[key] = _final
        return _final
    }

    /*
     * [heal, vitalité] que ce caster pose sur une cellule pour un profil de cible, DÉJÀ pondéré
     * par HEAL_COEF, ou null s'il n'y pose rien. Assemblage, hash de contenu et combo sont résolus à la demande puis
     * mémorisés par profil, absences comprises — le combo lui-même reste porté par
     * HEAL_COMBO_CACHE, clé par contenu, donc partagé entre casters et entre couvertures.
     */
    static partsAt(Coverage, Profile, Cell) {
        var memo = (Profile == HEAL_PROFILE_ALLY_SUMMON) ? Coverage.SUMMON : Coverage.LEEK
        if (Cell in memo) return memo[Cell]
        var parts = null
        var pack = (Profile == HEAL_PROFILE_ALLY_SUMMON) ? Coverage.PACK_SUMMON : Coverage.PACK_LEEK
        var geoms = Coverage.GEOMS
        var crits = Coverage.CRITS
        var tierTp = Coverage.TIER_TP
        var totalTp = Coverage.STATS.TOTAL_TP
        // Le soigneur choisit son palier : franchir lui ouvre des cibles mais lui prend les TP
        // qu'il aurait dépensés en soins. Les paliers sont emboîtés, donc plusieurs rendent
        // souvent la même panoplie sur cette cellule : on les dédoublonne par hash de CONTENU
        // et le balayage montant garde le moins cher — sauf quand leurs facteurs critiques
        // diffèrent, Saut posant +100 AGI : le palier plus cher est alors une vraie option.
        // Ce qui départage ensuite, c'est la vie projetée rendue, critique compris — soin et
        // vitalité confondus, les deux termes que le déroulé somme.
        var combo = null
        var critFactor = 1
        var seen = [: ]
        for (var t = 0; t < 4; t++) {
            var geom = geoms[t]
            if (geom == null) continue
            var itemAoeMap = ItemCoverageClass.itemAoeAt(geom, Cell)
            if (itemAoeMap == null) continue
            var contentHash = ItemCoverageClass.contentHashAt(geom, Cell, itemAoeMap)
            var crit = crits[t]
            // Un bit par classe de critique dans la même map : deux paliers de même panoplie
            // dont l'un saute ne posent pas le même soin, et ne sont donc pas des doublons.
            var cb = (crit > 1) ? 2 : 1
            var sm = (contentHash in seen) ? seen[contentHash] : 0
            if ((sm & cb) != 0) continue
            seen[contentHash] = sm | cb
            var budget = totalTp - tierTp[t]
            if (budget <= 0) continue
            var c = comboAtCell(itemAoeMap, Coverage.STATS, Profile, pack, contentHash, budget)
            if (combo == null || (c[0] + c[1]) * crit > (combo[0] + combo[1]) * critFactor) {
                combo = c
                critFactor = crit
            }
        }
        if (combo != null && (combo[0] > 0 || combo[1] > 0)) {
            // HEAL_COEF replie ICI : le déroulé du net le remultipliait à chaque usage alors
            // que la valeur est mémoïsée par cellule. La multiplication flottante étant
            // commutative au bit près, la valeur rendue est identique.
            parts = [combo[0] * critFactor * HEAL_COEF, combo[1] * critFactor * HEAL_COEF]
        }
        memo[Cell] = parts
        return parts
    }

    /*
     * Combo de heal glouton sur une cellule pour UN profil : empile les meilleurs items
     * (heal+vitalité)/TP dans TpBudget + MAX_USES, en accumulant les DEUX composantes
     * séparément -> [heal, vitalité]. Memoïsé par CONTENU : fonction pure des entrées
     * [item -> dist] de la cellule + (WIS, budget de TP, PROFIL) — ~350 cellules mais ~10
     * contenus distincts, partagés entre casters ; deux profils ne partagent JAMAIS un
     * combo (profil dans la clé), et deux casters de TYPES différents partagent
     * correctement un combo allié identique (un profil allié ne dépend pas du type du
     * caster). USES volontairement HORS clé : tout heal caster a USES = 0. Le fold de
     * contenu est dépendant de l'ordre d'itération : deux maps de même contenu construites
     * dans des ordres différents FRAGMENTENT seulement, jamais de collision.
     */
    static comboAtCell(itemAoeMap, casterStats, profile, ProfilePack, contentHash, TpBudget) {
        // contentHash = fold de contenu de itemAoeMap, ProfilePack = (profil, WIS, TP) du
        // caster : tous deux calculés par l'appelant, une fois par cellule et une fois par
        // couverture. TpBudget entre aussi dans la clé — la même panoplie ne pose pas le
        // même soin selon que le soigneur a dû franchir pour l'atteindre.
        var comboKey = addTwoValuesToBinHash(OFFSET_BASIS ^ contentHash, ProfilePack, TpBudget)
        if (comboKey in HEAL_COMBO_CACHE) return HEAL_COMBO_CACHE[comboKey]

        // Facteur sagesse invariant du miss, calculé une fois (le moteur floor le SOIN, pas
        // la stat : WIS -50 soigne 50%, <= -100 soigne 0).
        var wisdomFactor = max(0, 1 + casterStats.WISDOM / 100)
        var items = []
        for (var item: var aoeDist in itemAoeMap) {
            var parts = getItemHealParts(item, wisdomFactor, aoeDist, profile)
            var gain = parts[0] + parts[1]
            if (gain <= 0) continue
            // [item, heal, vitalité, efficacité, coût] — efficacité = (heal+vitalité)/TP
            // pré-calculée une fois (même division que l'ancien comparateur, mêmes floats).
            var cost = ITEMINFO[item].COST
            push(items, [item, parts[0], parts[1], gain / cost, cost])
        }
        if (count(items) == 0) {
            var zero = [0, 0]
            HEAL_COMBO_CACHE[comboKey] = zero
            return zero
        }
        items = arraySort(items, function(a, b) { return b[3] - a[3] })  // efficacité desc

        var remainingTp = TpBudget
        var totalHeal = 0
        var totalVitality = 0
        for (var it in items) {
            var item = it[0]
            var cost = it[4]
            var maxUses = ITEMINFO[item].MAX_USES
            // Chaque item n'apparaît qu'une fois dans la liste -> un scalaire local de uses
            // suffit ; les USES du caster ne sont jamais mutés ni clonés.
            var itemUses = StateClass.usesOf(casterStats, item)
            while (remainingTp >= cost && itemUses < maxUses) {
                totalHeal += it[1]
                totalVitality += it[2]
                remainingTp -= cost
                itemUses++
            }
        }
        var res = [totalHeal, totalVitality]
        HEAL_COMBO_CACHE[comboKey] = res
        return res
    }

    /* [heal, vitalité] d'un item à une distance d'AoE pour un profil : roll MIN, scalé
     * sagesse (wisdomFactor pré-calculé par l'appelant), falloff d'AoE. Les vues
     * PRÉCOMPILÉES d'ItemClass portent déjà tout le filtrage (non ON_CASTER — jamais de
     * Vampirization & co —, ALLIES + type du profil) : il ne reste que l'accumulation,
     * lignes originales dans l'ordre d'EFFECTS — mêmes additions et arrondis flottants. */
    static getItemHealParts(item, wisdomFactor, distance, profile) {
        var Infos = ITEMINFO[item]
        var effs = (profile == HEAL_PROFILE_ALLY_SUMMON) ? Infos.HEAL_EFFECTS_ALLY_SUMMON : Infos.HEAL_EFFECTS_ALLY_LEEK
        if (effs == null) return [0, 0]
        var distFactor = 1 - distance * 0.2
        var heal = 0
        var vitality = 0
        for (var eff in effs) {
            // Dans la vue, un EFFECT_HEAL est forcément de durée 0 (filtré au préchargement).
            if (eff[0] == EFFECT_HEAL) {
                heal += eff[1] * distFactor * wisdomFactor        // eff[1] = roll MIN (pessimiste)
            } else {   // EFFECT_BOOST_MAX_LIFE
                vitality += eff[1] * distFactor * wisdomFactor
            }
        }
        return [heal, vitality]
    }

    /* Items de heal castables du caster (cooldown <= 1), cachés par id pour le tour.
     * Parcourt INVENTORY (même ordre que l'ancienne map de cooldowns) + cooldown effectif. */
    static getHealItemsList(casterStats) {
        if (casterStats.ID in HEAL_ENTITY_INVENTORY) return HEAL_ENTITY_INVENTORY[casterStats.ID]
        var _final = []
        for (var i in casterStats.INVENTORY) {
            if (StateClass.cooldownOf(casterStats, i) > 1) continue
            if (isHealItem(ITEMINFO[i])) push(_final, i)
        }
        HEAL_ENTITY_INVENTORY[casterStats.ID] = _final
        return _final
    }

    static hasHealItem(casterStats) {
        return count(getHealItemsList(casterStats)) > 0
    }

    /* Qualification précompilée (ItemClass.IS_HEAL_ITEM) : heal instantané OU vitalité non
     * ON_CASTER — sans exiger ALLIES, qualification historique des healers conservée. */
    static isHealItem(Infos) {
        return Infos.IS_HEAL_ITEM
    }

}

/*
 * Ce qu'un soigneur peut poser, résolu cellule par cellule à la demande. La GÉOMÉTRIE est
 * partagée par toutes les couvertures de même déplacement ; le reste (facteur critique, packs
 * de combo) est propre à ce jeu de stats de soin.
 */
class HealCoverageClass {
    GEOMS         // [couverture paresseuse du palier 0..3], null aux paliers injouables —
                  // chacune partagée avec les soigneurs de même déplacement, hashs compris
    STATS         // stats du caster, relues par le combo
    CRITS         // [facteur critique du palier 0..3], appliqué APRÈS le combo (les combos
                  // restent crit-free) ; les paliers sauteurs portent les +100 AGI de Saut
    TIER_TP       // [coût NET du palier 0..3] : son prix moins ce qu'un auto-buff de TP
                  // rentable rapporte, donc parfois négatif
    PACK_LEEK     // part caster de la clé de combo, profil poireau
    PACK_SUMMON   // idem, profil summon
    LEEK          // [cellule -> [heal, vitalité]] résolues, null quand rien n'est posé
    SUMMON

    constructor(ThisGeoms, ThisStats, ThisCrits, ThisPackLeek, ThisPackSummon, ThisTierTp) {
        this.GEOMS = ThisGeoms
        this.STATS = ThisStats
        this.CRITS = ThisCrits
        this.TIER_TP = ThisTierTp
        this.PACK_LEEK = ThisPackLeek
        this.PACK_SUMMON = ThisPackSummon
        this.LEEK = [: ]
        this.SUMMON = [: ]
    }
}
