/**
 * HEAL MAP — symmetric to the danger map, but for healing instead of damage. BOTH sides'
 * healers are modeled (enemy heals cushion enemy net damage — my kill pressure on a target
 * its healer can patch back up is worth less).
 *
 *   getHealMap(State) -> [ casterId -> [ cell -> heal ] ]
 *
 * For each alive caster that can heal (EXCEPT Me — my heals are handled by the BFS), its
 * "coverage": how much INSTANT heal it can deliver to a same-side target standing on each
 * cell, given where the caster can move + cast. Kept per-caster (not summed) so the net-HP
 * step can sequence heals/damage in TURN ORDER (can't blindly add X heal if the target died
 * or is already full life before the heal lands). heal_received(target) =
 *   Σ over casters K with K.SIDE == target.SIDE of coverage[K][target.CELL]
 * (the side gate lives in DeltaClass.netDamage — the map itself is side-agnostic).
 *
 * SIMPLER than danger:
 *  - only EFFECT_HEAL with duration 0 (instant). duration>0 = "negative poison" (vaccine/serum,
 *    a heal-over-time that cures POISON in Consequences) → excluded here.
 *  - NO shields (heal isn't reduced), NO vulnerability loop.
 *  - PESSIMISTIC: uses eff[1] (MIN roll) — small roll for heal (danger uses eff[2], max).
 *  - value(item) = eff[1] · (1 + WISDOM/100) · (1 − 0.2·aoeDist).   (mirrors Consequences EFFECT_HEAL)
 *  - combo = greedy heal/TP within TOTAL_TP + MAX_USES (no target dependence → per-caster only).
 *
 * Reuses DangerClass geometry (getMapAoeForItem) + WalkCells. RAW potential — the missing-life
 * cap and turn-order sequencing happen in DeltaClass.netDamage. Consumed per node by
 * DeltaClass.getNetDamageMap (hot path: getHealMapPrecomputed) and by FinalCell (no-arg getHealMap).
 **/

include("../../includes.leek")

class HealClass {

    /* One healer's contribution to its side's healers fingerprint (XOR-fold, order-independent).
     * SINGLE SOURCE OF TRUTH: the per-side folds salt NETDAMAGE_CACHE and the COMBINED (all-sides)
     * fold keys HEAL_MAP_CACHE. Every fold site uses it (getHealMap, getNetDamageMap, buildHfpBySide,
     * the Node HFP patch) — never inline it again, a divergence silently splits the caches. */
    static healerContribution(stat, id) {
        return addValueToBinHash(OFFSET_BASIS ^ id, (max(0, stat.WISDOM) << 32) | (max(0, stat.TOTAL_TP) << 22) | (max(0, stat.TOTAL_MP) << 12) | stat.CELL) // clamped: negative shackled stats == 0 at use, and unclamped they OR-absorb the higher fields
    }

    /* GATED composable variant: the entity's contribution to ITS side's healers fingerprint, 0
     * unless it qualifies (alive, non-Me — my heals are the BFS's job — with a heal item). BOTH
     * sides qualify (enemy heals modeled). SINGLE SOURCE for every fold site (getHealMap,
     * getNetDamageMap, buildHfpBySide, and the incremental Node patch of HFP_BY_SIDE — Phase 4a,
     * same pattern as contextContribution). */
    static healerContributionOf(stat, id) {
        if (id == Me || stat.LIFE <= 0) return 0
        if (!hasHealItem(stat)) return 0
        return healerContribution(stat, id)
    }

    /* Heal map lookup by an ALREADY-KNOWN combined fingerprint (XOR of the node's HFP_BY_SIDE
     * values — Phase 4a). Cache hit unless a healer changed on this branch; on a miss the casters
     * list is rebuilt with one scan. */
    static getHealMapByFp(State, fp) {
        if (fp in HEAL_MAP_CACHE) return HEAL_MAP_CACHE[fp]
        var casters = []
        for (var e: var stat in State) {
            if (healerContributionOf(stat, e) != 0) push(casters, e)
        }
        return getHealMapPrecomputed(State, fp, casters)
    }

    /* Full rebuild of the per-side healers fingerprint map (sides without healers stay ABSENT —
     * every read is 0-defaulted). Used at the BFS root and as the Node summon/resurrect fallback —
     * the incremental HFP patch must stay bit-consistent with this. */
    static buildHfpBySide(State) {
        var _final = [: ]
        for (var e: var stat in State) {
            var c = healerContributionOf(stat, e)
            if (c != 0) _final[stat.SIDE] = ((stat.SIDE in _final) ? _final[stat.SIDE] : 0) ^ c
        }
        return _final
    }

    /* No-arg entry: scans State to build the combined healers fingerprint + caster list, then
     * delegates. For callers that don't already walk State (FinalCell, debug). Keep this loop
     * structurally IDENTICAL to the fold in DeltaClass.getNetDamageMap. */
    static getHealMap(State) {
        var fp = 0
        var casters = []
        for (var e: var stat in State) {
            var c = healerContributionOf(stat, e)   // single-source gates + formula
            if (c != 0) {
                fp ^= c
                push(casters, e)
            }
        }
        return getHealMapPrecomputed(State, fp, casters)
    }

    /* Hot path: `fp` (COMBINED all-sides fingerprint, ORDER-INDEPENDENT) + `casters` are already
     * built by the caller's own State scan, so State isn't walked a second time here. Bit-identical
     * to the inline scan in getHealMap (same XOR fold, order-free). Returns the heal map BY REFERENCE. */
    static getHealMapPrecomputed(State, fp, casters) {
        BenchOps.Start("Heal")
        if (fp in HEAL_MAP_CACHE) {                          // unchanged healers across BFS nodes -> hit
            BenchOps.Stop("Heal")
            return HEAL_MAP_CACHE[fp]                        // BY REFERENCE — read-only downstream
        }

        var _final = [: ]
        for (var caster in casters) {
            _final[caster] = getCasterCoverage(State[caster])
        }
        HEAL_MAP_CACHE[fp] = _final
        BenchOps.Stop("Heal")
        return _final
    }

    /* [cell -> heal] : the instant heal this caster can land on a same-side target per cell.
     * Cached by (id, cell, mp, wisdom, tp) — constant per turn for a non-Me caster.
     * SPLIT below (mirrors the danger map): the GEOMETRY (which cells each item reaches — NoEnt
     * walkcells + AoE expansion, ~65% of a cold build) only depends on (id, cell, mp) and is
     * cached separately, so WIS/TP changes (shackles, buffs) rebuild only the cheap combo layer. */
    static getCasterCoverage(casterStats) {
        var key = addValueToBinHash(OFFSET_BASIS ^ casterStats.ID, (casterStats.CELL << 10) | max(0, casterStats.TOTAL_MP))
        key = addValueToBinHash(key, (max(0, casterStats.WISDOM) << 15) | max(0, casterStats.TOTAL_TP)) // clamped: negative shackled stats == 0 at use
        if (key in HEAL_COVERAGE_CACHE) return HEAL_COVERAGE_CACHE[key]

        // GEOMETRY layer — position-only key, same pack as danger's MAP_CELL_ITEM_AOE_CACHE.
        var geomKey = (casterStats.ID << 20) | (casterStats.CELL << 10) | max(0, casterStats.TOTAL_MP)
        var mapCellItemAoe
        if (geomKey in HEAL_CELL_ITEM_AOE_CACHE) {
            mapCellItemAoe = HEAL_CELL_ITEM_AOE_CACHE[geomKey]
        } else {
            var walkCells = WalkCellsClass.getMaxWalkOrJumpNoEntitiesFull(casterStats)
            mapCellItemAoe = getMapCellItemAoe(casterStats, walkCells)
            HEAL_CELL_ITEM_AOE_CACHE[geomKey] = mapCellItemAoe
        }

        var _final = [: ]
        for (var cell: var itemAoeMap in mapCellItemAoe) {
            _final[cell] = comboAtCell(itemAoeMap, casterStats)
        }
        HEAL_COVERAGE_CACHE[key] = _final
        return _final
    }

    /* [cell -> [item -> minAoeDist]] : which heal items reach which cells (reuses danger geometry). */
    static getMapCellItemAoe(casterStats, walkCells) {
        var startCell = casterStats.CELL
        var _final = [: ]
        for (var item in getHealItemsList(casterStats)) {
            for (var cell: var minAoeDist in DangerClass.getMapAoeForItem(item, ITEMINFO[item], walkCells, startCell)) {
                if (cell in _final) {
                    _final[cell][item] = minAoeDist
                } else {
                    _final[cell] = [: ]
                    _final[cell][item] = minAoeDist
                }
            }
        }
        return _final
    }

    /* Greedy heal combo on one cell: stack the best heal/TP items within TOTAL_TP + MAX_USES.
     * MEMOIZED BY CONTENT (mirrors danger's COMBO_FROM_ITEM_AOE_CACHE): the result is a pure
     * function of the cell's [item -> aoeDist] entries + the caster's (WIS, TOTAL_TP) — a
     * coverage build has ~350 cells but only ~10 distinct contents, and the same contents recur
     * across casters and rebuilds all turn. USES is deliberately NOT in the key: every heal
     * caster has USES = 0 (see Cache.leek). Reuses DangerClass.getHashFromItemAoeMap (the fold
     * is order-dependent over map iteration — same-object iteration is stable, two same-content
     * maps built in different orders only FRAGMENT, never collide). */
    static comboAtCell(itemAoeMap, casterStats) {
        var comboKey = addValueToBinHash(OFFSET_BASIS ^ DangerClass.getHashFromItemAoeMap(itemAoeMap), (max(0, casterStats.WISDOM) << 15) | max(0, casterStats.TOTAL_TP))
        if (comboKey in HEAL_COMBO_CACHE) return HEAL_COMBO_CACHE[comboKey]

        var items = []
        for (var item: var aoeDist in itemAoeMap) {
            var heal = getItemHeal(item, casterStats, aoeDist)
            if (heal <= 0) continue
            var cost = ITEMINFO[item].COST
            push(items, [item, heal, cost])
        }
        if (count(items) == 0) {
            HEAL_COMBO_CACHE[comboKey] = 0
            return 0
        }
        items = arraySort(items, function(a, b) { return (b[1] / b[2]) - (a[1] / a[2]) })  // heal/TP desc

        var remainingTp = casterStats.TOTAL_TP
        var uses = clone(casterStats.USES)
        var total = 0
        for (var it in items) {
            var item = it[0]
            var heal = it[1]
            var cost = it[2]
            var maxUses = ITEMINFO[item].MAX_USES
            while (remainingTp >= cost && uses[item] < maxUses) {
                total += heal
                remainingTp -= cost
                uses[item]++
            }
        }
        HEAL_COMBO_CACHE[comboKey] = total
        return total
    }

    /* Instant heal of one item on a target at AoE distance (eff MIN, WIS-scaled, no shields). */
    static getItemHeal(item, casterStats, distance) {
        var distFactor = 1 - distance * 0.2
        var wisdomFactor = 1 + max(0, casterStats.WISDOM) / 100 // floor-at-use, like the engine (wisdom shackle can store a negative)
        var _final = 0
        for (var eff in ITEMINFO[item].EFFECTS) {
            if (eff[0] == EFFECT_HEAL && eff[3] == 0) {        // instant heal only (duration 0)
                _final += eff[1] * distFactor * wisdomFactor   // eff[1] = MIN roll (pessimistic)
            }
        }
        return _final
    }

    static getHealItemsList(casterStats) {
        if (casterStats.ID in HEAL_ENTITY_INVENTORY) return HEAL_ENTITY_INVENTORY[casterStats.ID]
        var _final = []
        for (var i: var cd in casterStats.COOLDOWNS) {
            if (cd > 1) continue
            if (isHealItem(ITEMINFO[i])) push(_final, i)
        }
        HEAL_ENTITY_INVENTORY[casterStats.ID] = _final
        return _final
    }

    static hasHealItem(casterStats) {
        return count(getHealItemsList(casterStats)) > 0
    }

    static isHealItem(Infos) {
        for (var eff in Infos.EFFECTS) {
            if (eff[0] == EFFECT_HEAL && eff[3] == 0) return true
        }
        return false
    }

}
