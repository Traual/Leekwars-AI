/**
 * Walkable cells binary functions file
 *
 * Bitmap representation: 1 int per COUPLE of lines (18 couples total).
 *   bits 0-17  : even line 2c   (18 cells)
 *   bits 18-23 : gap (always 0)
 *   bits 24-40 : odd line 2c+1  (17 cells)
 *   bits 41-63 : unused
 *
 * Constants used inline (literals cost 0 ops):
 *   262143 = 0x3FFFF       (even-line mask, bits 0-17)
 *   131071 = 0x1FFFF       (odd-line mask after extracting to bits 0-16)
 *   24                     (shift amount to place odd at bits 24-40)
 *
 * Couple 17 holds only the even line 34 (line 35 doesn't exist), so its odd
 * half is always 0 and MAP_OBSTACLES[17] has no odd bits, naturally masking
 * out any odd contribution.
 **/

include("../../includes.leek")

function CellToLine(cell) { //Used Only In Init
	var couple = floor(cell / 35)
	var c = cell % 35
	var line = c >= 18 ? 1 : 0
	return couple * 2 + line
}

function CellToPos(cell) { //Used Only In Init
	var c = cell % 35
	var line = c >= 18 ? 1 : 0
	return c - (18 * line)
}

function RowColToCell(row, col) {
	var couple = floor(row / 2)
	return couple * 35 + (row % 2 == 1 ? 18 : 0) + col
}

function InitObstacles(Obstacles) { //Pour initialiser la bitmap Obstacles
	if (MAP_OBSTACLES_LOADED) {
		for (var c = 0; c < 18; c++) MAP_OBSTACLES[c] = MAP_OBSTACLES_CACHE[c]
	} else {
		// Base: even line valid (262143 = bits 0-17), odd line valid for c < 17 (131071 << 24)
		for (var c = 0; c < 17; c++) MAP_OBSTACLES[c] = 262143 | (131071 << 24)
		MAP_OBSTACLES[17] = 262143
		for (var x in Obstacles) {
			MAP_OBSTACLES[MAP_CELL_TO_COUPLE[x]] -= MAP_CELL_TO_BITMASK[x]
		}
		MAP_OBSTACLES_LOADED = true
		for (var c = 0; c < 18; c++) MAP_OBSTACLES_CACHE[c] = MAP_OBSTACLES[c]
	}
}

function InitLeekCells(LeekCells) { //on met sur la bitmap d'obstacles les positions des entitées
	for (var x in LeekCells) {
		MAP_OBSTACLES[MAP_CELL_TO_COUPLE[x]] -= MAP_CELL_TO_BITMASK[x]
	}
}

function InitAccesMp()   { for (var i = 0; i < 35; i++) ACCESMP[i] = [: ] }
function InitAccesMpJ()  { for (var i = 0; i < 35; i++) ACCESMPJ[i] = [: ] }
function InitAccesMpT()  { for (var i = 0; i < 35; i++) ACCESMPT[i] = [: ] }
function InitAccesMpTJ() { for (var i = 0; i < 35; i++) ACCESMPTJ[i] = [: ] }

function InitBuildAcc(cell) {
	for (var c = 0; c < 18; c++) ACC[c] = 0
	ACC[MAP_CELL_TO_COUPLE[cell]] = MAP_CELL_TO_BITMASK[cell]
}

function InitBuildAccJ(cell) {
	for (var c = 0; c < 18; c++) { ACC[c] = 0; ACCJ[c] = 0 }
	ACC[MAP_CELL_TO_COUPLE[cell]] = MAP_CELL_TO_BITMASK[cell]
}

function InitBuildAccT(cell) {
	for (var c = 0; c < 18; c++) { ACC[c] = 0; ACCT[c] = 0 }
	ACC[MAP_CELL_TO_COUPLE[cell]] = MAP_CELL_TO_BITMASK[cell]
}

function InitBuildAccTJ(cell) {
	for (var c = 0; c < 18; c++) { ACC[c] = 0; ACCJ[c] = 0; ACCT[c] = 0; ACCTJ[c] = 0 }
	ACC[MAP_CELL_TO_COUPLE[cell]] = MAP_CELL_TO_BITMASK[cell]
}

function SaveBaseAccessibles() {
	for (var c = 0; c < 18; c++) {
		var v = ACC[c]
		var e = v & 262143
		var c2 = c << 1
		if (e) ACCESMP[c2][e] = 0
		if (c < 17) {
			var o = v >> 24
			if (o) ACCESMP[c2 | 1][o] = 0
		}
	}
}

// ============================================================================
// Templates: 1 per action type. Loop over couples (18 iterations).
// Each iteration processes both the even and odd line of the couple.
// Shifts are inline. Parity is implicit (even half = bits 0-17, odd = 24-40).
// ============================================================================

// WalkOne: chebyshev = 1, only |Δline|=1 (diff parity).
//   Target even (line 2c) ← odd sources: shifts +1, 0 (left)  → Δpos in {-1, 0}
//   Target odd (line 2c+1) ← even sources: shifts 0, -1 (right) → Δpos in {0, +1}
// Note: src values only have bits 0-17 (even) and 24-40 (odd), so (v >> 24)
// already has at most bits 0-16 → the `& 131071` is redundant. Similarly
// `& obst` already masks `sumE` to bits 0-17, so `& 262143` is redundant.
function _WalkOne(src, tmp) {
	for (var c = 0; c < 18; c++) {
		var v = src[c]
		var e = v & 262143
		var o = v >> 24

		var sumE = o | (o << 1)
		if (c > 0) {
			var pO = src[c - 1] >> 24
			sumE |= pO | (pO << 1)
		}
		var sumO = e | (e >> 1)
		if (c < 17) {
			var nE = src[c + 1] & 262143
			sumO |= nE | (nE >> 1)
		}

		var obst = MAP_OBSTACLES[c]
		var newE = e | (sumE & obst)
		var newO = o | (sumO & (obst >> 24))
		tmp[c] = newE | (newO << 24)
	}
}

// TotalJump: chebyshev ≤ 3 from src. Source couples within Δcouple = -2..+2.
// Since the dc=0 same-parity case excludes Δpos=0 (= the source cell itself),
// but the base/walkable layers already contain that bit via `w & 262143`,
// re-including it via sumE is idempotent. We can therefore skip the dc != 0 check.
function _TotalJump(src, base, walkable, tmp) {
	for (var c = 0; c < 18; c++) {
		var sumE = 0
		var sumO = 0
		for (var dc = -2; dc <= 2; dc++) {
			var sc = c + dc
			if (sc < 0 || sc > 17) continue
			var v = src[sc]
			var e = v & 262143
			var o = v >> 24

			// Same parity (Δline even, dc in -1..+1): Δpos -1..+1
			if (dc >= -1 && dc <= 1) {
				sumE |= e | (e << 1) | (e >> 1)
				sumO |= o | (o << 1) | (o >> 1)
			}
			// Diff parity, o → sumE (Δpos -2..+1 → shifts +2,+1,0,-1), valid dc -2..+1
			if (dc <= 1) {
				sumE |= (o << 2) | (o << 1) | o | (o >> 1)
			}
			// Diff parity, e → sumO (Δpos -1..+2 → shifts +1,0,-1,-2), valid dc -1..+2
			if (dc >= -1) {
				sumO |= (e << 1) | e | (e >> 1) | (e >> 2)
			}
		}

		var obst = MAP_OBSTACLES[c]
		var b = base[c]
		var w = walkable[c]
		var oObst = obst >> 24
		var newE = (b & 262143) | (w & 262143) | (sumE & obst)
		var newO = (b >> 24) | (w >> 24) | (sumO & oObst)
		tmp[c] = newE | (newO << 24)
	}
}

// OnlyMaxJump: chebyshev = 3 exactly. R=3 odd → only diff parity contributes.
//   For target even, source odd:
//     - Δline = ±3 (edge, dc = -2 or +1): full Δpos -2..+1
//     - Δline = ±1 (dc = -1 or 0): corners only at Δpos = -2 and +1 (shifts +2 and -1)
//   For target odd, source even (only c < 17):
//     - Δline = ±3 (dc = -1 or +2): full Δpos -1..+2
//     - Δline = ±1 (dc = 0 or +1): corners only at Δpos = -1 and +2 (shifts +1 and -2)
function _OnlyMaxJump(src, base, tmp) {
	for (var c = 0; c < 18; c++) {
		var sumE = 0
		var sumO = 0

		// sumE edges Δline = ±3 (full odd→even dp range)
		if (c >= 2) {
			var o = src[c - 2] >> 24
			sumE |= (o << 2) | (o << 1) | o | (o >> 1)
		}
		if (c <= 16) {
			var o = src[c + 1] >> 24
			sumE |= (o << 2) | (o << 1) | o | (o >> 1)
		}
		// sumE non-edge Δline = ±1 (corners only)
		if (c >= 1) {
			var o = src[c - 1] >> 24
			sumE |= (o << 2) | (o >> 1)
		}
		var oSelf = src[c] >> 24
		sumE |= (oSelf << 2) | (oSelf >> 1)

		if (c < 17) {
			// sumO edges Δline = ±3 (full even→odd dp range)
			if (c >= 1) {
				var e = src[c - 1] & 262143
				sumO |= (e << 1) | e | (e >> 1) | (e >> 2)
			}
			if (c <= 15) {
				var e = src[c + 2] & 262143
				sumO |= (e << 1) | e | (e >> 1) | (e >> 2)
			}
			// sumO non-edge Δline = ±1 (corners only)
			var eSelf = src[c] & 262143
			sumO |= (eSelf << 1) | (eSelf >> 2)
			if (c <= 16) {
				var e = src[c + 1] & 262143
				sumO |= (e << 1) | (e >> 2)
			}
		}

		var obst = MAP_OBSTACLES[c]
		var b = base[c]
		var newE = (b & 262143) | (sumE & obst)
		var newO = (b >> 24) | (sumO & (obst >> 24))
		tmp[c] = newE | (newO << 24)
	}
}

// TotalTeleport: chebyshev ≤ 12 from src. Source couples within Δcouple = -6..+6.
//
// Optimisation: au lieu de calculer 12 shifts | OR (~24 ops) pour chaque variante
// (fE, fO, diff_to_sumE, diff_to_sumO), on utilise la "parallel expansion" pour
// construire l'OR de e décalé de -5..+5 en 3 étapes (15 ops), puis on ajoute les
// shifts extrêmes nécessaires. Au total ~22 ops pour les 2 variantes de e (vs 48).
//
// Pour dc=0 same parity, on inclut idempotamment Δpos=0 (= e lui-même) car
// `w & 262143` le contient déjà dans newE.
function _TotalTeleport(src, base, walkable, tmp) {
	for (var c = 0; c < 18; c++) {
		var sumE = 0
		var sumO = 0
		for (var dc = -6; dc <= 6; dc++) {
			var sc = c + dc
			if (sc < 0 || sc > 17) continue
			var v = src[sc]
			var e = v & 262143
			var o = v >> 24

			// Parallel expansion: ye = OR of e shifted -5..+5 (sym range incl 0)
			var ye = e | (e << 1) | (e >> 1)        // spread ±1
			ye = ye | (ye << 2) | (ye >> 2)          // spread ±3
			ye = ye | (ye << 2) | (ye >> 2)          // spread ±5
			var diff_e = ye | (e >> 6)               // OR of e shifted -6..+5 (= diff parity e→sumO)
			var same_e = diff_e | (e << 6)           // OR of e shifted -6..+6 (= same parity e→sumE)

			// Same trick for o
			var yo = o | (o << 1) | (o >> 1)
			yo = yo | (yo << 2) | (yo >> 2)
			yo = yo | (yo << 2) | (yo >> 2)
			var diff_o = yo | (o << 6)               // OR of o shifted -5..+6 (= diff parity o→sumE)
			var same_o = diff_o | (o >> 6)           // OR of o shifted -6..+6 (= same parity o→sumO)

			sumE |= same_e
			if (dc <= 5) sumE |= diff_o
			sumO |= same_o
			if (dc >= -5) sumO |= diff_e
		}

		var obst = MAP_OBSTACLES[c]
		var b = base[c]
		var w = walkable[c]
		var oObst = obst >> 24
		var newE = (b & 262143) | (w & 262143) | (sumE & obst)
		var newO = (b >> 24) | (w >> 24) | (sumO & oObst)
		tmp[c] = newE | (newO << 24)
	}
}

// OnlyMaxTeleport: chebyshev = 12 exactly. R=12 even → only same parity contributes.
//   - Edge Δline = ±12 (dc = ±6): full Δpos -6..+6 (incl. 0) → parallel expansion
//   - Non-edge Δline (dc ∈ -5..+5): corners only (Δpos = ±6) → 2 shifts each
function _OnlyMaxTeleport(src, base, tmp) {
	for (var c = 0; c < 18; c++) {
		var sumE = 0
		var sumO = 0

		// Edge dc = -6: full ±6 expansion via parallel trick
		if (c >= 6) {
			var v = src[c - 6]
			var e = v & 262143
			var o = v >> 24
			var ye = e | (e << 1) | (e >> 1)
			ye = ye | (ye << 2) | (ye >> 2)
			ye = ye | (ye << 3) | (ye >> 3)
			sumE |= ye
			var yo = o | (o << 1) | (o >> 1)
			yo = yo | (yo << 2) | (yo >> 2)
			yo = yo | (yo << 3) | (yo >> 3)
			sumO |= yo
		}
		// Edge dc = +6
		if (c <= 11) {
			var v = src[c + 6]
			var e = v & 262143
			var o = v >> 24
			var ye = e | (e << 1) | (e >> 1)
			ye = ye | (ye << 2) | (ye >> 2)
			ye = ye | (ye << 3) | (ye >> 3)
			sumE |= ye
			var yo = o | (o << 1) | (o >> 1)
			yo = yo | (yo << 2) | (yo >> 2)
			yo = yo | (yo << 3) | (yo >> 3)
			sumO |= yo
		}

		// Non-edge dc -5..+5: corners only (Δpos = ±6)
		for (var dc = -5; dc <= 5; dc++) {
			var sc = c + dc
			if (sc < 0 || sc > 17) continue
			var v = src[sc]
			var e = v & 262143
			var o = v >> 24
			sumE |= (e << 6) | (e >> 6)
			sumO |= (o << 6) | (o >> 6)
		}

		var obst = MAP_OBSTACLES[c]
		var b = base[c]
		var newE = (b & 262143) | (sumE & obst)
		var newO = (b >> 24) | (sumO & (obst >> 24))
		tmp[c] = newE | (newO << 24)
	}
}

// === Dispatch wrappers (preserve original API) ===

function WalkOneInACC()   { _WalkOne(ACC,   TMP)   }
function WalkOneInACCJ()  { _WalkOne(ACCJ,  TMPJ)  }
function WalkOneInACCT()  { _WalkOne(ACCT,  TMPT)  }
function WalkOneInACCTJ() { _WalkOne(ACCTJ, TMPTJ) }

function TotalJumpToTMPJFromACC()       { _TotalJump(ACC,  ACCJ,  ACC,  TMPJ)  }
function OnlyMaxJumpToTMPJFromACC()     { _OnlyMaxJump(ACC,  ACCJ,  TMPJ)  }
function TotalJumpToTMPTJFromACCT()     { _TotalJump(ACCT, ACCTJ, ACCT, TMPTJ) }
function OnlyMaxJumpToTMPTJFromACCT()   { _OnlyMaxJump(ACCT, ACCTJ, TMPTJ) }

function TotalTeleportationToTMPTFromACC()      { _TotalTeleport(ACC,  ACCT,  ACC,  TMPT)  }
function OnlyMaxTeleportationToTMPTFromACC()    { _OnlyMaxTeleport(ACC,  ACCT,  TMPT)  }
function TotalTeleportationToTMPTJFromACCJ()    { _TotalTeleport(ACCJ, ACCTJ, ACCJ, TMPTJ) }
function OnlyMaxTeleportationToTMPTJFromACCJ()  { _OnlyMaxTeleport(ACCJ, ACCTJ, TMPTJ) }

// === Save / Update ===
// ACCESMP* are indexed by LINE (35 entries). For a couple c, the diff between TMP[c]
// and ACC[c] is split back into even (line 2c) and odd (line 2c+1) halves.

// Save the diff (TMP ^ ACC) split into even (bits 0-17) and odd (bits 24-40 → 0-16) halves.
// `c << 1` instead of `2 * c` (1 op vs 2). `(c << 1) | 1` instead of `2*c + 1`.
// `(d >> 24)` already has only bits 0-16 since TMP/ACC have no bits >40, so `& 131071` is redundant.

function SaveAccesMpFromTmp(m) {
	for (var c = 0; c < 18; c++) {
		var d = TMP[c] ^ ACC[c]
		var dE = d & 262143
		var c2 = c << 1
		if (dE) ACCESMP[c2][dE] = m
		if (c < 17) {
			var dO = d >> 24
			if (dO) ACCESMP[c2 | 1][dO] = m
		}
	}
}

function SaveAccesMpJFromTmpJ(m) {
	for (var c = 0; c < 18; c++) {
		var d = TMPJ[c] ^ ACCJ[c]
		var dE = d & 262143
		var c2 = c << 1
		if (dE) ACCESMPJ[c2][dE] = m
		if (c < 17) {
			var dO = d >> 24
			if (dO) ACCESMPJ[c2 | 1][dO] = m
		}
	}
}

function SaveAccesMpTFromTmpT(m) {
	for (var c = 0; c < 18; c++) {
		var d = TMPT[c] ^ ACCT[c]
		var dE = d & 262143
		var c2 = c << 1
		if (dE) ACCESMPT[c2][dE] = m
		if (c < 17) {
			var dO = d >> 24
			if (dO) ACCESMPT[c2 | 1][dO] = m
		}
	}
}

function SaveAccesMpTJFromTmpTJ(m) {
	for (var c = 0; c < 18; c++) {
		var d = TMPTJ[c] ^ ACCTJ[c]
		var dE = d & 262143
		var c2 = c << 1
		if (dE) ACCESMPTJ[c2][dE] = m
		if (c < 17) {
			var dO = d >> 24
			if (dO) ACCESMPTJ[c2 | 1][dO] = m
		}
	}
}

function UpdateAccFromTmp()     { for (var c = 0; c < 18; c++) ACC[c]   = TMP[c]   }
function UpdateAccJFromTmpJ()   { for (var c = 0; c < 18; c++) ACCJ[c]  = TMPJ[c]  }
function UpdateAccTFromTmpT()   { for (var c = 0; c < 18; c++) ACCT[c]  = TMPT[c]  }
function UpdateAccTJFromTmpTJ() { for (var c = 0; c < 18; c++) ACCTJ[c] = TMPTJ[c] }

// === BINARY_TO_CELL_BY_LINE: per-line decoding (still 35 entries, indexed by line) ===
global BINARY_TO_CELL_BY_LINE = [
	[BINARY_TO_CELL_ZERO_ZERO, BINARY_TO_CELL_ZERO_ONE, BINARY_TO_CELL_ZERO_TWO],
	[BINARY_TO_CELL_ONE_ZERO, BINARY_TO_CELL_ONE_ONE, BINARY_TO_CELL_ONE_TWO],
	[BINARY_TO_CELL_TWO_ZERO, BINARY_TO_CELL_TWO_ONE, BINARY_TO_CELL_TWO_TWO],
	[BINARY_TO_CELL_THREE_ZERO, BINARY_TO_CELL_THREE_ONE, BINARY_TO_CELL_THREE_TWO],
	[BINARY_TO_CELL_FOUR_ZERO, BINARY_TO_CELL_FOUR_ONE, BINARY_TO_CELL_FOUR_TWO],
	[BINARY_TO_CELL_FIVE_ZERO, BINARY_TO_CELL_FIVE_ONE, BINARY_TO_CELL_FIVE_TWO],
	[BINARY_TO_CELL_SIX_ZERO, BINARY_TO_CELL_SIX_ONE, BINARY_TO_CELL_SIX_TWO],
	[BINARY_TO_CELL_SEVEN_ZERO, BINARY_TO_CELL_SEVEN_ONE, BINARY_TO_CELL_SEVEN_TWO],
	[BINARY_TO_CELL_EIGHT_ZERO, BINARY_TO_CELL_EIGHT_ONE, BINARY_TO_CELL_EIGHT_TWO],
	[BINARY_TO_CELL_NINE_ZERO, BINARY_TO_CELL_NINE_ONE, BINARY_TO_CELL_NINE_TWO],
	[BINARY_TO_CELL_TEN_ZERO, BINARY_TO_CELL_TEN_ONE, BINARY_TO_CELL_TEN_TWO],
	[BINARY_TO_CELL_ELEVEN_ZERO, BINARY_TO_CELL_ELEVEN_ONE, BINARY_TO_CELL_ELEVEN_TWO],
	[BINARY_TO_CELL_TWELVE_ZERO, BINARY_TO_CELL_TWELVE_ONE, BINARY_TO_CELL_TWELVE_TWO],
	[BINARY_TO_CELL_THIRTEEN_ZERO, BINARY_TO_CELL_THIRTEEN_ONE, BINARY_TO_CELL_THIRTEEN_TWO],
	[BINARY_TO_CELL_FOURTEEN_ZERO, BINARY_TO_CELL_FOURTEEN_ONE, BINARY_TO_CELL_FOURTEEN_TWO],
	[BINARY_TO_CELL_FIFTEEN_ZERO, BINARY_TO_CELL_FIFTEEN_ONE, BINARY_TO_CELL_FIFTEEN_TWO],
	[BINARY_TO_CELL_SIXTEEN_ZERO, BINARY_TO_CELL_SIXTEEN_ONE, BINARY_TO_CELL_SIXTEEN_TWO],
	[BINARY_TO_CELL_SEVENTEEN_ZERO, BINARY_TO_CELL_SEVENTEEN_ONE, BINARY_TO_CELL_SEVENTEEN_TWO],
	[BINARY_TO_CELL_EIGHTEEN_ZERO, BINARY_TO_CELL_EIGHTEEN_ONE, BINARY_TO_CELL_EIGHTEEN_TWO],
	[BINARY_TO_CELL_NINETEEN_ZERO, BINARY_TO_CELL_NINETEEN_ONE, BINARY_TO_CELL_NINETEEN_TWO],
	[BINARY_TO_CELL_TWENTY_ZERO, BINARY_TO_CELL_TWENTY_ONE, BINARY_TO_CELL_TWENTY_TWO],
	[BINARY_TO_CELL_TWENTYONE_ZERO, BINARY_TO_CELL_TWENTYONE_ONE, BINARY_TO_CELL_TWENTYONE_TWO],
	[BINARY_TO_CELL_TWENTYTWO_ZERO, BINARY_TO_CELL_TWENTYTWO_ONE, BINARY_TO_CELL_TWENTYTWO_TWO],
	[BINARY_TO_CELL_TWENTYTHREE_ZERO, BINARY_TO_CELL_TWENTYTHREE_ONE, BINARY_TO_CELL_TWENTYTHREE_TWO],
	[BINARY_TO_CELL_TWENTYFOUR_ZERO, BINARY_TO_CELL_TWENTYFOUR_ONE, BINARY_TO_CELL_TWENTYFOUR_TWO],
	[BINARY_TO_CELL_TWENTYFIVE_ZERO, BINARY_TO_CELL_TWENTYFIVE_ONE, BINARY_TO_CELL_TWENTYFIVE_TWO],
	[BINARY_TO_CELL_TWENTYSIX_ZERO, BINARY_TO_CELL_TWENTYSIX_ONE, BINARY_TO_CELL_TWENTYSIX_TWO],
	[BINARY_TO_CELL_TWENTYSEVEN_ZERO, BINARY_TO_CELL_TWENTYSEVEN_ONE, BINARY_TO_CELL_TWENTYSEVEN_TWO],
	[BINARY_TO_CELL_TWENTYEIGHT_ZERO, BINARY_TO_CELL_TWENTYEIGHT_ONE, BINARY_TO_CELL_TWENTYEIGHT_TWO],
	[BINARY_TO_CELL_TWENTYNINE_ZERO, BINARY_TO_CELL_TWENTYNINE_ONE, BINARY_TO_CELL_TWENTYNINE_TWO],
	[BINARY_TO_CELL_THIRTY_ZERO, BINARY_TO_CELL_THIRTY_ONE, BINARY_TO_CELL_THIRTY_TWO],
	[BINARY_TO_CELL_THIRTYONE_ZERO, BINARY_TO_CELL_THIRTYONE_ONE, BINARY_TO_CELL_THIRTYONE_TWO],
	[BINARY_TO_CELL_THIRTYTWO_ZERO, BINARY_TO_CELL_THIRTYTWO_ONE, BINARY_TO_CELL_THIRTYTWO_TWO],
	[BINARY_TO_CELL_THIRTYTHREE_ZERO, BINARY_TO_CELL_THIRTYTHREE_ONE, BINARY_TO_CELL_THIRTYTHREE_TWO],
	[BINARY_TO_CELL_THIRTYFOUR_ZERO, BINARY_TO_CELL_THIRTYFOUR_ONE, BINARY_TO_CELL_THIRTYFOUR_TWO]
]

function _ConvertAccesMpToCells(accesMp, _final) {
	for (var line = 0; line < 35; line++) {
		var parts = BINARY_TO_CELL_BY_LINE[line]
		var p0 = parts[0]
		var p1 = parts[1]
		var p2 = parts[2]
		for (var bin: var mp in accesMp[line]) {
			for (var c in p0[bin & 63] + p1[(bin & 4032) >> 6] + p2[bin >> 12]) {
				_final[c] = mp
			}
		}
	}
}

function getAccess()   { var f = [: ]; _ConvertAccesMpToCells(ACCESMP, f);   return f }
function getAccessJ()  { var f = [: ]; _ConvertAccesMpToCells(ACCESMPJ, f);  return f }
function getAccessT()  { var f = [: ]; _ConvertAccesMpToCells(ACCESMPT, f);  return f }
function getAccessTJ() { var f = [: ]; _ConvertAccesMpToCells(ACCESMPTJ, f); return f }

function getAccesible(mp) {
	SaveBaseAccessibles()
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC()
		SaveAccesMpFromTmp(m)
		UpdateAccFromTmp()
	}
}

function getAccesibleJ(mp) {
	TotalJumpToTMPJFromACC()
	SaveAccesMpJFromTmpJ(0)
	UpdateAccJFromTmpJ()
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC()
		UpdateAccFromTmp()
		WalkOneInACCJ()
		SaveAccesMpJFromTmpJ(m)
		UpdateAccJFromTmpJ()
		OnlyMaxJumpToTMPJFromACC()
		SaveAccesMpJFromTmpJ(m)
		UpdateAccJFromTmpJ()
	}
}

function getAccesibleT(mp) {
	TotalTeleportationToTMPTFromACC()
	SaveAccesMpTFromTmpT(0)
	UpdateAccTFromTmpT()
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC()
		UpdateAccFromTmp()
		WalkOneInACCT()
		SaveAccesMpTFromTmpT(m)
		UpdateAccTFromTmpT()
		OnlyMaxTeleportationToTMPTFromACC()
		SaveAccesMpTFromTmpT(m)
		UpdateAccTFromTmpT()
	}
}

function getAccesibleTJ(mp) {
	TotalTeleportationToTMPTFromACC()
	TotalJumpToTMPJFromACC()
	UpdateAccJFromTmpJ()
	UpdateAccTFromTmpT()
	// IMPORTANT : les deux fonctions ci-dessous écrivent toutes deux dans TMPTJ avec
	// `tmp[c] = base[c] | walkable[c] | (...)`. Sans Save+Update entre les deux,
	// la deuxième écrase la première (jump-then-tele perdu si l'intermédiaire de
	// tele-then-jump est obstacle, et vice versa).
	TotalTeleportationToTMPTJFromACCJ()      // jump puis tele
	SaveAccesMpTJFromTmpTJ(0)
	UpdateAccTJFromTmpTJ()                    // ACCTJ contient maintenant ces cellules
	TotalJumpToTMPTJFromACCT()                // tele puis jump (base = ACCTJ préservé)
	SaveAccesMpTJFromTmpTJ(0)
	UpdateAccTJFromTmpTJ()
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC()
		UpdateAccFromTmp()
		WalkOneInACCT()
		WalkOneInACCJ()
		WalkOneInACCTJ()
		SaveAccesMpTJFromTmpTJ(m)
		UpdateAccTFromTmpT()
		UpdateAccJFromTmpJ()
		UpdateAccTJFromTmpTJ()
		OnlyMaxTeleportationToTMPTFromACC()
		OnlyMaxJumpToTMPJFromACC()
		// Même pattern qu'au step 0 : Save+Update entre les deux écritures TMPTJ.
		OnlyMaxTeleportationToTMPTJFromACCJ()
		SaveAccesMpTJFromTmpTJ(m)
		UpdateAccTJFromTmpTJ()
		OnlyMaxJumpToTMPTJFromACCT()
		SaveAccesMpTJFromTmpTJ(m)
		UpdateAccTFromTmpT()
		UpdateAccJFromTmpJ()
		UpdateAccTJFromTmpTJ()
	}
}
