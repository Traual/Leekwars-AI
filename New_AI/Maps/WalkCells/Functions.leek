/**
 * Walkable cells binary functions file
 **/

include("../../includes.leek")

function CellToLine(cell) { //Used Only In Init
	var couple = floor(cell / 35)
	var c = cell % 35
	var line = c >= 18 ? 1 : 0
	return couple * 2 + line
}

function CellToPos(cell) { //Used Only In Init
	var c = cell % 35
	var line = c >= 18 ? 1 : 0
	return c - (18 * line)
}

function RowColToCell(row, col) {
	var couple = floor(row / 2)
	return couple * 35 + (row % 2 == 1 ? 18 : 0) + col
}

function InitObstacles(Obstacles) { //Pour initialiser la bitmap Obstacles
	if (MAP_OBSTACLES_LOADED) {
		for (var i = 0; i < 35; i++) MAP_OBSTACLES[i] = MAP_OBSTACLES_CACHE[i]
	} else {
		for (var i = 0; i < 35; i++) MAP_OBSTACLES[i] = (i % 2 == 0) ? 262143 : 131071
		for (var x in Obstacles) {
			MAP_OBSTACLES[MAP_CELL_TO_LINE[x]] -= 1 << MAP_CELL_TO_POS[x]
		}
		MAP_OBSTACLES_LOADED = true
		for (var i = 0; i < 35; i++) MAP_OBSTACLES_CACHE[i] = MAP_OBSTACLES[i]
	}
}

function InitLeekCells(LeekCells) { //on met sur la bitmap d'obstacles les positions des entitées
	for (var x in LeekCells) {
		MAP_OBSTACLES[MAP_CELL_TO_LINE[x]] -= 1 << MAP_CELL_TO_POS[x]
	}
}

function InitAccesMp()   { for (var i = 0; i < 35; i++) ACCESMP[i] = [: ] }
function InitAccesMpJ()  { for (var i = 0; i < 35; i++) ACCESMPJ[i] = [: ] }
function InitAccesMpT()  { for (var i = 0; i < 35; i++) ACCESMPT[i] = [: ] }
function InitAccesMpTJ() { for (var i = 0; i < 35; i++) ACCESMPTJ[i] = [: ] }

function InitBuildAcc(cell) {
	for (var i = 0; i < 35; i++) ACC[i] = 0
	ACC[MAP_CELL_TO_LINE[cell]] = 1 << MAP_CELL_TO_POS[cell]
}

function InitBuildAccJ(cell) {
	for (var i = 0; i < 35; i++) { ACC[i] = 0; ACCJ[i] = 0 }
	ACC[MAP_CELL_TO_LINE[cell]] = 1 << MAP_CELL_TO_POS[cell]
}

function InitBuildAccT(cell) {
	for (var i = 0; i < 35; i++) { ACC[i] = 0; ACCT[i] = 0 }
	ACC[MAP_CELL_TO_LINE[cell]] = 1 << MAP_CELL_TO_POS[cell]
}

function InitBuildAccTJ(cell) {
	for (var i = 0; i < 35; i++) { ACC[i] = 0; ACCJ[i] = 0; ACCT[i] = 0; ACCTJ[i] = 0 }
	ACC[MAP_CELL_TO_LINE[cell]] = 1 << MAP_CELL_TO_POS[cell]
}

function SaveBaseAccessibles() {
	for (var i = 0; i < 35; i++) if (ACC[i]) ACCESMP[i][ACC[i]] = 0
}

// ============================================================================
// Templates: 1 template per action type. Each loops over x = 0..34 (target line).
// Bitmap shifts are inline. Parity of x controls direction (even -> source odd
// needs <<1; odd -> source even needs >>1).
// ============================================================================

// WalkOne: chebyshev = 1. Only |Δline|=1 (different parity) contributes.
function _WalkOne(src, tmp) {
	for (var x = 0; x < 35; x++) {
		var sum = 0
		var isEven = (x % 2 == 0)
		if (x > 0) {
			var v = src[x - 1]
			sum |= isEven ? (v | (v << 1)) : (v | (v >> 1))
		}
		if (x < 34) {
			var v = src[x + 1]
			sum |= isEven ? (v | (v << 1)) : (v | (v >> 1))
		}
		tmp[x] = src[x] | (sum & MAP_OBSTACLES[x])
	}
}

// TotalJump: chebyshev ≤ 3 from src. base = already-accessible in target layer (J or TJ),
// walkable = current walkable layer (ACC or ACCT). Result merges all three.
function _TotalJump(src, base, walkable, tmp) {
	for (var x = 0; x < 35; x++) {
		var sum = 0
		var isEven = (x % 2 == 0)
		// Same parity (Δline even = -2, 0, +2): Δpos in -1..+1; skip (s==x, dp=0)
		for (var dl = -2; dl <= 2; dl += 2) {
			var s = x + dl
			if (s < 0 || s > 34) continue
			var v = src[s]
			if (s == x) sum |= (v << 1) | (v >> 1)
			else sum |= (v << 1) | v | (v >> 1)
		}
		// Diff parity (Δline odd = -3, -1, +1, +3): Δpos depends on x parity
		for (var dl = -3; dl <= 3; dl += 2) {
			var s = x + dl
			if (s < 0 || s > 34) continue
			var v = src[s]
			if (isEven) sum |= (v << 2) | (v << 1) | v | (v >> 1)
			else sum |= (v << 1) | v | (v >> 1) | (v >> 2)
		}
		tmp[x] = base[x] | walkable[x] | (sum & MAP_OBSTACLES[x])
	}
}

// OnlyMaxJump: chebyshev = 3 exactly. R=3 odd → only diff parity contributes.
function _OnlyMaxJump(src, base, tmp) {
	for (var x = 0; x < 35; x++) {
		var sum = 0
		var isEven = (x % 2 == 0)
		// Edge Δline = ±3: full diff-parity dp set
		for (var dl = -3; dl <= 3; dl += 6) {
			var s = x + dl
			if (s < 0 || s > 34) continue
			var v = src[s]
			if (isEven) sum |= (v << 2) | (v << 1) | v | (v >> 1)
			else sum |= (v << 1) | v | (v >> 1) | (v >> 2)
		}
		// Not edge Δline = ±1: corners only (|Δx|=R=3)
		for (var dl = -1; dl <= 1; dl += 2) {
			var s = x + dl
			if (s < 0 || s > 34) continue
			var v = src[s]
			if (isEven) sum |= (v << 2) | (v >> 1)
			else sum |= (v << 1) | (v >> 2)
		}
		tmp[x] = base[x] | (sum & MAP_OBSTACLES[x])
	}
}

// TotalTeleport: chebyshev ≤ 12 from src.
function _TotalTeleport(src, base, walkable, tmp) {
	for (var x = 0; x < 35; x++) {
		var sum = 0
		var isEven = (x % 2 == 0)
		// Same parity (Δline even = -12..+12): Δpos -6..+6; skip (s==x, dp=0)
		for (var dl = -12; dl <= 12; dl += 2) {
			var s = x + dl
			if (s < 0 || s > 34) continue
			var v = src[s]
			var f = (v << 6) | (v << 5) | (v << 4) | (v << 3) | (v << 2) | (v << 1) |
				(v >> 1) | (v >> 2) | (v >> 3) | (v >> 4) | (v >> 5) | (v >> 6)
			sum |= (s == x) ? f : (f | v)
		}
		// Diff parity (Δline odd = -11..+11): Δpos -6..+5 (even target) or -5..+6 (odd target)
		for (var dl = -11; dl <= 11; dl += 2) {
			var s = x + dl
			if (s < 0 || s > 34) continue
			var v = src[s]
			if (isEven) {
				sum |= (v << 6) | (v << 5) | (v << 4) | (v << 3) | (v << 2) | (v << 1) | v |
					(v >> 1) | (v >> 2) | (v >> 3) | (v >> 4) | (v >> 5)
			} else {
				sum |= (v << 5) | (v << 4) | (v << 3) | (v << 2) | (v << 1) | v |
					(v >> 1) | (v >> 2) | (v >> 3) | (v >> 4) | (v >> 5) | (v >> 6)
			}
		}
		tmp[x] = base[x] | walkable[x] | (sum & MAP_OBSTACLES[x])
	}
}

// OnlyMaxTeleport: chebyshev = 12 exactly. R=12 even → only same parity contributes.
function _OnlyMaxTeleport(src, base, tmp) {
	for (var x = 0; x < 35; x++) {
		var sum = 0
		// Edge Δline = ±12: full same-parity dp -6..+6
		for (var dl = -12; dl <= 12; dl += 24) {
			var s = x + dl
			if (s < 0 || s > 34) continue
			var v = src[s]
			sum |= (v << 6) | (v << 5) | (v << 4) | (v << 3) | (v << 2) | (v << 1) | v |
				(v >> 1) | (v >> 2) | (v >> 3) | (v >> 4) | (v >> 5) | (v >> 6)
		}
		// Not edge Δline = -10..+10 step 2 (same parity): corners only (dp = ±6)
		for (var dl = -10; dl <= 10; dl += 2) {
			var s = x + dl
			if (s < 0 || s > 34) continue
			var v = src[s]
			sum |= (v << 6) | (v >> 6)
		}
		tmp[x] = base[x] | (sum & MAP_OBSTACLES[x])
	}
}

// === Dispatch wrappers (preserve original API) ===

function WalkOneInACC()   { _WalkOne(ACC,   TMP)   }
function WalkOneInACCJ()  { _WalkOne(ACCJ,  TMPJ)  }
function WalkOneInACCT()  { _WalkOne(ACCT,  TMPT)  }
function WalkOneInACCTJ() { _WalkOne(ACCTJ, TMPTJ) }

function TotalJumpToTMPJFromACC()       { _TotalJump(ACC,  ACCJ,  ACC,  TMPJ)  }
function OnlyMaxJumpToTMPJFromACC()     { _OnlyMaxJump(ACC,  ACCJ,  TMPJ)  }
function TotalJumpToTMPTJFromACCT()     { _TotalJump(ACCT, ACCTJ, ACCT, TMPTJ) }
function OnlyMaxJumpToTMPTJFromACCT()   { _OnlyMaxJump(ACCT, ACCTJ, TMPTJ) }

function TotalTeleportationToTMPTFromACC()      { _TotalTeleport(ACC,  ACCT,  ACC,  TMPT)  }
function OnlyMaxTeleportationToTMPTFromACC()    { _OnlyMaxTeleport(ACC,  ACCT,  TMPT)  }
function TotalTeleportationToTMPTJFromACCJ()    { _TotalTeleport(ACCJ, ACCTJ, ACCJ, TMPTJ) }
function OnlyMaxTeleportationToTMPTJFromACCJ()  { _OnlyMaxTeleport(ACCJ, ACCTJ, TMPTJ) }

// === Save / Update (loops) ===
function SaveAccesMpFromTmp(m)     { for (var i = 0; i < 35; i++) { var d = TMP[i]   ^ ACC[i];   if (d) ACCESMP[i][d]   = m } }
function SaveAccesMpJFromTmpJ(m)   { for (var i = 0; i < 35; i++) { var d = TMPJ[i]  ^ ACCJ[i];  if (d) ACCESMPJ[i][d]  = m } }
function SaveAccesMpTFromTmpT(m)   { for (var i = 0; i < 35; i++) { var d = TMPT[i]  ^ ACCT[i];  if (d) ACCESMPT[i][d]  = m } }
function SaveAccesMpTJFromTmpTJ(m) { for (var i = 0; i < 35; i++) { var d = TMPTJ[i] ^ ACCTJ[i]; if (d) ACCESMPTJ[i][d] = m } }

function UpdateAccFromTmp()     { for (var i = 0; i < 35; i++) ACC[i]   = TMP[i]   }
function UpdateAccJFromTmpJ()   { for (var i = 0; i < 35; i++) ACCJ[i]  = TMPJ[i]  }
function UpdateAccTFromTmpT()   { for (var i = 0; i < 35; i++) ACCT[i]  = TMPT[i]  }
function UpdateAccTJFromTmpTJ() { for (var i = 0; i < 35; i++) ACCTJ[i] = TMPTJ[i] }

// === BINARY_TO_CELL_BY_LINE ===
global BINARY_TO_CELL_BY_LINE = [
	[BINARY_TO_CELL_ZERO_ZERO, BINARY_TO_CELL_ZERO_ONE, BINARY_TO_CELL_ZERO_TWO],
	[BINARY_TO_CELL_ONE_ZERO, BINARY_TO_CELL_ONE_ONE, BINARY_TO_CELL_ONE_TWO],
	[BINARY_TO_CELL_TWO_ZERO, BINARY_TO_CELL_TWO_ONE, BINARY_TO_CELL_TWO_TWO],
	[BINARY_TO_CELL_THREE_ZERO, BINARY_TO_CELL_THREE_ONE, BINARY_TO_CELL_THREE_TWO],
	[BINARY_TO_CELL_FOUR_ZERO, BINARY_TO_CELL_FOUR_ONE, BINARY_TO_CELL_FOUR_TWO],
	[BINARY_TO_CELL_FIVE_ZERO, BINARY_TO_CELL_FIVE_ONE, BINARY_TO_CELL_FIVE_TWO],
	[BINARY_TO_CELL_SIX_ZERO, BINARY_TO_CELL_SIX_ONE, BINARY_TO_CELL_SIX_TWO],
	[BINARY_TO_CELL_SEVEN_ZERO, BINARY_TO_CELL_SEVEN_ONE, BINARY_TO_CELL_SEVEN_TWO],
	[BINARY_TO_CELL_EIGHT_ZERO, BINARY_TO_CELL_EIGHT_ONE, BINARY_TO_CELL_EIGHT_TWO],
	[BINARY_TO_CELL_NINE_ZERO, BINARY_TO_CELL_NINE_ONE, BINARY_TO_CELL_NINE_TWO],
	[BINARY_TO_CELL_TEN_ZERO, BINARY_TO_CELL_TEN_ONE, BINARY_TO_CELL_TEN_TWO],
	[BINARY_TO_CELL_ELEVEN_ZERO, BINARY_TO_CELL_ELEVEN_ONE, BINARY_TO_CELL_ELEVEN_TWO],
	[BINARY_TO_CELL_TWELVE_ZERO, BINARY_TO_CELL_TWELVE_ONE, BINARY_TO_CELL_TWELVE_TWO],
	[BINARY_TO_CELL_THIRTEEN_ZERO, BINARY_TO_CELL_THIRTEEN_ONE, BINARY_TO_CELL_THIRTEEN_TWO],
	[BINARY_TO_CELL_FOURTEEN_ZERO, BINARY_TO_CELL_FOURTEEN_ONE, BINARY_TO_CELL_FOURTEEN_TWO],
	[BINARY_TO_CELL_FIFTEEN_ZERO, BINARY_TO_CELL_FIFTEEN_ONE, BINARY_TO_CELL_FIFTEEN_TWO],
	[BINARY_TO_CELL_SIXTEEN_ZERO, BINARY_TO_CELL_SIXTEEN_ONE, BINARY_TO_CELL_SIXTEEN_TWO],
	[BINARY_TO_CELL_SEVENTEEN_ZERO, BINARY_TO_CELL_SEVENTEEN_ONE, BINARY_TO_CELL_SEVENTEEN_TWO],
	[BINARY_TO_CELL_EIGHTEEN_ZERO, BINARY_TO_CELL_EIGHTEEN_ONE, BINARY_TO_CELL_EIGHTEEN_TWO],
	[BINARY_TO_CELL_NINETEEN_ZERO, BINARY_TO_CELL_NINETEEN_ONE, BINARY_TO_CELL_NINETEEN_TWO],
	[BINARY_TO_CELL_TWENTY_ZERO, BINARY_TO_CELL_TWENTY_ONE, BINARY_TO_CELL_TWENTY_TWO],
	[BINARY_TO_CELL_TWENTYONE_ZERO, BINARY_TO_CELL_TWENTYONE_ONE, BINARY_TO_CELL_TWENTYONE_TWO],
	[BINARY_TO_CELL_TWENTYTWO_ZERO, BINARY_TO_CELL_TWENTYTWO_ONE, BINARY_TO_CELL_TWENTYTWO_TWO],
	[BINARY_TO_CELL_TWENTYTHREE_ZERO, BINARY_TO_CELL_TWENTYTHREE_ONE, BINARY_TO_CELL_TWENTYTHREE_TWO],
	[BINARY_TO_CELL_TWENTYFOUR_ZERO, BINARY_TO_CELL_TWENTYFOUR_ONE, BINARY_TO_CELL_TWENTYFOUR_TWO],
	[BINARY_TO_CELL_TWENTYFIVE_ZERO, BINARY_TO_CELL_TWENTYFIVE_ONE, BINARY_TO_CELL_TWENTYFIVE_TWO],
	[BINARY_TO_CELL_TWENTYSIX_ZERO, BINARY_TO_CELL_TWENTYSIX_ONE, BINARY_TO_CELL_TWENTYSIX_TWO],
	[BINARY_TO_CELL_TWENTYSEVEN_ZERO, BINARY_TO_CELL_TWENTYSEVEN_ONE, BINARY_TO_CELL_TWENTYSEVEN_TWO],
	[BINARY_TO_CELL_TWENTYEIGHT_ZERO, BINARY_TO_CELL_TWENTYEIGHT_ONE, BINARY_TO_CELL_TWENTYEIGHT_TWO],
	[BINARY_TO_CELL_TWENTYNINE_ZERO, BINARY_TO_CELL_TWENTYNINE_ONE, BINARY_TO_CELL_TWENTYNINE_TWO],
	[BINARY_TO_CELL_THIRTY_ZERO, BINARY_TO_CELL_THIRTY_ONE, BINARY_TO_CELL_THIRTY_TWO],
	[BINARY_TO_CELL_THIRTYONE_ZERO, BINARY_TO_CELL_THIRTYONE_ONE, BINARY_TO_CELL_THIRTYONE_TWO],
	[BINARY_TO_CELL_THIRTYTWO_ZERO, BINARY_TO_CELL_THIRTYTWO_ONE, BINARY_TO_CELL_THIRTYTWO_TWO],
	[BINARY_TO_CELL_THIRTYTHREE_ZERO, BINARY_TO_CELL_THIRTYTHREE_ONE, BINARY_TO_CELL_THIRTYTHREE_TWO],
	[BINARY_TO_CELL_THIRTYFOUR_ZERO, BINARY_TO_CELL_THIRTYFOUR_ONE, BINARY_TO_CELL_THIRTYFOUR_TWO]
]

function _ConvertAccesMpToCells(accesMp, _final) {
	for (var line = 0; line < 35; line++) {
		var parts = BINARY_TO_CELL_BY_LINE[line]
		var p0 = parts[0]
		var p1 = parts[1]
		var p2 = parts[2]
		for (var bin: var mp in accesMp[line]) {
			for (var c in p0[bin & 63] + p1[(bin & 4032) >> 6] + p2[bin >> 12]) {
				_final[c] = mp
			}
		}
	}
}

function getAccess()   { var f = [: ]; _ConvertAccesMpToCells(ACCESMP, f);   return f }
function getAccessJ()  { var f = [: ]; _ConvertAccesMpToCells(ACCESMPJ, f);  return f }
function getAccessT()  { var f = [: ]; _ConvertAccesMpToCells(ACCESMPT, f);  return f }
function getAccessTJ() { var f = [: ]; _ConvertAccesMpToCells(ACCESMPTJ, f); return f }

function getAccesible(mp) {
	SaveBaseAccessibles()
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC()
		SaveAccesMpFromTmp(m)
		UpdateAccFromTmp()
	}
}

function getAccesibleJ(mp) {
	TotalJumpToTMPJFromACC()
	SaveAccesMpJFromTmpJ(0)
	UpdateAccJFromTmpJ()
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC()
		UpdateAccFromTmp()
		WalkOneInACCJ()
		SaveAccesMpJFromTmpJ(m)
		UpdateAccJFromTmpJ()
		OnlyMaxJumpToTMPJFromACC()
		SaveAccesMpJFromTmpJ(m)
		UpdateAccJFromTmpJ()
	}
}

function getAccesibleT(mp) {
	TotalTeleportationToTMPTFromACC()
	SaveAccesMpTFromTmpT(0)
	UpdateAccTFromTmpT()
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC()
		UpdateAccFromTmp()
		WalkOneInACCT()
		SaveAccesMpTFromTmpT(m)
		UpdateAccTFromTmpT()
		OnlyMaxTeleportationToTMPTFromACC()
		SaveAccesMpTFromTmpT(m)
		UpdateAccTFromTmpT()
	}
}

function getAccesibleTJ(mp) {
	TotalTeleportationToTMPTFromACC()
	TotalJumpToTMPJFromACC()
	UpdateAccJFromTmpJ()
	UpdateAccTFromTmpT()
	TotalTeleportationToTMPTJFromACCJ()
	TotalJumpToTMPTJFromACCT()
	SaveAccesMpTJFromTmpTJ(0)
	UpdateAccTJFromTmpTJ()
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC()
		UpdateAccFromTmp()
		WalkOneInACCT()
		WalkOneInACCJ()
		WalkOneInACCTJ()
		SaveAccesMpTJFromTmpTJ(m)
		UpdateAccTFromTmpT()
		UpdateAccJFromTmpJ()
		UpdateAccTJFromTmpTJ()
		OnlyMaxTeleportationToTMPTFromACC()
		OnlyMaxJumpToTMPJFromACC()
		OnlyMaxTeleportationToTMPTJFromACCJ()
		OnlyMaxJumpToTMPTJFromACCT()
		SaveAccesMpTJFromTmpTJ(m)
		UpdateAccTFromTmpT()
		UpdateAccJFromTmpJ()
		UpdateAccTJFromTmpTJ()
	}
}
