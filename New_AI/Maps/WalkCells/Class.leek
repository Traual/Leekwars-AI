/**
 * WalkCells API
 *
 * Public surface :
 *   - WalkCellsClass.getWalk / getJump / getTele / getTPJ   : per-layer fetchers (cache-or-compute)
 *   - WalkCellsClass.canJump / canTele / canTPJ             : capacity checks
 *   - WalkCellsClass.getMaxLayer(state, e, bh)              : returns the maximal reachability map
 *                                                              (TPJ > TELE > JUMP > WALK). Use when
 *                                                              the caller only needs ".MAX".
 *   - WalkCellsClass.getMaxWalkOrJump(state, e, bh)         : maximal map ignoring teleport. Used
 *                                                              for enemy danger evaluation.
 *   - WalkCellsClass.getAllLayers(state, e, bh)             : returns a LayersClass with the four
 *                                                              layers + .MAX. Use when the caller
 *                                                              needs to know which layer each cell
 *                                                              belongs to (BFS, Node, MoveTo).
 *
 * All fetchers reuse the existing caches (WALKABLE_CACHE / JUMP_CACHE / TELEPORTATION_CACHE /
 * TELEPORTATION_AND_JUMP_CACHE), keyed by HashWalkCells(cell, mp, base_hash).
**/

include("../../includes.leek")

/**
 * Container for the four reachability layers + the max layer. Returned by getAllLayers.
 * Each layer is a Map<cell : mp_cost>. Disabled layers are [:] (empty map).
 */
class LayersClass {
	WALK
	JUMP
	TELEPORTATION
	TELEPORTATION_AND_JUMP
	MAX
	constructor(w, j, t, tj, m) {
		this.WALK = w
		this.JUMP = j
		this.TELEPORTATION = t
		this.TELEPORTATION_AND_JUMP = tj
		this.MAX = m
	}
}

class WalkCellsClass {

	// ============================================================================
	// Capacity checks
	// ============================================================================

	static canJump(stats) {
		var cd = stats.COOLDOWNS[CHIP_JUMP]
		return (cd == 0 || (stats.ID != Me && cd <= 1)) && stats.TP >= ITEMINFO[CHIP_JUMP].COST
	}

	static canTele(stats) {
		var cd = stats.COOLDOWNS[CHIP_TELEPORTATION]
		return (cd == 0 || (stats.ID != Me && cd <= 1)) && stats.TP >= ITEMINFO[CHIP_TELEPORTATION].COST
	}

	static canTPJ(stats) {
		return canJump(stats) && canTele(stats)
			&& stats.TP >= ITEMINFO[CHIP_JUMP].COST + ITEMINFO[CHIP_TELEPORTATION].COST
	}

	// ============================================================================
	// Per-layer fetchers : cache lookup, compute on miss, store and return.
	// ============================================================================

	static getWalk(state, entity, base_hash) {
		var stats = state[entity]
		var hashWalk = HashWalkCells(stats.CELL, stats.MP, base_hash)
		if (hashWalk in WALKABLE_CACHE) return WALKABLE_CACHE[hashWalk]
		var r = WalkableCells(stats.CELL, LoadIgnoreCells(state, entity, base_hash), stats.MP)
		WALKABLE_CACHE[hashWalk] = r
		return r
	}

	static getJump(state, entity, base_hash) {
		var stats = state[entity]
		var hashWalk = HashWalkCells(stats.CELL, stats.MP, base_hash)
		if (hashWalk in JUMP_CACHE) return JUMP_CACHE[hashWalk]
		var r = WalkableCellsWithJump(stats.CELL, LoadIgnoreCells(state, entity, base_hash), stats.MP)
		JUMP_CACHE[hashWalk] = r
		return r
	}

	static getTele(state, entity, base_hash) {
		var stats = state[entity]
		var hashWalk = HashWalkCells(stats.CELL, stats.MP, base_hash)
		if (hashWalk in TELEPORTATION_CACHE) return TELEPORTATION_CACHE[hashWalk]
		var r = WalkableCellsWithTeleportation(stats.CELL, LoadIgnoreCells(state, entity, base_hash), stats.MP)
		TELEPORTATION_CACHE[hashWalk] = r
		return r
	}

	static getTPJ(state, entity, base_hash) {
		var stats = state[entity]
		var hashWalk = HashWalkCells(stats.CELL, stats.MP, base_hash)
		if (hashWalk in TELEPORTATION_AND_JUMP_CACHE) return TELEPORTATION_AND_JUMP_CACHE[hashWalk]
		var r = WalkableCellsWithTeleportationAndJump(stats.CELL, LoadIgnoreCells(state, entity, base_hash), stats.MP)
		TELEPORTATION_AND_JUMP_CACHE[hashWalk] = r
		return r
	}

	// ============================================================================
	// Composeurs : pick the right fetcher(s) based on capacities.
	// ============================================================================

	/**
	 * Returns the maximal reachability map (TPJ > TELE > JUMP > WALK).
	 * Use when the caller only needs the set of reachable cells, regardless of layer.
	 */
	static getMaxLayer(state, entity, base_hash) {
		BenchOps.Start("WalkCells")
		var stats = state[entity]
		var r
		if (canTPJ(stats))       r = getTPJ(state, entity, base_hash)
		else if (canTele(stats)) r = getTele(state, entity, base_hash)
		else if (canJump(stats)) r = getJump(state, entity, base_hash)
		else                     r = getWalk(state, entity, base_hash)
		BenchOps.Stop("WalkCells")
		return r
	}

	/**
	 * Returns the maximal reachability map between Walk and Jump (no teleport).
	 * Used for enemy danger evaluation: we don't model their teleport for cost reasons.
	 */
	static getMaxWalkOrJump(state, entity, base_hash) {
		BenchOps.Start("WalkCells")
		var r = canJump(state[entity])
			? getJump(state, entity, base_hash)
			: getWalk(state, entity, base_hash)
		BenchOps.Stop("WalkCells")
		return r
	}

	/**
	 * Returns all four layers + .MAX in a LayersClass instance.
	 * Use when the caller needs to know which layer each cell belongs to
	 * (BFS for action cost, Node for cost+cooldown, MoveTo for runtime routing).
	 */
	static getAllLayers(state, entity, base_hash) {
		BenchOps.Start("WalkCells")
		var stats = state[entity]
		var cJ = canJump(stats)
		var cT = canTele(stats)
		var cTJ = cJ && cT && stats.TP >= ITEMINFO[CHIP_JUMP].COST + ITEMINFO[CHIP_TELEPORTATION].COST
		var walk = getWalk(state, entity, base_hash)
		var jump = cJ  ? getJump(state, entity, base_hash) : [:]
		var tele = cT  ? getTele(state, entity, base_hash) : [:]
		var tpj  = cTJ ? getTPJ(state, entity, base_hash)  : [:]
		var max  = cTJ ? tpj : (cT ? tele : (cJ ? jump : walk))
		var result = new LayersClass(walk, jump, tele, tpj, max)
		BenchOps.Stop("WalkCells")
		return result
	}

	// ============================================================================
	// Hashing helpers
	// ============================================================================

	static HashWalkCells(Cell, Mp, BaseHash) {
		return addValueToBinHash((OFFSET_BASIS ^ BaseHash), (Cell << 32) | Mp) // hash of (Cell, Mp) under BaseHash
	}

	// Very specific function of hashing teleportation items and cell/mp of entity but /!\ doesn't take basehash into account /!\
	static HashWalkCellsWithItemsWithoutBaseHash(entity_state) {
		var Entity = entity_state.ID
		var Tp = entity_state.TP
		var EntityCooldowns = entity_state.COOLDOWNS
		var JumpCooldown = EntityCooldowns[CHIP_JUMP]
		var JumpCost = ITEMINFO[CHIP_JUMP].COST
		var TeleportationCooldown = EntityCooldowns[CHIP_TELEPORTATION]
		var TeleportationCost = ITEMINFO[CHIP_TELEPORTATION].COST
		var CanJump = (JumpCooldown == 0 || Entity != Me && JumpCooldown <= 1) && Tp >= JumpCost
		var CanTeleport = (TeleportationCooldown == 0 || Entity != Me && TeleportationCooldown <= 1) && Tp >= TeleportationCost
		var BaseValue = CanJump ?
						CanTeleport ? 4 : 2 :
						CanTeleport ? 3 : 1
		return addValueToBinHash((OFFSET_BASIS ^ BaseValue), (entity_state.CELL << 32) | entity_state.MP)
	}

	// ============================================================================
	// Sorting / coefficient helpers (consumed by Actions module)
	// ============================================================================

	static LoadSortedWalkCells(layers) {
		var TmpArray = []
		var TmpMapScoring = [: ]
		var Walk = layers.WALK
		var Jump = layers.JUMP
		var Tele = layers.TELEPORTATION
		var TeleAndJump = layers.TELEPORTATION_AND_JUMP
		for (var c:var mp in layers.MAX) {
			push(TmpArray, c)
			TmpMapScoring[c] = (c in Walk) ? Walk[c] :
            			 		(c in Jump) ? Jump[c] + 100 :
            			 		(c in Tele) ? Tele[c] + 1000 :
            			 		TeleAndJump[c] + 10000
		}
		return arraySort(TmpArray, function(a, b) {
			return TmpMapScoring[a] - TmpMapScoring[b]
		})
	}

	//Soon Obselete :
	static LoadCoeffedCellsFromWalkCellsClass(layers) {//Used for Action Map Loading (Should i walk or jump and save mp ...) No need to cache cuz its already cached only by BaseHash in Action Map
		var _final = [: ]
		var Walk = layers.WALK
		var Jump = layers.JUMP
		var Tele = layers.TELEPORTATION
		var TeleAndJump = layers.TELEPORTATION_AND_JUMP
		for (var c:var mp in layers.MAX) {
			if (c in Walk) {
				_final[c] = Walk[c]
			} else if (c in Jump) {
				_final[c] = Jump[c] + 100
			} else if (c in Tele) {
				_final[c] = Tele[c] + 1000
			} else if (c in TeleAndJump) {
				_final[c] = TeleAndJump[c] + 10000
			}
		}
		return _final
	}

	// ============================================================================
	// Runtime helpers (executed once per turn at action emission time)
	// ============================================================================

	static MoveTo(cell, State, BaseHash) {
		var layers = WalkCellsClass.getAllLayers(State, Me, BaseHash)
		var ActionsToGet = getActionsToGet(State[Me].CELL, cell, layers.TELEPORTATION_AND_JUMP, layers.TELEPORTATION, layers.JUMP, layers.WALK)
		for (var Action in ActionsToGet) {
			moveTowardCell(Action.From)
			useChipOnCell(Action.Item, Action.To)
		}
		moveTowardCell(cell)
	}

	static getActionsToGet(from, to, AccesMpTeleportationAndJump, AccesMpTeleportation, AccesMpJump, AccesMpWalk) {

		// shortcut references
		var maps = [
			"walk": AccesMpWalk,
			"jump": AccesMpJump,
			"tp":   AccesMpTeleportation,
			"tpJump": AccesMpTeleportationAndJump
		]

		// downgrade capabilities per layer
		var downgrade = [
			"tpJump": ['jump', 'tp'],
			"tp":     ['tp'],
			"jump":   ['jump']
		]

		var cur = to
		var actions = []

		// determine current layer
		var layer = null
		if (cur in maps["walk"]) layer = 'walk'
		else if (cur in maps["jump"]) layer = 'jump'
		else if (cur in maps["tp"]) layer = 'tp'
		else if (cur in maps["tpJump"]) layer = 'tpJump'

		while (true) {

			if (!layer) {
				debug(cur+" isn't reachable")
				break
			}

			// once we're in walk-only layer, stop: walking handled separately
			if (layer == 'walk') {
				break
			}

			var progressed = false
			var curCost = maps[layer][cur]

			// 1) try each downgrade ability in order
			for (var ability in downgrade[layer]) {
				// compute neighbours for this ability
				var neighs
				if (ability == 'jump') {
					neighs = ALLCELLINFO[cur].CIRCLE_THREE_DIST
				} else { // ability == 'tp'
					var tpInfo = ITEMINFO[CHIP_TELEPORTATION]
					neighs = CellClass.getDisc(cur, tpInfo.MINRANGE, tpInfo.MAXRANGE)
				}

				// compute next layer after using this ability
				var nextLayer = (layer == 'tpJump')
					? (ability == 'jump' ? 'tp' : 'jump')
					: 'walk'
				var nextCosts = maps[nextLayer]

				// look for a valid landing cell
				for (var neigh:var dist in neighs) {
					if (neigh in nextCosts && nextCosts[neigh] <= curCost) {
						// prepend action
						var chip = (ability == 'jump' ? CHIP_JUMP : CHIP_TELEPORTATION)
						unshift(actions, new ActionClass(chip, neigh, cur))
						cur = neigh
						progressed = true
						layer = nextLayer
						break
					}
				}
				if (progressed) break
			}
			if (progressed) continue

			// 2) fallback: walk one step in same layer (no Action recorded here)
			for (var neigh:var dist in ALLCELLINFO[cur].CIRCLE_ONE_DIST) {
				if (neigh in maps[layer] && maps[layer][neigh] < curCost) {
					cur = neigh
					progressed = true
					break
				}
			}
			if (progressed) continue;

			// 3) no way forward
			debug("Cannot find path from "+from+" to "+to)
			break
		}

		// now cur ∈ AccesMpWalk: caller should walk from 'from' to 'cur' automatically
		return actions
	}

	// ============================================================================
	// Low-level wrappers around the bitmap BFS in Functions.leek
	// ============================================================================

	// Fast-path: bench-validated optimized BFS (~3-4× fewer ops vs legacy pipeline).
	// Each function clones MAP_OBSTACLES_CACHE (obstacle-only baseline, populated
	// once in Preload.InitCellClass) and subtracts `leekcells` locally — no global
	// pollution, no setup ceremony.
	static WalkableCells(from, leekcells, mp) {
		return _FastWalkableCells(from, leekcells, mp)
	}

	static WalkableCellsWithJump(from, leekcells, mp) {
		return _FastWalkableCellsWithJump(from, leekcells, mp)
	}

	static WalkableCellsWithTeleportation(from, leekcells, mp) {
		return _FastWalkableCellsWithTeleportation(from, leekcells, mp)
	}

	static WalkableCellsWithTeleportationAndJump(from, leekcells, mp) {
		return _FastWalkableCellsWithTeleportationAndJump(from, leekcells, mp)
	}

	static LoadIgnoreCells(EveryStats, EntityToBeIgnored, BaseHash) {
		var Hash = addValueToBinHash(OFFSET_BASIS ^ BaseHash, EntityToBeIgnored)
		if (Hash in IGNORE_CELLLS_CACHE) return IGNORE_CELLLS_CACHE[Hash]
		var _final = []
		for (var e: var stat in EveryStats) {
			if (stat.LIFE > 0 && e != EntityToBeIgnored) push(_final, stat.CELL)
		}
		IGNORE_CELLLS_CACHE[Hash] = _final
		return _final
	}
}
