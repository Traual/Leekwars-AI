/*
 * Danger map : les dégâts que chaque caster adverse peut poser sur une cible à une cellule
 * donnée (meilleur combo, déplacement + vulnés compris).
 */

include("../../includes.leek")

// ==================== DIAGNOSTIC TEMPORAIRE Bitmap — À RETIRER (revert) ====================
// Chasse la divergence de première décision de PacificRose (elevation -> fortress) : compare
// la géométrie Bitmap à la géométrie LEGACY (code exact de 6264491) sur chaque miss du cache
// FULL, pour PacificRose seulement. Un seul rejeu du même seed suffit.
global DIAG_BITMAP_MISMATCH_LOGGED = false   // premier écart de CONTENU seulement
global DIAG_BITMAP_ORDER_LOGGED = false      // posé SEULEMENT quand un ordre différent est trouvé
global DIAG_BITMAP_STARTED = false           // log unique de démarrage (ne désactive rien)
global DIAG_BITMAP_RETURN_LEGACY = false     // test d'isolation : servir la legacy (Bitmap construite quand même)
// ===========================================================================================

class DangerClass {
	// La chaîne de vulnés ne fait bouger que les DEUX shields (scalaires) — plus aucun
	// snapshot d'EntityState transporté. LIFE/SIDE/IS_SUMMON/Antidote restent lus sur la
	// cible originale, jamais mutée.
	EndAbsoluteShield
	EndRelativeShield
	EndTp
	EndUses
	EndValueDamage
	constructor(TmpAbs, TmpRel, TmpTp, TmpUses, TmpValueDamage) {
		this.EndAbsoluteShield = TmpAbs
		this.EndRelativeShield = TmpRel
		this.EndTp = TmpTp
		this.EndUses = TmpUses
		this.EndValueDamage = TmpValueDamage
	}

	/*
	 * Danger par caster qu'une entité prend À SA CELLULE COURANTE. Uniforme pour toutes les
	 * entités — la recherche de fuite de Me vit dans DeltaClass.minDeltaForMe, pas ici.
	 * Clé + hit HORS fenêtre BenchOps : le bucket "Danger" ne profile que les miss.
	 *
	 * @param entity_state stats de la cible
	 * @param state [id -> stats]
	 * @param entity_id id de la cible
	 * @param base_hash hash (id, cellule) des vivants
	 * @param thisStatsHashForDanger graine de la cible (contexte adverse + ses shields) — clé
	 * @return [casterId -> dégâts] à la cellule de la cible
	 */
	static getEntityDanger(entity_state, state, entity_id, base_hash, thisStatsHashForDanger) {
		// (id << 10 | cellule) — l'ID est OBLIGATOIRE : CastersInOrder pivote sur la cible,
		// deux cibles de même camp aux mêmes shields/cellule peuvent avoir un ordre
		// d'attaquants différent (la chaîne de vulnés en dépend). Pack injectif, cellule 10 bits.
		var Hash = addValueToBinHash(OFFSET_BASIS ^ thisStatsHashForDanger, (entity_id << 10) | entity_state.CELL)
		if (Hash in ENTITY_DANGER_CACHE_FOR_OTHERS) return ENTITY_DANGER_CACHE_FOR_OTHERS[Hash]
		BenchOps.Start("Danger")
		// Me est déjà dans la map d'EntitiesToSkip (source unique) : lecture directe,
		// sans clone ni patch local — la map cachée reste read-only.
		var thisToSkipMap = DangerClass.EntitiesToSkip(entity_state, state, base_hash)
		var thisEnemiesWalkableCellsMap = LoadEnemiesWalkableCellsMap(state, entity_id, thisToSkipMap, base_hash, thisStatsHashForDanger)
		var thisCastersInOrder = StateClass.getEntitiesInTurnOrderAfterEntity(state, entity_state.ID)
		var tmp = DangerClass.get(entity_state.CELL, state, entity_state, thisEnemiesWalkableCellsMap, thisToSkipMap, thisStatsHashForDanger, thisCastersInOrder)
		ENTITY_DANGER_CACHE_FOR_OTHERS[Hash] = tmp
		BenchOps.Stop("Danger")
		return tmp
	}

	/*
	 * [casterId -> walkcells] des casters menaçant une cible.
	 * statsHash dans la clé : un shackle MP/TP simulé en branche change la mobilité d'un
	 * caster sans toucher base_hash — sans lui, le cache servirait les walkcells d'avant
	 * shackle tout le tour. Le réassemblage au miss est bon marché (les maps NoEnt par
	 * caster restent cachées tout le combat par (cellule, mp)).
	 *
	 * @param toSkipMap [id -> true] des entités à ne pas charger
	 */
	static LoadEnemiesWalkableCellsMap(state, entity_id, toSkipMap, base_hash, statsHash) {
		var ThisHash = addValueToBinHash((OFFSET_BASIS ^ base_hash ^ statsHash), entity_id)
		if (ThisHash in EVERY_ENEMIES_WALKABLES) return EVERY_ENEMIES_WALKABLES[ThisHash]
		var EnemiesWalkCells = [: ]
		for (var e: var stat in state) {
			if (e in toSkipMap) continue
			// Walkcells "NoEntities" : les entités ne comptent pas comme obstacles.
			// Approximation acceptée contre un cache persistant tout le combat.
			EnemiesWalkCells[e] = WalkCellsClass.getMaxWalkOrJumpNoEntitiesFull(stat)
		}
		EVERY_ENEMIES_WALKABLES[ThisHash] = EnemiesWalkCells
		return EnemiesWalkCells
	}

	/*
	 * Danger par caster sur UNE cellule : pour chaque caster adverse (en ordre de tour), son
	 * meilleur combo contre la cible telle que les casters PRÉCÉDENTS l'ont laissée — les
	 * vulnés d'un caster amplifient les suivants (chaîne cross-casters).
	 * chainTarget n'est JAMAIS muté en place (la machinerie de combo clone avant d'écrire) ;
	 * les endStates viennent du cache de combo — READ-ONLY par contrat.
	 *
	 * @return [casterId -> dégâts]
	 */
	static get(Cell, State, TargetStats, EnemyWalkCells, ToSkipMap, StatsHashForDanger, CastersInOrder) {
		// (id << 10 | cellule) : même raison que getEntityDanger — l'ordre des casters (donc
		// la chaîne de vulnés) dépend de l'IDENTITÉ de la cible, pas que de ses stats.
		var ThisHash = addValueToBinHash((OFFSET_BASIS ^ StatsHashForDanger), (TargetStats.ID << 10) | Cell)
		if (ThisHash in CELL_DANGER_GET_CACHE) return CELL_DANGER_GET_CACHE[ThisHash]
		var _final = [: ]   // par caster, pas sommé : le net séquence par ordre de tour
		// La cible n'est jamais mutée : seuls ses deux shields COURANTS évoluent le long de la
		// chaîne, en scalaires. TargetStats reste lu en métadonnées (LIFE/SIDE/type/Antidote).
		var chainAbs = TargetStats.ABSOLUTE_SHIELD
		var chainRel = TargetStats.RELATIVE_SHIELD
		for (var Caster in CastersInOrder) {
			if (Caster in ToSkipMap) continue
			var CasterStats = State[Caster]
			var MapCellItemAoe = getMapCellItemAoe(CasterStats, EnemyWalkCells[Caster])
			// Caster incapable d'atteindre cette cellule : aucun combo ni map vide alloués.
			if (!(Cell in MapCellItemAoe)) continue
			var combo = getComboFromItemAoe(MapCellItemAoe[Cell], CasterStats, TargetStats, chainAbs, chainRel)
			if (combo[0] > 0) {
				// Le crit est appliqué EN PROFONDEUR (getItemDanger avant les shields + vulnés
				// de chaîne critées), pas ici : (d − ABS)·1.3 ≠ d·1.3 − ABS.
				_final[Caster] = combo[0]
				chainAbs = combo[1]   // le caster suivant voit les shields post-vulné/debuff
				chainRel = combo[2]
			}
		}
		CELL_DANGER_GET_CACHE[ThisHash] = _final
		return _final
	}

	/*
	 * Facteur de crit binaire asymétrique d'un caster (doctrine dans Constants) : un caster
	 * ADVERSE est craint critique dès MIN_AGILITY_ENEMY_CRIT, un allié n'est crédité qu'à
	 * partir de MIN_AGILITY_TO_FULLY_CRIT (on ne compte pas sur sa chance).
	 */
	static critFactorOf(CasterStats) {
		var critAt = (CasterStats.SIDE != getSide(Me)) ? MIN_AGILITY_ENEMY_CRIT : MIN_AGILITY_TO_FULLY_CRIT
		return (CasterStats.AGILITY >= critAt) ? CRITICAL_FACTOR : 1
	}

	/*
	 * Meilleur combo d'un caster sur la cible, vulnés comprises (essaie chaque item de vulné
	 * en premier tant que ça améliore les dégâts).
	 *
	 * @param ItemAoeMap [item -> minAoeDist] des items qui atteignent la cellule
	 * @param TargetStats métadonnées de la cible (LIFE/SIDE/IS_SUMMON/Antidote) — JAMAIS muté
	 * @param curAbs/curRel shields COURANTS de la cible (scalaires portés par la chaîne)
	 * @return l'ENTRÉE de cache [dégâtsCombo, absFinal, relFinal] — que des scalaires, aucune
	 *         référence vers une entité du State ni du workspace transactionnel.
	 */
	static getComboFromItemAoe(ItemAoeMap, CasterStats, TargetStats, curAbs, curRel) {
		if (mapIsEmpty(ItemAoeMap)) return [0, curAbs, curRel]
		var HashedItemAoeMap = getHashFromItemAoeMap(ItemAoeMap)
		var HashWithShield = getStatsHashForDangerOneCaster(TargetStats, CasterStats, HashedItemAoeMap, curAbs, curRel)
		if (HashWithShield in COMBO_FROM_ITEM_AOE_CACHE) return COMBO_FROM_ITEM_AOE_CACHE[HashWithShield]
		// TOTAL_TP : le danger représente le potentiel max du prochain tour, pas les TP
		// restants de ce tour — stable d'un step de BFS à l'autre.
		var BaseTp = CasterStats.TOTAL_TP
		var BaseUses = StateClass.rootUsesMap(CasterStats)   // caster jamais Me -> map complète
		var _final = getGreedyComboFromItemAoe(ItemAoeMap, CasterStats, TargetStats, BaseTp, BaseUses, curAbs, curRel)
		var ComboWithVulne = getFirstComboVulneFrom(ItemAoeMap, CasterStats, TargetStats, BaseTp, BaseUses, curAbs, curRel)
		while ((ComboWithVulne instanceof DangerClass) && (ComboWithVulne.EndValueDamage > _final)) {
			_final = ComboWithVulne.EndValueDamage
			curAbs = ComboWithVulne.EndAbsoluteShield
			curRel = ComboWithVulne.EndRelativeShield
			BaseUses = ComboWithVulne.EndUses
			BaseTp = ComboWithVulne.EndTp
			ComboWithVulne = getFirstComboVulneFrom(ItemAoeMap, CasterStats, TargetStats, BaseTp, BaseUses, curAbs, curRel)
		}
		// Entrée en SCALAIRES : le cache ne retient plus aucune référence vers une entité,
		// donc plus rien à figer par un clone (sans vulné jouée, on stocke les shields
		// d'entrée tels quels).
		var entry = [_final, curAbs, curRel]
		COMBO_FROM_ITEM_AOE_CACHE[HashWithShield] = entry
		return entry
	}

	/* Hash de contenu d'une map [item -> dist] : chaîne rotate-XOR, entrée (item 9 bits | dist 4 bits). */
	static getHashFromItemAoeMap(ItemAoeMap) {
		var Hash_Final = 0
		for (var item: var dist in ItemAoeMap) {
			Hash_Final = addValueToBinHash(Hash_Final, (item << 4) | dist)
		}
		return Hash_Final
	}

	/*
	 * Meilleur item de vulné jouable en premier : renvoie le DangerClass (état/TP/uses/dégâts
	 * après vulné + combo) du plus rentable, ou null si aucun.
	 */
	static getFirstComboVulneFrom(ItemAoeMap, CasterStats, TargetStats, BaseTp, BaseUses, curAbs, curRel) {
		var MaxDamages = 0
		var _final
		for (var item: var aoe in ItemAoeMap) {
			var Infos = ITEMINFO[item]
			if (BaseUses[item] < Infos.MAX_USES && BaseTp >= Infos.COST && Infos.IS_VULNERABILITY) {
				var CDangerClass = getCellDangerClassFromItem(TargetStats, Infos, BaseTp, BaseUses, ItemAoeMap, CasterStats, item, curAbs, curRel)
				var Damages = CDangerClass.EndValueDamage
				if (MaxDamages < Damages) {
					MaxDamages = Damages
					_final = CDangerClass
				}
			}
		}
		return _final
	}

	/*
	 * Hash du danger d'UN caster sur la cible : items atteignables + shields/antidote de la
	 * cible + stats offensives du caster. Shields masqués à leur slot (une vulné est un shield
	 * négatif : non masqué, le signe absorberait les champs hauts) ; antidote 99 = pas de chip,
	 * distinct de prêt (0) ; stats du caster clampées à 0 (le moteur plancher à l'usage).
	 */
	static getStatsHashForDangerOneCaster(TargetStats, CasterStats, TmpHash, curAbs, curRel) {
		var hash_value = (OFFSET_BASIS ^ TmpHash)

		var effAntidoteCdTar = StateClass.cooldownOf(TargetStats, CHIP_ANTIDOTE)
		var antidoteCdTar = (effAntidoteCdTar == null) ? 99 : effAntidoteCdTar
		// Bit 50 = type de la cible (poireau/summon) : les masques NON_SUMMONS/SUMMONS
		// changent les effets applicables — l'ID reste HORS clé exprès, deux cibles de même
		// type et mêmes shields partagent leur combo (LIFE lue seulement > 0, SIDE toujours
		// ennemi du caster dans cette machinerie : constants, pas des inputs). Les shields
		// sont ceux COURANTS de la chaîne (scalaires), pas l'objet cible.
		var Mycombined = ((TargetStats.IS_SUMMON ? 1 : 0) << 50) | ((curAbs & 0xFFFFF) << 30) | ((curRel & 0x7FFF) << 15) | antidoteCdTar
		hash_value = addValueToBinHash(hash_value, Mycombined)

		// TOTAL_TP : potentiel max du prochain tour, comme le contexte de statsHashFor.
		// Bit 62 = classe de crit du caster (les valeurs de combo et les vulnés en dépendent).
		var critBit = (critFactorOf(CasterStats) > 1) ? 1 : 0
		var Hiscombined = (critBit << 62) | (max(0, CasterStats.STRENGTH) << 45) | (max(0, CasterStats.MAGIC) << 30) | (max(0, CasterStats.TOTAL_TP) << 15) | CasterStats.POWER
		hash_value = addValueToBinHash(hash_value, Hiscombined)

		return hash_value
	}

	/* Deux shields finaux / TP / uses / dégâts après avoir joué cet item de vulné puis le
	 * meilleur combo derrière. Le clone de BaseUses reste (comptabilité d'uses de la vulné),
	 * mais la cible n'est plus jamais clonée : ses deux shields sont des scalaires. */
	static getCellDangerClassFromItem(TargetStats, Infos, BaseTp, BaseUses, ItemAoeMap, CasterStats, Item, curAbs, curRel) {
		var ThisTp = BaseTp - Infos.COST
		var ThisUses = clone(BaseUses)
		var newShields = getRoughVulneConsequences(TargetStats, curAbs, curRel, Infos, critFactorOf(CasterStats), CasterStats)
		ThisUses[Item]++
		var DamagesWithThisItemVulne = getGreedyComboFromItemAoe(ItemAoeMap, CasterStats, TargetStats, ThisTp, ThisUses, newShields[0], newShields[1])
		return new DangerClass(newShields[0], newShields[1], ThisTp, ThisUses, DamagesWithThisItemVulne)
	}

	/* Applique les effets de vulné/debuff d'un item aux DEUX shields (scalaires abs/rel) —
	 * plus aucun clone d'EntityState. Ordre des effets de l'item, facteur critique et
	 * isHitable par effet CONSERVÉS. TargetStats sert uniquement à isHitable (LIFE/SIDE/
	 * IS_SUMMON) et n'est jamais muté. Retourne [abs, rel]. */
	static getRoughVulneConsequences(TargetStats, curAbs, curRel, Infos, CritFactor, CasterStats) {
		var abs = curAbs
		var rel = curRel
		for (var eff in Infos.EFFECTS) {
			var EffType = eff[0]
			if (EffType != EFFECT_DEBUFF && EffType != EFFECT_VULNERABILITY && EffType != EFFECT_ABSOLUTE_VULNERABILITY) continue
			if (!ConsequencesClass.isHitable(eff, TargetStats, CasterStats, false)) continue
			if (EffType == EFFECT_DEBUFF) {
				var keep = max(0, 1 - (eff[1] * CritFactor / 100))   // clampé : un débuff crité peut dépasser 100%
				abs *= keep   // ABS puis REL, même ordre qu'avant
				rel *= keep
			} else if (EffType == EFFECT_VULNERABILITY) {
				rel -= eff[1] * CritFactor
			} else {   // EFFECT_ABSOLUTE_VULNERABILITY
				abs -= eff[1] * CritFactor
			}
		}
		return [abs, rel]
	}

	/*
	 * Combo glouton sans vulné : empile les items par dégâts (liste triée d'EntityDanger)
	 * dans le budget TP + MAX_USES. BaseUses est READ-ONLY (jamais muté ni cloné) : une
	 * seule entrée (item, aoe) de la liste peut matcher ItemAoeMap[item] par item — un
	 * scalaire local de uses par entrée suffit.
	 *
	 * @return dégâts totaux du combo
	 */
	static getGreedyComboFromItemAoe(ItemAoeMap, CasterStats, TargetStats, CasterTP, BaseUses, curAbs, curRel) {
		var EntityDangerArray = EntityDangerClass.get(CasterStats, TargetStats, curAbs, curRel)
		var ComboHash = getGreedyComboHash(ItemAoeMap, EntityDangerArray, CasterTP)
		if (ComboHash in COMBO_DAMAGE_CACHE) return COMBO_DAMAGE_CACHE[ComboHash]
		var _final = 0
		for (var EntityDanger in EntityDangerArray) {
			var ItemEntityDanger = EntityDanger.Item
			if (ItemAoeMap[ItemEntityDanger] == EntityDanger.Aoe) {
				var CostEntityDanger = EntityDanger.Cost
				var MaxUsesOfItem = ITEMINFO[ItemEntityDanger].MAX_USES
				var itemUses = BaseUses[ItemEntityDanger]
				while (CasterTP >= CostEntityDanger && itemUses < MaxUsesOfItem) {
					_final += EntityDanger.Damages
					CasterTP -= CostEntityDanger
					itemUses++
				}
			}
		}
		COMBO_DAMAGE_CACHE[ComboHash] = _final
		return _final
	}

	/* Hash du combo glouton : chaque (item utilisable, ses dégâts) + le TP du caster. */
	static getGreedyComboHash(ItemAoeMap, EntityDangerArray, CasterTP) {
		var hash_value = (OFFSET_BASIS ^ CasterTP)

		for (var EntityDanger in EntityDangerArray) {
			var ItemEntityDanger = EntityDanger.Item
			if (ItemAoeMap[ItemEntityDanger] == EntityDanger.Aoe) {

				var combined = (ItemEntityDanger << 30) | EntityDanger.Damages
				hash_value = addValueToBinHash(hash_value, combined)

			}
		}

		return hash_value
	}

	/*
	 * [cellule -> [item -> plus petite distance d'AoE]] : ce que le caster peut atteindre.
	 * Clé (ID, couche marche/saut, cellule, TOTAL_MP) — l'ID est OBLIGATOIRE : la valeur
	 * embarque la liste d'items du caster, deux ennemis déplacés sur la même cellule
	 * (attract/push) avec le même MP ne doivent pas partager d'entrée. usesJumpLayer =
	 * canJumpNextTurn (source unique) : EntityWalkCells reçu est la couche marche OU
	 * marche+Jump — un buff/shackle TP franchissant le coût de Jump en branche change la
	 * couche sans toucher ID/cellule/MP, le bit garantit que la map reçue et la clé
	 * décrivent la même couche. Pack direct injectif : cellule <= 612 (10 bits),
	 * MP < 1024 (10 bits), mp clampé (shacklé négatif == 0).
	 */
	static getMapCellItemAoe(EntityStats, EntityWalkCells) {
		var usesJumpLayer = WalkCellsClass.canJumpNextTurn(EntityStats) ? 1 : 0
		// movementKey (21 bits, sans ID) décrit exactement la map NoEntities reçue :
		// couche marche/saut, cellule de départ, budget MP.
		var movementKey = (usesJumpLayer << 20) | (EntityStats.CELL << 10) | max(0, EntityStats.TOTAL_MP)
		var TmpHash = (EntityStats.ID << 21) | movementKey
		if (TmpHash in MAP_CELL_ITEM_AOE_CACHE) return MAP_CELL_ITEM_AOE_CACHE[TmpHash]
		var _final = buildMapCellItemAoe(EntityDangerClass.getItemsList(EntityStats), EntityWalkCells, movementKey)
		MAP_CELL_ITEM_AOE_CACHE[TmpHash] = _final
		return _final
	}

	/*
	 * Assemblage commun Danger/Heal : [cell -> [item -> minAoeDist]] pour une liste d'items
	 * et les walkcells du caster. Les géométries vivent dans deux caches PERSISTANTS
	 * (jamais vidés au tour) clés par (movementKey, signature) — movementKey détermine
	 * exactement la map NoEntities, elle-même statique : même contexte au tour suivant ou
	 * chez un autre caster -> géométrie réutilisée telle quelle. Même FULL_GEOMETRY_KEY ->
	 * toute la map d'AoE partagée ; même LAUNCH_GEOMETRY_KEY -> l'union des cellules
	 * directement lançables partagée. Maps cachées STRICTEMENT read-only.
	 * Seul l'ASSEMBLAGE dépend de la liste d'items (cooldown-filtrée par tour) — il reste
	 * caché par tour chez les appelants. L'ordre d'insertion des items = l'ordre de la
	 * liste (le fold dépendant de l'ordre de getHashFromItemAoeMap, les clés de combo et
	 * l'ordre glouton en dépendent).
	 */
	static buildMapCellItemAoe(items, walkCellsMap, movementKey) {
		var _final = [: ]
		var diagPacific = getName(Me) == "PacificRose"   // DIAGNOSTIC — À RETIRER (une fois par build)
		for (var Item in items) {
			var Infos = ITEMINFO[Item]
			var fullKey = (movementKey << 30) | Infos.FULL_GEOMETRY_KEY
			// launchKey hoisté en tête d'itération (remis dans la branche miss au retrait du
			// diagnostic) : le diag doit lire les états des DEUX caches AVANT toute
			// lecture/construction/écriture de cette géométrie.
			var launchKey = (movementKey << 25) | Infos.LAUNCH_GEOMETRY_KEY
			// ============ DIAGNOSTIC TEMPORAIRE Bitmap — À RETIRER (revert) ============
			var diagFullWasHit = false
			var diagLaunchWasHit = false
			if (diagPacific) {
				diagFullWasHit = (fullKey in ITEM_FULL_GEOMETRY_CACHE)
				diagLaunchWasHit = (launchKey in ITEM_LAUNCH_GEOMETRY_CACHE)
			}
			// ===========================================================================
			var itemMap
			if (fullKey in ITEM_FULL_GEOMETRY_CACHE) {
				itemMap = ITEM_FULL_GEOMETRY_CACHE[fullKey]
			} else {
				var directMask
				if (launchKey in ITEM_LAUNCH_GEOMETRY_CACHE) {
					directMask = ITEM_LAUNCH_GEOMETRY_CACHE[launchKey]
				} else {
					directMask = getMapHittableCellsTotal(Infos, walkCellsMap)
					ITEM_LAUNCH_GEOMETRY_CACHE[launchKey] = directMask
				}
				itemMap = getMapAoeForItem(Infos, directMask)
				ITEM_FULL_GEOMETRY_CACHE[fullKey] = itemMap   // le cache de production reste TOUJOURS Bitmap
			}
			// ============ DIAGNOSTIC TEMPORAIRE Bitmap — À RETIRER (revert) ============
			// APRÈS la résolution hit/miss : chaque géométrie CONSOMMÉE par PacificRose est
			// comparée, y compris une FULL préchauffée (par un bulbe/un tour antérieur). Le
			// remplacement éventuel (RETURN_LEGACY) est LOCAL — jamais écrit au cache. Les
			// booléens HIT/MISS viennent des captures d'AVANT résolution.
			if (diagPacific) {
				var diagMask
				if (launchKey in ITEM_LAUNCH_GEOMETRY_CACHE) {
					diagMask = ITEM_LAUNCH_GEOMETRY_CACHE[launchKey]
				} else {
					diagMask = getMapHittableCellsTotal(Infos, walkCellsMap)   // fallback (hit FULL sans launch)
				}
				itemMap = diagCompareGeometry(Item, Infos, walkCellsMap, movementKey, launchKey, fullKey, diagMask, itemMap, diagFullWasHit, diagLaunchWasHit)
			}
			// ===========================================================================
			for (var Cell: var MinAoeDist in itemMap) {
				if (Cell in _final) {
					_final[Cell][Item] = MinAoeDist
				} else {
					_final[Cell] = [: ]
					_final[Cell][Item] = MinAoeDist
				}
			}
		}
		return _final
	}

	/*
	 * [cellule -> distance d'AoE minimale] pour un item, depuis le MASQUE des cellules
	 * directes (Bitmap #2). Expansion par COUCHES de distance : la couche 0 est le masque
	 * direct, chaque centre direct OR ses masques d'AoE par distance (areaMasksByCenter —
	 * AREA_MAX majore exactement les distances de getAreaDist : table AreaMax == Manhattan
	 * max de la forme), puis les distances MINIMALES s'obtiennent en retirant de chaque
	 * couche les cellules déjà vues aux distances inférieures — un recouvrement entre
	 * centres garde toujours la plus petite distance, comme l'ancien fold min. UN seul
	 * décodage par couche finale vers la map historique.
	 */
	static getMapAoeForItem(ItemInfos, directMask) {
		var _final = [: ]
		if (directMask == 0L) return _final   // aucun centre direct : aucune expansion possible
		var areaMax = ItemInfos.AREA_MAX
		// Couche 0 traitée DIRECTEMENT : décodage du masque direct à distance 0 — la boucle
		// de minimisation part de seen = directMask, sans les trois opérations 0L inutiles.
		var mask = directMask
		while (mask != 0L) {
			var cell = trailingZeros(mask)
			_final[cell] = 0
			mask = setBit(mask, cell, 0)
		}
		if (areaMax == 0) return _final
		var area = ItemInfos.AREA
		var rawLayers = [0L]   // slot 0 inutilisé (couche 0 déjà décodée) : indices == distances
		for (var d = 1; d <= areaMax; d++) {
			push(rawLayers, 0L)
		}
		mask = directMask
		while (mask != 0L) {
			var center = trailingZeros(mask)
			for (var d: var m in areaMasksByCenter(area, center)) {
				if (d == 0) continue   // le bit dist-0 du centre est déjà dans la couche 0
				rawLayers[d] = rawLayers[d] | m
			}
			mask = setBit(mask, center, 0)
		}
		// andNot via & puis ^ (pas de ~ sur un big_integer : complément à deux infini).
		// Couches vides court-circuitées (les formes X ont des distances absentes).
		var seen = directMask
		for (var d = 1; d <= areaMax; d++) {
			var layer = rawLayers[d]
			if (layer == 0L) continue
			var common = layer & seen
			if (common != 0L) {
				layer = layer ^ common
				if (layer == 0L) continue
			}
			if (d < areaMax) seen = seen | layer   // la dernière couche n'a plus de lecteur
			while (layer != 0L) {
				var cell = trailingZeros(layer)
				_final[cell] = d
				layer = setBit(layer, cell, 0)
			}
		}
		return _final
	}

	/*
	 * Masque big_integer des cellules touchables en direct par l'item depuis n'importe
	 * quelle cellule accessible du caster (Bitmap #2 : plus AUCUN décodage intermédiaire —
	 * ITEM_LAUNCH_GEOMETRY_CACHE cache le masque, seul getMapAoeForItem le consomme, et
	 * aucun consommateur Danger/Heal ne reçoit de big_integer : le format aval reste
	 * [cell -> minAoeDist] via ITEM_FULL_GEOMETRY_CACHE).
	 */
	static getMapHittableCellsTotal(ItemInfos, WalkCellsMap) {
		var mask = 0L
		for (var EntityCell: var mp in WalkCellsMap) {
			mask = mask | launchMaskFromOrigin(ItemInfos, EntityCell)
		}
		return mask
	}

	// ==================== DIAGNOSTIC TEMPORAIRE Bitmap — À RETIRER (revert) ====================

	/* Builders de RÉFÉRENCE : reproduction EXACTE du code de 6264491 (union de maps +
	 * fold min), jamais appelés hors diagnostic. */
	static legacyMapHittableCellsTotal(ItemInfos, WalkCellsMap) {
		var _final = [: ]
		var LaunchType = ItemInfos.LAUNCHTYPE
		var MinRange = ItemInfos.MINRANGE
		var MaxRange = ItemInfos.MAXRANGE
		if (ItemInfos.NEEDLOS) {
			for (var EntityCell: var mp in WalkCellsMap) {
				_final += ActionsClass.LaunchWithLos[LaunchType](EntityCell, MinRange, MaxRange)
			}
		} else {
			for (var EntityCell: var mp in WalkCellsMap) {
				_final += ActionsClass.LaunchWithoutLos[LaunchType](EntityCell, MinRange, MaxRange)
			}
		}
		return _final
	}

	static legacyMapAoeForItem(ItemInfos, MapCellsBool) {
		var _final = [: ]
		for (var cell: var bool in MapCellsBool) {
			_final[cell] = 0
		}
		if (ItemInfos.AREA_MAX > 0) {
			var area = ItemInfos.AREA
			for (var cell: var bool in MapCellsBool) {
				for (var Aoe: var AoeDist in CellClass.getAreaDist(area, cell)) {
					var ActualCellDist = _final[Aoe]
					if (ActualCellDist == null || ActualCellDist > AoeDist) {
						_final[Aoe] = AoeDist
					}
				}
			}
		}
		return _final
	}

	static diagLog(step, Item, movementKey, launchKey, fullKey, area, cell, legacyVal, bitmapVal, legacySize, bitmapSize) {
		debugE("[DIAG Bitmap] ÉCART " + step + " item=" + Item + " movementKey=" + movementKey
			+ " launchKey=" + launchKey + " fullKey=" + fullKey + " area=" + area
			+ " cell=" + cell + " legacy=" + legacyVal + " bitmap=" + bitmapVal
			+ " tailles legacy=" + legacySize + " bitmap=" + bitmapSize)
	}

	/*
	 * Compare la géométrie Bitmap (directMask + itemMap) à la legacy 6264491, dans les DEUX
	 * sens, valeurs comprises, sans hash. Log au PREMIER écart global uniquement. Contenus
	 * identiques -> compare l'ORDRE d'itération des cellules (une fois). Retourne la map
	 * servie à l'appelant : la Bitmap, ou la legacy si DIAG_BITMAP_RETURN_LEGACY (isolation).
	 */
	/*
	 * FORAGE D'ÉTAGE au premier écart DIRECT : recalcul Bitmap TOTALEMENT FRAIS, sans lire
	 * AUCUN des trois caches (ITEM_LAUNCH/LAUNCH_MASK_BY_ORIGIN/ITEM_FULL) — mêmes
	 * dispatchers, setBit, OR. Compte origines/maps non vides/cellules source, puis cherche
	 * la première origine dont le masque CACHÉ (launchMaskFromOrigin) diverge du frais.
	 * Grille : freshTotal=120 & direct=0 -> cache agrégé LAUNCH empoisonné ; freshOrigin ok
	 * & caché vide -> LAUNCH_MASK_BY_ORIGIN empoisonné/collision ; freshOrigin vide malgré
	 * source non vide -> conversion setBit ; freshTotal vide malgré origins non vides -> OR.
	 */
	static diagDirectDeepDive(Item, Infos, walkCellsMap, directMask, legacyDirect, fullWasHit, launchWasHit) {
		var freshTotalMask = 0L
		// Agrégat INDÉPENDANT : setBit direct sur chaque cellule source, sans masque par
		// origine ni OR — discrimine conversion-par-origine vs agrégation.
		var freshTotalByDirectSetBit = 0L
		var nOrigins = 0
		var nNonEmptyOrigins = 0
		var nSourceCells = 0
		var nonZeroOriginMasks = 0
		var sumOriginBits = 0
		var firstOriginLogged = false
		var firstBadOrigin = -1
		var firstBadInfo = ""
		for (var origin: var mp in walkCellsMap) {
			nOrigins++
			var cells = Infos.NEEDLOS
				? ActionsClass.LaunchWithLos[Infos.LAUNCHTYPE](origin, Infos.MINRANGE, Infos.MAXRANGE)
				: ActionsClass.LaunchWithoutLos[Infos.LAUNCHTYPE](origin, Infos.MINRANGE, Infos.MAXRANGE)
			var srcSize = mapSize(cells)
			if (srcSize > 0) nNonEmptyOrigins++
			nSourceCells += srcSize
			var freshOriginMask = 0L
			var firstSrcCell = -1
			for (var cell: var _t in cells) {
				if (firstSrcCell == -1) firstSrcCell = cell
				freshOriginMask = setBit(freshOriginMask, cell)
				freshTotalByDirectSetBit = setBit(freshTotalByDirectSetBit, cell)
			}
			if (freshOriginMask != 0L) nonZeroOriginMasks++
			sumOriginBits += bitCount(freshOriginMask)
			freshTotalMask = freshTotalMask | freshOriginMask
			if (!firstOriginLogged) {
				firstOriginLogged = true
				debugE("[DIAG Bitmap ÉTAGE] première origine=" + origin
					+ " premièreCelluleSource=" + firstSrcCell
					+ " srcSize=" + srcSize
					+ " originMaskBits=" + bitCount(freshOriginMask)
					+ " testBit(première)=" + (firstSrcCell == -1 ? "n/a" : testBit(freshOriginMask, firstSrcCell)))
			}
			if (firstBadOrigin == -1) {
				var cached = launchMaskFromOrigin(Infos, origin)
				if (cached != freshOriginMask) {
					firstBadOrigin = origin
					var diff = cached ^ freshOriginMask
					firstBadInfo = "originKey=" + ((origin << 25) | Infos.LAUNCH_GEOMETRY_KEY)
						+ " srcSize=" + srcSize
						+ " freshBits=" + bitCount(freshOriginMask)
						+ " cachedBits=" + bitCount(cached)
						+ " firstDivergentCell=" + trailingZeros(diff)
				}
			}
		}
		debugE("[DIAG Bitmap ÉTAGE] item=" + Item
			+ " walkOrigins=" + mapSize(walkCellsMap)
			+ " parcourues=" + nOrigins + " nonVides=" + nNonEmptyOrigins + " cellulesSource=" + nSourceCells
			+ " nonZeroOriginMasks=" + nonZeroOriginMasks
			+ " sumOriginBits=" + sumOriginBits
			+ " directMaskBits=" + bitCount(directMask)
			+ " freshTotalBits(OR)=" + bitCount(freshTotalMask)
			+ " freshTotalBits(directSetBit)=" + bitCount(freshTotalByDirectSetBit)
			+ " legacySize=" + mapSize(legacyDirect)
			+ " FULL=" + (fullWasHit ? "HIT" : "MISS")
			+ " LAUNCH=" + (launchWasHit ? "HIT" : "MISS"))
		if (firstBadOrigin != -1) {
			debugE("[DIAG Bitmap ÉTAGE] première origine divergente=" + firstBadOrigin + " " + firstBadInfo)
		} else {
			debugE("[DIAG Bitmap ÉTAGE] aucune origine divergente : chaque masque caché == frais")
		}
	}

	static diagCompareGeometry(Item, Infos, walkCellsMap, movementKey, launchKey, fullKey, directMask, itemMap, fullWasHit, launchWasHit) {
		// Premier écart déjà identifié : ne plus payer les reconstructions legacy — sauf si
		// l'isolation exige la map legacy pour l'assemblage.
		if (DIAG_BITMAP_MISMATCH_LOGGED && !DIAG_BITMAP_RETURN_LEGACY) return itemMap
		var legacyDirect = legacyMapHittableCellsTotal(Infos, walkCellsMap)
		var legacyAoe = legacyMapAoeForItem(Infos, legacyDirect)
		if (!DIAG_BITMAP_MISMATCH_LOGGED) {
			if (!DIAG_BITMAP_STARTED) {
				DIAG_BITMAP_STARTED = true
				debug("[DIAG Bitmap] comparaisons actives (PacificRose)")
			}
			// --- DIRECT : legacy -> bitmap puis bitmap -> legacy ---
			var directCount = 0
			for (var cell: var b in legacyDirect) {
				directCount++
				if (!testBit(directMask, cell)) {
					DIAG_BITMAP_MISMATCH_LOGGED = true
					diagLog("DIRECT", Item, movementKey, launchKey, fullKey, Infos.AREA, cell, "présent", "ABSENT", mapSize(legacyDirect), bitCount(directMask))
					diagDirectDeepDive(Item, Infos, walkCellsMap, directMask, legacyDirect, fullWasHit, launchWasHit)
					return DIAG_BITMAP_RETURN_LEGACY ? legacyAoe : itemMap
				}
			}
			if (bitCount(directMask) != directCount) {
				var m = directMask
				while (m != 0L) {
					var cell = trailingZeros(m)
					if (!(cell in legacyDirect)) {
						DIAG_BITMAP_MISMATCH_LOGGED = true
						diagLog("DIRECT", Item, movementKey, launchKey, fullKey, Infos.AREA, cell, "ABSENT", "présent", mapSize(legacyDirect), bitCount(directMask))
						diagDirectDeepDive(Item, Infos, walkCellsMap, directMask, legacyDirect, fullWasHit, launchWasHit)
						return DIAG_BITMAP_RETURN_LEGACY ? legacyAoe : itemMap
					}
					m = setBit(m, cell, 0)
				}
			}
			// --- AOE : valeurs des deux côtés ---
			for (var cell: var dist in legacyAoe) {
				var bmDist = (cell in itemMap) ? itemMap[cell] : null
				if (bmDist != dist) {
					DIAG_BITMAP_MISMATCH_LOGGED = true
					diagLog("AOE", Item, movementKey, launchKey, fullKey, Infos.AREA, cell, dist, (bmDist == null ? "ABSENT" : bmDist), mapSize(legacyAoe), mapSize(itemMap))
					return DIAG_BITMAP_RETURN_LEGACY ? legacyAoe : itemMap
				}
			}
			if (mapSize(itemMap) != mapSize(legacyAoe)) {
				for (var cell: var dist in itemMap) {
					if (!(cell in legacyAoe)) {
						DIAG_BITMAP_MISMATCH_LOGGED = true
						diagLog("AOE", Item, movementKey, launchKey, fullKey, Infos.AREA, cell, "ABSENT", dist, mapSize(legacyAoe), mapSize(itemMap))
						return DIAG_BITMAP_RETURN_LEGACY ? legacyAoe : itemMap
					}
				}
			}
			// --- Contenus identiques : verdict d'ORDRE — le flag n'est posé QUE sur un ordre
			// différent (un premier item à ordre identique n'empêche pas de contrôler les
			// items suivants).
			if (!DIAG_BITMAP_ORDER_LOGGED) {
				var keysL = mapKeys(legacyAoe)
				var keysB = mapKeys(itemMap)
				var firstDiff = -1
				for (var i = 0; i < count(keysL); i++) {
					if (keysL[i] != keysB[i]) { firstDiff = i; break }
				}
				if (firstDiff != -1) {
					DIAG_BITMAP_ORDER_LOGGED = true
					debug("[DIAG Bitmap] contenus identiques, ORDRE DIFFÉRENT dès l'index " + firstDiff
						+ " (item " + Item + ") : legacy=" + keysL[firstDiff] + " bitmap=" + keysB[firstDiff])
				}
			}
		}
		return DIAG_BITMAP_RETURN_LEGACY ? legacyAoe : itemMap
	}

	// ================== FIN DIAGNOSTIC TEMPORAIRE Bitmap — À RETIRER (revert) ==================

	/*
	 * [distance -> masque big_integer] des cellules d'AoE d'un type de zone autour d'un
	 * centre — construit PARESSEUSEMENT depuis CellClass.getAreaDist (SOURCE GÉOMÉTRIQUE
	 * UNIQUE : aucune formule de cercle/carré/plus/X dupliquée), persistant au combat.
	 * Clé (areaType << 10) | centerCell, injective (cellule < 1024).
	 */
	static areaMasksByCenter(areaType, centerCell) {
		var key = (areaType << 10) | centerCell
		if (key in AREA_MASKS_BY_CENTER_CACHE) return AREA_MASKS_BY_CENTER_CACHE[key]
		var byDist = [: ]
		for (var cell: var dist in CellClass.getAreaDist(areaType, centerCell)) {
			byDist[dist] = setBit((dist in byDist) ? byDist[dist] : 0L, cell)
		}
		AREA_MASKS_BY_CENTER_CACHE[key] = byDist
		return byDist
	}

	/*
	 * Masque big_integer des cellules lançables depuis originCell avec la signature de
	 * lancement de l'item (bit `cell` = 1). SOURCE GÉOMÉTRIQUE UNIQUE : la map vient des
	 * dispatchers LaunchWithLos/LaunchWithoutLos existants — aucune formule de portée ni
	 * de LoS dupliquée, seule la SORTIE est convertie en masque (une fois par origine,
	 * persistant au combat). Suffixe L OBLIGATOIRE : `1 << cell` resterait un entier 64
	 * bits (shift mod 64, faux silencieux au-delà de la cellule 63) — `1L << cell` est
	 * bien un big_integer.
	 */
	static launchMaskFromOrigin(ItemInfos, originCell) {
		var key = (originCell << 25) | ItemInfos.LAUNCH_GEOMETRY_KEY
		if (key in LAUNCH_MASK_BY_ORIGIN_CACHE) return LAUNCH_MASK_BY_ORIGIN_CACHE[key]
		var cells = ItemInfos.NEEDLOS
			? ActionsClass.LaunchWithLos[ItemInfos.LAUNCHTYPE](originCell, ItemInfos.MINRANGE, ItemInfos.MAXRANGE)
			: ActionsClass.LaunchWithoutLos[ItemInfos.LAUNCHTYPE](originCell, ItemInfos.MINRANGE, ItemInfos.MAXRANGE)
		var mask = 0L
		for (var cell: var _t in cells) {
			mask = setBit(mask, cell)
		}
		LAUNCH_MASK_BY_ORIGIN_CACHE[key] = mask
		return mask
	}

	/*
	 * [id -> true] des entités à skipper pour le danger d'une cible : Me (ma menace est le
	 * travail du BFS, jamais du danger ambiant — valide pour tous les appelants), son propre
	 * camp, les morts, et les casters sans item menaçant. Clé (BaseHash, id). Map cachée
	 * read-only : aucun appelant ne la clone ni ne la patche.
	 */
	static EntitiesToSkip(EntityState, State, BaseHash) {
		var ThisHash = addValueToBinHash((OFFSET_BASIS ^ BaseHash), EntityState.ID)
		if (ThisHash in TO_SKIP_MAP_CACHE) return TO_SKIP_MAP_CACHE[ThisHash]
		var _final = [: ]
		_final[Me] = true
		var entity_side = EntityState.SIDE
		for (var caster: var caststats in State) {
			if ((entity_side == caststats.SIDE) || caststats.LIFE <= 0 || !HaveAnHittableItem(caststats, caster)) {
				_final[caster] = true
			}
		}
		TO_SKIP_MAP_CACHE[ThisHash] = _final
		return _final
	}

	/* L'entité a-t-elle un item à compter dans la danger map ? (cooldown <= 1, effet menaçant)
	 * Parcourt INVENTORY (même ordre que l'ancienne map de cooldowns) + cooldown effectif. */
	static HaveAnHittableItem(CasterStats, CasterID) {
		if (CasterID in HAVE_AN_HITTABLE_ITEM_CACHE) return HAVE_AN_HITTABLE_ITEM_CACHE[CasterID]
		for (var i in CasterStats.INVENTORY) {
			if (StateClass.cooldownOf(CasterStats, i) > 1) continue
			for (var eff in ITEMINFO[i].EFFECTS) {
				if (MapHittables[eff[0]]) {
					HAVE_AN_HITTABLE_ITEM_CACHE[CasterID] = true
					return true
				}
			}
		}
		HAVE_AN_HITTABLE_ITEM_CACHE[CasterID] = false
		return false
	}

	static MapHittables = [
		EFFECT_DAMAGE: true,
		EFFECT_LIFE_DAMAGE: true,
		EFFECT_POISON: true,
		EFFECT_DEBUFF: true,
		EFFECT_ABSOLUTE_VULNERABILITY: true,
		EFFECT_VULNERABILITY: true
	]

}
