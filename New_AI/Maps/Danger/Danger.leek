/*
 * Danger map : les dégâts que chaque caster adverse peut poser sur une cible à une cellule
 * donnée (meilleur combo, déplacement + vulnés compris).
 *
 * Façade courte : clé de cellule, couverture d'une cellule depuis le plan offensif,
 * groupement local exact, déroulé cross-casters, et CELL_DANGER_GET_CACHE. La géométrie vit
 * dans ItemCoverageClass, le plan dans DangerPlanClass, les combos dans DangerComboClass.
 */

include("../../includes.leek")

class DangerClass {

	/* Pas de la couverture à plat : (index dans l'ordre du plan, ItemAoeMap, hash de contenu).
	 * L'INDEX plutôt que l'id : il donne aussi le pack offensif et le facteur critique du
	 * caster par simple lecture alignée. Layout strictement interne — ni Delta, ni FinalCell,
	 * ni le scoring ne le voient. */

	/* Décalage de la seconde moitié de la partition de jeu (DangerPlanClass) : plus grand que tout écart
	 * de TURN_ORDER, il range « a déjà joué » après « joue encore ». Sert aussi de marque de
	 * retrait consommé. */
	static SEQ_WRAP = 1000

	/*
	 * Les boucliers expirants de la cible, convertis en RANGS dans sa séquence de jeu :
	 * [rang du lanceur, retrait absolu, retrait relatif]. Même partition que les séquences du plan.
	 * Le lanceur peut être un attaquant de cette chaîne : une vulnérabilité est posée par
	 * l'adversaire. Son propre rang compte alors, car le moteur retire la ligne au début de son
	 * tour, avant qu'il n'agisse — il frappe sans elle et en repose une neuve dans son combo.
	 * Le rang zéro est celui de la cible : il porte une ligne déjà tombée quand le cycle s'ouvre,
	 * donc retirée pour tous les attaquants.
	 * Liste NEUVE à chaque appel : le déroulé y marque les retraits consommés.
	 */
	static expiryDropsByRank(Plan, TargetStats) {
		var raw = TargetStats.SHIELD_EXPIRY
		if (raw == null) return null
		var ordersById = Plan.ORDER_BY_ID
		var targetOrder = ordersById[TargetStats.ID]
		var out = []
		var n = count(raw)
		for (var i = 0; i < n; i += 3) {
			var casterId = raw[i]
			if (casterId == EXPIRY_PRE_OPENING) {
				// Retrait deja acquis a l'ouverture du cycle : rang zero, le creneau de la cible
				// elle-meme, qu'aucun attaquant n'occupe. Il est donc consomme avant le premier
				// combo, exactement comme s'il etait retire de la defense initiale.
				push(out, 0)
				push(out, raw[i + 1])
				push(out, raw[i + 2])
				continue
			}
			// Lanceur absent de l'ordre de tour : plus rien à retirer de son fait.
			if (!(casterId in ordersById)) continue
			var o = ordersById[casterId]
			push(out, o >= targetOrder ? o - targetOrder : o - targetOrder + SEQ_WRAP)
			push(out, raw[i + 1])
			push(out, raw[i + 2])
		}
		if (count(out) == 0) return null
		return out
	}

	/* Partie CONSTANTE de la clé de CELL_DANGER_GET_CACHE — SOURCE UNIQUE : la cellule s'y
	 * ajoute par un simple XOR sur ses dix bits bas, disjoints de l'id.
	 * L'id de la cible est OBLIGATOIRE : la chaîne cross-casters pivote sur ELLE, deux cibles
	 * de même camp aux mêmes shields peuvent avoir un ordre d'attaquants différent. */
	static cellCacheSeed(TargetDangerSeed, TargetId) {
		return addValueToBinHash((OFFSET_BASIS ^ TargetDangerSeed), TargetId << 10)
	}

	/*
	 * Couverture ordonnée d'une cellule, prise dans le plan : les casters qui l'atteignent,
	 * dans la séquence de jeu vue par la cible (partition sur les TURN_ORDER, construite une
	 * fois par cible). La cellule ne sert QU'À sélectionner les maps d'items — plus rien en
	 * aval ne lit son numéro (ni les combos, ni leurs clés, ni le glouton, ni EntityDanger,
	 * ni les vulnés).
	 */
	static coverageOfCell(Cell, Plan, CovSeq, TargetId) {
		// La couverture ne dépend PAS des boucliers de la cible — seulement de la cellule, du plan
		// et de la séquence de couverture, elle-même fonction de (plan, cible). Or la clé de
		// CELL_DANGER_GET_CACHE, elle, porte les boucliers : un simple auto-buff rendait FROID tout
		// le domaine de fuite et refaisait cette couverture à l'identique. Elle est donc mémorisée
		// SUR LE PLAN, que les graines se partagent.
		var covKey = (TargetId << 10) | Cell
		if (covKey in Plan.COV_BY_CELL) {
			var hit = Plan.COV_BY_CELL[covKey]
			LAST_COVERAGE_HASH = hit[1]
			return hit[0]
		}
		var maps = Plan.OFFENSIVE_MAPS
		var mapKeys = Plan.MAP_KEYS
		// TROIS tableaux parallèles et non un tableau plat à pas de 3 : le déroulé lisait
		// l'élément i, puis i+1 et i+2 en repayant l'addition d'indice à chaque caster. Un
		// parcours par clé:valeur donne l'indice gratuitement et les deux autres lectures
		// tombent à une opération. Les trois restent alignés par construction.
		var covIdx = []
		var covMap = []
		var covHash = []
		var hash = 0
		for (var idx in CovSeq) {
			// CONTRAT : CovSeq ne retient que les casters à map offensive non nulle.
			var offMap = maps[idx]
			// Caster incapable d'atteindre cette cellule : aucun triplet, aucun combo.
			if (!(Cell in offMap)) continue
			var itemMap = offMap[Cell]
			// Hash de contenu mémorisé par (map, cellule) et transporté jusqu'au combo.
			var contentHash = DangerPlanClass.itemAoeHashOf(mapKeys[idx], Cell, itemMap)
			push(covIdx, idx)
			push(covMap, itemMap)
			push(covHash, contentHash)
			// Même fold que le regroupement par bucket, mais sur les valeurs déjà en main.
			// Digest de longueur variable : chaîne à MULTIPLICATION (contrat des clés, famille
			// 3b). Pas de finaliseur — il n'existe qu'une consommation, une égalité pleine de
			// clé de bucket, et les termes agrégés sont déjà avalanchés.
			hash = (hash ^ (contentHash ^ (idx << 56))) * MIX_A
		}
		LAST_COVERAGE_HASH = hash
		var cov = [covIdx, covMap, covHash]
		Plan.COV_BY_CELL[covKey] = [cov, hash]
		return cov
	}

	/*
	 * Déroulé de la chaîne de vulnés sur une couverture : chaque caster frappe la cible telle
	 * que les PRÉCÉDENTS l'ont laissée — ses vulnés amplifient les suivants. La cible n'est
	 * jamais mutée : seuls ses deux shields COURANTS évoluent, en scalaires.
	 *
	 * @return [casterId -> dégâts], pas sommé : le net séquence par ordre de tour
	 */
	static evalChainFromCoverage(Coverage, Plan, State, TargetStats, AntidoteCd) {
		var _final = [: ]
		var chainAbs = TargetStats.ABSOLUTE_SHIELD
		var chainRel = TargetStats.RELATIVE_SHIELD
		var order = Plan.ORDER
		var packs = Plan.CASTER_PACKS
		var seeds = Plan.CASTER_SEEDS
		var crits = Plan.CRIT_FACTORS
		// Type de la cible, cooldown d'antidote et invincibilité : fixes pour toute la chaîne,
		// packés une fois.
		var targetFixed = DangerComboClass.targetFixedPack(TargetStats.IS_SUMMON, AntidoteCd, TargetStats.STATES)
		var covIdx = Coverage[0]
		var covMap = Coverage[1]
		var covHash = Coverage[2]
		// Boucliers alliés qui tombent pendant la fenêtre. Presque toujours null : le déroulé
		// est alors exactement celui d'avant, à un test près.
		var drops = expiryDropsByRank(Plan, TargetStats)
		var dn = drops == null ? 0 : count(drops)
		var ords = dn > 0 ? Plan.TURN_ORDERS : null
		var targetOrder = dn > 0 ? Plan.ORDER_BY_ID[TargetStats.ID] : 0
		// Deux déroulés : la présence d'un bouclier allié qui TOMBE pendant la fenêtre est une
		// constante de l'appel, et elle est presque toujours fausse. La tester à chaque caster
		// coûtait un test par pas de la boucle la plus chaude du danger.
		//
		// Dans les deux branches : le crit est appliqué EN PROFONDEUR (formules d'EntityDanger
		// avant les shields + vulnés de chaîne critées), pas ici — (d − ABS)·1.3 ≠ d·1.3 − ABS.
		// DANGER_COEF est en revanche replié à l'écriture : le déroulé du net le remultipliait à
		// chaque caster, à chaque cellule et à chaque nœud, alors que cette map est mémoïsée par
		// cellule et partagée par tout un bucket. La multiplication flottante étant commutative
		// au bit près, la valeur consommée est identique. La garde reste sur la valeur BRUTE :
		// elle dit si le caster fait des dégâts, pas si sa contribution pondérée est positive.
		if (dn > 0) {
			for (var i: var idx in covIdx) {
				// Ce caster joue-t-il au tour du lanceur du bouclier, ou après ? Si oui, il ne le
				// voit plus : le moteur retire la ligne au DÉBUT du tour de son lanceur
				// (Entity.java:810-824), avant que ce lanceur n'agisse (Fight.java:367 puis 378).
				// L'égalité de rang compte donc, et c'est le cas courant : le lanceur d'une
				// vulnérabilité est un attaquant de cette chaîne, qui en repose une neuve.
				// Balayage plutôt que tri : la liste tient en un ou deux retraits.
				var o = ords[idx]
				var rank = o >= targetOrder ? o - targetOrder : o - targetOrder + SEQ_WRAP
				for (var k = 0; k < dn; k += 3) {
					if (drops[k] > rank) continue
					chainAbs -= drops[k + 1]
					chainRel -= drops[k + 2]
					drops[k] = SEQ_WRAP * 2   // consommé : ne repassera sous aucun rang
				}
				var casterId = order[idx]
				var combo = DangerComboClass.comboOfCaster(covMap[i], covHash[i], seeds[idx], packs[idx], crits[idx], State[casterId], TargetStats, chainAbs, chainRel, AntidoteCd, targetFixed)
				if (combo[0] > 0) {
					_final[casterId] = combo[0] * DANGER_COEF
					chainAbs = combo[1]   // le caster suivant voit les shields post-vulné/debuff
					chainRel = combo[2]
					// Le moteur reduit la VALEUR de chaque ligne, puis retire la ligne dans son
					// etat REDUIT (Effect.reduce puis Entity.reduceEffects). Une echeance qui
					// transporterait encore son montant d'origine rendrait plus de bouclier qu'il
					// n'en reste : 60 restants pour 100 retires font apparaitre une vulnerabilite
					// de 40 qui n'existe pas. Les echeances subissent donc les memes debuffs, dans
					// l'ordre, LIGNE A LIGNE et avec l'arrondi signe du moteur — arrondir leur
					// somme ne donne pas la somme de leurs arrondis.
					var kept = combo[3]
					if (kept != null) {
						for (var kv in kept) {
							for (var k = 0; k < dn; k += 3) {
								if (drops[k] > SEQ_WRAP) continue   // deja consomme
								var da = drops[k + 1]
								var dr = drops[k + 2]
								drops[k + 1] = da >= 0 ? round(da * kv) : -round(-da * kv)
								drops[k + 2] = dr >= 0 ? round(dr * kv) : -round(-dr * kv)
							}
						}
					}
				}
			}
		} else {
			for (var i: var idx in covIdx) {
				var casterId = order[idx]
				var combo = DangerComboClass.comboOfCaster(covMap[i], covHash[i], seeds[idx], packs[idx], crits[idx], State[casterId], TargetStats, chainAbs, chainRel, AntidoteCd, targetFixed)
				if (combo[0] > 0) {
					_final[casterId] = combo[0] * DANGER_COEF
					chainAbs = combo[1]   // le caster suivant voit les shields post-vulné/debuff
					chainRel = combo[2]
				}
			}
		}
		return _final
	}

	/*
	 * Primitive FROIDE unique : le danger d'une cellule dont la clé est déjà connue absente du
	 * cache. L'appelant a donc toujours testé CELL_DANGER_GET_CACHE avant — un hit ne
	 * construit ni plan, ni couverture, ni ordre, ni bucket.
	 *
	 * Buckets null : la chaîne est déroulée directement (une seule cellule à évaluer).
	 * Buckets non null : groupement local PROGRESSIF — les cellules dont le hash de couverture
	 * coïncide partagent une unique chaîne. Le hash 64 bits non linéaire fait foi, comme
	 * partout ailleurs dans l'IA (contrat des clés en tête de Constants.leek).
	 *
	 * @return [casterId -> dégâts], partagée en LECTURE SEULE
	 */
	static dangerOfCellCold(Cell, CellDangerKey, Plan, CovSeq, State, TargetStats, AntidoteCd, Buckets) {
		var coverage = coverageOfCell(Cell, Plan, CovSeq, TargetStats.ID)
		var danger
		if (Buckets == null) {
			danger = evalChainFromCoverage(coverage, Plan, State, TargetStats, AntidoteCd)
		} else {
			// Un seul fold par caster : le contenu de sa map, perturbé par sa POSITION dans
			// l'ordre (deux couvertures aux mêmes maps mais aux casters différents ou
			// permutés ne partagent pas de bucket).
			var hash = LAST_COVERAGE_HASH
			if (hash in Buckets) {
				danger = Buckets[hash]
			} else {
				danger = evalChainFromCoverage(coverage, Plan, State, TargetStats, AntidoteCd)
				Buckets[hash] = danger
			}
		}
		CELL_DANGER_GET_CACHE[CellDangerKey] = danger
		return danger
	}

}
