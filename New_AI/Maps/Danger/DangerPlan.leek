/*
 * Plan offensif : qui menace une cible, avec quelle géométrie et quelles stats.
 *
 * Un plan est construit UNE fois par (terrain, contexte offensif, camp de la cible) et
 * partagé par toutes les cibles de ce camp et toutes leurs cellules. Il ne retient que des
 * ids, des nombres et des maps issues des caches de tour — JAMAIS un EntityState ni une
 * référence vers le workspace, qu'une restauration pourrait rendre incohérente.
 */

include("../../includes.leek")

class DangerPlanClass {

	static MOVEMENT_KEY_MASK = 2097151   // (1 << 21) - 1 : isole movementKey dans la clé

	/* Clé de MAP_CELL_ITEM_AOE_CACHE — SOURCE UNIQUE, aussi utilisée comme préfixe EXACT des
	 * clés de DANGER_ITEM_AOE_HASH_CACHE (un hash de contenu ne doit jamais survivre au
	 * changement de map qui l'a produit).
	 * L'ID est OBLIGATOIRE : la valeur embarque la liste d'items du caster, deux ennemis
	 * déplacés sur la même cellule (attract/push) avec le même MP ne doivent pas partager
	 * d'entrée. usesJumpLayer = canJumpNextTurn (source unique) : un buff/shackle TP
	 * franchissant le coût de Jump change la couche sans toucher ID/cellule/MP, le bit
	 * garantit que la map reçue et la clé décrivent la même couche. Pack direct injectif :
	 * cellule <= 612 (10 bits), MP < 1024 (10 bits), mp clampé (shacklé négatif == 0). */
	static mapCellItemAoeKeyOf(EntityStats) {
		var usesJumpLayer = WalkCellsClass.canJumpNextTurn(EntityStats) ? 1 : 0
		return (EntityStats.ID << 21) | (usesJumpLayer << 20) | (EntityStats.CELL << 10) | max(0, EntityStats.TOTAL_MP)
	}

	/* [cellule -> [item -> plus petite distance d'AoE]] : ce que le caster peut atteindre.
	 * TmpHash est la clé DÉJÀ calculée par l'appelant, jamais reconstruite ici. */
	static getMapCellItemAoe(EntityStats, EntityWalkCells, TmpHash) {
		if (TmpHash in MAP_CELL_ITEM_AOE_CACHE) return MAP_CELL_ITEM_AOE_CACHE[TmpHash]
		// Les 21 bits bas sont exactement movementKey, clé des géométries persistantes.
		var _final = ItemCoverageClass.buildMapCellItemAoe(EntityDangerClass.getItemsList(EntityStats), EntityWalkCells, TmpHash & MOVEMENT_KEY_MASK)
		MAP_CELL_ITEM_AOE_CACHE[TmpHash] = _final
		return _final
	}

	/*
	 * Hash de contenu d'une ItemAoeMap, mémorisé par (map, cellule) : le contenu n'est donc
	 * itéré qu'UNE fois par couple de tout le tour, au lieu d'un scan à chaque signature de
	 * couverture ET à chaque appel de combo. Clé exacte et injective (pas de hash
	 * probabiliste) : la clé de MAP_CELL_ITEM_AOE_CACHE décalée de 10 bits, plus la cellule.
	 */
	static itemAoeHashOf(MapKey, Cell, ItemAoeMap) {
		var key = (MapKey << 10) | Cell
		if (key in DANGER_ITEM_AOE_HASH_CACHE) return DANGER_ITEM_AOE_HASH_CACHE[key]
		var contentHash = ItemCoverageClass.hashItemAoeMap(ItemAoeMap)
		DANGER_ITEM_AOE_HASH_CACHE[key] = contentHash
		return contentHash
	}

	/*
	 * Couverture offensive d'un caster isolé : [cellule -> ItemAoeMap], EXACTEMENT celle que
	 * le plan retiendrait pour lui. Sert au ciblage exact caster -> cibles du scoring, qui ne
	 * doit PAS construire un plan d'équipe entier pour tester un caster sale.
	 * null quand le caster ne menace personne : absent, Me (toujours exclu du danger), mort,
	 * ou sans item menaçant. Map issue de MAP_CELL_ITEM_AOE_CACHE — READ-ONLY.
	 */
	static offensiveCoverageOf(CasterStats, CasterId, MapKey) {
		if (CasterStats == null || CasterId == Me || CasterStats.LIFE <= 0) return null
		if (count(EntityDangerClass.getItemsList(CasterStats)) == 0) return null
		if (MapKey in MAP_CELL_ITEM_AOE_CACHE) return MAP_CELL_ITEM_AOE_CACHE[MapKey]
		return getMapCellItemAoe(CasterStats, WalkCellsClass.getMaxWalkOrJumpNoEntitiesFull(CasterStats), MapKey)
	}

	/* Clé du plan d'équipe : terrain + contexte offensif du camp visé + ce camp. Volontairement
	 * CONSERVATRICE — elle peut fragmenter sur une stat offensive sans effet géométrique, mais
	 * elle est exacte et ne coûte aucun nouveau scan : BaseHash et le contexte viennent des
	 * fingerprints déjà portés par le Node.
	 * Elle ne contient NI les shields, NI l'antidote, NI la LIFE, NI l'id de la cible : deux
	 * cibles du même camp partagent leur plan, seul leur point de départ dans l'ordre diffère. */
	static dangerTeamPlanKeyOf(BaseHash, OffensiveContextHash, TargetSide) {
		return addValueToBinHash(addValueToBinHash(OFFSET_BASIS ^ BaseHash, OffensiveContextHash), TargetSide)
	}

	/*
	 * LA PARTITION, écrite deux fois ci-dessous parce qu'elle n'a que deux consommateurs et
	 * qu'ils la filtrent tous les deux : les indices de ORDER de ceux qui jouent APRÈS la cible
	 * (TURN_ORDER >= le sien, cible exclue), puis ceux qui ont déjà joué. C'est une PARTITION
	 * sur les TURN_ORDER, pas une rotation d'index : le tableau trié est un cache persistant clé
	 * par le set des vivants, il peut être désynchronisé des ordres relus au tour.
	 * La seconde passe n'a pas à exclure la cible : son propre ordre est ÉGAL à targetOrder,
	 * elle est donc déjà partie avec la première.
	 * Chaque séquence est construite UNE fois par (plan, cible) et réutilisée par toutes les
	 * cellules et tous les nœuds qui partagent ce plan.
	 */

	/*
	 * Séquence RESTREINTE aux casters qui menacent réellement ce camp. Les entrées à map
	 * offensive nulle (Me, morts, même camp, sans item menaçant) ne produisent jamais de
	 * couverture : les écarter ne change aucun résultat, mais la boucle par cellule froide ne
	 * balaie plus tout l'ordre de tour.
	 * NE PAS l'utiliser pour le déroulé du net : un caster sans menace peut être un soigneur.
	 */
	static coverageSequenceFor(Plan, TargetId) {
		if (TargetId in Plan.COV_SEQ_BY_ID) return Plan.COV_SEQ_BY_ID[TargetId]
		var order = Plan.ORDER
		var ords = Plan.TURN_ORDERS
		var maps = Plan.OFFENSIVE_MAPS
		var targetOrder = Plan.ORDER_BY_ID[TargetId]
		var n = count(order)
		var cov = []
		for (var i = 0; i < n; i++) {
			if (ords[i] < targetOrder) continue
			if (order[i] == TargetId) continue
			if (maps[i] == null) continue
			push(cov, i)
		}
		for (var i = 0; i < n; i++) {
			if (ords[i] >= targetOrder) continue
			if (maps[i] == null) continue
			push(cov, i)
		}
		Plan.COV_SEQ_BY_ID[TargetId] = cov
		return cov
	}

	/*
	 * Même séquence, restreinte aux casters qui peuvent CHANGER le net de la cible : ceux qui
	 * la menacent (map offensive non nulle — les seuls qui peuvent entrer dans la map de danger)
	 * et ceux qui peuvent la soigner (vivants, non-Me, porteurs d'un item de soin — les seuls
	 * que la heal map contient). Les autres traversent le déroulé sans jamais rien y ajouter :
	 * les écarter ne change ni valeur ni ordre des additions flottantes.
	 *
	 * Contrairement aux deux séquences ci-dessus, elle porte les IDENTIFIANTS des casters et
	 * non leurs index : son seul consommateur, le déroulé du net, les résout à chaque cellule.
	 */
	static netSequenceFor(Plan, TargetId) {
		if (TargetId in Plan.NET_SEQ_BY_ID) return Plan.NET_SEQ_BY_ID[TargetId]
		var order = Plan.ORDER
		var ords = Plan.TURN_ORDERS
		var actives = Plan.ACTIVE
		var sameSides = Plan.SAME_SIDE
		var targetOrder = Plan.ORDER_BY_ID[TargetId]
		var n = count(order)
		var netSeq = []
		var allySeq = []
		for (var i = 0; i < n; i++) {
			if (ords[i] < targetOrder) continue
			if (order[i] == TargetId) continue
			if (!actives[i]) continue
			push(netSeq, order[i])
			push(allySeq, sameSides[i])
		}
		for (var i = 0; i < n; i++) {
			if (ords[i] >= targetOrder) continue
			if (!actives[i]) continue
			push(netSeq, order[i])
			push(allySeq, sameSides[i])
		}
		Plan.NET_SEQ_BY_ID[TargetId] = netSeq
		Plan.NET_ALLY_BY_ID[TargetId] = allySeq
		return netSeq
	}

	/* Drapeaux « du même camp que la cible » alignés sur la séquence de net, construits avec
	 * elle. Le déroulé du net les lit au lieu de rouvrir l'état à chaque caster. */
	static netAllySeqFor(Plan, TargetId) {
		if (!(TargetId in Plan.NET_ALLY_BY_ID)) netSequenceFor(Plan, TargetId)
		return Plan.NET_ALLY_BY_ID[TargetId]
	}

	/*
	 * Plan offensif contre un camp. Une SEULE boucle sur l'ordre de tour global : chaque entrée
	 * reçoit sa map offensive (null si elle ne menace pas ce camp), sa clé de map, son pack
	 * offensif canonique et son facteur critique — tous calculés une seule fois.
	 *
	 * ORDRE : le tableau trié est un cache PERSISTANT clé par le set des vivants, il peut donc
	 * être désynchronisé des TURN_ORDER relus à chaque tour. La séquence de jeu ne se déduit
	 * PAS de ses index : elle se reconstruit par PARTITION sur les TURN_ORDER (ceux >= celui de
	 * la cible d'abord, cible exclue, puis ceux <), exactement comme le séquenceur historique.
	 * Le plan porte donc les TURN_ORDER alignés sur l'ordre.
	 */
	static getTeamPlan(State, BaseHash, OffensiveContextHash, TargetSide) {
		var key = dangerTeamPlanKeyOf(BaseHash, OffensiveContextHash, TargetSide)
		if (key in DANGER_TEAM_PLAN_CACHE) return DANGER_TEAM_PLAN_CACHE[key]
		// MISS de la clé rapide. Or un plan ne dépend PAS du BaseHash : des alliés de la cible qui
		// se déplacent en fabriquent un neuf, identique. Ce dont il dépend vraiment : le set des
		// VIVANTS (il pinne l'ordre de tour, et l'aliveness est tout ce que le plan lit du camp de
		// la cible), le contexte offensif adverse (positions et stats des menaces) et le camp visé.
		// La signature n'est calculée qu'ICI, sur le chemin lent.
		var planSig = addValueToBinHash(addValueToBinHash(OFFSET_BASIS ^ StateClass.getHashedEntities(State), OffensiveContextHash), TargetSide)
		if (planSig in PLAN_BY_SIG) {
			var shared = PLAN_BY_SIG[planSig]
			DANGER_TEAM_PLAN_CACHE[key] = shared
			return shared
		}
		var order = StateClass.getSortedEntityByTurnOrder(State)
		var ordersById = [: ]
		var orders = []
		var maps = []
		var mapKeys = []
		var packs = []
		var crits = []
		var actives = []
		var sameSides = []
		var n = count(order)
		var activeMask = 0
		var mapsMask = 0
		for (var i = 0; i < n; i++) {
			var id = order[i]
			ordersById[id] = State[id] == null ? 0 : State[id].TURN_ORDER
			push(orders, ordersById[id])
			var stat = State[id]
			var offMap = null
			var mapKey = null
			var pack = null
			var crit = 1
			// Exclusions : Me (ma menace est le travail du BFS, jamais le danger ambiant),
			// le camp de la cible, les morts, et les casters sans item menaçant — la liste
			// d'items EST la qualification, aucun second scan d'inventaire.
			if (id != Me && stat.LIFE > 0 && stat.SIDE != TargetSide && count(EntityDangerClass.getItemsList(stat)) > 0) {
				mapKey = mapCellItemAoeKeyOf(stat)
				// Walkcells évaluées SEULEMENT au miss : l'argument était calculé à chaque
				// caster alors que la map est déjà en cache neuf fois sur dix.
				offMap = (mapKey in MAP_CELL_ITEM_AOE_CACHE) ? MAP_CELL_ITEM_AOE_CACHE[mapKey]
					: getMapCellItemAoe(stat, WalkCellsClass.getMaxWalkOrJumpNoEntitiesFull(stat), mapKey)
				crit = DangerComboClass.critFactorOf(stat)
				pack = DangerComboClass.casterOffensivePack(stat, crit)
			}
			push(maps, offMap)
			push(mapKeys, mapKey)
			push(packs, pack)
			push(crits, crit)
			// Peut-il changer le net d'une cible de ce camp ? Menace, ou soigneur éligible à la
			// heal map (mêmes conditions que healerContributionOf).
			var active = offMap != null || (id != Me && stat.LIFE > 0 && HealClass.hasHealItem(stat))
			push(actives, active)
			// Signature des séquences : ce dont elles dépendent RÉELLEMENT, et rien d'autre.
			if (active) activeMask |= 1 << i
			if (offMap != null) mapsMask |= 1 << i
			// Le plan est TOUJOURS construit avec le camp de sa propre cible : « du même camp
			// que la cible » est donc une constante du plan, pas une question à reposer à
			// chaque cellule et à chaque nœud dans le déroulé du net.
			push(sameSides, stat != null && stat.SIDE == TargetSide)
		}
		var plan = new DangerTeamPlanClass(order, ordersById, orders, maps, mapKeys, packs, crits, actives, sameSides)
		// Les séquences de jeu ne dépendent QUE de l'ordre de tour (donc du set des vivants, qui
		// pinne le tri), du camp visé, de qui menace et de qui peut changer un net. La clé du plan,
		// elle, porte le BaseHash : un ennemi poussé fabrique un plan neuf dont les séquences
		// seraient pourtant identiques. Deux plans de même signature partagent donc leurs trois
		// mémos PAR RÉFÉRENCE — ce qu'un plan construit sert immédiatement à l'autre.
		var sig = mix64(mix64((StateClass.getHashedEntities(State) << 8) | TargetSide) ^ (activeMask * MIX_A)) ^ mix64(mapsMask)
		if (sig in SEQ_MEMO_BY_SIG) {
			var shared = SEQ_MEMO_BY_SIG[sig]
			plan.COV_SEQ_BY_ID = shared[0]
			plan.NET_SEQ_BY_ID = shared[1]
			plan.NET_ALLY_BY_ID = shared[2]
		} else {
			SEQ_MEMO_BY_SIG[sig] = [plan.COV_SEQ_BY_ID, plan.NET_SEQ_BY_ID, plan.NET_ALLY_BY_ID]
		}
		DANGER_TEAM_PLAN_CACHE[key] = plan
		PLAN_BY_SIG[planSig] = plan
		return plan
	}
}

/*
 * Tableaux PARALLÈLES alignés sur ORDER (l'ordre de tour global, morts compris — les
 * consommateurs filtrent déjà). Un seul objet par plan : pas d'objet par caster, donc pas
 * d'allocation ni d'accès de champ supplémentaires par entrée.
 */
class DangerTeamPlanClass {
	ORDER           // ids du tableau trié (cache persistant, potentiellement désynchronisé)
	ORDER_BY_ID     // [id -> son TURN_ORDER] : pivot de la partition
	TURN_ORDERS     // [i] = TURN_ORDER de ORDER[i], aligné
	COV_SEQ_BY_ID   // [id cible -> indices de ORDER dans l'ordre de jeu], restreints aux casters
	                // à map offensive non nulle — construit paresseusement
	NET_SEQ_BY_ID   // idem, restreinte aux casters qui peuvent changer le net (menace ou soin)
	NET_ALLY_BY_ID  // [id cible -> drapeaux « même camp », alignés sur NET_SEQ_BY_ID]
	SAME_SIDE       // [i] = ce caster est-il du camp visé par le plan ?
	ACTIVE          // [i] = ce caster peut-il changer un net de ce camp ?
	OFFENSIVE_MAPS  // [i] = [cellule -> ItemAoeMap] du caster, ou null s'il ne menace pas
	MAP_KEYS        // [i] = clé de cette map (préfixe des hashs de contenu), ou null
	CASTER_PACKS    // [i] = pack offensif canonique du caster, ou null
	CRIT_FACTORS    // [i] = facteur critique déjà résolu, 1 par défaut
	constructor(ThisOrder, ThisOrderById, ThisTurnOrders, ThisMaps, ThisMapKeys, ThisPacks, ThisCrits, ThisActives, ThisSameSides) {
		this.ORDER = ThisOrder
		this.ORDER_BY_ID = ThisOrderById
		this.TURN_ORDERS = ThisTurnOrders
		this.COV_SEQ_BY_ID = [: ]
		this.NET_SEQ_BY_ID = [: ]
		this.NET_ALLY_BY_ID = [: ]
		this.SAME_SIDE = ThisSameSides
		this.ACTIVE = ThisActives
		this.OFFENSIVE_MAPS = ThisMaps
		this.MAP_KEYS = ThisMapKeys
		this.CASTER_PACKS = ThisPacks
		this.CRIT_FACTORS = ThisCrits
	}
}
