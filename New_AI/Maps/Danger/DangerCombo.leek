/*
 * Combo d'UN caster sur une cible : packing canonique du couple, combo glouton dégâts/TP,
 * et chaîne de vulnérabilités du caster (essayer une vulné d'abord tant que ça améliore).
 *
 * Un seul packing par famille — le pack défensif de la cible et le pack offensif du caster
 * n'existent qu'ici, et toutes les clés du danger en dérivent.
 */

include("../../includes.leek")

class DangerComboClass {

	// Slots du pack de cible — déclarés UNE fois, les deux niveaux les partagent.
	static ABS_MASK = 1048575        // 20 bits
	static ABS_SHIFT = 30
	static REL_MASK = 32767          // 15 bits
	static REL_SHIFT = 15
	static TARGET_TYPE_SHIFT = 50
	// Les deux états du moteur que ces packs LISENT, pris directement dans le masque d'états :
	// UNHEALABLE (ordinal 2) et INVINCIBLE (ordinal 3) y sont voisins, un ET puis un décalage les
	// posent en 51 et 52, au-dessus du slot de type. Les autres états ne changent aucune des
	// valeurs packées ici — les porter fragmenterait les caches sans rien corriger.
	// Derives des ordinaux du MOTEUR, pas ecrits en dur : la cle et l'escompte lisent alors le
	// meme bit par construction, et un ordinal qui bougerait cote generateur les deplacerait
	// ensemble au lieu de les faire diverger en silence.
	static STATE_KEY_MASK = (1 << STATE_UNHEALABLE) | (1 << STATE_INVINCIBLE)
	static INVINCIBLE_KEY_MASK = 1 << STATE_INVINCIBLE
	static STATE_KEY_SHIFT = 49      // UNHEALABLE -> bit 51, INVINCIBLE -> bit 52

	/*
	 * Pack DÉFENSIF de la cible : shields COURANTS de la chaîne et antidote, RIEN d'autre.
	 * Chaque champ est masqué à son slot — une vulné est un shield NÉGATIF, non masqué son
	 * signe s'étendrait et absorberait les champs hauts. antidoteCd 99 = pas d'antidote dans
	 * l'inventaire (jamais de cure, le poison compte sa durée PLEINE), distinct d'un antidote
	 * prêt (0).
	 * C'est ce niveau qui nourrit la graine des clés de CELLULE : l'identité de la cible y est
	 * déjà portée à part, et son type est immuable pour un id donné — l'ajouter n'apporterait
	 * aucune information et déplacerait toutes les clés pour rien.
	 * Les deux états d'immunité, eux, y entrent : le moteur annule les dégâts directs et les ticks
	 * de poison sur un INVINCIBLE, et refuse le soin instantané sur un UNHEALABLE. Les deux
	 * valeurs cachées sous cette graine en dépendent donc, le danger d'une cellule pour l'un et
	 * le net pour l'autre. La graine étant la SOURCE UNIQUE des clés de cellule, de net et de
	 * fuite, les y poser une fois couvre tous les consommateurs d'un seul geste.
	 */
	static targetDefensePack(CurAbs, CurRel, AntidoteCd, TargetStates) {
		return ((TargetStates & STATE_KEY_MASK) << STATE_KEY_SHIFT) | ((CurAbs & ABS_MASK) << ABS_SHIFT) | ((CurRel & REL_MASK) << REL_SHIFT) | AntidoteCd
	}

	/*
	 * Part INVARIANTE du pack de couple : le type de la cible et son cooldown d'antidote. Ni
	 * l'un ni l'autre ne bouge le long d'une chaîne de vulnés ni d'un caster à l'autre — le
	 * déroulé les repackait pourtant à chaque combo.
	 * L'invincibilité les rejoint : elle est fixe sur toute la chaîne comme eux, et elle décide ce
	 * que vaut chaque effet. Elle SEULE — l'incurabilité ne change aucun dégât, la porter ici
	 * scinderait gabarits et listes de dégâts en deux mondes identiques.
	 */
	static targetFixedPack(IsSummon, AntidoteCd, TargetStates) {
		return ((TargetStates & INVINCIBLE_KEY_MASK) << STATE_KEY_SHIFT) | ((IsSummon ? 1 : 0) << TARGET_TYPE_SHIFT) | AntidoteCd
	}

	/*
	 * Pack du couple : les boucliers COURANTS de la chaîne, étendus de la part invariante.
	 * Les vues d'effets filtrent réellement par masque poireau/summon, donc deux types ne
	 * doivent jamais partager une liste de dégâts ni un combo. Mêmes champs, mêmes slots et
	 * mêmes masques que targetDefensePack : le `|` étant associatif, la valeur est identique.
	 */
	static targetPairPackWith(CurAbs, CurRel, Fixed) {
		return ((CurAbs & ABS_MASK) << ABS_SHIFT) | ((CurRel & REL_MASK) << REL_SHIFT) | Fixed
	}

	/* Cooldown effectif d'Antidote, 99 quand l'item n'est pas dans l'inventaire. Calculé UNE
	 * fois par évaluation de cible puis transporté en scalaire. */
	static antidoteCdOf(TargetStats) {
		// Memoise sur l'objet stat, meme contrat que CAP_MEMO : son unique input est le
		// cooldown effectif d'Antidote, qu'invalide antidoteChanged dans diffMaskOf. Evite la
		// remontee de chaine ITEM_STATE_PARENT a chaque evaluation de cible.
		var memo = TargetStats.ANTICD_MEMO
		if (memo != null) return memo
		var eff = StateClass.cooldownOf(TargetStats, CHIP_ANTIDOTE)
		var cd = (eff == null) ? 99 : eff
		TargetStats.ANTICD_MEMO = cd
		return cd
	}

	/*
	 * Pack OFFENSIF canonique du caster : classe de crit + stats qui pilotent les formules de
	 * dégâts. Stats clampées à 0 (le moteur plancher à l'usage : une stat shacklée négative
	 * produit le même danger que 0), TOTAL_TP car le danger est le potentiel du PROCHAIN tour.
	 * COMPROMIS ASSUMÉ (README) : la LIFE courante du caster n'entre PAS dans le pack — la
	 * projection d'un LIFE_DAMAGE peut rester celle cachée avant des dégâts non létaux ce tour
	 * (une mort reste immédiatement visible via vivant/mort) ; l'exactitude coûtait +6,31 %.
	 * Slots : POWER 0-14, TOTAL_TP 15-29, MAGIC 30-44, STRENGTH 45-59, crit 62.
	 */
	static casterOffensivePack(CasterStats, CritFactor) {
		var critBit = (CritFactor > 1) ? 1 : 0
		return (critBit << 62) | (max(0, CasterStats.STRENGTH) << 45) | (max(0, CasterStats.MAGIC) << 30) | (max(0, CasterStats.TOTAL_TP) << 15) | CasterStats.POWER
	}

	/*
	 * Facteur de crit binaire asymétrique d'un caster (doctrine dans Constants) : un caster
	 * ADVERSE est craint critique dès MIN_AGILITY_ENEMY_CRIT, un allié n'est crédité qu'à
	 * partir de MIN_AGILITY_TO_FULLY_CRIT (on ne compte pas sur sa chance).
	 */
	static critFactorOf(CasterStats) {
		return critFactorAt(CasterStats, CasterStats.AGILITY)
	}

	/* Le meme facteur pour une AGILITE imposee : celle d'apres deplacement, quand le palier
	 * retenu passe par Saut et pose ses +100. */
	static critFactorAt(CasterStats, Agility) {
		var critAt = (CasterStats.SIDE != getSide(Me)) ? MIN_AGILITY_ENEMY_CRIT : MIN_AGILITY_TO_FULLY_CRIT
		return (Agility >= critAt) ? CRITICAL_FACTOR : 1
	}

	/* Facteurs critiques des QUATRE paliers de deplacement — SOURCE UNIQUE de la regle.
	 * Saut pose RAW_BUFF_AGILITY 100 des le cast : tout ce qui se joue depuis un palier
	 * sauteur (1 et 3) porte donc ce bonus. On ne separe pas au sein d'un palier ce qui
	 * aurait pu se passer du saut : son cout est paye de toute facon, et sauter d'une case
	 * puis revenir est toujours possible. */
	static tierCritFactorsOf(CasterStats) {
		var base = critFactorOf(CasterStats)
		var jumped = critFactorAt(CasterStats, CasterStats.AGILITY + JUMP_AGILITY_BUFF)
		return [base, jumped, base, jumped]
	}

	/* Classe d'agilite d'un caster pour les empreintes de contexte — SOURCE UNIQUE.
	 * Les quatre seuils que le danger peut franchir : les deux seuils de crit, et les memes
	 * diminues des 100 AGI que Saut pose. Sans les seuils sautes, deux etats de meme classe
	 * de base mais de classe SAUTEE differente (AGI 800 et 900 pour un allie) partageraient
	 * une empreinte et donc une carte de danger. */
	static critClassOf(Agility) {
		if (Agility >= MIN_AGILITY_TO_FULLY_CRIT) return 4
		if (Agility >= MIN_AGILITY_TO_FULLY_CRIT - JUMP_AGILITY_BUFF) return 3
		if (Agility >= MIN_AGILITY_ENEMY_CRIT) return 2
		if (Agility >= MIN_AGILITY_ENEMY_CRIT - JUMP_AGILITY_BUFF) return 1
		return 0
	}

	/* Clé CANONIQUE du couple (caster, cible-avec-ses-shields-courants) — SOURCE UNIQUE.
	 * Clé de DANGER_ENTITY_CACHE, et racine des clés de combo : plus aucune seconde fonction
	 * ne repacke les mêmes champs. L'id du caster est dedans : sa liste d'items lui est propre. */
	/* Premier pas de la chaîne, fonction du SEUL identifiant du caster : le plan le précalcule
	 * une fois par caster au lieu de le refaire à chaque combo et à chaque cellule. */
	static casterSeedOf(CasterId) {
		return (OFFSET_BASIS ^ CasterId) * MIX_A
	}

	static dangerPairKey(CasterSeed, CasterPack, TargetPack) {
		// Chaîne à MULTIPLICATION (contrat des clés, famille 3b) et non addValueToBinHash : les
		// deux packs sont LARGES — celui de la cible occupe 51 bits — et une chaîne linéaire les
		// fait se recouvrir au lieu de les séparer. Mesuré collisionnant : 267 combos servis
		// pour d'autres entrées sur un seul combat.
		// Pas de finaliseur : la clé n'est comparée qu'entière, et le hash de contenu auquel
		// elle est ensuite combinée est déjà avalanché.
		var h = (CasterSeed ^ TargetPack) * MIX_A
		return (h ^ CasterPack) * MIX_A
	}

	/*
	 * Meilleur combo du caster sur la cible, vulnés comprises.
	 *
	 * @param ItemAoeMap [item -> minAoeDist] des items du caster qui atteignent la cellule
	 * @param ContentHash hash de contenu d'ItemAoeMap, mémorisé par l'appelant
	 * @param CasterPack / CritFactor packs du plan, déjà calculés une fois pour tout le tour
	 * @param curAbs/curRel shields COURANTS de la cible (scalaires portés par la chaîne)
	 * @return [dégâts, absFinal, relFinal] — que des scalaires, aucune référence retenue
	 */
	static comboOfCaster(ItemAoeMap, ContentHash, CasterSeed, CasterPack, CritFactor, CasterStats, TargetStats, curAbs, curRel, AntidoteCd, TargetFixed, TpCost) {
		// CONTRAT : la map d'items n'est jamais vide — elle vient d'une couverture, et
		// buildMapCellItemAoe ne crée l'entrée d'une cellule qu'en y écrivant un item.
		var isSummon = TargetStats.IS_SUMMON
		var pairKey = dangerPairKey(CasterSeed, CasterPack, targetPairPackWith(curAbs, curRel, TargetFixed))
		// Le surcoût de franchissement entre dans la clé : le même caster, sur deux cellules
		// couvertes par les mêmes items, ne joue pas le même combo selon qu'il doit sauter
		// pour y arriver ou non.
		var comboKey = addTwoValuesToBinHash(pairKey, ContentHash, TpCost)
		if (comboKey in COMBO_FROM_ITEM_AOE_CACHE) return COMBO_FROM_ITEM_AOE_CACHE[comboKey]

		// TOTAL_TP : le danger représente le potentiel max du prochain tour, pas les TP
		// restants de ce tour — stable d'un step de BFS à l'autre.
		// Clé du gabarit : la clé du couple à BOUCLIERS NULS. Invariante sur toute la chaîne
		// de vulnés (seuls les boucliers y varient), donc calculée une seule fois, après le
		// cache de combo pour qu'un hit ne la paie jamais.
		var templateKey = dangerPairKey(CasterSeed, CasterPack, targetPairPackWith(0, 0, TargetFixed))
		// Ce que le franchissement lui prend n'est plus disponible pour attaquer. Planché à
		// zéro : un budget négatif ne joue rien, comme un budget nul.
		var baseTp = max(0, CasterStats.TOTAL_TP - TpCost)
		// Uses : racine TOUJOURS zéro (caster jamais Me, EntityState initialise à 0 et le
		// danger est son prochain tour) — playedUses est l'overlay SPARSE des seuls items
		// consommés par la chaîne, null tant qu'aucun ne l'est.
		var playedUses = null
		var best = greedyDamage(ItemAoeMap, pairKey, templateKey, CasterStats, TargetStats, CritFactor, AntidoteCd, curAbs, curRel, baseTp, playedUses, -1, 0)

		// Les vulnés jouées d'abord peuvent améliorer le combat : on retient la meilleure tant
		// qu'elle bat STRICTEMENT le total courant. Aucun candidat REJETÉ n'alloue quoi que ce
		// soit — ni tableau de shields, ni structure de résultat, ni clone de l'overlay.
		var vulneEffs = isSummon ? 1 : 0   // sélection de vue résolue une fois hors boucle
		var targetAlive = TargetStats.LIFE > 0
		// Facteurs de conservation des debuffs RETENUS, dans l'ordre : les echeances de bouclier
		// doivent les subir comme les lignes qu'elles retirent. Reste null dans l'immense
		// majorite des combos, aucun n'ayant de debuff.
		var keeps = null
		while (true) {
			var bestDamage = 0
			var bestItem = -1
			var bestAbs = 0
			var bestRel = 0
			var bestTp = 0
			var bestUses = 0
			var bestKeeps = null
			for (var item: var aoe in ItemAoeMap) {
				var Infos = ITEMINFO[item]
				// Le test le plus sélectif d'abord : la plupart des items atteignant la cellule
				// ne sont pas des vulnérabilités, et l'overlay d'usages n'a alors pas à être
				// consulté. Mêmes trois conditions, court-circuitées dans un autre ordre.
				if (!Infos.IS_VULNERABILITY) continue
				var used = (playedUses == null) ? 0 : ((item in playedUses) ? playedUses[item] : 0)
				if (used < Infos.MAX_USES && baseTp >= Infos.COST) {
					// Shields après cette vulné, EN SCALAIRES. Ordre des lignes et facteur
					// critique conservés, ABS puis REL pour le debuff. Cible morte ou vue
					// vide : shields inchangés (l'ancien isHitable refusait tout sur un mort).
					var newAbs = curAbs
					var newRel = curRel
					var thisKeeps = null
					if (targetAlive) {
						var effs = vulneEffs ? Infos.DANGER_VULNE_EFFECTS_ENEMY_SUMMON : Infos.DANGER_VULNE_EFFECTS_ENEMY_LEEK
						if (effs != null) {
							// Décroissance de zone : le moteur multiplie la valeur de CHAQUE
							// vulnérabilité et de chaque débuff par le facteur d'aire avant
							// d'arrondir (EffectVulnerability.java:11, EffectDebuff.java:10 :
							// (v1 + v2·jet) · aoe · criticalPower). Le gabarit de dégâts l'applique
							// déjà (son `distFactor`) ; cette chaîne l'oubliait, et voyait la
							// cible plus vulnérable qu'elle ne le sera.
							var fall = AOE_FALLOFF[aoe]
							for (var eff in effs) {
								var EffType = eff[0]
								// Le debuff TOTAL se reduit comme l'autre du point de vue des boucliers : la
								// chaine ne transporte que deux agregats, et un bouclier n'est jamais
								// irreductible. La difference des deux effets ne se voit qu'au ledger.
								if (EffType == EFFECT_DEBUFF || EffType == EFFECT_TOTAL_DEBUFF) {
									// Le moteur TRONQUE le pourcentage à l'entier, puis réduit
									// chaque ligne par round(|v| · r) · signe(v). Sur des shields
									// AGRÉGÉS on applique la même règle d'arrondi à l'agrégat :
									// même granularité que le moteur, sans son détail par ligne.
									var keep = max(0, 1 - floor(eff[1] * fall * CritFactor) / 100)   // clampé : un débuff crité peut dépasser 100%
									if (thisKeeps == null) thisKeeps = []
									push(thisKeeps, keep)
									newAbs = newAbs >= 0 ? round(newAbs * keep) : -round(-newAbs * keep)   // ABS puis REL, même ordre qu'avant
									newRel = newRel >= 0 ? round(newRel * keep) : -round(-newRel * keep)
								} else if (EffType == EFFECT_VULNERABILITY) {
									// Montant arrondi à l'entier et appliqué seulement s'il est
									// strictement positif, comme EffectVulnerability.
									var relDrop = round(eff[1] * fall * CritFactor)
									if (relDrop > 0) newRel -= relDrop
								} else {   // EFFECT_ABSOLUTE_VULNERABILITY
									var absDrop = round(eff[1] * fall * CritFactor)
									if (absDrop > 0) newAbs -= absDrop
								}
							}
						}
					}
					var thisTp = baseTp - Infos.COST
					var thisUses = used + 1
					var newPairKey = dangerPairKey(CasterSeed, CasterPack, targetPairPackWith(newAbs, newRel, TargetFixed))
					var damages = greedyDamage(ItemAoeMap, newPairKey, templateKey, CasterStats, TargetStats, CritFactor, AntidoteCd, newAbs, newRel, thisTp, playedUses, item, thisUses)
					if (bestDamage < damages) {   // strict : à égalité, le PREMIER item gagne
						bestDamage = damages
						bestItem = item
						bestAbs = newAbs
						bestRel = newRel
						bestTp = thisTp
						bestUses = thisUses
						bestKeeps = thisKeeps
					}
				}
			}
			if (bestItem == -1 || bestDamage <= best) break
			best = bestDamage
			curAbs = bestAbs
			curRel = bestRel
			baseTp = bestTp
			if (bestKeeps != null) {
				if (keeps == null) keeps = []
				for (var kv in bestKeeps) push(keeps, kv)
			}
			// SEUL le candidat retenu matérialise l'overlay : création si null, sinon un unique
			// clone. L'overlay du parent n'est jamais muté.
			playedUses = (playedUses == null) ? [: ] : clone(playedUses)
			playedUses[bestItem] = bestUses
		}
		var entry = [best, curAbs, curRel, keeps]
		COMBO_FROM_ITEM_AOE_CACHE[comboKey] = entry
		return entry
	}

	/*
	 * Combo glouton sans vulné : empile les items par dégâts/TP décroissant (liste triée
	 * d'EntityDanger) dans le budget TP + MAX_USES.
	 *
	 * Volontairement NON caché : sa clé serait un sur-ensemble strict de celle du combo, donc
	 * tout hit possible est déjà intercepté en amont par COMBO_FROM_ITEM_AOE_CACHE.
	 *
	 * CandidateItem/-Uses forment un overlay VIRTUEL : la valeur du candidat remplace (ou
	 * ajoute) son entrée sans cloner l'overlay engagé. CandidateItem = -1 quand il n'y en a pas.
	 *
	 * @return dégâts totaux du combo
	 */
	static greedyDamage(ItemAoeMap, PairKey, TemplateKey, CasterStats, TargetStats, CritFactor, AntidoteCd, curAbs, curRel, CasterTP, PlayedUses, CandidateItem, CandidateUses) {
		var EntityDangerArray = EntityDangerClass.getByPairKey(PairKey, TemplateKey, CasterStats, TargetStats, CritFactor, AntidoteCd, curAbs, curRel)
		var _final = 0
		var tp = CasterTP
		for (var EntityDanger in EntityDangerArray) {
			var ItemEntityDanger = EntityDanger.Item
			if (ItemAoeMap[ItemEntityDanger] != EntityDanger.Aoe) continue
			var CostEntityDanger = EntityDanger.Cost
			// Hors budget : la boucle ci-dessous ne tournerait pas une seule fois. Le compte
			// d'usages restants et le plafond de l'item ne servent alors à rien — or les
			// dernières lignes d'une liste triée par dégâts par TP sont justement celles que
			// le budget épuisé refuse.
			if (tp < CostEntityDanger) continue
			var MaxUsesOfItem = ITEMINFO[ItemEntityDanger].MAX_USES
			var itemUses
			if (ItemEntityDanger == CandidateItem) {
				itemUses = CandidateUses
			} else {
				itemUses = (PlayedUses == null) ? 0 : ((ItemEntityDanger in PlayedUses) ? PlayedUses[ItemEntityDanger] : 0)
			}
			while (tp >= CostEntityDanger && itemUses < MaxUsesOfItem) {
				_final += EntityDanger.Damages
				tp -= CostEntityDanger
				itemUses++
			}
		}
		return _final
	}
}
