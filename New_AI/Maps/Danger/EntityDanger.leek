/*
 * EntityDanger : pour un couple (caster, cible), la liste triée des items du caster avec
 * leurs dégâts sur la cible à chaque distance d'AoE possible — la matière première des
 * combos de la danger map.
 */

include("../../includes.leek")

// Libération/Debuff reste VOLONTAIREMENT dans la géométrie et les candidats de vulné :
// elle peut retirer les shields avant le combo de dégâts. Son Damage direct nul l'empêche
// déjà d'entrer comme attaque brute — ne pas la filtrer pour gratter des opés.
class EntityDangerClass {
	Item
	Aoe
	Damages
	Cost
	DamagesPerTp
	constructor(ItemId, AoeDist, DamageOnTarget, CostOfItem, DamagesPerTpOfItem) {
		this.Item = ItemId
		this.Aoe = AoeDist
		this.Damages = DamageOnTarget
		this.Cost = CostOfItem
		this.DamagesPerTp = DamagesPerTpOfItem
	}

	/*
	 * Liste triée (dégâts/TP décroissant) des (item, aoeDist, dégâts) du caster sur la cible.
	 * Cachée par MapHash (stats offensives du caster + shields/antidote de la cible).
	 * Les formules de dégâts (ex-ConsequencesClass.getItemDanger, unique appelant) vivent
	 * ICI : les facteurs invariants du couple (caster, cible) sont hoistés HORS des boucles
	 * item/distance — sous-expressions IDENTIQUES, mêmes chaînes de multiplication, mêmes
	 * additions successives et soustraction d'ABS par effet (parité flottante stricte).
	 */
	static get(CasterStats, TargetStats, curAbs, curRel) {
		var Hash = MapHash(CasterStats, TargetStats, curAbs, curRel)
		// ====== DIAGNOSTIC #3 — À RETIRER (revert) ======
		if (DIAG3_CELL != 0 && DIAG3_TRACES < DIAG3_MAX) {
			debugW("[DIAG3]        [items] DANGER_ENTITY_CACHE : " + ((Hash in DANGER_ENTITY_CACHE) ? ("HIT -> " + count(DANGER_ENTITY_CACHE[Hash]) + " entrées") : "MISS")
				+ " | caster " + CasterStats.ID + " vs cible ABS " + curAbs + " / REL " + curRel)
		}
		// ===============================================
		if (Hash in DANGER_ENTITY_CACHE) return DANGER_ENTITY_CACHE[Hash]
		var Tmp = []
		// Garde cible morte : liste vide — l'ancienne garde de getItemDanger rendait 0 à
		// chaque distance, donc aucun EntityDanger n'était créé.
		if (TargetStats.LIFE > 0) {
			var powerFactor = 1 + CasterStats.POWER / 100
			var strengthFactor = 1 + max(0, CasterStats.STRENGTH) / 100 // plancher à l'usage, comme le moteur
			var magicFactor = 1 + max(0, CasterStats.MAGIC) / 100
			// Crit binaire asymétrique (Constants), appliqué AVANT les shields comme le
			// moteur : (d·1.3 − ABS) ≠ (d − ABS)·1.3.
			var critFactor = DangerClass.critFactorOf(CasterStats)
			// Shields de la cible en SCALAIRES (la chaîne de vulnés ne mute jamais l'objet).
			var shieldFactor = 1 - curRel / 100
			var lifeFactor = CasterStats.LIFE / 100
			// 99 = pas d'antidote dans l'inventaire (jamais de cure -> le poison compte sa
			// durée PLEINE), distinct d'un antidote prêt (0).
			var effAntidoteCd = StateClass.cooldownOf(TargetStats, CHIP_ANTIDOTE)
			var antidoteCd = (effAntidoteCd == null) ? 99 : effAntidoteCd
			var isSummonTarget = TargetStats.IS_SUMMON
			for (var i in getItemsList(CasterStats)) {
				var Multiplier = 1 // Plasma évalué à multiplicateur 1 (compromis, voir README)
				var Infos = ITEMINFO[i]
				// Vue préfiltrée (ENEMIES + type de cible, ON_CASTER exclu) sélectionnée UNE
				// fois par item ; null = aucun effet de dégâts applicable.
				var effs = isSummonTarget ? Infos.DANGER_DAMAGE_EFFECTS_ENEMY_SUMMON : Infos.DANGER_DAMAGE_EFFECTS_ENEMY_LEEK
				if (effs == null) continue
				var CostOfItem = Infos.COST
				var MaxAoeDist = MapDistPossibles[Infos.AREA]
				var AddingDist = MapAdditionDist[Infos.AREA]
				for (var aoe = 0; aoe <= MaxAoeDist; aoe += AddingDist) {
					var distFactor = 1 - (aoe * 0.2)
					var Damage = 0
					for (var eff in effs) {
						switch (eff[0]) {
							case EFFECT_DAMAGE:
								Damage += (eff[2] * distFactor * Multiplier * powerFactor * strengthFactor * critFactor * shieldFactor - curAbs)
								break
							case EFFECT_LIFE_DAMAGE:
								Damage += (eff[2] * powerFactor * lifeFactor * critFactor * shieldFactor - curAbs)
								break
							case EFFECT_POISON:
								Damage += eff[2] * powerFactor * distFactor * magicFactor * critFactor * min(eff[3], antidoteCd + 1)
								break
						}
					}
					if (Damage <= 0) continue
					var DamagesPerTpOfItem = Damage / CostOfItem
					var DangerMap = new EntityDangerClass(i, aoe, Damage, CostOfItem, DamagesPerTpOfItem)
					push(Tmp, DangerMap)
				}
			}
		}
		var _final = SortTmp(Tmp)
		DANGER_ENTITY_CACHE[Hash] = _final
		return _final
	}

	/* Items menaçants castables de l'entité (cooldown <= 1), cachés par id pour le tour.
	 * Parcourt INVENTORY (même ordre que l'ancienne map de cooldowns) + cooldown effectif. */
	static getItemsList(EntityStats) {
		var Hash = EntityStats.ID
		if (Hash in DANGER_ENTITY_INVENTORY) return DANGER_ENTITY_INVENTORY[Hash]
		var _final = []
		for (var i in EntityStats.INVENTORY) {
			if (StateClass.cooldownOf(EntityStats, i) > 1) continue
			if (ITEMINFO[i].IS_DANGER_ITEM) {
				push(_final, i)
			}
		}
		DANGER_ENTITY_INVENTORY[Hash] = _final
		return _final
	}

	static SortTmp(ActualTmp) {
		return arraySort(ActualTmp, function(a, b) {
			return b.DamagesPerTp - a.DamagesPerTp
		})
	}

	/*
	 * Clé du couple (caster, cible) : id + stats offensives du caster (TOTAL_TP = potentiel
	 * max du prochain tour, stats clampées à 0) + shields/antidote de la cible (masqués à
	 * leur slot : une vulné est un shield négatif ; antidote 99 = pas de chip, distinct
	 * de prêt). COMPROMIS ASSUMÉ (documenté au README) : la LIFE courante du caster n'entre
	 * PAS dans la clé — la projection d'un LIFE_DAMAGE peut rester celle cachée avant des
	 * dégâts non létaux ce tour (une mort reste immédiatement visible via vivant/mort) ;
	 * l'exactitude coûtait une invalidation globale mesurée à +6,31 %.
	 */
	static MapHash(EntityStats, MyStats, curAbs, curRel) {
		var hash_value = (OFFSET_BASIS ^ EntityStats.ID)

		var effAntidoteCdMe = StateClass.cooldownOf(MyStats, CHIP_ANTIDOTE)
		var antidoteCdMe = (effAntidoteCdMe == null) ? 99 : effAntidoteCdMe
		// Bit 50 = type de la cible (poireau/summon) : les vues de dégâts filtrent les effets par
		// leurs masques NON_SUMMONS/SUMMONS — deux types ne partagent jamais une liste. Les
		// shields sont ceux COURANTS de la chaîne (scalaires), pas l'objet cible.
		var combinedMe = ((MyStats.IS_SUMMON ? 1 : 0) << 50) | ((curAbs & 0xFFFFF) << 30) | ((curRel & 0x7FFF) << 15) | antidoteCdMe
		hash_value = addValueToBinHash(hash_value, combinedMe)

		// Bit 62 = classe de crit du caster (les valeurs d'items en dépendent depuis que
		// les formules de get appliquent le crit avant les shields).
		var critBit = (DangerClass.critFactorOf(EntityStats) > 1) ? 1 : 0
		var combinedEnemy = (critBit << 62) | (max(0, EntityStats.TOTAL_TP) << 45) | (max(0, EntityStats.STRENGTH) << 30) | (max(0, EntityStats.MAGIC) << 15) | EntityStats.POWER
		hash_value = addValueToBinHash(hash_value, combinedEnemy)

		return hash_value
	}

	static MapDistPossibles = [
		AREA_CIRCLE_1: 1,
		AREA_CIRCLE_2: 2,
		AREA_CIRCLE_3: 3,
		AREA_FIRST_INLINE: 0,
		AREA_LASER_LINE: 0,
		AREA_PLUS_1: 1,
		AREA_PLUS_2: 2,
		AREA_PLUS_3: 3,
		AREA_POINT: 0,
		AREA_SQUARE_1: 2,
		AREA_SQUARE_2: 4,
		AREA_X_1: 2,
		AREA_X_2: 4,
		AREA_X_3: 6
	]

	static MapAdditionDist = [
		AREA_CIRCLE_1: 1,
		AREA_CIRCLE_2: 1,
		AREA_CIRCLE_3: 1,
		AREA_FIRST_INLINE: 1,
		AREA_LASER_LINE: 1,
		AREA_PLUS_1: 1,
		AREA_PLUS_2: 1,
		AREA_PLUS_3: 1,
		AREA_POINT: 1,
		AREA_SQUARE_1: 1,
		AREA_SQUARE_2: 1,
		AREA_X_1: 2,
		AREA_X_2: 2,
		AREA_X_3: 2
	]
}
