/*
 * EntityDanger : pour un couple (caster, cible), la liste triée des items du caster avec
 * leurs dégâts sur la cible à chaque distance d'AoE possible — la matière première des
 * combos de la danger map.
 */

include("../../includes.leek")

// Libération/Debuff reste VOLONTAIREMENT dans la géométrie et les candidats de vulné :
// elle peut retirer les shields avant le combo de dégâts. Son Damage direct nul l'empêche
// déjà d'entrer comme attaque brute — ne pas la filtrer pour gratter des opés.
class EntityDangerClass {
	Item
	Aoe
	Damages
	Cost
	DamagesPerTp
	constructor(ItemId, AoeDist, DamageOnTarget, CostOfItem, DamagesPerTpOfItem) {
		this.Item = ItemId
		this.Aoe = AoeDist
		this.Damages = DamageOnTarget
		this.Cost = CostOfItem
		this.DamagesPerTp = DamagesPerTpOfItem
	}

	// Nature d'une ligne du gabarit : ce qui reste à lui appliquer une fois les boucliers connus.
	static TPL_DAMAGE = 0    // · shieldFactor − curAbs
	static TPL_POISON = 1    // rien, la valeur est entière
	static TPL_LIFE = 2      // · lifeFactor · critFactor · shieldFactor − curAbs
	static TPL_MULTI = 3     // plusieurs effets, chacun avec sa propre nature

	/*
	 * Liste triée (dégâts/TP décroissant) des (item, aoeDist, dégâts) du caster sur la cible.
	 * Clé = la clé canonique du couple, calculée UNE fois par l'appelant (DangerComboClass) :
	 * le lookup précède tout facteur froid, un hit ne recalcule aucune formule.
	 *
	 * Au miss, l'énumération et tout ce qui ne dépend PAS des boucliers viennent du gabarit
	 * (templateFor) : il ne reste ici que le facteur de bouclier et la soustraction d'ABS.
	 * Les chaînes de multiplication sont coupées à l'endroit EXACT où la dépendance aux
	 * boucliers commence, donc l'associativité gauche-à-droite est préservée terme à terme et
	 * les flottants sont identiques au bit près. La vie du caster reste lue ICI : LIFE n'est
	 * pas dans la clé, la sortir du gabarit lui interdit de figer une vie périmée.
	 */
	static getByPairKey(PairKey, TemplateKey, CasterStats, TargetStats, CritFactor, AntidoteCd, curAbs, curRel) {
		if (PairKey in DANGER_ENTITY_CACHE) return DANGER_ENTITY_CACHE[PairKey]
		var Tmp = []
		// Garde cible morte : liste vide — l'ancienne garde de getItemDanger rendait 0 à
		// chaque distance, donc aucun EntityDanger n'était créé.
		if (TargetStats.LIFE > 0) {
			// Shields de la cible en SCALAIRES (la chaîne de vulnés ne mute jamais l'objet).
			var shieldFactor = 1 - curRel / 100
			var lifeFactor = CasterStats.LIFE / 100
			for (var row in templateFor(TemplateKey, CasterStats, TargetStats.IS_SUMMON, CritFactor, AntidoteCd, EntityStateClass.hasState(TargetStats, STATE_INVINCIBLE))) {
				var Damage = 0
				var kind = row[3]
				if (kind == TPL_DAMAGE) {
					Damage += (row[4] * shieldFactor - curAbs)
				} else if (kind == TPL_MULTI) {
					// Natures et valeurs alternées à la queue de la ligne, dans l'ordre de la vue
					// d'effets : les additions successives se suivent exactement comme avant.
					// Chaque terme est planché à zéro SÉPARÉMENT, comme le moteur qui applique
					// max(0, d) à chaque effet (EffectDamage.java:27) — un effet est un objet
					// distinct, Attack.java:264 appelle createEffect une fois par effet. Sans ce
					// plancher, le résidu NÉGATIF d'un dégât direct que le bouclier absolu absorbe
					// entièrement se soustrait au poison du MÊME item, qui lui ne voit aucun
					// bouclier (EffectPoison.java:12). Quatre items mélangent les deux : double_gun,
					// flame_thrower, excalibur et burning. Le plancher change aussi la valeur des
					// items à plusieurs dégâts, dont le bouclier absolu se retranche désormais ligne
					// à ligne : machine_gun, illicit_grenade_launcher et devil_strike.
					var n = count(row)
					for (var j = 4; j < n; j += 2) {
						var k = row[j]
						var v = row[j + 1]
						if (k == TPL_DAMAGE) Damage += max(0, v * shieldFactor - curAbs)
						else if (k == TPL_POISON) Damage += v
						else Damage += max(0, v * lifeFactor * CritFactor * shieldFactor - curAbs)
					}
				} else if (kind == TPL_POISON) {
					Damage += row[4]
				} else {
					Damage += (row[4] * lifeFactor * CritFactor * shieldFactor - curAbs)
				}
				if (Damage <= 0) continue
				var CostOfItem = row[2]
				var DamagesPerTpOfItem = Damage / CostOfItem
				var DangerMap = new EntityDangerClass(row[0], row[1], Damage, CostOfItem, DamagesPerTpOfItem)
				push(Tmp, DangerMap)
			}
		}
		var _final = SortTmp(Tmp)
		DANGER_ENTITY_CACHE[PairKey] = _final
		return _final
	}

	/*
	 * Gabarit du couple SANS ses boucliers : une ligne [item, aoeDist, coût, nature, valeur]
	 * par (item, distance d'AoE) atteignable, dans l'ordre d'énumération d'origine — l'ordre
	 * décide des égalités du tri, il ne bouge pas.
	 *
	 * Sa clé est la clé du couple à boucliers nuls : seuls curAbs et curRel en sont retirés,
	 * aucun champ n'est ajouté ni relâché. C'est ce qui le rend chaud — la chaîne de vulnés
	 * fait varier les boucliers et RIEN d'autre, soit ~9 listes de dégâts par gabarit.
	 *
	 * Une ligne à effet unique porte sa valeur directement ; au-delà, elle porte la liste de
	 * ses effets, chacun avec sa nature. Les items sans vue d'effets applicable et les
	 * distances sans le moindre effet de dégâts ne produisent aucune ligne, comme la boucle
	 * d'origine ne produisait aucun EntityDanger pour eux.
	 *
	 * L'invincibilité de la cible est tranchée ICI, une fois par gabarit : elle est dans la clé et
	 * ne dépend d'aucun bouclier. Les effets que le moteur annule totalement disparaissent de la
	 * ligne ; un dégât de VIE garde la sienne, à valeur nulle, parce que le moteur lui laisse la
	 * soustraction du bouclier absolu — que le lecteur applique déjà.
	 */
	static templateFor(TemplateKey, CasterStats, IsSummonTarget, CritFactor, AntidoteCd, TargetInvincible) {
		if (TemplateKey in DANGER_TEMPLATE_CACHE) return DANGER_TEMPLATE_CACHE[TemplateKey]
		var powerFactor = 1 + CasterStats.POWER / 100
		var strengthFactor = 1 + max(0, CasterStats.STRENGTH) / 100 // plancher à l'usage, comme le moteur
		var magicFactor = 1 + max(0, CasterStats.MAGIC) / 100
		// Crit binaire asymétrique, appliqué AVANT les shields comme le moteur :
		// (d·1.3 − ABS) ≠ (d − ABS)·1.3. Résolu une fois par le plan.
		// 99 en cooldown d'antidote = pas d'antidote dans l'inventaire (jamais de cure -> le
		// poison compte sa durée PLEINE), distinct d'un antidote prêt (0).
		var rows = []
		for (var i in getItemsList(CasterStats)) {
			// Plasma évalué à multiplicateur 1 (compromis, voir README) : aucun facteur ne
			// figure donc dans la chaîne de dégâts, multiplier par 1 rend le même flottant.
			var Infos = ITEMINFO[i]
			// Vue préfiltrée (ENEMIES + type de cible, ON_CASTER exclu) sélectionnée UNE
			// fois par item ; null = aucun effet de dégâts applicable.
			var effs = IsSummonTarget ? Infos.DANGER_DAMAGE_EFFECTS_ENEMY_SUMMON : Infos.DANGER_DAMAGE_EFFECTS_ENEMY_LEEK
			if (effs == null) continue
			var CostOfItem = Infos.COST
			var MaxAoeDist = Infos.AOE_DIST_MAX
			var AddingDist = Infos.AOE_DIST_STEP
			for (var aoe = 0; aoe <= MaxAoeDist; aoe += AddingDist) {
				var distFactor = 1 - (aoe * 0.2)
				// UNE seule allocation par ligne : le premier effet la crée à sa forme courte, un
				// second la bascule en forme longue sur place. Rien d'intermédiaire — la
				// construction est payée bien plus souvent qu'elle n'est amortie sur un combat
				// dont la cible porte peu de boucliers.
				var row = null
				for (var eff in effs) {
					var effType = eff[0]
					var kind = TPL_DAMAGE
					var value = 0
					if (effType == EFFECT_DAMAGE) {
						// Le moteur annule les dégâts directs APRÈS les boucliers : sur un invincible
						// la valeur est nulle quels que soient ces boucliers, la ligne n'a donc plus
						// rien à porter.
						if (TargetInvincible) continue
						value = eff[2] * distFactor * powerFactor * strengthFactor * CritFactor
					} else if (effType == EFFECT_POISON) {
						// Le tick est mis à zéro tant que le porteur est invincible, et aucun chip ne
						// pose cet état pour une durée finie : aucun tick projeté ne passe.
						if (TargetInvincible) continue
						kind = TPL_POISON
						value = eff[2] * powerFactor * distFactor * magicFactor * CritFactor * min(eff[3], AntidoteCd + 1)
					} else if (effType == EFFECT_LIFE_DAMAGE) {
						kind = TPL_LIFE
						// Coupée AVANT lifeFactor : la vie du caster n'est pas dans la clé.
						// Ici le moteur annule AVANT les boucliers : il reste la soustraction du
						// bouclier absolu, qui laisse passer des dégâts quand il est NÉGATIF. La ligne
						// survit donc à valeur nulle, et le lecteur en retranche curAbs comme d'habitude.
						value = TargetInvincible ? 0 : (eff[2] * powerFactor)
					} else {
						continue
					}
					if (row == null) {
						row = [i, aoe, CostOfItem, kind, value]
					} else {
						// Bascule : la nature du premier effet, jusque-là dans le slot 3, descend
						// derrière le marqueur et sa valeur repart en queue.
						if (row[3] != TPL_MULTI) {
							var firstKind = row[3]
							var firstValue = row[4]
							row[3] = TPL_MULTI
							row[4] = firstKind
							push(row, firstValue)
						}
						push(row, kind)
						push(row, value)
					}
				}
				if (row != null) push(rows, row)
			}
		}
		DANGER_TEMPLATE_CACHE[TemplateKey] = rows
		return rows
	}

	/* Items menaçants castables de l'entité (cooldown <= 1), cachés par id pour le tour.
	 * SOURCE UNIQUE de la qualification « ce caster menace-t-il ? » : une liste vide signifie
	 * qu'il ne compte dans aucune danger map.
	 * Parcourt INVENTORY (l'ordre d'insertion des items en dépend) + cooldown effectif. */
	/*
	 * TP que le caster gagnera EN NET a s'auto-buffer, et ce qu'il doit avancer pour cela,
	 * packes en (cout << 16) | net. Un auto-buff rentable n'est pas un arbitrage : personne
	 * ne refuse quatre TP contre un, donc il n'a rien a faire dans la chaine de candidats,
	 * ou il couterait un combo de plus par cellule et par pas.
	 *
	 * Constante du tour pour un non-Me : son inventaire ne bouge pas, et ses cooldowns non
	 * plus tant qu'il n'a pas rejoue. D'ou le cache par identifiant, sans autre cle.
	 *
	 * NE SONT PAS COMPTES, et c'est deliberé :
	 *  - les buffs de TP a l'ECHELLE (rage, fouet) : le moteur les multiplie par la SCIENCE
	 *    du lanceur (EffectBuffTP.java:11), or la science n'est dans aucune cle du danger et
	 *    prisme peut la changer en branche. Les compter demanderait de replier le gain dans
	 *    le TP EFFECTIF partout — pack offensif, empreinte de contexte et detection de
	 *    changement. Faisable, mais ce n'est plus une ligne. 24 des 56 porteurs de rage du
	 *    meta y gagneraient quelque chose sous la doctrine de critique adverse.
	 *  - les buffs de FORCE et de MAGIE (proteine, steroide, sorcellerie, prisme) : eux
	 *    changent le pack offensif du caster, donc la cle du gabarit de degats, que la chaine
	 *    tient pour invariante. Il faudrait reconstruire et retrier un gabarit par candidat.
	 *    Chiffre sur douze combats a jeu identique : +2,53 % des operations de toute l'IA,
	 *    contre +0,59 % pour la seule voie des TP. Faisable aussi, si le budget le permet.
	 */
	/* La partie INVARIANTE du tour : ce que l'inventaire du porteur peut lui rapporter, et ce
	 * qu'il doit avancer. Ni son inventaire ni ses cooldowns ne bougent pendant mon tour, d'ou
	 * le cache par identifiant seul — c'est aussi la partie chere, une remontee de cooldown
	 * par item. Rend null pour qui ne porte aucun auto-buff de TP, soit presque tout le monde. */
	static selfTpItemsOf(EntityStats) {
		var h = EntityStats.ID
		if (h in DANGER_SELF_TP_CACHE) return DANGER_SELF_TP_CACHE[h]
		var raw = 0
		var cost = 0
		var items = null
		for (var i in EntityStats.INVENTORY) {
			var inf = ITEMINFO[i]
			// Test le plus selectif d'abord : un seul item du jeu passe, inutile de remonter la
			// chaine de cooldowns pour tous les autres.
			if (inf.SELF_TP_RAW == 0) continue
			if (StateClass.cooldownOf(EntityStats, i) > 1) continue
			raw += inf.SELF_TP_RAW
			cost += inf.SELF_TP_COST
			if (items == null) items = [: ]
			items[i] = true
		}
		var _final = (raw > 0) ? [raw, cost, items] : null
		DANGER_SELF_TP_CACHE[h] = _final
		return _final
	}

	/*
	 * Ce que le porteur touche DEJA de ces memes items — SOURCE UNIQUE, et une ENTREE a part
	 * entiere de tout ce qui en depend.
	 *
	 * L'auto-buff n'est pas cumulable : le moteur retire la ligne de meme type et meme item,
	 * quel qu'en soit le lanceur, avant de poser la neuve (Effect.createEffect:240). Relancer
	 * ne rapporte donc que la DIFFERENCE, et le cast se paie quand meme.
	 *
	 * Ce montant NE SE DEDUIT PAS du TP total : Adrenaline +5 et Rage +5 donnent le meme total
	 * et des budgets differents — 17 en gardant sa ligne, 21 en lancant la sienne. Il entre
	 * donc dans les cles ET dans les empreintes, sans quoi deux branches se servent l'une
	 * l'autre selon l'ordre de lecture.
	 *
	 * Le ledger est relu ICI et nulle part ailleurs : la lecture est courte, elle est NULLE
	 * pour qui ne porte aucun de ces items, et aucun combo ne la paie.
	 *
	 * Une ligne MOURANTE est comptee comme vivante — arbitrage assume, pas de suivi
	 * d'echeance. L'ecart n'est pas borne et n'est pas toujours prudent : une ligne critique de
	 * +7 qui tombe avant le tour projete fait garder 19 la ou le moteur donnera 16.
	 */
	static selfTpHeldOf(EntityStats) {
		var it = selfTpItemsOf(EntityStats)
		if (it == null) return 0
		var items = it[2]
		var held = 0
		for (var eff in EntityStats.EFFECTS) {
			if (eff[0] != EFFECT_RAW_BUFF_TP) continue
			if (eff[5] in items) held += eff[1]
		}
		return held
	}

	/* Terme d'empreinte du montant deja porte : zero quand il n'y en a pas, donc les
	 * empreintes du cas courant restent bit pour bit celles d'avant. Multiplie et non
	 * concatene : il n'y a plus de bit libre dans ces packs, et le produit entre de toute
	 * facon dans un mix64 derriere. */
	static selfTpHeldTermOf(EntityStats) {
		var held = selfTpHeldOf(EntityStats)
		return held == 0 ? 0 : held * MIX_B
	}

	/* [brut, cout, deja porte] du porteur, ou null s'il n'a aucun auto-buff de TP jouable. */
	static selfTpProfileOf(EntityStats) {
		var it = selfTpItemsOf(EntityStats)
		if (it == null) return null
		return [it[0], it[1], selfTpHeldOf(EntityStats)]
	}

	/* TP REELLEMENT recus si le buff part avec ce facteur critique (EffectRawBuffTP :
	 * round((v1 + v2 x jet) x cibles x critique), jet minimal). */
	static selfTpValueAt(Profile, Crit) {
		return round(Profile[0] * Crit)
	}

	/* Gain NET du cast : ce qu'il recoit, moins ce qu'il perd en remplacant sa ligne, moins
	 * son cout. Planche a zero — ne PAS le lancer reste une option, et c'est la bonne des
	 * que la ligne en place vaut deja autant. */
	static selfTpGainAt(Profile, Crit) {
		var g = selfTpValueAt(Profile, Crit) - Profile[2] - Profile[1]
		return g > 0 ? g : 0
	}

	static getItemsList(EntityStats) {
		var Hash = EntityStats.ID
		if (Hash in DANGER_ENTITY_INVENTORY) return DANGER_ENTITY_INVENTORY[Hash]
		var _final = []
		for (var i in EntityStats.INVENTORY) {
			if (StateClass.cooldownOf(EntityStats, i) > 1) continue
			if (ITEMINFO[i].IS_DANGER_ITEM) {
				push(_final, i)
			}
		}
		DANGER_ENTITY_INVENTORY[Hash] = _final
		return _final
	}

	static SortTmp(ActualTmp) {
		return arraySort(ActualTmp, function(a, b) {
			return b.DamagesPerTp - a.DamagesPerTp
		})
	}

	static MapDistPossibles = [
		// Zones a l'echelle du CAMP (apocalypse, divine_protection) : toutes les cibles sont a
		// distance 0, il n'y a aucun palier de decroissance a balayer.
		AREA_ENEMIES: 0,
		AREA_ALLIES: 0,
		AREA_CIRCLE_1: 1,
		AREA_CIRCLE_2: 2,
		AREA_CIRCLE_3: 3,
		AREA_FIRST_INLINE: 0,
		AREA_LASER_LINE: 0,
		AREA_PLUS_1: 1,
		AREA_PLUS_2: 2,
		AREA_PLUS_3: 3,
		AREA_POINT: 0,
		AREA_SQUARE_1: 2,
		AREA_SQUARE_2: 4,
		AREA_X_1: 2,
		AREA_X_2: 4,
		AREA_X_3: 6
	]

	static MapAdditionDist = [
		AREA_ENEMIES: 1,
		AREA_ALLIES: 1,
		AREA_CIRCLE_1: 1,
		AREA_CIRCLE_2: 1,
		AREA_CIRCLE_3: 1,
		AREA_FIRST_INLINE: 1,
		AREA_LASER_LINE: 1,
		AREA_PLUS_1: 1,
		AREA_PLUS_2: 1,
		AREA_PLUS_3: 1,
		AREA_POINT: 1,
		AREA_SQUARE_1: 1,
		AREA_SQUARE_2: 1,
		AREA_X_1: 2,
		AREA_X_2: 2,
		AREA_X_3: 2
	]
}
