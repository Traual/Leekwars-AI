/*
 * Gravity map : score de placement par cellule, pour FinalCell (plus haut = mieux placé).
 * PAS un trade avec le danger (la sécurité est filtrée à part).
 *
 * Par cellule, somme sur chaque entité vivante hors Me (pondérée par l'importance) :
 *   - ennemis : attraction d'approche linéaire (plus près = plus haut)
 *   - alliés  : cohésion convexe 1 - (d/maxDist)^x — plate de près (liberté de chasser),
 *               pentue de loin (urgence de regrouper) ; plus une pénalité anti-cluster AoE
 *   - centre  : petite attraction vers le centre de la carte
 *   - COVID (gate myCovidValue > 0) : dans le rayon réel de contagion, récompense la
 *     proximité des ennemis (contaminer) et pénalise celle des alliés, à la vraie valeur de
 *     spread (engine-exact, voir myCovidValue). Le spread part au endTurn -> FinalCell est
 *     exactement le point de décision.
 */

include("../../includes.leek")

// Tunable weights
global GRAV_W_CENTER    = 0.01
global GRAV_W_ENEMY     = 0.20
global GRAV_W_ALLY      = 0.79
global GRAV_ALLY_POWER  = 3       // convexité cohésion : plus haut = plus plat près / plus pentu loin
global GRAV_AOE_RADIUS  = 2       // anti-cluster (rayon)
global GRAV_AOE_PENALTY = 0.3
global GRAV_COVID_W_PER_HP = 0.007 // covid : poids PAR HP de valeur de spread (≈ l'ancien 2.0 binaire pour un covid ~300)

// Constantes du chip COVID, lues une fois depuis ITEMINFO (lazy, dans myCovidValue). Moteur vérifié
// (Attack.java) : le rayon = value1 de l'effet TYPE_PROPAGATION, stampé sur le poison au cast ;
// la base = value1 du poison (roll MIN, pessimiste — même convention que la Heal Map).
global COVID_RANGE = null
global COVID_BASE  = null

// Map constant (NOT a tunable score)
global GRAV_MAXDIST     = 34      // distance max sur la carte, pour normaliser

class GravityClass {

    /* [cell -> gravity score] over the given cells. */
    static loadGravityMap(State, walkCells) {
        BenchOps.Start("Gravity")
        var mySide = getSide(Me)
        var centerCell = getCellFromXY(0, 0)
        var covid = myCovidValue()                        // GATE : > 0 = j'ai covid

        // Toutes les entités une fois : [cell, importance, isAlly].
        var ents = []
        for (var e: var stat in State) {
            if (stat.LIFE <= 0 || e == Me) continue
            push(ents, [stat.CELL, ImportanceClass.get(stat), stat.SIDE == mySide])
        }

        var _final = [: ]
        for (var cell: var _ in walkCells) {
            var g = GRAV_W_CENTER * (1 - CellClass.getDist(cell, centerCell) / GRAV_MAXDIST)
            for (var en in ents) {
                var d = CellClass.getDist(cell, en[0])
                var imp = en[1]
                if (en[2]) {                                                                  // ALLIÉ
                    g += GRAV_W_ALLY * imp * (1 - pow(d / GRAV_MAXDIST, GRAV_ALLY_POWER))      // cohésion convexe sommée
                    if (d < GRAV_AOE_RADIUS) g -= GRAV_AOE_PENALTY                             // anti-cluster
                    if (covid > 0 && d <= COVID_RANGE) g -= GRAV_COVID_W_PER_HP * covid * imp  // épargner l'allié (mes bulbes inclus)
                } else {                                                                       // ENNEMI
                    g += GRAV_W_ENEMY * imp * (1 - d / GRAV_MAXDIST)                          // approche linéaire sommée
                    if (covid > 0 && d <= COVID_RANGE) g += GRAV_COVID_W_PER_HP * covid * imp  // contaminer l'ennemi
                }
            }
            _final[cell] = g
        }
        BenchOps.Stop("Gravity")
        return _final
    }

    /* REAL spread value of my covid (0 = not infected -> the covid block stays dormant).
     * Engine-exact (Entity.endTurn -> Effect.createEffect FROM THE CHIP'S BASE PARAMS, verified):
     * what a neighbour receives = base · (1 + max(0, casterMagic)/100) · (1 + max(0, casterPower)/100)
     * · crit, recomputed at EVERY spread with the ORIGINAL caster's CURRENT stats (aoe = 1 in
     * propagation, the crit flag of my effect is carried). Deliberately NOT my local effect value:
     * a Liberation that shrinks MY value changes NOTHING to the spreads — and if the effect is
     * fully removed, getEffects stops returning it -> 0 here (gate closes). */
    static myCovidValue() {
        if (COVID_RANGE == null) {   // lazy chip constants (once per fight)
            for (var ceff in ITEMINFO[CHIP_COVID].EFFECTS) {
                if (ceff[0] == EFFECT_PROPAGATION) COVID_RANGE = ceff[1]
                if (ceff[0] == EFFECT_POISON) COVID_BASE = ceff[1]   // roll MIN (pessimiste)
            }
        }
        // getEffects layout: [0]=type, [1]=value, [2]=caster, [3]=turns, [4]=critical, [5]=item.
        for (var eff in getEffects(Me)) {
            if (eff[5] != CHIP_COVID || eff[0] != EFFECT_POISON) continue
            var m = getMagic(eff[2])   // caster D'ORIGINE, stats ACTUELLES (mort -> null -> 0)
            var p = getPower(eff[2])
            var value = COVID_BASE * (1 + max(0, m == null ? 0 : m) / 100) * (1 + max(0, p == null ? 0 : p) / 100) * (eff[4] ? CRITICAL_FACTOR : 1)
            debug("[COVID] value=" + value + " range=" + COVID_RANGE + " | raw effect=" + eff)   // TEMP validation (layout getEffects + valeurs) — à retirer après un combat covidé
            return value
        }
        return 0
    }

    /* TEMP debug: markText the gravity score on every map cell (heatmap to eyeball the field). */
    static debugVisual() {
        var State = StateClass.Virtualize()
        var allCells = [: ]
        for (var c = 0; c < 613; c++) allCells[c] = 0
        var gravity = loadGravityMap(State, allCells)
        clearMarks()
        for (var cell: var score in gravity) {
            markText(cell, round(score * 100) / 100)
        }
    }
}
