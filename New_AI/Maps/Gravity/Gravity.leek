/*
 * Coût de placement SPATIAL d'une cellule : ce que coûte d'y finir le tour, hors danger.
 *
 * Somme de coûts NON NÉGATIFS — plus bas = mieux placé, zéro = borne parfaite. Aucune
 * récompense n'est produite ici : une composante ne peut qu'ALOURDIR une cellule, jamais
 * l'alléger. C'est cet invariant qui rend la coupure du reclassement terminal exacte.
 *
 * Par cellule, somme sur chaque entité vivante hors Me :
 *   - distance : écart LINÉAIRE à une distance CIBLE propre à l'entité, |d − cible|, pondéré
 *     par son coefficient. Alliés et ennemis suivent la même forme — la cible dit OÙ se
 *     placer, le coefficient dit COMBIEN ça compte, et les deux viennent du contexte de poids.
 *     Une forme courbe n'apporterait rien de plus : elle ne saurait que déplacer une pente que
 *     le coefficient règle déjà.
 *   - anti-cluster : pénalité forfaitaire quand un allié est dans le rayon d'AoE
 *   - centre : petit coût d'éloignement au centre de la carte
 *   - COVID (gate myCovidValue > 0) : dans le rayon réel de contagion, coûte la proximité
 *     d'un allié (le contaminer) et coûte l'ÉLOIGNEMENT d'un ennemi (l'occasion manquée de
 *     le contaminer), à la vraie valeur de spread (engine-exact, voir covidValue). Le spread
 *     part au endTurn -> la cellule finale est exactement le point de décision.
 */

include("../../includes.leek")

// Tunable weights
global GRAV_W_CENTER    = 0.01
global GRAV_W_ENEMY     = 0.20
global GRAV_W_ALLY      = 0.79
global GRAV_AOE_RADIUS  = 2       // anti-cluster (rayon)
global GRAV_AOE_PENALTY = 0.3
global GRAV_COVID_W_PER_HP = 0.007 // covid : poids PAR HP de valeur de spread (≈ l'ancien 2.0 binaire pour un covid ~300)

// Constantes du chip COVID, lues une fois depuis ITEMINFO (lazy, dans covidValue). Moteur vérifié
// (Attack.java) : le rayon = value1 de l'effet TYPE_PROPAGATION, stampé sur le poison au cast ;
// la base = value1 du poison (roll MIN, pessimiste — même convention que la Heal Map).
global COVID_RANGE = null
global COVID_BASE  = null

// Map constant (NOT a tunable score)
global GRAV_MAXDIST     = 34      // distance max sur la carte, pour normaliser

// Cellule centrale, résolue une fois par combat.
global GRAV_CENTER_CELL = null


class GravityClass {

    /*
     * Coût spatial d'UNE cellule, mémoïsé par (terrain, cellule).
     * BaseHash est EXACTEMENT le fold des (id, cellule) des vivants hors Me : c'est tout ce
     * dont la somme dépend, l'importance étant figée par replan et la valeur de covid par
     * tour. Les deux caches sont donc vidés au replan, en même temps qu'IMPORTANCE_BY_ID.
     */
    static costAt(State, BaseHash, cell) {
        var key = addValueToBinHash(BaseHash, cell)
        if (key in PLACEMENT_COST_CACHE) return PLACEMENT_COST_CACHE[key]
        var ents = entsOf(State, BaseHash)
        var fw = REPLAN_WEIGHTS.FINAL_CELL_WEIGHTS
        var cost = fw.CENTER * CellClass.getDist(cell, GRAV_CENTER_CELL) / GRAV_MAXDIST
        var n = count(ents)
        for (var i = 0; i < n; i += 5) {
            var d = CellClass.getDist(cell, ents[i])
            var coef = ents[i + 1]                                                  // poids · importance, déjà multipliés
            // Distance CIBLE : le coût est nul à la distance visée et monte des DEUX côtés.
            // À cible nulle il vaut la distance elle-même — une distance étant positive,
            // |d − 0| est exactement d, donc la forme historique est retrouvée au bit près.
            // C'est le seul moyen d'exprimer « reste à portée d'arme, ni plus près ni plus
            // loin » : aucune courbe croissante ne place son minimum ailleurs qu'à zéro.
            var t = ents[i + 4]
            var dd = (t == 0) ? d : abs(d - t)
            cost += coef * dd / GRAV_MAXDIST                                        // écart à la cible
            if (ents[i + 2]) {                                                      // ALLIÉ
                if (d < GRAV_AOE_RADIUS) cost += fw.CROWDING                        // anti-cluster
                if (d <= COVID_RANGE) cost += ents[i + 3]                           // épargner l'allié (mes bulbes inclus)
            } else if (d > COVID_RANGE) {                                            // ENNEMI
                cost += ents[i + 3]                                                 // occasion manquée de contaminer
            }
        }
        PLACEMENT_COST_CACHE[key] = cost
        return cost
    }

    /*
     * Entités qui pèsent sur le placement, À PLAT : [cellule, coefficient, allié ?, coût covid].
     * Un quadruplet par vivant hors Me, dans l'ordre du State.
     *
     * Les deux coefficients viennent du contexte de poids du replan : ils sont invariants par
     * cellule, alors qu'ils étaient refaits une fois par cellule ET par entité. Les chaînes de
     * multiplication sont coupées à l'endroit exact où la distance entre en jeu : l'ordre
     * gauche-à-droite est préservé, les flottants sont identiques au bit près.
     * Un coût covid nul quand je ne suis pas contagieux annule la composante sans la tester.
     */
    static entsOf(State, BaseHash) {
        if (BaseHash in GRAV_ENTS_CACHE) return GRAV_ENTS_CACHE[BaseHash]
        if (GRAV_CENTER_CELL == null) GRAV_CENTER_CELL = getCellFromXY(0, 0)
        var mySide = State[Me].SIDE
        var ents = []
        for (var e: var stat in State) {
            if (stat.LIFE <= 0 || e == Me) continue
            var w = REPLAN_WEIGHTS.entityWeights(e, stat)
            push(ents, stat.CELL)
            push(ents, w.FINAL_DISTANCE)
            push(ents, stat.SIDE == mySide)
            push(ents, w.FINAL_COVID)
            push(ents, w.FINAL_DISTANCE_TARGET)
        }
        GRAV_ENTS_CACHE[BaseHash] = ents
        return ents
    }

    /* REAL spread value of my covid (0 = not infected -> the covid block stays dormant).
     * Engine-exact (Entity.endTurn -> Effect.createEffect FROM THE CHIP'S BASE PARAMS, verified):
     * what a neighbour receives = base · (1 + max(0, casterMagic)/100) · (1 + max(0, casterPower)/100)
     * · crit, recomputed at EVERY spread with the ORIGINAL caster's CURRENT stats (aoe = 1 in
     * propagation, the crit flag of my effect is carried). Deliberately NOT my local effect value:
     * a Liberation that shrinks MY value changes NOTHING to the spreads — and if the effect is
     * fully removed, getEffects stops returning it -> 0 here (gate closes).
     * Lit l'état RÉEL du moteur, donc invariant sur tout le tour : mémoïsé au tour. */
    static covidValue() {
        if (GRAV_COVID_VALUE != null) return GRAV_COVID_VALUE
        if (COVID_RANGE == null) {   // lazy chip constants (once per fight)
            for (var ceff in ITEMINFO[CHIP_COVID].EFFECTS) {
                if (ceff[0] == EFFECT_PROPAGATION) COVID_RANGE = ceff[1]
                if (ceff[0] == EFFECT_POISON) COVID_BASE = ceff[1]   // roll MIN (pessimiste)
            }
        }
        GRAV_COVID_VALUE = 0
        // getEffects layout: [0]=type, [1]=value, [2]=caster, [3]=turns, [4]=critical, [5]=item.
        for (var eff in getEffects(Me)) {
            if (eff[5] != CHIP_COVID || eff[0] != EFFECT_POISON) continue
            var m = getMagic(eff[2])   // caster D'ORIGINE, stats ACTUELLES (mort -> null -> 0)
            var p = getPower(eff[2])
            GRAV_COVID_VALUE = COVID_BASE * (1 + max(0, m == null ? 0 : m) / 100) * (1 + max(0, p == null ? 0 : p) / 100) * (eff[4] ? CRITICAL_FACTOR : 1)
            break
        }
        return GRAV_COVID_VALUE
    }

}
