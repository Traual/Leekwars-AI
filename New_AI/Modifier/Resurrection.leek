/*
 * Résurrection : applique les conséquences d'un revive (vie, cellule, ordre de tour) sur
 * l'état de simulation. Le CHOIX du mort vit dans le BFS (resurrectIdOf -> ScoringWichId,
 * une fois par état évalué) et voyage en payload d'action jusqu'au cast réel.
 */

include("../includes.leek")

class ResurrectionClass {
	ID
	SCORE
	constructor(id, score) {
		this.ID = id
		this.SCORE = score
	}

	static Update(To, ParentState, ActionPatches, Resurrect_ID) {
		if (Resurrect_ID == null) return;
		// PureDelta : le cadavre du ParentState reste INTACT — le passage mort -> vivant est
		// porté par le patch du candidat (chaque champ : delta = valeur ressuscitée − valeur
		// effective courante).
		var patch = StateClass.ensureEntityPatch(ActionPatches, Resurrect_ID)
		var base = StateClass.patchedBaseOf(ParentState, ActionPatches, Resurrect_ID)

		// Le moteur ressuscite PROPRE : die() retire tous les effets SUR le mort (stats de
		// base, zéro shield/poison/DR). EFFECTS : rebindé VIDE via le patch — plus d'effets
		// fantômes pour un ReplacementChangeStats ultérieur.
		patch.setEFFECTS([])
		patch.addPOISON(-patch.effPOISON(base))
		patch.addPOISON_OVER_TIME(-patch.effPOISON_OVER_TIME(base))
		patch.addAFTEREFFECT(-patch.effAFTEREFFECT(base))
		patch.addAFTEREFFECT_OVER_TIME(-patch.effAFTEREFFECT_OVER_TIME(base))
		patch.addHEAL(-patch.effHEAL(base))
		patch.addHEAL_OVER_TIME(-patch.effHEAL_OVER_TIME(base))
		patch.addABSOLUTE_SHIELD(-patch.effABSOLUTE_SHIELD(base))
		patch.addRELATIVE_SHIELD(-patch.effRELATIVE_SHIELD(base))
		patch.addDAMAGE_RETURN(-patch.effDAMAGE_RETURN(base))
		patch.addPOWER(-patch.effPOWER(base))
		var bases = base.BASE_STATS   // map IMMUABLE, partagée avec les états parents
		patch.addSTRENGTH(bases[STAT_STRENGTH] - patch.effSTRENGTH(base))
		patch.addWISDOM(bases[STAT_WISDOM] - patch.effWISDOM(base))
		patch.addAGILITY(bases[STAT_AGILITY] - patch.effAGILITY(base))
		patch.addMAGIC(bases[STAT_MAGIC] - patch.effMAGIC(base))
		patch.addRESISTANCE(bases[STAT_RESISTANCE] - patch.effRESISTANCE(base))
		patch.addSCIENCE(bases[STAT_SCIENCE] - patch.effSCIENCE(base))
		patch.addTOTAL_MP(bases[STAT_MP] - patch.effTOTAL_MP(base))
		patch.addMP(bases[STAT_MP] - patch.effMP(base))
		patch.addTOTAL_TP(bases[STAT_TP] - patch.effTOTAL_TP(base))
		patch.addTP(bases[STAT_TP] - patch.effTP(base))

		// Vie ressuscitée engine-exacte : source unique reviveTotalLifeFrom/reviveLife (l'ordre
		// des arrondis du moteur y est répliqué), partagée avec getResurrectionScore. L'AGI de
		// Me est lue en EFFECTIF (même cast).
		var mePatch = (Me in ActionPatches) ? ActionPatches[Me] : null
		var meBase = StateClass.patchedBaseOf(ParentState, ActionPatches, Me)
		var meAgility = (mePatch != null) ? mePatch.effAGILITY(meBase) : meBase.AGILITY
		var curTotalLife = patch.effTOTAL_LIFE(base)
		var newTotalLife = reviveTotalLifeFrom(curTotalLife, meAgility)
		patch.addTOTAL_LIFE(newTotalLife - curTotalLife)
		patch.addLIFE(reviveLife(newTotalLife) - patch.effLIFE(base))
		patch.addCELL(To - patch.effCELL(base))

		// Ordre de tour fidèle au moteur : le ressuscité est réinséré juste AVANT la prochaine
		// entité VIVANTE qui le suit dans l'ordre initial (les morts de branche comptent — on lit
		// la vue EFFECTIVE), sinon ajouté en FIN (cas des summons et des slots inconnus).
		// -0.25 (pas -0.5) pour ne jamais tie un bulbe virtuel (invocateur + 0.5) et rester du
		// bon côté : un bulbe inséré à indexOf(owner)+1 agit AVANT un ressuscité placé à
		// indexOf(follower). Cohérence de cache : ENTITY_SORTED_BY_TURN_ORDER_CACHE est clé par
		// le bit-set des vivants, que ce revive flippe — et cet ordre est une fonction PURE de
		// (INITIAL_TURN_ORDER, set des vivants), donc même clé <=> même tri.
		var myInit = (Resurrect_ID in INITIAL_TURN_ORDER) ? INITIAL_TURN_ORDER[Resurrect_ID] : null
		var followerInit = null
		var followerOrder = null
		var maxOrder = 0
		for (var o: var ostat0 in ParentState) {
			if (o == Resurrect_ID) continue
			var op = (o in ActionPatches) ? ActionPatches[o] : null
			var ob = StateClass.patchedBaseOf(ParentState, ActionPatches, o)
			var olife = (op != null) ? op.effLIFE(ob) : ob.LIFE
			if (olife <= 0) continue
			var oorder = (op != null) ? op.effTURN_ORDER(ob) : ob.TURN_ORDER
			if (oorder > maxOrder) maxOrder = oorder
			if (myInit != null && (o in INITIAL_TURN_ORDER)) {
				var oInit = INITIAL_TURN_ORDER[o]
				if (oInit > myInit && (followerInit == null || oInit < followerInit)) {
					followerInit = oInit
					followerOrder = oorder
				}
			}
		}
		// Summons nés dans l'action : jamais dans INITIAL_TURN_ORDER (ids virtuels), mais
		// leur ordre compte pour le maxOrder du fallback.
		for (var pid: var pp in ActionPatches) {
			if (pp.NEW_ENTITY == null || pid == Resurrect_ID) continue
			if (pp.effLIFE(pp.NEW_ENTITY) <= 0) continue
			var oorder = pp.effTURN_ORDER(pp.NEW_ENTITY)
			if (oorder > maxOrder) maxOrder = oorder
		}
		patch.addTURN_ORDER(((followerOrder != null) ? followerOrder - 0.25 : maxOrder + 1) - patch.effTURN_ORDER(base))
	}

	/*
	 * Vie de résurrection ENGINE-EXACTE (Entity.resurrect:945-946) — l'ordre des opérations
	 * compte : TL = max(10, round(TL·0.5·critFactor)) PUIS LIFE = floor(TL/2), la division
	 * ENTIÈRE positive du moteur (TL 101 -> 51 -> 25, pas 25.5). Crit binaire à 950 AGI, la
	 * convention de toute la sim. SOURCE UNIQUE : Update (la sim) et getResurrectionScore
	 * (le classement) passent tous deux ici — jamais de formule flottante parallèle.
	 */
	static reviveTotalLife(oldTotalLife, State) {
		return reviveTotalLifeFrom(oldTotalLife, State[Me].AGILITY)
	}

	/* Source unique paramétrée : la sim PureDelta y passe l'AGI EFFECTIVE de Me. */
	static reviveTotalLifeFrom(oldTotalLife, meAgility) {
		var critFactor = (meAgility >= MIN_AGILITY_TO_FULLY_CRIT) ? CRITICAL_FACTOR : 1
		return max(10, round(oldTotalLife * 0.5 * critFactor))
	}

	static reviveLife(newTotalLife) {
		return floor(newTotalLife / 2)
	}

	/*
	 * Le meilleur mort allié à relever (score = son terme post-revive, voir
	 * ScoringClass.getResurrectionScore).
	 * Règle moteur (State.resurrectEntity) : ressusciter un VRAI poireau ignore la limite de
	 * summons ; ressusciter un summon mort exige une place libre. SOURCE UNIQUE du choix,
	 * appelée UNE fois par état évalué (BFS.resurrectIdOf) — la sim (Update) et le vrai cast
	 * (Play) reçoivent l'id en payload d'action, jamais de re-choix divergent.
	 */
	static ScoringWichId(State) {
		var summonSlotFree = StateClass.countLivingSummons(State, State[Me].SIDE) < SUMMON_LIMIT
		var _final_id
		var top_score = 0
		for (var id: var entity_state in State) {
			if (entity_state.LIFE > 0) continue
			if (entity_state.SIDE != State[Me].SIDE) continue
			if (entity_state.IS_SUMMON && !summonSlotFree) continue   // summon mort : place requise
			var Score = ScoringClass.getResurrectionScore(entity_state, State)
			if (Score > top_score) {
				_final_id = id
				top_score = Score
			}
		}
		// Pas de debug ici : tourne sur CHAQUE nœud de résurrection du BFS (le vrai cast logue dans Play).
		return new ResurrectionClass(_final_id, top_score)
	}
}
