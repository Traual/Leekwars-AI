/*
 * Résurrection : applique les conséquences d'un revive (vie, cellule, ordre de tour) sur
 * l'état de simulation. Le CHOIX du mort vit dans le BFS (resurrectIdOf -> ScoringWichId,
 * une fois par état évalué) et voyage en payload d'action jusqu'au cast réel.
 */

include("../includes.leek")

class ResurrectionClass {
	ID
	SCORE
	constructor(id, score) {
		this.ID = id
		this.SCORE = score
	}

	static Update(To, State, Resurrect_ID, entityDeltas) {
		if (Resurrect_ID == null) return;
		// Clone-on-write du SEUL candidat (plus aucun préclonage des morts alliés) : il entre
		// dans entityDeltas, le patch incrémental BaseHash/context/HFP voit son passage
		// mort -> vivant, et le State parent garde son cadavre intact.
		var revived = StateClass.ensureTracked(State, Resurrect_ID, entityDeltas)

		// Le moteur ressuscite PROPRE : die() retire tous les effets SUR le mort (stats de
		// base, zéro shield/poison/DR). Reset par champs — BASE_STATS EST la base vraie.
		// EFFECTS : REBINDÉ sur un tableau neuf (pas muté — le container est partagé avec les
		// états parents, mais le revived est un clone frais : l'assignation ne touche que lui).
		// Plus d'effets fantômes pour un ReplacementChangeStats ultérieur.
		StateClass.touchField(revived, DELTA_EFFECTS, revived.EFFECTS)
		revived.EFFECTS = []
		StateClass.touchField(revived, DELTA_POISON, revived.POISON)
		revived.POISON = 0
		StateClass.touchField(revived, DELTA_POISON_OVER_TIME, revived.POISON_OVER_TIME)
		revived.POISON_OVER_TIME = 0
		StateClass.touchField(revived, DELTA_AFTEREFFECT, revived.AFTEREFFECT)
		revived.AFTEREFFECT = 0
		StateClass.touchField(revived, DELTA_AFTEREFFECT_OVER_TIME, revived.AFTEREFFECT_OVER_TIME)
		revived.AFTEREFFECT_OVER_TIME = 0
		StateClass.touchField(revived, DELTA_HEAL, revived.HEAL)
		revived.HEAL = 0
		StateClass.touchField(revived, DELTA_HEAL_OVER_TIME, revived.HEAL_OVER_TIME)
		revived.HEAL_OVER_TIME = 0
		StateClass.touchField(revived, DELTA_ABSOLUTE_SHIELD, revived.ABSOLUTE_SHIELD)
		revived.ABSOLUTE_SHIELD = 0
		StateClass.touchField(revived, DELTA_RELATIVE_SHIELD, revived.RELATIVE_SHIELD)
		revived.RELATIVE_SHIELD = 0
		StateClass.touchField(revived, DELTA_DAMAGE_RETURN, revived.DAMAGE_RETURN)
		revived.DAMAGE_RETURN = 0
		StateClass.touchField(revived, DELTA_POWER, revived.POWER)
		revived.POWER = 0
		var bases = revived.BASE_STATS   // map IMMUABLE, partagée avec les états parents
		StateClass.touchField(revived, DELTA_STRENGTH, revived.STRENGTH)
		revived.STRENGTH   = bases[STAT_STRENGTH]
		StateClass.touchField(revived, DELTA_WISDOM, revived.WISDOM)
		revived.WISDOM     = bases[STAT_WISDOM]
		StateClass.touchField(revived, DELTA_AGILITY, revived.AGILITY)
		revived.AGILITY    = bases[STAT_AGILITY]
		StateClass.touchField(revived, DELTA_MAGIC, revived.MAGIC)
		revived.MAGIC      = bases[STAT_MAGIC]
		StateClass.touchField(revived, DELTA_RESISTANCE, revived.RESISTANCE)
		revived.RESISTANCE = bases[STAT_RESISTANCE]
		StateClass.touchField(revived, DELTA_SCIENCE, revived.SCIENCE)
		revived.SCIENCE    = bases[STAT_SCIENCE]
		StateClass.touchField(revived, DELTA_TOTAL_MP, revived.TOTAL_MP)
		revived.TOTAL_MP = bases[STAT_MP]
		StateClass.touchField(revived, DELTA_MP, revived.MP)
		revived.MP       = bases[STAT_MP]
		StateClass.touchField(revived, DELTA_TOTAL_TP, revived.TOTAL_TP)
		revived.TOTAL_TP = bases[STAT_TP]
		StateClass.touchField(revived, DELTA_TP, revived.TP)
		revived.TP       = bases[STAT_TP]

		// Vie ressuscitée engine-exacte : source unique reviveTotalLife/reviveLife (l'ordre
		// des arrondis du moteur y est répliqué), partagée avec getResurrectionScore.
		var newTotalLife = reviveTotalLife(revived.TOTAL_LIFE, State)
		StateClass.touchField(revived, DELTA_TOTAL_LIFE, revived.TOTAL_LIFE)
		revived.TOTAL_LIFE = newTotalLife
		StateClass.touchField(revived, DELTA_LIFE, revived.LIFE)
		revived.LIFE = reviveLife(newTotalLife)
		StateClass.touchField(revived, DELTA_CELL, revived.CELL)
		revived.CELL = To

		// Ordre de tour fidèle au moteur : le ressuscité est réinséré juste AVANT la prochaine
		// entité VIVANTE qui le suit dans l'ordre initial (les morts de branche comptent — on lit
		// le State courant), sinon ajouté en FIN (cas des summons et des slots inconnus).
		// -0.25 (pas -0.5) pour ne jamais tie un bulbe virtuel (invocateur + 0.5) et rester du
		// bon côté : un bulbe inséré à indexOf(owner)+1 agit AVANT un ressuscité placé à
		// indexOf(follower). Cohérence de cache : ENTITY_SORTED_BY_TURN_ORDER_CACHE est clé par
		// le bit-set des vivants, que ce revive flippe — et cet ordre est une fonction PURE de
		// (INITIAL_TURN_ORDER, set des vivants), donc même clé <=> même tri.
		var myInit = (Resurrect_ID in INITIAL_TURN_ORDER) ? INITIAL_TURN_ORDER[Resurrect_ID] : null
		var followerInit = null
		var followerOrder = null
		var maxOrder = 0
		for (var o: var ostat in State) {
			if (ostat.LIFE <= 0 || o == Resurrect_ID) continue
			if (ostat.TURN_ORDER > maxOrder) maxOrder = ostat.TURN_ORDER
			if (myInit != null && (o in INITIAL_TURN_ORDER)) {
				var oInit = INITIAL_TURN_ORDER[o]
				if (oInit > myInit && (followerInit == null || oInit < followerInit)) {
					followerInit = oInit
					followerOrder = ostat.TURN_ORDER
				}
			}
		}
		StateClass.touchField(revived, DELTA_TURN_ORDER, revived.TURN_ORDER)
		revived.TURN_ORDER = (followerOrder != null) ? followerOrder - 0.25 : maxOrder + 1
	}

	/*
	 * Vie de résurrection ENGINE-EXACTE (Entity.resurrect:945-946) — l'ordre des opérations
	 * compte : TL = max(10, round(TL·0.5·critFactor)) PUIS LIFE = floor(TL/2), la division
	 * ENTIÈRE positive du moteur (TL 101 -> 51 -> 25, pas 25.5). Crit binaire à 950 AGI, la
	 * convention de toute la sim. SOURCE UNIQUE : Update (la sim) et getResurrectionScore
	 * (le classement) passent tous deux ici — jamais de formule flottante parallèle.
	 */
	static reviveTotalLife(oldTotalLife, State) {
		var critFactor = (State[Me].AGILITY >= MIN_AGILITY_TO_FULLY_CRIT) ? CRITICAL_FACTOR : 1
		return max(10, round(oldTotalLife * 0.5 * critFactor))
	}

	static reviveLife(newTotalLife) {
		return floor(newTotalLife / 2)
	}

	/*
	 * Le meilleur mort allié à relever (score = son terme post-revive, voir
	 * ScoringClass.getResurrectionScore).
	 * Règle moteur (State.resurrectEntity) : ressusciter un VRAI poireau ignore la limite de
	 * summons ; ressusciter un summon mort exige une place libre. SOURCE UNIQUE du choix,
	 * appelée UNE fois par état évalué (BFS.resurrectIdOf) — la sim (Update) et le vrai cast
	 * (Play) reçoivent l'id en payload d'action, jamais de re-choix divergent.
	 */
	static ScoringWichId(State) {
		var summonSlotFree = StateClass.countLivingSummons(State, State[Me].SIDE) < SUMMON_LIMIT
		var _final_id
		var top_score = 0
		for (var id: var entity_state in State) {
			if (entity_state.LIFE > 0) continue
			if (entity_state.SIDE != State[Me].SIDE) continue
			if (entity_state.IS_SUMMON && !summonSlotFree) continue   // summon mort : place requise
			var Score = ScoringClass.getResurrectionScore(entity_state, State)
			if (Score > top_score) {
				_final_id = id
				top_score = Score
			}
		}
		// Pas de debug ici : tourne sur CHAQUE nœud de résurrection du BFS (le vrai cast logue dans Play).
		return new ResurrectionClass(_final_id, top_score)
	}
}
