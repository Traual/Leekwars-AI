/**
 * BulbState: Creates a virtual entity state for a summoned bulb.
 * Uses getBulbStats() and getBulbChips() API for accurate, up-to-date stats.
 **/

include("../includes.leek")

class BulbState {
	// Fight Stats
	ABSOLUTE_SHIELD
	RELATIVE_SHIELD
	DAMAGE_RETURN
	POWER
	SUMMONER
	SUMMONS
	IS_SUMMON
	ID
	WEAPON
	INVENTORY
	COOLDOWNS
	USES
	SIDE
	EVERYONE
	IS_ALLY
	IS_ENEMY
	IS_STRENGTH_ALLIES
	IS_STRENGTH_ENEMIES
	SPECIAL_WEAPON
	EFFECTS
	EFFECTS_ITEM_MAP
	POISON
	POISON_OVER_TIME
	JUST_POISON
	JUST_POISON_OVER_TIME
	TURN_ORDER
	// Leek Stats
	LIFE
	TOTAL_LIFE
	STRENGTH
	TO_SAVE_STRENGTH
	TO_SAVE_SHACKLE_STRENGTH
	WISDOM
	TO_SAVE_WISDOM
	TO_SAVE_SHACKLE_WISDOM
	AGILITY
	TO_SAVE_AGILITY
	TO_SAVE_SHACKLE_AGILITY
	RESISTANCE
	TO_SAVE_RESISTANCE
	SCIENCE
	TO_SAVE_SCIENCE
	MAGIC
	TO_SAVE_MAGIC
	TO_SAVE_SHACKLE_MAGIC
	FREQUENCY
	MP
	TO_SAVE_MP
	TOTAL_MP
	TO_SAVE_TOTAL_MP
	TO_SAVE_SHACKLE_TOTAL_MP
	TP
	TO_SAVE_TP
	TOTAL_TP
	TO_SAVE_TOTAL_TP
	TO_SAVE_SHACKLE_TOTAL_TP
	NAME
	// Map Stats
	CELL
	STATIC

	constructor(id, SummonerLevelTimes, Chip, To, Summoner, SummonerStats) {
		// Charger les stats dynamiques via l'API
		var stats = getBulbStats(Chip)

		// === Fight Stats ===
		this.ABSOLUTE_SHIELD = 0
		this.RELATIVE_SHIELD = 0
		this.DAMAGE_RETURN = 0
		this.POWER = 0
		this.SUMMONER = Summoner
		this.SUMMONS = []
		this.IS_SUMMON = true
		this.ID = id
		this.INVENTORY = getBulbChips(Chip)
		this.COOLDOWNS = [: ]
		this.USES = [: ]
		for (var i in this.INVENTORY) {
			this.COOLDOWNS[i] = 0
			this.USES[i] = 0
		}
		this.SIDE = SummonerStats.SIDE
		this.EFFECTS = []
		this.EFFECTS_ITEM_MAP = [: ]
		this.POISON = 0
		this.POISON_OVER_TIME = 0
		this.JUST_POISON = 0
		this.JUST_POISON_OVER_TIME = 0
		this.TURN_ORDER = getEntityTurnOrder(Summoner) + 1

		// === Leek Stats (interpolation min + (max - min) * SummonerLevelTimes) ===
		this.LIFE = stats[STAT_LIFE][0] + (stats[STAT_LIFE][1] - stats[STAT_LIFE][0]) * SummonerLevelTimes
		this.TOTAL_LIFE = this.LIFE
		this.STRENGTH = stats[STAT_STRENGTH][0] + (stats[STAT_STRENGTH][1] - stats[STAT_STRENGTH][0]) * SummonerLevelTimes
		this.WISDOM = stats[STAT_WISDOM][0] + (stats[STAT_WISDOM][1] - stats[STAT_WISDOM][0]) * SummonerLevelTimes
		this.AGILITY = stats[STAT_AGILITY][0] + (stats[STAT_AGILITY][1] - stats[STAT_AGILITY][0]) * SummonerLevelTimes
		this.RESISTANCE = stats[STAT_RESISTANCE][0] + (stats[STAT_RESISTANCE][1] - stats[STAT_RESISTANCE][0]) * SummonerLevelTimes
		this.SCIENCE = stats[STAT_SCIENCE][0] + (stats[STAT_SCIENCE][1] - stats[STAT_SCIENCE][0]) * SummonerLevelTimes
		this.MAGIC = stats[STAT_MAGIC][0] + (stats[STAT_MAGIC][1] - stats[STAT_MAGIC][0]) * SummonerLevelTimes
		this.FREQUENCY = 0
		this.MP = stats[STAT_MP][0] + (stats[STAT_MP][1] - stats[STAT_MP][0]) * SummonerLevelTimes
		this.TOTAL_MP = this.MP
		this.TP = stats[STAT_TP][0] + (stats[STAT_TP][1] - stats[STAT_TP][0]) * SummonerLevelTimes
		this.TOTAL_TP = this.TP
		this.NAME = getNameFromChip(Chip)

		// === Original Stats for Liberation / Manumission ===
		this.TO_SAVE_STRENGTH = this.STRENGTH
		this.TO_SAVE_SHACKLE_STRENGTH = 0
		this.TO_SAVE_WISDOM = this.WISDOM
		this.TO_SAVE_SHACKLE_WISDOM = 0
		this.TO_SAVE_AGILITY = this.AGILITY
		this.TO_SAVE_SHACKLE_AGILITY = 0
		this.TO_SAVE_RESISTANCE = this.RESISTANCE
		this.TO_SAVE_SCIENCE = this.SCIENCE
		this.TO_SAVE_MAGIC = this.MAGIC
		this.TO_SAVE_SHACKLE_MAGIC = 0
		this.TO_SAVE_MP = this.MP
		this.TO_SAVE_TOTAL_MP = this.TOTAL_MP
		this.TO_SAVE_SHACKLE_TOTAL_MP = 0
		this.TO_SAVE_TP = this.TP
		this.TO_SAVE_TOTAL_TP = this.TOTAL_TP
		this.TO_SAVE_SHACKLE_TOTAL_TP = 0

		// === Map Stats ===
		this.CELL = To
		this.STATIC = false
	}

	static getNameFromChip(Chip) {
		switch (Chip) {
			case CHIP_PUNY_BULB:
				return "puny_bulb"
			case CHIP_ROCKY_BULB:
				return "rocky_bulb"
			case CHIP_ICED_BULB:
				return "iced_bulb"
			case CHIP_HEALER_BULB:
				return "healer_bulb"
			case CHIP_FIRE_BULB:
				return "fire_bulb"
			case CHIP_WIZARD_BULB:
				return "wizard_bulb"
			case CHIP_METALLIC_BULB:
				return "metallic_bulb"
			case CHIP_SAVANT_BULB:
				return "savant_bulb"
			case CHIP_TACTICIAN_BULB:
				return "tactician_bulb"
			case CHIP_LIGHTNING_BULB:
				return "lightning_bulb"
		}
	}
}