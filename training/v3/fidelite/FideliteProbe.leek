/*
 * Sonde de fidelite : joue un script d'actions impose et compare, apres chaque action, l'etat
 * PREDIT par les consequences de l'IA a l'etat relu dans le moteur. Deployee a cote de
 * Main.leek par le banc, jamais dans New_AI.
 */

include("includes.leek")

class FideliteProbe {

	/* Vue comparable d'une entite : les champs que les consequences ecrivent. */
	static vue(s) {
		var lignes = [: ]
		for (var e in s.EFFECTS) {
			var k = e[0] + "|" + e[2] + "|" + e[3] + "|" + e[5] + "|" + e[7]
			lignes[k] = ((k in lignes) ? lignes[k] : 0) + e[1]
		}
		return [
			"LIFE": s.LIFE, "TOTAL_LIFE": s.TOTAL_LIFE, "CELL": s.CELL, "STATES": s.STATES,
			"TP": s.TP, "MP": s.MP, "TOTAL_TP": s.TOTAL_TP, "TOTAL_MP": s.TOTAL_MP,
			"STRENGTH": s.STRENGTH, "WISDOM": s.WISDOM, "AGILITY": s.AGILITY,
			"RESISTANCE": s.RESISTANCE, "SCIENCE": s.SCIENCE, "MAGIC": s.MAGIC, "POWER": s.POWER,
			"ABSOLUTE_SHIELD": s.ABSOLUTE_SHIELD, "RELATIVE_SHIELD": s.RELATIVE_SHIELD,
			"DAMAGE_RETURN": s.DAMAGE_RETURN,
			"POISON": s.POISON, "POISON_OVER_TIME": s.POISON_OVER_TIME,
			"AFTEREFFECT": s.AFTEREFFECT, "AFTEREFFECT_OVER_TIME": s.AFTEREFFECT_OVER_TIME,
			"HEAL": s.HEAL, "HEAL_OVER_TIME": s.HEAL_OVER_TIME,
			"EFFECTS": lignes
		]
	}

	static vueEtat(state) {
		var out = [: ]
		for (var id: var s in state) out[id] = vue(s)
		return out
	}

	/* Effets de TOUS les items passes a leur jet maximal (index 2 de getChipEffects, plantes
	 * comprises) ; rend la sauvegarde. */
	static jetMaxPartout() {
		var sauvegarde = [: ]
		for (var item: var info in ITEMINFO) {
			sauvegarde[item] = info.EFFECTS
			var out = []
			for (var e in info.EFFECTS) {
				var c = clone(e, 1)
				c[1] = e[2]
				push(out, c)
			}
			info.EFFECTS = out
		}
		return sauvegarde
	}

	static restaurer(sauvegarde) {
		for (var item: var effs in sauvegarde) ITEMINFO[item].EFFECTS = effs
	}

	/* Etat predit par les consequences d'un lancer de Me sur `cell`. */
	static predireLancer(S, item, cell) {
		var baseHash = StateClass.getBaseHash(S)
		var P = clone(S, 1)
		var clonedIds = [: ]
		StateClass.beginActionOnWorkspace(P, clonedIds)
		var me = P[Me]
		var info = ITEMINFO[item]
		var cout = info.COST
		if (info.IS_WEAPON && me.WEAPON != item) cout += 1
		me.TP -= cout
		if (info.IS_WEAPON) me.WEAPON = item
		ConsequencesClass.getConsequences(P, item, me.CELL, cell, Me, baseHash, clonedIds, null)
		StateClass.setCooldown(P[Me], item, info.COOLDOWN)
		return P
	}

	/* Etat predit par une marche de Me jusqu'a `cell` (couche de marche seule). */
	static predireMarche(S, cell) {
		var baseHash = StateClass.getBaseHash(S)
		var layers = WalkCellsClass.getAllLayers(S, Me, baseHash)
		var P = clone(S, 1)
		var clonedIds = [: ]
		StateClass.beginActionOnWorkspace(P, clonedIds)
		var me = P[Me]
		var start = me.CELL
		var mp = me.MP
		if (!(cell in layers.WALK)) return P
		me.CELL = cell
		me.MP -= layers.WALK[cell]
		if (!mapIsEmpty(PLANT_ZONE_BY_ID)) AwakeningClass.replayMeMove(P, start, cell, mp, layers, baseHash, clonedIds)
		return P
	}

	static jouerAction(action) {
		var kind = action[0]
		if (kind == "chip") return useChipOnCell(action[1], action[2])
		if (kind == "weapon") {
			if (getWeapon() != action[1]) setWeapon(action[1])
			return useWeaponOnCell(action[2])
		}
		if (kind == "summon") return summon(action[1], action[2], FideliteProbe.invocation)
		if (kind == "move") {
			var S = StateClass.Virtualize()
			var r = WalkCellsClass.MoveTo(action[1], S, StateClass.getBaseHash(S))
			return r[0] ? 1 : 0
		}
		return -99
	}

	/* IA des invocations du banc : une plante joue sa vraie politique, un bulbe ne fait rien. */
	static invocation() {
		if (getType() == ENTITY_PLANT) PlantPolicy.playReal()
	}

	static predire(S, action, jetMax) {
		var sauvegarde = jetMax ? jetMaxPartout() : null
		var kind = action[0]
		var P = S
		if (kind == "chip" || kind == "weapon" || kind == "summon") P = predireLancer(S, action[1], action[2])
		if (kind == "move") P = predireMarche(S, action[1])
		if (sauvegarde != null) restaurer(sauvegarde)
		// Les caches de cibles et de chemins ne doivent pas resservir un calcul fait sous
		// d'autres effets.
		CONSEQUENCE_TARGET_CACHE = [: ]
		return P
	}

	static play(script) {
		var nom = getName()
		if (!(nom in script)) return;
		var tour = getTurn()
		if (!(tour in script[nom])) return;
		var etape = 0
		for (var action in script[nom][tour]) {
			var marques = REAL_AWAKEN_MARKS
			ReloadCacheNewTurn()
			REAL_AWAKEN_MARKS = marques
			Preload.InitStateClass()
			var S = StateClass.Virtualize()
			var avant = [: ]
			for (var id: var s in S) avant[id] = true
			var pMin = vueEtat(predire(S, action, false))
			var pMax = vueEtat(predire(S, action, true))
			var code = jouerAction(action)
			marques = REAL_AWAKEN_MARKS
			ReloadCacheNewTurn()
			REAL_AWAKEN_MARKS = marques
			Preload.InitStateClass()
			var R = vueEtat(StateClass.Virtualize())
			debug("FID " + jsonEncode([
				"nom": nom, "tour": tour, "etape": etape, "action": action, "code": code,
				"avant": avant, "min": pMin, "max": pMax, "reel": R
			]))
			etape++
		}
	}
}
