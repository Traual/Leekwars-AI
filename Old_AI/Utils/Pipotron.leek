/**
 * Here we are speaking shrek facts
**/

class Pipotron {
    static feed(arrayText) {
        for (var text in arrayText) {
            var words = split(toLower(text)," ") // Convertir en minuscules et séparer en mots
            if (!isEmpty(words) && words[0] == "") removeElement(words, "")
            var endOfSentence = count(words) - 2
            for (var i = 0; i < count(words) - 1; i++) {
                var word = words[i]
                var nextWord = words[i + 1]

                if (i == 0 && word != "," && word != "'") push(beginnings, word) // Enregistrer les débuts de phrase

                if (!(word in nGrams)) {
                    nGrams[word] = []
                }
                push(nGrams[word], nextWord)
                if (i == endOfSentence) {
                    if (!(nextWord in nGrams)) {
                        nGrams[nextWord] = []
                    }
                    push(nGrams[nextWord], " ")
                }
            }
        }
    }

    static ReRollRand() {
        for (var tmp = 0; tmp <= getEntity(); tmp++) randInt(0, 5)
    }
    
    static generate(maxLength) {
        if (count(beginnings) == 0) {
            return "Aucune donnée d'entraînement !"
        }

        var currentWord = beginnings[randInt(0, count(beginnings))]
        var result = [UpFirstLetter(currentWord)] //To Maj

        for (var i = 0; i < maxLength; i++) {
            var possibilities = nGrams[currentWord]

            var nextWord = possibilities[randInt(0, count(possibilities))]
            if (nextWord == " ") break
            push(result, nextWord)
            currentWord = nextWord
        }

        var Points = [".", " !", " ?", "..."]

        return join(result, " ") + Points[randInt(0, count(Points))]
    }

    static UpFirstLetter(word) {
        var _final = []
        var arrayLetters = split(word,"")
        push(_final, toUpper(arrayLetters[0]))
        for (var i = 1; i < count(arrayLetters); i++) {
            push(_final, arrayLetters[i])
        }
        return join(_final, "")
    }

    static SplitIntoSentences(longText) {
        var _final = []
        var Tmp1 = split(longText,"...") // Séparer les phrases délimités par une ponctuation
        for (var Tmpp1 in Tmp1) {
            var Tmp2 = split(Tmpp1,"!")
            for (var Tmpp2 in Tmp2) {
                var Tmp3 = split(Tmpp2,"?")
                for (var Tmpp3 in Tmp3) {
                    var Tmp4 = split(Tmpp3,".")
                    push(_final, Tmp4)
                }
            }
        }


        return arrayFlatten(_final)
    }
}

