/**
 * Here we are preshotting average enemies plays !
**/

include("../includes.leek")

class WeaponToSet { 
	static get(EveryStats, MyStats) {
		if (MyStats.TP >= 1) {
			var BaseHash = Tree.getBaseHash(EveryStats)
			var BestScore = 0
			var BestWeapon
			for (var weap in MyStats.INVENTORY) {
				var Infos = ITEMINFO[weap]
				if (!Infos.IS_WEAPON) continue
				var ItemScore = 0
				var MaxDist = MyStats.MP + Infos.MAXRANGE
				var MinDist = Infos.MINRANGE - MyStats.MP
				var MaxTimes = min(floor(MyStats.TOTAL_TP / Infos.COST), Infos.MAX_USES)
				for (var entity: var stat in EveryStats) {
					var TmpDist = CellInfo.getDist(stat.CELL, MyStats.CELL)
					var OverDist = 1
					if (TmpDist > MaxDist || TmpDist < MinDist) OverDist = 0.1
					var ScoreItemOnEntity = rawScoreOfItem(weap, entity, EveryStats, BaseHash) * MaxTimes * OverDist
					if (ScoreItemOnEntity > 0) ItemScore += ScoreItemOnEntity
				}
				if (ItemScore > BestScore) {
					BestScore = ItemScore
					BestWeapon = weap
				}
			}
			return BestWeapon
		}
	}

	static rawScoreOfItem(item, entity, EveryStats, BaseHash) {
		var _final = 0
		var Infos = ITEMINFO[item]
		var MyStats = EveryStats[Me]
		var EntityCell = EveryStats[entity].CELL
		var BaseTargets = Consequences.ConsequenceTargetsWithoutMe(item, EntityCell, EveryStats, BaseHash)
		for (var eff in Infos.EFFECTS) {
			var TmpTargets = Consequences.RealConsequenceTargets(BaseTargets, eff, EveryStats, MyStats, Me)
			var Multiplier = (eff[5] & EFFECT_MODIFIER_MULTIPLIED_BY_TARGETS) ? mapSize(TmpTargets) : 1 //Saving Multiplier
			var RealTargets = eff[5] & EFFECT_MODIFIER_ON_CASTER ? [Me: 0] : TmpTargets
			_final += ActionFitness.EffectsMap[eff[0]](EveryStats, EntityCell, EntityCell, eff, Me, Multiplier, item, RealTargets, MyStats)
		}
		return _final
	}
}