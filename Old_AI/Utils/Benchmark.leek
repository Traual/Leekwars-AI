	static DebugAllOps() {
		debug(
			"Cell Danger Area Took : " + CellDangerAreaOps / 1000000 + "M opés
			" +
			"Cell Danger Combo Took : " + CellDangerComboOps / 1000000 + "M opés
			" +
			"Final Cell Took : " + FinalCellOps / 1000000 + "M opés
			" +
			"Actions Aoe Hash Took : " + ActionsAoeHashOps / 1000000 + "M opés
			" +
			"Actions Loading Class Took : " + ActionsLoadingClassOps / 1000000 + "M opés
			" +
			"Actions Cells Dependant Took : " + ActionsCellsDependantOps / 1000000 + "M opés
			" +
			"Actions Cells Independant Took : " + ActionsCellsIndependantOps / 1000000 + "M opés
			" +
			"Gravity Took : " + GravityOps / 1000000 + "M opés
			" +
			"Consequences Took : " + ConsequencesOps / 1000000 + "M opés
			" +
			"Fitness Took : " + FitnessOps / 1000000 + "M opés
			" +
			"WalkCells Took : " + WalkcellsOps / 1000000 + "M opés
			" +
			"BFS (Total) Took : " + BFSOps / 1000000 + "M opés
			" +
