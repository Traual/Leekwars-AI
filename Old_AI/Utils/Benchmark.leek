	}
	static ActionsCellsDependantStop() {
		ActionsCellsDependantOps += getOperations()
	}
	static ActionsCellsIndependantStart() {
		ActionsCellsIndependantOps -= getOperations()
	}
	static ActionsCellsIndependantStop() {
		ActionsCellsIndependantOps += getOperations()
	}
	/*static TreeStart() {
		TreeOps -= getOperations()
	}
	static TreeStop() {
		TreeOps += getOperations()
	}*/
	static GravityStart() {
		GravityOps -= getOperations()
	}
	static GravityStop() {
		GravityOps += getOperations()
	}
	static ConsequencesStart() {
		ConsequencesOps -= getOperations()
	}
	static ConsequencesStop() {
		ConsequencesOps += getOperations()
	}
	static FitnessStart() {
		FitnessOps -= getOperations()
	}
	static FitnessStop() {
		FitnessOps += getOperations()
	}
	/*static CloneStart() {
		CloneOps -= getOperations()
	}
	static CloneStop() {
		CloneOps += getOperations()
	}*/
	static WalkcellsStart() {
		WalkcellsOps -= getOperations()
	}
	static WalkcellsStop() {
		WalkcellsOps += getOperations()
	}
	static FinalCellStart() {
		FinalCellOps -= getOperations()
	}
	static FinalCellStop() {
		FinalCellOps += getOperations()
	}
	static BFSStart() {
		BFSOps -= getOperations()
	}
	static BFSStop() {
		BFSOps += getOperations()
	}
	static DFSStart() {
		DFSOps -= getOperations()
	}
	static DFSStop() {
		DFSOps += getOperations()
	}
	/*static SortedWalkOpsStart() {
		SortedWalkOps -= getOperations()
	}
	static SortedWalkOpsStop() {
		SortedWalkOps += getOperations()
	}*/
	static LoadingBaseActionsStart() {
