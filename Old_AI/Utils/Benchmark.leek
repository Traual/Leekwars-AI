			" +
			"Coef Loading took : " + CoefLoadingOps / 1000000 + "M opés
			" +
			"Sorting in BFS took : " + SortingInBFSOps / 1000000 + "M opés
			" +
			"For in BFS took : " + ForInBFSOps / 1000000 + "M opés"
		)
	}
}

class BenchmarkRam {
	static RAM
	static Start() {
		RAM = getUsedRAM()
	}
	static Stop(name) {
		debug(name+" Ram : "+(((getUsedRAM()-RAM)/getMaxRAM())*100)+" %");
	}
}