	}
	static ForInBFSOpsStop() {
		ForInBFSOps += getOperations()
	}
	static SortingInBFSOpsStart() {
		SortingInBFSOps -= getOperations()
	}
	static SortingInBFSOpsStop() {
		SortingInBFSOps += getOperations()
	}
	static FitnessActionStart() {
