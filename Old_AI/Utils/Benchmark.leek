/**
 * Benchmark (to test operations)
**/

class Benchmark {
	static CellDangerAreaOps
	static CellDangerComboOps
	static ActionsAoeHashOps
	static ActionsLoadingClassOps
	static ActionsCellsDependantOps
	static ActionsCellsIndependantOps
	static TreeOps
	static GravityOps
	static ConsequencesOps
	static FitnessOps
	static WalkcellsOps
	static FinalCellOps
	static BFSOps
	static DFSOps
	static CloneOps
	static LoadingBaseActions
	static ScoringEveryNodes
	static FitnessActionsOps
	static SortedWalkOps
	static ForInBFSOps
	static SortingInBFSOps
	static CoefLoadingOps
	DEBUGOP
	StartOp() {
		DEBUGOP = getOperations()
	}
	StopOp(name) {
		debug(name+" opés "+((getOperations()-DEBUGOP-17)/1000)+" k")
	}
	static Init() {
		CellDangerAreaOps = 0
		CellDangerComboOps = 0
		ActionsAoeHashOps = 0
		ActionsLoadingClassOps = 0
		ActionsCellsDependantOps = 0
		ActionsCellsIndependantOps = 0
		TreeOps = 0
		GravityOps = 0
		ConsequencesOps = 0
		FitnessOps = 0
		WalkcellsOps = 0
		FinalCellOps = 0
		BFSOps = 0
		DFSOps = 0
		CloneOps = 0
		SortedWalkOps = 0
		LoadingBaseActions = 0
		ScoringEveryNodes = 0
		ForInBFSOps = 0
		SortingInBFSOps = 0
		FitnessActionsOps = 0
		CoefLoadingOps = 0
	}
	static CellDangerAreaStart() {
		CellDangerAreaOps -= getOperations()
	}
	static CellDangerAreaStop() {
		CellDangerAreaOps += getOperations()
	}
	static CellDangerComboStart() {
		CellDangerComboOps -= getOperations()
	}
	static CellDangerComboStop() {
		CellDangerComboOps += getOperations()
	}
	static ActionsAoeHashStart() {
