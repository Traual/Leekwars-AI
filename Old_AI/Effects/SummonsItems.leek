/**
 * Class to add to ActualStats on the consequences of an action (Only SUMMON Type) : Item To X (For SummonCell)
 **/

include("../includes")

class SummonItems {
	MEAN
    GENTLE
    constructor(RelativeMean, RelativeGentle) {
        this.MEAN = RelativeMean
        this.GENTLE = RelativeGentle
    }

    static LoadRelativeSummonItems(BulbInventory, BulbName) {
        if (BulbName in SUMMONS_ITEMS_CACHE) return SUMMONS_ITEMS_CACHE[BulbName]
        var TotalMean = 0
		var TotalGentle = 0
		for (var i in BulbInventory) {
			for (var eff in ITEMINFO[i].EFFECTS) {
				var VarTargetType = Target.TargetType[eff[0]]
				if (VarTargetType == Target.ALLY) {
    				TotalGentle++
				} else if (VarTargetType == Target.ENEMY) {
    				TotalMean++
				} else if (VarTargetType == Target.ALL) {
   					TotalGentle++
    				TotalMean++
				}
			}
		}
		var RelativeMean = TotalMean / (TotalGentle + TotalMean)
		var RelativeGentle = TotalGentle / (TotalGentle + TotalMean)
        var _final = new SummonItems(RelativeMean, RelativeGentle)
        SUMMONS_ITEMS_CACHE[BulbName] = _final
        return _final
    }
}