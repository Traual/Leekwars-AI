/**
 * Class to add to ActualStats on the consequences of an action (Only SUMMON Type) : Item To X (For SummonCell)
 **/

include("../includes.leek")

class BulbStats {
	//Create a new class very close to stats (constructor asks : id, SummonerLevelTimes, Chip, To, Summoner, SummonerStats) and on this new class, build the bulb stats (with all same names then stats, .LIFE ETC) so both are used the same way and can be mixed in AllStats

	//////////////////////////////////////////////////////////////////////////////////////////Fight Stats
//////////////////////////////////////////////////////////////////////////////////////
	ABSOLUTE_SHIELD
	RELATIVE_SHIELD
	DAMAGE_RETURN
	POWER
	SUMMONER
	SUMMONS
	SUMMON
	ID
	WEAPON
	INVENTORY
	COOLDOWNS
	ALLIES
	ENEMIES
	EVERYONE
	ALLY
	ENEMY
	IS_STRENGTH_ALLIES
	IS_STRENGTH_ENEMIES
	SPECIAL_WEAPON
	EFFECTS
	EFFECTS_ITEM_MAP
	POISON
	POISON_OVER_TIME
	JUST_POISON
	JUST_POISON_OVER_TIME
	TURN_ORDER
	//////////////////////////////////////////////////////////////////////////////////////////Leek Stats
//////////////////////////////////////////////////////////////////////////////////////
	LIFE
	TOTAL_LIFE
	STRENGTH
	TO_SAVE_STRENGTH //Oui on doit save POS et NEG pour Manumission (retire les neg) et liberations (retire 60% de POS et NEG)
	TO_SAVE_SHACKLE_STRENGTH
	WISDOM
	TO_SAVE_WISDOM
	TO_SAVE_SHACKLE_WISDOM
	AGILITY
	TO_SAVE_AGILITY
	TO_SAVE_SHACKLE_AGILITY
	RESISTANCE
	TO_SAVE_RESISTANCE
	//TO_SAVE_SHACKLE_RESISTANCE //Does not exist (yet)
	SCIENCE
	TO_SAVE_SCIENCE
	//TO_SAVE_SHACKLE_SCIENCE //Does not exist (yet)
	MAGIC
	TO_SAVE_MAGIC
	TO_SAVE_SHACKLE_MAGIC
	FREQUENCY //No need to save cuz not usefull for Liberation/Manumission 
	MP
	TO_SAVE_MP
	//TO_SAVE_SHACKLE_MP
	TOTAL_MP
	TO_SAVE_TOTAL_MP
	TO_SAVE_SHACKLE_TOTAL_MP
	TP
	TO_SAVE_TP
	//TO_SAVE_SHACKLE_TP
	TOTAL_TP
	TO_SAVE_TOTAL_TP
	TO_SAVE_SHACKLE_TOTAL_TP
	NAME
	//AI_NAME
	//AI_ID
	//FARMER_NAME	//////////////////////////////////////////////////////////////////////////////////////////Map Stats	//////////////////////////////////////////////////////////////////////////////////////

	CELL
	STATIC
	//////////////////////////////////////////////////////////////////////////////////////////INIT
	//////////////////////////////////////////////////////////////////////////////////////
	constructor(id, SummonerLevelTimes, Chip, To, Summoner, SummonerStats) {//TO Check Map Out Cuz Ram
		MAX_ID = id
		var MapChipsToFunctions = [
			CHIP_PUNY_BULB: function(id, SummonerLevelTimes, To, Summoner, SummonerStats) {
				/**
				 * Fight Stats
				 **/
				this.ABSOLUTE_SHIELD = 0
				this.RELATIVE_SHIELD = 0
				this.DAMAGE_RETURN = 0 //Its always 0 at the start, so like this i will save the exact total buff of each so not saving it
				this.POWER = 0
				this.SUMMONER = Summoner
				this.SUMMONS = []
				this.SUMMON = true
				this.ID = id
				//this.WEAPON = Not Yet Weapon Bulbs
				this.INVENTORY = [
					CHIP_PEBBLE,
					CHIP_HELMET,
					CHIP_PROTEIN,
					CHIP_BANDAGE
				]
				this.COOLDOWNS = [: ]
				for (var i in this.INVENTORY) {
					this.COOLDOWNS[i] = 0
					//if (Items.isSpecialWeap(i)) this.SPECIAL_WEAPON = i (not yet ?)
				}
				this.ALLY = SummonerStats.ALLY
				this.ENEMY = SummonerStats.ENEMY
				this.EFFECTS = []
				this.EFFECTS_ITEM_MAP = [: ]
				this.POISON = 0
				this.POISON_OVER_TIME = 0
				this.JUST_POISON = 0
				this.JUST_POISON_OVER_TIME = 0
				this.TURN_ORDER = getEntityTurnOrder(Summoner) + 1
				/**
				 * Leek Stats
				 **/
				//Maybe Floor all these values to make it clean and precise ?
				this.LIFE = 50 + 250 * SummonerLevelTimes
				this.TOTAL_LIFE = this.LIFE
				this.STRENGTH = 100 * SummonerLevelTimes
				this.WISDOM = 100 * SummonerLevelTimes
				this.AGILITY = 100 * SummonerLevelTimes
				this.RESISTANCE = 100 * SummonerLevelTimes
				this.SCIENCE = 100 * SummonerLevelTimes
				this.MAGIC = 0
				this.FREQUENCY = 0
				this.MP = 3 + 2 * SummonerLevelTimes
				this.TOTAL_MP = this.MP
				this.TP = 4 + 3 * SummonerLevelTimes
				this.TOTAL_TP = this.TP
				this.NAME = "puny_bulb"
				//this.AI_NAME = SummonerStats.AI_NAME
				//this.AI_ID = SummonerStats.AI_ID
				//this.FARMER_NAME = SummonerStats.FARMER_NAME
				/**
				 * Original Stats for Libe And Shackle summ for Manumission (No need to edit these with the map after cuz he will spawn without any effects)
				 **/
				this.TO_SAVE_STRENGTH = this.STRENGTH //initial strength of the leek
				this.TO_SAVE_SHACKLE_STRENGTH = 0 //Total Shackle Effects
				this.TO_SAVE_WISDOM = this.WISDOM
				this.TO_SAVE_SHACKLE_WISDOM = 0
				this.TO_SAVE_AGILITY = this.AGILITY
				this.TO_SAVE_SHACKLE_AGILITY = 0
				this.TO_SAVE_RESISTANCE = this.RESISTANCE
				//this.TO_SAVE_SHACKLE_RESISTANCE = 0
				this.TO_SAVE_SCIENCE = this.SCIENCE
				//this.TO_SAVE_SHACKLE_SCIENCE = 0
				this.TO_SAVE_MAGIC = this.MAGIC
				this.TO_SAVE_SHACKLE_MAGIC = 0
				this.TO_SAVE_MP = this.MP
				//this.TO_SAVE_SHACKLE_MP = 0
				this.TO_SAVE_TOTAL_MP = this.TOTAL_MP
				this.TO_SAVE_SHACKLE_TOTAL_MP = 0
				this.TO_SAVE_TP = this.TP
				//this.TO_SAVE_SHACKLE_TP = 0
				this.TO_SAVE_TOTAL_TP = this.TOTAL_TP
				this.TO_SAVE_SHACKLE_TOTAL_TP = 0
				/**
				 * Map Stats
				 **/
				this.CELL = To
				this.STATIC = false
			},
