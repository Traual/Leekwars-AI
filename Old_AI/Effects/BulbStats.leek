			CHIP_METALLIC_BULB: function(id, SummonerLevelTimes, To, Summoner, SummonerStats) {
				/**
				 * Fight Stats
				 **/
				this.ABSOLUTE_SHIELD = 0
				this.RELATIVE_SHIELD = 0
