		TarStats.TO_SAVE_SHACKLE_STRENGTH += Damage
	}

	static getEntityShackleTpConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		var Damage = (Effect[1]) * DistToAoeNumber(Dist) * (1 + CastStats.MAGIC / 100) // No MULTIPLIER (Yet)
		TarStats.TP -= Damage
		TarStats.TOTAL_TP -= Damage
		//TarStats.TO_SAVE_SHACKLE_TP += Damage
		TarStats.TO_SAVE_SHACKLE_TOTAL_TP += Damage
	}

	static getEntityShackleWisdomConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		// No MULTIPLIER No DIST(Yet)
		var Damage = (Effect[1]) /* DistToAoeNumber(Dist)*/ * (1 + CastStats.MAGIC / 100)
		TarStats.WISDOM -= Damage
		TarStats.TO_SAVE_SHACKLE_WISDOM += Damage
	}

	static getEntityStealAbsoluteShieldConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		//No Dist no Multiplier (Yet)
		TarStats.ABSOLUTE_SHIELD += Effect[1] /* DistToAoeNumber(Dist) * Multiplier*/
	}

	static getEntitySummonConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		debugW("Summon, special effect Not Handeled in consequences")
	}

	static getEntityVulnerabilityConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		//No Dist no Multiplier (Yet)
		TarStats.RELATIVE_SHIELD -= Effect[1] /* DistToAoeNumber(Dist) * Multiplier*/
	}

	static DistToAoeNumber(dist) {
		return 1 - (dist * 0.2)
	}

