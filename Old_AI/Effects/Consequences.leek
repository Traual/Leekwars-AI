	static getConsequences(ActualStats, Item, From, To, Caster, BaseHash) { //Need from for lasers 
		Benchmark.ConsequencesStart()
		var Targets = ConsequenceTargets(Item, From, To, ActualStats, Caster, BaseHash)
		var CastStats = ActualStats[Caster]
		for (var Effect in ITEMINFO[Item].EFFECTS) {
			var EffectType = Effect[0]
			if (EffectType == EFFECT_SUMMON) {
				var Id = MAX_ID + 1 //Put in stats ? TODO
				var EntityStats = new BulbStats(Id, SUMMONER_LEVEL_TIMES, Item, To, Caster, CastStats)
				ActualStats[Id] = EntityStats
				continue
			} else if (EffectType == EFFECT_RESURRECT) {
				Resurrection.Update(To, ActualStats, ALL_DEAD_ENTITIES)
				continue
			}
			var TmpTargets = RealConsequenceTargets(Targets, Effect, ActualStats, CastStats, Caster)
			var Multiplier = (Effect[5] & EFFECT_MODIFIER_MULTIPLIED_BY_TARGETS) ? mapSize(TmpTargets) : 1 //Saving Multiplier
			var RealTargets = Effect[5] & EFFECT_MODIFIER_ON_CASTER ? [Caster: 0] : TmpTargets
			ConsMap[EffectType](ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats)
		}
		Benchmark.ConsequencesStop()
	}

	static isHitable(Effect, TarStats, CastStats, TarIsCaster) { //Determine wether or not the effect can be put on target (for example : Burning on leek : false, Vaccin on Ally : True)
		//if (CastStats.LIFE <= 0 || TarStats.LIFE <= 0) return false
		var tmp = Effect[4]
		var Hash = tmp + TarStats.ID * 100
		if (Hash in HITABLEOK) return !(tmp & EFFECT_TARGET_CASTER) && TarIsCaster ? false : HITABLEOK[Hash]
		var Ally = CastStats.ENEMY ? TarStats.ENEMY : TarStats.ALLY
		var Summ = TarStats.SUMMON
		if ((!(tmp & EFFECT_TARGET_ALLIES) && Ally) || (!(tmp & EFFECT_TARGET_ENEMIES) && !Ally) || (!(tmp & EFFECT_TARGET_NON_SUMMONS) && !Summ) || (!(tmp & EFFECT_TARGET_SUMMONS) && Summ)) {
			HITABLEOK[Hash] = false
			return false
		} else {
			HITABLEOK[Hash] = true
			return !(!(tmp & EFFECT_TARGET_CASTER) && TarIsCaster)
		}
	}

	static EffectsRemove = [
		EFFECT_ABSOLUTE_SHIELD: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.ABSOLUTE_SHIELD -= ValueOfEffect
		},
		EFFECT_ABSOLUTE_VULNERABILITY: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.ABSOLUTE_SHIELD += ValueOfEffect
		},
		EFFECT_AFTEREFFECT: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.POISON -= ValueOfEffect
			StatsTarget.POISON_OVER_TIME -= ValueOfEffect * DurationOfEffect
		},
		EFFECT_ALLY_KILLED_TO_AGILITY: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.AGILITY -= ValueOfEffect
		},
		EFFECT_BUFF_AGILITY: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.AGILITY -= ValueOfEffect
		},
		EFFECT_BUFF_MP: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.MP -= ValueOfEffect
			StatsTarget.TOTAL_MP -= ValueOfEffect
		},
		EFFECT_BUFF_RESISTANCE: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.RESISTANCE -= ValueOfEffect
		},
		EFFECT_BUFF_STRENGTH: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.STRENGTH -= ValueOfEffect
		},
		EFFECT_BUFF_TP: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
