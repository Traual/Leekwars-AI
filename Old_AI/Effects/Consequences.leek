	static ConsequenceTargetsWithoutMe(Item, To, EveryStats, BaseHash) {
		var Hash = ConsequenceTargetsHash(BaseHash, Item, To, To)
		if (Hash in CONSEQUENCE_TARGET_CACHE_WITHOUT_ME) {
			return CONSEQUENCE_TARGET_CACHE_WITHOUT_ME[Hash]
		}
		var Tars = [: ]
		FunctionMapForConsequenceTargetsWithoutMe[ITEMINFO[Item].AREA](Tars, Item, To, To, EveryStats)
		CONSEQUENCE_TARGET_CACHE_WITHOUT_ME[Hash] = Tars
		return Tars
	}

	static ConsequenceTargetsHash(BaseHash, Item, From, To) {//BaseHash is Cell:Id Hash
		return (BaseHash * MAX_ITEM * MAX_CELL * MAX_CELL) + (Item * MAX_CELL * MAX_CELL) + (From * MAX_CELL) + To
	}

	static RealConsequenceTargets(AllTargets, Effect, ActualStats, CastStats, Caster) {//TODO opti with map remove in alltargets
		var _final = [: ]
		for (var tar: var dist in AllTargets) {
			if (isHitable(Effect, ActualStats[tar], CastStats, tar == Caster)) _final[tar] = dist
		}
		return _final
	}

	static getItemDanger(item, casterstats, targetstats, Distance, Multiplier) {
		var Info = ITEMINFO[item]
		if (!isHitable(Info.EFFECTS[0], targetstats, casterstats, false)) return 0 //Ugly for the effect part might redo it clean ?
		var _final = 0
		for (var eff in Info.EFFECTS) {
			if (eff[5] & EFFECT_MODIFIER_ON_CASTER) continue
			if (TmpMapForItemDanger[eff[0]]) _final += TmpMapForItemDanger[eff[0]](casterstats, targetstats, eff, Distance, Multiplier)
		}
		return _final
	}

	static TmpMapForItemDanger = [
		EFFECT_DAMAGE: function(casterstats, targetstats, Effect, Distance, Multiplier) {
			return ((Effect[2] * Consequences.DistToAoeNumber(Distance) * Multiplier * (1 + casterstats.POWER / 100)) * (1 + casterstats.STRENGTH / 100) * (1 - targetstats.RELATIVE_SHIELD / 100) - targetstats.ABSOLUTE_SHIELD)
		},
		EFFECT_LIFE_DAMAGE: function(casterstats, targetstats, Effect, Distance, Multiplier) {
			return ((Effect[2] * (1 + casterstats.POWER / 100)) * (casterstats.LIFE / 100) * (1 - targetstats.RELATIVE_SHIELD / 100) - targetstats.ABSOLUTE_SHIELD)
		},
		EFFECT_POISON: function(casterstats, targetstats, Effect, Distance, Multiplier) {
			return (Effect[2] * (1 + casterstats.POWER / 100)) * Consequences.DistToAoeNumber(Distance) * (1 + casterstats.MAGIC / 100) * /*Effect[3]*/ min(Effect[3], targetstats.COOLDOWNS[CHIP_ANTIDOTE]+1)
		}
	]
}