				Consequences.ReplacementChangeStats(Item, Effect, ActualStats[Tar])
				Consequences.getEntityAbsoluteShieldConsequences(Dist, Multiplier, Effect, ActualStats[Tar], CastStats, Tar == Caster)
			}
