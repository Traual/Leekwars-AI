	static ReplacementChangeStats(Item, Effect, TarStats) { //Determine wether or not the effect will change something (And make the changes before application of item) (Stackable and already here ? : True. Not Stackable And here : False)
		if (Effect[5] & EFFECT_MODIFIER_STACKABLE) return; //stackable, then pass
		if (TarStats.EFFECTS_ITEM_MAP[Item]) { //Otherwise check if enemy already has item
			//Then search the effect on target : 
			for (var eff in TarStats.EFFECTS) {
				if (eff[5] == Item) {
					EffectsRemove[eff[0]](TarStats, eff[1], eff[3])
				}
			}
		}
	}

	static RemoveCastedEffects(EveryStats, Caster) {
		for (var e: var stat in EveryStats) {
			for (var eff in stat.EFFECTS) {
				if (eff[2] == Caster) {
					//debugW("removing an effect from a kill")
					EffectsRemove[eff[0]](stat, eff[1], eff[3])
				}
			}
		}
	}

	static getKillConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster, EveryStats, AddTpEnhancedLightninger) {
		//Remove his Life
		TarStats.LIFE = 0
		var Killed = TarStats.ID
		//Then Remove his Effects Casted
		RemoveCastedEffects(EveryStats, Killed)
		//Then Remove his bulbs
		//Then Remove the bulb's casted effects
		for (var e: var stat in EveryStats) {
			if (stat.SUMMONER == Killed) { //TODO : Doesn't work on TarStats
				getKillConsequences(Dist, Multiplier, Effect, stat, CastStats, TarIsCaster, EveryStats, false)
			}
			if (stat.SPECIAL_WEAPON == WEAPON_ENHANCED_LIGHTNINGER && AddTpEnhancedLightninger) { //TODO: Redo clean
				stat.TOTAL_TP++
				stat.TP++
			} else {
				if (stat.SPECIAL_WEAPON == WEAPON_DARK_KATANA) stat.AGILITY += 100
			}
		}
		//Then add special effects (Like Dark Katana and Enhanced_Lightner) //TODO !

		//Adding Power : 
		var cp = ChestPower[TarStats.NAME]
		if (cp) CastStats.POWER += cp
		if (FIGHT_TYPE == FIGHT_TYPE_BATTLE_ROYALE) {
			if (TarStats.SUMMON) {
				CastStats.POWER += 2 + floor(TarStats.POWER / 2)
			} else {
				CastStats.POWER += 10 + floor(TarStats.POWER / 2)
			}
		}
	}

	static ChestPower = [
		"wooden_chest": 10,
		"iron_chest": 50,
		"diamond_chest": 100
	]

	static SpeMapNova = [
		WEAPON_UNBRIDLED_GAZOR: function(TarStatsTmp, DamageTmp) {
			TarStatsTmp.MAGIC += DamageTmp * 0.2 // Cuz 10 percent of nova damage
		}
	]

	static SpeMap = [
		WEAPON_REVOKED_M_LASER: function(TarStatsTmp, DamageTmp) {
			TarStatsTmp.STRENGTH += DamageTmp * 0.05
		},
		WEAPON_UNBRIDLED_GAZOR: function(TarStatsTmp, DamageTmp) {
			TarStatsTmp.MAGIC += DamageTmp * 0.01 // Cuz 10 percent of nova damage so 10 percent of 5 percent
		},
		WEAPON_MYSTERIOUS_ELECTRISOR: function(TarStatsTmp, DamageTmp) {
			TarStatsTmp.ABSOLUTE_SHIELD += DamageTmp * 0.05
		}
	]

	static getEntityDamageConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster, EveryStats) {
		var BaseDamages = (Effect[1] * DistToAoeNumber(Dist) * Multiplier) * (1 + CastStats.STRENGTH / 100) * (1 + CastStats.POWER / 100)
		var DamagesWithShield = max(0, BaseDamages * (1 - TarStats.RELATIVE_SHIELD / 100) - TarStats.ABSOLUTE_SHIELD)
		var TargetLife = TarStats.LIFE
		var Damage = min(DamagesWithShield, TargetLife) // Either the full damage or the Life (If Kill)
		if (Damage >= TargetLife && TargetLife > 0) {
			//debug("entered kill consequence")
			getKillConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster, EveryStats, true) //Killed so consequences
		} else {
			TarStats.LIFE -= Damage
		}
		TarStats.TOTAL_LIFE -= Damage * EROSION_NO_POISON
		if (!TarIsCaster) {
			var Damage_Return = BaseDamages * (TarStats.DAMAGE_RETURN / 100)
			CastStats.LIFE += min(Damage * (CastStats.WISDOM / 1000), CastStats.TOTAL_LIFE - CastStats.LIFE) - Damage_Return //Either the full heal or the leftover heal (If near full life) Then the damage return (applied like this in fights)
			//Then Damage Return Erosion
			CastStats.TOTAL_LIFE -= Damage_Return * EROSION_NO_POISON
		}
		var fct = SpeMap[TarStats.SPECIAL_WEAPON]
		if (fct != null) SpeMap[TarStats.SPECIAL_WEAPON](TarStats, Damage)
	}

	static getEntityRawBuffTpConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		var add = Effect[1] /* DistToAoeNumber(Dist)*/ * Multiplier //No dist cuz no aoe ?
		TarStats.TP += add
		TarStats.TOTAL_TP += add
	}

	static getEntityAbsoluteShieldConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		//var add = Effect[1] * CastStats.RESISTANCE /* DistToAoeNumber(Dist) * Multiplier*/ //No dist cuz no aoe and no multiplier No need to var cuz only one time used
		TarStats.ABSOLUTE_SHIELD += Effect[1] * (1 + CastStats.RESISTANCE / 100)
	}
	static getEntityAbsoluteVulnerabilityConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		//var add = Effect[1] /* DistToAoeNumber(Dist) * Multiplier*/ //No dist cuz no aoe and no multiplier No need to var cuz only one time used
		TarStats.ABSOLUTE_SHIELD -= Effect[1]
	}

	static getEntityAfterEffectConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		var add = Effect[2] * DistToAoeNumber(Dist) * (1 + CastStats.SCIENCE / 100) //EFFECT 2 TO AVOID KILLING ALLIES ?
		/* Multiplier*/ //No multiplier 
		TarStats.LIFE -= add
		TarStats.TOTAL_LIFE -= add * EROSION_NO_POISON //0.05 from actual damage then 5% from after effect poison, but stays over time so how ?
		TarStats.POISON += add //NO add to Just Poison cuz not Antidotable
		TarStats.POISON_OVER_TIME += add * Effect[3]
	}

	static getEntityAntidoteConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		TarStats.POISON -= TarStats.JUST_POISON
		TarStats.JUST_POISON = 0
		TarStats.POISON_OVER_TIME -= TarStats.JUST_POISON_OVER_TIME
		TarStats.JUST_POISON_OVER_TIME = 0
	}

	static getEntityBoostMaxLifeConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		var add = Effect[1] /* DistToAoeNumber(Dist)*/ * (1 + CastStats.WISDOM / 100)
		/* Multiplier*/ //No multiplier and no aoe (yet)
		TarStats.LIFE += add
		TarStats.TOTAL_LIFE += add
	}

	static getEntityBuffAgilityConsequences(Dist, Multiplier, Effect, TarStats, CastStats, TarIsCaster) {
		/* Multiplier*/ //No multiplier (yet)
		TarStats.AGILITY += Effect[1] * DistToAoeNumber(Dist) * (1 + CastStats.SCIENCE / 100)
	}

