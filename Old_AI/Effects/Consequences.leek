			StatsTarget.TOTAL_TP -= ValueOfEffect
		},
		EFFECT_BUFF_WISDOM: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.WISDOM -= ValueOfEffect
		},
		EFFECT_DAMAGE_RETURN: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.DAMAGE_RETURN -= ValueOfEffect
		},
		EFFECT_DAMAGE_TO_ABSOLUTE_SHIELD: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.ABSOLUTE_SHIELD -= ValueOfEffect
		},
		EFFECT_DAMAGE_TO_STRENGTH: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.STRENGTH -= ValueOfEffect
		},
		EFFECT_HEAL: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.POISON += ValueOfEffect
			StatsTarget.POISON_OVER_TIME += ValueOfEffect * DurationOfEffect
		},
		EFFECT_KILL_TO_TP: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.TP -= ValueOfEffect
			StatsTarget.TOTAL_TP -= ValueOfEffect
		},
		EFFECT_MOVED_TO_MP: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.MP -= ValueOfEffect
			StatsTarget.TOTAL_MP -= ValueOfEffect
		},
		EFFECT_NOVA_DAMAGE_TO_MAGIC: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.MAGIC -= ValueOfEffect
		},
		EFFECT_POISON: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.POISON -= ValueOfEffect
			StatsTarget.POISON_OVER_TIME -= ValueOfEffect * DurationOfEffect
			StatsTarget.JUST_POISON -= ValueOfEffect
			StatsTarget.JUST_POISON_OVER_TIME -= ValueOfEffect * DurationOfEffect
		},
		EFFECT_POISON_TO_SCIENCE: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.SCIENCE -= ValueOfEffect
		},
		EFFECT_RAW_ABSOLUTE_SHIELD: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
			StatsTarget.ABSOLUTE_SHIELD -= ValueOfEffect
		},
		EFFECT_RAW_BUFF_AGILITY: function(StatsTarget, ValueOfEffect, DurationOfEffect) {
