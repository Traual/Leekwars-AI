	/* Loads the tp Coef of an allies, it loads it with the entity score in fight and Placement Importance To everyone
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
	* @param EntityImportanceMap Map <Id : Int> Importance of Entity in the fight
	* @param EntityScoreInFight Score of importance of Entity in the Fight
    *
    * @return Int : Coef Tp of Entity
    */

	static getTpCoefForAllies(EveryStats, EntityStats, EntityScoreInFight, EntityImportanceMap) {
		var _final = EntityScoreInFight

		_final *= (getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) +  getPlacementImportanceToEntityAllies(EntityStats, EveryStats, EntityImportanceMap)) / 2 //The More he is close to my everyone the more i want to add tp to him (divided by to align it with other coefs)

		return _final * TotalTpAlliesImportance
	}

	/* Loads the tp Coef of an enemy, it loads it with the entity score in fight and Placement Importance To everyone
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
	* @param EntityImportanceMap Map <Id : Int> Importance of Entity in the fight
	* @param EntityScoreInFight Score of importance of Entity in the Fight
    *
    * @return Int : Coef Tp of Entity
    */

	static getTpCoefForEnemies(EveryStats, EntityStats, EntityScoreInFight, EntityImportanceMap) {
		var _final = EntityScoreInFight

		_final *= (getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) +  getPlacementImportanceToEntityAllies(EntityStats, EveryStats, EntityImportanceMap)) / 2 //The More he is close to my everyone the more i want to add tp to him (divided by to align it with other coefs)

		return -_final * TotalTpEnemiesImportance
	}

	/* Loads the mp Coef of an ally, it loads it with the entity score in fight and Placement Importance To everyone
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
	* @param EntityImportanceMap Map <Id : Int> Importance of Entity in the fight
	* @param EntityScoreInFight Score of importance of Entity in the Fight
    *
    * @return Int : Coef Mp of Entity
    */

	static getMpCoefForAllies(EveryStats, EntityStats, EntityScoreInFight, EntityImportanceMap) {
		if (EntityStats.STATIC) return 0

		var _final = EntityScoreInFight

		_final *= (getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) +  getPlacementImportanceToEntityAllies(EntityStats, EveryStats, EntityImportanceMap)) / 2 //The More he is close to my everyone the more i want to add mp to him (divided by to align it with other coefs)
		
		return _final * TotalMpAlliesImportance
	}

	/* Loads the mp Coef of an enemy, it loads it with the entity score in fight and Placement Importance To everyone
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
	* @param EntityImportanceMap Map <Id : Int> Importance of Entity in the fight
	* @param EntityScoreInFight Score of importance of Entity in the Fight
    *
    * @return Int : Coef Mp of Entity
    */

	static getMpCoefForEnemies(EveryStats, EntityStats, EntityScoreInFight, EntityImportanceMap) {
		if (EntityStats.STATIC) return 0

		var _final = EntityScoreInFight 

		_final *= (getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) +  getPlacementImportanceToEntityAllies(EntityStats, EveryStats, EntityImportanceMap)) / 2 //The More he is close to my everyone the more i want to add tp to him (divided by to align it with other coefs)

		return -_final * TotalMpEnemiesImportance
	}
	
	static ScoringWichId(EveryDeadStats, MyStats, EveryStats, EntityImportanceMap) {
		var _final_id
		var top_score = 0
		for (var id:var stat in EveryDeadStats) {
			if (stat.ENEMY) continue
			var Score = getResurrectScore(stat, MyStats, EveryStats, EntityImportanceMap)
			if (Score > top_score) {
				_final_id = id
				top_score = Score
			}
		}
		return _final_id
	}

	static getResurrectScore(DeadEntityStats, MyStats, EveryStats, EntityImportanceMap) {
		var Hash = Resurrection.HashEveryScores(DeadEntityStats.ID, DeadEntityStats.TOTAL_LIFE)
		if (Hash in RESURRECT_SCORE_CACHE) {
			return RESURRECT_SCORE_CACHE[Hash]
		}
		var EntityStats = clone(DeadEntityStats, 2)
		Resurrection.getAliveStatsFromDeadStats(EntityStats)
		var SummonScore = 0.06 * getSummonScoreForInventory(MyStats, EntityStats.INVENTORY, EntityStats, EveryStats, EntityImportanceMap)
		var Tmp =  getEntitySummonScore(EntityStats, EveryStats, EntityImportanceMap) * SummonScore
		RESURRECT_SCORE_CACHE[Hash] = Tmp
		return Tmp
	}

	static updateCooldownScoresMap(EveryStats, EnemyTeamIndexes) {
		COOLDOWN_SCORES_MAP = [: ]
		for (var Item:var Fct in MapItemCooldownFunction) {
			COOLDOWN_SCORES_MAP[Item] = Fct(EveryStats, EnemyTeamIndexes)
		}
		return COOLDOWN_SCORES_MAP
	}

	static MapItemCooldownFunction = [
		CHIP_ADRENALINE: function(EveryStats, EnemyTeamIndexes) {
			return 2 / Coefs.getNumberOfItemInAllyTeam(EveryStats, CHIP_ADRENALINE)
    	},
    	CHIP_ANTIDOTE: function(EveryStats, EnemyTeamIndexes) {
			return (EnemyTeamIndexes.MAGIC_INDEX / 35) / Coefs.getNumberOfItemInAllyTeam(EveryStats, CHIP_ANTIDOTE)
    	},
    	CHIP_BRAMBLE: function(EveryStats, EnemyTeamIndexes) {
			return (EnemyTeamIndexes.STRENGTH_INDEX / 150) / Coefs.getNumberOfItemInAllyTeam(EveryStats, CHIP_BRAMBLE)
    	},
		CHIP_COVID: function(EveryStats, EnemyTeamIndexes) {
			return 20 / Coefs.getNumberOfItemInAllyTeam(EveryStats, CHIP_COVID)
    	},
    	CHIP_LIBERATION: function(EveryStats, EnemyTeamIndexes) {
			return (EnemyTeamIndexes.RESISTANCE_INDEX / 800) / Coefs.getNumberOfItemInAllyTeam(EveryStats, CHIP_LIBERATION)
    	},
    	CHIP_REGENERATION: function(EveryStats, EnemyTeamIndexes) {
			return (40 + ((EnemyTeamIndexes.STRENGTH_INDEX / 400)) / Coefs.getNumberOfItemInAllyTeam(EveryStats, CHIP_REGENERATION))
    	},
		CHIP_PLAGUE: function(EveryStats, EnemyTeamIndexes) {
			return 7 / Coefs.getNumberOfItemInAllyTeam(EveryStats, CHIP_PLAGUE)
    	},
    	CHIP_PUNISHMENT: function(EveryStats, EnemyTeamIndexes) {
			return 2 / Coefs.getNumberOfItemInAllyTeam(EveryStats, CHIP_PUNISHMENT)
    	},
    	CHIP_MANUMISSION: function(EveryStats, EnemyTeamIndexes) {
			return (EnemyTeamIndexes.MAGIC_INDEX / 800) / Coefs.getNumberOfItemInAllyTeam(EveryStats, CHIP_MANUMISSION)
    	},
    	CHIP_RESURRECTION: function(EveryStats, EnemyTeamIndexes) {
			return 4 / Coefs.getNumberOfItemInAllyTeam(EveryStats, CHIP_RESURRECTION)
    	},
    	CHIP_JUMP: function(EveryStats, EnemyTeamIndexes) {
			return 1 / Coefs.getNumberOfItemInAllyTeam(EveryStats, CHIP_JUMP)
    	},
    	CHIP_TELEPORTATION: function(EveryStats, EnemyTeamIndexes) {
			return 3 / Coefs.getNumberOfItemInAllyTeam(EveryStats, CHIP_JUMP)
    	}
	]

	static getNumberOfItemInAllyTeam(EveryStats, Item) {
		var _final = 1
		for (var ally:var stat in EveryStats) {
			if (stat.ENEMY) continue
			if (Item in stat.COOLDOWNS) _final++
		}
		return _final > 1 ? _final - 1 : _final //To avoid dividing by 0
	}
}