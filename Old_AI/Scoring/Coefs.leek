		//Then Every 200 Damages Return, the coef divides by 2 to avoid going full shield and Damages Return at the same time
		_final /= (1 + (EntityStats.DAMAGE_RETURN/200))

		//Then I return the coef
		return _final * RelativeShieldAlliesImportance
	}

