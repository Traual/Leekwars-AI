	/* Loads the relative shield Coef of an ally, it works like a relative shield to see what percentage of damages incoming are Damages and Not Poisons
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
	* @param EntityScoreInFight The score of importance in fight of the entity
    *
    * @return Int : Coef Damage Return of Entity
    */

	static getDamageReturnCoefForAllies(EveryStats, EntityStats, EntityScoreInFight) {
		//First i look at the entity Importance cuz coef will scale on it
		var _final = EntityScoreInFight

		//I Load Entity Danger Weighted By dist for its actual Absolute Shield and + 10 absolute Shield
		var ClonedStats = clone(EntityStats, 2)
		var BaseDanger = getDangerWeightedByDist(ClonedStats, EveryStats)
		ClonedStats.RELATIVE_SHIELD += 10 //I can change it to avoid counting actual shields (with setting abs and rel to 0 before but i want to add more damages returns to target without shield)
		var NewDanger = getDangerWeightedByDist(ClonedStats, EveryStats)
		//I add the difference to _final
		_final *= BaseDanger - NewDanger

		//Then Every 200 Damages Return, the coef divides by 2 to try and put equal damages return on every allies
		_final /= (1 + (EntityStats.DAMAGE_RETURN/200))

		//Then I return the coef
		return _final * DamageReturnAlliesImportance
	}

	/* Loads the relative shield Coef of an enemy, it works like a relative shield to see what percentage of damages incoming are Damages and Not Poisons
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
	* @param EntityScoreInFight The score of importance in fight of the entity
    *
    * @return Int : Coef Damage Return of Entity
    */
	
	static getDamageReturnCoefForEnemies(EveryStats, EntityStats, EntityScoreInFight) {
		//First i look at the entity Importance cuz coef will scale on it
		var _final = EntityScoreInFight

		//I Load Entity Danger Weighted By dist for its actual Absolute Shield and + 10 absolute Shield
		var ClonedStats = clone(EntityStats, 2)
		var BaseDanger = getDangerWeightedByDist(ClonedStats, EveryStats)
		ClonedStats.RELATIVE_SHIELD -= 10 //I can change it to avoid counting actual shields (with setting abs and rel to 0 before but i want to remove more damages returns to target without shield)
		var NewDanger = getDangerWeightedByDist(ClonedStats, EveryStats)
		//I add the difference to _final
		_final *= BaseDanger - NewDanger

		//Then Every 200 Damages Return, the coef divides by 2 cuz 100 damage return is more important a 100 damages return then at 250
		_final /= (1 + (EntityStats.DAMAGE_RETURN/200))

		//Then I return the coef
		return _final * DamageReturnEnemiesImportance
	}

	/* Loads the power Coef of an ally, it takes every damages at every people weighted by dist and this entity importance in fight, and kinda derivates it (like absolute shield or strenght)
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
	* @param EntityImportanceMap Map <Id : Int> Importance of Entity in the fight
    *
    * @return Int : Coef Power of Entity
    */

	static getPowerCoefForAllies(EveryStats, EntityStats, EntityImportanceMap) {
		//I Load its possible damage output right now, and with 10 more power to see how much damages this buff is equal to (timed by dist and entity importance of targets ofc)
		var ClonedStats = clone(EntityStats, 2)
		var BaseDanger = getDamageOutputWeightedByDistAndImportance(ClonedStats, EveryStats, EntityImportanceMap)
		ClonedStats.POWER += 10
		var NewDanger = getDamageOutputWeightedByDistAndImportance(ClonedStats, EveryStats, EntityImportanceMap)
		//I add the difference to _final
		var _final = NewDanger - BaseDanger

		//Then I return the coef
		return _final * PowerAlliesImportance
	}

	/* Loads the power Coef of an enemy, it takes every damages at every people weighted by dist and this entity importance in fight, and kinda derivates it (like absolute shield or strenght)
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
	* @param EntityImportanceMap Map <Id : Int> Importance of Entity in the fight
    *
    * @return Int : Coef Power of Entity
    */

	static getPowerCoefForEnemies(EveryStats, EntityStats, EntityImportanceMap) {
		//I Load its possible damage output right now, and with 10 less power to see how much damages this nerf is equal to (timed by dist and entity importance of targets ofc)
		var ClonedStats = clone(EntityStats, 2)
		var BaseDanger = getDamageOutputWeightedByDistAndImportance(ClonedStats, EveryStats, EntityImportanceMap)
		ClonedStats.POWER -= 10
		var NewDanger = getDamageOutputWeightedByDistAndImportance(ClonedStats, EveryStats, EntityImportanceMap)
		//I add the difference to _final
		var _final = NewDanger - BaseDanger

		//Then I return the coef
		return _final * PowerAlliesImportance
	}

	/* Loads the Poison Coef of an enemy, it is just some ifs to get the need to poison an entity (for 1 turn)
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
    *
    * @return Int : Coef Poison of Entity
    */

	static getPoisonCoefForEnemies(EveryStats, EntityStats, EntityImportanceMap, EntityScoreInFight) {

		var _final = EntityScoreInFight 

		_final *= (1 + EntityStats.POISON/5000) //The More Poison he has the more i want to poison him over time
		
		_final *= getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) //The More he is close to my allies the more i want to damage him (to protect my entities from his damages)

		return _final * PoisonEnemiesImportance
	}

	/* Loads the Poison Coef of an ally, it is just some ifs to get the need to poison an entity (for 1 turn)
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
    *
    * @return Int : Coef Poison of Entity
    */

	static getPoisonCoefForAllies(EveryStats, EntityStats, EntityImportanceMap, EntityScoreInFight) {
		
		var _final = EntityScoreInFight 

		_final *= 1 / (1 + EntityStats.POISON/5000) //The Less Poison he has the more i want to poison him over time
		
		_final *= getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) //The More he is close to my enemies the more i want to serum him ? (cuz he will take damages)

		return -_final * PoisonAlliesImportance
	}

	/* Loads the Poison Over Time Coef of an enemy, it is just some ifs to get the need to poison an entity (for x turns > 1)
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
    *
    * @return Int : Coef Poison of Entity
    */

	static getPoisonOverTimeCoefForEnemies(EveryStats, EntityStats, EntityImportanceMap, EntityScoreInFight) {

		var _final = EntityScoreInFight

		_final *= (1 + EntityStats.POISON_OVER_TIME/10000) //The More Poison he has the more i want to poison him over time
		
		_final *= getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) //The More he is close to my allies the more i want to damage him (to protect my entities from his damages)

		_final *= 1 + (EntityStats.COOLDOWNS[CHIP_ANTIDOTE] / 4) + (getAverageAntidoteCooldown(EntityStats, EveryStats) / 2)

		return _final * PoisonOverTimeEnemiesImportance
	}

	/* Loads the Poison Coef of an ally, it is just some ifs to get the need to poison an entity (for 1 turn)
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
    *
    * @return Int : Coef Poison of Entity
    */

	static getPoisonOverTimeCoefForAllies(EveryStats, EntityStats, EntityImportanceMap, EntityScoreInFight) {
		
		var _final = EntityScoreInFight

		_final *= 1 / (1 + EntityStats.POISON_OVER_TIME/10000) //The Less Poison he has the more i want to poison him over time
		
		_final *= getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) //The More he is close to my enemies the more i want to serum him ? (cuz he will take damages)

		return -_final * PoisonOverTimeAlliesImportance
	}

	/* Loads the Life Coef of an enemy, it is just some ifs to get the need to add life to an entity
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
    *
    * @return Int : Coef Life of Entity
    */

	static getLifeCoefForEnemies(EveryStats, EntityStats, EntityImportanceMap, EntityScoreInFight) {
		//We Add Its Life Into Score : (The Less Life he has, the more i want to damage him)
		var _final = 1 / (1 + min(5000, EntityStats.LIFE)/4000)
		//Then we add entity importance distance :

		_final *= getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) //The More he is close to my enemies the more i want to damage him (to protect my entities from his damages)

		//Then We Put the Entity Importance : 
		_final *= EntityScoreInFight
		//Then We Return _final
		return -_final * LifeEnemiesImportance
	}

	/* Loads the Life Coef of an ally, it is just some ifs to get the need to add life to an entity
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
    *
    * @return Int : Coef Life of Entity
    */

	static getLifeCoefForAllies(EveryStats, EntityStats, EntityImportanceMap,  EntityScoreInFight) {

		if (EntityStats.POISON > EntityStats.TOTAL_LIFE) return 0//All the heal of the world can't save him (if i don't add some max life to him)

		//We Add Its Life Into Score : (The Less Life he has, the more i want to heal him)
		var _final = 1 / (1 + EntityStats.LIFE/4000)
		//Then we add entity importance distance :

		_final *= getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) //The More he is close to my enemies the more i want to heal him (so he can continue to deal damages or just don't die)

		//Then We Put the Entity Importance : 
		_final *= EntityScoreInFight
		//Then We Return _final
		return _final * LifeAlliesImportance
	}


	/* Loads the Total Life Coef of an enemy, it is just some ifs to get the need to add total life to an entity
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
    *
    * @return Int : Coef Total Life of Entity
    */

	static getTotalLifeCoefForEnemies(EveryStats, EntityStats, EntityImportanceMap, EntityScoreInFight) {
		//We Add Its Life Into Score : (The Less Life he has, the more i want to remove total life him)
		var _final = 1
		//Then we add entity importance distance :

		_final *= getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) //The More he is close to my allies the more i want to damage him (to protect my entities from his damages)

		//Then We Put the Entity Importance : 
		_final *= EntityScoreInFight
		//Then We Return _final
		return -_final * TotalLifeEnemiesImportance
	}

	/* Loads the Total Life Coef of an ally, it is just some ifs to get the need to add total life to an entity
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
    *
    * @return Int : Coef Total Life of Entity
    */

	static getTotalLifeCoefForAllies(EveryStats, EntityStats, EntityImportanceMap, EntityScoreInFight) {
		//We Add Its Life Into Score : (The Less Life he has, the more i want to add total life to him)
		var _final = 1 / (1 + EntityStats.TOTAL_LIFE/1000)
		//Then we add entity importance distance :

		_final *= getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) //The More he is close to my enemies the more i want to add total life to him (so he can continue to deal damages or just don't die)

		//Then We Put the Entity Importance : 
		_final *= EntityScoreInFight
		//Then We Return _final
		return _final * TotalLifeAlliesImportance
	}

	/* Loads the strength Coef of an ally, it loads it with Strength Index and Placement Importance To Enemies
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
	* @param EntityImportanceMap Map <Id : Int> Importance of Entity in the fight
	* @param EveryEntityIndexes Class Entity Indexes of Entity
    *
    * @return Int : Coef Strength of Entity
    */

	static getStrengthCoefForAllies(EveryStats, EntityStats, EntityImportanceMap, AllyTeamIndexes, EnemyTeamIndexes) {
		//I Clone the Stats and add strength
		var statt = clone(EntityStats, 2)
		statt.STRENGTH += 10
		//I Look the new absolute importance
		var ThisEntityIndexes = EntityIndexes.getEntityIndexes(statt)
		var EntityNewAbsoluteImportance = EntityIndexes.getEntityImportanceIndex(AllyTeamIndexes, EnemyTeamIndexes, ThisEntityIndexes, statt)
		//I compute the relative difference from this change
		return getRelativeDifferenceInImportance(EntityImportanceMap, EntityImportanceMap[EntityStats.ID], EntityNewAbsoluteImportance) * StrengthAlliesImportance
	}

	/* Loads the strength Coef of an enemy, it loads it with Strength Index and Placement Importance To Allies
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
	* @param EntityImportanceMap Map <Id : Int> Importance of Entity in the fight
	* @param EveryEntityIndexes Class Entity Indexes of Entity
    *
    * @return Int : Coef Strength of Entity
    */

	static getStrengthCoefForEnemies(EveryStats, EntityStats, EntityImportanceMap, AllyTeamIndexes, EnemyTeamIndexes) {
		//I Clone the Stats and remove strength
		var statt = clone(EntityStats, 2)
		statt.STRENGTH -= 10
		//I Look the new absolute importance
		var ThisEntityIndexes = EntityIndexes.getEntityIndexes(statt)
		var EntityNewAbsoluteImportance = EntityIndexes.getEntityImportanceIndex(AllyTeamIndexes, EnemyTeamIndexes, ThisEntityIndexes, statt)
		//I compute the relative difference from this change
		//debug("Strength : "+statt.STRENGTH+" new absolute Importance : "+EntityNewAbsoluteImportance+" old absolute importance : "+EntityImportanceMap[EntityStats.ID]+" new Entity indexes : "+ThisEntityIndexes)
		return getRelativeDifferenceInImportance(EntityImportanceMap, EntityImportanceMap[EntityStats.ID], EntityNewAbsoluteImportance) * StrengthEnemiesImportance
	}

