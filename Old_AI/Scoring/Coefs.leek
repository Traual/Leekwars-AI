/**
 * Here we are preshotting average enemies plays !
**/

include("../includes.leek")

class Coefs {

	//TODO : in shield coefs : if (EntityStats.ID == Me) _final /= x ? (cuz its already counted in danger if i can't put final cell for everyone at the end of my play) (1 min)

	static Update(EveryStats) {
		Benchmark.CoefLoadingStart()

		MAX_RELATIVE_SHIELD_SCORED = 100 //I will score relative shield for a target until 100

		//Refreshing : 
		COEF_ABSOLUTE_SHIELD = [: ]
		COEF_RELATIVE_SHIELD = [: ]
		COEF_DAMAGE_RETURN = [: ]
		COEF_POWER = [: ]
		COEF_POISON = [: ]
		COEF_POISON_OVER_TIME = [: ]
		COEF_LIFE = [: ]
		COEF_TOTAL_LIFE = [: ]
		COEF_STRENGTH = [: ]
		COEF_WISDOM = [: ]
		COEF_AGILITY = [: ]
		COEF_RESISTANCE= [: ]
		COEF_SCIENCE= [: ]
		COEF_MAGIC = [: ]
		COEF_TOTAL_TP = [: ]
		COEF_TOTAL_MP = [: ]
		KILL_SCORE = [: ]
		KILL_SCORE_POISON = [: ]
		KILL_SCORE_POISON_LONG = [: ]
		ENTITY_GRAVITY_SCORE_MAP = [: ]
		LOCKING_ENTITY_SCORE_MAP = [: ]
		COVID_SCORE_MAP = [: ]

		UpdateCoefMaps(EveryStats)
		Benchmark.CoefLoadingStop()
	}
	
	static UpdateCoefMaps(EveryStats) {
		var AllyTeamIndexes = new TeamIndexes(EveryStats, true)
		var EnemyTeamIndexes = new TeamIndexes(EveryStats, false)
		//debug("My Team Indexes : "+AllyTeamIndexes)
		//debug("Enemy Team Indexes : "+EnemyTeamIndexes)
		var MapIdEntityIndexes = [: ]
		for (var e:var stat in EveryStats) {
			MapIdEntityIndexes[e] = EntityIndexes.getEntityIndexes(stat)
		}
		var MapAbsoluteImportance = LoadMapAbsoluteImportance(EveryStats, AllyTeamIndexes, EnemyTeamIndexes, MapIdEntityIndexes)
		var GravityMapAggressiveness = LoadGravityAgressiveness(MapAbsoluteImportance, EveryStats)
		var MapRelativeImportance = getMapRelativeImportance(MapAbsoluteImportance, EveryStats)

		//debug("Gravity Map Aggressiveness Score : "+(GravityMapAggressiveness / 3.5))
		//debug(MapAbsoluteImportance)

		for (var e:var stat in EveryStats) {
			var EveryEntityIndexes = MapIdEntityIndexes[e]
			var EntityScoreInFight = MapRelativeImportance[e]

			if (stat.ALLY) {
				LoadAlliesCoefs(e, stat, EveryStats, EntityScoreInFight, MapRelativeImportance, AllyTeamIndexes, EnemyTeamIndexes, MapAbsoluteImportance)
				LoadAlliesSpecialScores(e, stat, EveryStats, EntityScoreInFight, MapRelativeImportance, MapIdEntityIndexes)
			} else { //Enemies
				LoadEnemiesCoefs(e, stat, EveryStats, EntityScoreInFight, MapRelativeImportance, EnemyTeamIndexes, AllyTeamIndexes, MapAbsoluteImportance)
				LoadEnemiesSpecialScores(e, stat, EveryStats, EntityScoreInFight, MapRelativeImportance, MapIdEntityIndexes, GravityMapAggressiveness)
			}
		}

		UpdateSummonScores(EveryStats, EveryStats[Me], MapRelativeImportance)
		UpdateDeathScores(EveryStats)
		updateCooldownScoresMap(EveryStats, EnemyTeamIndexes)

		/*debug("Here is the map for the coef absolute shield: " + COEF_ABSOLUTE_SHIELD)
		debug("Here is the map for the coef relative shield: " + COEF_RELATIVE_SHIELD)
		debug("Here is the map for the coef damage return: " + COEF_DAMAGE_RETURN)
		debug("Here is the map for the coef power: " + COEF_POWER)
		debug("Here is the map for the coef Poison: " + COEF_POISON)
		debug("Here is the map for the coef Poison Over Time: " + COEF_POISON_OVER_TIME)
		debug("Here is the map for the coef life: " + COEF_LIFE)
		debug("Here is the map for the coef total life: " + COEF_TOTAL_LIFE)*/
		//debug("Here is the map for the coef strength: " + COEF_STRENGTH)
		//debug("Here is the map for the coef wisdom: " + COEF_WISDOM)
		/*debug("Here is the map for the coef agility: " + COEF_AGILITY)
		debug("Here is the map for the coef resistance: " + COEF_RESISTANCE)
		debug("Here is the map for the coef science: " + COEF_SCIENCE)
		debug("Here is the map for the coef magic: " + COEF_MAGIC)
		debug("Here is the map for the coef TP: " + COEF_TOTAL_TP)
		debug("Here is the map for the coef MP: " + COEF_TOTAL_MP)
		debug("Here is the map for the score kill: " + KILL_SCORE)*/
	}

	static LoadMapAbsoluteImportance(EveryStats, AllyTeamIndexes, EnemyTeamIndexes, MapIdEntityIndexes) {
		var MapAbsoluteImportance = [: ]
		for (var e:var stat in EveryStats) {
			if (stat.ALLY) {
				MapAbsoluteImportance[e] = EntityIndexes.getEntityImportanceIndex(AllyTeamIndexes, EnemyTeamIndexes, MapIdEntityIndexes[e], stat)
			} else {
				MapAbsoluteImportance[e] = EntityIndexes.getEntityImportanceIndex(EnemyTeamIndexes, AllyTeamIndexes, MapIdEntityIndexes[e], stat)
			}
		}
		return MapAbsoluteImportance
	}

	static UpdateDeathScores(EveryStats) {
		DEATH_SCORE = -KILL_SCORE[Me] + 1
		DEATH_SCORE_POISON = -KILL_SCORE_POISON[Me] + 1
		DEATH_SCORE_POISON_OVER_TIME = -KILL_SCORE_POISON_LONG[Me] + 1
		//Adding Summons to Kill Score :
		for (var DeathSummon in EveryStats[Me].SUMMONS) {
			DEATH_SCORE -= KILL_SCORE[DeathSummon]
			DEATH_SCORE_POISON -= KILL_SCORE_POISON[DeathSummon]
			DEATH_SCORE_POISON_OVER_TIME -= KILL_SCORE_POISON_LONG[DeathSummon]
		}
	}

	static UpdateSummonScores(EveryStats, MyStats, EntityImportanceMap) {
		//SUMMON SCORES
		SummonPuny = getBaseSummonScore(CHIP_PUNY_BULB, EveryStats, MyStats, EntityImportanceMap)
		SummonRocky = getBaseSummonScore(CHIP_ROCKY_BULB, EveryStats, MyStats, EntityImportanceMap)
		SummonIced = getBaseSummonScore(CHIP_ICED_BULB, EveryStats, MyStats, EntityImportanceMap)
		SummonHealer = getBaseSummonScore(CHIP_HEALER_BULB, EveryStats, MyStats, EntityImportanceMap)
		SummonFire = getBaseSummonScore(CHIP_FIRE_BULB, EveryStats, MyStats, EntityImportanceMap)
		SummonWizard = getBaseSummonScore(CHIP_WIZARD_BULB, EveryStats, MyStats, EntityImportanceMap)
		SummonMetallic = getBaseSummonScore(CHIP_METALLIC_BULB, EveryStats, MyStats, EntityImportanceMap)
		SummonSavant = getBaseSummonScore(CHIP_SAVANT_BULB, EveryStats, MyStats, EntityImportanceMap)
		SummonTactician = getBaseSummonScore(CHIP_TACTICIAN_BULB, EveryStats, MyStats, EntityImportanceMap)
		SummonLightning = getBaseSummonScore(CHIP_LIGHTNING_BULB, EveryStats, MyStats, EntityImportanceMap)

		SummonChipMapScore = [ //Updating map
			CHIP_PUNY_BULB: SummonPuny,
			CHIP_ROCKY_BULB: SummonRocky,
			CHIP_ICED_BULB: SummonIced,
			CHIP_HEALER_BULB: SummonHealer,
			CHIP_FIRE_BULB: SummonFire,
			CHIP_WIZARD_BULB: SummonWizard,
			CHIP_METALLIC_BULB: SummonMetallic,
			CHIP_SAVANT_BULB: SummonSavant,
			CHIP_TACTICIAN_BULB: SummonTactician,
			CHIP_LIGHTNING_BULB: SummonLightning
		]

		SummonNameMapScore = [
			"puny_bulb": SummonPuny,
			"rocky_bulb": SummonRocky,
			"iced_bulb": SummonIced,
			"healer_bulb": SummonHealer,
			"fire_bulb": SummonFire,
			"wizard_bulb": SummonWizard,
			"metallic_bulb": SummonMetallic,
			"savant_bulb": SummonSavant,
			"tactician_bulb": SummonTactician,
			"lightning_bulb": SummonLightning
		]

		RESURRECT_ID = ScoringWichId(ALL_DEAD_ENTITIES, MyStats, EveryStats, EntityImportanceMap)
		RESURRECT_SCORE = RESURRECT_ID in ALL_DEAD_ENTITIES ? getResurrectScore(ALL_DEAD_ENTITIES[RESURRECT_ID], MyStats, EveryStats, EntityImportanceMap) : 0
	}

	static LoadAlliesCoefs(e, stat, EveryStats, EntityScoreInFight, MapRelativeImportance, AllyTeamIndexes, EnemyTeamIndexes, MapAbsoluteImportance) {
		COEF_ABSOLUTE_SHIELD[e] = getAbsoluteShieldCoefForAllies(EveryStats, stat, EntityScoreInFight) 
        COEF_RELATIVE_SHIELD[e] = getRelativeShieldCoefForAllies(EveryStats, stat, EntityScoreInFight) 
        COEF_DAMAGE_RETURN[e] = getDamageReturnCoefForAllies(EveryStats, stat, EntityScoreInFight) 
        COEF_POWER[e] = getPowerCoefForAllies(EveryStats, stat, MapRelativeImportance) 
		COEF_POISON[e] = getPoisonCoefForAllies(EveryStats, stat, MapRelativeImportance, EntityScoreInFight) 
		COEF_POISON_OVER_TIME[e] = getPoisonOverTimeCoefForAllies(EveryStats, stat, MapRelativeImportance, EntityScoreInFight) 
        COEF_LIFE[e] = getLifeCoefForAllies(EveryStats, stat, MapRelativeImportance, EntityScoreInFight) 
        COEF_TOTAL_LIFE[e] = getTotalLifeCoefForAllies(EveryStats, stat, MapRelativeImportance, EntityScoreInFight) 
        COEF_STRENGTH[e] = getStrengthCoefForAllies(EveryStats, stat, MapAbsoluteImportance, AllyTeamIndexes, EnemyTeamIndexes) 
        COEF_WISDOM[e] = getWisdomCoefForAllies(EveryStats, stat, MapAbsoluteImportance, AllyTeamIndexes, EnemyTeamIndexes) 
        COEF_AGILITY[e] = getAgilityCoefForAllies(EveryStats, stat, MapAbsoluteImportance, AllyTeamIndexes, EnemyTeamIndexes) 
        COEF_RESISTANCE[e] = getResistanceCoefForAllies(EveryStats, stat, MapAbsoluteImportance, AllyTeamIndexes, EnemyTeamIndexes) 
        COEF_SCIENCE[e] = getScienceCoefForAllies(EveryStats, stat, MapAbsoluteImportance, AllyTeamIndexes, EnemyTeamIndexes) 
        COEF_MAGIC[e] = getMagicCoefForAllies(EveryStats, stat, MapAbsoluteImportance, AllyTeamIndexes, EnemyTeamIndexes) 
        COEF_TOTAL_TP[e] = getTpCoefForAllies(EveryStats, stat, EntityScoreInFight, MapRelativeImportance) 
        COEF_TOTAL_MP[e] = getMpCoefForAllies(EveryStats, stat, EntityScoreInFight, MapRelativeImportance) 
	}

	static LoadEnemiesCoefs(e, stat, EveryStats, EntityScoreInFight, MapRelativeImportance, AllyTeamIndexes, EnemyTeamIndexes, MapAbsoluteImportance) {
		COEF_ABSOLUTE_SHIELD[e] = getAbsoluteShieldCoefForEnemies(EveryStats, stat, EntityScoreInFight) 
        COEF_RELATIVE_SHIELD[e] = getRelativeShieldCoefForEnemies(EveryStats, stat, EntityScoreInFight) 
        COEF_DAMAGE_RETURN[e] = getDamageReturnCoefForEnemies(EveryStats, stat, EntityScoreInFight) 
        COEF_POWER[e] = getPowerCoefForEnemies(EveryStats, stat, MapRelativeImportance) 
		COEF_POISON[e] = getPoisonCoefForEnemies(EveryStats, stat, MapRelativeImportance, EntityScoreInFight) 
		COEF_POISON_OVER_TIME[e] = getPoisonOverTimeCoefForEnemies(EveryStats, stat, MapRelativeImportance, EntityScoreInFight) 
        COEF_LIFE[e] = getLifeCoefForEnemies(EveryStats, stat, MapRelativeImportance, EntityScoreInFight) 
        COEF_TOTAL_LIFE[e] = getTotalLifeCoefForEnemies(EveryStats, stat, MapRelativeImportance, EntityScoreInFight) 
        COEF_STRENGTH[e] = getStrengthCoefForEnemies(EveryStats, stat, MapAbsoluteImportance, AllyTeamIndexes, EnemyTeamIndexes) 
        COEF_WISDOM[e] = getWisdomCoefForEnemies(EveryStats, stat, MapAbsoluteImportance, AllyTeamIndexes, EnemyTeamIndexes) 
        COEF_AGILITY[e] = getAgilityCoefForEnemies(EveryStats, stat, MapAbsoluteImportance, AllyTeamIndexes, EnemyTeamIndexes) 
        COEF_RESISTANCE[e] = getResistanceCoefForEnemies(EveryStats, stat, MapAbsoluteImportance, AllyTeamIndexes, EnemyTeamIndexes) 
        COEF_SCIENCE[e] = getScienceCoefForEnemies(EveryStats, stat, MapAbsoluteImportance, AllyTeamIndexes, EnemyTeamIndexes) 
        COEF_MAGIC[e] = getMagicCoefForEnemies(EveryStats, stat, MapAbsoluteImportance, AllyTeamIndexes, EnemyTeamIndexes)
        COEF_TOTAL_TP[e] = getTpCoefForEnemies(EveryStats, stat, EntityScoreInFight, MapRelativeImportance) 
        COEF_TOTAL_MP[e] = getMpCoefForEnemies(EveryStats, stat, EntityScoreInFight, MapRelativeImportance) 
	}

	static LoadAlliesSpecialScores(e, stat, EveryStats, EntityScoreInFight, MapRelativeImportance, MapIdEntityIndexes) {
		//Kill Scores
		KILL_SCORE[e] = -getKillScore(EntityScoreInFight, stat, EveryStats, MapRelativeImportance)
		KILL_SCORE_POISON[e] = -getPoisonKillScore(EntityScoreInFight, stat, EveryStats, MapRelativeImportance)
		KILL_SCORE_POISON_LONG[e] = -getPoisonOverTimeKillScore(EntityScoreInFight, stat, EveryStats, MapRelativeImportance)

		//For Gravity Map
		ENTITY_GRAVITY_SCORE_MAP[e] = getAllyGravityScore(EntityScoreInFight, e, MapIdEntityIndexes, MapRelativeImportance[Me])
		LOCKING_ENTITY_SCORE_MAP[e] = -getLockingEntityScore(EntityScoreInFight, stat)
		COVID_SCORE_MAP[e] = getCovidEntityScore(COEF_POISON[e], COEF_POISON_OVER_TIME[e], stat)
		//debug("allies : "+ENTITY_GRAVITY_SCORE_MAP)
	}

	static LoadEnemiesSpecialScores(e, stat, EveryStats, EntityScoreInFight, MapRelativeImportance, MapIdEntityIndexes, GravityMapAggressiveness) {
		//Kill Scores
		KILL_SCORE[e] = getKillScore(EntityScoreInFight, stat, EveryStats, MapRelativeImportance)
		KILL_SCORE_POISON[e] = getPoisonKillScore(EntityScoreInFight, stat, EveryStats, MapRelativeImportance)
		KILL_SCORE_POISON_LONG[e] = getPoisonOverTimeKillScore(EntityScoreInFight, stat, EveryStats, MapRelativeImportance)

		//For Gravity Map
		ENTITY_GRAVITY_SCORE_MAP[e] = getEnemyGravityScore(COEF_LIFE[e], COEF_POISON_OVER_TIME[e], MapIdEntityIndexes, GravityMapAggressiveness)
		LOCKING_ENTITY_SCORE_MAP[e] = getLockingEntityScore(EntityScoreInFight, stat)
		COVID_SCORE_MAP[e] = getCovidEntityScore(COEF_POISON[e], COEF_POISON_OVER_TIME[e], stat)
		//debug("enemies : "+ENTITY_GRAVITY_SCORE_MAP)
	}

	static getMapRelativeImportance(MapAbsoluteImportance, EveryStats) {
		var _final = [: ]
		//Loading the total Importance of allies : 
		var AlliesTotal = 1
		var EnemiesTotal = 1
		for (var Id:var Importance in MapAbsoluteImportance) {
			if (EveryStats[Id].ALLY) {
				AlliesTotal += Importance
			} else {
				EnemiesTotal += Importance
			}
		}
		for (var Id:var Importance in MapAbsoluteImportance) {
			if (EveryStats[Id].ALLY) {
				_final[Id] = Importance / AlliesTotal
			} else {
				_final[Id] = Importance / EnemiesTotal
			}
		}
		return _final
	}

	static LoadGravityAgressiveness(MapAbsoluteImportance, EveryStats) {
		var _final = [: ]
		//Loading the total Importance of allies : 
		var AlliesTotal = 0
		var EnemiesTotal = 0
		for (var Id:var Importance in MapAbsoluteImportance) {
			if (EveryStats[Id].ALLY) {
				AlliesTotal += Importance
			} else {
				EnemiesTotal += Importance
			}
		}
		return (AlliesTotal / EnemiesTotal) * 0.00128
	}

	static getBaseSummonScore(Chip, EveryStats, SummonerStats, EntityImportanceMap) {
		var EntityStats = new BulbStats(MAX_ID+1, SUMMONER_LEVEL_TIMES, Chip, SummonerStats.CELL, Me, SummonerStats) //I put Summoner cell to summon bulb cuz its not important for its score
		var SummonScore = 0.06 * getSummonScoreForInventory(SummonerStats, EntityStats.INVENTORY, EntityStats, EveryStats, EntityImportanceMap)
		return getEntitySummonScore(EntityStats, EveryStats, EntityImportanceMap) * SummonScore
	}

	static getSummonScoreForInventory(SummonerStats, BulbInventory, EntityStats, EveryStats, EntityImportanceMap) {
		var ThisRelativeItems = SummonItems.LoadRelativeSummonItems(BulbInventory, EntityStats.NAME)
		return (getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) * ThisRelativeItems.MEAN) + (getPlacementImportanceToEntityAllies(EntityStats, EveryStats, EntityImportanceMap) * ThisRelativeItems.GENTLE)
	}

	static getEntitySummonScore(EntityStats, EveryStats, EntityImportanceMap) {
		var EIndexes = EntityIndexes.getEntityIndexes(EntityStats)
		var AllyIndexes = new TeamIndexes(EveryStats, true)
		var EnemyIndexes = new TeamIndexes(EveryStats, false)
		var AbsoluteImportance = EntityIndexes.getEntityImportanceIndex(AllyIndexes, EnemyIndexes, EIndexes, EntityStats)
		return getRelativeDifferenceInImportance(EntityImportanceMap, 0, AbsoluteImportance)
	}

	static getRelativeDifferenceInImportance(AbsoluteImportanceBaseMap, OldAbsoluteEntityImportance, NewAbsoluteEntityImportance) {
		var BaseTotalScore = 0
		for (var Tmp:var Imp in AbsoluteImportanceBaseMap) {
			BaseTotalScore += Imp
		}
		//debug("New absolute entity importance : "+ NewAbsoluteEntityImportance+"Old Absolute Entity Importance : "+OldAbsoluteEntityImportance+" base total score : "+BaseTotalScore)
		return (NewAbsoluteEntityImportance - OldAbsoluteEntityImportance) / BaseTotalScore
	}
	
	static getKillScore(EntityImportance, EntityStats, EveryStats, EntityImportanceMap) {
		var _final = 10000 * EntityImportance

		_final *= getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) //The More he is close to my enemies the more i want to damage him (to protect my entities from his damages)

		return _final
	}

	static getPoisonKillScore(EntityImportance, EntityStats, EveryStats, EntityImportanceMap) {
		var TimesKill = canBeAntidoteBeforeDying(EntityStats, EveryStats) ? 700 : 7000
		var _final = TimesKill * EntityImportance

		_final *= getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) //The More he is close to my enemies the more i want to damage him (to protect my entities from his damages)

		return _final
	}

	static getPoisonOverTimeKillScore(EntityImportance, EntityStats, EveryStats, EntityImportanceMap) {
		var KillScore = 500 * getAverageAntidoteCooldown(EntityStats, EveryStats)
		var _final = KillScore * EntityImportance

		_final *= getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) //The More he is close to my enemies the more i want to damage him (to protect my entities from his damages)

		return _final
	}

	static getAllyGravityScore(TargetImportanceScore, EntityId, MapIdEntityIndexes, MyImportanceScore) {
		var TargetIndexes = MapIdEntityIndexes[EntityId]
		var MyIndexes = MapIdEntityIndexes[Me]
		return (TargetImportanceScore * (MyIndexes.WISDOM_INDEX + MyIndexes.AGILITY_INDEX + MyIndexes.RESISTANCE_INDEX + MyIndexes.SCIENCE_INDEX) + MyImportanceScore * (TargetIndexes.WISDOM_INDEX + TargetIndexes.AGILITY_INDEX + TargetIndexes.RESISTANCE_INDEX + TargetIndexes.SCIENCE_INDEX)) / 160
	}

	static getEnemyGravityScore(CoefLifeOfTarget, CoefPoisonOfTarget, MapIdEntityIndexes, GravityMapAggressiveness) {
		var MyIndexes = MapIdEntityIndexes[Me]
		return (((-CoefLifeOfTarget) * MyIndexes.STRENGTH_INDEX) + (CoefPoisonOfTarget * MyIndexes.MAGIC_INDEX)) * GravityMapAggressiveness
	}

	static getLockingEntityScore(TargetImportanceScore, EntityStats) {
		return TargetImportanceScore * 1000
	}

	static getCovidEntityScore(Coef_Psn, Coef_Psn_Ovr_Tme, EntityStats) {
		return CHIP_COVID in EntityStats.EFFECTS_ITEM_MAP ? 0 : (Coef_Psn + (Coef_Psn_Ovr_Tme * min(7, EntityStats.COOLDOWNS[CHIP_ANTIDOTE]))) * 50
	}

	/* Entity Can be Antidote before dying : 
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param TargetStats Class Stats of Target
    *
    * @return Bool 
    */

	static canBeAntidoteBeforeDying(TargetStats, EveryStats) {
		var IsTargetAlly = TargetStats.ALLY
		var TargetCell = TargetStats.CELL
		var TargetID = TargetStats.ID
		var JumpMaxRange = ITEMINFO[CHIP_JUMP].MAXRANGE
		for (var Caster in AllStats.getSortedEntityByTurnOrder(EveryStats)) {
			if (Caster == TargetID) return false
			var CasterStats = EveryStats[Caster]
			if (FinalCell.areEntityAllies(IsTargetAlly, CasterStats.ALLY)) {
				var CasterCooldowns = CasterStats.COOLDOWNS
				if (CHIP_ANTIDOTE in CasterCooldowns && CasterCooldowns[CHIP_ANTIDOTE] == 0 && CellInfo.getDist(CasterStats.CELL, TargetCell) <= (CasterStats.MP + JumpMaxRange)) {
					return true
				}
			}
		}
	}

	/* Loads the average Antidote Cooldown of a team (max cooldown if entity doesn't have the chip)
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param TargetStats Class Stats of Target
    *
    * @return Int : Antidote Cooldown
    */

	static getAverageAntidoteCooldown(TargetStats, EveryStats) {
		var _final = 0
		var IsTargetAlly = TargetStats.ALLY
		var BaseAntidoteCooldown = ITEMINFO[CHIP_ANTIDOTE].COOLDOWN
		for (var Caster:var CasterStats in EveryStats) {
			if (CasterStats.SUMMON) continue
			if (FinalCell.areEntityAllies(IsTargetAlly, CasterStats.ALLY)) {
				var CasterCooldowns = CasterStats.COOLDOWNS
				if (CHIP_ANTIDOTE in CasterCooldowns) {
					_final += CasterCooldowns[CHIP_ANTIDOTE]
				} else {
					_final += BaseAntidoteCooldown
				}
			}
		}
		return (_final / mapSize(EveryStats))
	}

	/* Loads the Danger for an entity : It takes every of his enemies and load danger from it then multiply this danger to add 0 to 50% of damages depending on dist
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param TargetStats Class Stats of Target
    *
    * @return Int : Damages ally may take
    */

	static getDangerWeightedByDist(TargetStats, EveryStats) {
		var Hash = CellDanger.getStatsHashForDanger(TargetStats, TargetStats.ID)
		if (Hash in DANGER_WEIGHTED_BY_DIST_CACHE) return DANGER_WEIGHTED_BY_DIST_CACHE[Hash]
		var _final = 0
		var IsTargetAlly = TargetStats.ALLY
		var TargetCell = TargetStats.CELL
		for (var Caster:var CasterStats in EveryStats) {
			if (!FinalCell.areEntityAllies(IsTargetAlly, CasterStats.ALLY)) {
				var EntityItemAoeMap = [: ]
				for (var i in EntityDangerMap.getItemsList(CasterStats)) {
					EntityItemAoeMap[i] = 0
				}
				var RealDanger = CellDanger.getBFSComboFromItemAoe(EntityItemAoeMap, CasterStats, TargetStats, CasterStats.TP, clone(CasterStats.USES))
				var DistEntities = 35 - CellInfo.getDist(CasterStats.CELL, TargetCell)
				_final += RealDanger * (1 + (DistEntities/70))
			}
		}
		DANGER_WEIGHTED_BY_DIST_CACHE[Hash] = _final
		return _final
	}

	/* Loads the Damage Output for an entity : It takes every of his enemies and load danger from it then multiply this danger to add 0 to 50% of damages depending on dist. Finally this scores is timed by the entity importance
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param TargetStats Class Stats of Target
	* @param EntityImportanceMap Map <Id : Int> Importance of Target
    *
    * @return Int : Damages entity can output
    */

	static getDamageOutputWeightedByDistAndImportance(CasterStats, EveryStats, EntityImportanceMap) {
		var _final = 0
		var IsCasterAlly = CasterStats.ALLY
		var CasterCell = CasterStats.CELL
		for (var TmpTarget:var TargetStats in EveryStats) {
			if (!FinalCell.areEntityAllies(IsCasterAlly, TargetStats.ALLY)) {
				var EntityItemAoeMap = [: ]
				for (var i in EntityDangerMap.getItemsList(CasterStats)) {
					EntityItemAoeMap[i] = 0
				}
				var RealDanger = CellDanger.getBFSComboFromItemAoe(EntityItemAoeMap, CasterStats, TargetStats, CasterStats.TP, clone(CasterStats.USES))
				var DistEntities = 35 - CellInfo.getDist(TargetStats.CELL, CasterCell)
				_final += RealDanger * (1 + (DistEntities/70)) * EntityImportanceMap[TmpTarget]
			}
		}
		return _final
	}

	/* Loads the placement importance of an entity (it just seek the dist it is to important enemies of his)
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity 
	* @param EntityImportanceMap Map <Id : Int> Importance of Target
    *
    * @return Int : Placement Score
    */
	
	static getPlacementImportanceToEntityEnemies(EntityStats, EveryStats, EntityImportanceMap) { //TODO : Cache With EntityCell and ID And Name
		var _final = 0
		var IsEntityAlly = EntityStats.ALLY
		var EntityCell = EntityStats.CELL
		for (var EnemyEntity:var EnemyStats in EveryStats) {
			if (!FinalCell.areEntityAllies(IsEntityAlly, EnemyStats.ALLY)) {
				var DistEntities = (35 - CellInfo.getDist(EnemyStats.CELL, EntityCell)) * EntityImportanceMap[EnemyEntity]
				_final += DistEntities
			}
		}
		_final = 0.8 + (_final / 87.5)
		return _final
	}
	
	/* Loads the placement importance of an entity (it just seek the dist it is to important allies of his)
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity 
	* @param EntityImportanceMap Map <Id : Int> Importance of Target
    *
    * @return Int : Placement Score
    */
	
	static getPlacementImportanceToEntityAllies(EntityStats, EveryStats, EntityImportanceMap) { //TODO : Cache With EntityCell and ID
		var _final = 0
		var IsEntityAlly = EntityStats.ALLY
		var EntityCell = EntityStats.CELL
		for (var AllyEntity:var AllyStats in EveryStats) {
			if (FinalCell.areEntityAllies(IsEntityAlly, AllyStats.ALLY)) {
				var DistEntities = (35 - CellInfo.getDist(AllyStats.CELL, EntityCell)) * EntityImportanceMap[AllyEntity]
				_final += DistEntities
			}
		}
		_final = 0.8 + (_final / 87.5)
		return _final
	}
	
	/* Loads the absolute shield Coef of an ally, roughly derivates the number of damages ally will take depending on its absolute shield (with a distance weight)
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
	* @param EntityScoreInFight The score of importance in fight of the entity
    *
    * @return Int : Coef Absolute Shield of Entity
    */

	static getAbsoluteShieldCoefForAllies(EveryStats, EntityStats, EntityScoreInFight) {
		//First i look at the entity Importance cuz coef will scale on it
		var _final = EntityScoreInFight

		//I Load Entity Danger Weighted By dist for its actual Absolute Shield and + 10 absolute Shield
		var ClonedStats = clone(EntityStats, 2)
		var BaseDanger = getDangerWeightedByDist(ClonedStats, EveryStats)
		ClonedStats.ABSOLUTE_SHIELD += 10
		var NewDanger = getDangerWeightedByDist(ClonedStats, EveryStats)
		//I add the difference to _final
		_final *= BaseDanger - NewDanger

		//Then Every 200 Damages Return, the coef divides by 2 to avoid going full shield and Damages Return at the same time
		_final /= (1 + (EntityStats.DAMAGE_RETURN/200))

		//Then I return the coef
		return _final * AbsoluteShieldAlliesImportance
	}

	/* Loads the absolute shield Coef of an enemy, roughly derivates the number of damages ally will take depending on its absolute shield (with a distance weight)
    *
	* @param EveryStats Map <Id : Class Stats>
	* @param EntityStats Class Stats of Entity that i want to load coef for
	* @param EntityScoreInFight The score of importance in fight of the entity
    *
    * @return Int : Coef Absolute Shield of Entity
    */

	static getAbsoluteShieldCoefForEnemies(EveryStats, EntityStats, EntityScoreInFight) {
		//First i look at the entity Importance cuz coef will scale on it
		var _final = EntityScoreInFight

		//I Load Entity Danger Weighted By dist for its actual Absolute Shield and - 10 absolute Shield
		var ClonedStats = clone(EntityStats, 2)
		var BaseDanger = getDangerWeightedByDist(ClonedStats, EveryStats)
		ClonedStats.ABSOLUTE_SHIELD -= 10
		var NewDanger = getDangerWeightedByDist(ClonedStats, EveryStats)
		//I add the difference to _final
		_final *= BaseDanger - NewDanger
		
		//Then Every 200 Damages Return, the coef divides by 2 to avoid putting vulné on a leek that i can't hit later because of its damage return
		_final /= (1 + (EntityStats.DAMAGE_RETURN/200))

		//Then I return the coef
		return _final * AbsoluteShieldEnemiesImportance
	}

