	static CooldownScore(item) {
		if (item in ITEMINFO) return (ITEMINFO[item].COOLDOWN ** 0.7) * 1
		return 0
	}*/

	static getDangerScore(Danger, GScore, MyStats) {//TODO : Add Gravity Score into IT
		var BaseScoreWithoutKills = max(0, (Danger * COEF_LIFE[MyStats.ID] - GScore))
		if (MyStats.LIFE <= Danger) { //DEATH Situation
			return DEATH_SCORE + BaseScoreWithoutKills
		} else if ((MyStats.LIFE - MyStats.POISON) <= Danger) { //POISON DEATH Situation
			return DEATH_SCORE_POISON + BaseScoreWithoutKills
		} else if ((MyStats.LIFE - MyStats.POISON_OVER_TIME) <= Danger) {//POISON OVER TIME DEATH Situation
			return DEATH_SCORE_POISON_OVER_TIME + BaseScoreWithoutKills
		}
		return BaseScoreWithoutKills
	}

	static AbsoluteShieldFunction(AddedShield, TargetID) {
		return AddedShield * COEF_ABSOLUTE_SHIELD[TargetID]
	}

	static RelativeShieldFunction(NewValue, OldValue, TargetID) {
		var AddedShield = (min(MAX_RELATIVE_SHIELD_SCORED, NewValue) - OldValue)//To Cap at 100 Relative Shield
		return AddedShield * COEF_RELATIVE_SHIELD[TargetID]
	}

	static DamageReturnFunction(AddedValue, TargetID) {
		return AddedValue * COEF_DAMAGE_RETURN[TargetID]
	}

	static PowerFunction(AddedValue, TargetID) {
		return AddedValue * COEF_POWER[TargetID]
	}

	static PoisonFunction(NewValue, OldValue, TargetStats) {
		//if (NewValue > TargetStats.LIFE) return KILL_SCORE_POISON[TargetStats.ID]
		var AddedPoison = (min(NewValue, TargetStats.LIFE) - OldValue)
		/*if (NewValue >= TargetStats.LIFE && OldValue < TargetStats.LIFE) _final += KILL_SCORE_POISON
		if (TargetStats.POISON_OVER_TIME >= TargetStats.LIFE) _final += KILL_SCORE_POISON_LONG
		if (NewValue <= TargetStats.LIFE && OldValue > TargetStats.LIFE) _final -= KILL_SCORE_POISON //Save*/
		//if (NewValue > TargetStats.LIFE) _final += KILL_SCORE_POISON_LONG //Didn't save all
		return AddedPoison * COEF_POISON[TargetStats.ID]
	}

	static PoisonOverTimeFunction(NewValue, OldValue, TargetStats) {
		//if (LifePercentage <= 0) return 0
		var AddedPoison = (NewValue - OldValue)
		/*
		if (NewValue >= TargetStats.LIFE && OldValue < TargetStats.LIFE) _final += KILL_SCORE_POISON_LONG
		if (NewValue <= TargetStats.LIFE && OldValue > TargetStats.LIFE) _final -= KILL_SCORE_POISON_LONG //Save Score*/
		return NewValue > TargetStats.LIFE ? AddedPoison * COEF_POISON_OVER_TIME[TargetStats.ID] + KILL_SCORE_POISON_LONG[TargetStats.ID] : AddedPoison * COEF_POISON_OVER_TIME[TargetStats.ID]
	}

	static LifeFunction(NewValue, OldValue, TargetStats) {
		//if (NewValue <= 0) return KILL_SCORE[TargetStats.ID]
		//if (LifePercentage <= 0) return 0
		var AddedLife = (NewValue - OldValue)
		/*if (NewValue <= 0 && OldValue > 0) _final -= KILL_SCORE
		if (TargetStats.POISON >= NewValue && TargetStats.POISON < OldValue) _final -= KILL_SCORE_POISON
		if (TargetStats.POISON_OVER_TIME >= NewValue && TargetStats.POISON_OVER_TIME < OldValue) _final -= KILL_SCORE_POISON_LONG*/
		//if (TargetStats.POISON >= OldValue || NewValue <= 0) _final += KILL_SCORE_POISON
		//if (TargetStats.POISON_OVER_TIME >= OldValue || NewValue <= 0) _final += KILL_SCORE_POISON_LONG
		return AddedLife * COEF_LIFE[TargetStats.ID]
	}

	static TotalLifeFunction(AddedValue, TargetID) {
		return AddedValue * COEF_TOTAL_LIFE[TargetID]
	}

	static StrengthFunction(AddedValue, TargetID) {
		return AddedValue * COEF_STRENGTH[TargetID]
	}

	static WisdomFunction(AddedValue, TargetID) {
		return AddedValue * COEF_WISDOM[TargetID]
	}

	static AgilityFunction(AddedValue, TargetID) {
		return AddedValue * COEF_AGILITY[TargetID]
	}

	static ResistanceFunction(AddedValue, TargetID) {
		return AddedValue * COEF_RESISTANCE[TargetID]
	}

	static ScienceFunction(AddedValue, TargetID) {
		return AddedValue * COEF_SCIENCE[TargetID]
	}

	static MagicFunction(AddedValue, TargetID) {
		return AddedValue * COEF_MAGIC[TargetID]
	}

	static TotalTpFunction(AddedValue, TargetID) {
		return AddedValue * COEF_TOTAL_TP[TargetID]
	}

	static TotalMpFunction(AddedValue, TargetID) {
		return AddedValue * COEF_TOTAL_MP[TargetID]
	}
}