/**
 * This method will help me give stats buff to entities and to know if i should shield, which bulb to summon etc
 **/

include("../includes.leek")

class EntityIndexes {
    STRENGTH_INDEX
    WISDOM_INDEX
    AGILITY_INDEX
    RESISTANCE_INDEX
    SCIENCE_INDEX
    MAGIC_INDEX
	constructor(EntityStats) {
        //Let's give them values : 

        //First Strength Index : 
        this.STRENGTH_INDEX = StrengthIndexCalculation(EntityStats)

        //Then Wisdom Index : 
        this.WISDOM_INDEX = WisdomIndexCalculation(EntityStats)

        //Then Agility Index : Change It For All Time Tp Cuz it can boost everything ?
        this.AGILITY_INDEX = AgilityIndexCalculation(EntityStats)

        //Then Resistance Index : 
        this.RESISTANCE_INDEX = ResistanceIndexCalculation(EntityStats)

        //Then Science Index : 
        this.SCIENCE_INDEX = ScienceIndexCalculation(EntityStats)

        //Then Magic Index : 
        this.MAGIC_INDEX = MagicIndexCalculation(EntityStats)

        //Index calculation is : Stat * How Much Tp He Can Use With This stat (For exemple if he has 20 PT, 400 resistance and can use only dome, his index will be max(9, 20) * 1+(stat/100) = 45)
    }

    static getEntityIndexes(EntityStats) {
        return new EntityIndexes(EntityStats)
    }

    getCapitalFromStat(stat) {
        if (stat <= 0) return 0
        var capital = 0

        if (stat > 600) {
            capital += (stat - 600) * 3
            stat = 600
        }

        if (stat > 400) {
            capital += (stat - 400) * 2
            stat = 400
        }

        if (stat > 200) {
            capital += (stat - 200) // *1, no need to write
            stat = 200
        }

        // Part 0 → 200 : 2 stat points stat per capital
        capital += stat / 2

        return capital
    }

    getMaxTPUsableForStat(entityStats, statTypeString) {
        var Hash = entityStats.NAME + statTypeString + entityStats.ID
        if (Hash in MAX_TP_USABLE_FOR_STAT_CACHE) return MAX_TP_USABLE_FOR_STAT_CACHE[Hash]
        var tpUsable = 0

        for (var itemId:var cd in entityStats.COOLDOWNS) {
            if (cd > 0) continue
            var Infos = ITEMINFO[itemId]
            var isUseful = isEffectUsefulForStat(Infos.EFFECTS, statTypeString)
            
            if (!isUseful) continue

            var Cost = Infos.COST
            if (Infos.COOLDOWN == 0) {
                Cost *= Infos.MAX_USES
            }

            tpUsable += Cost
        }
        MAX_TP_USABLE_FOR_STAT_CACHE[Hash] = tpUsable
        return tpUsable
    }

    isEffectUsefulForStat(ItemEffects, statTypeString) {
        for (var eff in ItemEffects) {
            if (statTypeString in MapFctUsefull && MapFctUsefull[statTypeString](eff[0])) return true
        }
        return false
    }

    static MapFctUsefull = [
        "STRENGTH": function(effectType) {
            return effectType == EFFECT_DAMAGE
        },
        "WISDOM": function(effectType) {
            return effectType == EFFECT_HEAL || effectType == EFFECT_BOOST_MAX_LIFE
        },
        "AGILITY": function(effectType) {
            return effectType == EFFECT_DAMAGE_RETURN
        },
        "RESISTANCE": function(effectType) {
            return effectType == EFFECT_ABSOLUTE_SHIELD || effectType == EFFECT_RELATIVE_SHIELD
        },
        "SCIENCE": function(effectType) {
            return effectType == EFFECT_BUFF_AGILITY ||
                effectType == EFFECT_BUFF_MP ||
                effectType == EFFECT_BUFF_RESISTANCE ||
                effectType == EFFECT_BUFF_STRENGTH ||
                effectType == EFFECT_BUFF_TP ||
                effectType == EFFECT_BUFF_WISDOM ||
                effectType == EFFECT_NOVA_DAMAGE ||
                effectType == EFFECT_NOVA_VITALITY
        },
        "MAGIC": function(effectType) {
            return effectType == EFFECT_POISON ||
                effectType == EFFECT_SHACKLE_AGILITY ||
                effectType == EFFECT_SHACKLE_MAGIC ||
                effectType == EFFECT_SHACKLE_MP ||
                effectType == EFFECT_SHACKLE_TP ||
                effectType == EFFECT_SHACKLE_WISDOM
        }
    ]

    StrengthIndexCalculation(EntityStats) {
        var capital = getCapitalFromStat(EntityStats.STRENGTH)
        var usableTP = min(EntityStats.TOTAL_TP, getMaxTPUsableForStat(EntityStats, "STRENGTH"))
        var powerFactor = 1 + (EntityStats.POWER / 100)
        var result = capital * usableTP * powerFactor
        return result
    }

    WisdomIndexCalculation(EntityStats) {
        var capital = getCapitalFromStat(EntityStats.WISDOM)
        var usableTP = min(EntityStats.TOTAL_TP, getMaxTPUsableForStat(EntityStats, "WISDOM"))
        var result = capital * usableTP
        return result
    }


    AgilityIndexCalculation(EntityStats) {
        var capital = getCapitalFromStat(EntityStats.AGILITY)
        var usableTP = min(EntityStats.TOTAL_TP, getMaxTPUsableForStat(EntityStats, "AGILITY"))
        var result = capital * usableTP // tu peux ajouter un facteur crit ou autre ici si besoin
        return result
    }


    ResistanceIndexCalculation(EntityStats) {
        var capital = getCapitalFromStat(EntityStats.RESISTANCE)
        var usableTP = min(EntityStats.TOTAL_TP, getMaxTPUsableForStat(EntityStats, "RESISTANCE"))
        var result = capital * usableTP
        return result
    }

    ScienceIndexCalculation(EntityStats) {
        var capital = getCapitalFromStat(EntityStats.SCIENCE)
        var usableTP = min(EntityStats.TOTAL_TP, getMaxTPUsableForStat(EntityStats, "SCIENCE"))
        var result = capital * usableTP
        return result
    }

    MagicIndexCalculation(EntityStats) {
        var capital = getCapitalFromStat(EntityStats.MAGIC)
        var usableTP = min(EntityStats.TOTAL_TP, getMaxTPUsableForStat(EntityStats, "MAGIC"))
        var powerFactor = 1 + (EntityStats.POWER / 150) ///150 cuz it only boosts poisons and not shackles
        var result = capital * usableTP * powerFactor
        return result
    }

    static getEntityImportanceIndex(AllyTeamIndexes, EnemyTeamIndexes, EIndexes, EntityStats) {
        //Coefs to Setup Importance 
        var StrengthCoef = 1 / (1 + EnemyTeamIndexes.RESISTANCE_INDEX / 10000) //The More Resistance There is, the less i want to play strength against it, maybe more some wizard bulb instead of a lightning bulb
        var WisdomCoef = 1
        var AgilityCoef = EnemyTeamIndexes.STRENGTH_INDEX / 4000
        var ResistanceCoef = EnemyTeamIndexes.STRENGTH_INDEX / 4000
        var ScienceCoef = 1
        var MagicCoef = 1
        var _final = EIndexes.STRENGTH_INDEX * StrengthCoef + EIndexes.WISDOM_INDEX * WisdomCoef + EIndexes.AGILITY_INDEX * AgilityCoef + EIndexes.RESISTANCE_INDEX * ResistanceCoef + EIndexes.SCIENCE_INDEX * ScienceCoef + EIndexes.MAGIC_INDEX * MagicCoef
        _final *= 1 + (EntityStats.LIFE / 5000)
        _final *= 1 + (EntityStats.TOTAL_MP / 30)
        _final *= 1 + (EntityStats.AGILITY * 0.0014) //Adding Crit Chance
        if (EntityStats.STATIC) _final /= 100
        return _final
    }
}