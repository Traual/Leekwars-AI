include("../includes.leek")

/*
 *  This is a Fitness Function For an Action, is much less opés consumming than fitness of a branch
 */

class ActionFitness {

	static Score(Act, EveryStats, HashEntityCell) { //This Will rate a score of an action 
		Benchmark.FitnessActionStart()
		var Item = Act.ITEM
		var From = Act.FROM
		var To = Act.TO
		var Infos = ITEMINFO[Item]
		var MyStats = EveryStats[Me]
		var BaseTargets = Consequences.ConsequenceTargets(Item, From, To, EveryStats, Me, HashEntityCell)
		var _final = Item in COOLDOWN_SCORES_MAP ? -COOLDOWN_SCORES_MAP[Item] : 0
		for (var eff in Infos.EFFECTS) {
			var TmpTargets = Consequences.RealConsequenceTargets(BaseTargets, eff, EveryStats, MyStats, Me)
			var Multiplier = (eff[5] & EFFECT_MODIFIER_MULTIPLIED_BY_TARGETS) ? mapSize(TmpTargets) : 1 //Saving Multiplier
			var RealTargets = eff[5] & EFFECT_MODIFIER_ON_CASTER ? [Me: 0] : TmpTargets
			_final += EffectsMap[eff[0]](EveryStats, From, To, eff, Me, Multiplier, Item, RealTargets, MyStats)
		}
		Benchmark.FitnessActionStop()
		return _final
	}

	static EffectsMap = [
		EFFECT_ABSOLUTE_SHIELD: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier * (1 + (CastStats.RESISTANCE * 0.01))
			if (Effect[5] & EFFECT_MODIFIER_STACKABLE) {//Effect is stackable
				for (var tar: var dist in RealTargets) { 
					_final += Fitness.AbsoluteShieldFunction(ValueAdded * Consequences.DistToAoeNumber(dist), tar)
				}
			} else {
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var Tmp = 0
					if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
						for (var eff in TargetStats.EFFECTS) {
							if (eff[5] == Item) {
								Tmp -= eff[1]
								break
							}
						}
					}
					Tmp += (ValueAdded * Consequences.DistToAoeNumber(dist))
					_final += Fitness.AbsoluteShieldFunction(Tmp, tar)
				}
			}
			return _final
		},
		EFFECT_ABSOLUTE_VULNERABILITY: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier
			if (Effect[5] & EFFECT_MODIFIER_STACKABLE) {//Effect is stackable
				for (var tar: var dist in RealTargets) {
					_final += Fitness.AbsoluteShieldFunction(-ValueAdded * Consequences.DistToAoeNumber(dist), tar)
				}
			} else {
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var Tmp = 0
					if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
						for (var eff in TargetStats.EFFECTS) {
							if (eff[5] == Item) {
								Tmp += eff[1]
								break
							}
						}
					}
					Tmp -= (ValueAdded * Consequences.DistToAoeNumber(dist))
					_final += Fitness.AbsoluteShieldFunction(Tmp, tar)
				}
			}
			return _final
		},
		EFFECT_AFTEREFFECT: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier * (1 + (CastStats.SCIENCE * 0.01))
			var DurationOfEffect = Effect[3]
			if (Effect[5] & EFFECT_MODIFIER_STACKABLE) {//Effect is stackable
				for (var tar: var dist in RealTargets) { 
					var TargetStats = ActualStats[tar]
					var EffectWithDist = ValueAdded * Consequences.DistToAoeNumber(dist)
					var OldValue = TargetStats.POISON
					var NewValue = OldValue + (EffectWithDist)
					var OldValueOverTime = TargetStats.POISON_OVER_TIME
					var NewValueOverTime = OldValueOverTime + (EffectWithDist * DurationOfEffect)
					var OldValueLife = TargetStats.LIFE
					var NewValueLife = OldValueLife - (EffectWithDist)
					_final += Fitness.PoisonFunction(NewValue, OldValue, TargetStats)
					_final += Fitness.PoisonOverTimeFunction(NewValueOverTime, OldValueOverTime, TargetStats)
					_final += Fitness.LifeFunction(NewValueLife, OldValueLife, TargetStats)
					_final += Fitness.TotalLifeFunction(EffectWithDist * EROSION_NO_POISON, tar)
				}
			} else {
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var EffectWithDist = ValueAdded * Consequences.DistToAoeNumber(dist)
					var OldValue = TargetStats.POISON
					var OldValueOverTime = TargetStats.POISON_OVER_TIME
					var OldValueLife = TargetStats.LIFE
					if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
						for (var eff in TargetStats.EFFECTS) {
							if (eff[5] == Item) { //No need to modify Life and Total life cuz it won't remove damages, it's already been applied
								var ValueOfEffect = eff[1]
								OldValue -= ValueOfEffect
								OldValueOverTime -= ValueOfEffect * eff[3]
							}
						}
					}
					var NewValue = OldValue + (EffectWithDist)
					var NewValueOverTime = OldValueOverTime + (EffectWithDist * DurationOfEffect)
					var NewValueLife = OldValueLife - (EffectWithDist)
					_final += Fitness.PoisonFunction(NewValue, OldValue, TargetStats)
					_final += Fitness.PoisonOverTimeFunction(NewValueOverTime, OldValueOverTime, TargetStats)
					_final += Fitness.LifeFunction(NewValueLife, OldValueLife, TargetStats)
					_final += Fitness.TotalLifeFunction(EffectWithDist * EROSION_NO_POISON, tar)
				}
			}
			return _final
		},
		EFFECT_ANTIDOTE: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			for (var tar: var dist in RealTargets) { //No need to check wether effect is stackable etc 
				var TargetStats = ActualStats[tar]
				var OldValue = TargetStats.POISON
				var NewValue = OldValue - TargetStats.JUST_POISON
				var OldValueOverTime = TargetStats.POISON_OVER_TIME
				var NewValueOverTime = OldValueOverTime - TargetStats.JUST_POISON_OVER_TIME
				_final += Fitness.PoisonFunction(NewValue, OldValue, TargetStats)
				_final += Fitness.PoisonOverTimeFunction(NewValueOverTime, OldValueOverTime, TargetStats)
			}
			return _final
		},
		EFFECT_ATTRACT: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			return 0 //TODO : Change after GravityMap is done
		},
		EFFECT_BOOST_MAX_LIFE: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier * (1 + (CastStats.WISDOM * 0.01))
			for (var tar: var dist in RealTargets) { 
				var TargetStats = ActualStats[tar]
				var Added = ValueAdded * Consequences.DistToAoeNumber(dist)
				var OldValueLife = TargetStats.LIFE
				var NewValueLife = OldValueLife + Added
				_final += Fitness.TotalLifeFunction(Added, tar)
				_final += Fitness.LifeFunction(NewValueLife, OldValueLife, TargetStats)
			}
			return _final
		},
		EFFECT_BUFF_AGILITY: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier * (1 + (CastStats.SCIENCE * 0.01))
			if (Effect[5] & EFFECT_MODIFIER_STACKABLE) {//Effect is stackable
				for (var tar: var dist in RealTargets) {
					_final += Fitness.AgilityFunction(ValueAdded * Consequences.DistToAoeNumber(dist), tar)
				}
			} else {
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var Tmp = 0
					if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
						for (var eff in TargetStats.EFFECTS) {
							if (eff[5] == Item) {
								Tmp -= eff[1]
								break
							}
						}
					}
					Tmp += (ValueAdded * Consequences.DistToAoeNumber(dist))
					_final += Fitness.AgilityFunction(Tmp, tar)
				}
			}
			return _final
		},
		EFFECT_BUFF_MP: function(ActualStats, From, To, Effect, Caster,Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier * (1 + (CastStats.SCIENCE * 0.01))
			if (Effect[5] & EFFECT_MODIFIER_STACKABLE) {//Effect is stackable
				for (var tar: var dist in RealTargets) {
					_final += Fitness.TotalMpFunction(ValueAdded * Consequences.DistToAoeNumber(dist), tar)
				}
			} else {
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var Tmp = 0
					if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
						for (var eff in TargetStats.EFFECTS) {
							if (eff[5] == Item) {
								Tmp -= eff[1]
								break
							}
						}
					}
					Tmp += (ValueAdded * Consequences.DistToAoeNumber(dist))
					_final += Fitness.TotalMpFunction(Tmp, tar)
				}
			}
			return _final
		},
		EFFECT_BUFF_RESISTANCE: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier * (1 + (CastStats.SCIENCE * 0.01))
