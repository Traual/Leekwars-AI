				}
			} else {
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var Tmp = 0
					if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
						for (var eff in TargetStats.EFFECTS) {
							if (eff[5] == Item) {
								Tmp += eff[1]
								break
							}
						}
					}
					Tmp -= (ValueAdded * Consequences.DistToAoeNumber(dist))
					_final += Fitness.TotalMpFunction(Tmp, tar)
				}
			}
			return _final
		},
		EFFECT_SHACKLE_STRENGTH: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier * (1 + (CastStats.MAGIC * 0.01))
			if (Effect[5] & EFFECT_MODIFIER_STACKABLE) {//Effect is stackable
				for (var tar: var dist in RealTargets) {
					_final += Fitness.StrengthFunction(-ValueAdded * Consequences.DistToAoeNumber(dist), tar)
				}
			} else {
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var Tmp = 0
					if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
						for (var eff in TargetStats.EFFECTS) {
							if (eff[5] == Item) {
								Tmp += eff[1]
								break
							}
						}
					}
					Tmp -= (ValueAdded * Consequences.DistToAoeNumber(dist))
					_final += Fitness.StrengthFunction(Tmp, tar)
				}
			}
			return _final
		},
		EFFECT_SHACKLE_TP: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier * (1 + (CastStats.MAGIC * 0.01))
			if (Effect[5] & EFFECT_MODIFIER_STACKABLE) {//Effect is stackable
				for (var tar: var dist in RealTargets) { 
					_final += Fitness.TotalTpFunction(-ValueAdded * Consequences.DistToAoeNumber(dist), tar)
				}
			} else {
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var Tmp = 0
					if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
						for (var eff in TargetStats.EFFECTS) {
							if (eff[5] == Item) {
								Tmp += eff[1]
								break
							}
