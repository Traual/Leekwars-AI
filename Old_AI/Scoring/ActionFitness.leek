		EFFECT_REMOVE_SHACKLES: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			for (var tar: var dist in RealTargets) {
				var TargetStats = ActualStats[tar]
				if (TargetStats.TO_SAVE_SHACKLE_AGILITY) {
					_final += Fitness.AgilityFunction(TargetStats.TO_SAVE_SHACKLE_AGILITY, tar)
				}
				if (TargetStats.TO_SAVE_SHACKLE_MAGIC) {
					_final += Fitness.MagicFunction(TargetStats.TO_SAVE_SHACKLE_MAGIC, tar)
				}
				if (TargetStats.TO_SAVE_SHACKLE_TOTAL_MP) {
					_final += Fitness.TotalMpFunction(TargetStats.TO_SAVE_SHACKLE_TOTAL_MP, tar)
				}
				if (TargetStats.TO_SAVE_SHACKLE_STRENGTH) {
					_final += Fitness.StrengthFunction(TargetStats.TO_SAVE_SHACKLE_STRENGTH, tar)
				}
				if (TargetStats.TO_SAVE_SHACKLE_TOTAL_TP) {
					_final += Fitness.TotalTpFunction(TargetStats.TO_SAVE_SHACKLE_TOTAL_TP, tar)
				}
				if (TargetStats.TO_SAVE_SHACKLE_WISDOM) {
					_final += Fitness.WisdomFunction(TargetStats.TO_SAVE_SHACKLE_WISDOM, tar)
				}
			}
			return _final
		},
