				}
			}
			return _final
		},
		EFFECT_DAMAGE: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var MyId = CastStats.ID
			var BaseEffect = Effect[1] * Multiplier * (1 + CastStats.STRENGTH * 0.01) * (1 + CastStats.POWER * 0.01)
			var MyWisdomMultiplier = CastStats.WISDOM * 0.001
			var MyLife = CastStats.LIFE
			var MyTotalLife = CastStats.TOTAL_LIFE
			for (var e: var dist in RealTargets) {
				var TargetStats = ActualStats[e]
				var OldValue = TargetStats.LIFE
				var InitialDamages = BaseEffect * Consequences.DistToAoeNumber(dist) * Multiplier
				var RealDamages = max(0, InitialDamages * (1 - TargetStats.RELATIVE_SHIELD * 0.01) - TargetStats.ABSOLUTE_SHIELD)
				var Damage = min(RealDamages, TargetStats.LIFE) // Either the full damage or the Life (If Kill)
				_final += Fitness.LifeFunction(OldValue - Damage, OldValue, TargetStats)
				_final += Fitness.TotalLifeFunction(Damage * EROSION_NO_POISON, e)
				if (e != MyId) {
					var LifeSteal = min(Damage * MyWisdomMultiplier, MyTotalLife - MyLife)
					var Damage_Return = InitialDamages * (TargetStats.DAMAGE_RETURN * 0.01)
					_final += Fitness.LifeFunction(MyLife + (LifeSteal - Damage_Return), MyLife, CastStats)
					_final += Fitness.TotalLifeFunction(Damage_Return * EROSION_NO_POISON, e)
				}
				if (TargetStats.SPECIAL_WEAPON in ActionFitness.SpeMapDmg) _final += ActionFitness.SpeMapDmg[TargetStats.SPECIAL_WEAPON](e, Damage)
			}
			return _final
		},
		EFFECT_DAMAGE_RETURN: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier * (1 + (CastStats.AGILITY * 0.01))
			if (Effect[5] & EFFECT_MODIFIER_STACKABLE) {//Effect is stackable
				for (var tar: var dist in RealTargets) {
					_final += Fitness.DamageReturnFunction(ValueAdded * Consequences.DistToAoeNumber(dist), tar)
				}
			} else {
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var Tmp = 0
					if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
						for (var eff in TargetStats.EFFECTS) {
							if (eff[5] == Item) {
								Tmp -= eff[1]
								break
							}
						}
					}
					Tmp += (ValueAdded * Consequences.DistToAoeNumber(dist))
					_final += Fitness.DamageReturnFunction(Tmp, tar)
				}
			}
			return _final
		},
		EFFECT_DEBUFF: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueRemoved = Effect[1] * Multiplier / 100
			var ValueAdded = 1 - ValueRemoved
			for (var tar: var dist in RealTargets) {
				var TargetStats = ActualStats[tar]
				//Absolute Shield
				if (TargetStats.ABSOLUTE_SHIELD) {
					_final += Fitness.AbsoluteShieldFunction(-TargetStats.ABSOLUTE_SHIELD * ValueRemoved, tar)
				}
				//Relative Shield
				if (TargetStats.RELATIVE_SHIELD) {
					var OldValueRelativeShield = TargetStats.RELATIVE_SHIELD
					_final += Fitness.RelativeShieldFunction(OldValueRelativeShield * ValueAdded, OldValueRelativeShield, tar)
				}
				//Damage Return
				if (TargetStats.DAMAGE_RETURN) {
					_final += Fitness.DamageReturnFunction(-TargetStats.DAMAGE_RETURN * ValueRemoved, tar)
				}
				//Poison
				if (TargetStats.POISON) {
					var OldValuePoison = TargetStats.POISON
					_final += Fitness.PoisonFunction(OldValuePoison * ValueAdded, OldValuePoison, TargetStats)
				}
				//Poison Over Time 
				if (TargetStats.POISON_OVER_TIME) {
					var OldValuePoisonOverTime = TargetStats.POISON_OVER_TIME
					_final += Fitness.PoisonOverTimeFunction(OldValuePoisonOverTime * ValueAdded, OldValuePoisonOverTime, TargetStats)
				}
				//Strength
				if (TargetStats.STRENGTH != TargetStats.TO_SAVE_STRENGTH) {
					_final += Fitness.StrengthFunction(-(TargetStats.STRENGTH - TargetStats.TO_SAVE_STRENGTH) * ValueRemoved, tar)
				}
				//Wisdom
				if (TargetStats.WISDOM != TargetStats.TO_SAVE_WISDOM) {
					_final += Fitness.WisdomFunction(-(TargetStats.WISDOM - TargetStats.TO_SAVE_WISDOM) * ValueRemoved, tar)
				}
				//Agility
				if (TargetStats.AGILITY != TargetStats.TO_SAVE_AGILITY) {
					_final += Fitness.AgilityFunction(-(TargetStats.AGILITY - TargetStats.TO_SAVE_AGILITY) * ValueRemoved, tar)
				}
				//Resistance
				if (TargetStats.RESISTANCE != TargetStats.TO_SAVE_RESISTANCE) {
					_final += Fitness.ResistanceFunction(-(TargetStats.RESISTANCE - TargetStats.TO_SAVE_RESISTANCE) * ValueRemoved, tar)
				}
				//Science
				if (TargetStats.SCIENCE != TargetStats.TO_SAVE_SCIENCE) {
					_final += Fitness.ScienceFunction(-(TargetStats.SCIENCE - TargetStats.TO_SAVE_SCIENCE) * ValueRemoved, tar)
				}
				//Magic
				if (TargetStats.MAGIC != TargetStats.TO_SAVE_MAGIC) {
					_final += Fitness.MagicFunction(-(TargetStats.MAGIC - TargetStats.TO_SAVE_MAGIC) * ValueRemoved, tar)
				}
				//Mp
				if (TargetStats.TOTAL_MP != TargetStats.TO_SAVE_TOTAL_MP) {
					_final += Fitness.TotalMpFunction(-(TargetStats.TOTAL_MP - TargetStats.TO_SAVE_TOTAL_MP) * ValueRemoved, tar)
				}
				//Tp
				if (TargetStats.TOTAL_TP != TargetStats.TO_SAVE_TOTAL_TP) {
					_final += Fitness.TotalTpFunction(-(TargetStats.TOTAL_TP - TargetStats.TO_SAVE_TOTAL_TP) * ValueRemoved, tar)
				}
			}
			return _final
		},
		EFFECT_HEAL: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier * (1 + (CastStats.WISDOM * 0.01))
			var DurationOfEffect = Effect[3]
			if (DurationOfEffect > 0) { //Its a poison
				if (Effect[5] & EFFECT_MODIFIER_STACKABLE) {//Effect is stackable
					for (var tar: var dist in RealTargets) {
						var TargetStats = ActualStats[tar]
						var RealValueAdded = ValueAdded * Consequences.DistToAoeNumber(dist)
						var OldValue = TargetStats.POISON
						var OldValueOverTime = TargetStats.POISON_OVER_TIME
						var NewValue = OldValue - (RealValueAdded)
						var NewValueOverTime = OldValueOverTime - (RealValueAdded * DurationOfEffect)
						_final += Fitness.PoisonFunction(NewValue, OldValue, TargetStats)
						_final += Fitness.PoisonOverTimeFunction(NewValueOverTime, OldValueOverTime, TargetStats)
					}
				} else {
					for (var tar: var dist in RealTargets) {
						var TargetStats = ActualStats[tar]
						var RealValueAdded = ValueAdded * Consequences.DistToAoeNumber(dist)
						var OldValue = TargetStats.POISON
						var OldValueOverTime = TargetStats.POISON_OVER_TIME
						if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
							for (var eff in TargetStats.EFFECTS) {
								if (eff[5] == Item) {
									OldValue += eff[1]
									OldValueOverTime += eff[1] * eff[3]
								}
							}
						}
						var NewValue = OldValue - (RealValueAdded)
						var NewValueOverTime = OldValueOverTime - (RealValueAdded * DurationOfEffect)
						_final += Fitness.PoisonFunction(NewValue, OldValue, TargetStats)
						_final += Fitness.PoisonOverTimeFunction(NewValueOverTime, OldValueOverTime, TargetStats)
					}
				}
			} else { //Its an instant heal
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var OldValue = TargetStats.LIFE
					var NewValue = min(OldValue + (ValueAdded * Consequences.DistToAoeNumber(dist)), TargetStats.TOTAL_LIFE)
					_final += Fitness.LifeFunction(NewValue, OldValue, TargetStats)
				}
			}
			return _final
		},
		EFFECT_INVERT: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			return 0 //TODO : Change after GravityMap is done
		},
		EFFECT_KILL: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			for (var tar: var dist in RealTargets) {
				var TargetStats = ActualStats[tar]
				var OldValue = TargetStats.LIFE
				var NewValue = 0
				_final += Fitness.LifeFunction(NewValue, OldValue, TargetStats)
			}
			return _final
		},
		EFFECT_LIFE_DAMAGE: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var MyId = CastStats.ID
			var BaseEffect = Effect[1] * Multiplier * 0.01 * CastStats.LIFE * (1 + CastStats.POWER / 100)
			var MyLife = CastStats.LIFE
			for (var e: var dist in RealTargets) {
				var TargetStats = ActualStats[e]
				var OldValue = TargetStats.LIFE
				var InitialDamages = BaseEffect * Consequences.DistToAoeNumber(dist) * Multiplier
				var RealDamages = max(0, InitialDamages * (1 - TargetStats.RELATIVE_SHIELD * 0.01) - TargetStats.ABSOLUTE_SHIELD)
				var Damage = min(RealDamages, TargetStats.LIFE) // Either the full damage or the Life (If Kill)
				_final += Fitness.LifeFunction(OldValue - Damage, OldValue, TargetStats)
				_final += Fitness.TotalLifeFunction(Damage * EROSION_NO_POISON, e)
				if (e != MyId) {
					var Damage_Return = InitialDamages * (TargetStats.DAMAGE_RETURN * 0.01)
					_final += Fitness.LifeFunction(MyLife - Damage_Return, MyLife, CastStats)
					_final += Fitness.TotalLifeFunction(Damage_Return * EROSION_NO_POISON, e)
				}
				if (TargetStats.SPECIAL_WEAPON in ActionFitness.SpeMapDmg) _final += ActionFitness.SpeMapDmg[TargetStats.SPECIAL_WEAPON](e, Damage)
			}
			return _final
		},
		EFFECT_NOVA_DAMAGE: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier * (1 + (CastStats.SCIENCE * 0.01))
			for (var tar: var dist in RealTargets) {
				var TargetStats = ActualStats[tar]
				var OldValue = TargetStats.TOTAL_LIFE
				var RealValueAdded = min(ValueAdded * Consequences.DistToAoeNumber(dist), TargetStats.TOTAL_LIFE - TargetStats.LIFE)
				_final += Fitness.TotalLifeFunction(RealValueAdded, tar)

				if (TargetStats.SPECIAL_WEAPON in ActionFitness.SpeMapNova) _final += ActionFitness.SpeMapNova[TargetStats.SPECIAL_WEAPON](tar, RealValueAdded)
			}
			return _final
		},
		EFFECT_NOVA_VITALITY: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier * (1 + (CastStats.SCIENCE * 0.01))
			for (var tar: var dist in RealTargets) {
				_final += Fitness.TotalLifeFunction(ValueAdded * Consequences.DistToAoeNumber(dist), tar)
			}
			return _final
		},
		EFFECT_POISON: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier * (1 + (CastStats.MAGIC * 0.01))
			var DurationOfEffect = Effect[3]
			if (Effect[5] & EFFECT_MODIFIER_STACKABLE) {//Effect is stackable
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var RealValueAdded = ValueAdded * Consequences.DistToAoeNumber(dist)
					var OldValue = TargetStats.POISON
					var OldValueOverTime = TargetStats.POISON_OVER_TIME
					var NewValue = OldValue + (RealValueAdded)
					var NewValueOverTime = OldValueOverTime + (RealValueAdded * DurationOfEffect)
					_final += Fitness.PoisonFunction(NewValue, OldValue, TargetStats)
					_final += Fitness.PoisonOverTimeFunction(NewValueOverTime, OldValueOverTime, TargetStats)
				}
			} else {
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var RealValueAdded = ValueAdded * Consequences.DistToAoeNumber(dist)
					var OldValue = TargetStats.POISON
					var OldValueOverTime = TargetStats.POISON_OVER_TIME
					if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
						for (var eff in TargetStats.EFFECTS) {
							if (eff[5] == Item) {
								OldValue -= eff[1]
								OldValueOverTime -= eff[1] * eff[3]
							}
						}
					}
					var NewValue = OldValue + (RealValueAdded)
					var NewValueOverTime = OldValueOverTime + (RealValueAdded * DurationOfEffect)
					_final += Fitness.PoisonFunction(NewValue, OldValue, TargetStats)
					_final += Fitness.PoisonOverTimeFunction(NewValueOverTime, OldValueOverTime, TargetStats)
				}
			}
			return _final
		},
