		EFFECT_SHACKLE_WISDOM: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier * (1 + (CastStats.MAGIC * 0.01))
			if (Effect[5] & EFFECT_MODIFIER_STACKABLE) {//Effect is stackable
				for (var tar: var dist in RealTargets) { 
					_final += Fitness.WisdomFunction(-ValueAdded * Consequences.DistToAoeNumber(dist), tar)
				}
			} else {
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var Tmp = 0
					if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
						for (var eff in TargetStats.EFFECTS) {
							if (eff[5] == Item) {
								Tmp += eff[1]
								break
							}
						}
					}
					Tmp -= (ValueAdded * Consequences.DistToAoeNumber(dist))
					_final += Fitness.WisdomFunction(Tmp, tar)
				}
			}
			return _final
		},
		EFFECT_STEAL_ABSOLUTE_SHIELD: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier
			if (Effect[5] & EFFECT_MODIFIER_STACKABLE) {//Effect is stackable
				for (var tar: var dist in RealTargets) { 
					_final += Fitness.AbsoluteShieldFunction(ValueAdded * Consequences.DistToAoeNumber(dist), tar)
				}
			} else {
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var Tmp = 0
					if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
						for (var eff in TargetStats.EFFECTS) {
							if (eff[5] == Item) {
								Tmp -= eff[1]
								break
							}
						}
					}
					Tmp += (ValueAdded * Consequences.DistToAoeNumber(dist))
					_final += Fitness.AbsoluteShieldFunction(Tmp, tar)
				}
			}
			return _final
		},
		EFFECT_SUMMON: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			return SummonChipMapScore[Item]
		},
		EFFECT_TELEPORT: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			return 0 //It isn't scored cuz its on walkcells
		},
		EFFECT_VULNERABILITY: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier
			if (Effect[5] & EFFECT_MODIFIER_STACKABLE) {//Effect is stackable
				for (var tar: var dist in RealTargets) { 
					var TargetStats = ActualStats[tar]
					var OldValue = TargetStats.RELATIVE_SHIELD
					var NewValue = OldValue - (ValueAdded * Consequences.DistToAoeNumber(dist))
					_final += Fitness.RelativeShieldFunction(NewValue, OldValue, tar)
				}
			} else {
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var OldValue = TargetStats.RELATIVE_SHIELD
					if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
						for (var eff in TargetStats.EFFECTS) {
							if (eff[5] == Item) {
								OldValue -= eff[1]
							}
						}
					}
					var NewValue = OldValue - (ValueAdded * Consequences.DistToAoeNumber(dist))
					_final += Fitness.RelativeShieldFunction(NewValue, OldValue, tar)
				}
			}
			return _final
		}
	]

	static SpeMapDmg = [ //and Dark Katana ? Add Enhanced Lightninger ? TODO
		WEAPON_REVOKED_M_LASER: function(TargetID, DamageTmp) {
			return Fitness.StrengthFunction(DamageTmp * 0.05, TargetID)
		},
		WEAPON_UNBRIDLED_GAZOR: function(TargetID, DamageTmp) {
			return Fitness.MagicFunction(DamageTmp * 0.01, TargetID)
		},
		WEAPON_MYSTERIOUS_ELECTRISOR: function(TargetID, DamageTmp) {
			return Fitness.AbsoluteShieldFunction(DamageTmp * 0.05, TargetID)
		}
	]

	static SpeMapNova = [
		WEAPON_UNBRIDLED_GAZOR: function(TargetID, DamageTmp) {
			return Fitness.MagicFunction(DamageTmp * 0.2, TargetID)
		}
	]
