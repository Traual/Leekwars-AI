		EFFECT_RAW_HEAL: function(ActualStats, From, To, Effect, Caster, Multiplier, Item, RealTargets, CastStats) {
			var _final = 0
			var ValueAdded = Effect[1] * Multiplier
			var DurationOfEffect = Effect[3]
			if (DurationOfEffect > 0) { //Its a poison
				if (Effect[5] & EFFECT_MODIFIER_STACKABLE) {//Effect is stackable
					for (var tar: var dist in RealTargets) {
						var TargetStats = ActualStats[tar]
						var RealValueAdded = ValueAdded * Consequences.DistToAoeNumber(dist)
						var OldValue = TargetStats.POISON
						var OldValueOverTime = TargetStats.POISON_OVER_TIME
						var NewValue = OldValue - (RealValueAdded)
						var NewValueOverTime = OldValueOverTime - (RealValueAdded * DurationOfEffect)
						_final += Fitness.PoisonFunction(NewValue, OldValue, TargetStats)
						_final += Fitness.PoisonOverTimeFunction(NewValueOverTime, OldValueOverTime, TargetStats)
					}
				} else {
					for (var tar: var dist in RealTargets) {
						var TargetStats = ActualStats[tar]
						var RealValueAdded = ValueAdded * Consequences.DistToAoeNumber(dist)
						var OldValue = TargetStats.POISON
						var OldValueOverTime = TargetStats.POISON_OVER_TIME
						if (TargetStats.EFFECTS_ITEM_MAP[Item]) {//Enemy already has the item, so i will need to update the OldValue Without the item effects
							for (var eff in TargetStats.EFFECTS) {
								if (eff[5] == Item) {
									OldValue += eff[1]
									OldValueOverTime += eff[1] * eff[3]
								}
							}
						}
						var NewValue = OldValue - (RealValueAdded)
						var NewValueOverTime = OldValueOverTime - (RealValueAdded * DurationOfEffect)
						_final += Fitness.PoisonFunction(NewValue, OldValue, TargetStats)
						_final += Fitness.PoisonOverTimeFunction(NewValueOverTime, OldValueOverTime, TargetStats)
					}
				}
			} else { //Its an instant heal
				for (var tar: var dist in RealTargets) {
					var TargetStats = ActualStats[tar]
					var OldValue = TargetStats.LIFE
					var NewValue = min(OldValue + (ValueAdded * Consequences.DistToAoeNumber(dist)), TargetStats.TOTAL_LIFE)
					_final += Fitness.LifeFunction(NewValue, OldValue, TargetStats)
				}
			}
			return _final
		},
