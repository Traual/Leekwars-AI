/**
 * This will load final cell (cell to end turn) its a combination between GravityCells and CellDanger
 **/

include("../includes.leek")

class FinalCache {
	CELL
	DANGER
	GRAVITY_SCORE
	constructor(Cell, Danger, GravityScore) {
		this.CELL = Cell
		this.DANGER = Danger
		this.GRAVITY_SCORE = GravityScore
	}
}