	CIRCLE_TWO_DIST
	CIRCLE_THREE_DIST
	SQUARE_ONE_DIST
	SQUARE_TWO_DIST
	PLUS_TWO_DIST
	PLUS_THREE_DIST
	X_ONE_DIST
