	static getLine(cell, minradius, radius) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE * MAX_POSSIBLE_RANGE) + (minradius * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in LINE_CACHE) return LINE_CACHE[TmpHash]
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]
		for (var i = minradius; i <= radius; i++) {
			_final += getPointsLine(cell, i, BaseX, BaseY)
		}
		LINE_CACHE[TmpHash] = _final
		return _final
	}

	static getPointsLine(cell, radius, BaseX, BaseY) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in POINTS_LINE_CACHE) return POINTS_LINE_CACHE[TmpHash]
		var _final = [: ]
		var Cell1 = getCellFromXY(BaseX + radius, BaseY)
		var Cell2 = getCellFromXY(BaseX - radius, BaseY)
		var Cell3 = getCellFromXY(BaseX, BaseY + radius)
		var Cell4 = getCellFromXY(BaseX, BaseY - radius)
		if (Cell1!=null && !TMPOBSTACLES[Cell1]) _final[Cell1] = true
		if (Cell2!=null && !TMPOBSTACLES[Cell2]) _final[Cell2] = true
		if (Cell3!=null && !TMPOBSTACLES[Cell3]) _final[Cell3] = true
		if (Cell4!=null && !TMPOBSTACLES[Cell4]) _final[Cell4] = true
		POINTS_LINE_CACHE[TmpHash] = _final
		return _final
	}

	static getLineWithLos(cell, minradius, radius) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE * MAX_POSSIBLE_RANGE) + (minradius * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in LINE_WITH_LOS_CACHE) return LINE_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]
		for (var d = minradius; d <= radius; d++) {
			_final += getPointsLineWithLos(cell, d, BaseX, BaseY)
		}
		LINE_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	
	static getPointsLineWithLos(cell, radius, BaseX, BaseY) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in POINTS_LINE_WITH_LOS_CACHE) return POINTS_LINE_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		for (var testingCell:var bool in getPointsLine(cell, radius, BaseX, BaseY)) {
			if (getLos(testingCell, cell)) {
				_final[testingCell] = true
			}
		}
		POINTS_LINE_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}
