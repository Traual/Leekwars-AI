	static getDiagonal(cell, minradius, radius) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE * MAX_POSSIBLE_RANGE) + (minradius * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in DIAGONAL_CACHE) return DIAGONAL_CACHE[TmpHash]
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]
		for (var i = minradius / 2; i <= radius / 2; i++) {
			_final += getDiagonalPoints(cell, i, BaseX, BaseY)
		}
		DIAGONAL_CACHE[TmpHash] = _final
		return _final
	}

	static getDiagonalPoints(cell, radius, BaseX, BaseY) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in POINTS_DIAGONAL_CACHE) return POINTS_DIAGONAL_CACHE[TmpHash]
		var _final = [: ]
		var Cell1 = getCellFromXY(BaseX + radius, BaseY + radius)
		var Cell2 = getCellFromXY(BaseX + radius, BaseY - radius)
		var Cell3 = getCellFromXY(BaseX - radius, BaseY + radius)
		var Cell4 = getCellFromXY(BaseX - radius, BaseY - radius)
		if (Cell1!=null && !TMPOBSTACLES[Cell1]) _final[Cell1] = true
		if (Cell2!=null && !TMPOBSTACLES[Cell2]) _final[Cell2] = true
		if (Cell3!=null && !TMPOBSTACLES[Cell3]) _final[Cell3] = true
		if (Cell4!=null && !TMPOBSTACLES[Cell4]) _final[Cell4] = true
		POINTS_DIAGONAL_CACHE[TmpHash] = _final
		return _final
	}
	
	static getDiagonalWithLos(cell, minradius, radius) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE * MAX_POSSIBLE_RANGE) + (minradius * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in DIAGONAL_WITH_LOS_CACHE) return DIAGONAL_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]
		for (var d = minradius / 2; d <= radius / 2; d++) {
			_final += getDiagonalPointsWithLos(cell, d, BaseX, BaseY)
		}
		DIAGONAL_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	
	static getDiagonalPointsWithLos(cell, radius, BaseX, BaseY) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in POINTS_DIAGONAL_WITH_LOS_CACHE) return POINTS_DIAGONAL_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		for (var testingCell:var bool in getDiagonalPoints(cell, radius, BaseX, BaseY)) {
			if (getLos(testingCell, cell)) {
				_final[testingCell] = true
			}
		}
		POINTS_DIAGONAL_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	static getStar(cell, minradius, radius) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE * MAX_POSSIBLE_RANGE) + (minradius * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in STAR_CACHE) return STAR_CACHE[TmpHash]
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]
		for (var d = minradius; d <= radius; d++) {
			_final += getStarPoints(cell, d, BaseX, BaseY)
		}
		STAR_CACHE[TmpHash] = _final
		return _final
	}

	static getStarPoints(cell, radius, BaseX, BaseY) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in POINTS_STAR_CACHE) return POINTS_STAR_CACHE[TmpHash]
		var _final = [: ]
		if (!(radius % 2)) {
			_final = mapMerge(getDiagonalPoints(cell, radius/2, BaseX, BaseY), getPointsLine(cell, radius, BaseX, BaseY))
		} else {
			_final = getPointsLine(cell, radius, BaseX, BaseY)
		}
		POINTS_STAR_CACHE[TmpHash] = _final
		return _final
	}
	
	static getStarWithLos(cell, minradius, radius) { //Special case, no need points maps cuz already saved in cache of Diagonals and Lines
		var TmpHash = (cell * MAX_POSSIBLE_RANGE * MAX_POSSIBLE_RANGE) + (minradius * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in STAR_WITH_LOS_CACHE) return STAR_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]
		for (var d = minradius; d <= radius; d++) {
			_final += getStarPointsWithLos(cell, d, BaseX, BaseY)
		}
		STAR_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	static getStarPointsWithLos(cell, radius, BaseX, BaseY) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in POINTS_STAR_WITH_LOS_CACHE) return POINTS_STAR_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		for (var testingCell:var bool in getStarPoints(cell, radius, BaseX, BaseY)) {
			if (getLos(testingCell, cell)) {
				_final[testingCell] = true
			}
		}
		POINTS_STAR_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	static getInvertedStar(cell, minradius, radius) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE * MAX_POSSIBLE_RANGE) + (minradius * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in INVERTED_STAR_CACHE) return INVERTED_STAR_CACHE[TmpHash]
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]

		if (minradius == 0) _final[cell] = true
		// Parcourir les cellules dans le rayon
		for (var d = minradius; d <= radius; d++) {
			_final += getInvertedStarPoints(cell, d, BaseX, BaseY)
		}
		INVERTED_STAR_CACHE[TmpHash] = _final
		return _final
	}

	static getInvertedStarPoints(cell, radius, BaseX, BaseY) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in POINTS_INVERTED_STAR_CACHE) return POINTS_INVERTED_STAR_CACHE[TmpHash]
		var _final = [: ]
		var CircleForThisRadius = getCircle(cell, radius)
		var StarForThisRadius = getStarPoints(cell, radius, BaseX, BaseY)
		for (var cellTest:var bool in CircleForThisRadius) {
			if (!(cellTest in StarForThisRadius)) _final[cellTest] = true
		}
		POINTS_INVERTED_STAR_CACHE[TmpHash] = _final
		return _final
	}

	static getInvertedStarWithLos(cell, minradius, radius) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE * MAX_POSSIBLE_RANGE) + (minradius * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in INVERTED_STAR_WITH_LOS_CACHE) return INVERTED_STAR_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]
		for (var d = minradius; d <= radius; d++) {
			_final += getInvertedStarPointsWithLos(cell, d, BaseX, BaseY)
		}
		INVERTED_STAR_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	
	static getInvertedStarPointsWithLos(cell, radius, BaseX, BaseY) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in POINTS_INVERTED_STAR_WITH_LOS_CACHE) return POINTS_INVERTED_STAR_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		for (var testingCell:var bool in getInvertedStarPoints(cell, radius, BaseX, BaseY)) {
			if (getLos(testingCell, cell)) {
				_final[testingCell] = true
			}
		}
		POINTS_INVERTED_STAR_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	static getLaserAoe(from, to, minrange, maxrange) {
		var Hash = from + (to * 1000) + (minrange * 100000) + (maxrange * 10000000)
		if (Hash in LASERS) return LASERS[Hash]
		var _final = [: ]
		/*if (from == to) {//Its a quick fix for Consequence on Lasers Without Knowing where it'll be from
			debug("Hey wtf ?")
			LASERS[Hash] = [from : true]
			return [from : true]
		}*/
		var FromX = CELL_X[from]
		var FromY = CELL_Y[from]
		var ToX = CELL_X[to]
		var ToY = CELL_Y[to]
		if (FromX == ToX) { //On The Y Line
			if (ToY > FromY) {
				for (var d = minrange; d <= maxrange; d++) {
					var Cell = getCellFromXY(FromX, FromY + d)
					if (Cell == null || TMPOBSTACLES[Cell]) break
					_final[Cell] = true
				}
			} else {
				for (var d = minrange; d <= maxrange; d++) {
					var Cell = getCellFromXY(FromX, FromY - d)
					if (Cell == null || TMPOBSTACLES[Cell]) break
					_final[Cell] = true
				}
			}
		} else if (FromY == ToY) { //On The X Line
			if (ToX > FromX) {
				for (var d = minrange; d <= maxrange; d++) {
					var Cell = getCellFromXY(FromX + d, FromY)
					if (Cell == null || TMPOBSTACLES[Cell]) break
					_final[Cell] = true
				}
			} else {
				for (var d = minrange; d <= maxrange; d++) {
					var Cell = getCellFromXY(FromX - d, FromY)
					if (Cell == null || TMPOBSTACLES[Cell]) break
					_final[Cell] = true
				}
			}
		}
		
		LASERS[Hash] = _final
		return _final
	}
	
	static getFirstInlineAoe(from, to, minrange, maxrange, EntityMap) {
		var _final = [: ]
		/*if (from == to) {//Its a quick fix for Consequence on Lasers Without Knowing where it'll be from
			debug("Hey wtf ?")
			return [from : true]
		}*/
		var FromX = CELL_X[from]
		var FromY = CELL_Y[from]
		var ToX = CELL_X[to]
		var ToY = CELL_Y[to]
		if (FromX == ToX) { //On The Y Line
			if (ToY > FromY) {
				for (var d = minrange; d <= maxrange; d++) {
					var Cell = getCellFromXY(FromX, FromY + d)
					if (Cell == null || TMPOBSTACLES[Cell]) break
					if (EntityMap[Cell]) {
						_final[Cell] = true
						break
					}
				}
			} else {
				for (var d = minrange; d <= maxrange; d++) {
					var Cell = getCellFromXY(FromX, FromY - d)
					if (Cell == null || TMPOBSTACLES[Cell]) break
					if (EntityMap[Cell]) {
						_final[Cell] = true
						break
					}
				}
			}
		} else if (FromY == ToY) { //On The X Line
			if (ToX > FromX) {
				for (var d = minrange; d <= maxrange; d++) {
					var Cell = getCellFromXY(FromX + d, FromY)
					if (Cell == null || TMPOBSTACLES[Cell]) break
					if (EntityMap[Cell]) {
						_final[Cell] = true
						break
					}
				}
			} else {
				for (var d = minrange; d <= maxrange; d++) {
					var Cell = getCellFromXY(FromX - d, FromY)
					if (Cell == null || TMPOBSTACLES[Cell]) break
					if (EntityMap[Cell]) {
						_final[Cell] = true
						break
					}
				}
			}
		}
		return _final
	}

	static getDistMapFromBoolMap(BoolMap, cell) {
		var _final = [: ]
		for (var c: var bool in BoolMap) {
			_final[c] = getDist(c, cell)
		}
		return _final
	}

	static getSquareOne(cell) { //Return Square 1 (no obstacle) //TODO : Redo less ugly (please)
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]
		var Cells = [ //CLASS 1
			getCellFromXY(BaseX + 1, BaseY),
			getCellFromXY(BaseX - 1, BaseY),
			getCellFromXY(BaseX, BaseY + 1),
			getCellFromXY(BaseX, BaseY - 1),
			getCellFromXY(BaseX + 1, BaseY + 1),
			getCellFromXY(BaseX - 1, BaseY - 1),
			getCellFromXY(BaseX - 1, BaseY + 1),
			getCellFromXY(BaseX + 1, BaseY - 1),
			cell
		]
		for (var c in Cells) {
			if (c != null && !TMPOBSTACLES[c]) _final[c] = true
		}
		return _final
	}

	static getSquareTwo(cell) { //Return Square 2 (no obstacle) //TODO : Redo less ugly (please)
		var _final = [: ]
		var BaseX = CELL_X[cell]
		var BaseY = CELL_Y[cell]
		var Cells = [ //CLASS 1
			getCellFromXY(BaseX + 1, BaseY),
			getCellFromXY(BaseX - 1, BaseY),
			getCellFromXY(BaseX, BaseY + 1),
			getCellFromXY(BaseX, BaseY - 1),
			getCellFromXY(BaseX + 1, BaseY + 1),
			getCellFromXY(BaseX + 1, BaseY - 1),
			getCellFromXY(BaseX - 1, BaseY + 1),
			getCellFromXY(BaseX - 1, BaseY - 1),
			cell,
			//CLASS 2
			getCellFromXY(BaseX + 2, BaseY),
			getCellFromXY(BaseX - 2, BaseY),
			getCellFromXY(BaseX, BaseY + 2),
			getCellFromXY(BaseX, BaseY - 2),
			getCellFromXY(BaseX + 2, BaseY + 1),
			getCellFromXY(BaseX + 2, BaseY - 1),
			getCellFromXY(BaseX - 2, BaseY + 1),
			getCellFromXY(BaseX - 2, BaseY - 1),
			getCellFromXY(BaseX + 1, BaseY + 2),
			getCellFromXY(BaseX + 1, BaseY - 2),
			getCellFromXY(BaseX - 1, BaseY + 2),
			getCellFromXY(BaseX - 1, BaseY - 2),
			getCellFromXY(BaseX - 2, BaseY - 2),
			getCellFromXY(BaseX - 2, BaseY + 2),
			getCellFromXY(BaseX + 2, BaseY - 2),
			getCellFromXY(BaseX + 2, BaseY + 2)
		]
		for (var c in Cells) {
			if (c != null && !TMPOBSTACLES[c]) _final[c] = true
		}
		return _final
	}
	/*
	static SortedMapCellsArray(CellsMap) { //Sort a map by its value (walk cells, area dist ...)
		var _final = []
		for (var c: var mp in CellsMap) {
			push(_final, c)
		}
		var tmp = arraySort(_final, function(a, b) {
			return CellsMap[a] - CellsMap[b]
		})
		return tmp
