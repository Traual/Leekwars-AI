	ALLCELLINFO = [: ]

	constructor(cell) {
		this.OBSTACLE = TMPOBSTACLES[cell]
		this.CELL = cell
		//this.ALLNEIGHBOURS = getAllNeighbours(cell)
		//this.NEIGHBOURS = getNeighbours(this.ALLNEIGHBOURS)
		//Area map (cell:true)
		this.CIRCLE_ONE = CellInfo.getDisc(cell, 0, 1)
		this.CIRCLE_TWO = CellInfo.getDisc(cell, 0, 2)
		this.CIRCLE_THREE = CellInfo.getDisc(cell, 0, 3)
		this.SQUARE_ONE = CellInfo.getSquareOne(cell)
		this.SQUARE_TWO = CellInfo.getSquareTwo(cell)
		this.PLUS_TWO = CellInfo.getLine(cell, 0, 2)
		this.PLUS_THREE = CellInfo.getLine(cell, 0, 3)
		this.X_ONE = CellInfo.getDiagonal(cell, 0, 2)
		this.X_TWO = CellInfo.getDiagonal(cell, 0, 4)
		this.X_THREE = CellInfo.getDiagonal(cell, 0, 6)
		//Area map (cell:dist)
		this.CIRCLE_ONE_DIST = getDistMapFromBoolMap(this.CIRCLE_ONE, cell)
		this.CIRCLE_TWO_DIST = getDistMapFromBoolMap(this.CIRCLE_TWO, cell)
		this.CIRCLE_THREE_DIST = getDistMapFromBoolMap(this.CIRCLE_THREE, cell)
		this.SQUARE_ONE_DIST = getDistMapFromBoolMap(this.SQUARE_ONE, cell)
		this.SQUARE_TWO_DIST = getDistMapFromBoolMap(this.SQUARE_TWO, cell)
		this.PLUS_TWO_DIST = getDistMapFromBoolMap(this.PLUS_TWO, cell)
		this.PLUS_THREE_DIST = getDistMapFromBoolMap(this.PLUS_THREE, cell)
		this.X_ONE_DIST = getDistMapFromBoolMap(this.X_ONE, cell)
		this.X_TWO_DIST = getDistMapFromBoolMap(this.X_TWO, cell)
		this.X_THREE_DIST = getDistMapFromBoolMap(this.X_THREE, cell)
		//Area Array (cell sorted by dist) SortedMapCellsArray(CellsMap)
		/*this.CIRCLE_ONE_ARRAY = SortedMapCellsArray(this.CIRCLE_ONE_DIST)
		this.CIRCLE_TWO_ARRAY = SortedMapCellsArray(this.CIRCLE_TWO_DIST)
		this.CIRCLE_THREE_ARRAY = SortedMapCellsArray(this.CIRCLE_THREE_DIST)
		this.SQUARE_ONE_ARRAY = SortedMapCellsArray(this.SQUARE_ONE_DIST)
		this.SQUARE_TWO_ARRAY = SortedMapCellsArray(this.SQUARE_TWO_DIST)
		this.PLUS_TWO_ARRAY = SortedMapCellsArray(this.PLUS_TWO_DIST)
		this.PLUS_THREE_ARRAY = SortedMapCellsArray(this.PLUS_THREE_DIST)
		this.X_ONE_ARRAY = SortedMapCellsArray(this.X_ONE_DIST)
		this.X_TWO_ARRAY = SortedMapCellsArray(this.X_TWO_DIST)
		this.X_THREE_ARRAY = SortedMapCellsArray(this.X_THREE_DIST)*/
		//Random Values
		this.X = CELL_X[cell]
		this.Y = CELL_Y[cell]
	}

	static Init() {
		for (var c = 0; c < 613; c++) {
			TMPOBSTACLES[c] = isObstacle(c)
			CELL_Y[c] = getCellY(c)
			CELL_X[c] = getCellX(c)
		}
		for (var c = 0; c < 613; c++) {
			MAP_CELL_TO_LINE[c] = CellToLine(c)
			MAP_CELL_TO_POS[c] = CellToPos(c)
		}
		for (var c = 0; c < 613; c++) {
			var cInfo = new CellInfo(c)
			ALLCELLINFO[c] = cInfo
		}
	}

	static getDisc(cell, minradius, radius) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE * MAX_POSSIBLE_RANGE) + (minradius * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in DISK_CACHE) return DISK_CACHE[TmpHash]

		var _final = [: ]
		// Parcourir les cellules dans les rayon
		for (var d = minradius; d <= radius; d++) {
			_final += getCircle(cell, d)
		}

		DISK_CACHE[TmpHash] = _final
		return _final
	}

	static getCircle(cell, radius) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in CIRCLE_CACHE) return CIRCLE_CACHE[TmpHash]
		var _final = [: ]
		for (var testingCell in CIRCLES_CELL_RADIUS[cell][radius]) {
			if (!TMPOBSTACLES[testingCell]) {
				_final[testingCell] = true
			}
		}
		CIRCLE_CACHE[TmpHash] = _final
		return _final
		/*
		var TmpHash = (cell * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in CIRCLE_CACHE) return CIRCLE_CACHE[TmpHash]
		var _final = [: ]
		for (var x = -radius; x <= radius; x++) {
			var y1 = radius - abs(x)
			var y2 = -y1

			var ThisCell1 = getCellFromXY(BaseX + x, BaseY + y1)
			if (ThisCell1!=null && !TMPOBSTACLES[ThisCell1]) {
				_final[ThisCell1] = true
			}

			// Vérifier que y1 et y2 ne sont pas égaux pour éviter les doublons
			if (y1 != y2) {
				var ThisCell2 = getCellFromXY(BaseX + x, BaseY + y2)
				if (ThisCell2!=null && !TMPOBSTACLES[ThisCell2]) {
					_final[ThisCell2] = true
				}
			}
		}
		CIRCLE_CACHE[TmpHash] = _final
		return _final*/
	}
	
	static getDiscWithLos(cell, minradius, radius) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE * MAX_POSSIBLE_RANGE) + (minradius * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in DISC_WITH_LOS_CACHE) return DISC_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		for (var d = minradius; d <= radius; d++) {
			_final += getCircleWithLos(cell, d)
		}
		DISC_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

	
	static getCircleWithLos(cell, radius) {
		var TmpHash = (cell * MAX_POSSIBLE_RANGE) + radius
		if (TmpHash in CIRCLE_WITH_LOS_CACHE) return CIRCLE_WITH_LOS_CACHE[TmpHash]
		var _final = [: ]
		for (var testingCell:var bool in getCircle(cell, radius)) {
			if (getLos(testingCell, cell)) {
				_final[testingCell] = true
			}
		}
		CIRCLE_WITH_LOS_CACHE[TmpHash] = _final
		return _final
	}

