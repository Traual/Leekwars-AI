	MP
	//TO_SAVE_MP
	//TO_SAVE_SHACKLE_MP
	TOTAL_MP
	TO_SAVE_TOTAL_MP
	TO_SAVE_SHACKLE_TOTAL_MP
	TP
	//TO_SAVE_TP
	//TO_SAVE_SHACKLE_TP
	TOTAL_TP
