/**
 * Fight constants
**/

include("../includes.leek")

class Fight {
	ALIVEALLIES = []
	ALIVEENEMIES = []
	constructor() {//Not checked
		//this.SELF = getEntity()
		for (var e in getAliveAllies()) {
			push(this.ALIVEALLIES, e)
		}
		for (var e in getAliveEnemies()) {
			push(this.ALIVEENEMIES, e)
		}
	}
}