	}

	for (var bin: var mp in ACCESMPThree) {
		for (var c in BINARY_TO_CELL_THREE_ZERO[(bin & 63)] + BINARY_TO_CELL_THREE_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_THREE_TWO[bin >> 12]) {
