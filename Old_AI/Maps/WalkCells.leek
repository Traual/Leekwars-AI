/**
 * Walkable cells from a state (allstats and an entity) TODO: Jump + walk + tp cells
 **/

include("../includes.leek")

class WalkCells {
	WALK //Map : Cell:Mp
	JUMP
	TELEPORTATION
	TELEPORTATION_AND_JUMP
	MAX
	constructor(EveryStats, Entity, DoWalk, DoJump, DoTeleportation, DoTeleportationAndJump, BaseHash) {
		Benchmark.WalkcellsStart()
		var EntityStats = EveryStats[Entity]
		var EntityCell = EntityStats.CELL
		var EntityCooldowns = EntityStats.COOLDOWNS
		var JumpCooldown = EntityCooldowns[CHIP_JUMP]
		var JumpCost = ITEMINFO[CHIP_JUMP].COST
		var TeleportationCooldown = EntityCooldowns[CHIP_TELEPORTATION]
		var TeleportationCost = ITEMINFO[CHIP_TELEPORTATION].COST
		var Mp = EntityStats.MP
		var Tp = EntityStats.TP
		var LeekCells = LoadIgnoreCells(EveryStats, Entity, BaseHash)
		var HashWalk = HashWalkCells(EntityCell, Mp, BaseHash) //Conditions already checked in constructor so no need to check them in cache

		if (DoWalk) {
			LoadWalkCells(EntityCell, LeekCells, Mp, HashWalk)
		} else {
			this.WALK = [: ]
		}

		var CanJump = (JumpCooldown == 0 || Entity != Me && JumpCooldown <= 1) && Tp >= JumpCost
		if (DoJump && CanJump) {
			LoadJumpCells(EntityCell, LeekCells, Mp, HashWalk)
		} else {
			this.JUMP = [: ]
		}
		
		var CanTeleport = (TeleportationCooldown == 0 || Entity != Me && TeleportationCooldown <= 1) && Tp >= TeleportationCost
		if (DoTeleportation && CanTeleport) {
			LoadTeleportationCells(EntityCell, LeekCells, Mp, HashWalk)
		} else {
			this.TELEPORTATION = [: ]
		}
		
		if (DoTeleportationAndJump && CanJump && CanTeleport && EntityStats.TP >= JumpCost + TeleportationCost) {
			LoadTeleportationAndJumpCells(EntityCell, LeekCells, Mp, HashWalk)
		} else {
			this.TELEPORTATION_AND_JUMP = [: ]
		}
		Benchmark.WalkcellsStop()
	}

	LoadWalkCells(EntityCell, LeekCells, Mp, HashWalk) {
		if (HashWalk in WALKABLE_CACHE) {
			var Cache = WALKABLE_CACHE[HashWalk]
			this.WALK = Cache
			this.MAX = Cache
		} else {
			this.WALK = WalkableCells(EntityCell, LeekCells, Mp)
			this.MAX = this.WALK
			WALKABLE_CACHE[HashWalk] = this.WALK
		}
	}

	LoadJumpCells(EntityCell, LeekCells, Mp, HashWalk) {
		if (HashWalk in JUMP_CACHE) {
			var Cache = JUMP_CACHE[HashWalk]
			this.JUMP = Cache
			this.MAX = Cache
		} else {
			this.JUMP = WalkableCellsWithJump(EntityCell, LeekCells, Mp)
			this.MAX = this.JUMP
			JUMP_CACHE[HashWalk] = this.JUMP
		}
	}

	LoadTeleportationCells(EntityCell, LeekCells, Mp, HashWalk) {
		if (HashWalk in TELEPORTATION_CACHE) {
			var Cache = TELEPORTATION_CACHE[HashWalk]
			this.TELEPORTATION = Cache
			this.MAX = Cache
		} else {
			this.TELEPORTATION = WalkableCellsWithTeleportation(EntityCell, LeekCells, Mp)
			this.MAX = this.TELEPORTATION
			TELEPORTATION_CACHE[HashWalk] = this.TELEPORTATION
		}
	}

	LoadTeleportationAndJumpCells(EntityCell, LeekCells, Mp, HashWalk) {
		if (HashWalk in TELEPORTATION_AND_JUMP_CACHE) {
			var Cache = TELEPORTATION_AND_JUMP_CACHE[HashWalk]
			this.TELEPORTATION_AND_JUMP = Cache
			this.MAX = Cache
		} else {
			this.TELEPORTATION_AND_JUMP = WalkableCellsWithTeleportationAndJump(EntityCell, LeekCells, Mp)
			this.MAX = this.TELEPORTATION_AND_JUMP
			TELEPORTATION_CACHE[HashWalk] = this.TELEPORTATION_AND_JUMP
		}
	}

	HashWalkCells(Cell, Mp, BaseHash) {
		return (BaseHash * MAX_CELL * MAX_MP) + (Cell * MAX_MP) + Mp // We start by Hashing Cell and Mp Value
	}
	
	static LoadCoeffedCellsFromWalkCellsClass(WalkCellsClass) {//Used for Action Map Loading (Should i walk or jump and save mp ...) No need to cache cuz its already cached only by BaseHash in Action Map
		var _final = [: ]
		var Walk = WalkCellsClass.WALK
		var Jump = WalkCellsClass.JUMP
		var Tele = WalkCellsClass.TELEPORTATION
		var TeleAndJump = WalkCellsClass.TELEPORTATION_AND_JUMP
		for (var c:var mp in WalkCellsClass.MAX) {
			if (c in Walk) {
				_final[c] = Walk[c]
			} else if (c in Jump) {
				_final[c] = Jump[c] + 5
			} else if (c in Tele) {
				_final[c] = Tele[c] + 15
			} else if (c in TeleAndJump) {
				_final[c] = TeleAndJump[c] + 20
			}
		}
		return _final
	}

	static MoveTo(cell, EveryStats, BaseHash) { //TODO
		var WalkClass = new WalkCells(EveryStats, Me, true, true, true, true, BaseHash)
		if (WalkClass.WALK && WalkClass.WALK[cell] != null) {
			moveTowardCell(cell)
		} else {
			if (WalkClass.JUMP && WalkClass.JUMP[cell] != null) {
				var ActionToDo = getActionsToGetWithJump(EveryStats[Me].CELL, cell, WalkClass.JUMP, WalkClass.WALK)[0]
				moveTowardCell(ActionToDo.FROM)
				useChipOnCell(ActionToDo.ITEM, ActionToDo.TO)
				moveTowardCell(cell)
			} else {
				if (WalkClass.TELEPORTATION && WalkClass.TELEPORTATION[cell] != null) {
					debugW("Need Tele")
				} else {
					if (WalkClass.TELEPORTATION_AND_JUMP && WalkClass.TELEPORTATION_AND_JUMP[cell] != null) {
						debugW("Need Tele And Jump")
					} else {
						debugE("Error can't reach cell : "+cell+" i am on cell :"+EveryStats[Me].CELL+" and i have :"+EveryStats[Me].MP+" mps")
					}
				}
			}
		}
	}

	static getActionsToGetWithJump(from, to, AccesMpJump, AccesMpWalk) {
		var TmpCell = to
		var _final = []
		while (TmpCell != from) {
			var HasWalked = false
			var ActionFound = false
			for (var Neighbour:var dist in ALLCELLINFO[TmpCell].CIRCLE_ONE_DIST) {
				if (Neighbour == TmpCell) continue
				if (AccesMpJump[Neighbour]!=null && AccesMpJump[Neighbour] < AccesMpJump[TmpCell]) {
					TmpCell = Neighbour
					HasWalked = true
				}
			}
			if (!HasWalked) {//I need to jump here
				for (var Neighbour:var dist in ALLCELLINFO[TmpCell].CIRCLE_THREE_DIST) {
					if (AccesMpWalk[Neighbour] != null && AccesMpWalk[Neighbour] <= AccesMpJump[TmpCell]) {
						push(_final, new Action(CHIP_JUMP, Neighbour, TmpCell))
						ActionFound = true
						break
					}
				}
			}
			if (ActionFound) break
		}
		return _final
	}

	static getActionsToGetWithTeleportation(cell, AccesMpTeleportation, AccesMpWalk) { //TODO

	}

	static getActionsToGetWithTeleportationAndJump(cell, AccesMpTeleportationAndJump, AccesMpTeleportation, AccesMpJump, AccesMpWalk) { //TODO

	}

	static WalkableCells(from, leekcells, mp) {
		InitObstacles(OBSTACLES_ARRAY)
		InitLeekCells(leekcells)
		InitBuildAcc(from)
		InitAccesMp()
		var acces = getAccesible(mp)
		return getAccess()
	}

	static WalkableCellsWithJump(from, leekcells, mp) {
		InitObstacles(OBSTACLES_ARRAY)
		InitLeekCells(leekcells)
		InitBuildAccJ(from)
		InitAccesMpJ()
		var acces = getAccesibleJ(mp)
		return getAccessJ()
	}

	static WalkableCellsWithTeleportation(from, leekcells, mp) {
		InitObstacles(OBSTACLES_ARRAY)
		InitLeekCells(leekcells)
		InitBuildAccT(from)
		InitAccesMpT()
		var acces = getAccesibleT(mp)
		return getAccessT()
	}
	
	static WalkableCellsWithTeleportationAndJump(from, leekcells, mp) {//TMP Commented to edit IA less laggy

	}

	static LoadIgnoreCells(EveryStats, EntityToBeIgnored, BaseHash) {
		if (BaseHash in IGNORE_CELLLS_CACHE) return IGNORE_CELLLS_CACHE[BaseHash]
		var _final = []
		for (var e: var stat in EveryStats) {
			if (stat.LIFE > 0 && e != EntityToBeIgnored) push(_final, stat.CELL)
		}
		IGNORE_CELLLS_CACHE[BaseHash] = _final
		return _final
	}
	/*
	static IgnoreCellsToMap(IgnoreCells) {
		var _final = [: ]
		for (var c in IgnoreCells) {
			_final[c] = true
		}
		return _final
	}

	static HashIgnoreCells(IgnoreCells) {
		var HashValue = 0
		for (var c in IgnoreCells) {
			HashValue = HashValue * MAX_CELL + c // Then we add the IgnoreCells Values
		}
		return HashValue
	}*/
}

function CellToLine(cell) { //Used Only In Init
	var couple = floor(cell / 35) // Couple de ligne
	var c = cell % 35 // position de x dans le couple de ligne
	var line = c >= 18 ? 1 : 0 // dans la ligne 1 ou 2 ?
	var l = couple * 2 + line // Numero de ligne
	return l
}

function CellToPos(cell) { //Used Only In Init
	var c = cell % 35 // position de x dans le couple de ligne
	var line = c >= 18 ? 1 : 0 // dans la ligne 1 ou 2 ?
	var pos = c - (18 * line) // Position de x dans la ligne
	return pos
}

