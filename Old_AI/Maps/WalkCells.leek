	}

	for (var bin: var mp in ACCESMPFive) {
		for (var c in BINARY_TO_CELL_FIVE_ZERO[(bin & 63)] + BINARY_TO_CELL_FIVE_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_FIVE_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPSix) {
		for (var c in BINARY_TO_CELL_SIX_ZERO[(bin & 63)] + BINARY_TO_CELL_SIX_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_SIX_TWO[bin >> 12]) {
