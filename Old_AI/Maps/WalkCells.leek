	}

	for (var bin: var mp in ACCESMPFour) {
		for (var c in BINARY_TO_CELL_FOUR_ZERO[(bin & 63)] + BINARY_TO_CELL_FOUR_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_FOUR_TWO[bin >> 12]) {
			_final[c] = mp
