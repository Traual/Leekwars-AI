	}
}

function InitLeekCells(LeekCells) { //on met sur la bitmap d'obstacles les positions des entitées
	for (var x in LeekCells) {
		obstacleFunctions[MAP_CELL_TO_LINE[x]](MAP_CELL_TO_POS[x])
	}
}


