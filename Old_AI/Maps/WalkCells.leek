		for (var c in BINARY_TO_CELL_SEVENTEEN_ZERO[(bin & 63)] + BINARY_TO_CELL_SEVENTEEN_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_SEVENTEEN_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTEighteen) {
		for (var c in BINARY_TO_CELL_EIGHTEEN_ZERO[(bin & 63)] + BINARY_TO_CELL_EIGHTEEN_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_EIGHTEEN_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTNineteen) {
		for (var c in BINARY_TO_CELL_NINETEEN_ZERO[(bin & 63)] + BINARY_TO_CELL_NINETEEN_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_NINETEEN_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTTwenty) {
		for (var c in BINARY_TO_CELL_TWENTY_ZERO[(bin & 63)] + BINARY_TO_CELL_TWENTY_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_TWENTY_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTTwentyOne) {
		for (var c in BINARY_TO_CELL_TWENTYONE_ZERO[(bin & 63)] + BINARY_TO_CELL_TWENTYONE_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_TWENTYONE_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTTwentyTwo) {
		for (var c in BINARY_TO_CELL_TWENTYTWO_ZERO[(bin & 63)] + BINARY_TO_CELL_TWENTYTWO_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_TWENTYTWO_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTTwentyThree) {
		for (var c in BINARY_TO_CELL_TWENTYTHREE_ZERO[(bin & 63)] + BINARY_TO_CELL_TWENTYTHREE_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_TWENTYTHREE_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTTwentyFour) {
		for (var c in BINARY_TO_CELL_TWENTYFOUR_ZERO[(bin & 63)] + BINARY_TO_CELL_TWENTYFOUR_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_TWENTYFOUR_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTTwentyFive) {
		for (var c in BINARY_TO_CELL_TWENTYFIVE_ZERO[(bin & 63)] + BINARY_TO_CELL_TWENTYFIVE_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_TWENTYFIVE_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTTwentySix) {
		for (var c in BINARY_TO_CELL_TWENTYSIX_ZERO[(bin & 63)] + BINARY_TO_CELL_TWENTYSIX_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_TWENTYSIX_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTTwentySeven) {
		for (var c in BINARY_TO_CELL_TWENTYSEVEN_ZERO[(bin & 63)] + BINARY_TO_CELL_TWENTYSEVEN_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_TWENTYSEVEN_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTTwentyEight) {
		for (var c in BINARY_TO_CELL_TWENTYEIGHT_ZERO[(bin & 63)] + BINARY_TO_CELL_TWENTYEIGHT_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_TWENTYEIGHT_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}
	for (var bin: var mp in ACCESMPTTwentyNine) {
		for (var c in BINARY_TO_CELL_TWENTYNINE_ZERO[(bin & 63)] + BINARY_TO_CELL_TWENTYNINE_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_TWENTYNINE_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTThirty) {
		for (var c in BINARY_TO_CELL_THIRTY_ZERO[(bin & 63)] + BINARY_TO_CELL_THIRTY_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_THIRTY_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTThirtyOne) {
		for (var c in BINARY_TO_CELL_THIRTYONE_ZERO[(bin & 63)] + BINARY_TO_CELL_THIRTYONE_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_THIRTYONE_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTThirtyTwo) {
		for (var c in BINARY_TO_CELL_THIRTYTWO_ZERO[(bin & 63)] + BINARY_TO_CELL_THIRTYTWO_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_THIRTYTWO_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTThirtyThree) {
		for (var c in BINARY_TO_CELL_THIRTYTHREE_ZERO[(bin & 63)] + BINARY_TO_CELL_THIRTYTHREE_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_THIRTYTHREE_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTThirtyFour) {
		for (var c in BINARY_TO_CELL_THIRTYFOUR_ZERO[(bin & 63)] + BINARY_TO_CELL_THIRTYFOUR_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_THIRTYFOUR_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}
	return _final
}

function getAccesible(mp) {
	//On Sauvegarde la case accessible de base : 
	SaveBaseAccessibles()
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC() //On Propage ACC et on save les Mp
		SaveAccesMpFromTmp(m) //On save les mp de TMP avant que ACC soit update
		UpdateAccFromTmp() //On Save le nouvel ACC (qui est tmp actuellement)
	}
}

function getAccesibleJ(mp) {
	UpdateShiftedForJump()
	TotalJumpToTMPJFromACC()
	SaveAccesMpJFromTmpJ(0)
	UpdateAccJFromTmpJ() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC() //On Propage ACC et on save les Mp
		UpdateAccFromTmp() //On Save le nouvel ACC (qui est tmp actuellement)
		UpdateShiftedForJump() //On Save les nouveaux Shifts d'ACC
		WalkOneInACCJ() //On Propage ACCJ avec une action de marche 
		SaveAccesMpJFromTmpJ(m) //On save les mp de TMPJ avant que ACCJ soit update
		UpdateAccJFromTmpJ() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
		OnlyMaxJumpToTMPJFromACC() //On Propage ACCJ avec une action de saut
		SaveAccesMpJFromTmpJ(m) //On save les mp de TMPJ avant que ACCJ soit update
		UpdateAccJFromTmpJ() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
	}
}

function getAccesibleJOpti(mp) { //Only Jumps from BaseCell (Not Used)
	UpdateShiftedForJump()
	TotalJumpToTMPJFromACC()
	SaveAccesMpJFromTmpJ(0)
	UpdateAccJFromTmpJ() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
	for (var m = 1; m <= mp; m++) {
		WalkOneInACCJ() //On Propage ACCJ avec une action de marche 
		SaveAccesMpJFromTmpJ(m) //On save les mp de TMPJ avant que ACCJ soit update
		UpdateAccJFromTmpJ() //On Save le nouvel ACCJ (qui est tmpJ actuellement)
	}
}

function getAccesibleT(mp) {
	UpdateShiftedForTeleportation()
	TotalTeleportationToTMPTFromACC()
	SaveAccesMpTFromTmpT(0)
	UpdateAccTFromTmpT() //On Save le nouvel ACCT (qui est tmpT actuellement)
	for (var m = 1; m <= mp; m++) {
		WalkOneInACC() //On Propage ACC et on save les Mp
		UpdateAccFromTmp() //On Save le nouvel ACC (qui est tmp actuellement)
		UpdateShiftedForTeleportation() //On Save les nouveaux Shifts d'ACC
		WalkOneInACCT() //On Propage ACCT avec une action de marche 
		SaveAccesMpTFromTmpT(m) //On save les mp de TMPT avant que ACCT soit update
		UpdateAccTFromTmpT() //On Save le nouvel ACCT (qui est tmpT actuellement)
		OnlyMaxTeleportationToTMPTFromACC() //On Propage ACCT avec une action de saut
		SaveAccesMpTFromTmpT(m) //On save les mp de TMPT avant que ACCT soit update
		UpdateAccTFromTmpT() //On Save le nouvel ACCT (qui est tmpT actuellement)
	}
}

