function WalkOneInACC() {
	//On Propage les cases sur la bitmap :
	TMPZero = ACCZero | (ACCOne | (ACCOne << 1)) & MAP_OBSTACLES_ZERO

	TMPOne = ACCOne | (ACCZero | ACCTwo | (ACCZero >> 1) | (ACCTwo >> 1)) & MAP_OBSTACLES_ONE

	TMPTwo = ACCTwo | (ACCOne | ACCThree | (ACCOne << 1) | (ACCThree << 1)) & MAP_OBSTACLES_TWO

	TMPThree = ACCThree | (ACCTwo | ACCFour | (ACCTwo >> 1) | (ACCFour >> 1)) & MAP_OBSTACLES_THREE

	TMPFour = ACCFour | (ACCThree | ACCFive | (ACCThree << 1) | (ACCFive << 1)) & MAP_OBSTACLES_FOUR

	TMPFive = ACCFive | (ACCFour | ACCSix | (ACCFour >> 1) | (ACCSix >> 1)) & MAP_OBSTACLES_FIVE

	TMPSix = ACCSix | (ACCFive | ACCSeven | (ACCFive << 1) | (ACCSeven << 1)) & MAP_OBSTACLES_SIX

	TMPSeven = ACCSeven | (ACCSix | ACCEight | (ACCSix >> 1) | (ACCEight >> 1)) & MAP_OBSTACLES_SEVEN

	TMPEight = ACCEight | (ACCSeven | ACCNine | (ACCSeven << 1) | (ACCNine << 1)) & MAP_OBSTACLES_EIGHT

	TMPNine = ACCNine | (ACCEight | ACCTen | (ACCEight >> 1) | (ACCTen >> 1)) & MAP_OBSTACLES_NINE

	TMPTen = ACCTen | (ACCNine | ACCEleven | (ACCNine << 1) | (ACCEleven << 1)) & MAP_OBSTACLES_TEN

	TMPEleven = ACCEleven | (ACCTen | ACCTwelve | (ACCTen >> 1) | (ACCTwelve >> 1)) & MAP_OBSTACLES_ELEVEN

	TMPTwelve = ACCTwelve | (ACCEleven | ACCThirteen | (ACCEleven << 1) | (ACCThirteen << 1)) & MAP_OBSTACLES_TWELVE

	TMPThirteen = ACCThirteen | (ACCTwelve | ACCFourteen | (ACCTwelve >> 1) | (ACCFourteen >> 1)) & MAP_OBSTACLES_THIRTEEN

	TMPFourteen = ACCFourteen | (ACCThirteen | ACCFifteen | (ACCThirteen << 1) | (ACCFifteen << 1)) & MAP_OBSTACLES_FOURTEEN

	TMPFifteen = ACCFifteen | (ACCFourteen | ACCSixteen | (ACCFourteen >> 1) | (ACCSixteen >> 1)) & MAP_OBSTACLES_FIFTEEN

	TMPSixteen = ACCSixteen | (ACCFifteen | ACCSeventeen | (ACCFifteen << 1) | (ACCSeventeen << 1)) & MAP_OBSTACLES_SIXTEEN

	TMPSeventeen = ACCSeventeen | (ACCSixteen | ACCEighteen | (ACCSixteen >> 1) | (ACCEighteen >> 1)) & MAP_OBSTACLES_SEVENTEEN

	TMPEighteen = ACCEighteen | (ACCSeventeen | ACCNineteen | (ACCSeventeen << 1) | (ACCNineteen << 1)) & MAP_OBSTACLES_EIGHTEEN

	TMPNineteen = ACCNineteen | (ACCEighteen | ACCTwenty | (ACCEighteen >> 1) | (ACCTwenty >> 1)) & MAP_OBSTACLES_NINETEEN

	TMPTwenty = ACCTwenty | (ACCNineteen | ACCTwentyOne | (ACCNineteen << 1) | (ACCTwentyOne << 1)) & MAP_OBSTACLES_TWENTY

	TMPTwentyOne = ACCTwentyOne | (ACCTwenty | ACCTwentyTwo | (ACCTwenty >> 1) | (ACCTwentyTwo >> 1)) & MAP_OBSTACLES_TWENTYONE

	TMPTwentyTwo = ACCTwentyTwo | (ACCTwentyOne | ACCTwentyThree | (ACCTwentyOne << 1) | (ACCTwentyThree << 1)) & MAP_OBSTACLES_TWENTYTWO

	TMPTwentyThree = ACCTwentyThree | (ACCTwentyTwo | ACCTwentyFour | (ACCTwentyTwo >> 1) | (ACCTwentyFour >> 1)) & MAP_OBSTACLES_TWENTYTHREE

	TMPTwentyFour = ACCTwentyFour | (ACCTwentyThree | ACCTwentyFive | (ACCTwentyThree << 1) | (ACCTwentyFive << 1)) & MAP_OBSTACLES_TWENTYFOUR

	TMPTwentyFive = ACCTwentyFive | (ACCTwentyFour | ACCTwentySix | (ACCTwentyFour >> 1) | (ACCTwentySix >> 1)) & MAP_OBSTACLES_TWENTYFIVE

	TMPTwentySix = ACCTwentySix | (ACCTwentyFive | ACCTwentySeven | (ACCTwentyFive << 1) | (ACCTwentySeven << 1)) & MAP_OBSTACLES_TWENTYSIX

	TMPTwentySeven = ACCTwentySeven | (ACCTwentySix | ACCTwentyEight | (ACCTwentySix >> 1) | (ACCTwentyEight >> 1)) & MAP_OBSTACLES_TWENTYSEVEN

	TMPTwentyEight = ACCTwentyEight | (ACCTwentySeven | ACCTwentyNine | (ACCTwentySeven << 1) | (ACCTwentyNine << 1)) & MAP_OBSTACLES_TWENTYEIGHT

	TMPTwentyNine = ACCTwentyNine | (ACCTwentyEight | ACCThirty | (ACCTwentyEight >> 1) | (ACCThirty >> 1)) & MAP_OBSTACLES_TWENTYNINE

	TMPThirty = ACCThirty | (ACCTwentyNine | ACCThirtyOne | (ACCTwentyNine << 1) | (ACCThirtyOne << 1)) & MAP_OBSTACLES_THIRTY

	TMPThirtyOne = ACCThirtyOne | (ACCThirty | ACCThirtyTwo | (ACCThirty >> 1) | (ACCThirtyTwo >> 1)) & MAP_OBSTACLES_THIRTYONE

	TMPThirtyTwo = ACCThirtyTwo | (ACCThirtyOne | ACCThirtyThree | (ACCThirtyOne << 1) | (ACCThirtyThree << 1)) & MAP_OBSTACLES_THIRTYTWO

	TMPThirtyThree = ACCThirtyThree | (ACCThirtyTwo | ACCThirtyFour | (ACCThirtyTwo >> 1) | (ACCThirtyFour >> 1)) & MAP_OBSTACLES_THIRTYTHREE

	TMPThirtyFour = ACCThirtyFour | (ACCThirtyThree | (ACCThirtyThree << 1)) & MAP_OBSTACLES_THIRTYFOUR
}

function WalkOneInACCJ() {
	//On Propage les cases sur la bitmap :
	TMPJZero = ACCJZero | (ACCJOne | (ACCJOne << 1)) & MAP_OBSTACLES_ZERO

	TMPJOne = ACCJOne | (ACCJZero | ACCJTwo | (ACCJZero >> 1) | (ACCJTwo >> 1)) & MAP_OBSTACLES_ONE

	TMPJTwo = ACCJTwo | (ACCJOne | ACCJThree | (ACCJOne << 1) | (ACCJThree << 1)) & MAP_OBSTACLES_TWO

	TMPJThree = ACCJThree | (ACCJTwo | ACCJFour | (ACCJTwo >> 1) | (ACCJFour >> 1)) & MAP_OBSTACLES_THREE

	TMPJFour = ACCJFour | (ACCJThree | ACCJFive | (ACCJThree << 1) | (ACCJFive << 1)) & MAP_OBSTACLES_FOUR

	TMPJFive = ACCJFive | (ACCJFour | ACCJSix | (ACCJFour >> 1) | (ACCJSix >> 1)) & MAP_OBSTACLES_FIVE

	TMPJSix = ACCJSix | (ACCJFive | ACCJSeven | (ACCJFive << 1) | (ACCJSeven << 1)) & MAP_OBSTACLES_SIX

	TMPJSeven = ACCJSeven | (ACCJSix | ACCJEight | (ACCJSix >> 1) | (ACCJEight >> 1)) & MAP_OBSTACLES_SEVEN

	TMPJEight = ACCJEight | (ACCJSeven | ACCJNine | (ACCJSeven << 1) | (ACCJNine << 1)) & MAP_OBSTACLES_EIGHT

	TMPJNine = ACCJNine | (ACCJEight | ACCJTen | (ACCJEight >> 1) | (ACCJTen >> 1)) & MAP_OBSTACLES_NINE

	TMPJTen = ACCJTen | (ACCJNine | ACCJEleven | (ACCJNine << 1) | (ACCJEleven << 1)) & MAP_OBSTACLES_TEN

	TMPJEleven = ACCJEleven | (ACCJTen | ACCJTwelve | (ACCJTen >> 1) | (ACCJTwelve >> 1)) & MAP_OBSTACLES_ELEVEN

	TMPJTwelve = ACCJTwelve | (ACCJEleven | ACCJThirteen | (ACCJEleven << 1) | (ACCJThirteen << 1)) & MAP_OBSTACLES_TWELVE

	TMPJThirteen = ACCJThirteen | (ACCJTwelve | ACCJFourteen | (ACCJTwelve >> 1) | (ACCJFourteen >> 1)) & MAP_OBSTACLES_THIRTEEN

	TMPJFourteen = ACCJFourteen | (ACCJThirteen | ACCJFifteen | (ACCJThirteen << 1) | (ACCJFifteen << 1)) & MAP_OBSTACLES_FOURTEEN

	TMPJFifteen = ACCJFifteen | (ACCJFourteen | ACCJSixteen | (ACCJFourteen >> 1) | (ACCJSixteen >> 1)) & MAP_OBSTACLES_FIFTEEN

	TMPJSixteen = ACCJSixteen | (ACCJFifteen | ACCJSeventeen | (ACCJFifteen << 1) | (ACCJSeventeen << 1)) & MAP_OBSTACLES_SIXTEEN

	TMPJSeventeen = ACCJSeventeen | (ACCJSixteen | ACCJEighteen | (ACCJSixteen >> 1) | (ACCJEighteen >> 1)) & MAP_OBSTACLES_SEVENTEEN

	TMPJEighteen = ACCJEighteen | (ACCJSeventeen | ACCJNineteen | (ACCJSeventeen << 1) | (ACCJNineteen << 1)) & MAP_OBSTACLES_EIGHTEEN

	TMPJNineteen = ACCJNineteen | (ACCJEighteen | ACCJTwenty | (ACCJEighteen >> 1) | (ACCJTwenty >> 1)) & MAP_OBSTACLES_NINETEEN

	TMPJTwenty = ACCJTwenty | (ACCJNineteen | ACCJTwentyOne | (ACCJNineteen << 1) | (ACCJTwentyOne << 1)) & MAP_OBSTACLES_TWENTY

	TMPJTwentyOne = ACCJTwentyOne | (ACCJTwenty | ACCJTwentyTwo | (ACCJTwenty >> 1) | (ACCJTwentyTwo >> 1)) & MAP_OBSTACLES_TWENTYONE

	TMPJTwentyTwo = ACCJTwentyTwo | (ACCJTwentyOne | ACCJTwentyThree | (ACCJTwentyOne << 1) | (ACCJTwentyThree << 1)) & MAP_OBSTACLES_TWENTYTWO

	TMPJTwentyThree = ACCJTwentyThree | (ACCJTwentyTwo | ACCJTwentyFour | (ACCJTwentyTwo >> 1) | (ACCJTwentyFour >> 1)) & MAP_OBSTACLES_TWENTYTHREE

	TMPJTwentyFour = ACCJTwentyFour | (ACCJTwentyThree | ACCJTwentyFive | (ACCJTwentyThree << 1) | (ACCJTwentyFive << 1)) & MAP_OBSTACLES_TWENTYFOUR

	TMPJTwentyFive = ACCJTwentyFive | (ACCJTwentyFour | ACCJTwentySix | (ACCJTwentyFour >> 1) | (ACCJTwentySix >> 1)) & MAP_OBSTACLES_TWENTYFIVE

	TMPJTwentySix = ACCJTwentySix | (ACCJTwentyFive | ACCJTwentySeven | (ACCJTwentyFive << 1) | (ACCJTwentySeven << 1)) & MAP_OBSTACLES_TWENTYSIX

	TMPJTwentySeven = ACCJTwentySeven | (ACCJTwentySix | ACCJTwentyEight | (ACCJTwentySix >> 1) | (ACCJTwentyEight >> 1)) & MAP_OBSTACLES_TWENTYSEVEN

	TMPJTwentyEight = ACCJTwentyEight | (ACCJTwentySeven | ACCJTwentyNine | (ACCJTwentySeven << 1) | (ACCJTwentyNine << 1)) & MAP_OBSTACLES_TWENTYEIGHT

	TMPJTwentyNine = ACCJTwentyNine | (ACCJTwentyEight | ACCJThirty | (ACCJTwentyEight >> 1) | (ACCJThirty >> 1)) & MAP_OBSTACLES_TWENTYNINE

	TMPJThirty = ACCJThirty | (ACCJTwentyNine | ACCJThirtyOne | (ACCJTwentyNine << 1) | (ACCJThirtyOne << 1)) & MAP_OBSTACLES_THIRTY

	TMPJThirtyOne = ACCJThirtyOne | (ACCJThirty | ACCJThirtyTwo | (ACCJThirty >> 1) | (ACCJThirtyTwo >> 1)) & MAP_OBSTACLES_THIRTYONE

	TMPJThirtyTwo = ACCJThirtyTwo | (ACCJThirtyOne | ACCJThirtyThree | (ACCJThirtyOne << 1) | (ACCJThirtyThree << 1)) & MAP_OBSTACLES_THIRTYTWO

	TMPJThirtyThree = ACCJThirtyThree | (ACCJThirtyTwo | ACCJThirtyFour | (ACCJThirtyTwo >> 1) | (ACCJThirtyFour >> 1)) & MAP_OBSTACLES_THIRTYTHREE

	TMPJThirtyFour = ACCJThirtyFour | (ACCJThirtyThree | (ACCJThirtyThree << 1)) & MAP_OBSTACLES_THIRTYFOUR
}

function WalkOneInACCT() {
	// On propage les cases sur la bitmap :
	TMPTZero = ACCTZero | (ACCTOne | (ACCTOne << 1)) & MAP_OBSTACLES_ZERO

	TMPTOne = ACCTOne | (ACCTZero | ACCTTwo | (ACCTZero >> 1) | (ACCTTwo >> 1)) & MAP_OBSTACLES_ONE

	TMPTTwo = ACCTTwo | (ACCTOne | ACCTThree | (ACCTOne << 1) | (ACCTThree << 1)) & MAP_OBSTACLES_TWO

	TMPTThree = ACCTThree | (ACCTTwo | ACCTFour | (ACCTTwo >> 1) | (ACCTFour >> 1)) & MAP_OBSTACLES_THREE

	TMPTFour = ACCTFour | (ACCTThree | ACCTFive | (ACCTThree << 1) | (ACCTFive << 1)) & MAP_OBSTACLES_FOUR

	TMPTFive = ACCTFive | (ACCTFour | ACCTSix | (ACCTFour >> 1) | (ACCTSix >> 1)) & MAP_OBSTACLES_FIVE

	TMPTSix = ACCTSix | (ACCTFive | ACCTSeven | (ACCTFive << 1) | (ACCTSeven << 1)) & MAP_OBSTACLES_SIX

	TMPTSeven = ACCTSeven | (ACCTSix | ACCTEight | (ACCTSix >> 1) | (ACCTEight >> 1)) & MAP_OBSTACLES_SEVEN

	TMPTEight = ACCTEight | (ACCTSeven | ACCTNine | (ACCTSeven << 1) | (ACCTNine << 1)) & MAP_OBSTACLES_EIGHT

	TMPTNine = ACCTNine | (ACCTEight | ACCTTen | (ACCTEight >> 1) | (ACCTTen >> 1)) & MAP_OBSTACLES_NINE

	TMPTTen = ACCTTen | (ACCTNine | ACCTEleven | (ACCTNine << 1) | (ACCTEleven << 1)) & MAP_OBSTACLES_TEN

	TMPTEleven = ACCTEleven | (ACCTTen | ACCTTwelve | (ACCTTen >> 1) | (ACCTTwelve >> 1)) & MAP_OBSTACLES_ELEVEN

	TMPTTwelve = ACCTTwelve | (ACCTEleven | ACCTThirteen | (ACCTEleven << 1) | (ACCTThirteen << 1)) & MAP_OBSTACLES_TWELVE

	TMPTThirteen = ACCTThirteen | (ACCTTwelve | ACCTFourteen | (ACCTTwelve >> 1) | (ACCTFourteen >> 1)) & MAP_OBSTACLES_THIRTEEN

	TMPTFourteen = ACCTFourteen | (ACCTThirteen | ACCTFifteen | (ACCTThirteen << 1) | (ACCTFifteen << 1)) & MAP_OBSTACLES_FOURTEEN

	TMPTFifteen = ACCTFifteen | (ACCTFourteen | ACCTSixteen | (ACCTFourteen >> 1) | (ACCTSixteen >> 1)) & MAP_OBSTACLES_FIFTEEN

	TMPTSixteen = ACCTSixteen | (ACCTFifteen | ACCTSeventeen | (ACCTFifteen << 1) | (ACCTSeventeen << 1)) & MAP_OBSTACLES_SIXTEEN

	TMPTSeventeen = ACCTSeventeen | (ACCTSixteen | ACCTEighteen | (ACCTSixteen >> 1) | (ACCTEighteen >> 1)) & MAP_OBSTACLES_SEVENTEEN

	TMPTEighteen = ACCTEighteen | (ACCTSeventeen | ACCTNineteen | (ACCTSeventeen << 1) | (ACCTNineteen << 1)) & MAP_OBSTACLES_EIGHTEEN

	TMPTNineteen = ACCTNineteen | (ACCTEighteen | ACCTTwenty | (ACCTEighteen >> 1) | (ACCTwenty >> 1)) & MAP_OBSTACLES_NINETEEN

	TMPTTwenty = ACCTTwenty | (ACCTNineteen | ACCTTwentyOne | (ACCTNineteen << 1) | (ACCTTwentyOne << 1)) & MAP_OBSTACLES_TWENTY

	TMPTTwentyOne = ACCTTwentyOne | (ACCTTwenty | ACCTTwentyTwo | (ACCTTwenty >> 1) | (ACCTTwentyTwo >> 1)) & MAP_OBSTACLES_TWENTYONE

	TMPTTwentyTwo = ACCTTwentyTwo | (ACCTTwentyOne | ACCTTwentyThree | (ACCTTwentyOne << 1) | (ACCTTwentyThree << 1)) & MAP_OBSTACLES_TWENTYTWO

	TMPTTwentyThree = ACCTTwentyThree | (ACCTTwentyTwo | ACCTTwentyFour | (ACCTTwentyTwo >> 1) | (ACCTTwentyFour >> 1)) & MAP_OBSTACLES_TWENTYTHREE

	TMPTTwentyFour = ACCTTwentyFour | (ACCTTwentyThree | ACCTTwentyFive | (ACCTTwentyThree << 1) | (ACCTTwentyFive << 1)) & MAP_OBSTACLES_TWENTYFOUR

	TMPTTwentyFive = ACCTTwentyFive | (ACCTTwentyFour | ACCTTwentySix | (ACCTTwentyFour >> 1) | (ACCTTwentySix >> 1)) & MAP_OBSTACLES_TWENTYFIVE

	TMPTTwentySix = ACCTTwentySix | (ACCTTwentyFive | ACCTTwentySeven | (ACCTTwentyFive << 1) | (ACCTTwentySeven << 1)) & MAP_OBSTACLES_TWENTYSIX

	TMPTTwentySeven = ACCTTwentySeven | (ACCTTwentySix | ACCTTwentyEight | (ACCTTwentySix >> 1) | (ACCTTwentyEight >> 1)) & MAP_OBSTACLES_TWENTYSEVEN

	TMPTTwentyEight = ACCTTwentyEight | (ACCTTwentySeven | ACCTTwentyNine | (ACCTTwentySeven << 1) | (ACCTTwentyNine << 1)) & MAP_OBSTACLES_TWENTYEIGHT

	TMPTTwentyNine = ACCTTwentyNine | (ACCTTwentyEight | ACCTThirty | (ACCTTwentyEight >> 1) | (ACCTThirty >> 1)) & MAP_OBSTACLES_TWENTYNINE

	TMPTThirty = ACCTThirty | (ACCTTwentyNine | ACCTThirtyOne | (ACCTTwentyNine << 1) | (ACCTThirtyOne << 1)) & MAP_OBSTACLES_THIRTY

	TMPTThirtyOne = ACCTThirtyOne | (ACCTThirty | ACCTThirtyTwo | (ACCTThirty >> 1) | (ACCTThirtyTwo >> 1)) & MAP_OBSTACLES_THIRTYONE

	TMPTThirtyTwo = ACCTThirtyTwo | (ACCTThirtyOne | ACCTThirtyThree | (ACCTThirtyOne << 1) | (ACCTThirtyThree << 1)) & MAP_OBSTACLES_THIRTYTWO

	TMPTThirtyThree = ACCTThirtyThree | (ACCTThirtyTwo | ACCTThirtyFour | (ACCTThirtyTwo >> 1) | (ACCTThirtyFour >> 1)) & MAP_OBSTACLES_THIRTYTHREE

	TMPTThirtyFour = ACCTThirtyFour | (ACCTThirtyThree | (ACCTThirtyThree << 1)) & MAP_OBSTACLES_THIRTYFOUR
}

