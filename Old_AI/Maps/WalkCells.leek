function getAccess() { //Pour chaque ligne, on coupe le nombre binaire en 3 parties de 6 bits, puis on décode a l'aide des tables les 6 bits --> un tableau des cellules. Et ensuite on les ajoute a _final pour le bon nombre de mp
	var _final = [: ]
	for (var bin: var mp in ACCESMPZero) {
		for (var c in BINARY_TO_CELL_ZERO_ZERO[(bin & 63)] + BINARY_TO_CELL_ZERO_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_ZERO_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPOne) {
		for (var c in BINARY_TO_CELL_ONE_ZERO[(bin & 63)] + BINARY_TO_CELL_ONE_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_ONE_TWO[bin >> 12]) {
			_final[c] = mp
		}
	}

	for (var bin: var mp in ACCESMPTwo) {
		for (var c in BINARY_TO_CELL_TWO_ZERO[(bin & 63)] + BINARY_TO_CELL_TWO_ONE[(bin & 4032) >> 6] + BINARY_TO_CELL_TWO_TWO[bin >> 12]) {
