/**
 * This is a map of gravity, i'm attracted by leeks / some obstacles to see were i want to go at the end of the turn (next to my bulbs and near the enemy)
 **/

include("../includes.leek")

class Gravity {
	/* Returns a gravity score map with covid (score of closeness to allies / enemies / center of map with locked cells (me or enemy) and covid cells)
    *
	* @param MyWalkCells Map of Walkable cells (cell : mp)
	* @param EveryStats Map of Stats Class (id : stats)
	* @param BaseHash : Hash of Id and Cell
    *
    * @return Map <Cell: Score>
    */

	static getFullGravityMap(MyWalkCells, EveryStats, CovidValue, BaseHash) {
		//First i seek for cache
		var Hash = HashGravityWithCovid(EveryStats[Me], CovidValue, BaseHash)
		if (Hash in GRAVITY_WITH_COVID_CACHE) return GRAVITY_WITH_COVID_CACHE[Hash]
		var _final
		if (CovidValue > 0) { //Only if i have a covid effect on me
			//I Start by cloning the actual gravity map (to avoid changing Cache Values)
			var tmp = clone(getGravityMapWithoutCovid(MyWalkCells, EveryStats, BaseHash))
			//Then I Load the covid cells
			var CovidCellsMap = CovidCell.getCovidCells(EveryStats, BaseHash)
			//Then i add the covid score of each cells
			for (var c: var score in tmp) {
				tmp[c] += getCellCovidScore(c, CovidValue, CovidCellsMap)
			}
			//Then i update _final with new values
			_final = tmp
		} else { //If i don't have covid i just return the Gravity map without covid
			_final = getGravityMapWithoutCovid(MyWalkCells, EveryStats, BaseHash)
		}
		GRAVITY_WITH_COVID_CACHE[Hash] = _final
		return _final
	}

	/* Returns a gravity score map without covid (score of closeness to allies / enemies / center of map with locked cells (me or enemy))
    *
	* @param MyWalkCells Map of Walkable cells (cell : mp)
	* @param EveryStats Map of Stats Class (id : stats)
	* @param BaseHash : Hash of Id and Cell
    *
    * @return Map <Cell: Score>
    */

	static getGravityMapWithoutCovid(MyWalkCells, EveryStats, BaseHash) {
		var Hash = HashGravityWithoutCovid(EveryStats[Me], BaseHash)
		if (Hash in GRAVITY_WITHOUT_COVID_CACHE) return GRAVITY_WITHOUT_COVID_CACHE[Hash]
		//For Return
		var _final = [: ]

		//For Locking Cells
		var OccupiedCells = LockCell.loadOccupiedCellsMap(EveryStats, BaseHash)
		var EntityMapLockedCells = LockCell.loadMapEntityLockedCells(EveryStats, OccupiedCells, BaseHash)
		var LockableEntitiesArray = LockCell.loadArrayLockableCells(EveryStats, BaseHash)

		//Then We Load the Map 
		for (var cell:var mp in MyWalkCells) {
			if (OccupiedCells[cell] || TMPOBSTACLES[cell]) continue
			var EntityLocksArray = getEntityLocksForACell(cell, LockableEntitiesArray, BaseHash)
			_final[cell] = getGravityScoreForCellWithoutCovid(cell, EveryStats, EntityMapLockedCells, EntityLocksArray, BaseHash)
		}

		//Then we Cache And Return
		GRAVITY_WITHOUT_COVID_CACHE[Hash] = _final
		return _final
	}

	/* Returns a covid score for a cell (which need to be added to gravity score)
    *
    * @param cell : cell that will be scored
	* @param CovidValue --> Integer : Its the value of Covid on me (0 pretty much everytime), it'll be used to add covid targets to gravity score
	* @param CovidCellsMap --> Map : <Cell : Array> Array of ids of covid targets if i place on Cell
    *
    * @return Integer --> The Gravity Score of cell
    */
	static getCellCovidScore(cell, CovidValue, CovidCellsMap) {

		var _final = 0 //the covid score of the Cell

		//Adding Score :
		if (CovidValue > 0) {
			if (cell in CovidCellsMap) {
				var MyCovidTargets = CovidCellsMap[cell]
				for (var tar in MyCovidTargets) {
					_final += CovidValue * COVID_SCORE_MAP[tar]
				}
			}
		}

		return _final
	}

	/* Returns a gravity score for a cell (score of closeness to allies / enemies / center of map with locked cells (me or enemy))
    *
    * @param cell : cell that will be scored
	* @param EveryStats Map of Stats Class (id : stats)
	* @param EntityMapLockedCells --> Map <Cell : True> of cells locked by entities
	* @param EntityLocksArray --> Array <Id> (entities that i lock on cell "cell")
	* @param BaseHash : Hash of Id and Cell
    *
    * @return Integer --> The Gravity Score of cell
    */
	static getGravityScoreForCellWithoutCovid(cell, EveryStats, EntityMapLockedCells, EntityLocksArray, BaseHash) {
		var Hash = (BaseHash * MAX_CELL) + cell
		if (Hash in GRAVITY_CELL_WITHOUT_COVID_CACHE) return GRAVITY_CELL_WITHOUT_COVID_CACHE[Hash]

		//First we start by adding dist to entities
		var _final = getGravityScoreOnlyDist(cell, EveryStats, ENTITY_GRAVITY_SCORE_MAP, BaseHash)

		//Then Adding Center Dist (On 1 Point, just to separate draws)

		_final += (35 - CellInfo.getDist(cell, 306)) * HOW_MUCH_CENTER_ATTRACT

		//Then Adding Locked Cells :

			//First only Obstacles locked (100% sure locked next turn)

			if (LOCKED_CELLS_OBSTACLES[cell]) _final += LOCKED_OBSTACLES_GRAVITY_SCORE

			//Then Obstacles and entities locked (80% sure locked next turn)

			if (EntityMapLockedCells[cell]) _final += LOCKED_OBSTACLES_AND_ENTITY_GRAVITY_SCORE

			//Then I need to add Scores of Me Locking Someone

			for (var e in EntityLocksArray) _final += LOCKING_ENTITY_SCORE_MAP[e]

		GRAVITY_CELL_WITHOUT_COVID_CACHE[Hash] = _final
		return _final
	}

	/* Returns only the dist score to others. No Cache Cuz it depends on Entity Scoring
    *
    * @param cell : cell that will be scored
	* @param EveryStats Map of Stats Class (id : stats)
	* @param EntityScoring --> Map <Id : Importance in Scoring>
	* @param BaseHash : Hash of Id and Cell
    *
    * @return Integer --> The Gravity Score of cell (based only on dist)
    */
	static getGravityScoreOnlyDist(cell, EveryStats, EntityScoring, BaseHash) {

		var _final = 0 //the final score of the Cell

		//First we start by adding dist to entities
		for (var e:var stat in EveryStats) {
			if (e == Me) continue
			var EntityGravityScore = EntityScoring[e]
			if (EntityGravityScore == 0) continue
			var TmpDist = CellInfo.getDist(stat.CELL, cell)
			if (TmpDist <= 3 && stat.ALLY) {
				_final -= (5 - TmpDist) * EntityGravityScore
			} else {
				_final += (35 - TmpDist) * EntityGravityScore
			}
		}

		return _final
	}

	/* Returns every entities that will be locked if i place on cell (its 0 a lot of time)
    *
    * @param cell : cell that will be scored
	* @param LockableEntitiesArray --> Array <LockCell class> (entities that i can lock)
	* @param BaseHash : Hash of Id and Cell
    *
    * @return Array <entities id> 
    */

	static getEntityLocksForACell(cell, LockableEntitiesArray, BaseHash) {
		if (BaseHash in ENTITY_LOCKS_FOR_A_CELL_CACHE) return ENTITY_LOCKS_FOR_A_CELL_CACHE[BaseHash]
		var _final = []
		for (var LockCellClass in LockableEntitiesArray) {
			if (LockCellClass.CELL_TO_LOCK == cell) {
				push(_final, LockCellClass.ENTITY_ID)
			}
		}
		ENTITY_LOCKS_FOR_A_CELL_CACHE[BaseHash] = _final
		return _final
	}

	/* Returns the value of covid on me TODO : Change for real covid value that will be applied on target
    *
    * @param EntityStats : class stat of entity
    *
    * @return Value <Int> Covid Value 
    */

	static getCovidValue(EntityStats) {
		for (var eff in EntityStats.EFFECTS) {
			if (eff[5] == CHIP_COVID) return eff[1]
		}
		return 0
	}

	/* Returns a sorted array of every gravity cells given in GravMap
    *
    * @param GravMap : Map <Cell : Grav Score>
	* @param MyStats : Stats class of Me
	* @param MyCovidValue : The Covid Value on me that i will pass on targets
	* @param BaseHash : Hash of Id and Cell
    *
    * @return Array <cells> sorted cells by score decreasing (the first one is the best) 
    */

	static sortGravity(GravMap, MyStats, MyCovidValue, BaseHash) {
		var Hash = HashGravityWithCovid(MyStats, MyCovidValue, BaseHash)
		if (Hash in GRAVITY_SORTED_CACHE) return GRAVITY_SORTED_CACHE[Hash]
		//First we push every cells of GravMap into an array
		var ArrayGravityCells = []
		for (var c:var sc in GravMap) {
			push(ArrayGravityCells, c)
		}
		//Then we sort this array
		var _final = arraySort(ArrayGravityCells, function(a, b) {
			return GravMap[b] - GravMap[a]
		})
		//Then cache and return
		GRAVITY_SORTED_CACHE[Hash] = _final
		return _final
	}

	static HashGravityWithCovid(MyStats, MyCovidValue, BaseHash) { //This the hash for caching the sorted gravity cells
		var hash_value = BaseHash
		
		// Adding MyCell and MyMp to Hash
		hash_value = hash_value * (MAX_CELL * MAX_MP) + (MyStats.CELL * MAX_MP) + MyStats.MP
		// Adding Jump Cost To Hash
		var JumpValue = MyStats.TP >= ITEMINFO[CHIP_JUMP].COST && MyStats.COOLDOWNS[CHIP_JUMP] == 0 ? 2 : 1
		//TODO : When I Add Tp i need to add it here too
		hash_value = hash_value * JumpValue

		//Adding Covid :
		hash_value = hash_value * MAX_POISON + MyCovidValue

		return hash_value
	}

	static HashGravityWithoutCovid(MyStats, BaseHash) { //This the hash for caching the sorted gravity cells
		var hash_value = BaseHash
		
		// Adding MyCell and MyMp to Hash
		hash_value = hash_value * (MAX_CELL * MAX_MP) + (MyStats.CELL * MAX_MP) + MyStats.MP
		// Adding Jump Cost To Hash
		var JumpValue = MyStats.TP >= ITEMINFO[CHIP_JUMP].COST && MyStats.COOLDOWNS[CHIP_JUMP] == 0 ? 2 : 1
		//TODO : When I Add Tp i need to add it here too
		hash_value = hash_value * JumpValue

		return hash_value
	}
}