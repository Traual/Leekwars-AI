/**
 * Listing possible actions
 **/

include("../includes.leek")

class Actions {
	//TODO add Shoot allies for lazers to go through
	//TODO : Optimize 
	
	static ToSkipItems = [
		CHIP_TELEPORTATION: true,
		CHIP_JUMP: true
	]

	static SpecialItems = [
		CHIP_RESURRECTION: true,
		CHIP_PUNY_BULB: true,
		CHIP_ROCKY_BULB: true,
		CHIP_ICED_BULB: true,
		CHIP_HEALER_BULB: true,
		CHIP_FIRE_BULB: true,
		CHIP_WIZARD_BULB: true,
		CHIP_METALLIC_BULB: true,
		CHIP_SAVANT_BULB: true,
		CHIP_TACTICIAN_BULB: true,
		CHIP_LIGHTNING_BULB: true
	]

	static getEveryActionsInAState(EveryStats, WalkCellsClass, MyCell,BaseHash) { //If i remove my mps from actions on everyone i could cache with BaseHash and MyCell
		var _final = []
		var LeekCells = Stats.getLeekCells(EveryStats)
		//Adding Actions on Me :
		pushAll(_final, getEveryActionsOnMe(MyCell, MY_INVENTORY_ON_ME, EveryStats))
		//Adding Action On Void : 
		pushAll(_final, getEveryActionsInVoid(MyCell, MY_INVENTORY_ON_VOID, EveryStats, LeekCells, BaseHash))
		//Adding Summon Actions : 
		pushAll(_final, getEverySummonActions(MyCell, MY_INVENTORY_SUMMON, EveryStats, LeekCells, BaseHash))
		var MyStats = EveryStats[Me]
		var MaxDist = CHIP_JUMP in MyStats.COOLDOWNS && MyStats.COOLDOWNS[CHIP_JUMP] == 0 ? MyStats.MP + ITEMINFO[CHIP_JUMP].MAXRANGE : MyStats.MP
		//Adding Actions on EveryOne Else
		pushAll(_final, getEveryActionsOnEveryOne(MyStats.CELL, MY_INVENTORY_ON_EVERYONE, EveryStats, MaxDist, WalkCellsClass, BaseHash))
		//Returning
		return _final
	}

	/* Gives me the list of all cell dependant actions ; actions for exemple on me, or summons ... things that changes when i move a cell, so every actions except for cell independant ones
    *
    * @param EveryStats : Map Id:Stats
    * @param MyCell : My Current Cell
	* @param BaseHash : Hash ID * CELL for each entities
    *
    * @return Array : Possibles actions Cell Dependant
    */

	static getActionsCellDependant(EveryStats, MyCell, BaseHash) {
		Benchmark.ActionsCellsDependantStart()
		var _final = []
		var LeekCells = Stats.getLeekCells(EveryStats)
		pushAll(_final, getEveryActionsOnMe(MyCell, MY_INVENTORY_ON_ME, EveryStats))
		//Adding Action On Void : 
		pushAll(_final, getEveryActionsInVoid(MyCell, MY_INVENTORY_ON_VOID, EveryStats, LeekCells, BaseHash))
		//Adding Summon Actions : 
		pushAll(_final, getEverySummonActions(MyCell, MY_INVENTORY_SUMMON, EveryStats, LeekCells, BaseHash))
		Benchmark.ActionsCellsDependantStop()
		return _final
	}

	/* Gives me the list of all cell independant actions ; actions on everyone else then me, things that doesn't changes when i move a cell, so every actions except for cell dependant ones
    *
    * @param EveryStats : Map Id:Stats
    * @param MyCell : My Current Cell
	* @param BaseHash : Hash ID * CELL for each entities
    *
    * @return Array : Possibles actions Cell Independant
    */

	static getActionsCellIndependant(EveryStats, WalkCellsClass,  BaseHash) {
		Benchmark.ActionsCellsIndependantStart()
		var MyStats = EveryStats[Me]
		var MaxDist = CHIP_JUMP in MyStats.COOLDOWNS && MyStats.COOLDOWNS[CHIP_JUMP] == 0 ? MyStats.MP + ITEMINFO[CHIP_JUMP].MAXRANGE : MyStats.MP
		var _final = getEveryActionsOnEveryOne(MyStats.CELL, MY_INVENTORY_ON_EVERYONE, EveryStats, MaxDist, WalkCellsClass, BaseHash)
		Benchmark.ActionsCellsIndependantStop()
		return _final
	}
	
	static getInventoryOnMe(Inventory, EveryStats) {
		var _final = []
		for (var item in Inventory) {
			if (!ToSkipItems[item] && Target.Targetable(Me, item, EveryStats)) {
				push(_final, item)
			}
		}
		return _final
	}

	static getEveryActionsOnMe(MyCell, Inventory, EveryStats) {
		if (MyCell in ACTIONS_ON_ME_CACHE) return ACTIONS_ON_ME_CACHE[MyCell]
		var _final = []
		for (var item in Inventory) {
			var Infos = ITEMINFO[item]
			var Act = getActionOnMe(MyCell, Infos.LAUNCHTYPE, Infos.MINRANGE, Infos.MAXRANGE, item, Infos.NEEDLOS)
			if (Act) push(_final, Act)
		}
		ACTIONS_ON_ME_CACHE[MyCell] = _final
		return _final
	}

	static getActionOnMe(MyCell, LaunchType, MinRange, MaxRange, item, NeedLos) {
		//TODO : Check i am the only entity in targets ?
		if (MinRange == 0) return new Action(item, MyCell, MyCell)
		var MinDist = 1000
		var MinDistCell
		if (NeedLos) {
			var Circle = LaunchWithLos[LaunchType](MyCell, MinRange, MaxRange)
			for (var to:var dist in AoeDistItem(item, MyCell)) {
				if (Circle[to] && CellInfo.getLosWithBaseHash(MyCell, to) && dist < MinDist) {
					MinDist = dist
					MinDistCell = to
				}
			}
		} else {
			var Circle = LaunchWithoutLos[LaunchType](MyCell, MinRange, MaxRange)
			for (var to:var dist in AoeDistItem(item, MyCell)) {
				if (Circle[to] && dist < MinDist) {
					MinDist = dist
					MinDistCell = to
				}
			}
		}
		if (MinDistCell != null) {
			var Act = new Action(item, MyCell, MinDistCell)
			return Act
		}
	}

	static getInventorySummon(Inventory) {
		var _final = []
		for (var item in Inventory) {
			if (SpecialItems[item]) {
				push(_final, item)
			}
		}
		return _final
	}
	
	static getEverySummonActions(MyCell, Inventory, EveryStats, LeekCells, BaseHash) {
		var TmpHash = BaseHash * MAX_CELL + MyCell
		if (TmpHash in ACTIONS_SUMMON_CACHE) return ACTIONS_SUMMON_CACHE[TmpHash]
		var _final = []
		for (var item in Inventory) {
			if (IsSummonable(item, EveryStats)) {//TODO : Check if resu isn't a bulb, or i already have 8 bulbs on the map
				var Infos = ITEMINFO[item]
				var Act = getSummonAction(Infos.LAUNCHTYPE, MyCell, Infos.MINRANGE, Infos.MAXRANGE, LeekCells, item, EveryStats, BaseHash)
				if (Act) push(_final, Act)
			}
		}
		ACTIONS_SUMMON_CACHE[TmpHash] = _final
		return _final
	}

	static getSummonAction(LaunchType, basefrom, MinRange, MaxRange, LeekCells, item, EveryStats, BaseHash) { //TODO : Cache
		var CellsUsables = []
		for (var c: var bool in LaunchWithLos[LaunchType](basefrom, MinRange, MaxRange)) {
			if (!LeekCells[c] && CellInfo.getLosWithBaseHash(basefrom, c)) {
				push(CellsUsables, c)
			}
		}
		var BestCellToSummon = BestSummonCellEntity(item, CellsUsables, EveryStats, BaseHash)
		if (BestCellToSummon != null) {
			var Act = new Action(item, basefrom, BestCellToSummon)
			return Act
		}
	}

	static getInventoryOnEveryOne(Inventory) {
		var _final = []
		for (var item in Inventory) {
			if (!ToSkipItems[item]) {
				push(_final, item)
			}
		}
		return _final
	}

	static getEveryActionsOnEveryOne(MyCell, Inventory, EveryStats, MaxDist, WalkCellsClass, BaseHash) {
		var Hash = BaseHash * MAX_CELL * MAX_MP + MyCell * MAX_MP + EveryStats[Me].MP
		if (Hash in ENTITY_ACTIONS_CACHE) return ENTITY_ACTIONS_CACHE[Hash]
		var CoeffedWalkCells = WalkCells.LoadCoeffedCellsFromWalkCellsClass(WalkCellsClass)

		//debug(Sorted)
		var _final = []
		for (var item in Inventory) {
			var Infos = ITEMINFO[item]
			if (Infos.AREA == AREA_FIRST_INLINE) { //Special case where i don't want to hit caster but a cell
				pushAll(_final, getFirstInlineActions(EveryStats, Infos, item, CoeffedWalkCells))
			} else { //Normal case
				pushAll(_final, getActionsOnEveryone(EveryStats, item, BaseHash, Infos, CoeffedWalkCells, MyCell, MaxDist))
			}
		}
		ENTITY_ACTIONS_CACHE[Hash] = _final
		return _final
	}

	static getActionsOnEveryone(EveryStats, Item, BaseHash, Infos, CoeffedWalkCells, MyStartingCell, MyBaseMaxDist) {
		//Redoing : 
		var MapHashClass = [: ]
		var MaxDist = Infos.MAXRANGE + Infos.AREA_MAX + MyBaseMaxDist
		var HashedMapAoe = LoadHashedMapAoe(EveryStats, Item, BaseHash, CoeffedWalkCells, MaxDist, MyStartingCell)
		Benchmark.ActionsLoadingClassStart()
		for (var from:var mapToHash in HashedMapAoe) {
			if (from in CoeffedWalkCells) {
				var mpScore = CoeffedWalkCells[from]
				for (var to:var toHash in mapToHash) {
					if (!(toHash in MapHashClass) || MapHashClass[toHash].MP_SCORE > mpScore) {
						if (CellInfo.getLosWithBaseHash(from, to)) MapHashClass[toHash] = new ActionPreSave(to, from, mpScore)
					}
				}
			}
		}
		var _final = []
		for (var ToHash:var PreSaveClass in MapHashClass) {
			push(_final, new Action(Item, PreSaveClass.FROM, PreSaveClass.TO))
		}
		Benchmark.ActionsLoadingClassStop()
		return _final
	}

	static getFirstInlineActions(EveryStats, Infos, Item, CoeffedWalkCells) {
		var _final = []
		var LaunchType = Infos.LAUNCHTYPE
		var MinRange = Infos.MINRANGE
		var MaxRange = Infos.MAXRANGE

		if (isAttract(Infos)) {
			for (var e:var stat in EveryStats) {
				if (e == Me) continue
				var EntityCell = stat.CELL
				var HittableCellsAreaEntity = LaunchWithLos[LaunchType](EntityCell, MinRange, MaxRange)
				var from = getClosestCoeffedWalkCellsToHit(HittableCellsAreaEntity, CoeffedWalkCells)
				if (from != null && CellInfo.getLosWithBaseHash(from, EntityCell)) {
					var CellToAttract = getClosestCellToAttract(from, EntityCell, MinRange, MaxRange)
					if (CellToAttract != EntityCell && CellInfo.getLosWithBaseHash(from, EntityCell)) { //Otherwise it doesn't launch and makes me crash :B
						var Act = new Action(Item, from, CellToAttract)
						push(_final, Act)
					}
				}
			}
		} else {
			for (var e:var stat in EveryStats) {
				if (e == Me) continue
				var EntityCell = stat.CELL
				var HittableCellsAreaEntity = LaunchWithLos[LaunchType](EntityCell, MinRange, MaxRange)
				var from = getClosestCoeffedWalkCellsToHit(HittableCellsAreaEntity, CoeffedWalkCells)
				if (from != null && CellInfo.getLosWithBaseHash(from, EntityCell)) {
					var CellToPush = getFarthestCellToPush(from, EntityCell, MinRange, MaxRange)
					if (CellToPush != EntityCell) { //Otherwise it doesn't launch and makes me crash :B
						var Act = new Action(Item, from, CellToPush)
						push(_final, Act)
					}
				}
			}
		}
		return _final
	}

	static getClosestCoeffedWalkCellsToHit(HittableCellsAreaEntity, CoeffedWalkCells) {
		var SmallestCoef = 1000000
		var _final
		for (var from:var bool in HittableCellsAreaEntity) {
			var CoefForFrom = CoeffedWalkCells[from]
			if (CoefForFrom != null && CoefForFrom < SmallestCoef) { //I Can go to the cell "from" to get e in my area of effect
				SmallestCoef = CoefForFrom
				_final = from
			}
		}
		return _final
	}

	static getFarthestCellToPush(from, EntityCell, MinRange, MaxRange) {
		var MaxDist = 0
		var MaxDistCell
		var PossiblesCellsToPush = CellInfo.getLaserAoe(from, EntityCell, MinRange, MaxRange)
		for (var c:var bool2 in PossiblesCellsToPush) {
			var ThisDist = CellInfo.getDist(c, from)
			if (MaxDist < ThisDist) {
				MaxDist = ThisDist
				MaxDistCell = c
			}
		}
		return MaxDistCell
	}

	static getClosestCellToAttract(from, EntityCell, MinRange, MaxRange) {
		var MinDist = 100
		var MinDistCell
		var PossiblesCellsToAttract = CellInfo.getLaserAoe(from, EntityCell, MinRange, MaxRange)
		for (var c:var bool2 in PossiblesCellsToAttract) {
			var ThisDist = CellInfo.getDist(c, from)
			if (MinDist > ThisDist) {
				MinDist = ThisDist
				MinDistCell = c
			}
		}
		return MinDistCell
	}

	static isAttract(Infos) { //ATM i can either be attract or push, if there are other items i need to re do this better
		for (var eff in Infos.EFFECTS) {
			if (eff[0] == EFFECT_ATTRACT) return true
		}
		return false
	}

	static LoadHashedMapAoe(EveryStats, Item, BaseHash, CoeffedWalkCells, MaxDist, MyBaseCell) {
		var Hash = BaseHash * MAX_ITEM + Item
		if (Hash in HASHED_MAP_ITEM_CACHE) return HASHED_MAP_ITEM_CACHE[Hash]
		Benchmark.ActionsAoeHashStart()
		var _final = [: ]
		var HashPush = 5 * MAX_ENTITY_ID //Max Dist And Entity Id for Pushing Hash
		var Infos = ITEMINFO[Item]
		var LaunchFct = Infos.NEEDLOS ? LaunchWithLos[Infos.LAUNCHTYPE] : LaunchWithoutLos[Infos.LAUNCHTYPE]
		for (var entity: var stat in EveryStats) {
			if (entity == Me || !Target.Targetable(entity, Item, EveryStats) /*|| CellInfo.getDist(MyBaseCell, stat.CELL) > MaxDist*/) continue
			for (var from:var MapToHash in LoadMapFromAoeForAnEntity(Item, stat.CELL, Infos, LaunchFct)) {
				//if (from in CoeffedWalkCells) {
					if (!(from in _final)) _final[from] = [: ]
					for (var to:var TmpHash in MapToHash) {
						if (!(to in _final[from])) {
							_final[from][to] = TmpHash * MAX_ENTITY_ID + entity
						} else {
							_final[from][to] = _final[from][to] * HashPush + TmpHash * MAX_ENTITY_ID + entity
						}
					}
				//}
			}
		}
		//Adding MySelf To Hash :
		if (Target.Targetable(Me, Item, EveryStats) && Infos.MINRANGE <= Infos.AREA_MAX && Infos.AREA_MAX > 0) {//Avoid Adding MySelf for Lightning
			for (var from:var MapToHash in _final) {
				var MapAoeCellsOfFrom = AoeDistItem(Item, from)
				for (var to:var TmpHash in MapToHash) {
					if (to in MapAoeCellsOfFrom) {//If i'm in the area, i add myself to hash :
						_final[from][to] = _final[from][to] * HashPush + MapAoeCellsOfFrom[to] * MAX_ENTITY_ID + Me
					}
				}
			}
		}
		HASHED_MAP_ITEM_CACHE[Hash] = _final
		Benchmark.ActionsAoeHashStop()
		return _final
	}

	static LoadMapFromAoeForAnEntity(Item, EntityCell, Infos, LaunchFunction) {
		var Hash = EntityCell * MAX_ITEM + Item
		if (Hash in COEFFED_MAP_ENTITY_CACHE) return COEFFED_MAP_ENTITY_CACHE[Hash]
		var MinRange = Infos.MINRANGE
		var MaxRange = Infos.MAXRANGE
		var _final = [: ]
		for (var to:var dist in AoeDistItem(Item, EntityCell)) {
			for (var from:var bool in LaunchFunction(to, MinRange, MaxRange)) {
				if (!(from in _final)) _final[from] = [: ]
				_final[from][to] = dist
			}
		}
		COEFFED_MAP_ENTITY_CACHE[Hash] = _final
		return _final
	}

	static getInventoryOnVoid(Inventory) {
		var _final = []
		for (var item in Inventory) {
			var Infos = ITEMINFO[item]
			if (!ToSkipItems[item] && Target.ImTargetable(Infos.EFFECTS)) {
				push(_final, item)
			}
		}
		return _final
	}
	
	static getEveryActionsInVoid(MyCell, Inventory, EveryStats, LeekCells, BaseHash) {
		var TmpHash = BaseHash * MAX_CELL + MyCell
		if (TmpHash in ACTIONS_ON_VOID_CACHE) return ACTIONS_ON_VOID_CACHE[TmpHash]
		var _final = []
		for (var item in Inventory) {
			var Infos = ITEMINFO[item]
			var Act = getActionInVoid(MyCell, Infos.MINRANGE, Infos.MAXRANGE, LeekCells, item)
			if (Act) push(_final, Act)
		}
		ACTIONS_ON_VOID_CACHE[TmpHash] = _final
		return _final
	}

	static getActionInVoid(basefrom, MinRange, MaxRange, LeekCells, Item) {
		//Items like broadsword on me
		for (var c: var bool in CellInfo.getDiscWithLos(basefrom, MinRange, MaxRange)) { //WEIRD DISC ONLY ?? CHANGE FOR LAUNCH TYPES TODO
			var GoodCell = true
			if (CellInfo.getLosWithBaseHash(basefrom, c)) {
				for (var aoe: var dist in AoeDistItem(Item, c)) {
					if (LeekCells[aoe]) {
						GoodCell = false
						break
					}
				}
				if (GoodCell) {
					var Act = new Action(Item, basefrom, c)
					return Act
				}
			}
		}
	}

	static IsSummonable(item, EveryStats) { //TODO : Being Able To Resu if i already have 8 bulbs and i want to resu a leek (dunno how to do it)
		var NumberOfSumms = 0
		for (var e: var stat in EveryStats) {
			if (stat.ALLY) NumberOfSumms += count(stat.SUMMONS)
		}
		/*if (item != CHIP_RESURRECTION && NumberOfSumms < SUMMON_LIMIT) return true
		if (item == CHIP_RESURRECTION && NumberOfSumms < SUMMON_LIMIT) {
			return true
		} else {//TODO : Resu Leeks Ally if Already got 8 bulbs ?
			return false
		}*/
		return NumberOfSumms < SUMMON_LIMIT
	}

	static BestSummonCellEntity(Chip, CellsUsables, EveryStats, BaseHash) { //TODO : CACHE With BASEHASH And Chip and use New Map Summon
		var BestScore = -1000000
		var _final
		var EntityScoring = EntityScoringForSummonCell(Chip, EveryStats)
		for (var c in CellsUsables) {
			var TmpScore = Gravity.getGravityScoreOnlyDist(c, EveryStats, EntityScoring, BaseHash)
			if (TmpScore > BestScore) {
				BestScore = TmpScore
				_final = c
			}
		}
		return _final
	}

	static EntityScoringForSummonCell(Chip, EveryStats) {
		var _final = [: ]
		if (Chip == CHIP_RESURRECTION) {
			for (var e:var stat in EveryStats) {
				if (stat.ALLY) {
					_final[e] = COEF_LIFE[e]
				} else {
					_final[e] = -COEF_LIFE[e]
				}
			}
		} else {
			var BulbInventory = BulbStats.getInventory(Chip)
			var RelativeItemsCount = SummonItems.LoadRelativeSummonItems(BulbInventory, BulbStats.getNameFromChip(Chip))
			for (var e:var stat in EveryStats) {
				if (stat.ALLY) {
					_final[e] = COEF_LIFE[e] * RelativeItemsCount.GENTLE
				} else {
					_final[e] = -COEF_LIFE[e] * RelativeItemsCount.MEAN
				}
			}
		}
		return _final
	}

	static AoeDistItem(item, to) { //Return a map of hit cells but no lazers
		var AoeType = ITEMINFO[item].AREA
		return MapOptiDistItem[AoeType](to)
	}

	static MapOptiDistItem = [
		AREA_POINT: function(to) {
			return [to: 0]
		},
		AREA_FIRST_INLINE: function(to) {
			return [to: 0]
		},
		AREA_LASER_LINE: function(to) {
			return [to: 0]
		},
		AREA_CIRCLE_1: function(to) {
			return ALLCELLINFO[to].CIRCLE_ONE_DIST
		},
		AREA_CIRCLE_2: function(to) {
			return ALLCELLINFO[to].CIRCLE_TWO_DIST
		},
		AREA_CIRCLE_3: function(to) {
			return ALLCELLINFO[to].CIRCLE_THREE_DIST
		},
		AREA_SQUARE_1: function(to) {
			return ALLCELLINFO[to].SQUARE_ONE_DIST
		},
		AREA_SQUARE_2: function(to) {
			return ALLCELLINFO[to].SQUARE_TWO_DIST
		},
		AREA_PLUS_2: function(to) {
			return ALLCELLINFO[to].PLUS_TWO_DIST
		},
		AREA_PLUS_3: function(to) {
			return ALLCELLINFO[to].PLUS_THREE_DIST
		},
		AREA_X_1: function(to) {
			return ALLCELLINFO[to].X_ONE_DIST
		},
		AREA_X_2: function(to) {
			return ALLCELLINFO[to].X_TWO_DIST
		},
		AREA_X_3: function(to) {
			return ALLCELLINFO[to].X_THREE_DIST
		}
	]
	
	static LaunchWithLos = [
		LAUNCH_TYPE_CIRCLE: function(to, MinRange, MaxRange) {
			return CellInfo.getDiscWithLos(to, MinRange, MaxRange)
		},
		LAUNCH_TYPE_LINE: function(to, MinRange, MaxRange) {
			return CellInfo.getLineWithLos(to, MinRange, MaxRange)
		},
		LAUNCH_TYPE_LINE_INVERTED: function(to, MinRange, MaxRange) {
			debugW("LineInverted Not Coded ATM (LaunchWithLos, Actions)")
		},
		LAUNCH_TYPE_DIAGONAL: function(to, MinRange, MaxRange) {
			return CellInfo.getDiagonalWithLos(to, MinRange, MaxRange)
		},
		LAUNCH_TYPE_DIAGONAL_INVERTED: function(to, MinRange, MaxRange) {
			debugW("Diag Inverted Not Coded ATM (LaunchWithLos, Actions)")
		},
		LAUNCH_TYPE_STAR: function(to, MinRange, MaxRange) {
			return CellInfo.getStarWithLos(to, MinRange, MaxRange)
		},
		LAUNCH_TYPE_STAR_INVERTED: function(to, MinRange, MaxRange) {
			return CellInfo.getInvertedStarWithLos(to, MinRange, MaxRange)
		}
	]
	
	static LaunchWithoutLos = [
		LAUNCH_TYPE_CIRCLE: function(to, MinRange, MaxRange) {
			return CellInfo.getDisc(to, MinRange, MaxRange)
		},
		LAUNCH_TYPE_LINE: function(to, MinRange, MaxRange) {
			return CellInfo.getLine(to, MinRange, MaxRange)
		},
		LAUNCH_TYPE_LINE_INVERTED: function(to, MinRange, MaxRange) {
			debugW("LineInverted Not Coded ATM (LaunchWithoutLos, Actions)")
		},
		LAUNCH_TYPE_DIAGONAL: function(to, MinRange, MaxRange) {
			return CellInfo.getDiagonal(to, MinRange, MaxRange)
		},
		LAUNCH_TYPE_DIAGONAL_INVERTED: function(to, MinRange, MaxRange) {
			debugW("Diag Inverted Not Coded ATM (LaunchWithoutLos, Actions)")
		},
		LAUNCH_TYPE_STAR: function(to, MinRange, MaxRange) {
			return CellInfo.getStar(to, MinRange, MaxRange)
		},
		LAUNCH_TYPE_STAR_INVERTED: function(to, MinRange, MaxRange) {
			return CellInfo.getInvertedStar(to, MinRange, MaxRange)
		}
	]
}