/**
 * This will load final cell (cell to end turn) its a combination between GravityCells and CellDanger
 **/
include("../includes")

class FinalCell {
	CELL
	DANGER
	GRAVITY_SCORE
	/* Construct the final cell Class: It loads a cell to go to, a danger, and a gravity score for this cell where i should go
    *
	* @param MyWalkCells Map <Cell : Mp> of my accescells
	* @param EveryStats Map <Id: Stats Class>
	* @param BaseHash Int : Hash of Id:Cell of every entities
    *
    * @return Nothing its a constructor
    */
	constructor(MyWalkCells, EveryStats, BaseHash) {

		//First i start by loading the Hash
		var TmpMyStats = EveryStats[Me]
		var BaseHashWithStatsHashForDanger = CellDanger.getStatsHashForDanger(TmpMyStats, BaseHash)
		var CovidValue = Gravity.getCovidValue(TmpMyStats) //it is an approx because its the value on me and not he value that will be passed by the effect
		var HashFinal = FinalHash(TmpMyStats, BaseHashWithStatsHashForDanger, CovidValue)
		//Hash is loaded (i need to load it here to avoid re loading CovidValue or BaseHashWithStatsHashForDanger Later in fors)

		if (HashFinal in FINAL_CACHE) {
			var Cache = FINAL_CACHE[HashFinal]
			this.CELL = Cache.CELL
			this.DANGER = Cache.DANGER
			this.GRAVITY_SCORE = Cache.GRAVITY_SCORE
			return;
		}

		Benchmark.FinalCellStart()

		//Cache wasn't existing yet, so we need to load the FinalMap for this :

		//I start by cloning mystats (cuz they will be modified in danger load), and removing shields that won't last until my next turn (can be modified in danger load, when its my ally's turn i remove it, but i think it will take a lot of time)
		var MyStats = clone(EveryStats[Me], 2) //Can Opti By Only Cloning Shield Values
		EditMyStats(MyStats)

		//Then i load everything i need to load cell Danger
		var BaseEnemiHash = Tree.getEnemiesBaseHash(EveryStats)
		var ToSkipMap = CellDanger.EntitiesToSkip(EveryStats)
		var EnemyWalkCells = LoadEnemiesWalkableCellsMap(EveryStats, ToSkipMap, BaseEnemiHash)
		Benchmark.GravityStart()
		var GravMap = Gravity.getFullGravityMap(MyWalkCells.MAX, EveryStats, CovidValue, BaseHash)
		var sorted = Gravity.sortGravity(GravMap, MyStats, CovidValue, BaseHash)
		Benchmark.GravityStop()

		//Then i seek the best cell to end my turn : I start with high gravity scores and i go lower and lower in grav score. If the highest gravity score is already at 0 damages, why load the others 
		var BestScore = 10000000
		for (var c in sorted) {
			var GravityScore = GravMap[c]
			if (-GravityScore >= BestScore) break //Its already a score that can't be beaten
			var Damage = CellDanger.get(c, EveryStats, MyStats, EnemyWalkCells, ToSkipMap, BaseHashWithStatsHashForDanger)
			var CellScore = Fitness.getDangerScore(Damage, GravityScore, MyStats)
			//Danger score is loaded, now i can compare scores
			if (CellScore < BestScore) {
				BestScore = CellScore
				this.CELL = c
				this.DANGER = Damage
				this.GRAVITY_SCORE = GravityScore
			}
		}
		//I Save the result to cache 
		FINAL_CACHE[HashFinal] = new FinalCache(this.CELL, this.DANGER, this.GRAVITY_SCORE)
		Benchmark.FinalCellStop()
	}

	/* Gives the hash for final cell (Taking into account : My Covid Value, BaseHash, My Abs and Rel Shield)
    *
	* @param MyStats : Stats class of Me
	* @param BaseHashWithStatsHashForDanger : Hash of Id and Cell Then i Added my Abs and Rel shield into it
	* @param CovidValue : The Covid Value on me that i will pass on targets
    *
    * @return Int (Hash)
    */
	
	static FinalHash(MyStats, BaseHashWithStatsHashForDanger, CovidValue) {
		return Gravity.HashGravityWithCovid(MyStats, CovidValue, BaseHashWithStatsHashForDanger)
	}

	/* Tells me if 2 entities are allies
    *
	* @param IsEntityAlly Bool : Wether entity One is ally or not
	* @param IsSecondEntityAlly Bool : Wether entity Two is ally or not
    *
    * @return Bool : Wether both of theses entities are allies
    */

	static areEntityAllies(IsEntityAlly, IsSecondEntityAlly) {
		return IsEntityAlly == IsSecondEntityAlly
	}

	static EditMyStats(MyStatsClone) { //This function removes the shield that won't make it during the whole danger phase (1 turn)
		for (var eff in MyStatsClone.EFFECTS) {
			if (eff[3] <= 1 && eff[2] != Me) {
				var Fct = MapEdit[eff[0]]
				if (Fct != null) {
					Fct(eff[1], MyStatsClone)
				}
			}
		}
	}

	static MapEdit = [
		EFFECT_ABSOLUTE_SHIELD:function(value, clonedstats) {
			clonedstats.ABSOLUTE_SHIELD -= value
		},
		EFFECT_RELATIVE_SHIELD:function(value, clonedstats) {
			clonedstats.RELATIVE_SHIELD -= value
		}
	]
	
	static LoadEnemiesWalkableCellsMap(EveryStats, ToSkip, BaseHash) { //Used for Danger
		if (BaseHash in EVERY_ENEMIES_WALKABLES) return EVERY_ENEMIES_WALKABLES[BaseHash]
		var EnemiesWalkCells = [: ]
		for (var e: var stat in EveryStats) { //Opti Possible By Caching WalkCells with its actual cell (it won't take into account moving entity cells :/) Maybe i can just cache it with looking at every entity within dist of walkcells + jump ?
			if (ToSkip[e]) continue
			EnemiesWalkCells[e] = LoadEnemyWalkableCellForDanger(EveryStats, stat, e, BaseHash).MAX
		}
		EVERY_ENEMIES_WALKABLES[BaseHash] = EnemiesWalkCells
		return EnemiesWalkCells
	}

	static LoadEnemyWalkableCellForDanger(EveryStats, EntityStats, entity, BaseHash) {//Opti Possible By Caching WalkCells with its actual cell (it won't take into account moving entity cells :/) Maybe i can just cache it with looking at every entity within dist of walkcells + jump ?
		return new WalkCells(EveryStats, entity, true, true, false, false, BaseHash) //Avoid loading TP and TP/JUMP
	}
}