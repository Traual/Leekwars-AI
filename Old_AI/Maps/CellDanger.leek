/**
 * Here i will calculate the danger of a cell or the best walkable cell to go to for danger/gravity cells
 **/

include("../includes")

class CellDanger {
	EndStats
	EndTp
	EndUses
	EndValueDamage
	constructor(TmpStats, TmpTp, TmpUses, TmpValueDamage) {
		this.EndStats = TmpStats
		this.EndTp = TmpTp
		this.EndUses = TmpUses
		this.EndValueDamage = TmpValueDamage
	}

	/* Loads an integer which is the danger i will face if i stay on cell "cell" (it takes in Enemy Strength, Tp, Mp, My Relative Shield, My Absolute Shield, It loads the best combo with vulnerabilities to it)
    *
	* @param Cell the cell i want to load damages for
	* @param EveryStats Map <Id : Class Stats>
	* @param TargetStats Class Stats of Target
	* @param EnemyWalkCells Map <Id : WalkCellsMap>
	* @param ToSkipMap Map <Id : ToSkipBool>
    *
    * @return Int : Damages i may take
    */

	static get(Cell, EveryStats, TargetStats, EnemyWalkCells, ToSkipMap, StatsHashForDanger) {
		var ThisHash = StatsHashForDanger * MAX_CELL + Cell
		if (ThisHash in CELL_DANGER_GET_CACHE) return CELL_DANGER_GET_CACHE[ThisHash]
		var _final = 0
		var TargetStatsCloned = clone(TargetStats, 2)
		for (var Caster in AllStats.getSortedEntityByTurnOrder(EveryStats)) {
			var CasterStats = EveryStats[Caster]
			if (ToSkipMap[Caster]) continue
			Benchmark.CellDangerAreaStart()
			var MapCellItemAoe = getMapCellItemAoe(CasterStats, EnemyWalkCells[Caster])
			Benchmark.CellDangerAreaStop()
			var MapThisCellItemAoe = Cell in MapCellItemAoe ? MapCellItemAoe[Cell] : [: ]
			Benchmark.CellDangerComboStart()
			_final += getComboFromItemAoe(MapThisCellItemAoe, CasterStats, TargetStatsCloned)
			Benchmark.CellDangerComboStop()
		}
		CELL_DANGER_GET_CACHE[ThisHash] = _final
		return _final
	}

	/* Loads Combo From an ItemAoe Map, MyStats and CasterStats
    *
	* @param ItemAoeMap Map <Item : MinAoeDist>
	* @param CasterStats Class Stats of Caster
	* @param TargetStats Class Stats of Target /!\ it will be changed so clone it /!\
    *
    * @return Int : Damages output of combo
    */

	static getComboFromItemAoe(ItemAoeMap, CasterStats, TargetStats) {
		if (mapIsEmpty(ItemAoeMap)) return 0 //Can't use item on me so can't do damages
		var HashedItemAoeMap = getHashFromItemAoeMap(ItemAoeMap)
		var HashWithShield = getStatsHashForDanger(TargetStats, HashedItemAoeMap)
		if (HashWithShield in COMBO_FROM_ITEM_AOE_CACHE) return COMBO_FROM_ITEM_AOE_CACHE[HashWithShield]
		var BaseTp = CasterStats.TP
		var BaseUses = CasterStats.USES
		var _final = getBFSComboFromItemAoe(ItemAoeMap, CasterStats, TargetStats, BaseTp, clone(BaseUses))
		var ComboWithVulne = getFirstComboVulneFrom(ItemAoeMap, CasterStats, TargetStats, BaseTp, BaseUses)
		while ((ComboWithVulne instanceof CellDanger) && (ComboWithVulne.EndValueDamage > _final)) {
			_final = ComboWithVulne.EndValueDamage
			TargetStats = ComboWithVulne.EndStats
			BaseUses = ComboWithVulne.EndUses
			BaseTp = ComboWithVulne.EndTp
			ComboWithVulne = getFirstComboVulneFrom(ItemAoeMap, CasterStats, TargetStats, BaseTp, BaseUses)
		}
		COMBO_FROM_ITEM_AOE_CACHE[HashWithShield] = _final
		return _final
	}

	/* get Me An Hash For ItemAoe
    *
	* @param ItemAoe Map <Item : MinArea>
    *
    * @return Hashed Map ItemAoe
    */

	static getHashFromItemAoeMap(ItemAoeMap) {
		var Hash_Final = 0
		for (var item:var dist in ItemAoeMap) {
			Hash_Final = (
				(Hash_Final * MAX_ITEM * MAX_AOE_DIST) +
				(item * MAX_AOE_DIST) +
				dist
			)
		}
		return Hash_Final
	}

	/* Loads Combo From an ItemAoe Map, MyStats and CasterStats
    *
	* @param ItemAoeMap Map <Item : MinAoeDist>
	* @param CasterStats Class Stats of Caster
	* @param TargetStats Class Stats of Target
    *
    * @return Int : Damages output of combo
    */

	static getFirstComboVulneFrom(ItemAoeMap, CasterStats, TargetStats, BaseTp, BaseUses) {
		var MaxDamages = 0
		var _final
		for (var item:var aoe in ItemAoeMap) {
			var Infos = ITEMINFO[item]
			if (BaseUses[item] < Infos.MAX_USES && BaseTp >= Infos.COST && IsVulnerabilityItem(Infos)) {//CHECK COST AND USES
				var CDangerClass = getCellDangerClassFromItem(TargetStats, Infos, BaseTp, BaseUses, ItemAoeMap, CasterStats, item)
				var Damages = CDangerClass.EndValueDamage
				if (MaxDamages < Damages) {
					MaxDamages = Damages
					_final = CDangerClass
				}
			}
		}
		return _final
	}

	/* get Me An Hash For Danger from MyStats (taking my shield into account)
    *
	* @param TargetStats Class Stats of Target
    *
    * @return Hashed Abs And Rel
    */

	static getStatsHashForDanger(TargetStats, TmpHash) {
		return (TmpHash * MAX_SHIELD * MAX_SHIELD * MAX_ANTIDOTE_CD) + (TargetStats.ABSOLUTE_SHIELD * MAX_SHIELD * MAX_ANTIDOTE_CD) + (TargetStats.RELATIVE_SHIELD * MAX_ANTIDOTE_CD) + TargetStats.COOLDOWNS[CHIP_ANTIDOTE]
		// Then integrate EveryOne's Mp/Tp/Str/Magic : Idead isn't bad but it'll add too much ops with Revoked M Laser i think
		/*
		for (var e: var stat in EveryStats) { //No Need for Ally/Enemies Cell cuz already in Gravity
			if (stat.ALLY) continue
			// Here add to Hash : stat.MP, stat.TP, stat.STRENGTH, and stat.MAGIC
				hash_value +=
				string((stat.MP * MAX_TP * MAX_STAT * MAX_STAT) +
				(stat.TP * MAX_STAT * MAX_STAT) +
				(stat.STRENGTH * MAX_STAT) +
				stat.MAGIC)
		}*/
	}

	/* get The Damages at the end of combo after using the item for vulné
    *
	* @param TargetStats Class Stats of Target
	* @param Infos : ITEMINFO of Item
    *
    * @return MyModifiedStats
    */

	static getCellDangerClassFromItem(TargetStats, Infos, BaseTp, BaseUses, ItemAoeMap, CasterStats, Item) {
		var ThisTp = BaseTp - Infos.COST
		var ThisUses = clone(BaseUses)
		var ThisItemMyStats = getRoughVulneConsequences(clone(TargetStats, 2), Infos)
		ThisUses[Item]++
		var DamagesWithThisItemVulne = getBFSComboFromItemAoe(ItemAoeMap, CasterStats, ThisItemMyStats, ThisTp, clone(ThisUses))
		return new CellDanger(ThisItemMyStats, ThisTp, ThisUses, DamagesWithThisItemVulne)
	}

	/* Change My Shields According to the item used
    *
	* @param TargetStats Class Stats of Target
	* @param Infos : ITEMINFO of Item
    *
    * @return MyModifiedStats
    */

	static getRoughVulneConsequences(TargetStats, Infos) {
		for (var eff in Infos.EFFECTS) {
			var EffType = eff[0]
			if (EffType in MapChange) MapChange[EffType](TargetStats, eff)
		}
		return TargetStats
	}

	static MapChange = [
		EFFECT_DEBUFF:function(TargetStats, eff) {
			TargetStats.ABSOLUTE_SHIELD *= 1 - (eff[1] / 100)
			TargetStats.RELATIVE_SHIELD *= 1 - (eff[1] / 100)
		},
		EFFECT_VULNERABILITY:function(TargetStats, eff) {
			TargetStats.RELATIVE_SHIELD -= eff[1]
		},
		EFFECT_ABSOLUTE_VULNERABILITY:function(TargetStats, eff) {
			TargetStats.ABSOLUTE_SHIELD -= eff[1]
		}
	]

	/* Loads Combo From an ItemAoe Map, MyStats and CasterStats
    *
	* @param ItemAoeMap Map <Item : MinAoeDist>
	* @param CasterStats Class Stats of Caster
	* @param TargetStats Class Stats of Target
    *
    * @return Int : Damages output of combo
    */

	static getBFSComboFromItemAoe(ItemAoeMap, CasterStats, TargetStats, CasterTP, ClonedEntityUses) {
		var EntityDangerArray = EntityDangerMap.get(CasterStats, TargetStats)
		var BFSHash = getBFSHash(ItemAoeMap, EntityDangerArray, CasterTP)
		if (BFSHash in BFS_CELL_DANGER_CACHE) return BFS_CELL_DANGER_CACHE[BFSHash]
		var _final = 0
		for (var EntityDangerClass in EntityDangerArray) {
			var ItemEntityDanger = EntityDangerClass.Item
			if (ItemAoeMap[ItemEntityDanger] == EntityDangerClass.Aoe) {
				var CostEntityDanger = EntityDangerClass.Cost
				var MaxUsesOfItem = ITEMINFO[ItemEntityDanger].MAX_USES
				while (CasterTP >= CostEntityDanger && ClonedEntityUses[ItemEntityDanger] < MaxUsesOfItem) {
					_final += EntityDangerClass.Damages
					CasterTP -= CostEntityDanger
					ClonedEntityUses[ItemEntityDanger]++
				}
			}
		}
		BFS_CELL_DANGER_CACHE[BFSHash] = _final
		return _final
	}

	/* Makes an Hash For BFS, it takes every items usables and its damages to me, and casterTp
    *
	* @param ItemAoeMap Map <Item : MinAoeDist>
	* @param EntityDangerArray Array of Class EntityDangerMap
    *
    * @return Int : Hash for BFS
    */

	static getBFSHash(ItemAoeMap, EntityDangerArray, CasterTP) {
		var _final = CasterTP
		for (var EntityDangerClass in EntityDangerArray) {
			var ItemEntityDanger = EntityDangerClass.Item
			if (ItemAoeMap[ItemEntityDanger] == EntityDangerClass.Aoe) {
				_final = (_final * MAX_ITEM * MAX_LIFE) + (ItemEntityDanger * MAX_LIFE) + EntityDangerClass.Damages
			}
		}
		return _final
	}

	/* Returns a Map <Cell : Map> <Item : SmallestAoe>
    *
	* @param EntityStats Class Stats of Caster
	* @param EntityWalkCells --> Map : <Cell : Score (Or MP)> Of Caster
    *
    * @return Map <Cell : Map> <Item : SmallestAoe>
    */

	static getMapCellItemAoe(EntityStats, EntityWalkCells) {
		var EntityStartCell = EntityStats.CELL
		var TmpHash = (mapSize(EntityWalkCells) * MAX_CELL) + (EntityStartCell)//Same Start Cell and Same number of walkcells --> very likely to not have any entities that have moved arround 
		if (TmpHash in MAP_CELL_ITEM_AOE_CACHE) return MAP_CELL_ITEM_AOE_CACHE[TmpHash]
		var _final = [: ]
		for (var Item in EntityDangerMap.getItemsList(EntityStats)) {
			for (var Cell:var MinAoeDist in getMapAoeForItem(Item, ITEMINFO[Item], EntityWalkCells, EntityStartCell)) {
				if (Cell in _final) {
					_final[Cell][Item] = MinAoeDist
				} else {
					_final[Cell] = [: ]
					_final[Cell][Item] = MinAoeDist
				}
			}
		}
		MAP_CELL_ITEM_AOE_CACHE[TmpHash] = _final
		return _final
	}


	/* Transforms getMapHittableCellsTotal (Map <Cell Id: true>) Into a map : Cell : MinAoeDist
    *
	* @param EntityStats Class Stats of Caster
	* @param EntityWalkCellsMap --> Map : <Cell : Score (Or MP)> Of Caster
    *
    * @return Map <Cell : MinAoeDist>
    */

	static getMapAoeForItem(Item, ItemInfos, WalkCellsMap, StartCell) {
		/*var TmpHash = (mapSize(WalkCellsMap) * MAX_CELL * MAX_ITEM) + (StartCell * MAX_ITEM) +  Item//Same Start Cell and Same number of walkcells --> very likely to not have any entities that have moved arround 
		if (TmpHash in MAP_ITEMS_USABLES_WITH_AOE_CACHE) return MAP_ITEMS_USABLES_WITH_AOE_CACHE[TmpHash]*/
		var _final = [: ]
		var MapCellsBool = getMapHittableCellsTotal(ItemInfos, WalkCellsMap, StartCell)
		//First i add every cells that can be hit without aoe (it works without this first for tho i save few thousands ops of not saving a value then replacing it by 0)
		for (var cell:var bool in MapCellsBool) {
			_final[cell] = 0
		}
		if (ItemInfos.AREA_MAX > 0) { //If item isn't area type point
			//Then i load aoe for unhittable cells
			for (var cell:var bool in MapCellsBool) {
				for (var Aoe:var AoeDist in Actions.AoeDistItem(Item, cell)) {
					var ActualCellDist = _final[Aoe]
					if (ActualCellDist == null || ActualCellDist > AoeDist) {
						_final[Aoe] = AoeDist
					}
				}
			}
		}
		//MAP_ITEMS_USABLES_WITH_AOE_CACHE[TmpHash] = _final
		return _final
	}

	/* Returns Every hitable cells by an entity with an item
    *
	* @param ItemInfos Class Items of item
	* @param WalkCellsMap --> Map : <Cell : Score (Or MP)> of Caster
    *
    * @return Map <Cell Id: true>
    */

	static getMapHittableCellsTotal(ItemInfos, WalkCellsMap, StartCell) {
		/*var TmpHash = (mapSize(WalkCellsMap) * MAX_CELL * MAX_ITEM) + (StartCell * MAX_ITEM) +  ItemInfos.ID//Same Start Cell and Same number of walkcells --> very likely to not have any entities that have moved arround 
		if (TmpHash in MAP_ITEMS_USABLES_CACHE) return MAP_ITEMS_USABLES_CACHE[TmpHash]*/

		//Starting by saving variables to save operations
		var _final = [: ]
		var LaunchType = ItemInfos.LAUNCHTYPE
		var MinRange = ItemInfos.MINRANGE
		var MaxRange = ItemInfos.MAXRANGE
		if (ItemInfos.NEEDLOS) { //Normal items cases (need los)
			for (var EntityCell:var mp in WalkCellsMap) {
				_final += Actions.LaunchWithLos[LaunchType](EntityCell, MinRange, MaxRange)
			}
		} else { //Other items cases (don't need los) like spark
			for (var EntityCell:var mp in WalkCellsMap) {
				_final += Actions.LaunchWithoutLos[LaunchType](EntityCell, MinRange, MaxRange)
			}
		}
		//MAP_ITEMS_USABLES_CACHE[TmpHash] = _final
		return _final
	}

	/* Returns Map of entities to skip (entity : true)
    *
	* @param EveryStats --> Map : <Id : Stats>
    *
    * @return Map <Id: true>
    */

	static EntitiesToSkip(EveryStats) {
		var _final = [: ]
		for (var caster: var caststats in EveryStats) {
			if (caststats.ALLY || caststats.LIFE <= 0 || !HaveAnHittableItem(caststats.COOLDOWNS, caster)) {
				_final[caster] = true
			}
		}
		return _final
	}

	/* Tells us if entity has an item that must be counted in danger map
    *
	* @param CooldownMap --> Map : <ItemId : Cooldown>
	* @param CasterID --> For caching result (can't change during a turn)
    *
    * @return Bool
    */

	static HaveAnHittableItem(CooldownMap, CasterID) {
		if (CasterID in HAVE_AN_HITTABLE_ITEM_CACHE) return HAVE_AN_HITTABLE_ITEM_CACHE[CasterID]
		for (var i: var cd in CooldownMap) {
			if (cd > 1) continue
			for (var eff in ITEMINFO[i].EFFECTS) {
				if (MapHittables[eff[0]]) {
					HAVE_AN_HITTABLE_ITEM_CACHE[CasterID] = true
					return true
				}
			}
		}
		HAVE_AN_HITTABLE_ITEM_CACHE[CasterID] = false
		return false
	}

	//Just a map for the function above

	static MapHittables = [
		EFFECT_DAMAGE: true,
		EFFECT_LIFE_DAMAGE: true,
		EFFECT_POISON: true,
		EFFECT_DEBUFF: true,
		EFFECT_ABSOLUTE_VULNERABILITY: true,
		EFFECT_VULNERABILITY:true
	]

	/* Tells us if an item (Item) can apply Vulnerability (To then try to apply it before damages items to check damages changes)
    *
	* @param ItemInfosVar ItemInfo Class of Item
    *
    * @return Bool
    */

	static IsVulnerabilityItem(ItemInfosVar) {
		for (var eff in ItemInfosVar.EFFECTS) {
			if (MapLoadForVulne[eff[0]]) return true
		}
		return false
	}

	//Just a map for the function above

	static MapLoadForVulne = [
		EFFECT_DEBUFF: true,
		EFFECT_ABSOLUTE_VULNERABILITY: true,
		EFFECT_VULNERABILITY:true
	]

	/* Returns a Hash ItemAoe Map, MyStats and CasterStats
    *
	* @param ItemAoeMap Map <Item : MinAoeDist>
	* @param CasterStats Class Stats of Caster
	* @param TargetStats Class Stats of Target
    *
    * @return Int Hash
    */

	static HashMapItemUseAoe(MapItemAoe, CurrentHash) {
		for (var i:var dist in MapItemAoe) {
			CurrentHash = 
			(CurrentHash * MAX_ITEM * MAX_AOE_DIST) +
			(i * MAX_AOE_DIST) +
			dist 
		}
		return CurrentHash
	}
}