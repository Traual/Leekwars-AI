/**
 * Here we have the Node Class ! Used in action Suite to keep track of EndStats, Parenting etc
**/

include("../includes")

class Node {
	ACTION
	END_STATS
	PARENT
	SCORE_ID_MAP
	FINAL_CELL
	constructor(Act, StatsAfterAction, Parent) {
		this.ACTION = Act
		this.END_STATS = StatsAfterAction
		this.PARENT = Parent
	}
}