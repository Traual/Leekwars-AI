	/* Gives me the best action to do in the EveryStats game state
    *
	* @param EveryStats Map of Stats Class (id : stats)
    *
    * @return Node
    */

	static getBestActionTreeInState(EveryStats) {
		Benchmark.DFSStart()
		var Tree_Array = []
		var BaseHash = Tree.getBaseHash(EveryStats)

		//Loading The BFS Tree
		getFullBFSTree(Tree_Array, EveryStats, BaseHash)

		//Then We Add The No Play Node (Not Above because we don't want to find plays on it)
		AddNoPlayNode(Tree_Array, EveryStats)

		debug("Number of leafs : "+count(Tree_Array))

		//Then We Look at Every Node in the Tree and find the Best One : 
		var BestScoredNode = getBestScoredNode(EveryStats, Tree_Array)

		Benchmark.DFSStop()

		//Then we need to find its first ancestor :
		return getFirstAncestor(BestScoredNode)
	}

	/* Adds the No Play Node Into the Tree Array (to be able to do nothing and go hide myself)
    *
	* @param Tree_Array Array of nodes <Node, Node ...>
	* @param EveryStats Map of Stats Class (id : stats)
    *
    * @return Nothing
    */

	static AddNoPlayNode(Tree_Array, EveryStats) {
		var NoPlayAction = new Action(null, null, null)
		var NoPlayNode = new Node(NoPlayAction, EveryStats, null)
		push(Tree_Array, NoPlayNode)
	}

	/* Gives me the first ancestor of a node
    *
	* @param ThisNode Node which i want to seek its ancestor
    *
    * @return First ancestor of the node
    */

	static getFirstAncestor(ThisNode) {
		while (ThisNode.PARENT != null) {
			ThisNode = ThisNode.PARENT
		}
		return ThisNode
	}

	/* Returns the best scored node in Tree_Array, takes into account node score, node danger, node gravity
    *
	* @param EveryStats Map of Stats Class (id : stats)
	* @param Tree_Array Array of nodes <Node, Node ...>
    *
    * @return Node
    */

	static getBestScoredNode(EveryStats, Tree_Array) {
		Benchmark.ScoringEveryNodesStart()
		//Then Find the best Scored Node in tree :
		var BestScore = -MAX_VALUE
		var BestNode
		var MyStats = EveryStats[Me]
		for (var Nod in Tree_Array) {
			var ThisNodeScore = Fitness.getNodeFinalScore(Nod)
			//if (getTurn() == 40) debug("This Branch : "+DebugBranchArray(Nod)+" is scored at base : "+ThisNodeScore)
			if (ThisNodeScore > BestScore) {
				//Then i try to see with danger
				var EndNodeStats = Nod.END_STATS
				var BaseHash = Tree.getBaseHash(EndNodeStats)
				var ThisWalkCells = new WalkCells(EndNodeStats, Me, true, true, false, false, BaseHash)
				Nod.FINAL_CELL = new FinalCell(ThisWalkCells, EndNodeStats, BaseHash)
				ThisNodeScore -= Fitness.getDangerScore(Nod.FINAL_CELL.DANGER, Nod.FINAL_CELL.GRAVITY_SCORE, MyStats)
				//debug("And its score with danger is : "+ThisNodeScore)
				if (ThisNodeScore > BestScore) {
					//Then if even with danger added, its still better, its the new best branch
					BestNode = Nod
					BestScore = ThisNodeScore
				}
			}
		}
		debugC("Best branch is : "+DebugBranchArray(BestNode)+" and its scored : "+BestScore+" and my base Tp are : "+EveryStats[Me].TP, COLOR_GREEN)
		Benchmark.ScoringEveryNodesStop()
		return BestNode
	}

	/* Adds the full "BFS Tree" to Tree Array. It adds every plays possible then for every play it adds to tree Array Every Best Move From Score of action
    *
	* @param EveryStats Map of Stats Class (id : stats)
	* @param Tree_Array Array of nodes <Node, Node ...>
	* @param BaseHash Hash of Id and Cells of everyone
    *
    * @return Nothing
    */

	static getFullBFSTree(Tree_Array, EveryStats, BaseHash) {
		//We start by loading every playable actions
		var MyStats = EveryStats[Me]
		var WalkCellsClass = new WalkCells(EveryStats, Me, true, true, false, false, BaseHash)
		var BaseActions = getFullScoredActionsArray(EveryStats, BaseHash)
		var ArrayToBFS = []
		//Then we push every playable actions into Tree Array
		for (var ScoredAct in BaseActions) {
			var ThisNode = Tree.ActionToNode(ScoredAct.ACTION, EveryStats, BaseHash, null)
			push(Tree_Array, ThisNode)
			push(ArrayToBFS, ThisNode)
		}
		//Then for each of base playable action i reload every playable scored actions and chose the best one, then the best one etc (with check for action score when i'll be picked to avoid wanting to heal an ally, then wanting to heal it again while full life)
		for (var Nod in ArrayToBFS) {
			//I Load the full action list and sort it for later
			var NodeStats = Nod.END_STATS
			var NodeBaseHash = Tree.getBaseHash(NodeStats)
			var SortedScoredActionsArray = arraySort(getFullScoredActionsArray(NodeStats, NodeBaseHash), function(a, b) {
    			return b.SCORE - a.SCORE
			})
			//While i have a good play to do i "play it" in my simulation then add its node to Tree Array
			var BestActionInThisState = getBestNodeShorten(NodeStats, NodeBaseHash, Nod, SortedScoredActionsArray)
			while (BestActionInThisState) {
				push(Tree_Array, BestActionInThisState)
				var ThisNodeStats = BestActionInThisState.END_STATS
				var ThisNodeBaseHash = Tree.getBaseHash(ThisNodeStats)
				BestActionInThisState = getBestNodeShorten(ThisNodeStats, ThisNodeBaseHash, BestActionInThisState, SortedScoredActionsArray)
			}
		}
	}

	/* Returns to me the best Node with "few" parameters
    *
	* @param EveryStats Map of Stats Class (id : stats)
	* @param ActualNode Used to make link between nodes (Node.PARENT == ActualNode)
	* @param BaseHash Hash of Id and Cells of everyone
	* @param SortedScoredActionsArray Array of every scored actions sorted by decreasing order (to avoid looking at every actions every time)
    *
    * @return Node (the best scored one) or False
    */

	static getBestNodeShorten(EveryStats, BaseHash, ActualNode, SortedScoredActionsArray) {
		var MyStats = EveryStats[Me]
		var MyTp = MyStats.TP
		if (MyTp < MINIMUM_COST_ITEM) return false
		/////////
		///REFRESHING
		////////
		var MyWalkCells = new WalkCells(EveryStats, Me, true, true, false, false, BaseHash)
		/////////
		///Finding the Best Action Playable From SortedActions
		////////
		return getBestNodeFromSortedActionArray(EveryStats, MyWalkCells, MyStats, SortedScoredActionsArray, MyTp, BaseHash, ActualNode)
	}

	//Small map to avoid moving entities in my BFS, cuz if i move someone i won't reload my actions so a lot of them will become irrelevant
	static ForbiddenItemsMapInBFS = [
		CHIP_INVERSION: true,
		CHIP_BOXING_GLOVE: true,
		CHIP_GRAPPLE: true
	]

	/* A version with more parameters then getBestNodeShorten but still returns the same thing (best playable node from scored array)
    *
	* @param EveryStats Map of Stats Class (id : stats)
	* @param MyWalkCells Class WalkCells of my entity
	* @param MyStats My Stats Class
	* @param SortedActions Array of every scored actions sorted by decreasing order (to avoid looking at every actions every time)
	* @param MyTp : My Current TP
	* @param BaseHash Hash of Id and Cells of everyone
	* @param ParentNode Used to make link between nodes (Node.PARENT == ParentNode)
    *
    * @return Node (the best scored one) or False
    */

	static getBestNodeFromSortedActionArray(EveryStats, MyWalkCells, MyStats, SortedActions, MyTp, BaseHash, ParentNode) {
		Benchmark.ForInBFSOpsStart()

		// Variables for optimization
		var BestScore = 0
		var BestAct
		var BestCost
		var MyOnlyWalkCells = MyWalkCells.WALK
		var MyMaxWalkCells = MyWalkCells.MAX
		var JumpCost = ITEMINFO[CHIP_JUMP].COST
		var MyWeapon = MyStats.WEAPON
		var MyCooldowns = MyStats.COOLDOWNS
		var MyUses = MyStats.USES

		// Iterate through actions to find the best one
		for (var ScoredAct in SortedActions) {
			//Variables to optimise
			var Act = ScoredAct.ACTION
			var From = Act.FROM
			if (From in MyMaxWalkCells) { // Check only if cell is accessible

				var Item = Act.ITEM
				if (MyCooldowns[Item] > 0 || Item in ForbiddenItemsMapInBFS) continue // Skip if item is on cooldown or its a movement item

				var Info = ITEMINFO[Item] 
        		if (MyUses[Item] >= Info.MAX_USES) continue // Skip if max uses reached
        
        		var TmpCost = Info.COST
        		if (TmpCost > MyTp) continue // Skip if action cost is too high

       			if (BestScore >= ScoredAct.SCORE) break // Array is sorted, no need to continue

				var Cost = Info.IS_WEAPON && MyWeapon != Item ?
					TmpCost + 1 :
					TmpCost //Adding weapon setting cost
				Cost += From in MyOnlyWalkCells ? 0 : JumpCost //Adding jump cost
				if (Cost <= MyTp) { //If real cost is lower then actual tp, the item is playable
					var ThisScore = ActionFitness.Score(Act, EveryStats, BaseHash) / Cost //Reloading score to get real score of action (to avoid wanting to heal a full life ally for exemple)
					if (ThisScore > BestScore) { //This action is the new best one, i will save it
						BestScore = ThisScore
						BestAct = Act
						BestCost = Cost
					}
				}
			}
		}

		Benchmark.ForInBFSOpsStop()

		if (BestAct) { //If there is an action for the best play, then i turn it into a node and return it
			var Item = BestAct.ITEM
			return Tree.ActionToNodeInTree(BestAct, EveryStats, BestAct.FROM, MyWalkCells, BestCost, ITEMINFO[Item], Item, BestAct.TO, BaseHash, ParentNode)
		} else {
			return false
		}
	}

	/* Returns the full list of possible actions with a score for each of them.
    *
	* @param EveryStats Map of Stats Class (id : stats)
	* @param BaseHash Hash of Id and Cells of everyone
    *
    * @return Array <ScoredAction Class>
    */

	static getFullScoredActionsArray(EveryStats, BaseHash) {
		var _final = []
		var MyStats = EveryStats[Me]
		var MyWalkCellsClass = new WalkCells(EveryStats, Me, true, true, false, false, BaseHash)
		var Acts = Actions.getEveryActionsInAState(EveryStats, MyWalkCellsClass, MyStats.CELL, BaseHash)
		var JumpCost = ITEMINFO[CHIP_JUMP].COST
		var MyWeapon = MyStats.WEAPON
		var MyCooldowns = MyStats.COOLDOWNS
		var MyTp = MyStats.TP
		var MyUses = MyStats.USES
		var MyOnlyWalkCells = MyWalkCellsClass.WALK
		for (var Act in Acts) {
			var Item = Act.ITEM
			var From = Act.FROM
			var Info = ITEMINFO[Item]
			var PossibleUses = min(floor(MyTp/Info.COST), Info.MAX_USES - MyUses[Item]) //Used to make jump costs (and weapon changing costs) less heavy in weight if i use item multiple time
			var Cost = Info.IS_WEAPON && MyWeapon != Item ?
				Info.COST + 1 :
				Info.COST
			Cost += From in MyOnlyWalkCells ? 0 : JumpCost
			if (Cost <= MyTp && MyCooldowns[Item] == 0 && MyUses[Item] < Info.MAX_USES) {
				var ThisScore = ActionFitness.Score(Act, EveryStats, BaseHash)
				if (ThisScore > 0 || Item in ForbiddenItemsMapInBFS) {
					var ThisScoredAction = new ScoredAction(Act, ThisScore / Info.COST)
					push(_final, ThisScoredAction)
				}
			}
		}
		return _final
	}

	/* Utility : Returns an array to debug a branch from an end Node
    *
	* @param EndNode The Node that i want to make into a string array
    *
    * @return Array <String>
    */
	
	static DebugBranchArray(EndNode) {
		if (!EndNode.ACTION.ITEM) return ["no play node"]
		var ClonedEndNode = clone(EndNode, 2)
		var _final = []
		push(_final, ITEMINFO[ClonedEndNode.ACTION.ITEM].NAME+" from "+ClonedEndNode.ACTION.FROM+" to "+ClonedEndNode.ACTION.TO)
		while (ClonedEndNode.PARENT != null) {
			ClonedEndNode = ClonedEndNode.PARENT
			push(_final, ITEMINFO[ClonedEndNode.ACTION.ITEM].NAME+" from "+ClonedEndNode.ACTION.FROM+" to "+ClonedEndNode.ACTION.TO)
		}
		reverse(_final)
		return _final
	}
}