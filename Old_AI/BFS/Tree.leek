/**
 * Here we are going to do the Tree Class (Everything usefull in a tree) !
 **/

include("../includes.leek")

class Tree {

	/* Hash Function for having an Hash of every Entities positions in Game (Very used)
    *
	* @param EveryStats Map <Id : Class Stats of Id>
    *
    * @return Hash id:Entity Cell of alive entities
    */

	static getBaseHash(EveryStats) { //This is the BaseHash
		var hash_value = 14695981039346656037
		var Mask_High = (1 << 13) - 1
		for (var id: var stat in EveryStats) {
			if (id == Me || stat.LIFE <= 0) continue
			// combine id (32 bits haut) et CELL (32 bits bas) en un mot 64 bits
       		var combined = (id << 32) | stat.CELL

        	// extraire les SHIFT bits de poids fort avant de faire >> sur hash
        	var high = (hash_value >> 51) & Mask_High

        	// rotation à gauche de SHIFT bits, puis injection par XOR
        	hash_value = ((hash_value << 13) | high) ^ combined

		}
		return hash_value
	}

	/* Hash Function for having an Hash of every Enemy Entities positions in Game (Used in cell Danger)
    *
	* @param EveryStats Map <Id : Class Stats of Id>
    *
    * @return Hash id:Entity Cell of alive enemies
    */

	static getEnemiesBaseHash(EveryStats) { //This is the Enemies BaseHash (For enemies walkcells in Final Cell Loading)
		var hash_value = 0

		for (var id: var stat in EveryStats) {
			if (stat.ALLY || stat.LIFE <= 0) continue
			hash_value = (hash_value * MAX_ENTITY_ID * MAX_CELL) + (id * MAX_CELL) + stat.CELL
		}
		return hash_value
	}

	/* It is a simplified version with less parameters of ActionToNodeInATree. It is used in Action Suite in Loading Base Nodes
    *
	* @param Act Action that i want to transform into a node
	* @param EveryStats Map <Id : Class Stats of Id>
	* @param BaseHash Hash of Id:Cell of EveryOne
	* @param ParentNode Node that will be Node.PARENT of the one created here
    *
    * @return New Node Class
    */

	static ActionToNode(Act, EveryStats, BaseHash, ParentNode) {
		if (Act == null) return;
		var MyStats = EveryStats[Me]
		var MyCell = MyStats.CELL
		var MyWalkCells = new WalkCells(EveryStats, Me, true, true, false, false, BaseHash)
		var Item = Act.ITEM
		var From = Act.FROM
		var To = Act.TO
		var Info = ITEMINFO[Item]
		var Cost = Info.IS_WEAPON && MyStats.WEAPON != Item ?
			Info.COST + 1 :
			Info.COST
		Cost += MyWalkCells.WALK[From]!=null ? 0 : ITEMINFO[CHIP_JUMP].COST
		return ActionToNodeInTree(Act, EveryStats, From, MyWalkCells, Cost, Info, Item, To, BaseHash, ParentNode)
	}

	/* It is a complicated version with more parameters of ActionToNode to avoid reloading informations that i already have. It is used in Action Suite in using the best play to expand the existing base nodes
    *
	* @param Act Action that i want to transform into a node
	* @param EveryStats Map <Id : Class Stats of Id>
	* @param From : Cell From (Act.FROM)
	* @param MyWalkCells Class WalkCells of my entity
	* @param Cost Total cost of the action including weapon changes, jump etc
	* @param Info Class ItemInfo of (Item)
	* @param Item : Item to use (Act.ITEM)
	* @param To : Cell To (Act.TO)
	* @param BaseHash Hash of Id:Cell of EveryOne
	* @param ParentNode Node that will be Node.PARENT of the one created here
    *
    * @return New Node Class
    */

	static ActionToNodeInTree(Act, EveryStats, From, MyWalkCells, Cost, Info, Item, To, BaseHash, ParentNode) {
		var Targets = Consequences.ConsequenceTargets(Item, From, To, EveryStats, Me, BaseHash)
		//debug(Targets)
		var ThisActionStats = Stats.CloneOnlyTargetsAndMe(Targets, EveryStats)//clone(EveryStats, 3)
		ThisActionStats[Me].CELL = From
		ThisActionStats[Me].MP -= MyWalkCells.WALK[From]!=null ? MyWalkCells.WALK[From] : MyWalkCells.JUMP[From]
		ThisActionStats[Me].TP -= Cost //We Remove TP
		if (Info.IS_WEAPON) ThisActionStats[Me].WEAPON = Item //Change Entity Weapon
		Consequences.getConsequences(ThisActionStats, Item, From, To, Me, BaseHash) //Changing item consequences
		ThisActionStats[Me].COOLDOWNS[Item] = Info.COOLDOWN //Adding the cooldown
		ThisActionStats[Me].USES[Item]++ //Adding the uses
		if (MyWalkCells.WALK[From] == null) ThisActionStats[Me].COOLDOWNS[CHIP_JUMP] = ITEMINFO[CHIP_JUMP].COOLDOWN //Adding the jump cooldown
		var NewNode = new Node(Act, ThisActionStats, ParentNode) //Creating Node
		//Now we need to score the node
		var ActualScoreIdMap = ParentNode ? ParentNode.SCORE_ID_MAP : [: ]
		var ThisNodeScoreIdMap = Fitness.getMapIdScore(ThisActionStats, EveryStats, Targets, ActualScoreIdMap)
		NewNode.SCORE_ID_MAP = ThisNodeScoreIdMap
		return NewNode
	}
}