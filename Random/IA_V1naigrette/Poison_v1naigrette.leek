include("Cache_Cache.leek");
// Variables

var enemy = getNearestEnemy();
var mycell = getCell();
var enemycell = getCell(enemy);
var tour = getTurn();
global leek2 = nearestrealenemy();


//Special

if (getTurn()==1) {setWeapon(WEAPON_FLAME_THROWER);
	
}

//S'approcher
if (getRelativeShield()>=40 && getAbsoluteShield()>=130) {
moveTowardCell(getCellToUseWeapon(WEAPON_FLAME_THROWER, leek2));	
}


if (getPathLength(getCell(), getCellToUseWeapon(WEAPON_FLAME_THROWER, leek2))<=getMP()) {
moveTowardCell(getCellToUseWeapon(WEAPON_FLAME_THROWER, leek2));
}
//Equiper ARME

if (getWeapon()!=WEAPON_FLAME_THROWER) {setWeapon(WEAPON_FLAME_THROWER);}

//Tirer

if (canUseWeapon(leek3)==false) {useWeapon(getNearestEnemy());
useWeapon(enemy);
useWeapon(enemy);}

else

useWeapon(leek3);
useWeapon(leek3);

if (canUseChip(CHIP_VENOM, leek2)) {useChip(CHIP_VENOM, leek2);}

if (inArray(getChips(nearestrealenemy()), CHIP_LIBERATION)) {
if (getCooldown(CHIP_LIBERATION, nearestrealenemy())<=3 && getMagic(nearestrealenemy())<=100) {
useChip(CHIP_WALL, getLeek());
useChip(CHIP_SHIELD, getLeek());
}

if (getCooldown(CHIP_LIBERATION, nearestrealenemy())>=3 && getMagic(nearestrealenemy())<=100) {
useChip(CHIP_ARMOR, getLeek());
useChip(CHIP_SHIELD, getLeek());
useChip(CHIP_FORTRESS, getLeek());
}
}

if (!inArray(getChips(nearestrealenemy()), CHIP_LIBERATION)) {
useChip(CHIP_ARMOR, getLeek());
useChip(CHIP_SHIELD, getLeek());
useChip(CHIP_FORTRESS, getLeek());
useChip(CHIP_WALL, getLeek());
}

if (canUseChip(CHIP_TRANQUILIZER, leek3)) {useChip(CHIP_TRANQUILIZER, leek3);}
if (canUseChip(CHIP_TRANQUILIZER, leek3)) {useChip(CHIP_TRANQUILIZER, leek3);}
if (canUseChip(CHIP_TRANQUILIZER, leek3)) {useChip(CHIP_TRANQUILIZER, leek3);}if (canUseChip(CHIP_TRANQUILIZER, leek3)) {useChip(CHIP_TRANQUILIZER, leek3);}if (canUseChip(CHIP_TRANQUILIZER, leek3)) {useChip(CHIP_TRANQUILIZER, leek3);}
if (canUseChip(CHIP_TRANQUILIZER, leek3)) {useChip(CHIP_TRANQUILIZER, leek3);}
if (canUseChip(CHIP_TRANQUILIZER, leek3)) {useChip(CHIP_TRANQUILIZER, leek3);}


// Bulbe Chetif

summon(CHIP_ROCKY_BULB, getCellToUseChip(CHIP_PUNY_BULB, getLeek()), bulbeRocheux);
summon(CHIP_PUNY_BULB, getCellToUseChip(CHIP_PUNY_BULB, getLeek()), bulbechetif);



//S'approcher 2

if (getLife()>getLife(leek2) && getPathLength(getCell(), getCell(leek2))>=15) {
	moveToward(leek2);
}

if (getTP()<=5) {
moveTowardCell(tableaucellscacher());}



