include("Cache cache");

// Variables
var enemy = getNearestEnemy();
var mycell = getCell();
var enemycell = getCell(enemy);
var tour = getTurn();
global leek2 = nearestrealenemy();
global tirer = useCHiporWeaponarea(WEAPON_GAZOR, 3, getNearestEnemy());

//Special

if (getTurn()==1) {setWeapon(WEAPON_GAZOR);	
}
//Chips Prioritaires

if (getLife()<300) {useChip(CHIP_REGENERATION, getLeek());}
if (canUseChip(CHIP_LIBERATION, leek3)) {useChip(CHIP_LIBERATION, leek3);}

//S'approcher

if (getTP()>=7) {
moveTowardCell(getCellToUseWeapon(WEAPON_GAZOR, getNearestEnemy()));}
else
moveAwayFrom(getNearestEnemy());

// Bulbe Chetif

summon(CHIP_ICED_BULB, getCell(), bulbAI());
summon(CHIP_ROCKY_BULB, getCell(), bulbeRocheux());
summon(CHIP_PUNY_BULB, getCellToUseChip(CHIP_PUNY_BULB, getLeek()), bulbechetif);


//Tirer

if (canUseWeapon(getNearestEnemy())) {useWeapon(getNearestEnemy());
useWeapon(getNearestEnemy());}

//Gentil Chips
if (getTurn()==1) {
useChip(CHIP_LOAM, getLeek());
}

if (getLife()<500) {
useChip(CHIP_VACCINE, getLeek());
useChip(CHIP_CURE, getLeek());}
if (canUseChip(CHIP_ARMOR, getLeek())) {useChip(CHIP_ARMOR, getLeek());}

//Mechant Chips

if (canUseChip(CHIP_VENOM, leek3)) {useChip(CHIP_VENOM, leek3);}
if (canUseChip(CHIP_TRANQUILIZER, leek3)) {useChip(CHIP_TRANQUILIZER, leek3);}


