include("Cache cache");

global leek2 = nearestrealenemy();
if (getLife(leek2) == 0) {leek2 = nearestrealenemy();	
}
var enemy = getNearestEnemy();
var mycell = getCell();
var enemycell = getCell(enemy);
var dist = getDistance(mycell, getCell(leek2));
var tour = getTurn();
var disto = getPathLength(mycell, getCell(leek2));
var leek2cell = getCell(leek2);

if (tour == 1) {
	summon(CHIP_ICED_BULB, getCellToUseChip(CHIP_ICED_BULB, getLeek()), bulbAI);
	moveAwayFrom(leek2);

}
if (dist > 12 and tour == 2) {
	summon(CHIP_ROCKY_BULB, getCellToUseChip(CHIP_ROCKY_BULB, getLeek()), bulbeRocheux);
}

// Ia 
if (getLife() < getTotalLife() - 500 and getCooldown(CHIP_REGENERATION) == 0) {
	useChip(CHIP_REGENERATION, getLeek());
	useChip(CHIP_VACCINE, getLeek());
	if (getCooldown(CHIP_REGENERATION) > 0) {
		moveTowardCell(tableaucellscacher());
		
	}

}
poisoncounter();

//B

if (getStrength(leek2)>=500 and getCooldown(CHIP_LIBERATION) == 0 && getScience(leek2)>=200) {
	if (getCooldown(CHIP_ICEBERG) == 0) {
		moveTowardCell(getCellToUseChip(CHIP_ICEBERG, leek2));
		useChip(CHIP_LIBERATION, leek2);

		if (getCooldown(CHIP_LIBERATION) > 0) {
			useChipOnCell(CHIP_ICEBERG, useCHiporWeaponarea(CHIP_ICEBERG, 2, leek2));
			useChip(CHIP_STALACTITE, leek2);
		}
	}
	if (getCooldown(CHIP_ICEBERG) > 0 && getCooldown(CHIP_STALACTITE) == 0) {
		moveTowardCell(getCellToUseChip(CHIP_LIBERATION, leek2));
		useChip(CHIP_LIBERATION, leek2);
		if (getCooldown(CHIP_LIBERATION) > 0) {
			useChip(CHIP_STALACTITE, leek2);
		}
	}
	if (getCooldown(CHIP_ICEBERG) > 0 && getCooldown(CHIP_STALACTITE) > 0) {
		moveTowardCell(getCellToUseWeapon(WEAPON_LASER, leek2));
		useChip(CHIP_LIBERATION, leek2);
		if (getWeapon() != WEAPON_LASER) {
			setWeapon(WEAPON_LASER);

		}
		if (getCooldown(CHIP_LIBERATION) > 0) {
			useWeapon(leek2);
		}
	}


}

if (bouclier() == true and getCooldown(CHIP_LIBERATION) == 0) {
	if (getCooldown(CHIP_ICEBERG) == 0) {
		moveTowardCell(getCellToUseChip(CHIP_ICEBERG, leek2));
		useChip(CHIP_LIBERATION, leek2);

		if (getCooldown(CHIP_LIBERATION) > 0) {
			useChipOnCell(CHIP_ICEBERG, useCHiporWeaponarea(CHIP_ICEBERG, 2, leek2));
			useChip(CHIP_STALACTITE, leek2);
		}
	}
	if (getCooldown(CHIP_ICEBERG) > 0 && getCooldown(CHIP_STALACTITE) == 0) {
		moveTowardCell(getCellToUseChip(CHIP_LIBERATION, leek2));
		useChip(CHIP_LIBERATION, leek2);
		if (getCooldown(CHIP_LIBERATION) > 0) {
			useChip(CHIP_STALACTITE, leek2);
		}
	}
	if (getCooldown(CHIP_ICEBERG) > 0 && getCooldown(CHIP_STALACTITE) > 0) {
		moveTowardCell(getCellToUseWeapon(WEAPON_LASER, leek2));
		useChip(CHIP_LIBERATION, leek2);
		if (getWeapon() != WEAPON_LASER) {
			setWeapon(WEAPON_LASER);

		}
		if (getCooldown(CHIP_LIBERATION) > 0) {
			useWeapon(leek2);
		}
	}


}

if (canUseWeapon(WEAPON_AXE, leek2)) {
if (getWeapon()!=WEAPON_AXE) {
setWeapon(WEAPON_AXE);	
}
while (canUseWeapon(WEAPON_AXE, leek2) && getTP()>=getWeaponCost(WEAPON_AXE) && isAlive(leek2)) {
useWeapon(leek2);	
}
}

if (getAbsoluteShield(leek2) <= 5 && getRelativeShield(leek2) <= 5 && getPathLength(getCell(), getCellToUseChip(CHIP_LIGHTNING, leek2))<=getMP()) {
	moveTowardCell(getCellToUseChip(CHIP_LIGHTNING, leek2));
	while (getTP()>=getChipCost(CHIP_LIGHTNING) && canUseChip(CHIP_LIGHTNING, leek2)) {
	if (getLife(leek2) > 0) {
		useChipOnCell(CHIP_LIGHTNING, useCHiporWeaponarea(CHIP_LIGHTNING, 2, leek2));
	}
		}
	if (getTP() < 2) {
		moveTowardCell(tableaucellscacher());

	}
}

if (getCooldown(CHIP_LIBERATION) > 0 && dist <= 11 && disto > 5 && bouclier() == true) {
	moveTowardCell(getCellToUseWeaponOnCell(WEAPON_GRENADE_LAUNCHER, leek2));

	if (getWeapon() != WEAPON_GRENADE_LAUNCHER) {
		setWeapon(WEAPON_GRENADE_LAUNCHER);

	}
	if (getLife(leek2)>0) {
		useWeaponOnCell(useCHiporWeaponarea(WEAPON_GRENADE_LAUNCHER, 2, leek2));
	}
	if (getLife(leek2)>0) {
		useWeaponOnCell(useCHiporWeaponarea(WEAPON_GRENADE_LAUNCHER, 2, leek2));
	}
	
	
}
summon(CHIP_METALLIC_BULB, getCellToUseChip(CHIP_METALLIC_BULB, getLeek()), bulbeMetalique);
summon(CHIP_HEALER_BULB, getCellToUseChip(CHIP_HEALER_BULB, getLeek()), bulbeSoigneur);
summon(CHIP_ICED_BULB, getCellToUseChip(CHIP_ICED_BULB, getLeek()), bulbAI);
summon(CHIP_ROCKY_BULB, getCellToUseChip(CHIP_ROCKY_BULB, getLeek()), bulbeRocheux);
summon(CHIP_PUNY_BULB, getCellToUseChip(CHIP_PUNY_BULB, getLeek()), bulbechetif);



if (getLife()<getTotalLife()) { useChip(CHIP_VACCINE, getLeek());	
}

useChipOnCell(CHIP_ROCKFALL, useCHiporWeaponarea(CHIP_ROCKFALL, 2, enemy));

if (getTP()<=12) {moveTowardCell(tableaucellscacher());}