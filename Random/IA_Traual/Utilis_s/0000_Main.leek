/* if (getFightContext()==FIGHT_CONTEXT_CHALLENGE) {
 var i;
 	say("Attends je reflechis");
	while (true) {
		i++;
	}
 } */
if(getTurn()==1) {
    _SHOULD_KEEP_MAINWEAP_INHAND = true;
    getMainWeapon = function(){
        if(true) return WEAPON_GAZOR;
        if(getLife(_NEAREST_ENEMY_LEEK)<=0) _NEAREST_ENEMY_LEEK = getNearestEnemyLeek();
        return getCellDistance(getCell(), getCell(_NEAREST_ENEMY_LEEK)) <= getTotalMP() ? WEAPON_KATANA : WEAPON_GAZOR;
    };
    failSafe = function(){
        if(getTP()>=15 && getCooldown(CHIP_RESURRECTION)==0 && _RESU_TARGET!=null && !isSummon(_RESU_TARGET)){
            var cell = findSafestCellToRez(_RESU_TARGET, getCell());
            resurrect(_RESU_TARGET, cell);
        }
        var arrayTrySummon = [CHIP_METALLIC_BULB, CHIP_HEALER_BULB, CHIP_LIGHTNING_BULB, CHIP_FIRE_BULB, CHIP_ICED_BULB, CHIP_ROCKY_BULB, CHIP_PUNY_BULB];
        if(_COUNT_METAL>2) removeElement(arrayTrySummon, CHIP_METALLIC_BULB);
        for(var item in arrayTrySummon){
            if(getTP()>=getChipCost(item) && getCooldown(item)==0){
                summon(item, getCellToUseChip(item, _SELF), ia_bulb_main);
            }
        }
        var arrayTryChip = [CHIP_ARMORING, CHIP_REMISSION, CHIP_BANDAGE];
        for(var item in arrayTryChip){
            if(getTP()>=getChipCost(item) && getCooldown(item)==0){
                useChip(item, _SELF);
            }
        }
        var arrayTryIfNotOnEffect = [CHIP_VACCINE, CHIP_FORTRESS, CHIP_ARMOR, CHIP_WALL, CHIP_SHIELD, CHIP_HELMET];
        for(var item in arrayTryIfNotOnEffect){
            if(getTP()>=getChipCost(item) && getCooldown(item)==0){
                if(_LEEKS[_SELF][_effects][item]==null)
                    useChip(item, _SELF);
            }
        }
    };
    getTeleportComboSet = function(){
        var combos = [], inHand = getWeapon();
        var TP = getTP()-_ITEM_COST[CHIP_TELEPORTATION];
        if(TP>=14 && inHand==WEAPON_GAZOR) push(combos, [WEAPON_GAZOR, WEAPON_GAZOR]);
        if(TP>=14 && inHand==WEAPON_KATANA) push(combos, [WEAPON_KATANA, WEAPON_KATANA]);
        return @combos;
    };
}

//end if turn 1

useChip(CHIP_MOTIVATION, getLeek());
useChip(CHIP_RAGE, getLeek());
 
// ADD INVERSION
if(count(_areaCells1[getCell()])==1){
    for(var cell in _areaCells1[getCell()]){
        var leek = getLeekOnCell(cell);
        if(leek != -1){
            useChip(CHIP_INVERSION, leek);
            countUsage(CHIP_INVERSION);
        }
    }
}
// ADD INVERSION
 
refreshLeeksCellsAndAliveStatus();
refreshLeeksEffectsAndStates();
 
// ADD ANTIDOTE
if(_LEEKS[_SELF][_psnTotal] > 600){
    useChip(CHIP_ANTIDOTE, _SELF);
    countUsage(CHIP_ANTIDOTE);
    refreshLeeksEffectsAndStates();
}
// ADD ANTIDOTE
 
reachableCells = getReachableCells([getCell():0], getMP(), []);

// CHECK TELE-LIBERATE

for(var e in getAliveEnemies()){
    if(!isSummon(e) && _LEEKS[e][_alterateStr] > 300){// 300 A LA BASE JE MET A 250 POUR TESTER 
        if(_ENCODING_STUFF[CHIP_LIBERATION]!=null && getCooldown(CHIP_LIBERATION)==0){
            var cellFrom = getCellToUseChip(CHIP_LIBERATION, e);
            if(reachableCells[cellFrom] != null){
                moveTowardCell(cellFrom);
                useChip(CHIP_LIBERATION, e);
            }else if(_IS_TELEPORT && getCooldown(CHIP_TELEPORTATION)==0){
                var cellFromTele = getCellToUseChipOnCell(CHIP_TELEPORTATION, cellFrom);
                var dist = reachableCells[cellFromTele];
                if(dist!=null && dist< getFightType()==FIGHT_TYPE_SOLO? getMP(): getMP()/2){
                    moveTowardCell(cellFromTele);
                    useChipOnCell(CHIP_TELEPORTATION, cellFrom);
                    countUsage(CHIP_TELEPORTATION);
                    useChip(CHIP_LIBERATION, e);
                }else break;
            }else break;
            countUsage(CHIP_LIBERATION);
            refreshLeeksCellsAndAliveStatus();
            refreshLeeksEffectsAndStates();
            reachableCells = getReachableCells([getCell():0], getMP(), []);
        }
        else debug("fuck j'ai pas libé... :(");
    }
}

//TEST A RETIRER JUSQU'A : CHECK TELE LIBERATE !'
 
// choix de la gravityCell
global distToEnemyLeek= _SNC_200 && _STR_300 ? 14 : 7;
if(getTurn()%10==0 && distToEnemyLeek>0)distToEnemyLeek--;
refreshGravityCells(distToEnemyLeek);
 
loadMapsDanger(_OPERATION_MAP_DANGER);
updateCoef(null);
setMapActions();
 
playBestMove(findBestMove(getComboSet(_SELF)));
 
 PkTuDisSa();
sayCupidon();
displayBench();
debugW('TOTALOP:' + round(getOperations()/1000) +"k");