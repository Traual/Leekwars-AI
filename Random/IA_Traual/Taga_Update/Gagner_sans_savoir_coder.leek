function MustRegen() {
	if (getLife() < 600 && getCooldown(CHIP_REGENERATION) == 0) {
		return true;
	}
	/*if (getLife()<getTotalLife() - 200*(1+getWisdom()/100)) {
		return true ;
	}
	*/
}

if (MustRegen()) {
	useChip(CHIP_REGENERATION, getLeek());
}
