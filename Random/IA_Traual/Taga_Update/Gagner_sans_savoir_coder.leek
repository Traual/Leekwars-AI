/////////////////////////////////////////////////////////////////////////////////////////////
//PRELOAD Turn 1
//
///////////////////////////////////////////////////////////////////////////////////////////
global TpKill = false;

if (getTurn() == 1) {
	_SHOULD_KEEP_MAINWEAP_INHAND = true;
	getMainWeapon = function() {
		if (true) return WEAPON_GAZOR;
		if (getLife(_NEAREST_ENEMY_LEEK) <= 0) _NEAREST_ENEMY_LEEK = getNearestEnemyLeek();
		return getCellDistance(getCell(), getCell(_NEAREST_ENEMY_LEEK)) <= getTotalMP() ? WEAPON_KATANA : WEAPON_GAZOR;
	};
	failSafe = function() {
		if (getTP() >= 15 && getCooldown(CHIP_RESURRECTION) == 0 && _RESU_TARGET != null && !isSummon(_RESU_TARGET)) {
			var cell = findSafestCellToRez(_RESU_TARGET, getCell());
			resurrect(_RESU_TARGET, cell);
		}
		var arrayTrySummon = [CHIP_HEALER_BULB, CHIP_METALLIC_BULB, CHIP_LIGHTNING_BULB, CHIP_FIRE_BULB, CHIP_ICED_BULB, CHIP_ROCKY_BULB, CHIP_PUNY_BULB];
		if (getAbsoluteShield() > 150 && _COUNT_METAL > 5) removeElement(arrayTrySummon, CHIP_METALLIC_BULB);
		for (var item in arrayTrySummon) {
			if (getTP() >= getChipCost(item) && getCooldown(item) == 0) {
				summon(item, getCellToUseChip(item, _SELF), ia_bulb_main);
			}
		}
		var arrayTryChip = [CHIP_ARMORING, CHIP_REMISSION, CHIP_BANDAGE];
		for (var item in arrayTryChip) {
			if (getTP() >= getChipCost(item) && getCooldown(item) == 0) {
				useChip(item, _SELF);
			}
		}
		var arrayTryIfNotOnEffect = [CHIP_VACCINE, CHIP_FORTRESS, CHIP_ARMOR, CHIP_WALL, CHIP_SHIELD, CHIP_HELMET];
		for (var item in arrayTryIfNotOnEffect) {
			if (getTP() >= getChipCost(item) && getCooldown(item) == 0) {
				if (_LEEKS[_SELF][_effects][item] == null) useChip(item, _SELF);
			}
		}
	};
	getTeleportComboSet = function() {
		var combos = [],
			inHand = getWeapon();
		var TP = getTP() - _ITEM_COST[CHIP_TELEPORTATION];
		if (TP >= 14 && inHand == WEAPON_GAZOR) push(combos, [WEAPON_GAZOR, WEAPON_GAZOR]);
		if (TP >= 14 && inHand == WEAPON_KATANA) push(combos, [WEAPON_KATANA, WEAPON_KATANA]);
		return @combos;
	};
}

if (TpKill && getFightType() == FIGHT_TYPE_SOLO && getScience() >= 500) {
	if (getTurn() == 1) {
		useChip(CHIP_REFLEXES, getLeek());
		useChip(CHIP_STRETCHING, getLeek());
		useChip(CHIP_RAGE, getLeek());
		useChip(CHIP_MOTIVATION, getLeek());
		useChip(CHIP_DOPING, getLeek());
		setWeapon(WEAPON_ELECTRISOR);
		moveTowardCell(useChipOnCell(CHIP_TELEPORTATION, getCellToUseWeapon(WEAPON_ELECTRISOR, _NEAREST_ENEMY_LEEK)));
		while (true) {
			say("Tu vas Kiffer Jusqu'a la fin quite a mourrir d'une éspéctase");
		}
	}
	if (getTurn() == 2) {
		if (getWeapon() != WEAPON_ELECTRISOR) {
			setWeapon(WEAPON_ELECTRISOR);
		}
		moveTowardCell(useChipOnCell(CHIP_TELEPORTATION, getCellToUseWeapon(WEAPON_ELECTRISOR, _NEAREST_ENEMY_LEEK)));
		useChipOnCell(CHIP_TELEPORTATION, getCellToUseWeapon(WEAPON_ELECTRISOR, _NEAREST_ENEMY_LEEK));
		useChip(CHIP_PROTEIN, getLeek());
		while (getTP() >= getWeaponCost(WEAPON_ELECTRISOR) && canUseWeapon(_NEAREST_ENEMY_LEEK)) {
			useWeapon(_NEAREST_ENEMY_LEEK);
		}
		if (getEnemiesCount() == 0) {
			say("EZZZZZZZZZZ Je t'ai soulevé :)");
		} else say("Oh Merde J'ai raté");
	}
}

