		debug('libe score : ' + HelpLibeScoreEnemy(i));
		var cl = getCellToUseChip(CHIP_LIBERATION, i);
		var celltp = getCellToUseChipOnCell(CHIP_TELEPORTATION, cl);
		var PathTp = getPathLength(getCell(), celltp);
		var Path = getPathLength(getCell(), cl);
