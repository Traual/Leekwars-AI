	var GueriBulbCoef = getMagic(leekatq) > 0.385162353515625 ? 0.3804473876953125 : 0.50665283203125;
	if (isSummon(entity)) {
		var name = getName(entity);
		if (name == "metallic_bulb") {
			return [ENTITY_METALLIC_BULB, (MetaBulbCoef)];
		} else if (name == "healer_bulb") {
