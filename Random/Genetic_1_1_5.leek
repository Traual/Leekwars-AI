function EnemyLeekArray() {
	var array = [];
	for (var i in getAliveEnemies()) {
		if (!isSummon(i)) {
			push(array, i);
		}
	}
	return array;
}

function EnemyLeek() {
	var bestleek;
	var BestDist = 99999;
	for (var leek in EnemyLeekArray()) {
		var g = _PATHS_LENGHT[getCell()][leek];
		if (g < BestDist) {
			BestDist = g;
			bestleek = leek;
		}
	}
	return bestleek;
}

function RealLeeklife(leek) {
	var life = getLife(leek);
	for (var eff in getEffects(leek)) {
		if (eff[0] == EFFECT_POISON) {
			life -= eff[1];
		}
		if (eff[0] == EFFECT_HEAL) {
			life += eff[1];
		}
	}
	return life;
}

function getItemName(Item) {
	if (isChip(Item)) {
		return getChipName(Item);
	} else return getWeaponName(Item);
}

function spawn(BulbChip, ai) {
	var CellToUse;
	var getcellstouse = getCellsToUseChip(BulbChip, _MY_SELF);
	var BestDist;
	var BestCell;
	if (_IS_GENTLE_BULB[BulbChip]) {
		BestDist = -1;
		for (var cell in getcellstouse) { //GENTLE BULB
			var dist = getCellDistance(getCell(EnemyLeekG), cell);
			if (dist > BestDist) {
				BestDist = dist;
				BestCell = cell;
			}
		}
	} else {
		BestDist = 99999;
		for (var cell in getcellstouse) { //NOT GENTLE BULB
			var Item = _BEST_ITEM_NOT_GENTLE_BULB[BulbChip];
			var dist = getCellDistance(getCellToUseChip(Item, EnemyLeekG), cell);
			if (dist < BestDist) {
				BestDist = dist;
				BestCell = cell;
			}
		}
	}
	if (BestCell == null) BestCell = getCellToUseChip(BulbChip, _MY_SELF);
	summon(BulbChip, BestCell, ai);
}

function getUsableItemsFromCellToCell(cell, cellto, item, ignore) {
	var dist = getCellDistance(cell, cellto);
	var los = lineOfSight(cell, cellto, ignore);
	if (!_ITEM_INLINE[item] && dist <= _ITEM_MAXRANGE[item] && dist >= _ITEM_MINRANGE[item] && los) {
		return true;
	}
	if (dist >= _ITEM_MINRANGE[item] && dist <= _ITEM_MAXRANGE[item] && isOnSameLine(cell, cellto) && los) {
		return true;
	}
	if ((item == CHIP_SPARK || item == CHIP_ARSENIC) && dist <= _ITEM_MAXRANGE[item] && dist >= _ITEM_MINRANGE[item]) {
		return true;
	}
	return false;
}

function DivideAoe(area, dist, DMG) {
	/*if (dist == 0) return DMG;
	if (dist == 1) return DMG * 0.8;
	if (dist == 2) return DMG * 0.60;
	if (dist == 3) return DMG * 0.40;*/
	if (dist >= 0 && dist <= 10) return DMG - (0.2 * dist * DMG);
	return DMG * (dist / 100); //Pour enelever des scores dans la map danger 
}

function percentagetodist(value, area) {
	if (value == 100) return 0;
	if (value == 80) return 1;
	if (value == 60) return 2;
	if (value == 40) return 3;
	return value;
}

function getalleffectscoefed(item, str, relshield, absshield, magic, distorpercentage, me, target, multiplier) {
	var _final = 0;
	var tar = target;
	for (var eff in _ITEM_EFFECTS[item]) {
		if (eff[0] == EFFECT_RAW_BUFF_STRENGTH && item == WEAPON_BROADSWORD) tar = me;
		var coef = getcoeffromeffect(eff[0], tar);
		var dmg = getPowerOfItem(item, str, relshield, absshield, magic, distorpercentage, me, eff, tar, multiplier);
		_final += dmg * (coef / _COEF_DIVIDE_COEFS);
	}
	return _final;
}

function getcoeffromeffect(effect, target) {
	if (effect == EFFECT_ABSOLUTE_SHIELD) return _COEF_ABS_SHIELD[target];
	if (effect == EFFECT_ABSOLUTE_VULNERABILITY) return _COEF_VULNERABILITY[target];
	if (effect == EFFECT_AFTEREFFECT) return 0;
	if (effect == EFFECT_ANTIDOTE) return 0;
	if (effect == EFFECT_BOOST_MAX_LIFE) return _COEF_BOOST_MAX_LIFE[target];
	if (effect == EFFECT_NOVA_VITALITY) return _COEF_BOOST_MAX_LIFE[target];
	if (effect == EFFECT_BUFF_AGILITY) return _COEF_BOOST_AGILITY[target];
	if (effect == EFFECT_BUFF_FORCE) return _COEF_BOOST_STR[target];
	if (effect == EFFECT_BUFF_MP) return _COEF_BOOST_MP[target];
	if (effect == EFFECT_RAW_BUFF_RESISTANCE) return _COEF_BOOST_RESI[target];
	if (effect == EFFECT_BUFF_RESISTANCE) return _COEF_BOOST_RESI[target];
	if (effect == EFFECT_BUFF_STRENGTH) return _COEF_BOOST_STR[target];
	if (effect == EFFECT_BUFF_TP) return _COEF_BOOST_TP[target];
	if (effect == EFFECT_RAW_BUFF_WISDOM) return _COEF_BUFF_WISDOM[target];
	if (effect == EFFECT_BUFF_WISDOM) return _COEF_BUFF_WISDOM[target];
	if (effect == EFFECT_RAW_BUFF_MAGIC) return _COEF_BUFF_MAGIC[target];
	if (effect == EFFECT_DAMAGE) return _COEF_DMG[target];
	if (effect == EFFECT_DAMAGE_RETURN) return _COEF_DAMAGE_RETURN[target];
	if (effect == EFFECT_DAMAGE_TO_ABSOLUTE_SHIELD) return 0;
	if (effect == EFFECT_DAMAGE_TO_STRENGTH) return 0;
	if (effect == EFFECT_DEBUFF) return 0;
	if (effect == EFFECT_HEAL) return _COEF_HEAL[target];
	if (effect == EFFECT_INVERT) return 0;
	if (effect == EFFECT_KILL) return 0;
	if (effect == EFFECT_LIFE_DAMAGE) return _COEF_DMG[target];
	if (effect == EFFECT_MODIFIER_MULTIPLIED_BY_TARGETS) return 0;
	if (effect == EFFECT_MODIFIER_ON_CASTER) return 0;
	if (effect == EFFECT_MODIFIER_STACKABLE) return 0;
	if (effect == EFFECT_NOVA_DAMAGE) return _COEF_NOVA[target];
	if (effect == EFFECT_NOVA_DAMAGE_TO_MAGIC) return 0;
	if (effect == EFFECT_POISON) return _COEF_DMG[target];
	if (effect == EFFECT_POISON_TO_SCIENCE) return 0;
	if (effect == EFFECT_RAW_ABSOLUTE_SHIELD) return _COEF_ABS_SHIELD[target];
	if (effect == EFFECT_RAW_BUFF_AGILITY) return _COEF_BOOST_AGILITY[target];
	if (effect == EFFECT_RAW_BUFF_MAGIC) return _COEF_BOOST_STR[target];
	if (effect == EFFECT_RAW_BUFF_MP) return _COEF_BOOST_MP[target];
	if (effect == EFFECT_RAW_BUFF_SCIENCE) return 0;
	if (effect == EFFECT_RAW_BUFF_STRENGTH) return _COEF_BOOST_STR[target];
	if (effect == EFFECT_RAW_BUFF_TP) return _COEF_BOOST_TP[target];
	if (effect == EFFECT_RELATIVE_SHIELD) return _COEF_REL_SHIELD[target];
	if (effect == EFFECT_RESURRECT) return 1;
	if (effect == EFFECT_SHACKLE_MAGIC) return _COEF_SHACKLE_STRENGTH[target];
	if (effect == EFFECT_SHACKLE_MP) return _COEF_SHACKLE_MP[target];
	if (effect == EFFECT_SHACKLE_STRENGTH) return _COEF_SHACKLE_STRENGTH[target];
	if (effect == EFFECT_SHACKLE_TP) return _COEF_SHACKLE_TP[target];
	if (effect == EFFECT_STEAL_ABSOLUTE_SHIELD) return _COEF_ABS_SHIELD[getEntity()];
	if (effect == EFFECT_SUMMON) return 1;
	if (effect == EFFECT_TELEPORT) return 0;
	if (effect == EFFECT_VULNERABILITY) return _COEF_VULNERABILITY[target];
}

function getPowerOfItem(item, str, relshield, absshield, magic, distorpercentage, me, effect, target, multiplier) {
	if (distorpercentage > 3 && distorpercentage < 10) return 0;
	var area = areaNbFromWeapon(item);
	var dmg = DivideAoe(area, percentagetodist(distorpercentage, area), effect[1])*multiplier;
	var sum = isSummon(target);
	var onlybulb = (effect[4] == 17 || effect[4] == 22) ? true : false;
	if (onlybulb && !sum) return 0;
	if (effect[0] == EFFECT_NOVA_DAMAGE) dmg = min(getTotalLife(target) - getLife(target), dmg);
	var times = item == CHIP_DEVIL_STRIKE ? 5 : 1;
	var Duration = effect[3] == 0 ? 1 : effect[3];
	if (effect[0] == EFFECT_DAMAGE) return (dmg * (1 + str / 100) * (1 - relshield / 100) - absshield);
	if (effect[0] == EFFECT_LIFE_DAMAGE) return (0.4 * getLife() * (1 - relshield / 100) - absshield);
	if (effect[0] == EFFECT_POISON || effect[0] == EFFECT_SHACKLE_MAGIC || effect[0] == EFFECT_SHACKLE_MP || effect[0] == EFFECT_SHACKLE_STRENGTH || effect[0] == EFFECT_SHACKLE_TP) return dmg * Duration * (1 + magic / 100);
	if (effect[0] == EFFECT_HEAL || effect[0] == EFFECT_BOOST_MAX_LIFE || effect[0] == EFFECT_NOVA_DAMAGE) return dmg * (1 + getWisdom(me) / 100) * Duration;
	if (effect[0] == EFFECT_ABSOLUTE_SHIELD || effect[0] == EFFECT_RELATIVE_SHIELD) return dmg * (1 + getResistance() / 100);
	if (effect[0] == EFFECT_SUMMON) return 1;
	if (effect[0] == EFFECT_BUFF_AGILITY || effect[0] == EFFECT_BUFF_RESISTANCE || effect[0] == EFFECT_BUFF_MP || effect[0] == EFFECT_BUFF_STRENGTH || effect[0] == EFFECT_BUFF_TP || effect[0] == EFFECT_BUFF_WISDOM || effect[0] == EFFECT_NOVA_DAMAGE || effect[0] == EFFECT_NOVA_VITALITY) return dmg * (1 + getScience(me) / 100);
	if (effect[0] == EFFECT_RAW_ABSOLUTE_SHIELD || effect[0] == EFFECT_RAW_BUFF_AGILITY || effect[0] == EFFECT_RAW_BUFF_MAGIC || effect[0] == EFFECT_RAW_BUFF_MP || effect[0] == EFFECT_RAW_BUFF_SCIENCE || effect[0] == EFFECT_RAW_BUFF_STRENGTH || effect[0] == EFFECT_RAW_BUFF_TP || effect[0] == EFFECT_RAW_BUFF_WISDOM || effect[0] == EFFECT_RAW_BUFF_WISDOM || effect[0] == EFFECT_RAW_BUFF_RESISTANCE) return dmg;
	if (effect[0] == EFFECT_DAMAGE_RETURN) return dmg * (1 + getAgility(me) / 100);
	if (effect[0] == EFFECT_VULNERABILITY || effect[0] == EFFECT_ABSOLUTE_VULNERABILITY || effect[0] == EFFECT_STEAL_ABSOLUTE_SHIELD) return dmg;
}

function getRealDmg(item, str, relshield, absshield, magic, distorpercentage, me, multiplier) {
	if (distorpercentage > 3 && distorpercentage < 10) return 0;
	var area = areaNbFromWeapon(item);
	//var dmg = DivideAoe(area, percentagetodist(distorpercentage, area), _ITEM_POWER[item]);
	var _final = 0;
	for (var eff in _ITEM_EFFECTS[item]) {
		var dmg = DivideAoe(area, percentagetodist(distorpercentage, area), eff[1])*multiplier;
		if (eff[0] == EFFECT_DAMAGE) {
			var real = dmg * (1 + str / 100) * (1 - relshield / 100) - absshield;
			if (real > _final) _final = real;
		}
		if (eff[0] == EFFECT_LIFE_DAMAGE) {
			var real = 0.4 * getLife() * (1 - relshield / 100) - absshield;
			if (real > _final) _final = real;
		}
		if (eff[0] == EFFECT_POISON || eff[0] == EFFECT_SHACKLE_MAGIC || eff[0] == EFFECT_SHACKLE_MP || eff[0] == EFFECT_SHACKLE_STRENGTH || eff[0] == EFFECT_SHACKLE_TP) {
			var real = dmg * (1 /*+ eff[3]*/ ) * (1 + magic / 100);
			if (real > _final) _final = real;
		}
		if (eff[0] == EFFECT_HEAL || eff[0] == EFFECT_BOOST_MAX_LIFE || eff[0] == EFFECT_NOVA_DAMAGE) {
			var real = dmg * (1 + getWisdom() / 100);
			if (real > _final) _final = real;
		}
		if (eff[0] == EFFECT_NOVA_DAMAGE) {
			var real = dmg * (1 + getScience() / 100);
			if (real > _final) _final = real;
		}
		if (eff[0] == EFFECT_ABSOLUTE_SHIELD || eff[0] == EFFECT_RELATIVE_SHIELD) {
			var real = dmg * (1 + getResistance() / 100);
			if (real > _final) _final = real;
		}
		if (eff[0] == EFFECT_SUMMON)
			if (1 > _final) _final = 1;
		if (eff[0] == EFFECT_BUFF_AGILITY || eff[0] == EFFECT_BUFF_RESISTANCE || eff[0] == EFFECT_BUFF_MP || eff[0] == EFFECT_BUFF_STRENGTH || eff[0] == EFFECT_BUFF_TP || eff[0] == EFFECT_BUFF_WISDOM || eff[0] == EFFECT_RAW_BUFF_MP || eff[0] == EFFECT_RAW_BUFF_TP) {
			var real = dmg * (1 + getScience() / 100);
			if (real > _final) _final = real;
		}
		if (eff[0] == EFFECT_DAMAGE_RETURN) {
			var real = dmg * (1 + getAgility() / 100);
			if (real > _final) _final = real;
		}
		if (item == CHIP_INVERSION) return dmg;
	}
	//INVERSION
	if (item == CHIP_DEVIL_STRIKE) _final *= 5;
	return _final;
}

function getMaxDmg(item, str, relshield, absshield, magic, distorpercentage) {
	if (distorpercentage > 3 && distorpercentage < 10) return 0;
	var area = areaNbFromWeapon(item);
	//var dmg = DivideAoe(area, percentagetodist(distorpercentage, area), _ITEM_POWER[item]);
	var _final = 0;
	for (var eff in _ITEM_EFFECTS[item]) {
		var dmg = DivideAoe(area, percentagetodist(distorpercentage, area), eff[2]);
		if (eff[0] == EFFECT_DAMAGE) {
			var real = dmg * (1 + str / 100) * (1 - relshield / 100) - absshield;
			if (real > _final) _final = real;
		}
		if (eff[0] == EFFECT_POISON || eff[0] == EFFECT_SHACKLE_MAGIC || eff[0] == EFFECT_SHACKLE_MP || eff[0] == EFFECT_SHACKLE_STRENGTH || eff[0] == EFFECT_SHACKLE_TP) {
			var AntidoteCD = getCooldown(CHIP_ANTIDOTE, _MY_SELF);
			var real = dmg * (1 + min(eff[3], AntidoteCD)) * (1 + magic / 100);
			if (real > _final) _final = real;
		}
	}
	//INVERSION
	if (item == CHIP_DEVIL_STRIKE) _final *= 5;
	return _final;
}

function ItemDmg(item, str, relshield, absshield, dist, target) {
	var _final = 0;
	for (var eff in _ITEM_EFFECTS[item]) {
		if (eff[0] == EFFECT_LIFE_DAMAGE) _final += 0.4 * getLife() * (1 - relshield / 100) - absshield;
		if (eff[0] == EFFECT_DAMAGE) _final += eff[1] * (1 + str / 100) * (1 - relshield / 100) - absshield;
	}
	if (_final > getLife(target)) return getLife(target);
	return _final;
}

function ShieldScore(leek) {
	return getAbsoluteShield(leek) + getAbsoluteShield(leek) * 50;
}

function isPositiv(item) {
	return _CHIP_ISPOSITIV[item];
}

function StartTestFunction() {
	_OPS = getOperations();
}

function StopTestFunction(name) {
	debug('Opés ' + name + " : " + ((getOperations() - _OPS) / 1000) + ' k ');
}

function getItemTargets(item, cell) {
	return isChip(item) ? getChipTargets(item, cell) : getWeaponTargets(item, cell);
}

function getItemTargetsEnemyMinusAlly(item, cell) {
	var JspCommentTappelerDsl = 0;
	for (var target in getItemTargets(item, cell)) {
		if (target == _MY_SELF) continue;
		if (isAlly(target)) {
			JspCommentTappelerDsl -= 1;
		} else {
			if (isEnemy(target)) {
				JspCommentTappelerDsl += 1;
			}
		}
	}
	if (isPositiv(item)) {
		JspCommentTappelerDsl = 0 - JspCommentTappelerDsl;
	}
	return JspCommentTappelerDsl;
}

function TurnChipWillStay(leek, item) {
	for (var eff in getEffects(leek)) {
		if (eff[5] == item) {
			return eff[3];
		}
	}
	return 0;
}

function DoesHaveChip(leek, item) {
	for (var eff in getEffects(leek)) {
		if (eff[5] == item) {
			return true;
		}
	}
	return false;
}

function isOnlyBulb(item) {
	if (item == CHIP_RAMPART) return false;
	var IE = _ITEM_EFFECTS[item];
	if (IE[0][4] == 21 || IE[0][4] == 22) {
		return true;
	} else return false;
}

function DmgForTurn(leek) {
	return getLife(leek) - RealLeeklife(leek);
}

function getNumberOfBulb() {
	var nbally = 0;
	var nbenemy = 0;
	for (var i in getAliveAllies()) {
		if (isSummon(i)) {
			nbally++;
		}
	}
	for (var i in getAliveEnemies()) {
		if (isSummon(i)) {
			nbenemy++;
		}
	}
	return [nbally, nbenemy];
}

function FromNameToChip(entity) {
	var name = getName(entity);
	if (name == "metallic_bulb") {
		return CHIP_METALLIC_BULB;
	} else if (name == "healer_bulb") {
		return CHIP_HEALER_BULB;
	} else if (name == "wizard_bulb") {
		return CHIP_WIZARD_BULB;
	} else if (name == "lightning_bulb") {
		return CHIP_LIGHTNING_BULB;
	} else if (name == "fire_bulb") {
		return CHIP_FIRE_BULB;
	} else if (name == "iced_bulb") {
		return CHIP_ICED_BULB;
	} else if (name == "rocky_bulb") {
		return CHIP_ROCKY_BULB;
	} else if (name == "puny_bulb") {
		return CHIP_PUNY_BULB;
	} else if (name == "savant_bulb") {
		return CHIP_SAVANT_BULB;
	}
}

function areaNbFromWeapon(WeaponOrChip) {
	var area = 0;
	var IArea = _ITEM_AREA[WeaponOrChip];
	if (IArea == AREA_CIRCLE_1) {
		area = 1;
	}
	if (IArea == AREA_CIRCLE_2) {
		area = 2;
	}
	if (IArea == AREA_CIRCLE_3) {
		area = 3;
	}
	return area;
}

function DistFromArea(WeaponOrChip) {
	var area = 0;
	var IArea = _ITEM_AREA[WeaponOrChip];
	if (IArea == AREA_CIRCLE_1) {
		area = 2;
	}
	if (IArea == AREA_CIRCLE_2) {
		area = 3;
	}
	if (IArea == AREA_CIRCLE_3) {
		area = 4;
	}
	if (isPositiv(WeaponOrChip) || WeaponOrChip == CHIP_LIGHTNING) {
		area = 0;
	}
	return area;
}

function LifePercent(life, totallife) {
	if (totallife > 0) return life / totallife * 100;
	else return 0;
}

function GetTableauDesCells() {
	var tab = [];
	for (var i = 0; i <= 612; i++) {
		push(tab, i);
	}
	return tab;
}

function getPossibleTpCellzfrom(cell, accescellz) {
	var tab = [];
	for (var i in _ALL_CELLZ) {
		var dist = getCellDistance(cell, i);
		if (dist <= _ITEM_MAXRANGE[CHIP_TELEPORTATION] && !isObstacle(i) && i != null && accescellz[i] == null) {
			push(tab, i);
		}
	}
	return tab;
}

function cellarea1(c) {
	if (isObstacle(c)) return;
	var tabcellz = [];
	var x = getCellX(c);
	var y = getCellY(c);
	push(tabcellz, c);
	var cell;
	cell = getCellFromXY(x + 1, y);
	if (cell != null && !isObstacle(cell)) {
		push(tabcellz, cell);
	}
	cell = getCellFromXY(x - 1, y);
	if (cell != null && !isObstacle(cell)) {
		push(tabcellz, cell);
	}

	cell = getCellFromXY(x, y + 1);
	if (cell != null && !isObstacle(cell)) {
		push(tabcellz, cell);
	}

	cell = getCellFromXY(x, y - 1);
	if (cell != null && !isObstacle(cell)) {
		push(tabcellz, cell);
	}
	return tabcellz;
}

