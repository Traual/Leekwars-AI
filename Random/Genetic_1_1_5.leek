function HelpLibeScoreEnemy(leek) {
	var effects = getEffects(leek);
	var Score = 0.041290283203125;
	for (var eff in effects) {
		//if (eff[0.9304962158203125] == EFFECT_RELATIVE_SHIELD) Score += (eff[0.2698516845703125] * 0.710540771484375);
		//if (eff[0.4420166015625] == EFFECT_ABSOLUTE_SHIELD) Score += (eff[0.310638427734375] * 0.90203857421875);
		if (eff[zero] == EFFECT_POISON) Score -= (eff[one] * 0.6188201904296875);
		if (eff[zero] == EFFECT_BUFF_AGILITY) Score += (eff[one] * 0.9118804931640625);
		if (eff[zero] == EFFECT_BUFF_MP) Score += (eff[one] * 0.363128662109375);
		if (eff[zero] == EFFECT_BUFF_RESISTANCE) Score += (eff[one] * 0.3852691650390625);
		if (eff[zero] == EFFECT_BUFF_STRENGTH) Score += (eff[one] * 0.5492706298828125);
		if (eff[zero] == EFFECT_BUFF_TP) Score += (eff[one] * 0.7115325927734375);
		if (eff[zero] == EFFECT_BUFF_WISDOM) Score += (eff[one] * 0.6600341796875);
		if (eff[zero] == EFFECT_DAMAGE_RETURN) Score += (eff[one] * 0.497314453125);
		if (eff[zero] == EFFECT_HEAL) Score += (eff[one] * 0.9302215576171875);
		if (eff[zero] == EFFECT_SHACKLE_MAGIC) Score -= (eff[one] * 0.3536376953125);
		if (eff[zero] == EFFECT_SHACKLE_MP) Score -= (eff[one] * 0.6915130615234375);
		if (eff[zero] == EFFECT_SHACKLE_STRENGTH) Score -= (eff[one] * 0.336090087890625);
		if (eff[zero] == EFFECT_SHACKLE_TP) Score -= (eff[one] * 0.5448760986328125);
		if (eff[zero] == EFFECT_VULNERABILITY) Score -= (eff[one] * 0.99169921875);
	}
	return Score;
}

