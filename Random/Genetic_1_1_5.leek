function getArrayComboBulbSorted(entity) {
	if (entity == ENTITY_ICED_BULB) return [CHIP_ICEBERG, CHIP_STALACTITE, CHIP_WARM_UP, CHIP_ICE];
	if (entity == ENTITY_HEALER_BULB) return [CHIP_VACCINE, CHIP_CURE, CHIP_DRIP, CHIP_BANDAGE];
	if (entity == ENTITY_ROCKY_BULB) return [CHIP_ROCKFALL, CHIP_HELMET, CHIP_ROCK, CHIP_PEBBLE];
	if (entity == ENTITY_PUNY_BULB) return [CHIP_PROTEIN, CHIP_BANDAGE, CHIP_HELMET, CHIP_PEBBLE];
	if (entity == ENTITY_METALLIC_BULB) return [CHIP_ARMOR, CHIP_WINGED_BOOTS, CHIP_SHIELD, CHIP_WALL];
	if (entity == ENTITY_FIRE_BULB) return [CHIP_METEORITE, CHIP_DEVIL_STRIKE, CHIP_FLAME, CHIP_SPARK];
	if (entity == ENTITY_LIGHTNING_BULB) return [CHIP_STEROID, CHIP_LIGHTNING, CHIP_FLASH, CHIP_SHOCK];
	if (entity == ENTITY_WIZARD_BULB) return [CHIP_TOXIN, CHIP_VENOM, CHIP_SLOW_DOWN, CHIP_TRANQUILIZER];
	if (entity == ENTITY_SAVANT_BULB) return [CHIP_ALTERATION, CHIP_MUTATION, CHIP_ADRENALINE, CHIP_THORN];
	if (entity == ENTITY_LEEK_) return SortedSupportItems(entity);
	return [null];
}

