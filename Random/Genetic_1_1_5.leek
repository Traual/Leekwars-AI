function GetItems(Leek) {
	var TabItems = [];
	for (var i in getChips(Leek)) {
		if (getNumberOfBulb()[0] == 8 && _ITEM_EFFECTS[i] == EFFECT_SUMMON) continue;
		if (getCooldown(i, Leek) == 0 || getCooldown(i, Leek) <= 1 && Leek == EnemyLeekG) push(TabItems, i);
	}
	pushAll(TabItems, getWeapons(Leek));
	if (getLife() < 1000 || getAbsoluteShield() == 0) removeElement(TabItems, CHIP_DEVIL_STRIKE);
	if (ShieldScore(getEntity()) < 200) removeElement(TabItems, CHIP_PUNISHMENT);
	if (count(getSummons()) == 8) {
		removeElement(TabItems, CHIP_METALLIC_BULB);
		removeElement(TabItems, CHIP_HEALER_BULB);
		removeElement(TabItems, CHIP_PUNY_BULB);
		removeElement(TabItems, CHIP_WIZARD_BULB);
		removeElement(TabItems, CHIP_FIRE_BULB);
		removeElement(TabItems, CHIP_LIGHTNING_BULB);
		removeElement(TabItems, CHIP_ROCKY_BULB);
		removeElement(TabItems, CHIP_ICED_BULB);
		removeElement(TabItems, CHIP_SAVANT_BULB);
	}
	removeElement(TabItems, CHIP_REGENERATION);
	removeElement(TabItems, CHIP_ANTIDOTE);
	removeElement(TabItems, CHIP_LIBERATION);
	//removeElement(TabItems, CHIP_TELEPORTATION);
	removeElement(TabItems, CHIP_COVETOUSNESS);
	if (getLife(EnemyLeekG) + 100 >= getTotalLife(EnemyLeekG)) {
		removeElement(TabItems, CHIP_ALTERATION);
		removeElement(TabItems, WEAPON_MYSTERIOUS_ELECTRISOR);
	}
	return TabItems;
}

function getItemCoef(Item, target) {
	var ie = _ITEM_EFFECTS[Item];
	for (var eff in ie) {
		var effect = eff[0];
		if (eff[0] == EFFECT_DAMAGE && Item != WEAPON_B_LASER && Item != WEAPON_DESTROYER || eff[0] == EFFECT_POISON) return _COEF_DMG[target];
		if (effect == EFFECT_ABSOLUTE_SHIELD) return _COEF_ABS_SHIELD[target];
		if (effect == EFFECT_ABSOLUTE_VULNERABILITY) return _COEF_VULNERABILITY[target];
		if (effect == EFFECT_AFTEREFFECT) return 0;
		if (effect == EFFECT_ANTIDOTE) return 0;
		if (effect == EFFECT_BOOST_MAX_LIFE) return _COEF_BOOST_MAX_LIFE[target];
		if (effect == EFFECT_NOVA_VITALITY) return _COEF_BOOST_MAX_LIFE[target];
		if (effect == EFFECT_BUFF_AGILITY) return _COEF_BOOST_AGILITY[target];
		if (effect == EFFECT_BUFF_FORCE) return _COEF_BOOST_STR[target];
		if (effect == EFFECT_BUFF_MP) return _COEF_BOOST_MP[target];
		if (effect == EFFECT_RAW_BUFF_RESISTANCE) return _COEF_BOOST_RESI[target];
		if (effect == EFFECT_BUFF_RESISTANCE) return _COEF_BOOST_RESI[target];
		if (effect == EFFECT_BUFF_STRENGTH) return _COEF_BOOST_STR[target];
		if (effect == EFFECT_BUFF_TP) return _COEF_BOOST_TP[target];
		if (effect == EFFECT_RAW_BUFF_WISDOM) return _COEF_BUFF_WISDOM[target];
		if (effect == EFFECT_BUFF_WISDOM) return _COEF_BUFF_WISDOM[target];
		if (effect == EFFECT_RAW_BUFF_MAGIC) return _COEF_BUFF_MAGIC[target];
		if (effect == EFFECT_DAMAGE_RETURN) return _COEF_DAMAGE_RETURN[target];
		if (effect == EFFECT_DAMAGE_TO_ABSOLUTE_SHIELD) return 0;
		if (effect == EFFECT_DAMAGE_TO_STRENGTH) return 0;
		if (effect == EFFECT_DEBUFF) return 0;
		if (effect == EFFECT_HEAL) return _COEF_HEAL[target];
		if (effect == EFFECT_INVERT) return 0;
		if (effect == EFFECT_KILL) return 0;
		if (effect == EFFECT_LIFE_DAMAGE) return _COEF_DMG[target];
		if (effect == EFFECT_MODIFIER_MULTIPLIED_BY_TARGETS) return 0;
		if (effect == EFFECT_MODIFIER_ON_CASTER) return 0;
		if (effect == EFFECT_MODIFIER_STACKABLE) return 0;
		if (effect == EFFECT_NOVA_DAMAGE) return _COEF_NOVA[target];
		if (effect == EFFECT_NOVA_DAMAGE_TO_MAGIC) return 0;
		if (effect == EFFECT_POISON) return _COEF_DMG[target];
		if (effect == EFFECT_POISON_TO_SCIENCE) return 0;
		if (effect == EFFECT_RAW_ABSOLUTE_SHIELD) return _COEF_ABS_SHIELD[target];
		if (effect == EFFECT_RAW_BUFF_AGILITY) return _COEF_BOOST_AGILITY[target];
		if (effect == EFFECT_RAW_BUFF_MAGIC) return _COEF_BOOST_STR[target];
		if (effect == EFFECT_RAW_BUFF_MP) return _COEF_BOOST_MP[target];
		if (effect == EFFECT_RAW_BUFF_SCIENCE) return 0;
		if (effect == EFFECT_RAW_BUFF_STRENGTH) return _COEF_BOOST_STR[target];
		if (effect == EFFECT_RAW_BUFF_TP) return _COEF_BOOST_TP[target];
		if (effect == EFFECT_RELATIVE_SHIELD) return _COEF_REL_SHIELD[target];
		if (effect == EFFECT_RESURRECT) return 1;
		if (effect == EFFECT_SHACKLE_MAGIC) return _COEF_SHACKLE_STRENGTH[target];
		if (effect == EFFECT_SHACKLE_MP) return _COEF_SHACKLE_MP[target];
		if (effect == EFFECT_SHACKLE_STRENGTH) return _COEF_SHACKLE_STRENGTH[target];
		if (effect == EFFECT_SHACKLE_TP) return _COEF_SHACKLE_TP[target];
		if (effect == EFFECT_STEAL_ABSOLUTE_SHIELD) return _COEF_ABS_SHIELD[target];
		if (effect == EFFECT_SUMMON) return 1;
		if (effect == EFFECT_TELEPORT) return 0;
		if (effect == EFFECT_VULNERABILITY) return _COEF_VULNERABILITY[target];
	}
	return 0;
}

function RessurectionSummon() {
	var BestEntity;
	var BestCoef = 0;
	var myto = getEntityTurnOrder();
	for (var e in getDeadAllies()) {
		var tocontinue = false;
		for (var enemy in getAliveEnemies()) {
			if (getEntityTurnOrder(e) - myto > getEntityTurnOrder(enemy) - myto && getEntityTurnOrder(e) - myto > 0) {
				tocontinue = true;
				break;
			}
		}
		if (tocontinue) continue;
		var item = FromNameToChip(e);
		var coef = bulbcoef(item, EnemyLeekG)[1] * getItemCoef(item, _MY_SELF) /* - (1000 - getTotalLife(e)) / 1000*/ ;
		debug("bulb coef : " + bulbcoef(item, EnemyLeekG)[1] + " item coef : " + getItemCoef(item, _MY_SELF));
		if (coef > BestCoef) {
			BestEntity = e;
			BestCoef = coef;
		}
	}
	return [BestCoef, BestEntity];
}

function IsSafeFromBrochette(cell) {
	for (var ally in _ALIVE_ALLIES) {
		if (ally == _MY_SELF) continue;
		if (isOnSameLine(getCell(ally), cell) && lineOfSight(cell, getCell(ally), _ALL_LEEKS)) return false;
	}
	return true;
}

function useItem(item, cell, weapon) {
	if (isWeapon(item) && weapon != item) setWeapon(item);
	var lol = isChip(item) ? useChipOnCell(item, cell) : useWeaponOnCell(cell);
	lol;
}

function IsStrEnemies() {
	for (var e in _ALIVE_ENEMIES) {
		if (getStrength(e) > 0 || inArray(getChips(e), CHIP_PUNISHMENT)) return true;
	}
	return false;
}

function MustLibe(me, target, item, distorpercentage, tp) {
	if (_ITEM_EFFECTS[item][0][0] == EFFECT_POISON || item == WEAPON_DESTROYER) return false;
	var change = (_ITEM_IS_WEAPON[item] && getWeapon() != item) ? 1 : 0;
	var str = getStrength(me);
	var relsh = getRelativeShield(target);
	var abssh = getAbsoluteShield(target);
	var magic = getMagic(me);
	var basedmg = getRealDmg(item, str, relsh, abssh, magic, distorpercentage, me, 1);
	var newdmg = getRealDmg(item, str, relsh * 0.4, abssh * 0.4, magic, distorpercentage, me, 1);
	//var InverDmg = getRealDmg(item, str, relsh - 20, abssh, magic, distorpercentage, me);
	//if (InverDmg > newdmg || basedmg > RealLeeklife(target)) return false;
	//var tp = getTP();
	basedmg *= floor((tp - change) / _ITEM_COST[item]);
	newdmg *= floor((tp - _ITEM_COST[CHIP_LIBERATION] - change) / _ITEM_COST[item]);
	//InverDmg *= floor((tp - _ITEM_COST[CHIP_INVERSION] - change) / _ITEM_COST[item]);
	//if (InverDmg > newdmg && inArray(getChips(), CHIP_INVERSION)) return false;
	return newdmg > basedmg;
}

function MustInver(me, target, item, distorpercentage, tp) {
	if (_ITEM_EFFECTS[item][0][0] == EFFECT_POISON || item == WEAPON_DESTROYER) return false;
	var change = (_ITEM_IS_WEAPON[item] && getWeapon() != item) ? 1 : 0;
	var str = getStrength(me);
	var relsh = getRelativeShield(target);
	var abssh = getAbsoluteShield(target);
	var magic = getMagic(me);
	var basedmg = getRealDmg(item, str, relsh, abssh, magic, distorpercentage, me, 1);
	var newdmg = getRealDmg(item, str, relsh - 20, abssh, magic, distorpercentage, me, 1);
	//var tp = getTP();
	basedmg *= floor((tp - change) / _ITEM_COST[item]);
	newdmg *= floor((tp - _ITEM_COST[CHIP_INVERSION] - change) / _ITEM_COST[item]);
	//if ((_TP[me] - _ITEM_COST[CHIP_INVERSION] - change) / _ITEM_COST[item] < 1) return false;
	return newdmg > basedmg;
}

function RemoveRelGoneShields() {
	var AllRemove = 0;
	for (var eff in getEffects()) {
		if (eff[0] == EFFECT_RELATIVE_SHIELD && eff[2] != _MY_SELF && eff[3] == 1) AllRemove += eff[1];
	}
	return AllRemove;
}

function RemoveAbsGoneShields() {
	var AllRemove = 0;
	for (var eff in getEffects()) {
		if (eff[0] == EFFECT_ABSOLUTE_SHIELD && eff[2] != _MY_SELF && eff[3] == 1) AllRemove += eff[1];
	}
	return AllRemove;
}

function getWeaponToSet() {
	var BestDist = 999;
	var BestWeap;
	//if (inArray(getWeapons(), WEAPON_ELECTRISOR)) return WEAPON_ELECTRISOR;
	//if (inArray(getWeapons(), WEAPON_GAZOR)) return WEAPON_GAZOR;
	//Je trie les weaps par dist
	for (var weap in getWeapons()) {
		if (weap == WEAPON_MYSTERIOUS_ELECTRISOR || getMagic() == 0 && weap == WEAPON_REVOKED_M_LASER) continue;
		var dist = getCellDistance(getCell(), getCellToUseWeapon(weap, EnemyLeekG));
		if (dist < BestDist) {
			BestDist = dist;
			BestWeap = weap;
		}
	}
	/*//je prend le meilleur weapon avec le plus de cost (généralement combo voulu avec les tp)
	var bestdmg = 0;
	var BestItem;
	for (var item in array) {
		var dmg = getRealDmg(item, _STRENGTH[_MY_SELF], 0, 0, _MAGIC[_MY_SELF], 0, _MY_SELF);
		dmg += getWeaponMaxRange(item) * 10;
		if (dmg > bestdmg) {
			bestdmg = dmg;
			BestItem = item;
		}
	}*/
	return BestWeap;
}

function getNumberOfBulbInAnArea(rayon, cellCentrale) {
	var NBulb = 0;
	for (var leek in _ALIVE_ALLIES) {
		if (getCellDistance(getCell(leek), cellCentrale) <= rayon && leek != _MY_SELF) {
			NBulb += bulbname(leek, EnemyLeekG)[1];
		}
	}
	return NBulb;
}
function countrealtargets(array, item) {
	var pos = isPositiv(item);
	var _final = 0;
	for (var t in array) {
		if (pos && isAlly(t)) _final++;
		if (!pos && isEnemy(t)) _final++;
	}
	return _final;
}

function getAreaNumber(item) {
	var area = isChip(item) ? getChipArea(item) : getWeaponArea(item);
	if (area == AREA_CIRCLE_1) {
		return 1;
	}
	if (area == AREA_CIRCLE_2) {
		return 2;
	}
	if (area == AREA_CIRCLE_3) {
		return 3;
	}
	if (area == AREA_LASER_LINE || area == AREA_POINT) {
		return 0;
	}
}

function cellareaplus1(c) {
	if (isObstacle(c)) return;
	var tabcellz = [];
	var x = getCellX(c);
	var y = getCellY(c);
	push(tabcellz, c);
	var cell;
	cell = getCellFromXY(x + 1, y);
	if (cell != null && !isObstacle(cell)) {
		push(tabcellz, cell);
	}
	cell = getCellFromXY(x - 1, y);
	if (cell != null && !isObstacle(cell)) {
		push(tabcellz, cell);
	}

	cell = getCellFromXY(x, y + 1);
	if (cell != null && !isObstacle(cell)) {
		push(tabcellz, cell);
	}

	cell = getCellFromXY(x, y - 1);
	if (cell != null && !isObstacle(cell)) {
		push(tabcellz, cell);
	}
	return tabcellz;
}

