			return [ENTITY_ROCKY_BULB, 0.4000701904296875];
		} else if (name == "puny_bulb") {
			return [ENTITY_PUNY_BULB, 0.58880615234375];
		} else if (name == "savant_bulb") {
			return [ENTITY_SAVANT_BULB, 0.0714263916015625];
