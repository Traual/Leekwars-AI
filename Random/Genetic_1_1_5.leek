	var _ARRAY_;
	var _Array_Targets = [];
	var _array_positiv = [];
	var _Array_Special = [];
	var items = GetItems(_MY_SELF);
	var str = getStrength();
	var mgc = getMagic();
	//var CellItem = [];
	var tp = getTP();
	var distarray = [];
	var nbarray = [];
	//JE RECUPERE LES ITEMS DE MANIERE A SAVOIR SI ILS DOIVENT ETRE UTILISES SUR ENEMY OU ALLY OU pas du tout utilisable
	/*for (var item in items) {
		if (isPositiv(item)) {
			removeElement(items, item);
			push(_array_positiv, item);
		}
		if (isPositiv(item) == null && item != CHIP_LIBERATION) {
			removeElement(items, item);
			push(_Array_Special, item);
		}
	}*/
	//FIN DU TRIAGE D'ITEMS
	//[item] ---> [cells]
	var BestTPItem = null;
	var TP_ITEMS = [CHIP_JUMP, null, CHIP_LEATHER_BOOTS];
	for (var i in TP_ITEMS) {
		if (inArray(GetItems(getEntity()), i) && getCooldown(i) == 0) {
			BestTPItem = i;
			break;
		}
	}
	var range = BestTPItem == CHIP_JUMP ? _ITEM_MAXRANGE[BestTPItem] : 2;
	var addrange = BestTPItem == null ? 0 : range;
	if (BestTPItem == null) addrange = 0;
	var acces = BestTPItem == CHIP_JUMP ? JumpCellzMp(getCell(), getMP()) : GetPossibleWalkableCells(getCell(), getMP() + addrange);
	var _array_acces = [];
	for (var c: var mp in acces) {
		_array_acces[c] = c;
	}
	//mark(acces, COLOR_BLUE);
	//pause();
	//debug(ArrayItemToString(GetItems(_MY_SELF)));
	for (var i in GetItems(_MY_SELF)) {
		_usablecellz = [];
		var Targets = !isPositiv(i) ? _ALIVE_ENEMIES : _ALIVE_ALLIES;
		var Interestings = [];
		for (var t in Targets) {
			if (getalleffectscoefed(i, str, getRelativeShield(t), getAbsoluteShield(t), mgc, 0, _MY_SELF, t, 1) > 0) push(Interestings, t);
		}
		//debug(ArrayLeeksToString(Interestings));
		for (var cell in _array_acces) {
			var tobreak = false;
			distarray[cell] = 0;
			nbarray[cell] = 0;
			for (var e in Interestings) {
				var celle = getCell(e);
				var good = false;
				for (var acell in _CELL_AREA[i][celle]) {
					if (getUsableItemsFromCellToCell(cell, acell, i, [_MY_SELF])) {
						push(_usablecellz, cell);
						var dist = getCellDistance(celle, acell);
						distarray[cell] += dist;
						nbarray[cell]++;
						tobreak = true;
						break;
					}
				}
				//if (tobreak) break;
			}
			if (getOperations() > _MAP_ACTION_OP_LIMIT) break;
		}
		//mark(_usablecellz);
		//pause();
		if (i == CHIP_COVETOUSNESS || i == CHIP_PRECIPITATION) _usablecellz = _MY_POSSIBLE_ACCES_CELLZ;
		_CELLZ_TO_USE[i] = _usablecellz;
		for (var c in _usablecellz) {
			if (c === null) continue;
			if (_USABLE_ITEMS[c] == null) _USABLE_ITEMS[c] = [];
			push(_USABLE_ITEMS[c], i);
		}
	}
	for (var c: var array in _USABLE_ITEMS) {
		var pwr = 0;
		for (var i in array) {
			var cost = _ITEM_COST[i];
			var iteration = _ITEM_COOLDOWN[i] > 0 ? 1 : floor(cost / tp);
			pwr += iteration * cost * nbarray[c] / ((distarray[c] + 1) / 3);
		}
		_MAP_ACTION_SCORED[c] = [pwr, array];
	}
	//debug(_MAP_ACTION_SCORED);
	StopTestFunction("Map action");
}

UpdateLeekEffects();
setCoef();
LoadActionMap();

function getAllShootableCellz(cell, item) {
	var _final = [];
	var Leeks = isPositiv(item) ? _ALIVE_ALLIES : _ALIVE_ENEMIES;
	var area = _ITEM_AREA[item];
	for (var leek in Leeks) {
		var cellL = getCell(leek);
		for (var to in _CELL_AREA[item][cellL]) {
			if (to == cellL && !_final[to] && getUsableItemsFromCellToCell(cell, to, item, [_MY_SELF])) _final[to] = to;
			if (!_final[to] && getUsableItemsFromCellToCell(cell, to, item, [_MY_SELF])) _final[to] = to;
		}
	}
	return _final;
}

function getCellzToUseItem(accescellz, item) {
	var _final = [];
	var mycell = getCell();
	if (isPositiv(item) == null && item != CHIP_LIBERATION && item != CHIP_ANTIDOTE) return [mycell];
	accescellz[mycell] = mycell;
	for (var c in _CELLZ_TO_USE[item]) {
		//if (item == CHIP_FRACTURE) mark(c,COLOR_BLUE);
		if (accescellz[c] != null) push(_final, c);
	}
	return _final;
}

function CanBrochette(Start, End) {
	if (isOnSameLine(Start, End) && lineOfSight(Start, End)) {
		return true;
	} else return false;
}

function getAllLazerTargets(item, from, to) { //A Refaire pour ne pas etre entre les enemys
	var _final = [];
	var basex = getCellX(from);
	var basey = getCellY(from);
	var goodone = false;
	var arraycells = [];
	var times = 0;
	for (var x = 0; x <= _ITEM_MAXRANGE[item]; x++) {
		var cell = getCellFromXY(x + basex, basey);
		if (cell == null || _OBSTACLES[cell]) break;
		if (x < _ITEM_MINRANGE[item]) continue;
		if (cell == to) goodone = true;
		push(arraycells, cell);
	}
	if (goodone == false) arraycells = [];
	if (!goodone) {
		for (var x = 0; x >= -_ITEM_MAXRANGE[item]; x--) {
			var cell = getCellFromXY(x + basex, basey);
			if (cell == null || _OBSTACLES[cell]) break;
			if (x > -_ITEM_MINRANGE[item]) continue;
			if (cell == to) goodone = true;
			push(arraycells, cell);
		}
	}
	if (goodone == false) arraycells = [];
	if (!goodone) {
		for (var y = 0; y <= _ITEM_MAXRANGE[item]; y++) {
			var cell = getCellFromXY(basex, y + basey);
			if (cell == null || _OBSTACLES[cell]) break;
			if (y < _ITEM_MINRANGE[item]) continue;
			if (cell == to) goodone = true;
			push(arraycells, cell);
		}
	}
	if (goodone == false) arraycells = [];
	if (!goodone) {
		for (var y = 0; y >= -_ITEM_MAXRANGE[item]; y--) {
			var cell = getCellFromXY(basex, y + basey);
			if (cell == null || _OBSTACLES[cell]) break;
			if (y > -_ITEM_MINRANGE[item]) continue;
			if (cell == to) goodone = true;
			push(arraycells, cell);
		}
	}
	if (goodone == false) arraycells = [];
	for (var c in arraycells) {
		var entity = getEntityOnCell(c);
		if (entity == _MY_SELF) continue;
		push(_final, entity);
	}
	return _final;
}

//getAllLazerTargets(WEAPON_FLAME_THROWER, getCell(), getCellFromXY(getCellX(getCell()), getCellY(getCell()) - 3));

function getBestAoeCell(from, item, timesuseitem, tp) {
	var BestAoeCell;
	var BestInterest = 0;
	var Interest;
	var CoefKillAlly = (item == CHIP_BURNING) ? 99999 : coefKillAlly;
	var pos = isPositiv(item);
	var OnlyBulb = isOnlyBulb(item);
	var LifeStolen = 0;
	var MultipliedByTargets = false;
	var Multiplier = 1;
	if (_ITEM_EFFECTS[item][0][5] & EFFECT_MODIFIER_MULTIPLIED_BY_TARGETS) MultipliedByTargets = true;
	if (_ITEM_EFFECTS[item][0][0] == EFFECT_RESURRECT) return [from, RessurectionSummon()[0]];
	if (_ITEM_AREA[item] == AREA_LASER_LINE) {
		for (var to in getAllShootableCellz(from, item)) {
			_ALL_TESTED_SHOOTABLE_CELLZ++;
			var LifeSteal = 0;
			Interest = 0;
			var Targets = getAllLazerTargets(item, from, to);
			if (MultipliedByTargets) Multiplier = countrealtargets(Targets, item);
			for (var target in Targets) {
				var Life = RealLeeklife(target);
				var cooldown = getCooldown(CHIP_ANTIDOTE, target);
				if (target == _MY_SELF || Life <= 0) continue;
				var shouldlibe = MustLibe(_MY_SELF, target, item, 0, tp);
				var shouldInver = MustInver(_MY_SELF, target, item, 0, tp);
				var libe = false;
				var inver = false;
				if (getCooldown(CHIP_LIBERATION) == 0 && shouldlibe && getUsableItemsFromCellToCell(from, to, CHIP_LIBERATION, _MY_SELF)) libe = true;
				if (getCooldown(CHIP_INVERSION) == 0 && shouldInver && getUsableItemsFromCellToCell(from, to, CHIP_INVERSION, _MY_SELF) && libe == false) inver = true;
				var RealDmg = getRealDmg(item, getStrength(), getRelativeShield(target), getAbsoluteShield(target), getMagic(), 0, _MY_SELF, Multiplier);
				if (libe) RealDmg = getRealDmg(item, getStrength(), getRelativeShield(target) * 0.4, getAbsoluteShield(target) * 0.4, getMagic(), 0, _MY_SELF, Multiplier);
				if (inver) RealDmg = getRealDmg(item, getStrength(), getRelativeShield(target) - 20, getAbsoluteShield(target), getMagic(), 0, _MY_SELF, Multiplier);
				RealDmg *= timesuseitem;
				if (!pos) {
					if (_IS_ALLY[target] == false) {
						if (_ITEM_EFFECTS[item][0][0] == EFFECT_DAMAGE) {
							LifeSteal += ItemDmg(item, getStrength(), getRelativeShield(target), getAbsoluteShield(target), 0, target) * (getWisdom() / 1000);
							LifeSteal -= ItemDmg(item, getStrength(), getRelativeShield(target), getAbsoluteShield(target), 0, target) * (getDamageReturn(target) / 100);
						}
						if (RealDmg >= Life && Life > 0) {
							RealDmg += killCoefs(target) * _SCORE_KILL;
							Life = 0;
						}
						Interest += getalleffectscoefed(item, getStrength(), getRelativeShield(target), getAbsoluteShield(target), getMagic(), 0, _MY_SELF, target, Multiplier);
					} else {
						Interest -= RealDmg * CoefKillAlly;
					}
				} else {
					if (_IS_ALLY[target]) {
						Interest += getalleffectscoefed(item, getStrength(), getRelativeShield(target), getAbsoluteShield(target), getMagic(), 0, _MY_SELF, target, Multiplier);
					} else {
						Interest -= RealDmg * CoefKillAlly;
					}
				}
			}
			if (Interest > BestInterest) {
				BestInterest = Interest;
				BestAoeCell = to;
				LifeStolen = LifeSteal;
			}
		}
		return [BestAoeCell, BestInterest, LifeStolen];
	} else
	if (pos == null && item != CHIP_LIBERATION) {
		var Coef = bulbcoef(item, EnemyLeekG)[1] * (getItemCoef(item, _MY_SELF) / _COEF_DIVIDE_COEFS);
		Coef *= _IS_GENTLE_BULB[item] ? _COEF_SUMMON_GENTLE : _COEF_SUMMON_FOCUS;
		return [from, Coef];
	} else
		for (var to in getAllShootableCellz(from, item)) {
			_ALL_TESTED_SHOOTABLE_CELLZ++;
			//debug(getChipName(item)+" 1");
			var LifeSteal = 0;
			Interest = 0;
			var areaaa = _ITEM_AREA[item];
			if (!pos && areaaa != AREA_X_1 && areaaa != AREA_X_2 && areaaa != AREA_X_3 || item == CHIP_LIBERATION) {
				var Targets = getItemTargets(item, to);
				if (MultipliedByTargets) Multiplier = countrealtargets(Targets, item);
				for (var target in Targets) {
					//debug(getChipName(item)+" 2");
					var dist = getCellDistance(to, getCell(target));
					var cooldown = getCooldown(CHIP_ANTIDOTE, target);
					var Life = RealLeeklife(target);
					if (target == _MY_SELF || Life <= 0) continue;
					var shouldlibe = MustLibe(_MY_SELF, target, item, dist, tp);
					var shouldInver = MustInver(_MY_SELF, target, item, dist, tp);
					var libe = false;
					var inver = false;
					if (getCooldown(CHIP_LIBERATION) == 0 && shouldlibe && getUsableItemsFromCellToCell(from, to, CHIP_LIBERATION, _MY_SELF)) libe = true;
					if (getCooldown(CHIP_INVERSION) == 0 && shouldInver && getUsableItemsFromCellToCell(from, to, CHIP_INVERSION, _MY_SELF) && libe == false) inver = true;
					var RealDmg = getRealDmg(item, getStrength(), getRelativeShield(target), getAbsoluteShield(target), getMagic(), dist, _MY_SELF, Multiplier);
					if (libe) RealDmg = getRealDmg(item, getStrength(), getRelativeShield(target) * 0.4, getAbsoluteShield(target) * 0.4, getMagic(), dist, _MY_SELF, Multiplier);
					if (inver) RealDmg = getRealDmg(item, getStrength(), getRelativeShield(target) - 20, getAbsoluteShield(target), getMagic(), dist, _MY_SELF, Multiplier);
					RealDmg *= timesuseitem;
					/*if (item==CHIP_ALTERATION) {
						debug("Dmg : "+RealDmg+' times use item : '+timesuseitem+" item coef : "+getItemCoef(item, target));
					}*/
					if (_IS_ALLY[target] == false) {
						if (_ITEM_EFFECTS[item][0][0] == EFFECT_DAMAGE) {
							LifeSteal += ItemDmg(item, getStrength(), getRelativeShield(target), getAbsoluteShield(target), dist, target) * (getWisdom() / 1000);
							LifeSteal -= ItemDmg(item, getStrength(), getRelativeShield(target), getAbsoluteShield(target), 0, target) * (getDamageReturn(target) / 100);
							if (item == CHIP_PUNISHMENT) LifeSteal = -0.84 * getLife();
						}
						if (RealDmg >= Life && Life > 0) {
							RealDmg += killCoefs(target) * _SCORE_KILL;
							Life = 0;
						}
						Interest += getalleffectscoefed(item, getStrength(), getRelativeShield(target), getAbsoluteShield(target), getMagic(), dist, _MY_SELF, target, Multiplier);
					} else {
						Interest -= RealDmg * CoefKillAlly;
					}
				}
				var DevilStrikeDmg = getRealDmg(item, getStrength(), getRelativeShield(), getAbsoluteShield(), getMagic(), 0, _MY_SELF, 1);
				if (item == CHIP_DEVIL_STRIKE) {
					Interest -= DevilStrikeDmg * (_COEF_HEAL[_MY_SELF] / _COEF_DIVIDE_COEFS);
					LifeStolen -= DevilStrikeDmg;
				}
			} else {
				var area = _ITEM_AREA[item];
				if (area != AREA_X_1 && area != AREA_X_2 && area != AREA_X_3) {
					LifeSteal = 0;
					var Targets = getItemTargets(item, to);
					if (MultipliedByTargets) Multiplier = countrealtargets(Targets, item);
					for (var target in Targets) {
						var cell = getCell(target);
						var tocontinue = false;
						//if (!isSummon(target) && OnlyBulb) continue;
						var dist = getCellDistance(to, cell);
						var real = getRealDmg(item, getStrength(), getRelativeShield(target), getAbsoluteShield(target), getMagic(), dist, _MY_SELF, Multiplier);
						for (var eff in getEffects(target)) {
							if (eff[5] == item && /*eff[1] > real && */ eff[3] > 1) tocontinue = true;
						}
						if (tocontinue) continue;
						if (target == _MY_SELF && _ITEM_EFFECTS[item][0][0] == EFFECT_HEAL) LifeSteal = real;
						if (_IS_ALLY[target]) Interest += getalleffectscoefed(item, getStrength(), getRelativeShield(target), getAbsoluteShield(target), getMagic(), dist, _MY_SELF, target, Multiplier);
						if (_IS_ALLY[target] == false) Interest -= real * CoefKillAlly;
					}
				}
				/*else {
				//debugW(getItemTargets(item, to));
				if (_ITEM_EFFECTS[0][0]!=EFFECT_DAMAGE) {
					LifeSteal = 0;
				var real = getRealDmg(item, _STRENGTH[_MY_SELF], _RELATIVE_SHIELD[_MY_SELF], _ABSOLUTE_SHIELD[_MY_SELF], _MAGIC[_MY_SELF], 0, _MY_SELF);
				real *= count(getItemTargets(item, to));
				if (_ITEM_EFFECTS[item][0][0] == EFFECT_HEAL) LifeSteal = real;
				Interest = real * (getItemCoef(item, _MY_SELF) / _COEF_DIVIDE_COEFS);
				} else {
				var total = 0;
					for (var t in getItemTargets(item, to)) {
						LifeSteal = 0;
						var real = getRealDmg(item, _STRENGTH[_MY_SELF], _RELATIVE_SHIELD[_MY_SELF], _ABSOLUTE_SHIELD[_MY_SELF], _MAGIC[_MY_SELF], 0, _MY_SELF);
						real *= count(getItemTargets(item, to));
						total+= real;
					}
					Interest = total * (getItemCoef(item, _MY_SELF) / _COEF_DIVIDE_COEFS);
				}
			}*/
			} //Fin Target
			if (Interest > BestInterest) {
				BestInterest = Interest;
				BestAoeCell = to;
				LifeStolen = LifeSteal;
			}

		} //Fin To
	return [BestAoeCell, BestInterest, LifeStolen];
}

