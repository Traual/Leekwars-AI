function GetAllTeleportableCellz() {
	var _final = [];
	for (var acces in _MY_ACCES_CELLZ) {
		for (var tp in getPossibleTpCellzfrom(acces, _MY_ACCES_CELLZ)) {
			if (_final[tp] == null) _final[tp] = acces;
		}
	}
	return _final;
}

function getCombos(entity, tp) {
	var array = [];
	//STRENGTH
	if (tp >= 21) push(array, [CHIP_LIGHTNING, CHIP_ROCKFALL, CHIP_LIGHTNING, CHIP_LIGHTNING, CHIP_LIGHTNING]);
	if (tp >= 21 && getWeapon(entity) == WEAPON_KATANA) push(array, [WEAPON_KATANA, WEAPON_KATANA, WEAPON_KATANA]);
	if (tp >= 22) push(array, [WEAPON_RIFLE, WEAPON_RIFLE, WEAPON_RIFLE]);
	if (tp >= 21 && getWeapon(entity) == WEAPON_RIFLE) push(array, [WEAPON_RIFLE, WEAPON_RIFLE, WEAPON_RIFLE]);
	if (tp >= 21) push(array, [WEAPON_RIFLE, WEAPON_RIFLE, CHIP_STALACTITE]);
	if (tp >= 20 || (tp >= 19 && getWeapon(entity) == WEAPON_RIFLE)) push(array, [WEAPON_RIFLE, WEAPON_RIFLE, CHIP_ROCKFALL]);
	if (tp >= 21 || (tp >= 20 && getWeapon(entity) == WEAPON_RHINO)) push(array, [WEAPON_RHINO, WEAPON_RHINO, WEAPON_RHINO, WEAPON_RHINO]);
	if (tp >= 21) push(array, [WEAPON_M_LASER, WEAPON_M_LASER, CHIP_LIGHTNING]);
	if (tp >= 21 || tp >= 20 && getWeapon(entity) == WEAPON_GRENADE_LAUNCHER) push(array, [WEAPON_GRENADE_LAUNCHER, WEAPON_GRENADE_LAUNCHER, CHIP_METEORITE]);
	if (tp >= 20) push(array, [WEAPON_ELECTRISOR, WEAPON_ELECTRISOR, CHIP_ROCKFALL]);
	if (tp >= 17) push(array, [WEAPON_M_LASER, WEAPON_M_LASER]);
	if (tp >= 15 || tp >= 14 && getWeapon(entity) == WEAPON_ELECTRISOR) push(array, [WEAPON_ELECTRISOR, WEAPON_ELECTRISOR]);
	if (tp >= 15 || tp >= 14 && getWeapon(entity) == WEAPON_M_LASER) push(array, [WEAPON_M_LASER, CHIP_STALACTITE]);
	if (tp >= 16 || (tp >= 15 && getWeapon(entity) == WEAPON_RHINO)) push(array, [WEAPON_RHINO, WEAPON_RHINO, WEAPON_RHINO]);
	if (tp >= 15) push(array, [WEAPON_RIFLE, WEAPON_RIFLE]);
	if (tp >= 14 && getWeapon(entity) == WEAPON_RIFLE) push(array, [WEAPON_RIFLE, WEAPON_RIFLE]);
	if (tp >= 14) push(array, [CHIP_LIGHTNING, CHIP_LIGHTNING, CHIP_STALACTITE]);
	if (tp >= 14) push(array, [WEAPON_ELECTRISOR, CHIP_STALACTITE]);
	if (tp >= 14) push(array, [WEAPON_KATANA, CHIP_DEVIL_STRIKE]);
	if (tp >= 13) push(array, [WEAPON_ELECTRISOR, CHIP_ROCKFALL]);
	if (tp >= 13) push(array, [WEAPON_M_LASER, CHIP_LIGHTNING]);
	if (tp >= 12) push(array, [WEAPON_GRENADE_LAUNCHER, WEAPON_GRENADE_LAUNCHER]);
	if (tp >= 11 || (tp >= 10 && getWeapon(entity) == WEAPON_RHINO)) push(array, [WEAPON_RHINO, WEAPON_RHINO]);
	if (tp >= 9) push(array, [WEAPON_M_LASER]);
	if (tp >= 8) push(array, [WEAPON_ELECTRISOR]);
	if (tp >= 7) push(array, [WEAPON_GRENADE_LAUNCHER]);
	if (tp >= 8) push(array, [WEAPON_RIFLE, WEAPON_RIFLE]);
	if (tp >= 7 && getWeapon(entity) == WEAPON_RIFLE) push(array, [WEAPON_RIFLE]);
	//MAGIC
	if (tp >= 21) push(array, [WEAPON_GAZOR, WEAPON_GAZOR, CHIP_PLAGUE]);
	if (tp >= 21) push(array, [WEAPON_GAZOR, WEAPON_FLAME_THROWER, WEAPON_FLAME_THROWER]);
	if (tp >= 19) push(array, [WEAPON_FLAME_THROWER, WEAPON_FLAME_THROWER, CHIP_PLAGUE]);
	if (tp >= 14) push(array, [WEAPON_GAZOR, CHIP_PLAGUE]);
	if (tp >= 14 && getWeapon(entity) == WEAPON_GAZOR) push(array, [WEAPON_GAZOR, WEAPON_GAZOR]);
	if (tp >= 13) push(array, [WEAPON_FLAME_THROWER, WEAPON_FLAME_THROWER]);
	if (tp >= 13) push(array, [WEAPON_FLAME_THROWER, CHIP_PLAGUE]);
	if (tp >= 11) push(array, [CHIP_PLAGUE, CHIP_TOXIN]);
	if (getFightType() != FIGHT_TYPE_SOLO) push(array, []);
	for (var comboz in array) {
		for (var item in comboz) {
			if (!inArray(GetItems(entity), item)) {
				removeElement(array, comboz);
				break;
			}
		}
	}
	return array;
}

function GetComboToOs(entity, comboz) {
	var Life = RealLeeklife(entity);
	var Comboo = comboz[0];
	var dmg = 0;
	for (var item in Comboo) {
		var divide = item == WEAPON_FLAME_THROWER ? 2 : _ITEM_EFFECTS[item][0][3];
		dmg += getRealDmg(item, getStrength(), getRelativeShield(entity), getAbsoluteShield(entity), getMagic(), 0, _MY_SELF, 1) / (1 + divide);
	}
	if (dmg < Life) return;
	reverse(comboz);
	var final = [];
	for (var combo in comboz) {
		var combodmg = 0;
		for (var item in combo) {
			var divide = item == WEAPON_FLAME_THROWER ? 2 : _ITEM_EFFECTS[item][0][3];
			combodmg += getRealDmg(item, getStrength(), getRelativeShield(entity), getAbsoluteShield(entity), getMagic(), 0, _MY_SELF, 1) / (1 + divide);
		}
		if (combodmg >= Life) push(final, combo);
	}
	return final;
}

function OneShotNoTp(entity, comboztoOs) {
	if (comboztoOs[0] == null) return;
	for (var combo in comboztoOs) {
		for (var cellz in _MY_ACCES_CELLZ) {
			var Ok = true;
			for (var item in combo) {
				if (!getUsableItemsFromCellToCell(cellz, getCell(entity), item, [])) {
					Ok = false;
					break;
				}
			}
			if (Ok) return [cellz, combo];
		}
	}
}

function OneShotTp(entity, comboztoOs) {
	if (comboztoOs[0] == null) return;
	var tpcellz = GetAllTeleportableCellz();
	for (var combo in comboztoOs) {
		for (var tpcell: var acces in tpcellz) {
			var Ok = true;
			for (var item in combo) {
				if (!getUsableItemsFromCellToCell(tpcell, getCell(entity), item, [])) {
					Ok = false;
					break;
				}
			}
			if (Ok) return [tpcell, combo, acces];
		}
	}
}

function OneShot(entity) {
	StartTestFunction();
	if (getFightType() == FIGHT_TYPE_SOLO) {
		_ITEM_MINRANGE[WEAPON_GAZOR] = 2;
		_ITEM_MINRANGE[CHIP_PLAGUE] = 1;
		_ITEM_MINRANGE[CHIP_TOXIN] = 1;
	}
	var NoTp = OneShotNoTp(entity, GetComboToOs(entity, getCombos(_MY_SELF, getTP())));
	if (NoTp[0] != null) {
		moveTowardCell(NoTp[0]);
		for (var i in NoTp[1]) {
			useItem(i, getCell(entity), getWeapon());
		}
		PipotronOs();
	} else {
		var Tp = OneShotTp(entity, GetComboToOs(entity, getCombos(_MY_SELF, getTP() - _ITEM_COST[CHIP_TELEPORTATION])));
		if (Tp[0] != null && inArray(getChips(), CHIP_TELEPORTATION) && getCooldown(CHIP_TELEPORTATION) == 0) {
			moveTowardCell(Tp[2]);
			useChipOnCell(CHIP_TELEPORTATION, Tp[0]);
			for (var i in Tp[1]) {
				useItem(i, getCell(entity), getWeapon());
			}
			PipotronOs();
		}
	}
	_ITEM_MINRANGE[WEAPON_GAZOR] = 4;
	_ITEM_MINRANGE[CHIP_PLAGUE] = 4;
	_ITEM_MINRANGE[CHIP_TOXIN] = 3;
	StopTestFunction("OS");
}

function cellRadius(cell, radius) {
	var _final = [];
	var basex = getCellX(cell);
	var basey = getCellY(cell);
	for (var x = -radius; x <= radius; x++) {
		for (var y = -radius; y <= radius; y++) {
			var celll = getCellFromXY(basex + x, basey + y);
			if (abs(x) + abs(y) <= radius && celll != null) push(_final, celll);
		}
	}
	return _final;
}

function AllAllyWalkCellz() {
	var _pre_final = [];
	var _final = [];
	for (var c: var mp in CellMp(getCell(), getMP())) {
		push(_pre_final, c);
	}
	for (var a in getAliveAllies()) {
		if (getSummoner(a) != getEntity() || !isSummon(a)) continue;
		for (var c: var mp in CellMp(getCell(a), getMP(a))) {
			push(_pre_final, c);
		}
	}
	for (var c in _pre_final) {
		if (!inArray(_final, c)) push(_final, c);
	}
	//debug(_final);
	return _final;
}

function updateGravityCellz(cellz) {
	StartTestFunction();
	var arrayScore = [];
	var Centre = getCellFromXY(0, 0);
	var AccesMp = [];
	var mymp = getMP();
	var me = getEntity();
	var myitems = GetItems(me);
	var usefulesitems = [];
	var cellzMp = [];
	for (var i in myitems) {
		if (!isPositiv(i)) push(usefulesitems, i);
	}
	for (var e in _ALIVE_ENEMIES) {
		AccesMp[e] = CellMp(getCell(e), getMP(e));
	}
	/*for (var e in _ALIVE_ENEMIES) {
		AccesMp[e] = [];
		var basecell = getCell(e);
		var basemp = getMP(e);
		for (var c: var mp in CellMp(basecell, basemp)) {
			AccesMp[e][c] = [];
			for (var mpe = 0; mpe <= basemp - mp; mpe++) {
				AccesMp[e][c][mpe] = CellMp(c, mpe);
			}
		}
	}
	for (var c: var mp in AccesMp[getNearestEnemy()][getCell(getNearestEnemy()) + 1][getMP(getNearestEnemy()) - 3]) {
		mark(c, COLOR_GREEN);
	}*/
	for (var c in cellz) {
		if (_OBSTACLES[c]) continue;
		arrayScore[c] = 40;
		for (var aoe in cellRadius(c, 4)) {
			if (_OBSTACLES[aoe] && aoe != null) arrayScore[c]++;
		}
		var nbacces3 = 0;
		for (var ctest: var mptest in CellMp(c, 3)) {
			nbacces3++;
		}
		arrayScore[c] -= nbacces3*10;
		if (nbacces3 < 9) arrayScore[c] -= 150;
		//var myfuturacces = CellMp(c, mymp);
		for (var e in _ALL_LEEKS) {
			var mpe = getMP(e);
			//if (isSummon(e)) continue;
			arrayScore[c] -= _PATHS_LENGHT[c][e] * (Dmgbulbcoef(FromNameToChip(e), me)[1] / _COEF_FOCUS_LEEK * 18);
			if (isEnemy(e)) {
				//var array = _BEST_CELLS_ATTACK_ENEMY[e][c]; //[e][getcell] -- > [mp , cellfrom]
				//var mp = array[0];
				//if (mp == null) continue;
				//arrayScore[c]+=mp/mpe*6;
				for (var ec: var emp in AccesMp[e]) {
					if (getCellDistance(ec, Centre) < getCellDistance(c, Centre)) arrayScore[c] -= 0.6;
				}
			}
			/*if (isEnemy(e)) {
				var array = _BEST_CELLS_ATTACK_ENEMY[e][c]; //[e][getcell] -- > [mp , cellfrom]
				var mp = array[0];
				var from = array[1];
				for (var ctest: var mptest in AccesMp[e][from][mpe - mp]) {
					for (var futurmycell: var futurmymp in myfuturacces) {
						for (var i in usefulesitems) {
							debug("boucle ok ");
							if (getUsableItemsFromCellToCell(futurmycell, ctest, i, [me])) arrayScore[c] += 30;
						}
					}
				}
			}*/
		}
		arrayScore[c] -= getCellDistance(c, Centre);
	}


	for (var c: var score in arrayScore) {
		markText(c, score);
		_GRAVITY_CELLZ[c] = score;
	}
	StopTestFunction("gravity cells");
}

function setDamageMap() {
	StartTestFunction();
	//mark(_MY_POSSIBLE_ACCES_CELLZ, COLOR_GREEN);
	var Items = [];
	var _danger = [];
	var JustToDebug = 0;
	var NumberEnemys;
	var LibeCooldowns = [];
	var OSPOSSIBLE = GetComboToOs(EnemyLeekG, getCombos(_MY_SELF, _TP_KILL_NEXT_TURN));
	_BEST_CELLS_ATTACK_ENEMY = [];
	var _TP = [];
	//Register all enemys items in an array and walkable cellz and max range items and the cooldown pour the liberation chip
	var Opsss = getOperations();
	/*var addpm = 0;
	addpm = getMP()<=12 ? _ITEM_MAXRANGE[CHIP_JUMP] : 0;
	addpm = getMP()<=9 ? _ITEM_MAXRANGE[CHIP_TELEPORTATION] : 0;
	var myacces = GetPossibleWalkableCells(getCell(), getMP());*/
	for (var e in _ALIVE_ENEMIES) {
		_ACCESCELLS[e] = null;
		Items[e] = getBestSortedItems(e, _MY_SELF);
		if (isEmpty(Items[e])) continue;
		debug("Best items : " + getName(e) + " " + ArrayItemToString(Items[e]));
		_TP[e] = getTP(e);
		//var addpm = 0;
		_BEST_CELLS_ATTACK_ENEMY[e] = [];
		if (inArray(getChips(e), CHIP_JUMP) && getCooldown(CHIP_JUMP, e) < 1) _ACCESCELLS[e] = JumpCellzMp(getCell(e), getMP(e));
		var addpm = (inArray(getChips(e), CHIP_LEATHER_BOOTS) && getCooldown(CHIP_LEATHER_BOOTS, e) < 1) ? 2 : 0;
		if (_ACCESCELLS[e] == null) _ACCESCELLS[e] = AccesCellzMp(getCell(e), getMP(e) + addpm);
		//pause();
		LibeCooldowns[e] = getCooldown(CHIP_LIBERATION, e);
	}
	//debug("Dmg map loading opés : " + ((getOperations() - Opsss) / 1000) + " k");
	//End registering
	var goneRel = RemoveRelGoneShields();
	var goneAbs = RemoveAbsGoneShields();
	for (var c in _MY_POSSIBLE_ACCES_CELLZ) {
		_danger[c] = [];
	}
	for (var index = 0; index < 10; index++) {
		NumberEnemys = 0;
		JustToDebug = index;
		var iterations = 0;
		for (var e in _ALIVE_ENEMIES) {
			var tpe = getTP(e);
			if (Items[e][index] == null) {
				NumberEnemys++;
				continue;
			}
			if (inArray(getChips(e), CHIP_ADRENALINE) && getCooldown(CHIP_ADRENALINE, e) < 1) tpe += 4;
			var cost = _ITEM_COST[Items[e][index]];
			iterations = floor(tpe / cost);
			if (_ITEM_COOLDOWN[Items[e][index]] > 0) iterations = 1;
			var cellz = [];
			cellz = _MY_POSSIBLE_ACCES_CELLZ;
			var dmgmap = getDamageMap(Items[e][index], cellz, _ACCESCELLS[e], []);
			for (var cell: var percentage in dmgmap[0]) {
				//if (Items[e][index]==CHIP_FRACTURE) {
				//	_DEBUFFABLE_CELLS[cell] = true;
				//	continue;
				//}
				var score = 0; //_REAL_LIFES[_MY_SELF]-_LIFE[_MY_SELF];
				var bulbm = _BULB_MOVES[cell];
				var my_abs = getAbsoluteShield();
				var my_rel = getRelativeShield();
				//Je retire les effects qui vont partir a la fin de mon tour
				my_rel -= RemoveRelGoneShields();
				my_abs -= RemoveAbsGoneShields();
				//Fin remove effects
				//J'add les bulbs effects
				for (var bulb: var item in bulbm) {
					//WISDOM
					if (_ITEM_EFFECTS[item][0][0] == EFFECT_HEAL) score -= (_ITEM_POWER[item] * (1 + getWisdom(bulb) / 100));
					//REL
					if (_ITEM_EFFECTS[item][0][0] == EFFECT_RELATIVE_SHIELD) my_rel += _ITEM_POWER[item] * (1 + getResistance(bulb) / 100);
					//ABS
					if (_ITEM_EFFECTS[item][0][0] == EFFECT_ABSOLUTE_SHIELD) my_abs += _ITEM_POWER[item] * (1 + getResistance(bulb) / 100);
				}
				//debug("score bulb : "+score);
				//Fin Bulbs
				//Libe : 
				//debug("score : "+score+" my abs : "+my_abs+" my rel : "+my_rel);
				var Libe = false;
				if (LibeCooldowns[e] == 0 && dmgmap[1][cell] && MustLibe(e, _MY_SELF, Items[e][index], percentage, _TP[e])) Libe = true;
				//Fin libe
				//Score
				percentage *= 1 + (getAgility(e) / 1000 * 1.4);
				score += Libe ? getMaxDmg(Items[e][index], getStrength(e), my_rel * 0.4, my_abs * 0.4, getMagic(e), percentage) : getMaxDmg(Items[e][index], getStrength(e), my_rel, my_abs, getMagic(e), percentage);
				var _tp = Libe ? tpe - _ITEM_COST[CHIP_LIBERATION] : tpe;
				iterations = floor(_tp / cost);
				//debug("iterations : " + iterations);
				/*var badones = 1;
				var midscore = 0;
				for (var i in Items[e]) {
					midscore += 
					if (i == Items[e][index]) continue;
					else badones++;
				}*/
				if (_ITEM_COOLDOWN[Items[e][index]] > 0) iterations = 1;
				//debug("Item : "+getItemName(Items[e][index])+" iter : "+iterations+ " dmg :  "+score);
				score *= iterations;
				//if (_danger[cell][e] == null || score > _danger[cell][e]) {
				var life = getLife();
				if (score < life * _MIN_MAP_DAMAGE && score < life * CareFullDead) score = 0;
				if (score > _danger[cell][e] || _danger[cell][e] == null) {
					_danger[cell][e] = score;
					_BEST_CELLS_ATTACK_ENEMY[e][cell] = dmgmap[2][cell];
				}
				//_MOST_DANGEROUS[cell] = e;
				//_MOST_DANGEROUS_ITEM[cell] = [Items[e][index], percentage, Libe];
				//}
				//End Score
				if (getOperations() > _MAP_DANGER_CRIT_OP_LIMIT) break;
			}
			if (getOperations() > _MAP_DANGER_OP_LIMIT) break;
			//if (didlibe==false) didlibe = true;
		}
		if ((getOperations() > _MAP_DANGER_OP_LIMIT) || NumberEnemys == count(_ALIVE_ENEMIES)) break;
	} // end index
	//debug(_danger);
	var _final = [];
	for (var cell: var arrayscore in _danger) {
		var cdmg = 0;
		for (var leek: var dmg in arrayscore) {
			cdmg += dmg;
		}
		//markText(cell, cdmg);
		_final[cell] = cdmg;
	}
	debugW("Loaded damage map at index : " + (JustToDebug));
	for (var c in _MY_POSSIBLE_ACCES_CELLZ) {
		if (_final[c] == null || _final[c] < 0) _final[c] = 0;
	}
	_MAP_DANGER = _final;
	StopTestFunction("Damage map");
}

function PreloadBulbActions(cell, arrayAllWcellz) {
	var _array = [];
	for (var bulb in _ALIVE_ALLIES) {
		if (isSummon(bulb) && !_NAME_IS_GENTLE_BULB[getName(bulb)]) continue;
		if (bulb == _MY_SELF) continue;
		var items = getArrayComboBulbSorted(bulbname(bulb, _MY_SELF)[0]);
		//debug(ArrayItemToString(items)); // fail items for leeksArrayItemToString(items)
		var tp = getTP(bulb);
		for (var item in items) {
			//if (DoesHaveChip(getSummoner(bulb), item)) continue;
			if (tp - _ITEM_COST[item] >= 0) tp -= _ITEM_COST[item];
			else continue;
			for (var wc in arrayAllWcellz[bulb]) {
				if (getUsableItemsFromCellToCell(wc, cell, item, [])) {
					_array[bulb] = item;
					break;
				}
			}
		}
	}
	return _array;
}

function LoadBulbActions() {
	StartTestFunction();
	var _acces = [];
	_BULB_MOVES = [];
	for (var bulb in _ALIVE_ALLIES) {
		//if (!isSummon(bulb)) continue;
		_acces[bulb] = AccesCell(getCell(bulb), getMP(bulb));
	}
	for (var cell in _MY_POSSIBLE_ACCES_CELLZ) {
		var ok = false;
		for (var bu in _ALIVE_ALLIES) {
			if (getCellDistance(getCell(bu), cell) < 5) ok = true;
		}
		if (!ok) continue;
		_BULB_MOVES[cell] = PreloadBulbActions(cell, _acces);
	}
	StopTestFunction("All bulb load for all cellz");
}

function CellToRessurect() {
	var arraySafe = [];
	var mindmg = 99999;
	for (var c: var dmg in _MAP_DANGER)
		if (dmg < mindmg) mindmg = dmg;
	for (var c: var dmg in _MAP_DANGER)
		if (dmg == mindmg) push(arraySafe, c);
	return BestCellBulb(arraySafe);
}

function isLocked(c, addedcell) {
	var x = getCellX(c);
	var y = getCellY(c);
	var cell;
	var nblocked = 0;
	cell = getCellFromXY(x + 1, y);
	if (cell == null || isObstacle(cell) || !isEmptyCell(cell) || cell == addedcell) {
		nblocked++;
	}
	cell = getCellFromXY(x - 1, y);
	if (cell == null || isObstacle(cell) || !isEmptyCell(cell) || cell == addedcell) {
		nblocked++;
	}

	cell = getCellFromXY(x, y + 1);
	if (cell == null || isObstacle(cell) || !isEmptyCell(cell) || cell == addedcell) {
		nblocked++;
	}

	cell = getCellFromXY(x, y - 1);
	if (cell == null || isObstacle(cell) || !isEmptyCell(cell) || cell == addedcell) {
		nblocked++;
	}
	if (nblocked == 4) return true;
	return false;
}

function getBestSortedItems(leek, tanker) {
	var array = [];
	var summ = isSummon(tanker);
	for (var item in GetItems(leek)) {
		if (isPositiv(item) != false || !summ && item == CHIP_BURNING) continue;
		var dmg = getMaxDmg(item, getStrength(leek), getRelativeShield(tanker), getAbsoluteShield(tanker), getMagic(leek), 0);
		dmg = _ITEM_COOLDOWN[item] == 0 ? dmg * (getTP(leek) / _ITEM_COST[item]) : dmg;
		if (dmg <= getLife(tanker) * _MIN_MAP_DAMAGE) continue; //OU 0
		array[item] = dmg;
	}
	var _array_sorted = arraySort(array, function(a, b) {
		if (a < b) return 1;
		else if (a > b) return -1;
		else return 0;
	});
	var _final = [];
	for (var item: var score in _array_sorted) {
		push(_final, item);
	}
	return _final;
}

function ArrayItemToString(arrayItems) {
	return arrayMap(arrayItems, function(x) {
		return getItemName(x);
	});
}

function ArrayLeeksToString(arrayleeks) {
	return arrayMap(arrayleeks, function(x) {
		return getName(x);
	});
}

function getDamageMap(item, myaccescellz, enemyaccescellz, ArrayDid) { //Return [cell : score , cell : score , ...] Score = dmg percent of weapon
	var array = [];
	var ArrayPossibleLibe = [];
	var arraymp = [];
	var summ = isSummon();
	var arrayleeks = [];
	//Put tout les leeks qui ne bougeront pas 
	for (var e in getAliveEnemies()) {
		if (!isSummon(e)) push(arrayleeks, e);
	}
	for (var a in getAliveAllies()) {
		push(arrayleeks, a);
	}

	//Check des cases sur lesquelles l'enemy peut tirer (qui font bien sur parti de mes accescellz)
	for (var c in myaccescellz) {
		if (ArrayDid[c] != null) continue;
		for (var ce: var mp in enemyaccescellz) {
			if (array[c] != null) break;
			if (getUsableItemsFromCellToCell(ce, c, item, arrayleeks)) {
				array[c] = (100 - mp / 10);
				arraymp[c] = [mp, ce];
				if (!summ && getUsableItemsFromCellToCell(ce, c, CHIP_LIBERATION, arrayleeks) || !summ && _ITEM_MAXRANGE[item] - _ITEM_MAXRANGE[CHIP_LIBERATION] > getMP(EnemyLeekG)) ArrayPossibleLibe[c] = true;
			}
		}
	}
	//Plus complexe : gestion des aoe 
	if (_ITEM_AREA[item] == AREA_CIRCLE_1 || _ITEM_AREA[item] == AREA_CIRCLE_2 || _ITEM_AREA[item] == AREA_CIRCLE_3) {
		//Et on fais un cellarea de ces cellz en mettant des scores
		for (var c: var score in array) {
			if (ArrayDid[c] != null || score == 0) continue;
			for (var circlec in _CELL_AREA[item][c]) {
				var dist = getCellDistance(c, circlec);
				var ratio = DivideAoe(getAreaNumber(item), dist, score);
				if (array[circlec] == null && inArray(myaccescellz, circlec) || array[circlec] < ratio && inArray(myaccescellz, circlec)) {
					array[circlec] = ratio * array[c] / 100;
					arraymp[circlec] = arraymp[c];
				}
			}
		}
	}
	return [array, ArrayPossibleLibe, arraymp];
}

function GetNumberOfAllyBulbWhoPlayAfter(entity) {
	var _final = 0;
	var myTO = getEntityTurnOrder(entity);
	var EnemyTO = getEntityTurnOrder(EnemyLeekG);
	for (var L in _ALIVE_ALLIES) {
		if (!isSummon(L)) continue;
		var name = getName(L);
		if (myTO < EnemyTO) { //Je joue avant l'enemy
			var TO = getEntityTurnOrder(L);
			if (TO < EnemyTO && TO > myTO) _final += _COEF_OPS_BULB[name];
		} else { //Je joue apres lui
			//if (getEntityTurnOrder(L) > myTO) _final+=_COEF_OPS_BULB[name];
		}
	}
	return _final;
}

function HidenCellzBulb(celldepart, mp) {
	StartTestFunction();
	var Others = GetNumberOfAllyBulbWhoPlayAfter(_MY_SELF);
	var totalCoef = 0;
	//debug("Others : "+GetNumberOfAllyBulbWhoPlayAfter(_MY_SELF));
	var PossibleOps = Others > 0 ? (((OPERATIONS_LIMIT - getOperations()) / (Others + _COEF_OPS_BULB[getName()]) * (_COEF_OPS_BULB[getName()])) - _OPS_BULB[getName(_MY_SELF)]) : (OPERATIONS_LIMIT - getOperations());
	debug(PossibleOps / 1000 + "k possible opés");
	var Opes = getOperations();
	var MyAccesCellz = GetWalkableCells(celldepart, mp);
	for (var c in MyAccesCellz) {
		if ( /*(_MAP_DANGER[c]!=null && _MAP_DANGER[c] > 0) || */ _BULB_MAP_DANGER[c] != null) removeElement(MyAccesCellz, c);
	}
	var nbchecked;
	var Bestcount = 0;
	for (var e in getAliveEnemies()) {
		var _items = getBestSortedItems(e, _MY_SELF);
		if (count(_items) > Bestcount) Bestcount = count(_items);
		if (_items[0] == null) continue;
		var HisAccesCellz = AccesCellzMp(getCell(e), getMP(e));
		var did = [];
		for (var i = 0; i <= count(_items); i++) {
			if (getOperations() - Opes >= PossibleOps) break;
			if (i > nbchecked) nbchecked = i;
			if (i >= 3) break;
			for (var cell: var percentage in getDamageMap(_items[i], MyAccesCellz, HisAccesCellz, did)[0]) {
				var dmg = /*getMaxDmg(_items[i], getStrength(e), getRelativeShield(), getAbsoluteShield(), getMagic(e), percentage)*/ percentage;
				if (_BULB_MAP_DANGER[cell] < dmg || _BULB_MAP_DANGER[cell] == null) {
					_BULB_MAP_DANGER[cell] = dmg;
					//removeElement(MyAccesCellz, cell);
				}
			}
		}
	}
	debug("Percentage Checked : " + (nbchecked / Bestcount * 100));
	MyAccesCellz = GetWalkableCells(celldepart, mp);
	for (var c in MyAccesCellz) {
		if (_BULB_MAP_DANGER[c] == null && (_MAP_DANGER[c] == null || _MAP_DANGER[c] == 0)) _BULB_MAP_DANGER[c] = 0;
		//if (_BULB_MAP_DANGER[c] == null && (_MAP_DANGER[c]!=null && _MAP_DANGER[c]>0)) _BULB_MAP_DANGER[c] = _MAP_DANGER[c];
		markText(c, _BULB_MAP_DANGER[c]);
	}
	var PathLeek = getPath(getCell(getSummoner()), getCell(EnemyLeekG));
	var BestScore = 9999999;
	var BestCellz = [];
	for (var cell in MyAccesCellz) {
		if (inArray(PathLeek, cell)) continue;
		var score = _BULB_MAP_DANGER[cell];
		var ally = getSummoner();
		//if (ally == null) ally = EnemyLeekG; //Pour que les test de distances passe quand meme
		if (score < BestScore && !isLocked(getCell(getSummoner()), cell) && (score == 0 || !isOnSameLine(cell, getCell(ally)) || !lineOfSight(cell, getCell(ally)))) {
			BestScore = score;
			BestCellz = [];
			push(BestCellz, cell);
		} else {
			if (score == BestScore && !isLocked(getCell(getSummoner()), cell) && (score == 0 || !isOnSameLine(cell, getCell(ally)) || !lineOfSight(cell, getCell(ally)))) {
				push(BestCellz, cell);
			}
		}
	}
	mark(BestCellz, COLOR_GREEN);
	debug("Nb Items Checked : " + (nbchecked + 1));
	StopTestFunction("Damage map bulb");
	return BestCellz;
}

function BestCellBulb(tableaucellz) {
	var arrayGravity = _GRAVITY_CELLZ;
	if (isSummon()) {
		var me = getEntity();
		var AccesMp = [];
		var Centre = getCellFromXY(0, 0);
		for (var e in _ALIVE_ENEMIES) {
			AccesMp[e] = CellMp(getCell(e), getMP(e));
		}
		for (var c in tableaucellz) {
			if (arrayGravity[c]==null) arrayGravity[c]=0;
			for (var e in _ALL_LEEKS) {
				var mpe = getMP(e);
				if (isEnemy(e)) {
					var array = _BEST_CELLS_ATTACK_ENEMY[e][c]; //[e][getcell] -- > [mp , cellfrom]
					arrayGravity[c] += _PATHS_LENGHT[c][e] * (Dmgbulbcoef(FromNameToChip(e), me)[1] / _COEF_FOCUS_LEEK * 18);
					var mp = array[0];
					if (mp == null) continue;
					//arrayGravity[c]-=mp/mpe*6;
					for (var ec: var emp in AccesMp[e]) {
						if (getCellDistance(ec, Centre) < getCellDistance(c, Centre)) arrayGravity[c] += 0.6;
					}
				} else {
					var dist = _PATHS_LENGHT[c][e] == null ? getCellDistance(c, getCell(e)) : _PATHS_LENGHT[c][e];
					var opticoef = (Dmgbulbcoef(FromNameToChip(e), EnemyLeekG)[1] / _COEF_FOCUS_LEEK * 70);
					var coef = opticoef != null ? opticoef : 1;
					arrayGravity[c] -= dist * coef;
				}
			}
		}
	}
	var BestCell;
	var BestScore = -5000;
	for (var c in tableaucellz) {
		var score = arrayGravity[c];
		if (score > BestScore) {
			BestCell = c;
			BestScore = score;
		}
	}
	return BestCell;
}

function getBestCellToHide(arraydanger, enemy, AccesCellz) {
	var BestScore = 9999999999;
	var BestCell;
	var ArrayCellzEgal = [];
	var ArrayCellzDanger = [];
	var avoid = [];
	var Futur_covided = [];
	for (var cell in AccesCellz) ArrayCellzDanger[cell] = arraydanger[cell];
	//debug(ArrayCellzDanger);
	for (var cell: var score in ArrayCellzDanger) {
		//mark(cell, COLOR_BLUE);
		if (score < getLife() && isLocked(getCell(EnemyLeekG), cell)) return [cell, score, true];
		for (var c in _AOE1[cell]) {
			if (isLocked(cell, c)) avoid[cell] = true;
		}
		if (score < BestScore && score != null) BestScore = score;
	}
	for (var cell: var score in ArrayCellzDanger) {
		if (score == BestScore && (!avoid[cell] || isEmpty(ArrayCellzEgal))) push(ArrayCellzEgal, cell);
	}
	for (var c in ArrayCellzEgal) {
		Futur_covided[c] = [];
		for (var aoe in _AOE2[c]) {
			if (isEntity(aoe)) push(Futur_covided[c], getEntityOnCell(aoe));
		}
	}
	//debug("Best hide score : "+BestScore);
	BestCell = BestCellBulb(ArrayCellzEgal);
	return [BestCell, BestScore, false, avoid[BestCell], Futur_covided[BestCell]];
}

function getSortedItemsByCost(Items) {
	return arraySort(Items, function(a, b) {
		var CostA = _ITEM_COOLDOWN[a] > 0 ? _ITEM_COST[a] : floor(getTP() / _ITEM_COST[a]);
		var CostB = _ITEM_COOLDOWN[b] > 0 ? _ITEM_COST[b] : floor(getTP() / _ITEM_COST[b]);
		if (CostA > CostB) return 1;
		else if (CostA < CostB) return -1;
		else return 0;
	});
}

function AreTheSame(array1, array2) {
	for (var i = 0; i < count(array1); i++) {
		if (array1[i] != array2[i]) return false;
	}
	return true;
}

function OnlyItemAcces(cell, walk) {
	var array = [];
	var tmp = [];
	var _final = [];
	var BestScore = 0;
	if (getTurn() == 1) return walk;
	for (var i in GetItems(getEntity())) {
		BestScore = 0;
		array = [];
		var walkable = [];
		for (var c: var pm in walk) {
			for (var item in _USABLE_ITEMS[c]) {
				if (item == i) walkable[c] = pm;
			}
		}
		/*debug("Weapon : "+ getItemName(i) + " mp : "+mp);
		for (var c:var pm in walkable) {
			mark(c);
		}
		pause();*/
		//mark(walkable,COLOR_BLUE);
		/*for (var c: var pm in walkable) {
			var score = _MAP_ACTION_SCORED[c][0];
			if (score > BestScore) BestScore = score;
		}
		for (var c: var pm in walkable) {
			var score = _MAP_ACTION_SCORED[c][0];
			if (score*2.5 > BestScore) array[c] = pm;
		}*/
		array = walkable;
		array[cell] = 0;
		for (var c: var pm in array) {
			//mark(c, COLOR_BLUE);
			var ok = false;
			var ok2 = false;
			/*for (var celll in _AOE1[c]) {
				if (array[celll] == array[c] - 1) ok = true;
			}
			if (!ok) {
				for (var celll in _AOE2[c]) {
					if (array[celll] == array[c] - 2) ok = true;
				}
			}*/
			for (var celll in _AOE3[c]) {
				var notnull = _USABLE_ITEMS[c] != null && _USABLE_ITEMS[celll] != null ? true : false;
				if (array[celll] == array[c] - 1 || array[celll] == array[c] - 2 || array[celll] == array[c] - 3) ok = true;
				if (notnull /*&& count(_USABLE_ITEMS[celll]) >=count(_USABLE_ITEMS[c]) && AreTheSame(_USABLE_ITEMS[c], _USABLE_ITEMS[celll]) */ && tmp[celll] != null) ok2 = true;
			}
			if (ok == true && ok2 == true) continue;
			else tmp[c] = pm;
		}
		if (!isPositiv(i)) {
			for (var c: var pm in tmp) {
				if (_final[c] == null) _final[c] = pm;
			}
		} else {
			for (var c: var pm in tmp) {
				if (_final[c] == null) _final[c] = pm;
				break;
			}
		}
	}
	//debug(_final);
	for (var c: var pm in _final) {
		mark(c, COLOR_RED);
	}

	return _final;
}


function getBestOnlyItem(cellfrom, mp, tp, cellold, items) {
	StartTestFunction();
	var AccesCellz = GetWalkableCells(cellfrom, mp);
	var Life = getLife();
	if (cellfrom != cellold) _BEST_DMG_CELL = [];
	_BEST_DMG_CELL[cellfrom] = getBestCellToHide(_MAP_DANGER, EnemyLeekG, AccesCellz);
	var BestScore = 0;
	//debug(_MAP_DANGER);
	BestScore -= (_BEST_DMG_CELL[cellfrom][1] * _SCORE_PLAY_SAFE);
	//debug('actual taking damage : ' + (-BestScore / _SCORE_PLAY_SAFE));
	//mark(_BEST_DMG_CELL[cellfrom][0], COLOR_GREEN);
	if (_BEST_DMG_CELL[cellfrom][1] >= Life) BestScore -= _SCORE_DEATH;
	else {
		if (_BEST_DMG_CELL[cellfrom][1] > Life * CareFullDead) BestScore -= _SCORE_RISK_DEATH;
	}
	debug("No action score : " + BestScore);
	var ItemAcces;
	var _TP_ITEMS = [null, CHIP_JUMP];
	var BestItem;
	var BestFrom;
	var BestTo;
	var ItemScore = 0;
	var cell = 0;
	var score = 1;
	var myweap = getWeapon();
	var mytp = tp;
	var NbItemsCheck = 0;
	var TimeToStop = false;
	var BestDmgMap;
	var tmpscore;
	var tparray = [];
	var tmppath;
	for (var tpi in _TP_ITEMS) {
		//debug(ArrayItemToString(items));
		if (!inArray(GetItems(_MY_SELF), tpi) && tpi != null) continue;
		var eff = tpi == CHIP_LEATHER_BOOTS ? 2 : _ITEM_MAXRANGE[CHIP_JUMP];
		var tpcost = tpi == null ? 0 : _ITEM_COST[tpi];
		var distadd = tpi == null ? 0 : eff;
		var scoreadd = tpi == CHIP_JUMP ? 100 * _COEF_TIMES_BOOST_AGILITY[_MY_SELF] : 0;
		//debug(distadd);
		var WalkMP = GetWalkableCellsMP(cellfrom, mp + distadd);
		if (tpi == CHIP_JUMP) WalkMP = JumpCellzMp(cellfrom, mp);
		ItemAcces = OnlyItemAcces(cellfrom, WalkMP);
		//mark(getCellzToUseItem(ItemAcces, CHIP_FRACTURE));
		if (getOperations() > _BEST_ITEM_OP_LIMIT) {
			debug("break play : " + NbItemsCheck + " items check / " + count(GetItems(_MY_SELF)));
			TimeToStop = true;
			break;
		}
		/*for (var c:var pm in ItemAcces) {
			mark(c);
		}*/
		//debug(ItemAcces[getCell()]);
		tmpscore = BestScore;
		for (var item in items) {
			if (item == CHIP_LIBERATION || item == CHIP_INVERSION) continue;
			NbItemsCheck++;
			if (_ITEM_IS_WEAPON[item] && myweap != item) mytp -= 1;
			var TimesUseItem = DivideTP ? 1 : _ITEM_COOLDOWN[item] > 0 ? 1 : floor(mytp / (_ITEM_COST[item] + tpcost));
			var cost = (_ITEM_IS_WEAPON[item] && myweap != item) ? (_ITEM_COST[item] * TimesUseItem + tpcost + 1) : (_ITEM_COST[item] * TimesUseItem + tpcost);
			if (cost > tp || cost == 0 || cost == 1) continue;
			if (tp < 5) cost = 1; // Pour eviter de prendre en compt les tp sur le last item
			for (var from in getCellzToUseItem(ItemAcces, item)) {
				ItemScore = 0;
				if (getOperations() > _BEST_ITEM_OP_LIMIT) {
					debug("break play : " + NbItemsCheck + " items check / " + count(GetItems(_MY_SELF)));
					TimeToStop = true;
					break;
				}
				var PathL = ItemAcces[from];
				var Path = getPath(from, cellfrom);
				//var Ops = getOperations();
				var dmgBestCell = _BEST_DMG_CELL[from];
				if (dmgBestCell[0] == null) {
					//load de la bestdmgcell et mise en cache
					dmgBestCell = getBestCellToHide(_MAP_DANGER, EnemyLeekG, GetWalkableCells(from, getMP() - PathL + distadd));
					_BEST_DMG_CELL[from] = dmgBestCell;
				}
				//debug("Opés load dmg cells : "+((getOperations()-Ops)/1000)+" k");
				var CAoE = getBestAoeCell(from, item, TimesUseItem, tp);
				if (_DEBUG) debug("item : " + getItemName(item) + " Aoe : " + CAoE + " cost : " + (cost) + " score play safe : " + _SCORE_PLAY_SAFE + " damage taking : " + dmgBestCell[1]);
				if (CAoE[score] == 0 || CAoE[cell] == null || getUsableItemsFromCellToCell(getCell(), CAoE[cell], item, []) && from != getCell()) continue;
				if (CAoE[score] / cost <= BestScore) continue;
				var dmg_maped = dmgBestCell[1];
				var Abandon = false;
				for (var c in Path) {
					if (c != from && getUsableItemsFromCellToCell(c, CAoE[cell], item, [])) Abandon = true;
				}
				tmppath = Path;
				//mark(Path[4]);
				if (Abandon) continue;
				var LifeSteal = CAoE[2];
				Life = RealLeeklife(_MY_SELF) + LifeSteal;
				var targets = getItemTargets(item, CAoE[0]);
				if (LifeSteal > 0 && LifeSteal != null && LifeSteal[0] == null) dmg_maped = dmg_maped - LifeSteal;
				if (from != getCell() && targets[0] == _MY_SELF && count(targets) == 1) continue;
				if (DivideTP) CAoE[score] /= cost;
				ItemScore += CAoE[score] + scoreadd;
				if (dmgBestCell[2]) ItemScore += _SCORE_LOCK;
				if (dmgBestCell[3]) ItemScore -= _SCORE_LOCK;
				if (getCooldown(CHIP_JUMP) < 2 && getCooldown(CHIP_TELEPORTATION) < 10) {
					ItemScore -= (dmg_maped * _SCORE_PLAY_SAFE);
					if (dmg_maped >= Life * _SCORE_DEATH_PERCENT /* && !_ITEM_CAN_REMOVE_DANGER[item]*/ ) ItemScore -= _SCORE_DEATH;
					else {
						if (dmg_maped > Life * CareFullDead) ItemScore -= _SCORE_RISK_DEATH;
					}
				}
				var covided = dmgBestCell[4];
				for (var entity in covided) {
					var mydmg = 0;
					var Putable = true;
					//dmg * (coef / _COEF_DIVIDE_COEFS);
					for (var effect in getEffects()) {
						if (effect[5] == CHIP_COVID) mydmg = effect[1];
					}
					//if (mydmg == 0) break;
					for (var effect in getEffects(entity)) {
						if (effect[5] == CHIP_COVID) Putable = false;
					}
					if (Putable == true) {
						var coef = isAlly(entity) ? _COEF_HEAL[entity] : _COEF_DMG[entity];
						ItemScore += mydmg * (coef / _COEF_DIVIDE_COEFS);
						debug("I can put covid to : " + getName(entity) + " for : " + mydmg + " damage per turn");
					}
				}
				//ItemScore -= (Path) / 10000;
				//if (_DEBUFFABLE_CELLS[dmgBestCell[0]]) ItemScore*= _TIMES_DEBUFF_SCARES;
				if (ItemScore > BestScore) {
					BestDmgMap = dmg_maped;
					BestScore = ItemScore;
					BestItem = item;
					BestFrom = from;
					BestTo = CAoE[cell];
				}
			} //Fin from
			if (TimeToStop) break;
		} //Fin Item
		if (tmpscore == BestScore || tpi == null) continue;
		//debugC("Waouw tp", COLOR_BLUE);
		if (tpi == CHIP_JUMP || tpi == CHIP_TELEPORTATION) {
			reverse(tmppath);
			var mpmax;
			var cellmax;
			tmppath[getCell()] = 0;
			for (var pm: var c in tmppath) {
				if (getCellDistance(c, BestFrom) <= 3) {
					cellmax = c;
					break;
				}
			}
			//mark(celltotp, COLOR_BLUE);
			tparray = [tpi, BestFrom, false];
			BestFrom = cellmax;
		} else if (tpi == CHIP_LEATHER_BOOTS) {
			tparray = [tpi, getCell(), true];
		}
	} // FIn TP
	//debug(_BEST_DMG_CELL);
	//debug('Dmg that i am taking if not removing damage : ' + _BEST_DMG_CELL[BestFrom][1]);
	//debug("Score of dmg : " + BestScore);
	/*var Divided = _BEST_DMG_CELL[BestFrom][1] > 0 ? BestDmgMap / _BEST_DMG_CELL[BestFrom][1] : 0;
	Divided /= 1;
	for (var c: var a in _BEST_DMG_CELL) {
		if (Divided == 0 || Divided == 1 || !_ITEM_CAN_REMOVE_DANGER[BestItem]) break;
		var dmgc = _BEST_DMG_CELL[c];
		var nb = dmgc[1];
		var celll = dmgc[0];
		var booleen = dmgc[2];
		nb *= Divided;
		_MAP_DANGER[c] = nb;
		_BEST_DMG_CELL[c] = [celll, nb, booleen];
	}*/
	StopTestFunction("New Only Item");
	return [BestItem, BestFrom, BestTo, tparray];
}

function getBestOnlyChipToUseForBulb(entity, inv) {
	var BestScore = 0;
	var BestItem;
	var BestFrom;
	var BestTo;
	var acces = GetWalkableCellsMP(getCell(entity), getMP(entity));
	acces[getCell()] = 0;
	var ForgetBulbs = false;
	if (getOperations() > 18000000) ForgetBulbs = true;
	var summ = getSummoner();
	for (var i in inv) {
		if (getTP() < _ITEM_COST[i] || getCooldown(i) > 0) continue;
		var TimesUseItem = _ITEM_COOLDOWN[i] > 0 ? 1 : floor(getTP() / _ITEM_COST[i]);
		for (var cell: var mp in acces) {
			if (getCellDistance(cell, getCell(getNearestEnemy())) > _ITEM_MAXRANGE[i] && !isPositiv(i)) continue;
			if (getCellDistance(cell, getCell(getNearestAlly())) > _ITEM_MAXRANGE[i] && isPositiv(i)) continue;
			if (ForgetBulbs) {
				if (getCellDistance(cell, getCell(summ)) > _ITEM_MAXRANGE[i] && isPositiv(i)) continue;
			}
			var Score = 0;
			var targets = [];
			var BestShootCell = getBestAoeCell(cell, i, TimesUseItem, getTP());
			if (BestShootCell[0] == null) continue;
			Score = BestShootCell[1];
			targets = getChipTargets(i, BestShootCell[0]);
			if (getCell() != cell && getUsableItemsFromCellToCell(getCell(), BestShootCell[0], i, [_MY_SELF])) continue;
			if (count(targets) == 1 && targets[0] == entity && cell != getCell()) continue;
			if (getName(entity) == "metallic_bulb" && isSummon(targets[0])) continue;
			if (inArray(targets, EnemyLeekG) && inArray(getWeapons(EnemyLeekG), WEAPON_REVOKED_M_LASER) && getName(entity) != "wizard_bulb") continue;
			/*if (_NAME_IS_GENTLE_BULB[getName(_MY_SELF)]) {
				var LessDmg = 99999;
				for (var cd: var mpd in CellMp(cell, getMP(entity) - mp)) {
					var Bmd = _BULB_MAP_DANGER[cd];
					if (Bmd < LessDmg) LessDmg = Bmd;
				}
				Score -= LessDmg * _SCORE_PLAY_SAFE_BULB;
			}*/
			/*if (!_NAME_IS_GENTLE_BULB[getName(entity)]) arrayIter(targets, function(x) {
				if (isSummon(x)) Score *= _TIMES_BULB_FOCUS_BULBS;
			});*/
			if (Score > BestScore) {
				BestScore = Score;
				BestFrom = cell;
				BestItem = i;
				BestTo = BestShootCell[0];
			}
		}
	}

	return [BestItem, BestFrom, BestTo];
}

function WCellzBulb() {
	var _final = [];
	for (var c: var mp in CellMp(getCell(), getMP())) {
		push(_final, c);
	}
	return _final;
}

function AiForBulbs() {
	var Name;
	var ops = getOperations();
	StartTestFunction();
	for (var i = 0; i < 10; i++) {
		UpdateLeekEffects();
		setCoef();
		if (getOperations() - ops > _OPS_BULB[getName()]) break;
		if (isLocked(getCell(getSummoner()), getCell())) moveAwayFrom(getSummoner(), 1);
		Name = bulbname(_MY_SELF, EnemyLeekG)[0];
		var item = getBestOnlyChipToUseForBulb(_MY_SELF, getArrayComboBulbSorted(Name));
		if (item[0] == null) break;
		var BestShootCell = item[2];
		var getCellToUse = item[1];
		moveTowardCell(getCellToUse);
		var times = _ITEM_COOLDOWN[item[0]] > 0 ? 1 : floor(getTP() / _ITEM_COST[item[0]]);
		for (var h = 0; h < times; h++) {
			useChipOnCell(item[0], BestShootCell);
		}
	}
	PiptronBulb();

	var BestCell = !_NAME_IS_GENTLE_BULB[getName(_MY_SELF)] ? BestCellBulb(WCellzBulb()) : BestCellBulb(HidenCellzBulb(getCell(), getMP()));
	moveTowardCell(BestCell);
	StopTestFunction("bulb");
}

function Play(enemys, weapon, cell, mp, enemyweapon, tpa, healAlly) {
	StartTestFunction();
	var tp = getTP();
	var tabSummon = [];
	var inv = GetItems(_MY_SELF);
	var oldcell;
	var ShouldAntidote = false;
	if (DmgForTurn(_MY_SELF) > getLife() / 5 && getCooldown(CHIP_ANTIDOTE) == 0 && inArray(getChips(), CHIP_ANTIDOTE)) {
		ShouldAntidote = true;
	}
	if (ShouldAntidote && tp >= _ITEM_COST[CHIP_ANTIDOTE]) {
		tp -= _ITEM_COST[CHIP_ANTIDOTE];
		_ITEM_MINRANGE[WEAPON_GAZOR] = 2;
		_ITEM_MINRANGE[CHIP_PLAGUE] = 1;
		_ITEM_MINRANGE[CHIP_TOXIN] = 1;
	}
	if (!ShouldAntidote && abs(HelpLibeScoreEnemy(getEntity())) > 9000 && HelpLibeScoreEnemy(getEntity()) < 0 && getCooldown(CHIP_LIBERATION) == 0 && inArray(getChips(), CHIP_LIBERATION)) {
		tp -= _ITEM_COST[CHIP_LIBERATION];
		useChip(CHIP_LIBERATION, getEntity());
	}
	//debug('My libe score : '+ (HelpLibeScoreEnemy(getLeek())));
	while (true) {
		UpdateLeekEffects();
		setCoef();
		if (isDead(EnemyLeekG)) EnemyLeekG = EnemyLeek();
		if (getOperations() > _PLAY_OP_LIMIT) {
			debug("Break : " + (getOperations() / 1000000) + " OP PLAY");
			break;
		}
		////////////////////////////////////////////////////////////////////////////////
		//Regen part
		////////////////////////////////////////////////////////////////////////////////
		if (getLife() < 1000 && getCooldown(CHIP_REGENERATION) == 0 && inArray(getChips(), CHIP_REGENERATION)) {
			useChip(CHIP_REGENERATION, _MY_SELF);
			tp -= _ITEM_COST[CHIP_REGENERATION];
			UpdateLeekEffects();
			setCoef();
		}
		////////////////////////////////////////////////////////////////////////////////
		//Best item part
		////////////////////////////////////////////////////////////////////////////////
		var items = GetItems(getEntity());
		for (var bulb in tabSummon) {
			removeElement(items, bulb);
		}
		var bi = getBestOnlyItem(getCell(), getMP(), tp, oldcell, getSortedItemsByCost(items));
		var BestShootingCell = bi[2];
		var CellToShoot = bi[1];
		var tparray = bi[3];
		for (var i in tabSummon) {
			if (_IS_GENTLE_BULB[i] == false && CellToShoot != null && getCellDistance(getCell(), getCell(EnemyLeekG)) < getCellDistance(CellToShoot, getCell(EnemyLeekG)) || _IS_GENTLE_BULB[i] == false && CellToShoot == null) {
				spawn(i, AiForBulbs);
			}
		}
		if (bi[0] == null || tp <= 0 || _ITEM_COST[bi[0]] > tp) {
			debug("break moving to hiden cells tp : " + tp);
			break;
		}
		if (_ITEM_IS_WEAPON[bi[0]] && getWeapon() != bi[0]) tp -= 1;
		debug("Using : " + getItemName(bi[0]));
		if (isPositiv(bi[0]) != null) {
			if (tparray[0] != null && tparray[2] == true) useChipOnCell(tparray[0], tparray[1]);
			moveTowardCell(CellToShoot);
			if (tparray[0] != null && tparray[2] == false) useChipOnCell(tparray[0], tparray[1]);
			//////////////////////////////////////////////////////////////////////////////
			//Libe/Inver Part
			//////////////////////////////////////////////////////////////////////////////
			for (var l in getAliveEnemies()) {
				if (isSummon(l)) continue;
				var Libed = false;
				if (getCooldown(CHIP_LIBERATION) == 0 && MustLibe(getEntity(), l, bi[0], getCellDistance(BestShootingCell, getCell(l)), tp) && getUsableItemsFromCellToCell(CellToShoot, getCell(l), CHIP_LIBERATION, []) && inArray(getItemTargets(bi[0], BestShootingCell), l) && inArray(getChips(), CHIP_LIBERATION)) {
					useChip(CHIP_LIBERATION, l);
					tp -= _ITEM_COST[CHIP_LIBERATION];
					Libed = true;
					//debug('Libéré !');
				}
				if (getCooldown(CHIP_INVERSION) == 0 && MustInver(getEntity(), l, bi[0], getCellDistance(BestShootingCell, getCell(l)), tp) && getUsableItemsFromCellToCell(CellToShoot, getCell(l), CHIP_INVERSION, []) && inArray(getItemTargets(bi[0], BestShootingCell), l) && inArray(getChips(), CHIP_INVERSION) && !Libed) {
					useChipOnCell(CHIP_INVERSION, getCell(l));
					tp -= _ITEM_COST[CHIP_INVERSION];
					BestShootingCell = CellToShoot;
					//debug('Inversé !');
				}
			}
			//////////////////////////////////////////////////////////////////////////////
			//Covetoussness part
			//////////////////////////////////////////////////////////////////////////////
			if (inArray(getChips(), CHIP_COVETOUSNESS) && getCooldown(CHIP_COVETOUSNESS) == 0) {
				var min = 1;
				var BestCell;
				for (var to in getAllShootableCellz(getCell(), CHIP_COVETOUSNESS)) {
					var tar = getChipTargets(CHIP_COVETOUSNESS, to);
					var nb = 0;
					for (var e in tar) {
						if (isEnemy(e)) nb++;
					}
					if (nb > min) {
						min = nb;
						BestCell = to;
					}
				}
				if (BestCell != null) {
					var pt = getTP();
					useChipOnCell(CHIP_COVETOUSNESS, BestCell);
					tp += getTP() - pt;
				}
			}
			//////////////////////////////////////////////////////////////////////////////
			//Devil strike part
			//////////////////////////////////////////////////////////////////////////////
			if (bi[0] == CHIP_DEVIL_STRIKE) {
				useChip(bi[0], _MY_SELF);
			}
			//////////////////////////////////////////////////////////////////////////////
			//using items
			//////////////////////////////////////////////////////////////////////////////
			if (getStrength() >= 400 || getOperations() >= _BEST_ITEM_OP_LIMIT) {
				var TP_ = tp;
				while (TP_ >= _ITEM_COST[bi[0]]) {
					useItem(bi[0], BestShootingCell, getWeapon());
					TP_ -= _ITEM_COST[bi[0]];
					if (_ITEM_COOLDOWN[bi[0]] > 0 || count(getItemTargets(bi[0], BestShootingCell)) == 0) break;
					var Worth = false;
					for (var t in getItemTargets(bi[0], BestShootingCell)) {
						if (RealLeeklife(t) > 0) Worth = true;
					}
					if (!Worth) break;
				}
				tp = TP_ + _ITEM_COST[bi[0]];
			} else useItem(bi[0], BestShootingCell, getWeapon());
			//////////////////////////////////////////////////////////////////////////////
			//End items (no bulbs)
			//////////////////////////////////////////////////////////////////////////////
		} //end is positiv != null
		//////////////////////////////////////////////////////////////////////////////
		//bulb storage
		//////////////////////////////////////////////////////////////////////////////
		if (isPositiv(bi[0]) == null && bi[0] != CHIP_TELEPORTATION && bi[0] != CHIP_ANTIDOTE && bi[0] != CHIP_INVERSION && bi[0] != CHIP_LIBERATION && bi[0] != CHIP_RESURRECTION) {
			removeElement(inv, bi[0]);
			push(tabSummon, bi[0]);
		}
		//////////////////////////////////////////////////////////////////////////////
		//resu part
		//////////////////////////////////////////////////////////////////////////////
		if (bi[0] == CHIP_RESURRECTION && getFightType() == FIGHT_TYPE_SOLO) {
			var e = RessurectionSummon()[1];
			var me = _MY_SELF;
			_MY_SELF = e;
			resurrect(e, CellToRessurect());
			_MY_SELF = me;
		}
		if (bi[0] == CHIP_RESURRECTION && getFightType() != FIGHT_TYPE_SOLO) {
			resurrect(DeadAlly()[0], CellToRessurect());
		}
		//////////////////////////////////////////////////////////////////////////////
		//End play each item
		//////////////////////////////////////////////////////////////////////////////
		tp -= _ITEM_COST[bi[0]];
		if (bi[0] == CHIP_MOTIVATION) tp += 3;
		if (bi[0] == CHIP_ADRENALINE) tp += 5;
		if (isPositiv(bi[0]) != null || bi[0] == CHIP_RESURRECTION) inv = GetItems(_MY_SELF);
		oldcell = getCell();
		if (getLife(EnemyLeekG) + 100 < getTotalLife(EnemyLeekG)) {
			push(inv, CHIP_ALTERATION);
			push(inv, WEAPON_MYSTERIOUS_ELECTRISOR);
		}
	} //Fin While
	if (ShouldAntidote) {
		useChip(CHIP_ANTIDOTE, _MY_SELF);
		_ITEM_MINRANGE[WEAPON_GAZOR] = 4;
		_ITEM_MINRANGE[CHIP_PLAGUE] = 4;
		_ITEM_MINRANGE[CHIP_TOXIN] = 2;
	}
	//////////////////////////////////////////////////////////////////////////////
	//Hidding part
	//////////////////////////////////////////////////////////////////////////////
	var BestHideCellz = getBestCellToHide(_MAP_DANGER, EnemyLeekG, GetWalkableCells(getCell(), getMP()));
	moveTowardCell(BestHideCellz[0]);
	//////////////////////////////////////////////////////////////////////////////
	//Spawnning part
	//////////////////////////////////////////////////////////////////////////////
	for (var i in tabSummon) {
		spawn(i, AiForBulbs);
	}
	//////////////////////////////////////////////////////////////////////////////
	//end play
	//////////////////////////////////////////////////////////////////////////////
	StopTestFunction("Play");
	return tabSummon;
}
/////////////////////////////////////////////////////////////////////////////////////////////TP Focus
/////////////////////////////////////////////////////////////////////////////////////////////

for (var l in _ALL_LEEKS) {
	if (getCooldown(CHIP_ANTIDOTE, l) >= 3 && inArray(getChips(l), CHIP_ANTIDOTE) && getLife() > 2000 && inArray(getChips(), CHIP_TELEPORTATION) && getCooldown(CHIP_TELEPORTATION) == 0 && getStrength(EnemyLeekG) <= 500) {
		var celltousechip = getCellToUseChip(CHIP_FRACTURE, l);
		var pathchip = getPathLength(getCell(), celltousechip);
		var celltelechip = getCellsToUseChipOnCell(CHIP_TELEPORTATION, celltousechip);
		var pathtp = getPathLength(getCell(), celltelechip);
		if (pathchip >= 10 && pathtp <= 2) {
			moveTowardCell(celltelechip);
			useChipOnCell(CHIP_TELEPORTATION, celltousechip);
		}
	}
}


/////////////////////////////////////////////////////////////////////////////////////////////Inver/TP locked
/////////////////////////////////////////////////////////////////////////////////////////////

for (var l in _ALL_LEEKS) {
	if (isLocked(getCell(), getCell(l))) {
		if (inArray(getChips(), CHIP_INVERSION) && (!inArray(getChips(l), CHIP_INVERSION) || getCooldown(CHIP_INVERSION, l) >= 3)) {
			useChipOnCell(CHIP_INVERSION, getCell(l));
		}
		if (inArray(getChips(), CHIP_TELEPORTATION) && (!inArray(getChips(), CHIP_INVERSION) || getCooldown(CHIP_INVERSION) == 0)) {
			for (var c in _AOE2[getCell(l)]) {
				if (!isLeek(c) && !isObstacle(c) && c != null) {
					useChipOnCell(CHIP_TELEPORTATION, c);
					break;
				}
			}
		}
	}
}



