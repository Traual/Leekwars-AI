function SortedSupportItems(leek) {
	var tmp = [];
	for (var i in GetItems(leek)) {
		if (!isPositiv(i)) continue;
		var times = 0;
		for (var eff in _ITEM_EFFECTS[i]) {
			if (eff[0] == EFFECT_HEAL && times == 0) times = 2;
			if (eff[0] == EFFECT_RELATIVE_SHIELD && times == 0) times = 20;
			if (eff[0] == EFFECT_ABSOLUTE_SHIELD && times == 0) times = 4;
		}
		tmp[i] = _ITEM_POWER[i] * times;
	}
	var sort = arraySort(tmp, function(a, b) {
		if (a < b) return 1;
		else if (a > b) return -1;
		else return 0;
	});
	var final = [];
	var cnt = 0;
	for (var i in sort) {
		cnt++;
		push(final, i);
		if (cnt > 1) break;
	}
}

function DeadAlly() {
	var array = [];
	for (var i in getDeadAllies()) {
		if (!isSummon(i)) {
			push(array, i);
		}
	}
	return array;
}

function getNeighbouringCellz(cell) {
	var tabcellz = [];
	var cellxy;
	var x = getCellX(cell);
	var y = getCellY(cell);
	cellxy = getCellFromXY(x + 1, y);
	if (cellxy != null && !_OBSTACLES[cellxy] && isEmptyCell(cellxy)) {
		push(tabcellz, cellxy);
	}
	cellxy = getCellFromXY(x - 1, y);
	if (cellxy != null && !_OBSTACLES[cellxy] && isEmptyCell(cellxy)) {
		push(tabcellz, cellxy);
	}
	cellxy = getCellFromXY(x, y + 1);
	if (cellxy != null && !_OBSTACLES[cellxy] && isEmptyCell(cellxy)) {
		push(tabcellz, cellxy);
	}
	cellxy = getCellFromXY(x, y - 1);
	if (cellxy != null && !_OBSTACLES[cellxy] && isEmptyCell(cellxy)) {
		push(tabcellz, cellxy);
	}
	return tabcellz;
}

function GetPossibleWalkableCells(cell, mp) {
	var accesscells = [cell];
	var set = [cell];
	for (var i = 0; i < mp; i++) {
		var Bords = [];
		for (var cellz in set) {
			for (var c in _AOE1[cellz]) {
				if (accesscells[c] == null) {
					accesscells[c] = c;
					push(Bords, c);
				}
			}
		}
		set = Bords;
	}
	return accesscells;
}

