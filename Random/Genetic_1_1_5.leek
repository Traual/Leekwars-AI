/////////////////////////////////////////////////////////////////////////////////////////////Ti peu de machine learning
/////////////////////////////////////////////////////////////////////////////////////////////
if (getRegister("Nb Fights") == null) setRegister("Nb Fights", 0);
if (getRegister("WIN") == null) setRegister("WIN", 0);
if (getRegister("Best Coef") == null) setRegister("Best Coef", 0.01);
if (getRegister("Tested Coef") == null) setRegister("Tested Coef", randFloat(0, 100));
if (getRegister("Best Nb Wins") == null) setRegister("Best Nb Wins", 0);
if (getFightContext() == FIGHT_CONTEXT_CHALLENGE) {
	if (RealLeeklife(EnemyLeekG) <= 0 || getAliveEnemiesCount() == 0) setRegister("WIN", number(getRegister("WIN")) + 1);
}

function ResetTestCoef(coef) {
	setRegister("Tested Coef", randFloat(0, 100000));
	setRegister("WIN", 0);
	setRegister("Nb Fights", 0);
}

function setMyCoef(coef, nbfights) {
	if (getFightContext() == FIGHT_CONTEXT_CHALLENGE) {
		if (number(getRegister("Nb Fights")) >= nbfights) {
			if (number(getRegister("Best Nb Wins")) < number(getRegister("WIN"))) {
				setRegister("Best Coef", number(getRegister("Tested Coef")));
				setRegister("Best Nb Wins", number(getRegister("WIN")));
			}
			ResetTestCoef(coef);
		}
		setRegister("Nb Fights", number(getRegister("Nb Fights")) + 1);
		coef = number(getRegister("Tested Coef"));
		debug("The value of the coef : " + coef);
	}
}


