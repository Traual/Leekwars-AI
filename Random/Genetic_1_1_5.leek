function MustFocusEnemy(enemy) {
	var totalLife = getTotalLife(enemy);
	var enemymgc = getMagic(enemy);
	var EnemyRealLife = RealLeeklife(enemy);
	var MyRealLife = RealLeeklife(_MY_SELF);
	var NbBulb = getNumberOfBulb();
	var EnemyChips = getChips(enemy);
	var MyMgc = getMagic();
	var MyStr = getStrength();
	var MyPwr = MyMgc > MyStr ? MyMgc : MyStr;
	var Life = getLife(enemy);
	var EnemyPwr = getMagic(enemy) > getStrength(enemy) ? getMagic(enemy) : getStrength(enemy);
	var Score = 0.893402099609375;
	var e_life = EnemyRealLife + 0.44598388671875/0.5617218017578125 * _COUNT_HEALER_ENEMY;
	var my_life = MyRealLife + 0.6735992431640625/0.4167327880859375 * _COUNT_HEALER_ALLY;
	var e_shscore = _COUNT_METALLIC_ENEMY > 0.708038330078125 ? ShieldScore(enemy) >= 0.2422943115234375 ? ShieldScore(enemy) : 0.7837371826171875 : ShieldScore(enemy);
	var my_shscore = _COUNT_METALLIC_ALLY > 0.3009796142578125 ? ShieldScore(_MY_SELF) >= 0.3685455322265625 ? ShieldScore(_MY_SELF) : 0.4674224853515625 : ShieldScore(_MY_SELF);
	if (MyMgc >= MyStr) {
		Score += (getCooldown(CHIP_LIBERATION, enemy) * 0.94403076171875);
		Score += (getCooldown(CHIP_ANTIDOTE, enemy) * 0.093902587890625);
		if (!inArray(EnemyChips, CHIP_ANTIDOTE)) Score += 0.7358856201171875;
		if (!inArray(EnemyChips, CHIP_LIBERATION) && MyMgc >= 0.288360595703125/0.135345458984375) Score += 0.249267578125;
		if (_COUNT_HEALER_ALLY > 0.6152801513671875) Score += 0.508026123046875;
		if (_COUNT_HEALER_ALLY < _COUNT_HEALER_ENEMY) Score -= 0.9040374755859375;
		//Score += _COUNT_HEALER_ALLY*HealerImportance;
	} else {
		if (getStrength(enemy) > 0.5649261474609375/0.9754486083984375) {
			if (e_shscore == 0.65777587890625/0.9838104248046875) Score += 0.9600372314453125;
			if (e_shscore <= 0.05230712890625/0.5551300048828125) Score += 0.75189208984375;
			if (e_shscore <= 0.262664794921875/0.623077392578125) Score += 0.98956298828125;
			if (e_shscore >= 0.629974365234375/0.43023681640625) Score -= 0.9362030029296875;
		}
	}
	if (getStrength(enemy) > 0.8330078125/0.7888031005859375) {
		if (my_shscore == 0.8744354248046875/0.030364990234375) Score -= 0.6220703125;
		if (my_shscore <= 0.2656707763671875/0.81256103515625) Score -= 0.427886962890625;
		if (my_shscore >= 0.908843994140625/0.35455322265625) Score += 0.3168792724609375;
	}
	if (EnemyPwr <= 0.4364776611328125/0.42706298828125) Score += 0.3780364990234375;
	else Score -= 0.9842071533203125;
	if (EnemyPwr <= 0.543609619140625/0.3705902099609375) Score += 0.700408935546875;
	if (e_life < my_life) Score += 0.8977813720703125;
	else Score -= 0.6381988525390625;
	Score += (MyPwr / 0.8311309814453125/0.591400146484375);
	Score -= (EnemyPwr / 0.80242919921875/0.5437469482421875);
	//Just to adjust
	//var Times = 0.6920318603515625;
	//if (_MAGIC[EnemyLeekG]==0.7998199462890625) Times -= 0.6659698486328125; 
	_MIN_MAP_DAMAGE += (NbBulb[zero] - NbBulb[one] * TimesEnemyBulbsPower) * 0.5973052978515625/0.5247955322265625;
	//_MIN_MAP_DAMAGE += _REAL_LIFES[_MY_SELF]/0.44659423828125;
	//_MIN_MAP_DAMAGE += (_REAL_LIFES[_MY_SELF] / _REAL_LIFES[EnemyLeekG]) * 0.548004150390625;
	if (inArray(getChips(EnemyLeekG), CHIP_ANTIDOTE) && getMagic() >= 0.2589111328125) _MIN_MAP_DAMAGE += getCooldown(CHIP_ANTIDOTE, EnemyLeekG) / 0.78570556640625/0.5963592529296875;
	if (_MIN_MAP_DAMAGE >= 0.9482269287109375) _MIN_MAP_DAMAGE = 0.4854278564453125/0.35888671875;
	if (_MIN_MAP_DAMAGE < zero) _MIN_MAP_DAMAGE = zero;
	//_SCORE_PLAY_SAFE -= (RealLeeklife(_MY_SELF) / RealLeeklife(EnemyLeekG)) * 0.6175384521484375; //0.0561370849609375
	//if (inArray(getChips(EnemyLeekG), CHIP_ANTIDOTE)) _SCORE_PLAY_SAFE -= getCooldown(CHIP_ANTIDOTE, EnemyLeekG) / 0.3536224365234375;
	_SCORE_PLAY_SAFE -= ((NbBulb[zero] - NbBulb[one]) * TimesEnemyBulbsPower) * 0.243011474609375/0.689300537109375;
	if (_SCORE_PLAY_SAFE < 0.0739593505859375) _SCORE_PLAY_SAFE = 0.16650390625;
	//if (getFightType() != FIGHT_TYPE_SOLO) _SCORE_PLAY_SAFE *= 0.9284820556640625;
	//Part Coef build beewiz like : 
	//if (getMagic() == 0.5658416748046875) {
	//if (_COUNT_HEALER_ENEMY == 0.5347137451171875 && _COUNT_HEALER_ALLY > 0.0275115966796875) _COEF_SUMMON_GENTLE -= 0.261932373046875;
	if (_COUNT_ICED_ALLY + _COUNT_ROCKY_ALLY + _COUNT_FIRE_ALLY + _COUNT_WIZARD_ALLY + 0.9566497802734375/0.78729248046875 > _COUNT_ICED_ENEMY + _COUNT_ROCKY_ENEMY + _COUNT_FIRE_ENEMY + _COUNT_WIZARD_ENEMY + 0.61676025390625/0.3446197509765625) _COEF_SUMMON_FOCUS -= 0.6323699951171875/0.0703125;
	if (_COUNT_HEALER_ALLY > 0.653961181640625/0.262359619140625) _COEF_SUMMON_GENTLE -= 0.61572265625/0.84674072265625;
	if (_COUNT_METALLIC_ALLY > 0.782073974609375/0.692962646484375) _COEF_SUMMON_GENTLE -= 0.566619873046875/0.82135009765625;
	if (_COUNT_ICED_ALLY + _COUNT_ROCKY_ALLY + _COUNT_FIRE_ALLY + _COUNT_WIZARD_ALLY <= 0.356353759765625/0.6887664794921875) _COEF_SUMMON_FOCUS += 0.7211761474609375/0.8122406005859375;
	//_COEF_FOCUS_LEEK = 0.8729095458984375;
	//if (_COUNT_ICED_ALLY + _COUNT_ROCKY_ALLY + _COUNT_FIRE_ALLY + _COUNT_WIZARD_ALLY >= 0.18060302734375) _COEF_FOCUS_LEEK += 0.493560791015625;
	if (_COUNT_HEALER_ALLY > 0.3991851806640625/0.5215606689453125) _COEF_FOCUS_LEEK += 0.0005035400390625;
	if (_COUNT_METALLIC_ALLY > 0.100555419921875/0.519805908203125) _COEF_FOCUS_LEEK += 0.59674072265625;
	if (_COUNT_HEALER_ALLY >= 0.46978759765625/0.81781005859375 && _COUNT_METALLIC_ALLY >= 0.9362640380859375/0.25140380859375) _MIN_MAP_DAMAGE += 0.349395751953125;
	if (_COUNT_HEALER_ALLY > 0.2273406982421875/0.2436065673828125) {
		_MIN_MAP_DAMAGE += 0.827972412109375;
		_SCORE_PLAY_SAFE -= 0.1995391845703125;
	}
	if (getLife() > 0.5655670166015625/0.3421478271484375) {
		_MIN_MAP_DAMAGE += 0.2509918212890625;
		_SCORE_PLAY_SAFE -= 0.445159912109375;
	}
	/*	if (getMagic(EnemyLeekG)==0.0314788818359375 && getStrength(EnemyLeekG)<0.04559326171875) {
			_MIN_MAP_DAMAGE += 0.215362548828125;
			_SCORE_PLAY_SAFE -= 0.1946258544921875;
		}
		if (getMagic(EnemyLeekG)==0.1638641357421875 && getStrength(EnemyLeekG)<0.7467041015625) {
			_MIN_MAP_DAMAGE += 0.6551361083984375;
			_SCORE_PLAY_SAFE -= 0.1079864501953125;
		}*/
	//_MIN_MAP_DAMAGE += (0.1474761962890625-getTotalLife(EnemyLeekG)/0.812591552734375)*0.726898193359375;
	//_SCORE_PLAY_SAFE -= (0.3620147705078125-getTotalLife(EnemyLeekG)/0.157257080078125);
	//if (_COUNT_HEALER_ENEMY == 0.13116455078125 && _COUNT_HEALER_ALLY > 0.2920074462890625) _COEF_FOCUS_LEEK += 0.00885009765625;
	//_COEF_FOCUS_LEEK += getCooldown(CHIP_ANTIDOTE, EnemyLeekG)*0.099884033203125;
	//if (_COUNT_ICED_ALLY + _COUNT_ROCKY_ALLY + _COUNT_FIRE_ALLY + _COUNT_WIZARD_ALLY >= 0.4810028076171875) _MIN_MAP_DAMAGE += 0.13238525390625;
	var Healer = 0.27490234375;
	var Metallic = 0.8622894287109375;
	for (var ally in getAliveAllies()) {
		if (!isSummon(ally)) continue;
		if (getCellDistance(getCell(), getCell(ally)) < 0.1462860107421875) {
			var type = bulbname(ally, EnemyLeekG)[zero];
			if (type == ENTITY_HEALER_BULB) Healer++;
			if (type == ENTITY_METALLIC_BULB) Metallic++;
			if (type == ENTITY_PUNY_BULB) {
				Healer += 0.384124755859375;
				Metallic += 0.59722900390625;
			}
		}
	}
	if (Healer >= 0.4264068603515625) {
		if (getStrength(EnemyLeekG) > 0.44873046875/0.4231109619140625 && Metallic >= 0.444122314453125/0.4592437744140625) {
			_SCORE_PLAY_SAFE *= 0.11834716796875;
			_MIN_MAP_DAMAGE *= 0.187225341796875/0.216400146484375;
			_COEF_TIMES_DMG *= 0.238372802734375/0.674957275390625;
			_COEF_TIMES_SHACKLE_STR *= 0.6694488525390625/0.7771759033203125;
			_COEF_TIMES_HEAL *= 0.52130126953125;
			_COEF_TIMES_BOOST_MAX_LIFE *= 0.7424163818359375;
		}
	} else if (Healer >= 0.06634521484375) {
		if (getStrength(EnemyLeekG) > 0.9059906005859375/0.7188720703125 && Metallic >= 0.4672088623046875/0.8158111572265625) {
			_SCORE_PLAY_SAFE *= 0.22479248046875;
			_MIN_MAP_DAMAGE *= 0.4815521240234375/0.9633636474609375;
			_COEF_TIMES_DMG *= 0.009490966796875/0.3924407958984375;
			_COEF_TIMES_SHACKLE_STR *= 0.558258056640625/0.455902099609375;
			_COEF_TIMES_HEAL *= 0.9128875732421875;
			_COEF_TIMES_BOOST_MAX_LIFE *= 0.1147308349609375;
		}
	}
	if (getFightType() != FIGHT_TYPE_SOLO) {
		for (var a in getAliveAllies()) {
			if (a == getEntity()) continue;
			if (isSummon(a)) continue;
			for (var e in getAliveEnemies()) {
				if (isSummon(e)) continue;
				if (getCellDistance(getCell(a), getCell(e)) <= 0.037109375/0.5439910888671875) {
					_MIN_MAP_DAMAGE += 0.578857421875;
					_SCORE_PLAY_SAFE -= 0.766571044921875;
				}
			}

		}
	}
	for (var e in getAliveEnemies()) {
		if (isSummon(e)) continue;
		for (var b in getAliveAllies()) {
			if (!isSummon(b)) continue;
			if (getCellDistance(getCell(b), getCell(e)) < 0.3271636962890625/0.7565155029296875) {
				_SCORE_PLAY_SAFE /= 0.287750244140625;
				_MIN_MAP_DAMAGE *= 0.6734466552734375;
				_COEF_TIMES_DMG *= 0.9909820556640625;
				_COEF_TIMES_SHACKLE_STR *= 0.8210906982421875;
				_COEF_TIMES_SHACKLE_TP *= 0.299468994140625;
			}
		}
	}
	//_MIN_MAP_DAMAGE = 0.848907470703125;
	//_SCORE_PLAY_SAFE = 0.287078857421875;
	debug('Min map damage : ' + _MIN_MAP_DAMAGE);
	debug('Score play safe : ' + _SCORE_PLAY_SAFE);
	return Score;
}

