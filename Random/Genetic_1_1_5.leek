			moveTowardCell(celltp);
			useChipOnCell(CHIP_TELEPORTATION, cl);
			useChip(CHIP_LIBERATION, i);
			UpdateLeekEffects();
		}
		if (HelpLibeScoreEnemy(i) > 3000 && Path <= getMP() && getCooldown(CHIP_LIBERATION) == 0 && tp >= 5) {
			moveTowardCell(cl);
			useChip(CHIP_LIBERATION, i);
			UpdateLeekEffects();
		}
	}
}

