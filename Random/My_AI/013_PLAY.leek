//debug(FromItemsToCombo(getTP(), getMP(), GetItems(_MY_SELF), getCell()));
//debug(getChipName(67));
function Play(@enemys, @weapon, @cell, @mp, @enemyweapon, @tpa, @healAlly) {
	OneShootTeam();
	var tp = getTP();
	var tabSummon = [];
	var WhilePlay = 0;
	while (true) {
		UpdateLeekEffects();
		if (ArrayItemsCellsTo[0][0] != _CELL[_MY_SELF]) {
			debug('Array Items Cells To Succefully Updated');
			UpdateActions(_MY_SELF, getMP(), getCell());
		}
		var inv = GetItems(_MY_SELF);
		OS();
		if (isDead(EnemyLeekG)) EnemyLeekG = EnemyLeek();
		if (getOperations() > _PLAY_OP_LIMIT) {
			debug("Break : " + (getOperations() / 1000) + " k opés play");
			break;
		}
		WhilePlay++;
		var bi = getBestItemToUse(inv, getMP(), _MY_SELF, tp);
		var TabCellzItem = FindItemsCellzInArrayItemsCellsTo(bi[0]);
		var Target = TabCellzItem[2];
		var BestShootingCell = TabCellzItem[3];
		var CellToShoot = TabCellzItem[4];
		var CellToUseLibe = getCellToUseChip(CHIP_LIBERATION, Target);
		if (getCooldown(CHIP_LIBERATION) == 0 && inArray(getChips(), CHIP_LIBERATION) && LibeScore(Target) > 4000 && isEnemy(Target) && tp >= 5 + _ITEM_COST[bi[0]] && getPathLength(getCell(), CellToUseLibe) + getPathLength(CellToUseLibe, CellToShoot) <= getMP()) {
			moveTowardCell(CellToUseLibe);
			useChip(CHIP_LIBERATION, Target);
			tp -= 5;
		}
		if (bi[0] == null || !inArray(inv, bi[0]) || tp - _ITEM_COST[bi[0]] <= 0) {
			debug("BREAK Ended play");
			break;
		}

		debug("Using : " + getItemName(bi[0]));
		if (isPositiv(bi[0]) != null || bi[0] == CHIP_INVERSION) {
			if (BestShootingCell != null) {
				mark(BestShootingCell, COLOR_RED);
				moveTowardCell(CellToShoot);
			}
			if (bi[0] == CHIP_DEVIL_STRIKE && getCellDistance(getCell(), _CELL[Target]) < 3) {
				useChip(bi[0], _MY_SELF);
				tp -= _ITEM_COST[bi[0]];
			}
			if (isChip(bi[0]) && getChipCooldown(bi[0]) == 0 && bi[0] != null || isWeapon(bi[0]) && bi[0] != null) {
				while (_ITEM_COST[bi[0]] <= tp && canUseItem(bi[0], BestShootingCell) && count(getItemTargets(bi[0], BestShootingCell)) > 0) {
					useItem(bi[0], BestShootingCell, getWeapon());
					tp -= _ITEM_COST[bi[0]];
				}
			}
			if (count(getItemTargets(bi[0], BestShootingCell)) > 0) {
				useItem(bi[0], BestShootingCell, getWeapon());
				tp -= _ITEM_COST[bi[0]];
			} else {
				UpdateActions(_MY_SELF, getMP(), getCell());
				UpdateLeekEffects();
			}
		}
		if (isPositiv(bi[0]) == null && bi[0] != CHIP_TELEPORTATION && bi[0] != CHIP_ANTIDOTE && bi[0] != CHIP_INVERSION && bi[0] != CHIP_LIBERATION && bi[0] != CHIP_RESURRECTION) {
			//debug("Pushing to tapsummon");
			tp -= _ITEM_COST[bi[0]];
			push(tabSummon, bi[0]);
		}

		if (bi[0] == CHIP_RESURRECTION) {
			resurrect(DeadAlly()[0], getCellToUseChip(CHIP_FIRE_BULB, _MY_SELF));
		}
		//debugC("Opés Play  : " + WhilePlay + " : " + getOperations() / 1000 + " k ", COLOR_BLUE);
	}
	//debugC('While Times :' + WhilePlay, COLOR_GREEN);
	debugC("Opés Play No Hidden Cellz : " + getOperations() / 1000 + " k ", COLOR_BLUE);
	var BestHideCellz = getBestCellToHide(_CELL[_MY_SELF], getMP(), EnemyLeekG);
	//debugW("BCTH : " + BestHideCellz);
	mark(BestHideCellz, COLOR_GREEN);
	moveTowardCell(BestHideCellz);
	for (var i in tabSummon) {
		summon(i, getCellToUseChip(i, getLeek()), AiForBulbs);
	}
	//FailSafe();
	if (getWeapon() == null && getTP() >= 1 && inArray(getWeapons(), WEAPON_M_LASER)) {
		setWeapon(WEAPON_M_LASER);
	}
}


