include("include");

/////////////////////////////////////////////////////////////////////////////////////////////All updates
/////////////////////////////////////////////////////////////////////////////////////////////

//UpdateLeekEffects();
UpdateActions(_MY_SELF, getMP() , getCell());
UpdateItemsToHide();

///////////////////////////////////////////////////////////////////////////////////////////////FailSafe
/////////////////////////////////////////////////////////////////////////////////////////////
function FailSafe() {
	var SummonArray = [CHIP_METALLIC_BULB, CHIP_HEALER_BULB, CHIP_LIGHTNING_BULB, CHIP_FIRE_BULB, CHIP_ICED_BULB, CHIP_ROCKY_BULB, CHIP_PUNY_BULB];
	if (getStrength(EnemyLeekG) < 200) {
		removeElement(SummonArray, CHIP_METALLIC_BULB);
		push(SummonArray, CHIP_METALLIC_BULB);
	}
	var HealArray = [CHIP_ARMORING, CHIP_REMISSION, CHIP_VACCINE, CHIP_CURE, CHIP_BANDAGE];
	if (getLife() == getTotalLife()) {
		removeElement(HealArray, CHIP_REMISSION);
		removeElement(HealArray, CHIP_CURE);
		removeElement(HealArray, CHIP_BANDAGE);
	}
	var OtherArray = [CHIP_RAGE, CHIP_MOTIVATION, CHIP_FORTRESS, CHIP_RAMPART, CHIP_ARMOR, CHIP_SHIELD, CHIP_WALL, CHIP_HELMET];

	for (var i in SummonArray) {
		if (inArray(GetItems(_MY_SELF), i)) summon(i, getCellToUseChip(i, _MY_SELF), AiForBulbs);
	}

	if (getStrength(EnemyLeekG) < 200) {
		for (var i in HealArray) {
			if (inArray(GetItems(_MY_SELF), i)) useChip(i, _MY_SELF);
		}
	}
	for (var i in OtherArray) {
		if (inArray(GetItems(_MY_SELF), i)) useChip(i, _MY_SELF);
	}

	for (var i in HealArray) {
		if (inArray(GetItems(_MY_SELF), i)) useChip(i, _MY_SELF);
	}
}

/////////////////////////////////////////////////////////////////////////////////////////////GESTION ANTIDOTE / REGEN
/////////////////////////////////////////////////////////////////////////////////////////////

if (DmgForTurn(_MY_SELF) > 350 && getCooldown(CHIP_ANTIDOTE) == 0 && inArray(getChips(), CHIP_ANTIDOTE)) {
	useChip(CHIP_ANTIDOTE, _MY_SELF);
}

if (getLife() < getTotalLife() - (200 * (1 + getWisdom() / 100)) && getCooldown(CHIP_REGENERATION) == 0 && inArray(getChips(), CHIP_REGENERATION)) {
	useChip(CHIP_REGENERATION, _MY_SELF);
}

