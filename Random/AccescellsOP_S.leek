function GetTableauDesCells() {
	var tab = [] ;
	for (var i = 0 ; i <= 613 ; i++) {
		push(tab, i);
	}
	return tab ;	
}


debug("Tableau Cells" + getOperations());

function GetWalkableCells(cell , MP) {
	var tab = [] ;
	for (var i in GetTableauDesCells()) {
		if (getPathLength(cell, i)<=
		MP
		 && getPathLength(cell, i)!=null && !isObstacle(i)) {
			push(tab, i);
		}
	}
   return tab ;
}


moveTowardCell(320);
mark(GetWalkableCells(getCell(), getMP()));
debug("Walkable Cells" + getOperations());

function GetNumberOfEnemyInAZone(Cell,RayonPath) {
	var tab = 0 ;
	for (var i in GetWalkableCells(Cell, RayonPath)) {
		if (isLeek(i) && isEnemy(getLeekOnCell(i))) {
			tab ++ ;
		}
	}	
}


















