var enemy = getNearestEnemy();

summon(CHIP_PUNY_BULB, getCellToUseChip(CHIP_PUNY_BULB, getLeek()), bulbai);

if (getWeapon()!=WEAPON_GRENADE_LAUNCHER) {
	setWeapon(WEAPON_GRENADE_LAUNCHER);
}
moveTowardCell(getCellToUseWeapon(WEAPON_GRENADE_LAUNCHER, enemy));
useWeapon(enemy);
useWeapon(enemy);

useChip(CHIP_ROCKFALL, enemy);
useChip(CHIP_FLAME, enemy);
useChip(CHIP_VACCINE, getLeek());
useChip(CHIP_CURE, getLeek());

function bulbai() {
var summoner = getSummoner();
moveTowardCell(getCellToUseChip(CHIP_PROTEIN, summoner));
useChip(CHIP_PROTEIN, summoner);
useChip(CHIP_HELMET, summoner);
if (getLife(summoner)>=getTotalLife(summoner)) {
	useChip(CHIP_BANDAGE, summoner);
}	
moveAwayFrom(getNearestAlly());	
useChip(CHIP_PROTEIN, getNearestAlly());
useChip(CHIP_HELMET, getNearestAlly());
if (getLife(getNearestAlly())>=getTotalLife(getNearestAlly())) {
	useChip(CHIP_BANDAGE, getNearestAlly());
}
useChip(CHIP_PEBBLE, getNearestEnemy());	
}
moveAwayFrom(enemy);