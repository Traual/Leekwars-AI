function Pipotron() {
var Number = randInt(0, 6);
   var tabPersonne = [
   "Je" ,
   "Tu" ,
   "Il" ,
   "Nous" ,
   "Vous" ,
   "Ils"
   ];
	var Radical = [
	"mang" ,
	'chant'
	"siest"
	"cabr" ,
	"gout" ,
	"tu" ,
	"croqu" ,
	"caval" ,
	"decoup" ,
	//"telephon" ,
	"flatul" ,
	//"ecart"
	];
	
	var Mots1erePersonneSing = [] ;
	for (var i in Radical) {
		push(Mots1erePersonneSing, i+"e");
	}
	
	
	var Mots2emePersonneSing = [] ;
	for (var i in Radical) {
		push(Mots2emePersonneSing, i+"es");
	}
	
	var Mots3emePersonneSing = [] ;
	for (var i in Radical) {
		push(Mots3emePersonneSing, i+"e");
	}
	
	var Mots1erePersonnePlur = [] ;
	for (var i in Radical) {
		push(Mots1erePersonnePlur, i+"ons");
	}
	
	var Mots2emePersonnePlur = [] ;
	for (var i in Radical) {
		push(Mots2emePersonnePlur, i+"ez");
	}
	
	var Mots3emePersonnePlur = [] ;
	for (var i in Radical) {
		push(Mots3emePersonnePlur, i+"ent");
	}
		
	var tabverbeConj = [] ;
	pushAll(tabverbeConj, [Mots1erePersonneSing , Mots2emePersonneSing , Mots3emePersonneSing , Mots1erePersonnePlur , Mots2emePersonnePlur , Mots3emePersonnePlur]);
		
		
	var Apres = [
	"une moto" ,
	"Pumpkings are better" ,
	"un troll" ,
	"des toilettes" ,
	"un ballon de volley ball" ,
	"des ordinateur" ,
	"un code" ,
	"un pipotron" ,
	"youtube" ,
	"un poireau" ,
	"une patate" ,
	"une pasteque"
	] ;
		
	var fin = [
	"qui pues !" ,
	"qui etait mauvaise ..." ,
	"qui etait bonne !" ,
	"qui sentait bon !",
	"que j'ai aimé !",
	"que j'ai regardé .",
	"ou pump a déféqué dessus",
	"ou un robot bleu s'est assis dessus"
	] ;
			  
    say(tabPersonne[Number] + " " + tabverbeConj[Number][randInt(0, count(Radical))] + " " + Apres[randInt(0, count(Apres))] +" "+ fin[randInt(0, count(fin))]);		  
}

Pipotron() ;


debugW(getOperations());


