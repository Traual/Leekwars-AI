global leek2 = nearestrealenemy();

function canbeos() {

	if (((getLife()<=100*getStrength(leek2)+100)*getTP(leek2)/8)*(getRelativeShield()/100)-getAbsoluteShield()) {
		return true  ;
	}
else

return false   ;
}

function canBeOS(baseDamage, // item's damage
        iteration,           // number of time the item is used
        strength,            // enemy's strength
        life,                // ally health
        absoluteShield,      // ally absolute shield
        relativeShield) {    // ally relative shield
    var damageAmplifier = 1 + strength / 100;
    var damageDealt = (baseDamage * damageAmplifier) * (1 - relativeShield / 100) - absoluteShield;
    return life <= damageDealt * iteration;
}

function PeutAllerSeCacherM() {
    var cellToUseWeapon = getCellToUseWeapon(WEAPON_M_LASER, leek2);
    
	return getPathLength(getCell(), cellToUseWeapon )+getPathLength(cellToUseWeapon , tableaucellscacher())< getMP();

}

function PeutAllerSeCacherLi() {
    var cellToUseChip = getCellToUseChip(CHIP_LIBERATION, leek2);
    
	return getPathLength(getCell(), cellToUseChip )+getPathLength(cellToUseChip , tableaucellscacher())<= getMP();

}

