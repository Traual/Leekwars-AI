include("Cache Cache");

global leek2 = nearestrealenemy();
global planque = tableaucellscacher();
var enemy = getNearestEnemy();
var mycell = getCell();
var enemycell = getCell(leek2);
var tour = getTurn();
var dist = getCellDistance(mycell, enemycell);

if (getTurn()==1) {
say(lama());
}
//Special

if (getWeapon()!=WEAPON_GAZOR) {setWeapon(WEAPON_GAZOR);
	
}

//Chips Prioritaires

if (getLife() < getTotalLife() - 600 and getCooldown(CHIP_REGENERATION) == 0) {
	useChip(CHIP_REGENERATION, getLeek());
	useChip(CHIP_VACCINE, getLeek());
	if (getCooldown(CHIP_REGENERATION) > 0) {
		moveTowardCell(tableaucellscacher());
		
	}

}

poisoncounter();

//Gun

moveTowardCell(getCellToUseWeapon(WEAPON_GAZOR , leek2));

if (canUseWeapon(WEAPON_FLAME_THROWER, leek2 && dist <=3)) {
setWeapon(WEAPON_FLAME_THROWER);
useWeapon(leek2);
useWeapon(leek2);
setWeapon(WEAPON_GAZOR);
}	

if (canUseWeapon(WEAPON_FLAME_THROWER, leek2) && dist>=4) {
useWeapon(leek2);
useWeapon(leek2);
}

if (dist>3) {
	useWeaponOnCell(
useCHiporWeaponarea(WEAPON_GAZOR, 3, leek2));
useWeaponOnCell(
useCHiporWeaponarea(WEAPON_GAZOR, 3, leek2));
}



//Bulbes

summon(CHIP_HEALER_BULB, getCellToUseChip(CHIP_HEALER_BULB, getLeek()), bulbeSoigneur());
summon(CHIP_ICED_BULB, getCellToUseChip(CHIP_ICED_BULB, getLeek()), bulbAI());
summon(CHIP_ROCKY_BULB, getCellToUseChip(CHIP_ROCKY_BULB, getLeek()), bulbeRocheux());
summon(CHIP_PUNY_BULB, getCellToUseChip(CHIP_PUNY_BULB, getLeek()), bulbechetif());

//Mechants Chips

if (getTP()<=7) {
useChip(CHIP_VENOM, leek2);
useChip(CHIP_TRANQUILIZER, leek2);	
}

//Gentil Chips

if (getLife()<getTotalLife()) {
useChip(CHIP_VACCINE, getLeek());
}

if (getLife()<getTotalLife()) {
useChip(CHIP_CURE, getLeek());
}

if (lineOfSight(mycell, enemycell) && getTP()<=3) {
moveTowardCell(planque);	
}

if (getTP()<=3 && dist<7) {
moveTowardCell(planque);
}







