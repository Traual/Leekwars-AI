include("Cache cache");
include("Cache cache");
global leek2=nearestrealenemy();
var planque=tableaucellscacher();
var MaCell=getCell();
var me=getLeek();
var disto=getPath(leek2, MaCell);
var enemy=leek2;
var enemycell=getCell(enemy);

////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////
//CHIPS PRIO
////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////

if (getLife()<600) {
useChip(CHIP_REGENERATION, me);
}

if (getTP()==getTotalTP() && getMP()>disto) {
moveToward(enemy);	
}

if (disto<15 && getTP() == getTotalTP() && getStrength()>=700) {
useChipOnCell(CHIP_TELEPORTATION, enemycell);
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//ARME 
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

if (getWeapon()!=WEAPON_AXE && getMP()>disto) {
setWeapon(WEAPON_AXE);	
}
if (getWeapon()!=WEAPON_AXE && getWeapon()!=WEAPON_LASER && canUseWeapon(WEAPON_LASER, enemy)) {
setWeapon(WEAPON_LASER);
}
if (getWeapon()!=WEAPON_AXE && getWeapon()!=WEAPON_LASER && getWeapon()!=WEAPON_GRENADE_LAUNCHER && canUseWeapon(WEAPON_GRENADE_LAUNCHER, enemy)) {
setWeapon(WEAPON_GRENADE_LAUNCHER);	
}


useWeapon(enemy);	
useWeapon(enemy);	


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//Chips Science
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

if (getStrength()<700 && disto>9) {

if (getAgility()<400) {
useChip(CHIP_REFLEXES, getLeek());
useChip(CHIP_STRETCHING, getLeek());
}

if (getTotalTP()>=15){
useChip(CHIP_RAGE, getLeek());
useChip(CHIP_MOTIVATION, getLeek());
}

if (getMP()<10) {
useChip(CHIP_LEATHER_BOOTS, getLeek());
useChip(CHIP_SEVEN_LEAGUE_BOOTS, getLeek());

useChip(CHIP_DOPING, getLeek());
useChip(CHIP_PROTEIN, getLeek());
}}

if (getStrength()<400) {
moveAwayFrom(enemy);
}



































































































































































