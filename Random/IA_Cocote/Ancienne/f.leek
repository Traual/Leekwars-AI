function bulbeMetalique() {
	var summoner = getSummoner();
	
moveTowardCell(getCellToUseChip(CHIP_SEVEN_LEAGUE_BOOTS, summoner));


useChip(CHIP_ARMOR, summoner);



useChip(CHIP_SHIELD, summoner);	



useChip(CHIP_SEVEN_LEAGUE_BOOTS, summoner);	



useChip(CHIP_WALL, summoner);	


useChip(CHIP_ARMOR, getNearestAlly());
useChip(CHIP_WALL, getNearestAlly());
useChip(CHIP_ARMOR, getNearestAlly());
useChip(CHIP_SEVEN_LEAGUE_BOOTS, getNearestAlly());
moveAwayFrom(summoner);

}

