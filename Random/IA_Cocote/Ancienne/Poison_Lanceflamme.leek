include("Fonction_Utiles");
global leek2 = nearestrealenemy();
global poto = nearestrealally();
var disto = getPathLength(getCell(), getCell(leek2));
var distBul = getPathLength(getCell(), getCell(getNearestEnemy()));
var dist = getCellDistance(getCell(), getCell(leek2));

if (getLife()<700 && dist<=10 && getMP()<=1 && getCooldown(CHIP_TELEPORTATION)==0 && getTP()>=8) {
	useChipOnCell(CHIP_TELEPORTATION, tableaucellscacher());
}

if (getLife(leek2)<=350 && getCooldown(CHIP_TELEPORTATION)==0) {
useChipOnCell(CHIP_TELEPORTATION, getCellToUseWeapon(WEAPON_FLAME_THROWER, leek2));
if (getWeapon()!=WEAPON_FLAME_THROWER) {
setWeapon(WEAPON_FLAME_THROWER);
}
useWeapon(leek2);
useWeapon(leek2);
useWeapon(leek2);
}

if (getTP()>=6 && getCooldown(CHIP_PLAGUE)==0) {

moveTowardCell(getCellToUseChip(CHIP_PLAGUE, leek2, ));

while (dist<=4 && getMP()>1) {
moveAwayFrom(leek2 , 1);	
}

useChip(CHIP_PLAGUE, leek2);
}

if (getWeapon()!=WEAPON_GAZOR) {
setWeapon(WEAPON_GAZOR);	
}

















































































































































































































































































































































































































