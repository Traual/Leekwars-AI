include("Cache cache");
global leek2=nearestrealenemy();
global me = getLeek();

function getAllyNamed(name){
  	var allies = getAliveAllies();
  	var marzy;
	
  	for(var ally in allies){
      	if(getName(ally) == "marzyhelmond"){
          	marzy ="marzyhelmond";
        }
    }
}
function getIdOfMarzy() {
  return getLeekID("marzyhelmond") ; 
}
var marzy=getIdOfMarzy();

function getAllyNamed1(name){
  	var allies = getAliveAllies();
  	var Traual;
	
  	for(var ally in allies){
      	if(getName(ally) == "Traual"){
          	Traual ="Traual";
        }
    }
}
function getIdOfTraual() {
  return getLeekID("Traual") ; 
}
var Traual=getIdOfTraual();

if (getPathLength(getCell(), getCell(leek2))<=9) {
moveAwayFrom(leek2);	
}

  /////////////////////////THORN////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////:
if (getCooldown(CHIP_THORN)==null && canUseChip(CHIP_THORN, marzy)) {
useChip(CHIP_THORN, marzy);	
}else

if (getCooldown(CHIP_THORN)==null && !canUseChip(CHIP_THORN, marzy) and canUseChip(CHIP_THORN, Traual)) {
useChip(CHIP_THORN, Traual);	
}else if ((getCooldown(CHIP_THORN)==null && !canUseChip(CHIP_THORN, marzy) and !canUseChip(CHIP_THORN, Traual) && getPathLength(getCell(), getCellToUseChip(CHIP_THORN, marzy))<=getMP())) {
	moveTowardCell(getCellsToUseChip(CHIP_THORN, marzy));
	useChip(CHIP_THORN, marzy);
	
}
if (getCooldown(CHIP_THORN)==null && getStrength(getNearestAlly())>=200 ) {
useChip(CHIP_THORN, getNearestAlly());}
