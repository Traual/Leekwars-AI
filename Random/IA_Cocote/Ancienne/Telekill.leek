include("Fonction_Utiles.leek");
global leek2 = nearestrealenemy();
var dist = getCellDistance(getCell(), getCell(leek2));
var disto = getPathLength(getCell(), getCell(leek2));

if (getWeapon()!=WEAPON_AXE) {
setWeapon(WEAPON_AXE);	
}

if (getPathLength(getCell(), getCellsToUseWeapon(leek2))>=getMP()) {
moveTowardCell(tableaucellscacher());	
}

if (getCooldown(CHIP_RAGE && canUseWeapon(leek2)==false)==0) {
useChip(CHIP_RAGE, getLeek());	
}

if (getCooldown(CHIP_MOTIVATION && canUseWeapon(leek2)==false)==0) {
useChip(CHIP_MOTIVATION, getLeek());
}

if (getCooldown(CHIP_DOPING)==0 && canUseWeapon(leek2)==false) {
useChip(CHIP_DOPING, getLeek());	
}

if (getCooldown(CHIP_PROTEIN)==0 && canUseWeapon(leek2)==false) {
useChip(CHIP_PROTEIN, getLeek());
}

if (getStrength()>=700) {
if (getCooldown(CHIP_TELEPORTATION)==0 && getTP()>=14) {
while (dist>18) {
moveToward(leek2,1);	
}
useChipOnCell(CHIP_TELEPORTATION, getCellToUseWeapon(leek2));	
}
useWeapon(leek2);
useWeapon(leek2);
useWeapon(leek2);
useWeapon(leek2);
useWeapon(leek2);
useWeapon(leek2);
}

useChip(CHIP_SEVEN_LEAGUE_BOOTS, getLeek());
useChip(CHIP_LEATHER_BOOTS, getLeek());
















































































