include("Cache cache");
global leek2=nearestrealenemy();
global me = getLeek();
global antipoison = poisoncounter();
var macell = getCell();
var enemycell = getCell(leek2);
var dist = getCellDistance(macell, enemycell);
var distally = getCellDistance(getCell(getNearestAlly()), enemycell);
var disto = getPathLength(getCell(), enemycell);



poisoncounter();

//////////////////////////////////////////////////////////////////////////////////////
//Regen
//////////////////////////////////////////////////////////////////////////////////////

if (getLife()<=500) {
useChip(CHIP_REGENERATION, me);
useChip(CHIP_VACCINE, me);
}

//////////////////////////////////////////////////////////////////////////////////////
//Weapon
//////////////////////////////////////////////////////////////////////////////////////
moveTowardCell(getCellToUseWeapon(WEAPON_GAZOR, leek2));

if (getWeapon()!=WEAPON_GAZOR) {
setWeapon(WEAPON_GAZOR);	
}

if (disto<=4) {
setWeapon(WEAPON_FLAME_THROWER);
useWeapon(leek2);
useWeapon(leek2);
setWeapon(WEAPON_GAZOR);
moveAwayFrom(leek2);
}

if (disto>=5) {
useWeaponOnCell(useCHiporWeaponarea(WEAPON_GAZOR, 3, leek2));
useWeaponOnCell(useCHiporWeaponarea(WEAPON_GAZOR, 3 , leek2));
}

if (disto<=5) {
moveAwayFrom(leek2);
useWeaponOnCell(useCHiporWeaponarea(WEAPON_GAZOR, 3, leek2));
useWeaponOnCell(useCHiporWeaponarea(WEAPON_GAZOR, 3, leek2));
}

//////////////////////////////////////////////////////////////////////////////////////
//Mechants chips plague
//////////////////////////////////////////////////////////////////////////////////////

if (dist>=4 && getCooldown(CHIP_PLAGUE)==null && distally>=4) {
useChip(CHIP_PLAGUE, leek2);	
}

if (dist>=5 && getCooldown(CHIP_PLAGUE)==null && distally>=5) {
useChipOnCell(CHIP_PLAGUE, useCHiporWeaponarea(CHIP_PLAGUE, 1, leek2));	
}

if (dist>=6 && getCooldown(CHIP_PLAGUE)==null && distally>=6) {
useChipOnCell(CHIP_PLAGUE, useCHiporWeaponarea(CHIP_PLAGUE, 2, leek2));	
}

if (dist>=7 && getCooldown(CHIP_PLAGUE)==null && distally>=7) {
useChipOnCell(CHIP_PLAGUE, useCHiporWeaponarea(CHIP_PLAGUE, 3, leek2));	
}

//////////////////////////////////////////////////////////////////////////////////////
//mechant chip toxine
//////////////////////////////////////////////////////////////////////////////////////

if (dist>=2 && distally>=2) {
useChip(CHIP_TOXIN, leek2);	
}

if (dist>=3 && distally>=3) {
useChipOnCell(CHIP_TOXIN, useCHiporWeaponarea(CHIP_TOXIN, 1, leek2));	
}


summon(CHIP_HEALER_BULB, getCellToUseChip(CHIP_HEALER_BULB, getLeek()), bulbeSoigneur());
//////////////////////////////////////////////////////////////////////////////////////
//mechant chip Venom
//////////////////////////////////////////////////////////////////////////////////////

useChip(CHIP_VENOM, leek2);

//////////////////////////////////////////////////////////////////////////////////////
//mechant chip fracture
//////////////////////////////////////////////////////////////////////////////////////

useChip(CHIP_FRACTURE, leek2);


//////////////////////////////////////////////////////////////////////////////////////
//mechant chip Retirage de PT/PM
//////////////////////////////////////////////////////////////////////////////////////

useChip(CHIP_SLOW_DOWN, leek2);
useChip(CHIP_SLOW_DOWN, leek2);
useChip(CHIP_SLOW_DOWN, leek2);
useChip(CHIP_SLOW_DOWN, leek2);
useChip(CHIP_SLOW_DOWN, leek2);
useChip(CHIP_TRANQUILIZER, leek2);
useChip(CHIP_TRANQUILIZER, leek2);
useChip(CHIP_TRANQUILIZER, leek2);
useChip(CHIP_TRANQUILIZER, leek2);
useChip(CHIP_TRANQUILIZER, leek2);

//////////////////////////////////////////////////////////////////////////////////////
//Cache cache
//////////////////////////////////////////////////////////////////////////////////////

if (getTP()<14) {
moveTowardCell(tableaucellscacher());	
}






























































































































