var enemy = getNearestEnemy();
var me = getLeek();
var poto = getNearestAlly()!=CHIP_PUNY_BULB;	
var traual; 	

for(var i in getAliveAllies()) {if (getName(i)==traual);}

if (isOnSameLine(getLeek(), poto)) {
moveAwayFrom(poto);}
moveToward(traual);


moveToward(poto);
		
if (getLife(poto)<300) {useChip(CHIP_CURE, poto);
useChip(CHIP_BANDAGE, poto);}
	
useChip(CHIP_SHIELD, poto);
useChip(CHIP_WALL, poto);
useChip(CHIP_HELMET, poto);	
		
useChip(CHIP_STEROID, poto);		
useChip(CHIP_PROTEIN, poto);

if (getWeapon()!=WEAPON_SHOTGUN) {
setWeapon(WEAPON_SHOTGUN);	
}
		
useWeapon(enemy);		
useWeapon(enemy);
useWeapon(enemy);
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		