include("Cache cache");
global leek2 = nearestrealenemy();
var me = getLeek();
var dist = getCellDistance(getCell(), getCell(leek2));
var disto = getPathLength(getCell(), getCell(leek2));

poisoncounter();

if (getLife()<=600) {
	useChipOnCell(CHIP_TELEPORTATION, tableaucellscacher());
}

if (BulbeAFerocier() == true) {
moveTowardCell(getCellToUseChip(CHIP_FEROCITY, bulbeABoost()));
	useChip(CHIP_FEROCITY, bulbeABoost());
}

if (LeekADoper() == true) {
moveTowardCell(getCellToUseChip(CHIP_DOPING, LeekABoost()));
	useChip(CHIP_DOPING, LeekABoost());
}

if (LeekASteroider()==true) {
moveTowardCell(getCellToUseChip(CHIP_STEROID, LeekABoost()));
useChip(CHIP_STEROID, LeekABoost());
}

if (LeekAProtein()==true) {
	moveTowardCell(getCellToUseChip(CHIP_PROTEIN, LeekABoost()));
useChip(CHIP_PROTEIN, LeekABoost());
}

if (BulbeADoper()==true) {
	moveTowardCell(getCellToUseChip(CHIP_DOPING, bulbeABoost()));
	useChip(CHIP_DOPING, bulbeABoost());
}

if (BulbeASteroider()==true) {
	moveTowardCell(getCellToUseChip(CHIP_STEROID, bulbeABoost()));
	useChip(CHIP_STEROID, bulbeABoost());
}

if (BulbeAProtein()==true) {
moveTowardCell(getCellToUseChip(CHIP_PROTEIN, bulbeABoost()));
	useChip(CHIP_PROTEIN, bulbeABoost());	
}
summon(CHIP_METALLIC_BULB, getCellsToUseChip(CHIP_METALLIC_BULB, getLeek()), bulbeMetalique());
summon(CHIP_HEALER_BULB, getCellsToUseChip(CHIP_HEALER_BULB, getLeek()), bulbeSoigneur());
summon(CHIP_FIRE_BULB, getCellToUseChip(CHIP_FIRE_BULB, getLeek()), BulbeL());
summon(CHIP_LIGHTNING_BULB, getCellToUseChip(CHIP_LIGHTNING, getLeek()), BulbeF());
summon(CHIP_ICED_BULB, getCellToUseChip(CHIP_ICED_BULB, getLeek()), bulbAI());
summon(CHIP_ROCKY_BULB, getCellsToUseChip(CHIP_ROCKY_BULB, getLeek()), bulbeRocheux());

moveTowardCell(tableaucellscacher());









