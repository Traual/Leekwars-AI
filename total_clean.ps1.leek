$root = "c:\Users\aurel\Leekwars-AI"

function Clean-Name {
    param($name)
    $clean = ($name -replace '[^a-zA-Z0-9.]', '_').Trim('_').Trim('.')
    while ($clean -match '__') { $clean = $clean -replace '__', '_' }
    return $clean
}

Write-Host "--- Nettoyage des DOSSIERS ---" -ForegroundColor Cyan
# On récupère les dossiers du plus profond au moins profond
$folders = Get-ChildItem -Path $root -Recurse -Directory | Where-Object { $_.FullName -notmatch '\\\.git\\' -and $_.FullName -notmatch '\\\.vscode\\' } | Sort-Object { $_.FullName.Length } -Descending

foreach ($folder in $folders) {
    if ($folder.Name -match '\s' -or $folder.Name -match '[^a-zA-Z0-9._]' -or $folder.Name -match '\.$') {
        $cleanName = Clean-Name $folder.Name
        $dest = Join-Path $folder.Parent.FullName $cleanName
        if ($folder.FullName -ne $dest) {
            Write-Host "Dossier: $($folder.FullName) -> $cleanName"
            try {
                Move-Item -LiteralPath "\\?\$($folder.FullName)" -Destination $dest -Force -ErrorAction Stop
            }
            catch {
                Write-Host "Erreur dossier: $($_.Exception.Message)" -ForegroundColor Red
            }
        }
    }
}

Write-Host "`n--- Nettoyage des FICHIERS ---" -ForegroundColor Cyan
$files = Get-ChildItem -Path $root -Recurse -File | Where-Object { $_.FullName -notmatch '\\\.git\\' -and $_.FullName -notmatch '\\\.vscode\\' }

foreach ($file in $files) {
    if ($file.Name -match '\s' -or $file.Name -match '[^a-zA-Z0-9._]' -or $file.Name -match '\.$') {
        $cleanName = Clean-Name $file.Name
        if ($cleanName -notmatch '\.leek$') {
            $cleanName += ".leek"
        }
        $cleanName = $cleanName -replace '_+\.leek$', '.leek'
        
        $dest = Join-Path $file.DirectoryName $cleanName
        if ($file.FullName -ne $dest) {
            Write-Host "Fichier: $($file.FullName) -> $cleanName"
            try {
                Move-Item -LiteralPath "\\?\$($file.FullName)" -Destination $dest -Force -ErrorAction Stop
            }
            catch {
                Write-Host "Erreur fichier: $($_.Exception.Message)" -ForegroundColor Red
            }
        }
    }
    elseif ($file.Extension -ne ".leek" -and $file.Name -ne "README.md" -and $file.Name -ne ".gitignore") {
        # Ajout de .leek aux fichiers qui n'ont pas d'extension ou une extension différente (sauf README/gitignore)
        $cleanName = $file.Name + ".leek"
        $dest = Join-Path $file.DirectoryName $cleanName
        Write-Host "Fichier (extension): $($file.FullName) -> $cleanName"
        try {
            Move-Item -LiteralPath "\\?\$($file.FullName)" -Destination $dest -Force -ErrorAction Stop
        }
        catch {
            Write-Host "Erreur extension: $($_.Exception.Message)" -ForegroundColor Red
        }
    }
}
